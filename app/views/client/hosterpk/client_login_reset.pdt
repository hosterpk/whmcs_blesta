<?php /* HOSTERPK OVERRIDE - diverges from stock: renders only the form card inside the slim auth shell (structure.pdt owns the brand panel and headline), warms the recovery outcome with view-only copy, drops the stock panel/col-md bootstrap chrome. Preserves the controller->view contract and Blesta's Form/CSRF flow (AR-D8). Stock baseline: bootstrap/client_login_reset.pdt @ 6.0.0-b1 sha256:f18603f26bca2c980dc66cc658cbde49fef4385a771cbcc6871258f086636467 */ ?>
<?php
/* Load the HosterPK copy table BEFORE this page content is captured into $content;
   Blesta renders the content view before the layout (structure.pdt), so the layout's
   language load happens too late for the Hosterpk.recover.* keys used here. Re-loading
   is a no-op once the static Language class has the file (mirrors client_login.pdt). */
$hpk_login_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_login_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_login_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_login_view_fs . 'language' . DS);
}
?>
<div class="hpk-login-card">
    <h2><?php $this->_('Hosterpk.recover.reset_heading');?></h2>
    <p><?php $this->_('Hosterpk.recover.reset_description');?></p>

    <?php
    /* Story 3.3 (FR15 / UX-DR22-23): VIEW-ONLY success/error classification (AR-D8 -
       no controller / auth-POST / CSRF re-wire), extending the 3.2 client_login.pdt
       pattern. message.pdt renders setMessage('message',..) as alert-success and
       setMessage('error',..) as alert-danger, so the type is read off the rendered HTML;
       the warm copy key is chosen by matching Blesta's OWN resolved language VALUES
       (entity-decoded first; empty/false needle guarded so strpos('') !== match-all).
       Under this checkout's privacy-preserving default (Blesta.default_password_reset_value
       = true) an unknown username emits the SAME reset_sent success value as a real send,
       so reset_unknown only fires if a future config sets that default to false. An
       unmapped $message is echoed as-is (preserves the 3.1/3.2 benign-flash behaviour). */
    $hpk_message = isset($message) ? html_entity_decode($message, ENT_QUOTES, 'UTF-8') : '';
    $hpk_is_error = (strpos($hpk_message, 'alert-danger') !== false);
    $hpk_copy_map = [
        'ClientLogin.!success.reset_sent'    => 'Hosterpk.recover.reset_sent',
        'ClientLogin.!error.unknown_user'    => 'Hosterpk.recover.reset_unknown',
        'ClientLogin.!error.captcha.invalid' => 'Hosterpk.login.error_captcha',
    ];
    $hpk_copy_key = null;
    if ($hpk_message !== '') {
        foreach ($hpk_copy_map as $hpk_k => $hpk_copy) {
            $hpk_needle = Language::_($hpk_k, true);
            if ($hpk_needle !== '' && $hpk_needle !== false && strpos($hpk_message, $hpk_needle) !== false) {
                $hpk_copy_key = $hpk_copy;
                break;
            }
        }
    }
    if ($hpk_copy_key !== null) {
        ?>
        <div class="hpk-alert <?php echo $hpk_is_error ? 'hpk-alert-danger' : 'hpk-alert-success';?> hpk-login-alert" role="alert">
            <i class="fas <?php echo $hpk_is_error ? 'fa-exclamation-circle' : 'fa-check-circle';?>" aria-hidden="true"></i>
            <span><?php $this->_($hpk_copy_key);?></span>
        </div>
        <?php
    } elseif (isset($message)) {
        echo $message;
    }
    ?>

    <?php
    $this->Form->create(null, ['class' => 'disable-on-submit']);
    ?>

    <div class="hpk-login-field">
        <?php
        $this->Form->label($this->_('ClientLogin.reset.field_username', true), 'login_username');
        $this->Form->fieldText('username', (isset($vars->username) ? $vars->username : null), ['id' => 'login_username', 'class' => 'form-control', 'placeholder' => $this->_('ClientLogin.reset.field_username', true)]);
        ?>
    </div>

    <?php
    if ((isset($captcha) ? $captcha : null)) {
    ?>
    <div class="hpk-login-field hpk-login-captcha">
        <?php echo $captcha;?>
    </div>
    <?php
    }
    ?>

    <button type="submit" class="hpk-btn hpk-btn-primary"><i class="fas fa-arrow-circle-right" aria-hidden="true"></i> <?php $this->_('ClientLogin.reset.field_resetsubmit');?></button>
    <?php
    $this->Form->end();
    ?>

    <div class="hpk-login-links">
        <a href="<?php echo $this->Html->safe($this->base_uri . 'login/forgot/');?>"><?php $this->_('ClientLogin.index.link_forgotusername');?></a>
        <a href="<?php echo $this->Html->safe($this->base_uri . 'login/');?>"><?php $this->_('ClientLogin.reset.link_login');?></a>
    </div>
</div>

<!-- HOSTERPK STOCK-JS PRESERVED -->
<?php
$this->Javascript->setInline('
    $(document).ready(function() {
        $("#login_username").focus();
    });
');
?>
<!-- /PRESERVED -->
