<?php /* HOSTERPK OVERRIDE — replaces the stock WidgetClient/nav-tabs edit-contact chrome with a .hpk-card + the .hpk-tabs skin (hpkTabs island) and brands the permission matrix into a .hpk-perm-grid. The dead Bootstrap collapse on the optional-login block is replaced by a local Alpine x-show toggle (degrades to visible = functional with no JS); the dead tooltip is replaced by visible .hpk-help-text. Per-field inline errors from the model $errors array; a warm view-only $message danger summary (Hosterpk.contacts.error_summary). Every field name/id + the setUsername JS are preserved. Stock baseline: bootstrap/client_contacts_edit.pdt @ 6.0.0-b1 sha256:5e31391906402f438a98434ba7313d305328cd383ade99b23672589954fe4999 */ ?>
<?php
/* Page-level language load for the Hosterpk.contacts.* keys. */
$hpk_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_view_fs . 'language' . DS);
}

/* Per-field inline error helper ($errors threaded in by the controller). */
$hpk_errors = (isset($errors) && is_array($errors)) ? $errors : [];
$hpk_field_error = function ($field) use ($hpk_errors) {
    if (empty($hpk_errors[$field])) {
        return '';
    }
    $msg = $hpk_errors[$field];
    while (is_array($msg)) {
        $msg = reset($msg);
    }
    return (string) $msg;
};
$hpk_login_enabled = !empty($vars->enable_login) || (empty($hpk_errors) && (isset($user) ? $user : false));
?>
<div class="hpk-contacts">
    <div class="hpk-contacts__nav">
        <?php echo ($navigation ?? null); ?>
    </div>
    <div class="hpk-contacts__content">
        <?php
        // View-only error summary (Task 6). edit() redirects on success; only the error
        // path renders inline. A non-danger flash is echoed as-is.
        $hpk_message = isset($message) ? html_entity_decode($message, ENT_QUOTES, 'UTF-8') : '';
        if ($hpk_message !== '') {
            if (strpos($hpk_message, 'alert-danger') !== false) {
        ?>
        <div class="hpk-alert hpk-alert-danger" role="alert">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <span><?php $this->_('Hosterpk.contacts.error_summary');?></span>
        </div>
        <?php
            } else {
                echo $message;
            }
        }
        ?>

        <div class="hpk-card" id="hpk-contact-edit">
            <h2 class="hpk-profile__section-title"><?php $this->_('ClientContacts.edit.boxtitle_edit');?></h2>

            <?php
            $this->Form->create(null, ['enctype' => 'multipart/form-data', 'class' => 'disable-on-submit']);
            ?>

            <div x-data="hpkTabs('contact')">
                <nav class="hpk-tabs" aria-label="<?php echo $this->Html->safe($this->_('ClientContacts.edit.boxtitle_edit', true));?>">
                    <a href="#hpk-contact-edit-contact" class="hpk-tab" :aria-current="isActive('contact') ? 'page' : false" @click.prevent="select('contact')"><?php $this->_('ClientContacts.edit.heading_contact');?></a>
                    <a href="#hpk-contact-edit-settings" class="hpk-tab" :aria-current="isActive('settings') ? 'page' : false" @click.prevent="select('settings')"><?php $this->_('ClientContacts.edit.heading_settings');?></a>
                    <a href="#hpk-contact-edit-authentication" class="hpk-tab" :aria-current="isActive('authentication') ? 'page' : false" @click.prevent="select('authentication')"><?php $this->_('ClientContacts.edit.heading_authentication');?></a>
                </nav>

                <section id="hpk-contact-edit-contact" class="hpk-tab-panel" data-hpk-tab-panel="contact" x-show="isActive('contact')">
                    <?php
                    echo (isset($contact_info) ? $contact_info : null);
                    echo (isset($phone_numbers) ? $phone_numbers : null);
                    ?>
                </section>

                <section id="hpk-contact-edit-settings" class="hpk-tab-panel" data-hpk-tab-panel="settings" x-show="isActive('settings')">
                    <h3 class="hpk-profile__section-title"><?php $this->_('ClientContacts.edit.heading_settings');?></h3>
                    <?php $hpk_err = $hpk_field_error('contact_type'); ?>
                    <div class="hpk-form-group">
                        <?php
                        $this->Form->label($this->_('ClientContacts.edit.field_contact_type', true), 'contact_type');
                        $this->Form->fieldSelect('contact_type', (isset($contact_types) ? $contact_types : null), (isset($vars->contact_type) ? $vars->contact_type : null), ['id' => 'contact_type', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                        if ($hpk_err !== '') {
                            echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                        }
                        ?>
                    </div>
                </section>

                <section id="hpk-contact-edit-authentication" class="hpk-tab-panel" data-hpk-tab-panel="authentication" x-show="isActive('authentication')">
                    <h3 class="hpk-profile__section-title"><?php $this->_('ClientContacts.edit.heading_authentication');?></h3>
                    <?php
                    /* Optional-login block — local Alpine x-show toggle in place of the dead Bootstrap
                       .collapse (Story 2.2); degrades to visible = functional with no JS. */
                    ?>
                    <div x-data="{ login: <?php echo $hpk_login_enabled ? 'true' : 'false';?> }">
                        <div class="hpk-form-group">
                            <label class="hpk-checkbox">
                                <?php $this->Form->fieldCheckbox('enable_login', 'true', $hpk_login_enabled, ['id' => 'enable_login', 'x-model' => 'login']);?>
                                <span><?php $this->_('ClientContacts.edit.field_enable_login');?></span>
                            </label>
                        </div>

                        <div id="login_fields" x-show="login">
                            <div class="hpk-form-group">
                                <?php $this->Form->label($this->_('ClientContacts.edit.field_username', true), 'username');?>
                                <?php
                                if ((isset($user) ? $user : null)) {
                                ?>
                                <p class="hpk-profile__static-value"><?php (print (isset($user->username) ? $this->Html->safe($user->username) : null));?></p>
                                <?php
                                } else {
                                    $hpk_err = $hpk_field_error('username');
                                    $this->Form->fieldText('username', (isset($vars->username) ? $vars->username : null), ['id' => 'username', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                                    if ($hpk_err !== '') {
                                        echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                                    }
                                }
                                ?>
                            </div>
                            <?php $hpk_err = $hpk_field_error('new_password'); ?>
                            <div class="hpk-form-group">
                                <?php
                                $this->Form->label($this->_('ClientContacts.edit.field_new_password', true), 'new_password');
                                $this->Form->fieldPassword('new_password', ['id' => 'new_password', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                                if ($hpk_err !== '') {
                                    echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                                }
                                ?>
                            </div>
                            <?php $hpk_err = $hpk_field_error('confirm_password'); ?>
                            <div class="hpk-form-group">
                                <?php
                                $this->Form->label($this->_('ClientContacts.edit.field_confirm_password', true), 'confirm_password');
                                $this->Form->fieldPassword('confirm_password', ['id' => 'confirm_password', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                                if ($hpk_err !== '') {
                                    echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                                }
                                ?>
                            </div>
                            <?php $hpk_err = $hpk_field_error('recovery_email'); ?>
                            <div class="hpk-form-group">
                                <?php
                                $this->Form->label($this->_('ClientContacts.edit.field_recovery_email', true), 'recovery_email');
                                $this->Form->fieldText('recovery_email', ($vars->recovery_email ?? (is_object($user) ? ($user->recovery_email ?? null) : null)), ['id' => 'recovery_email', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                                if ($hpk_err !== '') {
                                    echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                                }
                                ?>
                            </div>

                            <h4 class="hpk-profile__subsection-title"><?php $this->_('ClientContacts.edit.heading_permissions');?></h4>
                            <?php
                            $hpk_err = $hpk_field_error('permissions');
                            if ($hpk_err !== '') {
                                echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                            }
                            ?>
                            <div class="hpk-perm-grid">
                                <?php
                                foreach ((array)(isset($permissions) ? $permissions : null) as $area => $name) {
                                    $hpk_tip = $this->_('ClientContacts.tooltip.' . $area, true);
                                ?>
                                <div class="hpk-form-group">
                                    <label class="hpk-checkbox">
                                        <?php $this->Form->fieldCheckbox('permissions[area][]', $area, in_array($area, (array)(isset($vars->permissions['area']) ? $vars->permissions['area'] : null)));?>
                                        <span><?php (print (isset($name) ? $this->Html->safe($name) : null));?></span>
                                    </label>
                                    <?php
                                    if ($hpk_tip != '') {
                                    ?>
                                    <p class="hpk-help-text"><?php echo $this->Html->safe($hpk_tip);?></p>
                                    <?php
                                    }
                                    ?>
                                </div>
                                <?php
                                }
                                ?>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="hpk-profile__actions">
                <button type="submit" class="hpk-btn hpk-btn-primary"><i class="fas fa-edit" aria-hidden="true"></i> <?php $this->_('ClientContacts.edit.field_editsubmit');?></button>
            </div>
            <?php
            $this->Form->end();
            ?>
        </div>
    </div>
</div>

<!-- HOSTERPK STOCK-JS PRESERVED (RULE 6 tier b): mirror the recovery email into the username field. -->
<script type="text/javascript">
    $(document).ready(function() {
        setUsername();

        $("#email").on('change', function() {
            setUsername();
        });

        function setUsername() {
            $("#username").val($("#email").val());
        }
    });
</script>
<!-- /PRESERVED -->
