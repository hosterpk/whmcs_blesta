<?php /* HOSTERPK OVERRIDE - diverges from stock: wraps gateway-injected card DOM in .hpk-raw so HosterPK CSS never reaches it; native fallback fields keep their name/id/autocomplete/value/validation hooks and receive only HosterPK field chrome. Stock baseline: bootstrap/client_accounts_cc_info.pdt @ 6.0.0-b1 sha256:4d05fc9f7f08f8698244a1f9baae615a459bf812fb16fbae62c67a7d3665e3ad */ ?>
<?php
/* Partial-level language load: this partial may render before structure.pdt. */
$hpk_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_view_fs . 'language' . DS);
}
?>
<div class="row panel-fix">
    <div class="col-md-12">
        <h4><?php $this->_('ClientAccounts.cc_info.heading_cc');?></h4>
    </div>
    <div class="col-md-6">
        <?php
        if ((isset($gateway_form) ? $gateway_form : null)) {
        ?>
        <div class="form-group hpk-raw">
            <?php echo $gateway_form;?>
        </div>
        <p class="hpk-payment-secure-note"><?php $this->_('Hosterpk.payment_method.secure_note');?></p>
        <?php
        } else {
        ?>
        <div class="form-group">
            <?php
            $this->Form->label($this->_('ClientAccounts.cc_info.field_number', true), 'number');
            $this->Form->fieldText('number', isset($vars->last4) ? str_pad($vars->last4, 16, '*', STR_PAD_LEFT) : (isset($vars->number) ? $vars->number : null), ['id' => 'number', 'class' => 'form-control', 'placeholder' => $this->_('ClientAccounts.cc_info.field_number', true), 'autocomplete' => 'cc-number']);
            ?>
        </div>
        <div class="form-group">
            <?php $this->Form->label($this->_('ClientAccounts.cc_info.field_security', true), 'security_code');?>
            <a href="#" data-toggle="tooltip" title="<?php $this->_('ClientAccounts.cc_info.tooltip_code');?>"><i class="fas fa-question-circle text-info"></i></a>
            <?php $this->Form->fieldText('security_code', (isset($vars->security_code) ? $vars->security_code : null), ['id' => 'security_code', 'class' => 'form-control', 'placeholder' => $this->_('ClientAccounts.cc_info.field_security', true), 'autocomplete' => 'cc-csc']);?>
        </div>
        <div class="form-group">
            <?php $this->Form->label($this->_('ClientAccounts.cc_info.field_expiration', true), 'expiration');?>
            <div class="form-inline">
                <?php
                $this->Form->fieldSelect('expiration_month', (isset($expiration['months']) ? $expiration['months'] : null), (isset($vars->expiration_month) ? $vars->expiration_month : null), ['id' => 'expiration_month', 'class' => 'form-control form-control-sm', 'autocomplete' => 'cc-exp-month']);
                $this->Form->fieldSelect('expiration_year', (isset($expiration['years']) ? $expiration['years'] : null), (isset($vars->expiration_year) ? $vars->expiration_year : null), ['id' => 'expiration_year', 'class' => 'form-control form-control-sm', 'autocomplete' => 'cc-exp-year']);
                ?>
            </div>
        </div>
        <?php
        }

        if (isset($save_account) && $save_account) {
        ?>
        <div class="checkbox">
            <label>
            <?php
            $this->Form->fieldCheckbox('save_details', 'true', isset($vars->save_details));
            $this->_('ClientAccounts.cc_info.field_savedetails');
            ?>
            </label>
        </div>
        <?php
        }
        ?>
    </div>
    <div class="col-md-3">
        <?php echo ($navigation ?? null); ?>
    </div>
</div>
