<?php /* HOSTERPK OVERRIDE - diverges from stock: wraps gateway-injected bank DOM in .hpk-raw so HosterPK CSS never reaches it; native fallback fields keep their name/id/autocomplete/value/validation hooks and receive only HosterPK field chrome. Stock baseline: bootstrap/client_accounts_ach_info.pdt @ 6.0.0-b1 sha256:d69959010cf85282085f0bb3a745f67e56314bc4a80dfae7e9dc592563fda222 */ ?>
<?php
/* Partial-level language load: this partial may render before structure.pdt. */
$hpk_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_view_fs . 'language' . DS);
}
?>
<?php
if (!empty($message)) {
?>
    <div class="mb-3"><?php echo $message; ?></div>
<?php
}
?>

<div class="row">
    <div class="col-md-9">
        <div class="row panel-fix">
            <div class="col-md-12">
                <h4><?php $this->_('ClientAccounts.ach_info.heading_ach');?></h4>
            </div>
            <div class="col-md-9">
                <?php
                if ((isset($gateway_form) ? $gateway_form : null)) {
                ?>
                <div class="form-group hpk-raw">
                    <?php echo $gateway_form;?>
                </div>
                <p class="hpk-payment-secure-note"><?php $this->_('Hosterpk.payment_method.secure_note');?></p>
                <?php
                } else {
                ?>
                <div class="form-group">
                    <?php
                    $this->Form->label($this->_('ClientAccounts.ach_info.field_type', true), 'type');
                    $this->Form->fieldSelect('type', (isset($types) ? $types : null), (isset($vars->type) ? $vars->type : null), ['id' => 'type', 'class' => 'form-control']);
                    ?>
                </div>
                <div class="form-group">
                    <?php
                    $this->Form->label($this->_('ClientAccounts.ach_info.field_accountnum', true), 'ach_account');
                    $this->Form->fieldText('account', isset($vars->last4) ? str_pad($vars->last4, 9, '*', STR_PAD_LEFT) : (isset($vars->account) ? $vars->account : null), ['id' => 'ach_account', 'class' => 'form-control', 'placeholder' => $this->_('ClientAccounts.ach_info.field_accountnum', true)]);
                    ?>
                </div>
                <div class="form-group">
                    <?php
                    $this->Form->label($this->_('ClientAccounts.ach_info.field_routingnum', true), 'routing');
                    $this->Form->fieldText('routing', isset($vars->last4) ? str_pad(null, 9, '*', STR_PAD_LEFT) : (isset($vars->routing) ? $vars->routing : null), ['id' => 'routing', 'class' => 'form-control', 'placeholder' => $this->_('ClientAccounts.ach_info.field_routingnum', true)]);
                    ?>
                </div>
                <?php
                }

                if (isset($save_account) && $save_account) {
                ?>
                <div class="checkbox">
                    <label>
                    <?php
                    $this->Form->fieldCheckbox('save_details', 'true', isset($vars->save_details));
                    $this->_('ClientAccounts.ach_info.field_savedetails');
                    ?>
                    </label>
                </div>
                <?php
                }
                ?>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <?php echo ($navigation ?? null); ?>
    </div>
</div>
