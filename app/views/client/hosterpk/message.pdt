<?php /* HOSTERPK OVERRIDE - verbatim passthrough of the stock message/alert partial. Blesta's setMessage()/flashMessage() render this partial through a View bound to the active client template dir (client/hosterpk); a missing message.pdt here throws a hard "Files does not exist" Exception with NO bootstrap fallback (the app_controller fallback only covers client_*.pdt main views), which aborts the WHOLE action render. This first bit the Story 8.2 ticket reply page: under the support_manager HOSTERPK-SEAM the reply action's stock validation-error setMessage('error', ...) rendered message.pdt from client/hosterpk and 500'd the page to an empty body. Content is a hardened fork of stock: the .alert-* markup is restyled by the base.css frame-tier + the D5 state-color floor, the hosterpk page flash skinners re-skin $message into .hpk-alert, and the button URL passthrough now validates schemes to reject protocol-relative/non-http(s) URLs (lines 70-80). Stock baseline: bootstrap/message.pdt @ 6.0.0-b1 sha256:2179913b09b11c71e99c0d2eb8cd328d80d95c6830472563b4c8cd7d832e1d46 */ ?>
<?php
$success_message = (isset($success) ? $success : (isset($message) ? $message : false));
$types = [
    'success' => [
        'show' => (isset($success) || isset($message)),
        'title' => (isset($message_title) ? $message_title : false),
        'message' => $success_message,
        'buttons' => (isset($success_buttons) ? $success_buttons : null)
    ],
    'danger' => [
        'show' => isset($error),
        'title' => (isset($error_title) ? $error_title : false),
        'message' => (isset($error) ? $error : false),
        'buttons' => (isset($danger_buttons) ? $danger_buttons : null)
    ],
    'warning' => [
        'show' => isset($notice),
        'title' => (isset($notice_title) ? $notice_title : false),
        'message' => (isset($notice) ? $notice : false),
        'buttons' => (isset($notice_buttons) ? $notice_buttons : null)
    ],
    'info' => [
        'show' => isset($info),
        'title' => (isset($info_title) ? $info_title : false),
        'message' => (isset($info) ? $info : false),
        'buttons' => (isset($info_buttons) ? $info_buttons : null)
    ]
];

foreach ($types as $type => $message) {
    if (!$message['show']) {
        continue;
    }
?>
<div class="alert alert-<?php (print (isset($type) ? $this->Html->safe($type) : null));?> alert-dismissable w-100" role="alert">
    <?php
    if ((isset($show_close) ? $show_close : true)) {
    ?>
    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
    <?php
    }
    if ((isset($message['title']) ? $message['title'] : false)) {
    ?>
    <strong><?php (print (isset($message['title']) ? $this->Html->safe($message['title']) : null));?></strong><br>
    <?php
    }

    if (is_array($message['message'])) {
        foreach ($message['message'] as $field => $messages) {
            foreach ($messages as $key => $message_text) {
            ?>
                <?php echo (isset($message_text) ? $this->Html->safe($message_text, (isset($preserve_tags) ? $preserve_tags : false)) : null);?><br />
            <?php
            }
        }
    } else {
    ?>
    <?php echo (isset($message['message']) ? $this->Html->safe($message['message'], (isset($preserve_tags) ? $preserve_tags : false)) : null);?>
    <?php
    }

    if ((isset($message['buttons']) ? $message['buttons'] : false) && is_array($message['buttons'])) {
    ?>
    <p>
        <?php
        foreach ($message['buttons'] as $button) {
        ?>
        <?php
        $hpk_button_url = isset($button['url']) && is_string($button['url']) ? trim($button['url']) : null;
        $hpk_button_scheme = $hpk_button_url !== null ? parse_url($hpk_button_url, PHP_URL_SCHEME) : null;
        $hpk_button_protocol_relative = $hpk_button_url !== null && strpos($hpk_button_url, '//') === 0;
        $hpk_button_url_safe = (
            $hpk_button_url !== null
            && $hpk_button_url !== ''
            && !$hpk_button_protocol_relative
            && ($hpk_button_scheme === null || in_array(strtolower($hpk_button_scheme), ['http', 'https'], true))
        )
            ? $this->Html->safe($hpk_button_url)
            : '#';
        ?>
        <a href="<?php echo $hpk_button_url_safe;?>" class="btn btn-<?php (print (isset($type) ? $this->Html->safe($type) : null));?>"><i class="fas fa-fw <?php echo $this->Html->safe((isset($button['icon_class']) ? $button['icon_class'] : 'fa-exclamation-triangle'));?>"></i> <?php (print (isset($button['label']) ? $this->Html->safe($button['label']) : null));?></a>
        <?php
        }
        ?>
    </p>
    <?php
    }
    ?>
</div>
<?php
}
?>
