<?php /* HOSTERPK OVERRIDE — restyles the stock 2-column contact-info grid into HosterPK .hpk-form-* primitives, replaces the avatar inline-style attribute (RULE 1) with the .hpk-avatar-thumb class, and adds per-field inline errors (.hpk-invalid/.hpk-field-error) from the model $errors array. Every field name/id and the read-only/shown/required guards + the stock contact-populate / country→state AJAX / avatar-removal JS are preserved byte-for-byte (fenced). Shared by ClientMain::edit (profile) AND ClientContacts::add/edit (contacts), so branding it once covers both. Stock baseline: bootstrap/client_contacts_contact_info.pdt @ 6.0.0-b1 sha256:74f3e5f69317dbbae8c45715dfdf04635e21434fdf694995c3839c8763bc1995 */ ?>
<?php
/* Partial-level inline error helper — $errors is the model error array the controllers
   now thread into this partial (keyed by Blesta field name). Returns the first leaf
   message for a field, or '' when there is none. Server validation stays authoritative. */
$hpk_errors = (isset($errors) && is_array($errors)) ? $errors : [];
$hpk_field_error = function ($field) use ($hpk_errors) {
    if (empty($hpk_errors[$field])) {
        return '';
    }
    $msg = $hpk_errors[$field];
    while (is_array($msg)) {
        $msg = reset($msg);
    }
    return (string) $msg;
};
?>
