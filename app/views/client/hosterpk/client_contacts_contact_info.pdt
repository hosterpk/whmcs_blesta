<!-- HOSTERPK STOCK-JS PRESERVED (RULE 6 tier b): avatar removal/preview, enable_login avatar toggle, contact-select population, and country→state AJAX. Echoed verbatim from stock (selectors unchanged). -->
<?php
$this->Javascript->setInline('
    $(document).ready(function() {
        var contacts = ' . (isset($js_contacts) ? $js_contacts : null) . ";

        // Handle avatar removal
        $('#remove_avatar_link').click(function(e) {
            e.preventDefault();
            $('#remove_avatar').val('1');
            $('#avatar_preview').hide();
            $('#avatar').val('');
        });

        // Reset removal flag when a new avatar is selected
        $('#avatar').change(function() {
            if ($(this).val()) {
                $('#remove_avatar').val('0');
                $('#avatar_preview').show();
            }
        });

        // Function to toggle avatar section visibility
        function toggleAvatarSection() {
            var enable_login = $('#enable_login');
            var avatar = $('#avatar_section');

            if (enable_login.length === 0) {
                avatar.show();
            } else {
                if (enable_login.is(':checked')) {
                    avatar.show();
                } else {
                    avatar.hide();
                }
            }
        }

        // Initial check on page load
        toggleAvatarSection();

        // Listen for changes to the enable_login checkbox
        $('#enable_login').on('change', function() {
            toggleAvatarSection();
        });

        $('#contact_id').change(function() {
            if ($('#contact_id').val() != 'none') {
                // Populate contacts data onto form
                for (var i in contacts) {
                    if (contacts[i]['id'] == $('#contact_id').val()) {
                        // Set data
                        $('#first_name').val(contacts[i]['first_name']);
                        $('#last_name').val(contacts[i]['last_name']);
                        $('#address1').val(contacts[i]['address1']);
                        $('#address2').val(contacts[i]['address2']);
                        $('#city').val(contacts[i]['city']);
                        $('#country').val(contacts[i]['country']).trigger('change', [{state: contacts[i]['state']}]);
                        $('#zip').val(contacts[i]['zip']);
                        $('#email').val(contacts[i]['email']).trigger('change');
                        break;
                    }
                }
            }
        });

        $('#country').change(function(e, state) {
            $(this).blestaRequest('get', '" . $this->Html->safe($this->base_uri . 'main/getstates/') . "' + $(this).val(), null, function(data) {
                    // Remove all existing items
                    $('option', '#state').remove();

                    // Append all new items
                    $.each($(this).blestaSortObject(data), function(index, item) {
                        $('#state').append( new Option(item.value, item.key));
                    });

                    // Set state if given
                    if (state && state.state)
                        $('#state').val(state.state);
                },
                null,
                {dataType: 'json'}
            );
        });
    });
");
?>
<!-- /PRESERVED -->
