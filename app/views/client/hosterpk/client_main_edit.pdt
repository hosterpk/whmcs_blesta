                        }
                        $hpk_checkbox_attrs = [
                            'id' => 'receive_email_marketing',
                            'aria-describedby' => $hpk_describedby,
                        ];
                        if ($hpk_err !== '') {
                            $hpk_checkbox_attrs['class'] = 'hpk-invalid';
                            $hpk_checkbox_attrs['aria-invalid'] = 'true';
                        }
                    ?>
                    <div class="hpk-email-prefs" role="group" aria-labelledby="hpk-email-prefs-title">
                    <h3 id="hpk-email-prefs-title" class="hpk-profile__subsection-title"><?php $this->_('Hosterpk.email_prefs.section_title');?></h3>
                    <p id="hpk-email-prefs-help" class="hpk-help-text"><i class="fas fa-info-circle fa-fw" aria-hidden="true"></i> <?php $this->_('Hosterpk.email_prefs.marketing_help');?></p>
                    <div class="hpk-form-group">
                        <label class="hpk-checkbox" for="receive_email_marketing">
                            <?php
                            $this->Form->fieldCheckbox(
                                'receive_email_marketing',
                                'true',
                                (isset($vars->settings['receive_email_marketing']) ? $vars->settings['receive_email_marketing'] : 'false') == 'true',
                                $hpk_checkbox_attrs
                            );
                            ?>
                            <span><?php $this->_('ClientMain.edit.field_receive_email_marketing');?></span>
                        </label>
                        <?php
                        if ($hpk_err !== '') {
