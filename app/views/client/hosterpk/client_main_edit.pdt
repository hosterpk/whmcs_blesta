<?php /* HOSTERPK OVERRIDE — branded profile-edit card + tabs. Replaces the stock WidgetClient/nav-tabs Bootstrap chrome (left unstyled by the dropped application.min.css) with a .hpk-card + the .hpk-tabs skin driven by the hpkTabs Alpine island (in-page pane switch, degrades to stacked sections with no JS). Echoes the controller-injected $contact_info/$phone_numbers/$custom_fields partials as set. Adds per-field inline errors (.hpk-invalid/.hpk-field-error) sourced from the model $errors array (the Form helper has no error()/setErrors() in this Blesta version) + a warm view-only $message summary classifier (3.2/3.3 pattern). The Authentication tab + marketing checkbox render branded-but-not-deep (9.2/9.3 edit this same file; OQ1). Stock baseline: bootstrap/client_main_edit.pdt @ 6.0.0-b1 sha256:7421c66ee77ac15760b0462548dc5327228e4faa5c68785960699a084fedb861 */ ?>
<?php
/* Page-level language load: Blesta captures content before structure.pdt, so load the
   HosterPK copy table here for the Hosterpk.profile.* keys (mirrors client_accounts.pdt). */
$hpk_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_view_fs . 'language' . DS);
}

/* Per-field inline error helper. $errors is the model error array the controller now
   passes to the view (keyed by Blesta field name); returns the first leaf message for a
   field, or '' when there is none. Used to add .hpk-invalid to the control + a
   .hpk-field-error message below it. Server validation stays the source of truth — a
   no-JS submit re-renders these inline (and the summary) server-side. */
$hpk_errors = (isset($errors) && is_array($errors)) ? $errors : [];
$hpk_field_error = function ($field) use ($hpk_errors) {
    if (empty($hpk_errors[$field])) {
        return '';
    }
    $msg = $hpk_errors[$field];
    while (is_array($msg)) {
        $msg = reset($msg);
    }
    return (string) $msg;
};
?>

<div class="hpk-card hpk-profile" id="hpk-profile-edit">
    <?php
    /* View-only success/error summary (Task 6; 3.2/3.3 pattern). message.pdt renders
       setMessage('error', …) as .alert-danger, so the type is read off the rendered HTML.
       On error, swap in the warm Hosterpk.profile.error_summary lead; a benign info/notice
       flash (e.g. unverified-email) is echoed as-is so nothing is suppressed. Profile
       SUCCESS is post-redirect on the dashboard (UX-DR24), never inline here. */
    $hpk_message = isset($message) ? html_entity_decode($message, ENT_QUOTES, 'UTF-8') : '';
    if ($hpk_message !== '') {
        if (strpos($hpk_message, 'alert-danger') !== false) {
            /* Pick the summary lead by the SCOPE of the failing fields (9.2). The
               Authentication tab's security fields take priority when both a profile
               and a security field fail in the same submit, because that tab is the
               active recovery path on a password/2FA save. Scope is read off the
               threaded model $errors ($hpk_errors), not the rendered $message. */
            $hpk_security_fields = ['current_password', 'new_password', 'confirm_password', 'otp', 'two_factor_mode', 'two_factor_key', 'recovery_email'];
            $hpk_is_security_error = (count(array_intersect_key((array) $hpk_errors, array_flip($hpk_security_fields))) > 0);
            $hpk_summary_key = $hpk_is_security_error ? 'Hosterpk.security.error_summary' : 'Hosterpk.profile.error_summary';
    ?>
        <div class="hpk-alert hpk-alert-danger" role="alert">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <span><?php $this->_($hpk_summary_key);?></span>
        </div>
    <?php
        } else {
            echo $message;
        }
    }

    $this->Form->create(null, ['enctype' => 'multipart/form-data', 'class' => 'disable-on-submit']);
    ?>

    <div x-data="hpkTabs('contact')">
        <nav class="hpk-tabs" aria-label="<?php echo $this->Html->safe($this->_('ClientMain.edit.boxtitle_edit', true));?>">
            <a href="#hpk-profile-contact" class="hpk-tab" :aria-current="isActive('contact') ? 'page' : false" @click.prevent="select('contact')"><?php $this->_('ClientMain.edit.heading_contact');?></a>
            <?php
            if ((isset($is_primary) ? $is_primary : null)) {
            ?>
            <a href="#hpk-profile-billing" class="hpk-tab" :aria-current="isActive('billing') ? 'page' : false" @click.prevent="select('billing')"><?php $this->_('ClientMain.edit.heading_billing');?></a>
            <a href="#hpk-profile-settings" class="hpk-tab" :aria-current="isActive('settings') ? 'page' : false" @click.prevent="select('settings')"><?php $this->_('ClientMain.edit.heading_settings');?></a>
            <?php
            }
            ?>
            <a href="#hpk-profile-authentication" class="hpk-tab" :aria-current="isActive('authentication') ? 'page' : false" @click.prevent="select('authentication')"><?php $this->_('ClientMain.edit.heading_authentication');?></a>
        </nav>

        <section id="hpk-profile-contact" class="hpk-tab-panel" data-hpk-tab-panel="contact" x-show="isActive('contact')">
            <h2 class="hpk-profile__section-title"><?php $this->_('ClientMain.edit.heading_contact');?></h2>
            <?php
            echo (isset($contact_info) ? $contact_info : null);
            echo (isset($phone_numbers) ? $phone_numbers : null);
            ?>
        </section>

        <?php
        if ((isset($is_primary) ? $is_primary : null)) {
        ?>
        <section id="hpk-profile-billing" class="hpk-tab-panel" data-hpk-tab-panel="billing" x-show="isActive('billing')">
            <h2 class="hpk-profile__section-title"><?php $this->_('ClientMain.edit.heading_billing');?></h2>
            <div class="hpk-form-row">
                <div class="hpk-form-col">
                    <?php
                    // Show the Tax ID field
                    if ((isset($enabled_fields['tax_id']) ? $enabled_fields['tax_id'] : false)) {
                        $hpk_err = $hpk_field_error('tax_id');
                    ?>
                    <div class="hpk-form-group">
                        <?php
                        $this->Form->label($this->_('ClientMain.edit.field_taxid', true), 'tax_id');
                        $this->Form->fieldText('tax_id', (isset($vars->settings['tax_id']) ? $vars->settings['tax_id'] : null), ['id' => 'tax_id', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : ''), 'placeholder' => $this->_('ClientMain.edit.field_taxid', true)]);
                        if ($hpk_err !== '') {
                            echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                        }
                        ?>
                    </div>
                    <?php
                    }

                    // Show currency if enabled
                    if ((isset($enabled_fields['default_currency']) ? $enabled_fields['default_currency'] : false)) {
                        $hpk_err = $hpk_field_error('default_currency');
                    ?>
                    <div class="hpk-form-group">
                        <?php
                        $this->Form->label($this->_('ClientMain.edit.field_default_currency', true), 'default_currency');
                        $this->Form->fieldSelect('default_currency', (isset($currencies) ? $currencies : null), (isset($vars->settings['default_currency']) ? $vars->settings['default_currency'] : null), ['id' => 'default_currency', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                        if ($hpk_err !== '') {
                            echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                        }
                        ?>
                    </div>
                    <?php
                    }
                    $hpk_err = $hpk_field_error('inv_address_to');
                    ?>
                    <div class="hpk-form-group">
                        <?php
                        $this->Form->label($this->_('ClientMain.edit.field_invoiceaddress', true), 'inv_address_to');
                        $this->Form->fieldSelect('inv_address_to', (isset($contacts) ? $contacts : null), (isset($vars->settings['inv_address_to']) ? $vars->settings['inv_address_to'] : null), ['id' => 'inv_address_to', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                        if ($hpk_err !== '') {
                            echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                        }
                        ?>
                    </div>
                </div>
            </div>
        </section>

        <section id="hpk-profile-settings" class="hpk-tab-panel" data-hpk-tab-panel="settings" x-show="isActive('settings')">
            <h2 class="hpk-profile__section-title"><?php $this->_('ClientMain.edit.heading_settings');?></h2>
            <?php
            // Show additional settings, if any
            if ((isset($show_additional_settings) ? $show_additional_settings : false)) {
            ?>
            <div class="hpk-form-row">
                <div class="hpk-form-col">
                    <?php
                    // Show language if enabled
                    if ((isset($enabled_fields['language']) ? $enabled_fields['language'] : false)) {
                        $hpk_err = $hpk_field_error('language');
                    ?>
                    <div class="hpk-form-group">
                        <?php
                        $this->Form->label($this->_('ClientMain.edit.field_language', true), 'language');
                        $this->Form->fieldSelect('language', (isset($languages) ? $languages : null), (isset($vars->settings['language']) ? $vars->settings['language'] : null), ['id' => 'language', 'class' => 'form-control' . ($hpk_err !== '' ? ' hpk-invalid' : '')]);
                        if ($hpk_err !== '') {
                            echo '<span class="hpk-field-error">' . $this->Html->safe($hpk_err) . '</span>';
                        }
                        ?>
                    </div>
                    <?php
                    }
                    // Custom fields partial (branded in client_main_custom_fields.pdt)
                    echo (isset($custom_fields) ? $custom_fields : null);

                    // Email & notification preferences (Story 9.3). Stock Blesta exposes one
                    // client-editable notification control, so keep this group scoped to the
                    // existing marketing opt-in and its server-side error path.
                    if ((isset($enabled_fields['receive_email_marketing']) ? $enabled_fields['receive_email_marketing'] : false)) {
                        $hpk_err = $hpk_field_error('receive_email_marketing');
                        $hpk_describedby = 'hpk-email-prefs-help';
                        if ($hpk_err !== '') {
