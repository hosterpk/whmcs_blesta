<?php /* HOSTERPK OVERRIDE - diverges from stock: replaces Bootstrap/WidgetClient method-selection chrome with HosterPK radio-cards while preserving the real Blesta POST contract (pay_with, payment_account, payment_type, gateway) and all behavioral hooks. Stock baseline: bootstrap/client_pay_method.pdt @ 6.0.0-b1 sha256:b3d1a59a95ae576d80f53884ed8aa1397e5b40eb39ff7388c41b1db7b7eabe27 */ ?>
<?php
/* Blesta captures content before structure.pdt, so page copy must load here too. */
$hpk_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_view_fs . 'language' . DS);
}

// Mirror the stock column/no-options computation exactly.
$column_widths = 12;
$columns = 3;

if (empty($payment_accounts) || count($payment_accounts) <= 1 || (isset($require_passphrase) ? $require_passphrase : null)) {
    $columns--;
}
if (empty($payment_types) || count($payment_types) <= 1) {
    $columns--;
}
if (empty($nm_gateways)) {
    $columns--;
}

$column_widths /= ($columns == 0 ? 1 : $columns);

// If the invoice has already been paid, remove all payment methods
if ((isset($invoice_paid) ? $invoice_paid : null)) {
    $payment_accounts = [];
    $payment_types = [];
    $nm_gateways = [];
    $columns = 0;
}
?>
<div class="hpk-card hpk-payment-flow" id="hpk-pay-method">
    <?php
    echo (isset($message) ? $message : null);

    $this->Form->create(null, ['class' => 'disable-on-submit']);
    $this->Form->fieldHidden('pay_with', (isset($vars->pay_with) ? $vars->pay_with : null), ['id' => 'pay_with']);
    ?>

    <?php
    // No payment options available
    if ($columns == 0) {
    ?>
    <div class="hpk-alert hpk-alert-info">
        <?php $this->_('ClientPay.method.no_options');?>
    </div>
    <?php
    }
    ?>

    <?php
    if ($columns > 0) {
    ?>
    <fieldset class="hpk-payment-method-list">
        <legend class="hpk-payment-method-list__legend"><?php $this->_('Hosterpk.payment_method.select_method');?></legend>

        <?php
        // Saved payment accounts
        if (!empty($payment_accounts) && count($payment_accounts) > 1 && !(isset($require_passphrase) ? $require_passphrase : null)) {
            foreach ((isset($payment_accounts) ? $payment_accounts : []) as $account_value => $account_label) {
                // Skip the stock '' placeholder and optgroup markers (['value' => 'optgroup', ...]);
                // they are not selectable accounts and an array label would fatal Html->safe() on PHP 8.3.
                if ($account_value === '' || is_array($account_label)) {
                    continue;
                }
                $hpk_is_checked = ((isset($vars->pay_with) ? $vars->pay_with : null) == 'account'
                    && (isset($vars->payment_account) ? $vars->payment_account : null) == $account_value);
        ?>
        <label class="hpk-payment-method">
            <input type="radio" name="hpk_payment_method" class="hpk-payment-method__input" value="<?php echo $this->Html->safe($account_value);?>" data-hpk-pay-type="account" data-hpk-pay-value="<?php echo $this->Html->safe($account_value);?>"<?php echo $hpk_is_checked ? ' checked' : '';?>>
            <span class="hpk-payment-method__content">
                <span class="hpk-payment-method__radio"></span>
                <span class="hpk-payment-method__label"><?php (print (isset($account_label) ? $this->Html->safe($account_label) : null));?></span>
                <span class="hpk-payment-method__meta"><?php $this->_('Hosterpk.payment_method.saved_account');?></span>
            </span>
        </label>
        <?php
            }
        }

        // New payment details (cc / ach)
        if (!empty($payment_types) && count($payment_types) > 1) {
            foreach ((isset($payment_types) ? $payment_types : []) as $type_value => $type_label) {
                // Skip the stock '' placeholder (and any array marker) so it never renders as a card.
                if ($type_value === '' || is_array($type_label)) {
                    continue;
                }
                $hpk_is_checked = ((isset($vars->pay_with) ? $vars->pay_with : null) == 'details'
                    && (isset($vars->payment_type) ? $vars->payment_type : null) == $type_value);
        ?>
        <label class="hpk-payment-method">
            <input type="radio" name="hpk_payment_method" class="hpk-payment-method__input" value="<?php echo $this->Html->safe($type_value);?>" data-hpk-pay-type="details" data-hpk-pay-value="<?php echo $this->Html->safe($type_value);?>"<?php echo $hpk_is_checked ? ' checked' : '';?>>
            <span class="hpk-payment-method__content">
                <span class="hpk-payment-method__radio"></span>
                <span class="hpk-payment-method__label"><?php (print (isset($type_label) ? $this->Html->safe($type_label) : null));?></span>
                <span class="hpk-payment-method__meta"><?php $this->_('Hosterpk.payment_method.new_details');?></span>
            </span>
        </label>
        <?php
            }
        }

        // Non-merchant gateway options
        if (!empty($nm_gateways)) {
            foreach ((isset($nm_gateways) ? $nm_gateways : []) as $gateway) {
                $gateway_id = (isset($gateway->id) ? $gateway->id : null);
                $hpk_is_checked = ((isset($vars->pay_with) ? $vars->pay_with : null) == $gateway_id);
        ?>
        <label class="hpk-payment-method">
            <input type="radio" name="hpk_payment_method" class="hpk-payment-method__input" value="<?php echo $this->Html->safe($gateway_id);?>" data-hpk-pay-type="gateway" data-hpk-pay-value="<?php echo $this->Html->safe($gateway_id);?>"<?php echo $hpk_is_checked ? ' checked' : '';?>>
            <span class="hpk-payment-method__content">
                <span class="hpk-payment-method__radio"></span>
                <span class="hpk-payment-method__label"><?php (print (isset($gateway->name) ? $this->Html->safe($gateway->name) : null));?></span>
                <span class="hpk-payment-method__meta"><?php $this->_('Hosterpk.payment_method.gateway_option');?></span>
            </span>
        </label>
        <?php
            }
        }
        ?>
    </fieldset>
    <?php
    }
    ?>

    <?php
    // Canonical stock fields (kept for the controller contract but visually hidden).
    // These are updated by the display radio-card group via JavaScript.
    if (!empty($payment_accounts) && count($payment_accounts) > 1 && !(isset($require_passphrase) ? $require_passphrase : null)) {
    ?>
    <div class="hpk-visually-hidden">
        <?php
        $this->Form->fieldSelect('payment_account', (isset($payment_accounts) ? $payment_accounts : null), (isset($vars->payment_account) ? $vars->payment_account : null), ['id' => 'account']);
        ?>
    </div>
    <?php
    }
    if (!empty($payment_types) && count($payment_types) > 1) {
    ?>
    <div class="hpk-visually-hidden">
        <?php
        $this->Form->fieldSelect('payment_type', (isset($payment_types) ? $payment_types : null), (isset($vars->payment_type) ? $vars->payment_type : null), ['id' => 'details']);
        ?>
    </div>
    <?php
    }
    if (!empty($nm_gateways)) {
    ?>
    <div class="hpk-visually-hidden">
        <?php
        foreach ((isset($nm_gateways) ? $nm_gateways : []) as $gateway) {
            $this->Form->fieldRadio('gateway', (isset($gateway->id) ? $gateway->id : null), ((isset($vars->pay_with) ? $vars->pay_with : null) == (isset($gateway->id) ? $gateway->id : null)), ['class' => 'gateway']);
        }
        ?>
    </div>
    <?php
    }
    ?>

    <div id="payment_details" style="display:none;">
        <?php
        echo (isset($contact_info) ? $contact_info : null);
        ?>
        <div id="payment_details_cc" style="display:none;">
            <?php echo (isset($cc_info) ? $cc_info : null);?>
        </div>
        <div id="payment_details_ach" style="display:none;">
            <?php echo (isset($ach_info) ? $ach_info : null);?>
        </div>
    </div>

    <?php
    // Allow credits to be selected
    if ((isset($credits['amount']) ? $credits['amount'] : null) > 0 && !(isset($invoice_paid) ? $invoice_paid : null)) {
    ?>
    <div class="hpk-payment-flow__credit">
        <label class="hpk-checkbox">
            <?php
            $this->Form->fieldCheckbox('apply_credit', 'true', (isset($vars->apply_credit) ? $vars->apply_credit : null) == 'true', ['id' => 'apply_credit']);
            ?>
            <span><?php $this->_('ClientPay.method.field_apply_credit', false, $this->CurrencyFormat->format($credits['amount'], $credits['currency']));?></span>
        </label>
    </div>
    <?php
    }
    ?>

    <?php
    if (!empty($invoice)) {
    ?>
    <div class="hpk-payment-flow__invoice">
        <h4 class="hpk-payment-flow__section-title"><?php $this->_('ClientPay.method.heading_invoice', false, (isset($invoice->id_code) ? $this->Html->safe($invoice->id_code) : null));?></h4>
        <div class="hpk-table-wrap">
            <table class="hpk-table">
                <thead>
                    <tr>
                        <th scope="col" data-label="<?php $this->_('ClientPay.method.invoice_description');?>"><?php $this->_('ClientPay.method.invoice_description');?></th>
                        <th scope="col" data-label="<?php $this->_('ClientPay.method.invoice_quantity');?>"><?php $this->_('ClientPay.method.invoice_quantity');?></th>
                        <th scope="col" data-label="<?php $this->_('ClientPay.method.invoice_amount');?>"><?php $this->_('ClientPay.method.invoice_amount');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    $currency_options = [
                        'prefix' => false,
                        'suffix' => false,
                        'code' => false,
                        'with_separator' => false,
                        'html_code' => false,
                        'decimals' => (isset($currency->precision) ? $currency->precision : null)
                    ];
                    foreach ((isset($invoice->line_items) ? $invoice->line_items : []) as $line) {
                    ?>
                    <tr>
                        <td data-label="<?php $this->_('ClientPay.method.invoice_description');?>"><?php (print (isset($line->description) ? $this->Html->safe($line->description) : null));?></td>
                        <td data-label="<?php $this->_('ClientPay.method.invoice_quantity');?>"><?php echo $this->Html->safe($this->CurrencyFormat->truncateDecimal((isset($line->qty) ? $line->qty : null), 0));?></td>
                        <td data-label="<?php $this->_('ClientPay.method.invoice_amount');?>"><?php echo $this->CurrencyFormat->format((isset($line->amount) ? $line->amount : null), (isset($currency->code) ? $currency->code : null), $currency_options);?></td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
        </div>

        <?php
        // Show invoice totals breakdown if payments have been applied
        $paid_amount = $invoice->total - $invoice->due;
        if ($paid_amount > 0) {
        ?>
        <div class="hpk-payment-flow__totals">
            <table class="hpk-table hpk-table--compact">
                <tbody>
                    <tr>
                        <td><strong><?php $this->_('ClientPay.method.invoice_total');?></strong></td>
                        <td><?php echo $this->CurrencyFormat->format($invoice->total, $currency->code);?></td>
                    </tr>
                    <tr>
                        <td><strong><?php $this->_('ClientPay.method.invoice_paid_amount');?></strong></td>
                        <td><?php echo $this->CurrencyFormat->format($paid_amount, $currency->code);?></td>
                    </tr>
                    <tr>
                        <td><strong><?php $this->_('ClientPay.method.invoice_balance_due');?></strong></td>
                        <td><?php echo $this->CurrencyFormat->format($invoice->due, $currency->code);?></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <?php
        }
        ?>
    </div>
    <?php
    }
    ?>

    <div class="hpk-payment-flow__total">
        <span class="hpk-payment-flow__total-label"><?php $this->_('ClientPay.confirm.total');?></span>
        <strong class="hpk-payment-flow__total-value"><?php echo $this->CurrencyFormat->format((isset($total) ? $total : null), (isset($currency->code) ? $currency->code : null));?></strong>
    </div>

    <div class="hpk-payment-flow__actions">
        <button type="submit"<?php echo ($columns <= 0 ? ' style="display:none;"' : '');?> class="hpk-btn hpk-btn-primary" id="submit_payment">
            <i class="fas fa-arrow-circle-right"></i>
            <span class="confirm"><?php $this->_('ClientPay.method.field_submit');?></span>
            <span class="credit_confirm" style="display:none;"><?php $this->_('ClientPay.method.field_credit_submit');?></span>
        </button>
    </div>
    <?php
    $this->Form->end();
    ?>
</div>

<!-- HOSTERPK STOCK-JS PRESERVED (verbatim except the payment_type echo is JSON-encoded per review R2, since it is a POST value placed into a JS string; json_encode emits the surrounding quotes and escapes quotes/backslashes/line terminators that Html->safe would not) -->
<script type="text/javascript">
    $(document).ready(function() {
        var payment_type = <?php echo json_encode((isset($vars->payment_type) ? $vars->payment_type : ''), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);?>;
        if (payment_type == 'ach' || payment_type == 'cc') {
            $("#payment_details").show();
            $("#payment_details_" + payment_type).show();
        }

        $('#account, #details').on('change', function() {
            $('#pay_with').val($(this).attr('id'));
            $('.gateway').prop('checked', false);

            if ($(this).attr('id') == 'details') {
                if ($(this).val() == 'cc' || $(this).val() == 'ach') {
                    $('#payment_details').show();
                    togglePayDetails($(this).val());

                    $('html,body').animate({scrollTop: $('#payment_details').offset().top}, 'slow');
                }
                else
                    $('#payment_details').hide();

                $('#account').val('');
            }
            else {
                $('#payment_details, #payment_details_cc, #payment_details_ach').hide();
                $('#details').val('');
            }
        });

        $('.gateway').on('change', function() {
            $('#pay_with').val($(this).val());
            $('#payment_details, #payment_details_cc, #payment_details_ach').hide();
            $('#account, #details').val('');
        });

        toggleCredit();
        $('#apply_credit').change(function() {
            toggleCredit();
        });
    });
    /* The branded radio-card → stock-field sync lives in js/bootstrap.js
       (#hpk-pay-method scope) per AR-ENF4: no new authored inline island JS. */

    function toggleCredit() {
        if ($('#apply_credit').prop('checked')) {
            $('span.credit_confirm').show();
            $('#submit_payment').show();
            $('span.confirm').hide();
        }
        else {
            $('span.confirm').show();
            $('span.credit_confirm').hide();

            if (<?php echo $columns;?> <= 0) {
                $('#submit_payment').hide();
            }
        }
    }

    function togglePayDetails(val) {
        if (val == "cc") {
            $("#payment_details_ach").hide();
            $("#payment_details_cc").show();
        }
        else {
            $("#payment_details_cc").hide();
            $("#payment_details_ach").show();
        }
    }
</script>
<!-- /PRESERVED -->
