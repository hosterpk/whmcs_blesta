<?php /* HOSTERPK OVERRIDE - diverges from stock: renders only the form card inside the slim auth shell (structure.pdt owns the brand panel and headline), warms a confirm-reset validation failure with a view-only summary alert + inline new_password field error, reuses the registered hpkPasswordToggle, drops the stock panel/col-md bootstrap chrome. Preserves the controller->view contract and Blesta's Form/CSRF flow (AR-D8). Stock baseline: bootstrap/client_login_confirmreset.pdt @ 6.0.0-b1 sha256:9b5b22551e3405299506369c362085f21ff8613510ec753710f0af1c0ba0fc11 */ ?>
<?php
/* Load the HosterPK copy table BEFORE this page content is captured into $content;
   Blesta renders the content view before the layout (structure.pdt), so the layout's
   language load happens too late for the Hosterpk.recover.* + password_toggle.* keys
   used here. Re-loading is a no-op once the static Language class has the file. */
$hpk_login_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_login_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_login_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_login_view_fs . 'language' . DS);
}
?>
<div class="hpk-login-card">
    <h2><?php $this->_('Hosterpk.recover.confirm_heading');?></h2>
    <p><?php $this->_('Hosterpk.recover.confirm_description');?></p>

    <?php
    /* Story 3.3 (FR15 / UX-DR13/24, FR37): VIEW-ONLY error surfacing (AR-D8 - no
       controller / auth-POST / CSRF re-wire). confirmReset() logs in + redirects on
       success, so this view only renders on a validation failure: message.pdt emits
       alert-danger for setMessage('error', $errors). $this->Form->error() is NOT wired
       in this flow (the controller never calls Form->setErrors; the raw error array is
       not passed to the view) and Blesta keys ALL confirm-reset password rules
       (new_password.format / .matches) under the SINGLE field new_password - so the
       inline error is derived from the rendered $message and attributed to new_password.
       $hpk_field_error = the decoded message text with the leading message.pdt dismiss
       glyph (x / U+00D7) stripped. The top summary uses the warm recover.confirm_error;
       the inline .hpk-field-error carries the specific Blesta validation sentence. An
       unmapped (non-error) $message is echoed as-is (preserves 3.1/3.2 behaviour). */
    $hpk_message = isset($message) ? html_entity_decode($message, ENT_QUOTES, 'UTF-8') : '';
    $hpk_is_error = (strpos($hpk_message, 'alert-danger') !== false);
    $hpk_field_error = '';
    $hpk_field_error_id = 'new_password_error';
    if ($hpk_is_error) {
        $hpk_field_error = preg_replace('/<br\s*\/?>/i', ' ', $hpk_message);
        $hpk_field_error = trim(strip_tags($hpk_field_error));
        $hpk_field_error = preg_replace('/^\s*\x{00D7}\s*/u', '', $hpk_field_error);
        $hpk_field_error = preg_replace('/\s+/u', ' ', $hpk_field_error);
        ?>
        <div class="hpk-alert hpk-alert-danger hpk-login-alert" role="alert">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <span><?php $this->_('Hosterpk.recover.confirm_error');?></span>
        </div>
        <?php
    } elseif (isset($message)) {
        echo $message;
    }
    ?>

    <?php
    $this->Form->create(null, ['class' => 'disable-on-submit']);
    ?>

    <div class="hpk-login-field">
        <?php
        $this->Form->label($this->_('ClientLogin.confirmreset.field_new_password', true), 'new_password');
        ?>
        <div class="hpk-input-group"
             x-data="hpkPasswordToggle(<?php echo htmlspecialchars(json_encode(['show' => $this->_('Hosterpk.password_toggle.show', true), 'hide' => $this->_('Hosterpk.password_toggle.hide', true)], JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP), ENT_QUOTES); ?>)"
             x-init="init()">
            <?php
            $hpk_new_password_attrs = [
                'id' => 'new_password',
                'class' => 'form-control' . ($hpk_is_error ? ' hpk-invalid' : ''),
                'autocomplete' => 'new-password',
                'x-ref' => 'field',
            ];
            if ($hpk_is_error && $hpk_field_error !== '') {
                $hpk_new_password_attrs['aria-invalid'] = 'true';
                $hpk_new_password_attrs['aria-describedby'] = $hpk_field_error_id;
            }
            $this->Form->fieldPassword('new_password', $hpk_new_password_attrs);
            ?>
            <button type="button"
                    class="hpk-password-toggle"
                    x-cloak
                    x-ref="toggle"
                    @click="toggle()"
                    :aria-label="ariaLabel"
                    aria-label="<?php echo $this->Html->safe($this->_('Hosterpk.password_toggle.show', true)); ?>"
                    data-fallback-label="<?php echo $this->Html->safe($this->_('Hosterpk.password_toggle.show', true)); ?>"
                    x-text="shown ? labels.hide : labels.show"><?php echo $this->Html->safe($this->_('Hosterpk.password_toggle.show', true)); ?></button>
        </div>
        <?php
        if ($hpk_is_error && $hpk_field_error !== '') {
        ?>
        <span id="<?php echo $this->Html->safe($hpk_field_error_id);?>" class="hpk-field-error"><?php echo $this->Html->safe($hpk_field_error);?></span>
        <?php
        }
        ?>
    </div>

    <div class="hpk-login-field">
        <?php
        $this->Form->label($this->_('ClientLogin.confirmreset.field_confirm_password', true), 'confirm_password');
        ?>
        <div class="hpk-input-group"
             x-data="hpkPasswordToggle(<?php echo htmlspecialchars(json_encode(['show' => $this->_('Hosterpk.password_toggle.show', true), 'hide' => $this->_('Hosterpk.password_toggle.hide', true)], JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP), ENT_QUOTES); ?>)"
             x-init="init()">
            <?php
            $this->Form->fieldPassword('confirm_password', [
                'id' => 'confirm_password',
                'class' => 'form-control',
                'autocomplete' => 'new-password',
                'x-ref' => 'field',
            ]);
            ?>
            <button type="button"
                    class="hpk-password-toggle"
                    x-cloak
                    x-ref="toggle"
                    @click="toggle()"
                    :aria-label="ariaLabel"
                    aria-label="<?php echo $this->Html->safe($this->_('Hosterpk.password_toggle.show', true)); ?>"
                    data-fallback-label="<?php echo $this->Html->safe($this->_('Hosterpk.password_toggle.show', true)); ?>"
                    x-text="shown ? labels.hide : labels.show"><?php echo $this->Html->safe($this->_('Hosterpk.password_toggle.show', true)); ?></button>
        </div>
    </div>

    <button type="submit" class="hpk-btn hpk-btn-primary"><i class="fas fa-arrow-circle-right" aria-hidden="true"></i> <?php $this->_('ClientLogin.confirmreset.field_resetsubmit');?></button>
    <?php
    $this->Form->end();
    ?>

    <div class="hpk-login-links">
        <a href="<?php echo $this->Html->safe($this->base_uri . 'login/');?>"><?php $this->_('ClientLogin.confirmreset.link_login');?></a>
    </div>
</div>

<!-- HOSTERPK STOCK-JS PRESERVED -->
<?php
$this->Javascript->setInline('
    $(document).ready(function() {
        $("#new_password").focus();
    });
');
?>
<!-- /PRESERVED -->
