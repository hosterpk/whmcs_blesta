<?php /* HOSTERPK OVERRIDE - diverges from stock: replaces WidgetClient/Bootstrap chrome with HosterPK card and summary components while preserving the confirm form, authorization hidden fields, and gateway-output raw fence. Stock baseline: bootstrap/client_pay_confirm.pdt @ 6.0.0-b1 sha256:a13ed11066903a884b6dda9fae269379560eff0d4f528e3e022b32c59a362f1b */ ?>
<?php
/* Blesta captures content before structure.pdt, so page copy must load here too. */
$hpk_view_fs = null;
if (defined('ROOTWEBDIR') && defined('WEBDIR') && strpos($this->view_dir, WEBDIR) === 0) {
    $hpk_view_fs = ROOTWEBDIR . ltrim(substr($this->view_dir, strlen(WEBDIR)), '/\\');
}
if (isset($hpk_view_fs)) {
    Language::loadLang('hosterpk', null, $hpk_view_fs . 'language' . DS);
}
?>
<div class="hpk-card hpk-payment-flow" id="hpk-pay-confirm">
    <?php
    echo (isset($message) ? $message : null);
    ?>

    <?php
    $this->Form->create(null, ['id' => 'confirm-payment', 'class' => 'disable-on-submit']);
    $this->Form->fieldHidden('pay', '1');
    $this->Form->fieldHidden('authorized_transaction_id', $authorized_transaction_id ?? null);
    $this->Form->fieldHidden('authorized_transaction_hash', $authorized_transaction_hash ?? null);
    ?>

    <h4 class="hpk-payment-flow__section-title"><?php $this->_('ClientPay.confirm.payment_details');?></h4>

    <?php
    if ((isset($client) ? $client : false) || (isset($gateway_name) ? $gateway_name : false) || (isset($account) ? $account : false)) {
    ?>
    <div class="hpk-payment-flow__summary">
        <?php
        if ((isset($client) ? $client : false)) {
        ?>
        <div class="hpk-payment-flow__summary-block">
            <p>
                <?php (print (isset($client->first_name) ? $this->Html->safe($client->first_name) : null));?> <?php (print (isset($client->last_name) ? $this->Html->safe($client->last_name) : null));?><br />
                <?php echo $this->Html->concat('<br />', $this->Html->safe($client->address1), $this->Html->safe($client->address2), $this->Html->safe($client->city) . (isset($client->city) ? ', ' : '') . $this->Html->safe($client->state_name ?? $client->state) . ' ' . $this->Html->safe($client->zip), $this->Html->safe($client->country_name ?? $client->country));?>
            </p>
        </div>
        <?php
        }
        if ((isset($gateway_name) ? $gateway_name : false)) {
        ?>
        <div class="hpk-payment-flow__summary-block">
            <p><?php (print (isset($gateway_name) ? $this->Html->safe($gateway_name) : null));?></p>
        </div>
        <?php
        }
        if ((isset($account) ? $account : false)) {
        ?>
        <div class="hpk-payment-flow__summary-block">
            <p>
                <?php (print (isset($account->first_name) ? $this->Html->safe($account->first_name) : null));?> <?php (print (isset($account->last_name) ? $this->Html->safe($account->last_name) : null));?><br />
                <?php echo $this->Html->concat('<br />', $this->Html->safe($account->address1), $this->Html->safe($account->address2), $this->Html->safe($account->city) . ' ' . $this->Html->safe($account->state) . ' ' . $this->Html->safe($account->zip), $this->Html->safe($account->country));?>
            </p>
            <p>
                <?php
                if ((isset($account->type) ? $account->type : null) && (isset($account->last4) ? $account->last4 : null)) {
                    $this->_('ClientPay.confirm.account_info', false, (isset($account_types[$account_type]) ? $account_types[$account_type] : null), ($account_type == 'ach' ? (isset($ach_types[$account->type]) ? $ach_types[$account->type] : null) : (isset($cc_types[$account->type]) ? $cc_types[$account->type] : null)), (isset($account->last4) ? $account->last4 : null));
                } else {
                    $this->_('ClientPay.confirm.account_info_type', false, (isset($account_types[$account_type]) ? $account_types[$account_type] : null));
                }

                if ((isset($account->expiration) ? $account->expiration : null)) {
                    $date = substr($account->expiration, 0, 4) . '-' . substr($account->expiration, -2) . '-15';
                ?>
                <br />
                <?php $this->_('ClientPay.confirm.account_exp', false, $this->Date->format('F, Y', $date));?>
                <?php
                }
                ?>
            </p>
        </div>
        <?php
        }
        ?>
    </div>
    <?php
    }
    ?>

    <hr class="hpk-divider" />

    <?php if ((isset($merchant_payment_confirmation) ? $merchant_payment_confirmation : null)) { ?>
    <div class="hpk-payment-flow__gateway">
        <div class="hpk-raw">
            <?php echo $merchant_payment_confirmation;?>
        </div>
        <p class="hpk-payment-secure-note"><?php $this->_('Hosterpk.payment_method.secure_note');?></p>
    </div>
    <?php } ?>

    <div class="hpk-payment-flow__total">
        <span class="hpk-payment-flow__total-label"><?php $this->_('ClientPay.confirm.total');?></span>
        <strong class="hpk-payment-flow__total-value"><?php echo $this->CurrencyFormat->format((isset($total) ? $total : null), $currency);?></strong>
    </div>

    <div class="hpk-payment-flow__actions hpk-payment-flow__actions--split">
        <a class="hpk-btn hpk-btn-outline" href="<?php echo $this->Html->safe($this->base_uri . 'pay/');?>">
            <i class="fas fa-edit fa-fw"></i> <?php $this->_('ClientPay.confirm.field_edit');?>
        </a>
        <?php
        if (!(isset($gateway_buttons) ? $gateway_buttons : false)) {
        ?>
        <button type="submit" class="hpk-btn hpk-btn-primary" id="submit_payment">
            <i class="fas fa-plus-circle fa-fw"></i> <?php $this->_('ClientPay.confirm.field_submit');?>
        </button>
        <?php
        }
        ?>
    </div>
    <?php
    $this->Form->end();

    if ((isset($gateway_buttons) ? $gateway_buttons : false)) {
    ?>
    <div class="hpk-payment-flow__gateway-buttons">
        <?php
        foreach ((isset($gateway_buttons) ? $gateway_buttons : []) as $buttons) {
            foreach ($buttons as $gateway_button) {
            ?>
            <div class="hpk-payment-flow__gateway-button">
                <div class="hpk-raw">
                    <?php echo $gateway_button;?>
                </div>
            </div>
            <?php
            }
        }
        ?>
    </div>
    <?php
    }
    ?>
</div>
