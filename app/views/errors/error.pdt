<?php /** @var View $this **/ ?>

<?php
// Get source code
$line = 0;
$code = null;
$start_line = 0;
$end_line = 0;

if (!empty($exception) && file_exists($exception->getFile())) {
    $line = $exception->getLine();
    $code = @file_get_contents($exception->getFile());

    if ($line > 0) {
        $line = $line - 1;
    }

    if (!empty($code)) {
        $code = explode("\n", $code);

        $show_lines = 15;
        $start_line = max(0, $line - $show_lines);
        $end_line = min(count($code) - 1, $line + $show_lines);

        if (!isset($code[$line])) {
            $code = null;
        }
    }
}

// Check if debug mode is enabled
$debug_enabled = Configure::get('System.debug') && !empty($exception);
?>

<?php
if ($debug_enabled) {
    ?>
<div class="error-debug-container">
    <div class="error-header">
        <div class="error-header-content">
            <div class="error-type">
                <span class="error-badge"><?php echo get_class($exception);?></span>
            </div>
            <h1 class="error-message"><?php echo htmlentities($exception->getMessage(), ENT_QUOTES, 'UTF-8');?></h1>
            <div class="error-location">
                <i class="bi bi-file-code"></i>
                <span><?php echo htmlentities($exception->getFile(), ENT_QUOTES, 'UTF-8');?></span>
                <span class="error-line-badge">Line <?php echo htmlentities($exception->getLine(), ENT_QUOTES, 'UTF-8');?></span>
            </div>
        </div>
    </div>

    <nav class="error-nav">
        <a href="#stack-trace" class="error-nav-item">
            <i class="bi bi-stack"></i> Stack Trace
        </a>
        <a href="#source-code" class="error-nav-item">
            <i class="bi bi-code-slash"></i> Source Code
        </a>
        <a href="#request" class="error-nav-item">
            <i class="bi bi-arrow-down-up"></i> HTTP Request
        </a>
        <a href="#server" class="error-nav-item">
            <i class="bi bi-hdd-rack"></i> Server
        </a>
        <?php
        if (!empty($exception->getTrace())) {
            ?>
            <a href="#context" class="error-nav-item">
                <i class="bi bi-info-circle"></i> Context
            </a>
            <?php
        }
        ?>
    </nav>

    <div class="error-content">
        <!-- Stack Trace Section -->
        <section id="stack-trace" class="error-section">
            <h2 class="section-title">
                <i class="bi bi-stack"></i> Stack Trace
            </h2>
            <div class="stack-trace-list">
                <div class="stack-frame active" data-file="<?php echo htmlentities($exception->getFile(), ENT_QUOTES, 'UTF-8');?>" data-line="<?php echo $exception->getLine();?>">
                    <div class="frame-header">
                        <span class="frame-number">1</span>
                        <div class="frame-info">
                            <div class="frame-location">
                                <span class="frame-file"><?php echo basename($exception->getFile());?></span>
                                <span class="frame-line">:<?php echo $exception->getLine();?></span>
                            </div>
                            <div class="frame-path"><?php echo htmlentities(dirname($exception->getFile()), ENT_QUOTES, 'UTF-8');?></div>
                        </div>
                    </div>
                </div>

                <?php
                $trace = $exception->getTrace();
                if (!empty($trace)) {
                    $frame_num = 2;
                    foreach ($trace as $trace_line) {
                        if (empty($trace_line['file'])) {
                            continue;
                        }
                        ?>
                    <div class="stack-frame" data-file="<?php echo htmlentities($trace_line['file'], ENT_QUOTES, 'UTF-8');?>" data-line="<?php echo $trace_line['line'] ?? 0;?>">
                        <div class="frame-header">
                            <span class="frame-number"><?php echo $frame_num;?></span>
                            <div class="frame-info">
                                <div class="frame-function">
                                    <?php
                                    $function_call = '';
                                    if (!empty($trace_line['class'])) {
                                        $function_call .= $trace_line['class'];
                                    }
                                    if (!empty($trace_line['type'])) {
                                        $function_call .= $trace_line['type'];
                                    }
                                    if (!empty($trace_line['function'])) {
                                        $function_call .= $trace_line['function'] . '()';
                                    }
                                    echo htmlentities($function_call, ENT_QUOTES, 'UTF-8');
                                    ?>
                                </div>
                                <div class="frame-location">
                                    <span class="frame-file"><?php echo basename($trace_line['file']);?></span>
                                    <span class="frame-line">:<?php echo $trace_line['line'] ?? '?';?></span>
                                </div>
                                <div class="frame-path"><?php echo htmlentities(dirname($trace_line['file']), ENT_QUOTES, 'UTF-8');?></div>
                            </div>
                        </div>

                        <?php
                        if (!empty($trace_line['args'])) {
                            ?>
                            <div class="frame-args">
                                <div class="args-toggle" onclick="this.parentElement.classList.toggle('expanded')">
                                    <i class="bi bi-chevron-right"></i> Arguments (<?php echo count($trace_line['args']);?>)
                                </div>
                                <pre class="args-content"><?php
                                    ob_start();
                                    var_export($trace_line['args']);
                                    echo htmlentities(ob_get_clean(), ENT_QUOTES, 'UTF-8');
                                ?></pre>
                            </div>
                            <?php
                        }
                        ?>
                    </div>
                        <?php
                        $frame_num++;
                    }
                }
                ?>
            </div>
        </section>

        <!-- Source Code Section -->
        <section id="source-code" class="error-section">
            <h2 class="section-title">
                <i class="bi bi-code-slash"></i> Source Code
            </h2>
            <div class="code-viewer">
                <div class="code-header">
                    <span class="code-filename">
                        <i class="bi bi-file-code"></i>
                        <?php echo htmlentities($exception->getFile(), ENT_QUOTES, 'UTF-8');?>
                    </span>
                </div>
                <div class="code-content">
                    <?php
                    if (!empty($code) && is_array($code)) {
                        foreach ($code as $line_no => $line_str) {
                            if ($line_no < $start_line || $line_no > $end_line) {
                                continue;
                            }
                            $is_error_line = ($line_no == $line);
                            ?>
                        <div class="code-line<?php echo $is_error_line ? ' error-line' : '';?>">
                            <span class="line-number"><?php echo $line_no + 1;?></span>
                            <pre class="line-code"><?php echo htmlentities($line_str === '' ? ' ' : $line_str, ENT_QUOTES, 'UTF-8');?></pre>
                        </div>
                            <?php
                        }
                    } else {
                        ?>
                        <div class="code-fallback">
                            <pre><?php echo nl2br(htmlentities($exception->getTraceAsString(), ENT_QUOTES, 'UTF-8'));?></pre>
                        </div>
                        <?php
                    }
                    ?>
                </div>
            </div>
        </section>

        <!-- HTTP Request Section -->
        <section id="request" class="error-section">
            <h2 class="section-title">
                <i class="bi bi-arrow-down-up"></i> HTTP Request
            </h2>

            <!-- Request Headers -->
            <div class="server-dump-container expanded">
                <div class="server-dump-header" onclick="this.parentElement.classList.toggle('expanded')">
                    <i class="bi bi-chevron-right"></i>
                    <span>Request Headers</span>
                    <?php
                    $headers = [];
                    if (function_exists('getallheaders')) {
                        $headers = getallheaders();
                    } else {
                        foreach ($_SERVER as $key => $value) {
                            if (str_starts_with($key, 'HTTP_')) {
                                $header_name = str_replace(' ', '-', ucwords(strtolower(str_replace('_', ' ', str_after($key, 'HTTP_')))));
                                $headers[$header_name] = $value;
                            }
                        }
                    }
                    ?>
                    <span class="server-dump-count"><?php echo count($headers);?> items</span>
                </div>
                <div class="server-dump-content">
                    <table class="server-dump-table">
                        <thead>
                            <tr>
                                <th>Header</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php
                            foreach ($headers as $key => $value) {
                                ?>
                                <tr>
                                    <td class="server-key"><?php echo htmlentities($key, ENT_QUOTES, 'UTF-8');?></td>
                                    <td class="server-value"><?php echo htmlentities(is_array($value) ? json_encode($value) : (string) $value, ENT_QUOTES, 'UTF-8');?></td>
                                </tr>
                                <?php
                            }
                            ?>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- $_GET -->
            <?php
            if (!empty($_GET)) {
                ?>
                <div class="server-dump-container">
                    <div class="server-dump-header" onclick="this.parentElement.classList.toggle('expanded')">
                        <i class="bi bi-chevron-right"></i>
                        <span>$_GET</span>
                        <span class="server-dump-count"><?php echo count($_GET);?> items</span>
                    </div>
                    <div class="server-dump-content">
                        <table class="server-dump-table">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                foreach ($_GET as $key => $value) {
                                    ?>
                                    <tr>
                                        <td class="server-key"><?php echo htmlentities($key, ENT_QUOTES, 'UTF-8');?></td>
                                        <td class="server-value"><?php echo htmlentities(is_array($value) ? json_encode($value) : (string) $value, ENT_QUOTES, 'UTF-8');?></td>
                                    </tr>
                                    <?php
                                }
                                ?>
                            </tbody>
                        </table>
                    </div>
                </div>
                <?php
            }
            ?>

            <!-- $_POST -->
            <?php
            if (!empty($_POST)) {
                ?>
                <div class="server-dump-container">
                    <div class="server-dump-header" onclick="this.parentElement.classList.toggle('expanded')">
                        <i class="bi bi-chevron-right"></i>
                        <span>$_POST</span>
                        <span class="server-dump-count"><?php echo count($_POST);?> items</span>
                    </div>
                    <div class="server-dump-content">
                        <table class="server-dump-table">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                foreach ($_POST as $key => $value) {
                                    ?>
                                    <tr>
                                        <td class="server-key"><?php echo htmlentities($key, ENT_QUOTES, 'UTF-8');?></td>
                                        <td class="server-value"><?php echo htmlentities(is_array($value) ? json_encode($value) : (string) $value, ENT_QUOTES, 'UTF-8');?></td>
                                    </tr>
                                    <?php
                                }
                                ?>
                            </tbody>
                        </table>
                    </div>
                </div>
                <?php
            }
            ?>
        </section>

        <!-- Server Section -->
        <section id="server" class="error-section">
            <h2 class="section-title">
                <i class="bi bi-hdd-rack"></i> Server
            </h2>

            <!-- $_SERVER -->
            <div class="server-dump-container expanded">
                <div class="server-dump-header" onclick="this.parentElement.classList.toggle('expanded')">
                    <i class="bi bi-chevron-right"></i>
                    <span>$_SERVER</span>
                    <span class="server-dump-count"><?php echo count($_SERVER);?> items</span>
                </div>
                <div class="server-dump-content">
                    <table class="server-dump-table">
                        <thead>
                            <tr>
                                <th>Key</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php
                            foreach ($_SERVER as $key => $value) {
                                ?>
                                <tr>
                                    <td class="server-key"><?php echo htmlentities($key, ENT_QUOTES, 'UTF-8');?></td>
                                    <td class="server-value"><?php echo htmlentities(is_array($value) ? json_encode($value) : (string) $value, ENT_QUOTES, 'UTF-8');?></td>
                                </tr>
                                <?php
                            }
                            ?>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- $_ENV -->
            <?php
            if (!empty($_ENV)) {
                ?>
                <div class="server-dump-container">
                    <div class="server-dump-header" onclick="this.parentElement.classList.toggle('expanded')">
                        <i class="bi bi-chevron-right"></i>
                        <span>$_ENV</span>
                        <span class="server-dump-count"><?php echo count($_ENV);?> items</span>
                    </div>
                    <div class="server-dump-content">
                        <table class="server-dump-table">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                foreach ($_ENV as $key => $value) {
                                    ?>
                                <tr>
                                    <td class="server-key"><?php echo htmlentities($key, ENT_QUOTES, 'UTF-8');?></td>
                                    <td class="server-value"><?php echo htmlentities(is_array($value) ? json_encode($value) : (string) $value, ENT_QUOTES, 'UTF-8');?></td>
                                </tr>
                                    <?php
                                }
                                ?>
                            </tbody>
                        </table>
                    </div>
                </div>
                <?php
            }
            ?>
        </section>

        <!-- Context Section -->
        <?php
        if (!empty($exception->getTrace())) {
            ?>
            <section id="context" class="error-section">
                <h2 class="section-title">
                    <i class="bi bi-info-circle"></i> Context
                </h2>
                <div class="context-grid">
                    <div class="context-card">
                        <h3><i class="bi bi-box"></i> Blesta Version</h3>
                        <p><?php echo defined('BLESTA_VERSION') ? BLESTA_VERSION : 'N/A';?></p>
                    </div>
                    <div class="context-card">
                        <h3><i class="bi bi-filetype-php"></i> PHP Version</h3>
                        <p><?php echo phpversion();?></p>
                    </div>
                    <div class="context-card">
                        <h3><i class="bi bi-database"></i> MySQL Version</h3>
                        <p><?php
                        $mysql_version = 'N/A';
                        if (class_exists('PDO') && Configure::get('Blesta.database_info')) {
                            try {
                                $db_info = Configure::get('Blesta.database_info');
                                $pdo = new PDO(
                                    'mysql:host=' . ($db_info['host'] ?? 'localhost'),
                                    $db_info['user'] ?? '',
                                    $db_info['pass'] ?? ''
                                );
                                $mysql_version = $pdo->getAttribute(PDO::ATTR_SERVER_VERSION);
                            } catch (\Throwable $e) {
                                $mysql_version = 'N/A';
                            }
                        }
                        echo $mysql_version;
                        ?></p>
                    </div>
                    <div class="context-card">
                        <h3><i class="bi bi-shield-lock"></i> OpenSSL Version</h3>
                        <p><?php echo defined('OPENSSL_VERSION_TEXT') ? preg_replace('/^OpenSSL\s+/', '', OPENSSL_VERSION_TEXT) : 'N/A';?></p>
                    </div>
                    <div class="context-card">
                        <h3><i class="bi bi-pc-display"></i> Operating System</h3>
                        <p><?php echo PHP_OS . ' ' . php_uname('r');?></p>
                    </div>
                    <div class="context-card">
                        <h3><i class="bi bi-server"></i> Server API</h3>
                        <p><?php echo php_sapi_name();?></p>
                    </div>
                    <div class="context-card">
                        <h3><i class="bi bi-clock"></i> Time</h3>
                        <p><?php echo date('Y-m-d H:i:s');?></p>
                    </div>
                    <div class="context-card">
                        <h3><i class="bi bi-memory"></i> Memory</h3>
                        <p><?php echo round(memory_get_peak_usage(true) / 1024 / 1024, 2);?> MB</p>
                    </div>
                </div>
            </section>
            <?php
        }
        ?>

        <footer>
            <img src="<?php echo $this->view_dir;?>images/logo.svg" />
        </footer>
    </div>
</div>
    <?php
} else {
    ?>
<div class="error-production-container">
    <div class="error-production-content">
        <div class="error-icon">
            <i class="bi bi-exclamation-circle"></i>
        </div>
        <h1 class="error-title">500</h1>
        <h2 class="error-subtitle">Internal Server Error</h2>
        <p class="error-description">
            <?php
            if (!empty($error)) {
                echo $error;
            } else {
                ?>
                Something went wrong on our end. Please try again later or contact support if the problem persists.
                <?php
            }
            ?>
        </p>
        <div class="error-actions">
            <a href="javascript:history.back()" class="error-btn error-btn-secondary">
                <i class="bi bi-arrow-left"></i> Go Back
            </a>
            <a href="<?php echo defined('WEBDIR') ? WEBDIR : ('://' . $_SERVER['HTTP_HOST']);?>" class="error-btn error-btn-primary">
                <i class="bi bi-house"></i> Home
            </a>
        </div>
    </div>
</div>
    <?php
}
