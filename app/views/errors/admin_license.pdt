<?php /** @var View $this **/ ?>

<div class="license-container">
    <div class="license-content">
        <div class="license-icon">
            <i class="bi bi-shield-exclamation"></i>
        </div>

        <h1 class="license-title">License Invalid</h1>
        <p class="license-subtitle">Your Blesta license could not be validated</p>

        <?php
        if (($errors ?? null)) {
            ?>
        <div class="license-errors">
            <div class="license-errors-body">
                <?php
                foreach ($errors as $field => $errors) {
                    foreach ($errors as $key => $message_text) {
                        ?>
                <div class="license-error-item">
                    <i class="bi bi-x-circle"></i>
                    <span><?php echo (isset($message_text) ? $this->Html->safe($message_text, true) : null);?></span>
                </div>
                        <?php
                    }
                }
                ?>
            </div>
        </div>
            <?php
        }
        ?>

        <div class="license-form-container">
            <?php
            $this->Form->create(null, ['class' => 'license-form disable-on-submit']);
            ?>
            <div class="license-input-group">
                <label for="key" class="license-label">
                    <i class="bi bi-key"></i>
                    License Key
                </label>
                <?php
                $this->Form->fieldText('key', ($vars->key ?? null), [
                    'id' => 'key',
                    'class' => 'license-input',
                    'placeholder' => 'Enter your license key'
                ]);
                ?>
            </div>
            <div class="license-actions">
                <?php
                $this->Form->fieldSubmit('update', 'Validate License', ['class' => 'license-submit-btn']);
                ?>
            </div>
            <?php
            $this->Form->end();
            ?>
        </div>

        <div class="license-help">
            <p>Need help? Visit <a href="https://www.blesta.com/about/" target="_blank" rel="noopener">Blesta</a> or check your <a href="https://account.blesta.com/" target="_blank" rel="noopener">client area</a>.</p>
        </div>
    </div>
</div>
