<?php /** @var View $this **/ ?>

<div class="login-container">
    <div class="login-brand-panel">
        <div class="brand-content">
            <?php
            if (!empty($theme_logo)) {
                ?>
                <img<?php echo (!empty($admin_logo_height) ? ' style="height: ' . $admin_logo_height . 'px;"' : '');?> src="<?php echo $this->Html->safe(($theme_logo_dark ?? null) ?: $theme_logo);?>" alt="<?php echo $this->Html->safe($system_company->name ?? 'Blesta');?>" class="brand-logo brand-logo-dark" />
                <img<?php echo (!empty($admin_logo_height) ? ' style="height: ' . $admin_logo_height . 'px;"' : '');?> src="<?php (print (isset($theme_logo) ? $this->Html->safe($theme_logo) : null));?>" alt="<?php echo $this->Html->safe($system_company->name ?? 'Blesta');?>" class="brand-logo brand-logo-light" />
                <?php
            } else {
                ?>
                <img src="<?php echo $this->view_dir . 'images/logo.svg';?>" alt="Blesta" class="brand-logo brand-logo-dark">
                <img src="<?php echo $this->view_dir . 'images/logo-color.svg';?>" alt="Blesta" class="brand-logo brand-logo-light">
                <?php
            }
            ?>
            <h2 class="brand-title"><?php echo $this->Html->safe($system_company->name ?? 'Blesta');?></h2>
            <p class="brand-subtitle"><?php $this->_('AdminLogin.confirmreset.page_subtitle', false);?></p>
        </div>
    </div>

    <div class="login-form-panel">
        <div class="login-form-container">
            <div class="login-card">
                <div class="login-header">
                    <h1><?php $this->_('AdminLogin.confirmreset.title_adminarea', false);?></h1>
                    <p><?php $this->_('AdminLogin.confirmreset.subtitle_adminarea', false);?></p>
                </div>

                <?php echo ($message ?? null);?>

                <?php
                $this->Form->create(null, ['class' => 'disable-on-submit']);
                ?>
                    <div class="form-group">
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock input-icon"></i>
                            <?php
                            $this->Form->fieldPassword(
                                'new_password',
                                [
                                    'id' => 'new_password',
                                    'class' => 'form-control form-control-modern',
                                    'tabindex' => 1,
                                    'placeholder' => $this->_('AdminLogin.confirmreset.field_new_password', true),
                                    'autocomplete' => 'new-password',
                                    'autofocus' => 'autofocus'
                                ]
                            );
                            ?>
                            <button type="button" class="password-toggle" id="new-password-toggle" aria-label="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock input-icon"></i>
                            <?php
                            $this->Form->fieldPassword(
                                'confirm_password',
                                [
                                    'id' => 'confirm_password',
                                    'class' => 'form-control form-control-modern',
                                    'tabindex' => 2,
                                    'placeholder' => $this->_('AdminLogin.confirmreset.field_confirm_password', true),
                                    'autocomplete' => 'new-password'
                                ]
                            );
                            ?>
                            <button type="button" class="password-toggle" id="confirm-password-toggle" aria-label="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success btn-login" id="reset-button">
                        <span id="reset-button-text">
                            <i class="bi bi-key me-2"></i> <?php $this->_('AdminLogin.confirmreset.field_resetsubmit');?>
                        </span>
                    </button>

                    <div class="forgot-password">
                        <a href="<?php echo $this->base_uri . 'login/';?>" id="login-link"><?php $this->_('AdminLogin.confirmreset.link_login');?></a>
                    </div>
                <?php
                $this->Form->end();
                ?>
            </div>
        </div>
    </div>
</div>
