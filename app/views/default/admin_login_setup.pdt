<?php
$this->Javascript->setInline('
    document.addEventListener("DOMContentLoaded", function() {
        const passFields = document.querySelectorAll("#password, #confirm-password");
        const emailField = document.getElementById("email");
        const otherFields = document.querySelectorAll("#first_name, #last_name, #username, #license-key");

        showLicenseKey();
        showNewsletterField();
        validatePasswordMatch();

        document.querySelectorAll(".license_type").forEach(function(el) {
            el.addEventListener("change", function() {
                showLicenseKey();
                showNewsletterField();
            });
        });

        passFields.forEach(function(el) {
            el.addEventListener("input", function() {
                validatePasswordMatch();
            });
        });

        if (emailField) {
            emailField.addEventListener("input", function() {
                validateEmail();
            });
        }

        otherFields.forEach(function(el) {
            el.addEventListener("input", function() {
                validateNotEmpty(this);
            });
        });

        function showLicenseKey() {
            const haveLicense = document.getElementById("have-license");
            const licenseKeyGroup = document.getElementById("license-key-group");
            if (haveLicense && licenseKeyGroup) {
                if (haveLicense.checked) {
                    licenseKeyGroup.style.display = "block";
                } else {
                    licenseKeyGroup.style.display = "none";
                }
            }
        }

        function showNewsletterField() {
            const freeTrial = document.getElementById("free-trial");
            const newsletter = document.getElementById("newsletter");
            const textTrialNewsletter = document.getElementById("text-trial-newsletter");
            if (freeTrial && newsletter && textTrialNewsletter) {
                if (freeTrial.checked) {
                    newsletter.checked = true;
                    newsletter.disabled = true;
                    textTrialNewsletter.style.display = "block";
                } else {
                    newsletter.disabled = false;
                    textTrialNewsletter.style.display = "none";
                }
            }
        }

        function validatePasswordMatch() {
            var password = document.getElementById("password") ? document.getElementById("password").value : "";
            var confirm_password = document.getElementById("confirm-password") ? document.getElementById("confirm-password").value : "";

            passFields.forEach(function(el) {
                if (password === "" && confirm_password === "") {
                    el.classList.remove("is-valid", "is-invalid");
                } else if (password === confirm_password) {
                    el.classList.remove("is-invalid");
                    el.classList.add("is-valid");
                } else {
                    el.classList.remove("is-valid");
                    el.classList.add("is-invalid");
                }
            });
        }

        function validateEmail() {
            var email = emailField ? emailField.value : "";
            var email_regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if (emailField) {
                if (email === "") {
                    emailField.classList.remove("is-valid", "is-invalid");
                } else if (email_regex.test(email)) {
                    emailField.classList.remove("is-invalid");
                    emailField.classList.add("is-valid");
                } else {
                    emailField.classList.remove("is-valid");
                    emailField.classList.add("is-invalid");
                }
            }
        }

        function validateNotEmpty(element) {
            if (element.value === "") {
                element.classList.remove("is-valid");
            } else {
                element.classList.add("is-valid");
            }
        }
    });
');
