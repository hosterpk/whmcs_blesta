<?php /** @var View $this **/ ?>

<div class="login-container">
    <div class="login-brand-panel">
        <div class="brand-content">
            <?php
            if (!empty($theme_logo)) {
                ?>
                <img<?php echo (!empty($admin_logo_height) ? ' style="height: ' . $admin_logo_height . 'px;"' : '');?> src="<?php echo $this->Html->safe(($theme_logo_dark ?? null) ?: $theme_logo);?>" alt="<?php echo $this->Html->safe($system_company->name ?? 'Blesta');?>" class="brand-logo brand-logo-dark" />
                <img<?php echo (!empty($admin_logo_height) ? ' style="height: ' . $admin_logo_height . 'px;"' : '');?> src="<?php (print (isset($theme_logo) ? $this->Html->safe($theme_logo) : null));?>" alt="<?php echo $this->Html->safe($system_company->name ?? 'Blesta');?>" class="brand-logo brand-logo-light" />
                <?php
            } else {
                ?>
                <img src="<?php echo $this->view_dir . 'images/logo.svg';?>" alt="Blesta" class="brand-logo brand-logo-dark">
                <img src="<?php echo $this->view_dir . 'images/logo-color.svg';?>" alt="Blesta" class="brand-logo brand-logo-light">
                <?php
            }
            ?>
            <h2 class="brand-title"><?php echo $this->Html->safe($system_company->name ?? 'Blesta');?></h2>
            <p class="brand-subtitle"><?php $this->_('AdminLogin.index.page_subtitle', false);?></p>
        </div>
    </div>

    <div class="login-form-panel">
        <div class="login-form-container">
            <div class="login-card">
                <div class="login-header">
                    <h1><?php $this->_('AdminLogin.index.title_adminarea', false);?></h1>
                    <p><?php $this->_('AdminLogin.index.subtitle_adminarea', false);?></p>
                </div>

                <?php echo ($message ?? null);?>

                <?php
                $this->Form->create(null, ['class' => 'disable-on-submit']);
                ?>
                    <div class="form-group">
                        <div class="input-icon-wrapper">
                            <i class="bi bi-person input-icon"></i>
                            <?php
                            $this->Form->fieldText(
                                'username',
                                ($vars->username ?? null),
                                [
                                    'id' => 'username',
                                    'class' => 'form-control form-control-modern',
                                    'tabindex' => 1,
                                    'placeholder' => $this->_('AdminLogin.index.field_username', true),
                                    'autocomplete' => 'username',
                                    'autofocus' => 'autofocus'
                                ]
                            );
                            ?>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock input-icon"></i>
                            <?php
                            $this->Form->fieldPassword(
                                'password',
                                [
                                    'id' => 'password',
                                    'class' => 'form-control form-control-modern',
                                    'tabindex' => 2,
                                    'placeholder' => $this->_('AdminLogin.index.field_password', true),
                                    'autocomplete' => 'current-password'
                                ]
                            );
                            ?>
                            <button type="button" class="password-toggle" id="password-toggle" aria-label="Toggle password visibility">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <?php
                    if (($captcha ?? null)) {
                        ?>
                    <div class="form-check-modern">
                        <?php echo $captcha;?>
                    </div>
                        <?php
                    }
                    ?>

                    <div class="form-check-modern">
                        <?php
                        $this->Form->fieldCheckbox(
                            'remember_me',
                            'true',
                            ($vars->remember_me ?? null) == 'true',
                            [
                                'class' => 'form-check-input',
                                'id' => 'remember-me',
                                'tabindex' => 3
                            ]
                        );
                        ?>
                        <label class="form-check-label" for="remember-me">
                            <?php $this->_('AdminLogin.index.field_rememberme');?>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-login" id="login-button">
                        <span id="login-button-text">
                            <i class="bi bi-box-arrow-in-right me-2"></i> <?php $this->_('AdminLogin.index.field_loginsubmit');?>
                        </span>
                    </button>

                    <div class="forgot-password">
                        <a href="<?php echo $this->base_uri . 'login/reset/';?>" id="forgot-password-link"><?php $this->_('AdminLogin.index.link_resetpassword');?></a>
                    </div>
                <?php
                $this->Form->end();
                ?>
            </div>
        </div>
    </div>
</div>