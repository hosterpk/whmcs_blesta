    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminBilling.quotations.no_results');?></p>
</div>
<?php
}

$this->Widget->end();
?>

<script type="text/javascript">
(function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var widgetId = 'admin_billing_quotations';

    var quotationsTable = document.getElementById('quotations');
    if (!quotationsTable) return;

    // Initialize tooltips
    function initTooltips() {
        var w = document.getElementById(widgetId);
        if (w) {
            w.querySelectorAll('#quotations [data-bs-toggle="tooltip"]').forEach(function(el) {
                new bootstrap.Tooltip(el);
            });
        }
    }

    initTooltips();

    // Register persistent event handlers only once (survives AJAX content replacement)
    var widget = document.getElementById(widgetId);
    var isAjaxReload = widget && widget.hasAttribute('data-handlers-init');

    if (widget && !isAjaxReload) {
        widget.setAttribute('data-handlers-init', 'true');

        // Lazy-load quotation invoices when collapse row is shown
        document.addEventListener('show.bs.collapse', function(e) {
            var collapseRow = e.target.closest('tr.collapse');
            var w = document.getElementById(widgetId);
            if (!collapseRow || !w || !w.contains(collapseRow)) return;

            var container = collapseRow.querySelector('.quotation-invoices-container');
            if (!container || container.hasAttribute('data-loaded')) return;

            var quotationId = container.getAttribute('data-quotation-id');
            container.setAttribute('data-loaded', 'true');

            fetch(baseUri + 'billing/quotationinvoices/' + quotationId + '/', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(response) { return response.text(); })
            .then(function(html) {
                container.innerHTML = html;
            })
            .catch(function() {
                container.innerHTML = '<div class="alert alert-danger m-3">Error loading quotation details.</div>';
                container.removeAttribute('data-loaded');
            });
        });

        // Event delegation for click handlers within the widget
        widget.addEventListener('click', function(e) {
            // Handle approve quotation confirmation
            var approveBtn = e.target.closest('.approve-quotation');
            if (approveBtn) {
                e.preventDefault();
                var message = approveBtn.getAttribute('data-confirm-message') || '';
                var href = approveBtn.getAttribute('href');

                var modalEl = document.createElement('div');
                modalEl.className = 'modal fade';
                modalEl.setAttribute('tabindex', '-1');
                modalEl.innerHTML =
                    '<div class="modal-dialog modal-dialog-centered">' +
                    '<div class="modal-content">' +
                    '<div class="modal-header border-0 pb-0">' +
                    '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<?php $this->_("AppController.modal.text_close");?>"></button>' +
                    '</div>' +
                    '<div class="modal-body text-center py-4">' +
                    '<div class="mb-3"><i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i></div>' +
                    '<h5 class="modal-title mb-3"><?php $this->_("AppController.modal.text_confirm");?></h5>' +
                    '<p class="text-secondary">' + message + '</p>' +
                    '</div>' +
                    '<div class="modal-footer border-0 justify-content-center">' +
                    '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><?php $this->_("AppController.modal.btn_cancel");?></button>' +
                    '<button type="button" class="btn btn-success btn-confirm">Confirm</button>' +
                    '</div>' +
                    '</div>' +
                    '</div>';

                document.body.appendChild(modalEl);
                var modal = new bootstrap.Modal(modalEl);
                var confirmed = false;

                modalEl.querySelector('.btn-confirm').addEventListener('click', function() {
                    confirmed = true;
                    this.blur();
                    modal.hide();
                });

                modalEl.addEventListener('hidden.bs.modal', function() {
                    modalEl.remove();
                    if (confirmed) {
                        window.location = href;
                    }
                });

                modal.show();
                return;
            }

            // Handle invoice quotation modal
            var invoiceBtn = e.target.closest('.invoice-quotation-modal');
            if (invoiceBtn) {
                e.preventDefault();
                var url = invoiceBtn.getAttribute('href');

                var modal = document.getElementById('quotationInvoiceModal');
                if (!modal) {
                    modal = document.createElement('div');
                    modal.id = 'quotationInvoiceModal';
                    modal.className = 'modal fade';
                    modal.tabIndex = -1;
                    modal.innerHTML =
                        '<div class="modal-dialog modal-lg">' +
                            '<div class="modal-content">' +
                                '<div class="modal-header">' +
                                    '<h5 class="modal-title"><?php $this->_('AdminBilling.quotations.option_invoice');?></h5>' +
                                    '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<?php $this->_('AppController.modal.text_close');?>"></button>' +
                                '</div>' +
                                '<div class="modal-body"></div>' +
                                '<div class="modal-footer">' +
                                    '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><?php $this->_('AppController.modal.btn_cancel');?></button>' +
                                    '<button type="button" class="btn btn-primary btn-submit"><?php $this->_('AdminClients.invoicequotation.field_submit');?></button>' +
                                '</div>' +
                            '</div>' +
                        '</div>';
                    document.body.appendChild(modal);

                    modal.querySelector('.btn-submit').addEventListener('click', function() {
                        var form = modal.querySelector('form');
                        if (form) form.submit();
                    });
                }

                var modalBody = modal.querySelector('.modal-body');
                modalBody.innerHTML =
                    '<div class="text-center py-4">' +
                        '<div class="spinner-border" role="status">' +
                            '<span class="visually-hidden">Loading...</span>' +
                        '</div>' +
                    '</div>';

                var bsModal = new bootstrap.Modal(modal);
                bsModal.show();

                fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(response) { return response.text(); })
                .then(function(html) {
                    modalBody.innerHTML = html;

                    // Execute scripts from fetched content (innerHTML doesn't execute <script> tags)
                    modalBody.querySelectorAll('script').forEach(function(oldScript) {
                        var newScript = document.createElement('script');
                        newScript.textContent = oldScript.textContent;
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                })
                .catch(function() {
                    modalBody.innerHTML = '<div class="alert alert-danger">Error loading content.</div>';
                });
            }
        });
    }

    // Re-initialize expandable rows for AJAX-loaded widget
    document.dispatchEvent(new Event('blestaAjaxComplete'));
})();
</script>
