        'current' => (($status ?? null) == $status_id),
        'attributes' => ['href' => $this->base_uri . 'billing/quotations/' . $status_id . '/']
    ];
}

$this->Widget->clear();
$this->Widget->setTabs($tabs);
$this->Widget->setNavStyle('nav-tabs-custom');
$this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'billing/quotations/' . ($status ?? 'pending') . '/'), !empty($filter_vars));
$this->Widget->setAjaxFiltering();
