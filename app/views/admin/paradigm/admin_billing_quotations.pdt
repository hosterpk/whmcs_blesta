            for ($i = 0; $i < $num_quotations; $i++) {
                $expired = (($status ?? null) == 'expired' && $this->Date->toTime($this->Date->cast($quotations[$i]->date_expires)) < $this->Date->toTime(date('c')));
            ?>
            <tr style="cursor: pointer;" <?php echo (($status ?? null) != 'draft' ? 'data-collapse-row aria-expanded="false"' : '');?> class="quotation-row<?php echo (($status ?? null) == 'draft' ? ' no-expand' : '');?>">
                <td><?php echo (isset($quotations[$i]->id_code) ? $this->Html->safe($quotations[$i]->id_code) : null);?></td>
                <td>
                    <a href="<?php echo $this->base_uri . 'clients/view/' . (isset($quotations[$i]->client_id) ? $this->Html->safe($quotations[$i]->client_id) : null);?>" data-bs-toggle="tooltip" title="<?php echo (isset($quotations[$i]->client_first_name) ? $this->Html->safe($quotations[$i]->client_first_name) : null) . ' ' . (isset($quotations[$i]->client_last_name) ? $this->Html->safe($quotations[$i]->client_last_name) : null) . ($quotations[$i]->client_company ? ' - ' . $this->Html->safe($quotations[$i]->client_company) : '');?>">
                        <?php (print (isset($quotations[$i]->client_id_code) ? $this->Html->safe($quotations[$i]->client_id_code) : null));?>
                    </a>
