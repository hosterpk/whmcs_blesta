                ?>
                <td>
                    <div class="d-flex gap-2">
                        <a href="<?php echo $this->base_uri . 'clients/viewquotation/' . (isset($quotations[$i]->client_id) ? $this->Html->safe($quotations[$i]->client_id) : null) . '/' . (isset($quotations[$i]->id) ? $this->Html->safe($quotations[$i]->id) : null) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminBilling.quotations.option_view');?>">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="<?php echo $this->base_uri . 'clients/editquotation/' . (isset($quotations[$i]->client_id) ? $this->Html->safe($quotations[$i]->client_id) : null) . '/' . (isset($quotations[$i]->id) ? $this->Html->safe($quotations[$i]->id) : null) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminBilling.quotations.option_edit');?>">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <?php
                        if ($status == 'approved') {
                        ?>
                        <a href="<?php echo $this->base_uri . 'clients/invoicequotation/' . (isset($quotations[$i]->client_id) ? $this->Html->safe($quotations[$i]->client_id) : null) . '/' . (isset($quotations[$i]->id) ? $this->Html->safe($quotations[$i]->id) : null) . '/';?>" class="btn btn-sm btn-outline-primary invoice-quotation-modal" title="<?php $this->_('AdminBilling.quotations.option_invoice');?>">
                            <i class="bi bi-receipt"></i>
                        </a>
                        <?php
                        }
                        if ($status == 'pending') {
                        ?>
                        <a href="<?php echo $this->base_uri . 'clients/approvequotation/' . (isset($quotations[$i]->client_id) ? $this->Html->safe($quotations[$i]->client_id) : null) . '/' . (isset($quotations[$i]->id) ? $this->Html->safe($quotations[$i]->id) : null) . '/';?>" class="btn btn-sm btn-outline-success approve-quotation" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminBilling.quotations.confirm_approve', true));?>" title="<?php $this->_('AdminBilling.quotations.option_approve');?>">
                            <i class="bi bi-check-lg"></i>
                        </a>
                        <?php
                        }
                        ?>
                    </div>
                </td>
            </tr>
            <?php if (($status ?? null) != 'draft') { ?>
            <!-- Expandable Row -->
            <tr class="collapse">
                <td colspan="<?php echo (($status ?? null) !== 'approved' ? '9' : '8');?>" style="padding: 0; background-color: var(--bg-secondary);">
                    <div class="quotation-invoices-container" data-quotation-id="<?php echo (isset($quotations[$i]->id) ? $this->Html->safe($quotations[$i]->id) : null);?>">
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-secondary" role="status">
