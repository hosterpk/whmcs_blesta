<?php /** @var View $this **/ ?>

            <?php
            if (!empty($actions)) {
            ?>
            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <span><?php $this->_('AdminCompanyPlugins.settings.actions_description');?></span>
            </div>
            <?php
            }

            $i = 0;
            foreach ((isset($location_descriptions) ? $location_descriptions : []) as $location => $description) {
                if (array_key_exists($location, (array)$actions)) {
            ?>
            <h6 class="form-section-header<?php echo ($i > 0 ? ' mt-4' : '');?>"><?php echo $this->Html->safe((isset($description) ? $description : null));?></h6>

            <?php
                foreach ((isset($actions[$location]) ? $actions[$location] : []) as $action) {
                    $key = (isset($location) ? $location : null) . '-' . (isset($action->url) ? $action->url : null);
            ?>
            <div class="mb-4 p-3" style="background-color: var(--secondary-bg); border-radius: 0.375rem;">
                <h6 class="mb-2"><?php echo (isset($action->name) ? $this->Html->safe($action->name) : null);?></h6>
                <p class="text-muted small mb-3"><?php $this->_('AdminCompanyPlugins.settings.actions_uri', false, $this->Html->safe($action->full_uri));?></p>

                <div class="form-check mb-2">
                    <?php
                    $this->Form->fieldCheckbox(
                        'enabled[' . $key . ']',
                        '1',
                        ((isset($action->enabled) ? $action->enabled : null) == '1'),
                        ['id' => 'enabled_' . str_replace(['[', ']', '-'], '_', $key), 'class' => 'form-check-input']
                    );
                    $this->Form->label(
                        $this->_('AdminCompanyPlugins.settings.field_enabled', true),
                        'enabled_' . str_replace(['[', ']', '-'], '_', $key),
                        ['class' => 'form-check-label']
                    );
                    ?>
                </div>

                <?php
                if (!empty($action->sub)) {
                ?>
                <h6 class="mb-2 mt-3"><?php $this->_('AdminCompanyPlugins.settings.actions_heading_sub');?></h6>
                    <?php
                    foreach ((isset($action->sub) ? $action->sub : []) as $index => $sub) {
                        $field_name = $key . '[sub][enabled][' . $index . ']';
                        $field_id = 'sub_' . str_replace(['[', ']', '-'], '_', $key . '_' . $index);
                    ?>
                <div class="mb-3 p-2" style="background-color: var(--body-bg); border-radius: 0.25rem;">
                    <h6 class="mb-1" style="font-size: 0.9rem;"><?php echo (isset($sub['name']) ? $this->Html->safe($sub['name']) : null);?></h6>
                    <p class="text-muted small mb-2"><?php $this->_('AdminCompanyPlugins.settings.actions_uri', false, $this->Html->safe($sub['full_uri']));?></p>

                    <div class="form-check mb-0">
                        <?php
                        $this->Form->fieldCheckbox(
                            $field_name,
                            '1',
                            ((isset($sub['enabled']) ? $sub['enabled'] : '1') == '1'),
                            ['id' => $field_id, 'class' => 'form-check-input']
                        );
                        $this->Form->label(
                            $this->_('AdminCompanyPlugins.settings.field_enabled', true),
                            $field_id,
                            ['class' => 'form-check-label']
                        );
                        ?>
                    </div>
                </div>
                    <?php
                    }
                }

                if (!empty($action->secondary)) {
                ?>
                <h6 class="mb-2 mt-3"><?php $this->_('AdminCompanyPlugins.settings.actions_heading_secondary');?></h6>
                    <?php
                    foreach ((isset($action->secondary) ? $action->secondary : []) as $index => $secondary) {
                        $field_name = $key . '[secondary][enabled][' . $index . ']';
                        $field_id = 'secondary_' . str_replace(['[', ']', '-'], '_', $key . '_' . $index);
                    ?>
                <div class="mb-3 p-2" style="background-color: var(--body-bg); border-radius: 0.25rem;">
                    <h6 class="mb-1" style="font-size: 0.9rem;"><?php echo (isset($secondary['name']) ? $this->Html->safe($secondary['name']) : null);?></h6>
                    <p class="text-muted small mb-2"><?php $this->_('AdminCompanyPlugins.settings.actions_uri', false, $this->Html->safe($secondary['full_uri']));?></p>

                    <div class="form-check mb-0">
                        <?php
                        $this->Form->fieldCheckbox(
                            $field_name,
                            '1',
                            ((isset($secondary['enabled']) ? $secondary['enabled'] : '1') == '1'),
                            ['id' => $field_id, 'class' => 'form-check-input']
                        );
                        $this->Form->label(
                            $this->_('AdminCompanyPlugins.settings.field_enabled', true),
                            $field_id,
                            ['class' => 'form-check-label']
                        );
                        ?>
                    </div>
                </div>
                    <?php
                    }
                }
                ?>
            </div>
            <?php
                }
                $i++;
                }
            }

            if (empty($actions)) {
            ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyPlugins.settings.actions_no_results');?></p>
            </div>
            <?php
            }
            ?>
