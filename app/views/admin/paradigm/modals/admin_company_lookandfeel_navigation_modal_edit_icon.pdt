            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="editIconSubmit">
                    <i class="bi bi-check-lg me-1"></i><?php $this->_('AdminCompanyLookandfeel.navigation.save_icon');?>
