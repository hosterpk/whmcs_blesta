<?php /** @var View $this **/ ?>

        <div class="main-content-padding">
            <?php echo (isset($message) ? $message : null);?>

            <?php
            $this->Widget->clear();
            $this->Widget->create($this->_('AdminCompanyFeeds.index.boxtitle_data_feeds', true), ['id' => 'admin_company_feeds']);

            $this->Form->create(null, ['class' => 'disable-on-submit']);
            ?>
                    <p class="mb-3"><?php $this->_('AdminCompanyFeeds.index.data_feeds_description');?></p>

                    <div class="form-check">
                        <?php
                        $this->Form->fieldCheckbox(
                            'enable_data_feeds',
                            '1',
                            ($vars['enable_data_feeds'] ?? '0') == '1',
                            ['id' => 'enable_data_feeds', 'class' => 'form-check-input']
                        );
                        ?>
                        <label for="enable_data_feeds" class="form-check-label">
                            <?php $this->_('AdminCompanyFeeds.index.field_enable_data_feeds');?>
                        </label>
                    </div>
                <?php $this->Widget->footer(); ?>
                <div class="d-flex justify-content-end">
                    <?php
                    $this->Form->fieldSubmit(
                        'save',
                        $this->_('AdminCompanyFeeds.index.field_submit', true),
                        ['class' => 'btn btn-primary']
                    );
                    ?>
                </div>
                <?php
                $this->Form->end();
                $this->Widget->end();
                ?>
        </div>
