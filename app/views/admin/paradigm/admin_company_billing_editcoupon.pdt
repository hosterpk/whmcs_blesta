<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Bootstrap tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Select all assigned packages on submit
    document.getElementById('coupon').addEventListener('submit', function() {
        const assignedSelect = document.getElementById('assigned');
        if (assignedSelect) {
            Array.from(assignedSelect.options).forEach(option => option.selected = true);
        }

        // Also set hidden inputs for draggable items
        const assignedPackages = document.getElementById('assigned_packages');
        const items = assignedPackages.querySelectorAll('.drag-item');
        const hiddenSelect = document.getElementById('assigned');

        // Clear existing options
        hiddenSelect.innerHTML = '';

        // Add all assigned packages as selected options
        items.forEach(item => {
            const option = document.createElement('option');
            option.value = item.getAttribute('data-value');
            option.selected = true;
            hiddenSelect.appendChild(option);
        });
    });

    // Currency row add/remove functionality
    const currencyRowsContainer = document.getElementById('currency_rows');
    const addCurrencyBtn = document.querySelector('.currency_row_add');

    function updateRemoveButtons() {
        const rows = currencyRowsContainer.querySelectorAll('.currency_row');
        rows.forEach(row => {
            const removeBtn = row.querySelector('.currency_row_remove');
            if (rows.length === 1) {
                removeBtn.disabled = true;
                removeBtn.style.opacity = '0.5';
            } else {
                removeBtn.disabled = false;
                removeBtn.style.opacity = '1';
            }
        });
    }

    addCurrencyBtn?.addEventListener('click', function() {
        const firstRow = currencyRowsContainer.querySelector('.currency_row');
        const newRow = firstRow.cloneNode(true);

        // Clear values in cloned row
        newRow.querySelectorAll('select, input').forEach(field => {
            if (field.tagName === 'SELECT') {
                field.selectedIndex = 0;
            } else {
                field.value = '';
            }
        });

        currencyRowsContainer.appendChild(newRow);
        updateRemoveButtons();
    });

    currencyRowsContainer?.addEventListener('click', function(e) {
        if (e.target.closest('.currency_row_remove')) {
            const rows = currencyRowsContainer.querySelectorAll('.currency_row');
            if (rows.length > 1) {
                e.target.closest('.currency_row').remove();
                updateRemoveButtons();
            }
        }
    });

    updateRemoveButtons();

    // Generate coupon code
    const generateCodeBtn = document.querySelector('.generate-code');
    const codeInput = document.getElementById('code');

    generateCodeBtn?.addEventListener('click', function() {
        const length = Math.floor(Math.random() * 5) + 8;
        const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let code = '';
        for (let i = 0; i < length; i++) {
            code += characters.charAt(Math.floor(Math.random() * characters.length));
        }
        codeInput.value = code;
    });

    // Show/hide renew limitation
    const recurringRadios = document.querySelectorAll('.recurring');
    const renewLimitation = document.getElementById('renew_limitation');

    function showRenewLimitation() {
        const recurringYes = document.getElementById('recurring_yes');
        if (recurringYes && recurringYes.checked) {
            renewLimitation.style.display = '';
        } else {
            renewLimitation.style.display = 'none';
            const limitRecurringNo = document.getElementById('limit_recurring_no');
            if (limitRecurringNo) {
                limitRecurringNo.checked = true;
            }
        }
    }

    recurringRadios.forEach(radio => {
        radio.addEventListener('change', showRenewLimitation);
    });

    // Terms input handling
    const termsInputs = document.querySelectorAll('.terms');
    termsInputs.forEach(input => {
        input.addEventListener('input', function() {
            const index = this.id.replace('terms_', '');
            const checkbox = document.getElementById('enabled_' + index);
            if (checkbox) {
                checkbox.checked = this.value !== '';
            }
        });
    });

    // Package group filter
    const packageGroupSelect = document.getElementById('package_group_id');
    const availablePackages = document.getElementById('available_packages');

    function setAvailablePackages() {
        const selectedGroup = packageGroupSelect.value;
        const items = availablePackages.querySelectorAll('.drag-item');

        items.forEach(item => {
            if (selectedGroup === '') {
                item.style.display = '';
            } else {
                const itemClasses = item.className.split(' ');
                const groupClass = 'group_' + selectedGroup;
                if (itemClasses.includes(groupClass)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            }
        });
    }

    packageGroupSelect?.addEventListener('change', setAvailablePackages);

    // Drag & Drop Functionality
    const assignedPackagesList = document.getElementById('assigned_packages');
    const availablePackagesList = document.getElementById('available_packages');
    const moveLeftBtn = document.querySelector('.move_left');
    const moveRightBtn = document.querySelector('.move_right');

    let draggedItem = null;

    function setupDragItems() {
        document.querySelectorAll('#assigned_packages .drag-item, #available_packages .drag-item').forEach(item => {
            // Click to select
            item.addEventListener('click', function(e) {
                e.stopPropagation();
                if (e.ctrlKey || e.metaKey) {
                    this.classList.toggle('selected');
                } else {
                    document.querySelectorAll('.drag-item').forEach(i => i.classList.remove('selected'));
                    this.classList.add('selected');
                }
            });

            // Drag events
            item.addEventListener('dragstart', function(e) {
                draggedItem = this;
                this.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', this.textContent);
            });

            item.addEventListener('dragend', function(e) {
                this.classList.remove('dragging');
                document.querySelectorAll('.drag-list').forEach(l => l.classList.remove('drag-over'));
            });
        });

        // Setup drop zones
        [assignedPackagesList, availablePackagesList].forEach(list => {
            if (!list) return;

            list.addEventListener('dragover', function(e) {
                e.preventDefault();
                this.classList.add('drag-over');
            });

            list.addEventListener('dragleave', function(e) {
                if (!this.contains(e.relatedTarget)) {
                    this.classList.remove('drag-over');
                }
            });

            list.addEventListener('drop', function(e) {
                e.preventDefault();
                this.classList.remove('drag-over');

                if (draggedItem && draggedItem.parentNode !== this) {
                    this.appendChild(draggedItem);
                    draggedItem.classList.remove('selected');
                    draggedItem = null;
                }
            });
        });
    }

    setupDragItems();

    // Arrow button functionality
    moveLeftBtn?.addEventListener('click', function() {
        const selectedItems = availablePackagesList.querySelectorAll('.drag-item.selected');
        if (selectedItems.length > 0) {
            selectedItems.forEach(item => {
                assignedPackagesList.appendChild(item);
                item.classList.remove('selected');
            });
        }
    });

    moveRightBtn?.addEventListener('click', function() {
        const selectedItems = assignedPackagesList.querySelectorAll('.drag-item.selected');
        if (selectedItems.length > 0) {
            selectedItems.forEach(item => {
                availablePackagesList.appendChild(item);
                item.classList.remove('selected');
            });
        }
    });

    // Clear selection when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.drag-item')) {
            document.querySelectorAll('.drag-item.selected').forEach(item => item.classList.remove('selected'));
        }
    });

    // Package Options functionality
    const initialLoad = true;
    const packageOptionIndex = 0;
    const packageOptionId = '<?php echo ($vars->package_options[0]['option_id'] ?? '');?>';
    const packageOptionValue = '<?php echo !isset($vars->package_options[0]) ? '' : (!empty($vars->package_options[0]['option_value_ids']) ? json_encode($vars->package_options[0]['option_value_ids']) : ($vars->package_options[0]['regex_pattern'] ?? $vars->package_options[0]['min_quantity'] ?? ''));?>';
    const selectOptionText = '<?php echo $this->_('AdminCompanyBilling.editcoupon.text_select_option', true);?>';
    const baseUri = '<?php echo $this->Html->_($this->base_uri, true);?>';
    const optionValuesLabel = '<?php echo $this->_('AdminCompanyBilling.editcoupon.field_option_values', true);?>';
    const minQuantityLabel = '<?php echo $this->_('AdminCompanyBilling.editcoupon.field_min_quantity', true);?>';
    const regexPatternLabel = '<?php echo $this->_('AdminCompanyBilling.editcoupon.field_regex_pattern', true);?>';
    const anyValueText = '<?php echo $this->_('AdminCompanyBilling.editcoupon.text_any_value', true);?>';
    const tooltipText = '<?php echo $this->_('AppController.tooltip.text', true);?>';
    const regexTooltip = '<?php echo $this->_('AdminCompanyBilling.editcoupon.tooltip_regex_pattern', true);?>';

    // Handle option group selection
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('option_group_select')) {
            const groupId = e.target.value;
            const row = e.target.closest('tr');
            const optionSelect = row.querySelector('.option_select');
            const valuesField = row.querySelector('.option_values_field');

            // Reset option select and values
            optionSelect.innerHTML = '<option value="">' + selectOptionText + '</option>';
            valuesField.innerHTML = '<span class="text-muted">' + selectOptionText + '</span>';

            if (groupId) {
                optionSelect.disabled = false;

                fetch(baseUri + 'settings/company/billing/getpackageoptions/' + groupId, {
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    })
                    .then(response => response.json())
                    .then(data => {
                        Object.entries(data).forEach(([id, name]) => {
                            const option = document.createElement('option');
                            option.value = id;
                            option.textContent = name;
                            if (packageOptionId == id) {
                                option.selected = true;
                            }
                            optionSelect.appendChild(option);
                        });

                        if (packageOptionId && optionSelect.value === packageOptionId) {
                            optionSelect.dispatchEvent(new Event('change'));
                        }
                    });
            } else {
                optionSelect.disabled = true;
            }
        }

        if (e.target.classList.contains('option_select')) {
            const optionId = e.target.value;
            const row = e.target.closest('tr');
            const valuesField = row.querySelector('.option_values_field');
            const rowIndex = Array.from(row.parentNode.children).indexOf(row);

            valuesField.innerHTML = '<span class="text-muted">' + selectOptionText + '</span>';

            if (optionId) {
                fetch(baseUri + 'settings/company/billing/getpackageoptiondetails/' + optionId, {
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.type) {
                            buildOptionValuesField(valuesField, data, rowIndex);
                        }
                    });
            }
        }
    });

    function buildOptionValuesField(container, optionData, rowIndex) {
        let html = '';
        const baseName = 'package_options[' + rowIndex + ']';

        switch(optionData.type) {
            case 'radio':
            case 'select':
            case 'checkbox':
                html = '<select name="' + baseName + '[option_value_ids][]" class="form-select" multiple size="8">';
                Object.entries(optionData.values).forEach(([id, name]) => {
                    html += '<option value="' + id + '">' + name + '</option>';
                });
                html += '</select>';
                container.innerHTML = html;
                break;

            case 'quantity':
                container.innerHTML = '<input type="number" name="' + baseName + '[min_quantity]" value="' + (initialLoad ? packageOptionValue : '') + '" class="form-control" min="0" placeholder="' + minQuantityLabel + '" />';
                break;

            case 'text':
            case 'textarea':
            case 'password':
                container.innerHTML = '<div class="d-flex align-items-center gap-2">' +
                    '<input type="text" name="' + baseName + '[regex_pattern]" value="' + (initialLoad ? packageOptionValue : '') + '" class="form-control" placeholder="' + anyValueText + '" />' +
                    '<i class="bi bi-question-circle text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="' + regexTooltip + '" style="cursor: help; flex-shrink: 0;"></i>' +
                    '</div>';

                const newTooltip = container.querySelector('[data-bs-toggle="tooltip"]');
                if (newTooltip) {
                    new bootstrap.Tooltip(newTooltip);
                }
                break;
        }
    }

    // Trigger initial option group change if there's a pre-selected value
    const optionGroupSelect = document.querySelector('.option_group_select');
    if (optionGroupSelect && optionGroupSelect.value) {
        optionGroupSelect.dispatchEvent(new Event('change'));
    }
});
</script>
<?php
}
?>
