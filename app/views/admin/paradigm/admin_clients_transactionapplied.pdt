<?php /** @var View $this **/ ?>

<?php
if ((isset($applied) ? $applied : false) && ($num_applied = count($applied)) > 0) {
?>
<div class="p-3">
    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th style="width: 40px;"><i class="bi bi-arrow-return-right"></i></th>
                <th><?php $this->_('AdminClients.transactions.headingexpand_invoice');?></th>
                <th><?php $this->_('AdminClients.transactions.headingexpand_amount');?></th>
                <th><?php $this->_('AdminClients.transactions.headingexpand_appliedon');?></th>
                <th style="width: 80px;"><?php $this->_('AdminClients.transactions.headingexpand_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_applied; $i++) {
            ?>
            <tr>
                <td>&nbsp;</td>
                <td><?php (print (isset($applied[$i]->invoice_id_code) ? $this->Html->safe($applied[$i]->invoice_id_code) : null));?></td>
                <td><?php echo $this->CurrencyFormat->format((isset($applied[$i]->applied_amount) ? $this->Html->safe($applied[$i]->applied_amount) : null), (isset($applied[$i]->currency) ? $this->Html->safe($applied[$i]->currency) : null), ['html_code' => true]);?></td>
                <td><?php echo $this->Date->cast((isset($applied[$i]->applied_date) ? $this->Html->safe($applied[$i]->applied_date) : null), 'date_time');?></td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/viewinvoice/' . (isset($client->id) ? $client->id : null) . '/' . (isset($applied[$i]->invoice_id) ? $applied[$i]->invoice_id : null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminClients.invoices.option_view');?>">
                        <i class="bi bi-eye"></i>
                    </a>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="text-center py-4 text-muted">
    <p class="mb-0"><?php $this->_('AdminClients.transactions.applied_no_results');?></p>
</div>
<?php
}

if (!empty($transaction->message)) {
?>
<div class="alert alert-info mx-3 mb-3" role="alert"><?php echo $this->Html->safe($transaction->message);?></div>
<?php
}
