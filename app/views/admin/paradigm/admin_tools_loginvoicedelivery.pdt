<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'invoicedelivery'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/invoicedelivery/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_loginvoicedelivery'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if ((isset($invoice_logs) ? $invoice_logs : false) && ($num_logs = count($invoice_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/invoicedelivery/?sort=invoice_id_code&order=' . ($sort == 'invoice_id_code' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'invoice_id_code' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.loginvoicedelivery.invoice_id_code');?>
                                <?php if ($sort == 'invoice_id_code') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/invoicedelivery/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'first_name' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.loginvoicedelivery.first_name');?>
                                <?php if ($sort == 'first_name') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/invoicedelivery/?sort=method&order=' . ($sort == 'method' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'method' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.loginvoicedelivery.method');?>
                                <?php if ($sort == 'method') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/invoicedelivery/?sort=date_sent&order=' . ($sort == 'date_sent' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_sent' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.loginvoicedelivery.date_sent');?>
                                <?php if ($sort == 'date_sent') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                ?>
                <tr>
                    <td><a href="<?php echo $this->Html->safe($this->base_uri . 'clients/editinvoice/' . (isset($invoice_logs[$i]->client_id) ? $invoice_logs[$i]->client_id : null) . '/' . (isset($invoice_logs[$i]->invoice_id) ? $invoice_logs[$i]->invoice_id : null) . '/');?>"><?php (print (isset($invoice_logs[$i]->invoice_id_code) ? $this->Html->safe($invoice_logs[$i]->invoice_id_code) : null));?></a></td>
                    <td><a href="<?php echo $this->Html->safe($this->base_uri . 'clients/view/' . (isset($invoice_logs[$i]->client_id) ? $invoice_logs[$i]->client_id : null) . '/');?>"><?php echo $this->Html->concat(' ', (isset($invoice_logs[$i]->first_name) ? $this->Html->safe($invoice_logs[$i]->first_name) : null), (isset($invoice_logs[$i]->last_name) ? $this->Html->safe($invoice_logs[$i]->last_name) : null));?></a></td>
                    <td><span class="badge bg-secondary"><?php (print (isset($invoice_methods[$invoice_logs[$i]->method]) ? $this->Html->safe($invoice_methods[$invoice_logs[$i]->method]) : null));?></span></td>
                    <td><?php echo (isset($invoice_logs[$i]->date_sent) ? $this->Html->safe($this->Date->cast($invoice_logs[$i]->date_sent, 'date_time')) : null);?></td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.loginvoicedelivery.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>
