<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    const emailVerificationCheckbox = document.getElementById('email_verification');
    const preventUnverifiedPaymentsCheckbox = document.getElementById('prevent_unverified_payments');
    const passwordFormatSelect = document.getElementById('password_format');
    const passwordRuleField = document.getElementById('password_rule');
    const passwordLengthField = document.getElementById('password_length');

    // Initialize prevent_unverified_payments state
    if (emailVerificationCheckbox && preventUnverifiedPaymentsCheckbox) {
        if (emailVerificationCheckbox.checked) {
            preventUnverifiedPaymentsCheckbox.disabled = false;
        } else {
            preventUnverifiedPaymentsCheckbox.disabled = true;
        }

        // Handle email verification checkbox change
        emailVerificationCheckbox.addEventListener('change', function() {
            if (this.checked) {
                preventUnverifiedPaymentsCheckbox.disabled = false;
            } else {
                preventUnverifiedPaymentsCheckbox.disabled = true;
            }
        });
    }

    // Initialize password field visibility
    if (passwordFormatSelect && passwordRuleField && passwordLengthField) {
        function updatePasswordFields() {
            if (passwordFormatSelect.value === 'custom') {
                passwordRuleField.style.display = 'block';
                passwordLengthField.style.display = 'none';
            } else {
                passwordRuleField.style.display = 'none';
                passwordLengthField.style.display = 'block';
            }
        }

        // Initialize on page load
        updatePasswordFields();

        // Update when password format changes
        passwordFormatSelect.addEventListener('change', updatePasswordFields);
    }

    // Initialize Bootstrap tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
});
</script>
