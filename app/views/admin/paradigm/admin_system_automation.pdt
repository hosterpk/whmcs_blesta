<script>
// Initialize Bootstrap tooltips
document.addEventListener('DOMContentLoaded', function() {
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Run cron button
    const runCronBtn = document.getElementById('run_cron');
    const cronResults = document.getElementById('cron_results');
    const cronIframe = cronResults.querySelector('iframe');
    const cronKey = '<?php echo $this->Html->safe((isset($vars->cron_key) ? $vars->cron_key : null));?>';

    runCronBtn.addEventListener('click', function() {
        cronResults.style.display = 'block';
        cronIframe.src = '<?php echo $this->Html->safe(WEBDIR);?>cron/?cron_key=' + cronKey;
    });

    // Toggle cron key section
    const updateCronKey = document.getElementById('update_cron_key');
    const cronKeySection = document.getElementById('cron_key_section');
    const chevron = updateCronKey.querySelector('i');

    <?php if ((isset($show_cron_key) ? $show_cron_key : false)) { ?>
        cronKeySection.style.display = 'block';
        updateCronKey.style.display = 'none';
    <?php } ?>

    updateCronKey.addEventListener('click', function(e) {
        e.preventDefault();
        if (cronKeySection.style.display === 'none') {
            cronKeySection.style.display = 'block';
            chevron.classList.remove('bi-chevron-down');
            chevron.classList.add('bi-chevron-up');
        } else {
            cronKeySection.style.display = 'none';
            chevron.classList.remove('bi-chevron-up');
            chevron.classList.add('bi-chevron-down');
        }
    });

    // Select all on focus for cron command
    const cronCommand = document.getElementById('cron_command');
    cronCommand.addEventListener('focusin', function() {
        this.select();
    });

    // Update example command when cron key changes
    const cronKeyInput = document.getElementById('cron_key');
    const exampleCommand = document.getElementById('example_command');

    function updateExampleCommand() {
        const newKey = cronKeyInput.value.trim();
        const template = exampleCommand.getAttribute('data-template');
        if (template && newKey) {
            exampleCommand.value = template.replace('{{CRON_KEY}}', newKey);
        }
    }

    cronKeyInput.addEventListener('input', updateExampleCommand);
    cronKeyInput.addEventListener('change', updateExampleCommand);

    // Generate random code
    const generateCodeBtn = document.getElementById('generate_code');
    generateCodeBtn.addEventListener('click', function() {
        const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let randomString = '';
        for (let i = 0; i < 8; i++) {
            randomString += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        cronKeyInput.value = randomString;
        updateExampleCommand();
    });

    // Copy to clipboard functionality
    document.querySelectorAll('.copy-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const targetId = this.getAttribute('data-copy-target');
            const targetInput = document.getElementById(targetId);
            if (targetInput) {
                navigator.clipboard.writeText(targetInput.value).then(function() {
                    // Show success feedback
                    const icon = btn.querySelector('i');
                    icon.classList.remove('bi-clipboard');
                    icon.classList.add('bi-clipboard-check');
                    setTimeout(function() {
                        icon.classList.remove('bi-clipboard-check');
                        icon.classList.add('bi-clipboard');
                    }, 2000);
                }).catch(function(err) {
                    // Fallback for older browsers
                    targetInput.select();
                    document.execCommand('copy');
                });
            }
        });
    });
});
</script>
