<?php /** @var View $this **/ ?>


<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>
<?php
}
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => '',
        'icon' => 'bi-plus-lg',
        'attributes' => [
            'href' => $this->base_uri . 'settings/system/api/add/',
            'title' => $this->_('AdminSystemApi.index.categorylink_keyadd', true)
        ]
    ]
]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminSystemApi.index.boxtitle_api', true), ['id' => 'admin_system_api'], ($render_section ?? null));
?>
    <?php if ((isset($keys) ? $keys : false) && count($keys) > 0) { ?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/api/index/?sort=user&order=' . ($sort == 'user' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'user' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemApi.index.heading_user');?>
                            <?php if ($sort == 'user') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/api/index/?sort=key&order=' . ($sort == 'key' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'key' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemApi.index.heading_key');?>
                            <?php if ($sort == 'key') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/api/index/?sort=company_id&order=' . ($sort == 'company_id' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'company_id' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemApi.index.heading_company');?>
                            <?php if ($sort == 'company_id') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/api/index/?sort=date_created&order=' . ($sort == 'date_created' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'date_created' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemApi.index.heading_date');?>
                            <?php if ($sort == 'date_created') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th style="width: 100px;"><?php $this->_('AdminSystemApi.index.heading_options');?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($keys as $key) { ?>
                <tr>
                    <td><?php echo (isset($key->user) ? $this->Html->safe($key->user) : null);?></td>
                    <td><?php echo (isset($key->key) ? $this->Html->safe($key->key) : null);?></td>
                    <td><?php echo (isset($key->company_name) ? $this->Html->safe($key->company_name) : null);?></td>
                    <td><?php echo $this->Date->cast((isset($key->date_created) ? $key->date_created : null), 'date_time');?></td>
                    <td>
                        <div class="d-flex gap-2">
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/api/edit/' . (isset($key->id) ? $key->id : null) . '/');?>"
                               class="btn btn-sm btn-outline-secondary"
                               title="<?php echo $this->Html->safe($this->_('AdminSystemApi.index.option_edit', true));?>">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <?php
                            $this->Form->create($this->base_uri . 'settings/system/api/delete/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', (isset($key->id) ? $key->id : null));
                            ?>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                    data-confirm-message="<?php echo $this->Html->safe($this->_('AdminSystemApi.index.confirm_delete', true));?>"
                                    title="<?php echo $this->Html->safe($this->_('AdminSystemApi.index.option_delete', true));?>">
                                <i class="bi bi-trash"></i>
                            </button>
                            <?php
                            $this->Form->end();
                            ?>
                        </div>
                    </td>
                </tr>
                <?php } ?>
            </tbody>
        </table>
    </div>
    <?php
    if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        $this->Widget->footer();
        $this->Pagination->build();
    }
    ?>
    <?php } else { ?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('AdminSystemApi.index.no_results');?></p>
    </div>
    <?php } ?>
<?php
$this->Widget->end();

if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
</div>
<?php
}
?>
