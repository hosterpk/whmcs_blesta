<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'system'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $show_filters = !empty($filter_vars);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/system/'), $show_filters);
        $this->Widget->setFilterHtml(($level_checkbox_html ?? ''), $show_filters);
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logsystem'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if (!(isset($log_dir_valid) ? $log_dir_valid : true)) {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-folder-x" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logsystem.no_log_dir');?></p>
            </div>
            <?php
            } elseif ((isset($system_logs) ? $system_logs : false) && ($num_logs = count($system_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width: 220px;"><?php $this->_('AdminTools.logsystem.text_date');?></th>
                        <th style="width: 100px;"><?php $this->_('AdminTools.logsystem.text_level');?></th>
                        <th><?php $this->_('AdminTools.logsystem.text_message');?></th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                    $level = (isset($system_logs[$i]->level) ? $system_logs[$i]->level : 'error');
                    $level_class = 'secondary';
                    if (in_array($level, ['emergency', 'alert', 'critical'])) {
                        $level_class = 'danger';
                    } elseif ($level === 'error') {
                        $level_class = 'warning';
                    } elseif ($level === 'warning') {
                        $level_class = 'info';
                    } elseif (in_array($level, ['notice', 'info', 'debug'])) {
                        $level_class = 'secondary';
                    }
                ?>
                <tr style="cursor: pointer;" data-collapse-row aria-expanded="false">
                    <td><small class="text-muted"><?php echo $this->Html->safe(isset($system_logs[$i]->date) ? $system_logs[$i]->date : '');?></small></td>
                    <td><span class="badge bg-<?php echo $level_class;?>"><?php echo $this->Html->safe(ucfirst($level));?></span></td>
                    <td><?php echo $this->Html->safe(isset($system_logs[$i]->message) ? mb_strimwidth($system_logs[$i]->message, 0, 300, '...') : '');?></td>
                </tr>
                <tr class="collapse" id="system-details-<?php echo $i;?>">
                    <td colspan="3" style="padding: 0; background-color: var(--bg-secondary);">
                        <div style="padding: .5rem;">
                            <h6 class="mb-2"><?php $this->_('AdminTools.logsystem.text_message');?></h6>
                            <pre class="mb-0 bg-body p-3 rounded border" style="max-height: 400px; overflow-y: auto; white-space: pre-wrap; word-wrap: break-word;"><?php echo $this->Html->safe(isset($system_logs[$i]->message) ? \Blesta\Core\Util\LogReader\SystemLogReader::formatMessage($system_logs[$i]->message) : '');?></pre>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logsystem.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>
