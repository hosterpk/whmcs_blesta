<script>
// Handle required fields checkbox logic - vanilla JavaScript only
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Handle required contact fields changes
    const requiredFields = document.querySelectorAll('input[name="required_contact_fields[]"]');
    requiredFields.forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
            const row = checkbox.closest('tr');
            const shownCheckbox = row.querySelector('input[name="shown_contact_fields[]"]');

            if (shownCheckbox) {
                if (checkbox.checked) {
                    shownCheckbox.checked = true;
                    shownCheckbox.disabled = true;
                } else {
                    shownCheckbox.disabled = false;
                }
            }
        });
    });

    // Handle use_company_settings checkbox if it exists
    const useCompanySettings = document.getElementById('use_company_settings');
    if (useCompanySettings) {
        useCompanySettings.addEventListener('change', function() {
            const disabledFields = document.querySelectorAll('#required_fields input.disabled');
            disabledFields.forEach(function(field) {
                field.disabled = true;
            });
        });
    }
});
</script>
