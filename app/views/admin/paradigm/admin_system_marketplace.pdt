<?php /** @var View $this **/ ?>


<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->create($this->_('AdminSystemMarketplace.index.boxtitle_marketplace', true, (isset($extension->name) ? $extension->name : null)), ['id' => 'admin_system_marketplace']);
    ?>

        <?php if ((isset($marketplace) ? $marketplace : false) && !empty($marketplace->extensions)) { ?>
            <div class="list-group list-group-flush">
                <?php foreach ($marketplace->extensions as $i => $extension) { ?>
                <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/marketplace/listing/' . (isset($extension->id) ? $extension->id : null) . '/');?>"
                   class="list-group-item list-group-item-action">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                 style="width: 80px; height: 80px; background: url('<?php echo $this->Html->safe((isset($extension->home) ? $extension->home : null) . (isset($extension->icon) ? $extension->icon : null));?>') no-repeat center; background-size: contain;">
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">
                                <?php echo $this->Html->safe($extension->name);?>
                                <span class="text-muted">(ver <?php echo $this->Html->safe($extension->version);?>)</span>
                            </h6>
                            <div class="small text-muted mb-2">
                                <span class="me-3">
                                    <i class="bi bi-person"></i>
                                    <?php echo $this->Html->safe($extension->author->name);?>
                                </span>
                                <span class="me-3">
                                    <i class="bi bi-calendar"></i>
                                    <?php echo $this->Date->cast($extension->updated);?>
                                </span>
                                <span class="me-3">
                                    <i class="bi bi-tag"></i>
                                    <?php echo $this->Html->safe($extension->type);?>
                                    <?php echo $this->Html->safe($extension->price);?>
                                </span>
                            </div>
                            <div class="mb-2">
                                <?php
                                // Display star rating
                                $rating = isset($extension->rating) ? floatval($extension->rating) : 0;
                                $fullStars = floor($rating);
                                $halfStar = ($rating - $fullStars) >= 0.5;
                                $emptyStars = 5 - $fullStars - ($halfStar ? 1 : 0);

                                for ($s = 0; $s < $fullStars; $s++) {
                                    echo '<i class="bi bi-star-fill text-warning"></i>';
                                }
                                if ($halfStar) {
                                    echo '<i class="bi bi-star-half text-warning"></i>';
                                }
                                for ($s = 0; $s < $emptyStars; $s++) {
                                    echo '<i class="bi bi-star text-warning"></i>';
                                }
                                ?>
                            </div>
                            <p class="mb-0 text-muted"><?php echo $this->Html->safe($extension->desc);?></p>
                        </div>
                    </div>
                </a>
                <?php } ?>
            </div>
        <?php } else { ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminSystemMarketplace.index.text_unavailable');?></p>
            </div>
        <?php } ?>

    <?php $this->Widget->end();?>
</div>
