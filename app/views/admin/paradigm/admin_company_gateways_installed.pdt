<?php
echo (isset($left_nav) ? $left_nav : null);

$tabs = [];
foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
    $tabs[] = [
        'name' => $tab['name'],
        'current' => ($tab['uri'] == 'installed'),
        'attributes' => [
            'href' => $this->base_uri . 'settings/company/gateways/' . $tab['uri'] . '/'
        ]
    ];
}

$has_merchant_settings = !empty($gateway_currencies);
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->setTabs($tabs);
    $this->Widget->setFilterHtml((isset($filters) ? $filters->getHtml() : ''));
    if ($has_merchant_settings) {
        $this->Widget->setLinkButtons([
            [
                'name' => '',
                'icon' => 'bi bi-gear-fill',
                'attributes' => [
                    'href' => '#',
                    'data-bs-toggle' => 'collapse',
                    'data-bs-target' => '#merchant-settings'
                ]
            ]
        ]);
        $this->Widget->setBodyWrapper(false);
    }
    $this->Widget->create($this->_('AdminCompanyGateways.installed.boxtitle_gateway', true), ['id' => 'admin_company_gateways_installed']);
    ?>

            <?php if ($has_merchant_settings) { ?>
            <div class="collapse" id="merchant-settings">
            <div class="card-body border-top">
                <?php $this->Form->create(null, ['class' => 'disable-on-submit']); ?>
                <h6 class="form-section-header">
                    <?php $this->_('AdminCompanyGateways.installed.heading_default_gateways');?>
                </h6>
                <p class="text-muted mb-3">
                    <?php $this->_('AdminCompanyGateways.installed.text_default_gateways_desc');?>
                </p>

                <?php foreach ($gateway_currencies as $currency => $currency_gateways) { ?>
                <div class="row mb-3 align-items-center">
                    <div class="col-auto" style="width: 80px;">
                        <strong><?php echo $this->Html->safe($currency);?></strong>
                    </div>
                    <div class="col-md-6">
                        <?php
                        $this->Form->fieldSelect(
                            'default_gateways[' . $this->Html->safe($currency) . ']',
                            $currency_gateways,
                            ($vars->default_gateways[$currency] ?? $default_gateways[$currency] ?? null),
                            ['id' => 'default_gateways_' . $currency, 'class' => 'form-select']
                        );
                        ?>
                    </div>
                </div>
                <?php } ?>

                <div class="text-end">
                    <?php
                    $this->Form->fieldSubmit(
                        'save',
                        $this->_('AdminCompanyGateways.installed.btn_save', true),
                        ['class' => 'btn btn-primary']
                    );
                    ?>
                </div>
                <?php $this->Form->end(); ?>
            </div>
            </div>
            <div class="card-body">
            <?php } ?>

            <?php
            if ((isset($gateway_types) ? $gateway_types : null)) {
                $k = 0;
                foreach ($gateway_types as $type) {
                    ?>
                    <div data-extension-section>
                    <h6 class="form-section-header<?php echo ($k++ > 0 ? ' mt-4' : '');?>">
                        <?php $this->_('AdminCompanyGateways.installed.heading_' . $type);?>
                    </h6>

                        <?php
                        $gateway_list = [];
                        if (isset($gateways[$type])) {
                            $gateway_list = $gateways[$type];
                        }
                        $num_gateways = count($gateway_list);

                        if ($num_gateways > 0) {
                            for ($i = 0; $i < $num_gateways; $i++) {
                            ?>
                            <div class="d-flex align-items-start gap-3 pb-3<?php echo ($i != $num_gateways - 1) ? ' mb-3' : '';?>"<?php echo ($i != $num_gateways - 1) ? ' style="border-bottom: 1px solid var(--border-color);"' : '';?> data-extension-item>
                                <div style="width: 200px; flex-shrink: 0;">
                                    <?php if (!empty($gateway_list[$i]->icon)) { ?>
                                    <div class="extension-logo extension-logo-dual">
                                        <div class="extension-logo-blesta">
                                            <img src="<?php echo $this->view_dir;?>images/logo.svg" class="logo-dark" alt="Blesta">
                                            <img src="<?php echo $this->view_dir;?>images/logo-color.svg" class="logo-light" alt="Blesta">
                                        </div>
                                        <div class="extension-logo-icon">
                                            <i class="bi <?php echo $this->Html->safe($gateway_list[$i]->icon);?>"></i>
                                        </div>
                                    </div>
                                    <?php } else { ?>
                                    <div class="extension-logo extension-logo-single">
                                        <img src="<?php echo (isset($gateway_list[$i]->logo) ? $this->Html->safe($gateway_list[$i]->logo) : null);?>"
                                             alt="<?php echo (isset($gateway_list[$i]->name) ? $this->Html->safe($gateway_list[$i]->name) : null);?>">
                                    </div>
                                    <?php } ?>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <?php echo (isset($gateway_list[$i]->name) ? $this->Html->safe($gateway_list[$i]->name) : null);?>
                                    </h6>
                                    <div class="text-muted small mb-2">
                                        <?php $this->_('AdminCompanyGateways.installed.text_version', false, $gateway_list[$i]->installed_version);?>

                                        <?php
                                        if ((isset($gateway_list[$i]->signup_url) ? $gateway_list[$i]->signup_url : null)) {
                                        ?>
                                        <a href="<?php echo $this->Html->safe($gateway_list[$i]->signup_url);?>" target="_blank" class="ms-2">
                                            <?php $this->_('AdminCompanyGateways.installed.signup_url');?>
                                        </a>
                                        <?php
                                        }
                                        ?>
                                    </div>

                                    <div class="text-muted small mb-2">
                                        <?php $this->_('AdminCompanyGateways.installed.text_author');?>
                                        <?php
                                        foreach ((array)(isset($gateway_list[$i]->authors) ? $gateway_list[$i]->authors : null) as $index => $author) {
                                        ?>
                                        <a href="<?php echo (isset($author['url']) ? $this->Html->safe($author['url']) : null);?>" target="_blank">
                                            <?php echo (isset($author['name']) ? $this->Html->safe($author['name']) : null);?>
                                        </a><?php echo isset($gateway_list[$i]->authors[$index + 1]) ? ',' : '';?>
                                        <?php
                                        }
                                        ?>
                                    </div>

                                    <?php
                                    if ($type == 'merchant') {
                                    ?>
                                    <div class="text-muted small mb-2">
                                        <?php $this->_('AdminCompanyGateways.installed.text_supports');?>
                                        <?php
                                        if (isset($gateway_list[$i]->interfaces) && is_array($gateway_list[$i]->interfaces)) {
                                            $num_interfaces = count($gateway_list[$i]->interfaces);

                                            for ($j = 0; $j < $num_interfaces; $j++) {
                                                echo ($j > 0 ? ', ' : '') . $this->_('AdminCompanyGateways.installed.text_' . strtolower($gateway_list[$i]->interfaces[$j]), true);
                                            }
                                        }
                                        ?>
                                    </div>
                                    <?php
                                    }
                                    ?>

                                    <div class="text-muted small">
                                        <?php echo nl2br((isset($gateway_list[$i]->description) ? $this->Html->safe($gateway_list[$i]->description) : ''));?>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">
                                    <div class="d-flex gap-2 align-items-center">
                                        <?php
                                        if ((isset($gateway_list[$i]->version) ? $gateway_list[$i]->version : null) !== (isset($gateway_list[$i]->installed_version) ? $gateway_list[$i]->installed_version : null)) {
                                        ?>
                                        <?php
                                        $this->Form->create(
                                            $this->base_uri . 'settings/company/gateways/upgrade/' . (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null) . '/',
                                            ['class' => 'd-inline']
                                        );
                                        $this->Form->fieldHidden('id', (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null));
                                        $this->Form->fieldSubmit(
                                            'save',
                                            $this->_('AdminCompanyGateways.installed.btn_upgrade', true),
                                            ['class' => 'btn btn-sm btn-success']
                                        );
                                        $this->Form->end();
                                        ?>
                                        <?php
                                        }
                                        ?>

                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/gateways/manage/' . (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null) . '/');?>">
                                            <?php $this->_('AdminCompanyGateways.installed.btn_manage');?>
                                        </a>

                                        <?php
                                        $this->Form->create($this->base_uri . 'settings/company/gateways/uninstall/', ['class' => 'd-inline']);
                                        $this->Form->fieldHidden('id', (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null));
                                        ?>
                                        <a href="#"
                                           class="btn btn-sm btn-danger modal-confirm-delete"
                                           data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyGateways.installed.confirm_uninstall', true));?>">
                                            <?php $this->_('AdminCompanyGateways.installed.btn_uninstall');?>
                                        </a>
                                        <?php
                                        $this->Form->end();
                                        ?>
                                    </div>
                                </div>
                            </div>
                            <?php
                            }
                        } else {
                        ?>
                            <div class="card">
                                <div class="card-body text-center text-muted py-5">
                                    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                                    <p class="mt-3 mb-0">
                                        <?php $this->_('AdminCompanyGateways.installed.text_' . $type . '_none');?>
                                    </p>
                                </div>
                            </div>
                        <?php
                        }
                        ?>
                    </div>
                    <?php
                }
            }
            ?>
            <div class="text-center text-muted py-5 extension-filter-no-results" style="display: none;">
                <i class="bi bi-search" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyGateways.text_filter_no_results');?></p>
            </div>

            <?php if ($has_merchant_settings) { ?>
            </div>
            <?php } ?>

    <?php $this->Widget->end(); ?>
</div>
