        <?php
        $this->Form->label($this->_('AdminClients.addservice_addon.field_term', true), 'pricing_id', ['class' => 'form-label']);
        $this->Form->fieldSelect('pricing_id', ['' => $this->_('AppController.select.please', true)] + (array)(isset($terms) ? $terms : null), (isset($vars->pricing_id) ? $vars->pricing_id : null), ['id' => 'pricing_id', 'class' => 'form-select']);
        ?>
    </div>
    <?php
    if (!empty($module_row_fields)) {
    ?>
    <div class="col-12">
        <?php
        $this->Form->label((isset($module_row_name) ? $module_row_name : null), 'module_row_id', ['class' => 'form-label']);
        $this->Form->fieldSelect('module_row_id', (array)(isset($module_row_fields) ? $module_row_fields : []), (isset($vars->module_row_id) ? $vars->module_row_id : null), ['id' => 'module_row_id', 'class' => 'form-select']);
        ?>
    </div>
    <?php
    }
    ?>
</div>

<?php
if (isset($input_html)) {
    $module_field_html = $input_html->generate(null, $this->view);
?>
<h6 class="form-section-header">
    <?php $this->_('AdminClients.addservice_addon.module_heading', false, (isset($module_name) ? $module_name : null));?>
</h6>
