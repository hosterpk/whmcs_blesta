<?php /** @var View $this **/ ?>


<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>
<?php
}
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => '',
        'icon' => 'bi-plus-lg',
        'attributes' => [
            'href' => $this->base_uri . 'settings/system/staff/addgroup/',
            'title' => $this->_('AdminSystemStaff.groups.categorylink_addgroup', true)
        ]
    ]
]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminSystemStaff.groups.boxtitle_groups', true), ['id' => 'admin_system_staff_groups'], ($render_section ?? null));
?>

        <?php if ((isset($groups) ? $groups : false) && ($num_groups = count($groups)) > 0) { ?>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/staff/groups/?sort=name&order=' . ($sort == 'name' ? $negate_order : $order));?>"
                                   class="ajax text-decoration-none<?php echo $sort == 'name' ? ' ' . $order : '';?>">
                                    <?php $this->_('AdminSystemStaff.groups.heading_name');?>
                                    <?php if ($sort == 'name') { ?>
                                        <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                    <?php } ?>
                                </a>
                            </th>
                            <th>
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/staff/groups/?sort=company_name&order=' . ($sort == 'company_name' ? $negate_order : $order));?>"
                                   class="ajax text-decoration-none<?php echo $sort == 'company_name' ? ' ' . $order : '';?>">
                                    <?php $this->_('AdminSystemStaff.groups.heading_company_name');?>
                                    <?php if ($sort == 'company_name') { ?>
                                        <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                    <?php } ?>
                                </a>
                            </th>
                            <th>
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/staff/groups/?sort=num_staff&order=' . ($sort == 'num_staff' ? $negate_order : $order));?>"
                                   class="ajax text-decoration-none<?php echo $sort == 'num_staff' ? ' ' . $order : '';?>">
                                    <?php $this->_('AdminSystemStaff.groups.heading_staff');?>
                                    <?php if ($sort == 'num_staff') { ?>
                                        <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                    <?php } ?>
                                </a>
                            </th>
                            <th class="text-end"><?php $this->_('AdminSystemStaff.groups.heading_options');?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php for ($i = 0; $i < $num_groups; $i++) { ?>
                        <tr>
                            <td><?php echo $this->Html->safe($groups[$i]->name);?></td>
                            <td><?php echo $this->Html->safe($groups[$i]->company_name);?></td>
                            <td><?php echo $this->Html->safe($groups[$i]->num_staff);?></td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="<?php echo $this->base_uri . 'settings/system/staff/editgroup/' . $this->Html->safe($groups[$i]->id) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminSystemStaff.groups.option_edit');?>">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <?php if ((isset($groups[$i]->num_staff) ? $this->Html->safe($groups[$i]->num_staff) : null) == 0) { ?>
                                        <?php
                                        $this->Form->create($this->base_uri . 'settings/system/staff/deletegroup/', ['class' => 'd-inline']);
                                        $this->Form->fieldHidden('id', (isset($groups[$i]->id) ? $groups[$i]->id : null));
                                        ?>
                                        <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                           data-confirm-message="<?php echo $this->Html->safe($this->_('AdminSystemStaff.groups.modal_delete', true));?>"
                                           title="<?php $this->_('AdminSystemStaff.groups.option_delete');?>">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <?php $this->Form->end();?>
                                    <?php } ?>
                                </div>
                            </td>
                        </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php } else { ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminSystemStaff.groups.no_results');?></p>
            </div>
        <?php } ?>
<?php
$this->Widget->end();

if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
</div>
<?php
}
?>
