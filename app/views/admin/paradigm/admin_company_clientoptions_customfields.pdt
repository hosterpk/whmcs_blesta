<?php /** @var View $this **/ ?>

<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->setLinkButtons([
        [
            'name' => '',
            'icon' => 'bi-plus-lg',
            'attributes' => [
                'href' => $this->base_uri . 'settings/company/clientoptions/addcustomfield/',
                'title' => $this->_('AdminCompanyClientoptions.customfields.categorylink_addfield', true)
            ]
        ]
    ]);
    $this->Widget->setBodyWrapper(false);
    $this->Widget->create($this->_('AdminCompanyClientoptions.customfields.boxtitle_browse', true), ['id' => 'admin_company_clientoptions_customfields'], ($render_section ?? null));
    ?>

        <?php
        // Determine how many custom fields are displayed on this page
        $num_custom_fields = 0;

        if (is_array($groups) && ($num_groups = count($groups)) > 0) {
            for ($i = 0; $i < $num_groups; $i++) {
                // Skip client groups with no custom fields
                if (empty($groups[$i]->fields)) {
                    continue;
                }

                $num_custom_fields++;
        ?>

        <!-- Group Section -->
        <div class="card-body pb-0">
            <h6 class="form-section-header<?php echo ($i > 0 ? ' mt-4' : '');?>"><?php echo $this->Html->safe($groups[$i]->name);?></h6>
        </div>

        <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th><?php $this->_('AdminCompanyClientoptions.customfields.text_name');?></th>
                            <th><?php $this->_('AdminCompanyClientoptions.customfields.text_type');?></th>
                            <th><?php $this->_('AdminCompanyClientoptions.customfields.text_required');?></th>
                            <th><?php $this->_('AdminCompanyClientoptions.customfields.text_visible');?></th>
                            <th><?php $this->_('AdminCompanyClientoptions.customfields.text_read_only');?></th>
                            <th style="width: 100px;"><?php $this->_('AdminCompanyClientoptions.customfields.text_options');?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php
                        if (is_array($groups[$i]->fields)) {
                            $fields = $groups[$i]->fields;
                            for ($j = 0, $num_fields = count($fields); $j < $num_fields; $j++) {
                        ?>
                        <tr>
                            <td><?php echo $this->Html->safe(strip_tags($fields[$j]->real_name));?></td>
                            <td><?php echo (isset($types[$fields[$j]->type]) ? $types[$fields[$j]->type] : null);?></td>
                            <td>
                                <i class="bi bi-<?php echo !empty($fields[$j]->regex) ? 'check-circle text-success' : 'x-circle text-muted';?>"></i>
                            </td>
                            <td>
                                <i class="bi bi-<?php echo ((isset($fields[$j]->show_client) ? $this->Html->safe($fields[$j]->show_client) : null) == 1) ? 'check-circle text-success' : 'x-circle text-muted';?>"></i>
                            </td>
                            <td>
                                <i class="bi bi-<?php echo ((isset($fields[$j]->read_only) ? $this->Html->safe($fields[$j]->read_only) : null) == 1) ? 'check-circle text-success' : 'x-circle text-muted';?>"></i>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="<?php echo $this->base_uri . 'settings/company/clientoptions/editcustomfield/' . $fields[$j]->id . '/';?>"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="<?php echo $this->Html->safe($this->_('AdminCompanyClientoptions.customfields.option_edit', true));?>">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <?php
                                    $this->Form->create($this->base_uri . 'settings/company/clientoptions/deletecustomfield/', ['class' => 'd-inline']);
                                    $this->Form->fieldHidden('id', (isset($fields[$j]->id) ? $this->Html->safe($fields[$j]->id) : null));
                                    ?>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                            data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyClientoptions.customfields.confirm_delete', true));?>"
                                            title="<?php echo $this->Html->safe($this->_('AdminCompanyClientoptions.customfields.option_delete', true));?>">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <?php
                                    $this->Form->end();
                                    ?>
                                </div>
                            </td>
                        </tr>
                        <?php
                            }
                        }
                        ?>
                    </tbody>
                </table>
        </div>

        <?php
            }
        }

        if ($num_custom_fields == 0) {
        ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminCompanyClientoptions.customfields.no_results');?></p>
        </div>
        <?php
        }
        ?>
    <?php $this->Widget->end(); ?>
</div>
