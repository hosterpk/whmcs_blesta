<?php /** @var View $this **/ ?>

            <?php
            if (!empty($tasks)) {
            ?>
            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <span><?php $this->_('AdminCompanyPlugins.settings.automation_description');?></span>
            </div>
            <?php
            }

            $i = 0;
            foreach ((isset($tasks) ? $tasks : []) as $task) {
                $task_run_id = (isset($task->task_run_id) ? $task->task_run_id : null);
            ?>
            <?php if ($i > 0) { ?>
            <hr class="my-3">
            <?php } ?>

            <div class="mb-3 p-3" style="background-color: var(--secondary-bg); border-radius: 0.375rem;">
                <h6 class="mb-2"><?php echo (isset($task->real_name) ? $this->Html->safe($task->real_name) : null);?></h6>
                <?php
                if (!empty($task->real_description)) {
                ?>
                <p class="text-muted mb-3"><?php echo (isset($task->real_description) ? $this->Html->safe($task->real_description) : null);?></p>
                <?php
                }
                ?>

                <div class="form-check mb-0">
                    <?php
                    $this->Form->fieldCheckbox(
                        'enabled[' . $task_run_id . ']',
                        '1',
                        ((isset($task->enabled) ? $task->enabled : null) == '1'),
                        ['id' => 'enabled_' . $task_run_id, 'class' => 'form-check-input']
                    );
                    $this->Form->label(
                        $this->_('AdminCompanyPlugins.settings.field_enabled', true),
                        'enabled_' . $task_run_id,
                        ['class' => 'form-check-label']
                    );
                    ?>
                </div>
            </div>
            <?php
                $i++;
            }

            if (empty($tasks)) {
            ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyPlugins.settings.automation_no_results');?></p>
            </div>
            <?php
            }
            ?>
