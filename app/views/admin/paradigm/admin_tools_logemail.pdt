<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'email'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/email/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logemail'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if ((isset($email_logs) ? $email_logs : false) && ($num_logs = count($email_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/email/?sort=date_sent&order=' . ($sort == 'date_sent' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_sent' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logemail.text_date');?>
                                <?php if ($sort == 'date_sent') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/email/?sort=subject&order=' . ($sort == 'subject' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'subject' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logemail.text_subject');?>
                                <?php if ($sort == 'subject') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th><?php $this->_('AdminTools.logemail.text_summary');?></th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/email/?sort=sent&order=' . ($sort == 'sent' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'sent' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logemail.text_status');?>
                                <?php if ($sort == 'sent') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                    $sent = (isset($email_logs[$i]->sent) ? $this->Html->safe($email_logs[$i]->sent) : null);
                    $icon = ($sent ? 'bi-check-lg text-success' : 'bi-x-circle text-danger');
                    $email_id = (isset($email_logs[$i]->id) ? $this->Html->safe($email_logs[$i]->id) : $i);
                ?>
                <tr style="cursor: pointer;" data-collapse-row aria-expanded="false">
                    <td><?php echo $this->Date->cast((isset($email_logs[$i]->date_sent) ? $this->Html->safe($email_logs[$i]->date_sent) : null), 'date_time');?></td>
                    <td><?php (print (isset($email_logs[$i]->subject) ? $this->Html->safe($email_logs[$i]->subject) : null));?></td>
                    <?php
                    // Limit length of summary
                    $summary = (isset($email_logs[$i]->body_text) ? $email_logs[$i]->body_text : null);
                    if (strlen($summary) > 40) {
                        if (function_exists('mb_strimwidth')) {
                            $summary = mb_strimwidth($summary, 0, 40) . '...';
                        } else {
                            $summary = substr($summary, 0, 40) . '...';
                        }
                    }
                    ?>
                    <td class="text-muted"><?php (print (isset($summary) ? $this->Html->safe($summary) : null));?></td>
                    <td>
                        <i class="bi <?php (print (isset($icon) ? $this->Html->safe($icon) : null));?>"></i>
                        <?php echo ($sent) ? $this->_('AdminTools.logemail.text_sent', true) : $this->_('AdminTools.logemail.text_unsent', true);?>
                    </td>
                </tr>
                <tr class="collapse" id="email-details-<?php echo $email_id;?>">
                    <td colspan="4" style="padding: 0; background-color: var(--bg-secondary);">
                        <div style="padding: .5rem;">
                            <ul class="nav nav-tabs nav-tabs-sm" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#text_<?php echo $i;?>" type="button" role="tab"><?php $this->_('AdminTools.logemail.text_text');?></button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#html_<?php echo $i;?>" type="button" role="tab"><?php $this->_('AdminTools.logemail.text_html');?></button>
                                </li>
                            </ul>
                            <div class="tab-content p-3">
                                <div class="tab-pane fade show active" id="text_<?php echo $i;?>" role="tabpanel">
                                    <dl class="row mb-2">
                                        <dt class="col-sm-1"><?php $this->_('AdminTools.logemail.text_to');?></dt>
                                        <dd class="col-sm-11">
                                            <a href="mailto:<?php (print (isset($email_logs[$i]->to_address) ? $this->Html->safe($email_logs[$i]->to_address) : null));?>"><?php (print (isset($email_logs[$i]->to_address) ? $this->Html->safe($email_logs[$i]->to_address) : null));?></a>
                                        </dd>
                                        <?php
                                        // Show CC addresses
                                        if (!empty($email_logs[$i]->cc_address)) {
                                        ?>
                                        <dt class="col-sm-1"><?php $this->_('AdminTools.logemail.text_cc');?></dt>
                                        <dd class="col-sm-11">
                                            <?php
                                            $j = 0;
                                            foreach ($email_logs[$i]->cc_address as $cc_address) {
                                            ?><?php echo $j++ > 0 ? ', ' : '';?><a href="mailto:<?php (print (isset($cc_address) ? $this->Html->safe($cc_address) : null));?>"><?php (print (isset($cc_address) ? $this->Html->safe($cc_address) : null));?></a><?php
                                            }
                                            ?>
                                        </dd>
                                        <?php
                                        }
                                        ?>
                                        <dt class="col-sm-1"><?php $this->_('AdminTools.logemail.text_from');?></dt>
                                        <dd class="col-sm-11">
                                            <a href="mailto:<?php (print (isset($email_logs[$i]->from_address) ? $this->Html->safe($email_logs[$i]->from_address) : null));?>"><?php (print (isset($email_logs[$i]->from_name) ? $this->Html->safe($email_logs[$i]->from_name) : null));?></a>
                                        </dd>
                                    </dl>
                                    <div class="border rounded p-3 bg-body-tertiary">
                                        <?php echo nl2br($this->Html->hyperlink((isset($email_logs[$i]->body_text) ? $this->Html->safe($email_logs[$i]->body_text) : null)));?>
                                    </div>
                                    <?php
                                    // Cannot resend to a client if no client exists
                                    if (!empty($email_logs[$i]->to_client_id)) {
                                    ?>
                                    <div class="mt-2">
                                        <i class="bi bi-reply"></i>
                                        <a href="<?php echo $this->base_uri . 'clients/email/' . (isset($email_logs[$i]->to_client_id) ? $this->Html->safe($email_logs[$i]->to_client_id) : null) . '/' . (isset($email_logs[$i]->id) ? $this->Html->safe($email_logs[$i]->id) : null) . '/';?>">
                                            <?php $this->_('AdminTools.logemail.text_resend');?>
                                        </a>
                                    </div>
                                    <?php
                                    }

                                    $error = (isset($email_logs[$i]->error) ? $this->Html->safe($email_logs[$i]->error) : null);
                                    if (!empty($error)) {
                                    ?>
                                    <div class="alert alert-danger mt-2 mb-0"><?php echo $error;?></div>
                                    <?php
                                    }
                                    ?>
                                </div>
                                <div class="tab-pane fade" id="html_<?php echo $i;?>" role="tabpanel">
                                    <dl class="row mb-2">
                                        <dt class="col-sm-1"><?php $this->_('AdminTools.logemail.text_to');?></dt>
                                        <dd class="col-sm-11">
                                            <a href="mailto:<?php (print (isset($email_logs[$i]->to_address) ? $this->Html->safe($email_logs[$i]->to_address) : null));?>"><?php (print (isset($email_logs[$i]->to_address) ? $this->Html->safe($email_logs[$i]->to_address) : null));?></a>
                                        </dd>
                                        <?php
                                        // Show CC addresses
                                        if (!empty($email_logs[$i]->cc_address)) {
                                        ?>
                                        <dt class="col-sm-1"><?php $this->_('AdminTools.logemail.text_cc');?></dt>
                                        <dd class="col-sm-11">
                                            <?php
                                            $j = 0;
                                            foreach ($email_logs[$i]->cc_address as $cc_address) {
                                            ?><?php echo $j++ > 0 ? ', ' : '';?><a href="mailto:<?php (print (isset($cc_address) ? $this->Html->safe($cc_address) : null));?>"><?php (print (isset($cc_address) ? $this->Html->safe($cc_address) : null));?></a><?php
                                            }
                                            ?>
                                        </dd>
                                        <?php
                                        }
                                        ?>
                                        <dt class="col-sm-1"><?php $this->_('AdminTools.logemail.text_from');?></dt>
                                        <dd class="col-sm-11">
                                            <a href="mailto:<?php (print (isset($email_logs[$i]->from_address) ? $this->Html->safe($email_logs[$i]->from_address) : null));?>"><?php (print (isset($email_logs[$i]->from_name) ? $this->Html->safe($email_logs[$i]->from_name) : null));?></a>
                                        </dd>
                                    </dl>
                                    <iframe class="border rounded w-100" style="min-height: 300px;" srcdoc="<?php echo $this->Html->safe($email_logs[$i]->body_html);?>"></iframe>
                                    <?php
                                    // Cannot resend to a client if no client exists
                                    if (!empty($email_logs[$i]->to_client_id)) {
                                    ?>
                                    <div class="mt-2">
                                        <i class="bi bi-reply"></i>
                                        <a href="<?php echo $this->base_uri . 'clients/email/' . (isset($email_logs[$i]->to_client_id) ? $this->Html->safe($email_logs[$i]->to_client_id) : null) . '/' . (isset($email_logs[$i]->id) ? $this->Html->safe($email_logs[$i]->id) : null) . '/';?>">
                                            <?php $this->_('AdminTools.logemail.text_resend');?>
                                        </a>
                                    </div>
                                    <?php
                                    }

                                    $error = (isset($email_logs[$i]->error) ? $this->Html->safe($email_logs[$i]->error) : null);
                                    if (!empty($error)) {
                                    ?>
                                    <div class="alert alert-danger mt-2 mb-0"><?php echo $error;?></div>
                                    <?php
                                    }
                                    ?>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logemail.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>

