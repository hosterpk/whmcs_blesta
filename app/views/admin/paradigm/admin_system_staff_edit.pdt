<script>
document.addEventListener('DOMContentLoaded', function() {
    const staffForm = document.getElementById('staff');
    const twoFactorMode = document.getElementById('two_factor_mode');

    // Drag & Drop Functionality for Groups
    const assignedGroupsList = document.getElementById('assigned_groups');
    const availableGroupsList = document.getElementById('available_groups');
    const moveLeftBtn = document.querySelector('.move_left');
    const moveRightBtn = document.querySelector('.move_right');
    const hiddenSelect = document.getElementById('assigned');

    let draggedItem = null;

    function setupDragItems() {
        document.querySelectorAll('#assigned_groups .drag-item, #available_groups .drag-item').forEach(item => {
            // Click to select
            item.addEventListener('click', function(e) {
                e.stopPropagation();
                if (e.ctrlKey || e.metaKey) {
                    this.classList.toggle('selected');
                } else {
                    document.querySelectorAll('.drag-item').forEach(i => i.classList.remove('selected'));
                    this.classList.add('selected');
                }
            });

            // Drag events
            item.addEventListener('dragstart', function(e) {
                draggedItem = this;
                this.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', this.textContent);
            });

            item.addEventListener('dragend', function(e) {
                this.classList.remove('dragging');
                document.querySelectorAll('.drag-list').forEach(l => l.classList.remove('drag-over'));
            });
        });

        // Setup drop zones
        [assignedGroupsList, availableGroupsList].forEach(list => {
            if (!list) return;

            list.addEventListener('dragover', function(e) {
                e.preventDefault();
                this.classList.add('drag-over');
            });

            list.addEventListener('dragleave', function(e) {
                if (!this.contains(e.relatedTarget)) {
                    this.classList.remove('drag-over');
                }
            });

            list.addEventListener('drop', function(e) {
                e.preventDefault();
                this.classList.remove('drag-over');

                if (draggedItem && draggedItem.parentNode !== this) {
                    this.appendChild(draggedItem);
                    draggedItem.classList.remove('selected');
                    draggedItem = null;
                }
            });
        });
    }

    setupDragItems();

    // Arrow button functionality
    moveLeftBtn?.addEventListener('click', function() {
        const selectedItems = availableGroupsList.querySelectorAll('.drag-item.selected');
        if (selectedItems.length > 0) {
            selectedItems.forEach(item => {
                assignedGroupsList.appendChild(item);
                item.classList.remove('selected');
            });
        }
    });

    moveRightBtn?.addEventListener('click', function() {
        const selectedItems = assignedGroupsList.querySelectorAll('.drag-item.selected');
        if (selectedItems.length > 0) {
            selectedItems.forEach(item => {
                availableGroupsList.appendChild(item);
                item.classList.remove('selected');
            });
        }
    });

    // Clear selection when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.drag-item')) {
            document.querySelectorAll('.drag-item.selected').forEach(item => item.classList.remove('selected'));
        }
    });

    // Update hidden select on form submit
    if (staffForm) {
        staffForm.addEventListener('submit', function() {
            const items = assignedGroupsList.querySelectorAll('.drag-item');

            // Clear existing options
            hiddenSelect.innerHTML = '';

            // Add all assigned groups as selected options
            items.forEach(item => {
                const option = document.createElement('option');
                option.value = item.getAttribute('data-value');
                option.selected = true;
                hiddenSelect.appendChild(option);
            });
        });
    }

    // Two-factor mode visibility
    function hideTwoFactorModes() {
        const factorKey = document.getElementById('factor_key');
        const factorPin = document.getElementById('factor_pin');
        const qrCode = document.getElementById('two_factor_qr');

        switch(twoFactorMode.value) {
            case 'motp':
                factorPin.style.display = 'block';
                factorKey.style.display = 'block';
                if (qrCode) qrCode.style.display = 'none';
                break;
            case 'totp':
                factorKey.style.display = 'block';
                factorPin.style.display = 'none';
                if (qrCode) qrCode.style.display = 'block';
                break;
            case 'none':
            default:
                factorKey.style.display = 'none';
                factorPin.style.display = 'none';
                break;
        }
    }

    if (twoFactorMode) {
        hideTwoFactorModes();
        twoFactorMode.addEventListener('change', hideTwoFactorModes);
    }
});
</script>
