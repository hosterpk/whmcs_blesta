<?php /** @var View $this **/ ?>

            <?php
            if (!empty($events)) {
            ?>
            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <span><?php $this->_('AdminCompanyPlugins.settings.events_description');?></span>
            </div>
            <?php
            }

            $i = 0;
            foreach ((isset($events) ? $events : []) as $event) {
                $key = (isset($event->event) ? $event->event : null);
                $event_id = str_replace(['.', ':'], '_', $key);
            ?>
            <?php if ($i > 0) { ?>
            <hr class="my-3">
            <?php } ?>

            <div class="mb-3 p-3" style="background-color: var(--secondary-bg); border-radius: 0.375rem;">
                <h6 class="mb-2"><?php echo (isset($event->event) ? $this->Html->safe($event->event) : null);?></h6>
                <p class="text-muted mb-3"><?php $this->_('AdminCompanyPlugins.settings.event.' . strtolower((isset($event->event) ? $this->Html->safe($event->event) : null)));?></p>

                <div class="form-check mb-0">
                    <?php
                    $this->Form->fieldCheckbox(
                        'enabled[' . $key . ']',
                        '1',
                        ((isset($event->enabled) ? $event->enabled : null) == '1'),
                        ['id' => 'enabled_' . $event_id, 'class' => 'form-check-input']
                    );
                    $this->Form->label(
                        $this->_('AdminCompanyPlugins.settings.field_enabled', true),
                        'enabled_' . $event_id,
                        ['class' => 'form-check-label']
                    );
                    ?>
                </div>
            </div>
            <?php
                $i++;
            }

            if (empty($events)) {
            ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyPlugins.settings.events_no_results');?></p>
            </div>
            <?php
            }
            ?>
