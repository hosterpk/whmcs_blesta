<script type="text/javascript">
(function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var pricingId = document.getElementById('pricing_id');
    var priceOverride = document.getElementById('price_override');
    var overridePriceFields = document.getElementById('overridePriceFields');
    var disableOptionLogic = document.getElementById('disable_option_logic');
    var statusRadios = document.querySelectorAll('input[name="status"]');
    var useModuleCheckbox = document.getElementById('use_module');
    var notifyOrderCheckbox = document.getElementById('notify_order');
    var packageOptions = document.querySelector('.package-options');

    function updateServiceStatus(useModule, notifyOrder) {
        var checkedRadio = document.querySelector('input[name="status"]:checked');
        var status = checkedRadio ? checkedRadio.value : 'active';

        if (useModuleCheckbox) {
            useModuleCheckbox.checked = (status === 'active' && useModule) || status === 'pending';
            useModuleCheckbox.disabled = status !== 'active';
        }

        if (notifyOrderCheckbox) {
            notifyOrderCheckbox.checked = (status === 'active' && notifyOrder) || status === 'pending';
            notifyOrderCheckbox.disabled = status !== 'active';
        }
    }

    // Initial status update
    updateServiceStatus(<?php echo (isset($vars->use_module) ? $vars->use_module : 'true');?>, <?php echo (isset($vars->notify_order) ? $vars->notify_order : 'true');?>);

    statusRadios.forEach(function(radio) {
        radio.addEventListener('change', function() {
            updateServiceStatus(true, true);
        });
    });

    // Price override toggle
    function showPriceOverrideFields() {
        if (overridePriceFields) {
            if (priceOverride && priceOverride.checked) {
                overridePriceFields.style.display = '';
                overridePriceFields.querySelectorAll('input,select').forEach(function(input) {
                    input.disabled = false;
                });
            } else {
                overridePriceFields.style.display = 'none';
                overridePriceFields.querySelectorAll('input,select').forEach(function(input) {
                    input.disabled = true;
                });
            }
        }
    }

    showPriceOverrideFields();

    if (priceOverride) {
        priceOverride.addEventListener('change', showPriceOverrideFields);
    }

    // Package options fetch
    function fetchPackageOptions() {
        var pricingIdValue = pricingId ? pricingId.value : null;

        if (pricingIdValue && packageOptions) {
            var form = pricingId.closest('form');
            var fields = form.querySelectorAll('[name^="configoptions"],[name="disable_option_logic"]');
            var params = new URLSearchParams();
            fields.forEach(function(field) {
                if (field.type === 'checkbox' && !field.checked) return;
                params.append(field.name, field.value);
            });

            fetch(baseUri + 'clients/packageoptions/' + pricingIdValue + '?' + params.toString(), {
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(response => response.text())
            .then(text => {
                if (packageOptions && text) {
                    try { text = JSON.parse(text); } catch(e) { /* use raw text */ }
                    packageOptions.innerHTML = text;
                    packageOptions.querySelectorAll('script').forEach(function(oldScript) {
                        var newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(function(attr) {
                            newScript.setAttribute(attr.name, attr.value);
                        });
                        newScript.textContent = oldScript.textContent;
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                }
            })
            .catch(error => console.error('Error:', error));
        }
    }

    if (pricingId) {
        pricingId.addEventListener('change', fetchPackageOptions);
    }

    if (disableOptionLogic) {
        disableOptionLogic.addEventListener('change', fetchPackageOptions);
    }

    fetchPackageOptions();

    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
})();
</script>
<!-- WIDGET_FOOTER -->
