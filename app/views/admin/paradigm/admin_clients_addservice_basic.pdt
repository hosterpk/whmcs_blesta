            $selected_status = (isset($vars->status) ? $vars->status : 'pending');
            $status_order = ['active', 'pending', 'suspended', 'canceled'];
            foreach ($status_order as $status_value) {
                if (!isset($status[$status_value])) {
                    continue;
                }
                $status_label = $status[$status_value];
                $btn_class = 'btn-outline-primary';
                if ($status_value == 'active') {
                    $btn_class = 'btn-outline-success';
                } elseif ($status_value == 'canceled') {
                    $btn_class = 'btn-outline-danger';
                } elseif ($status_value == 'pending') {
                    $btn_class = 'btn-outline-warning';
                } elseif ($status_value == 'suspended') {
                    $btn_class = 'btn-outline-secondary';
                }

                $is_checked = ($selected_status == $status_value);
            ?>
            <input type="radio" class="btn-check" name="status" id="status-<?php echo $this->Html->safe($status_value);?>" value="<?php echo $this->Html->safe($status_value);?>"<?php echo $is_checked ? ' checked' : '';?>>
            <label class="btn <?php echo $this->Html->safe($btn_class);?>" for="status-<?php echo $this->Html->safe($status_value);?>">
