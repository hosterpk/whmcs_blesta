<?php /** @var View $this **/ ?>

<?php
if ((isset($invoices) ? $invoices : false) && ($num_invoices = count($invoices)) > 0) {
?>
<h6 class="form-section-header"><?php $this->_('AdminClients.makepaymentamount.heading_invoices');?></h6>
<div class="table-responsive mb-3">
    <table class="table">
        <thead>
            <tr>
                <th class="text-center" style="width: 40px;">
                    <?php $this->Form->fieldCheckbox('invoice_id[]', 'all', in_array('all', (isset($vars->invoice_id) ? $vars->invoice_id : [])), ['class' => 'form-check-input']);?>
                </th>
                <th><?php $this->_('AdminClients.makepaymentamount.text_invoice');?></th>
                <th><?php $this->_('AdminClients.makepaymentamount.text_datedue');?></th>
                <th><?php $this->_('AdminClients.makepaymentamount.text_due');?></th>
                <th><?php $this->_('AdminClients.makepaymentamount.text_amount');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_invoices; $i++) {
            ?>
            <tr>
                <td class="text-center">
                    <?php $this->Form->fieldCheckbox('invoice_id[]', (isset($invoices[$i]->id) ? $invoices[$i]->id : null), in_array($invoices[$i]->id, (isset($vars->invoice_id) ? $vars->invoice_id : [])), ['class' => 'form-check-input']);?>
                </td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/viewinvoice/' . $invoices[$i]->client_id . '/' . $invoices[$i]->id . '/');?>" target="_blank" class="text-decoration-none">
                        <?php (print (isset($invoices[$i]->id_code) ? $this->Html->safe($invoices[$i]->id_code) : null));?>
                    </a>
                </td>
                <td><?php echo $this->Date->cast((isset($invoices[$i]->date_due) ? $invoices[$i]->date_due : null));?></td>
                <td><?php echo $this->CurrencyFormat->format((isset($invoices[$i]->due) ? $this->Html->safe($invoices[$i]->due) : null), (isset($invoices[$i]->currency) ? $this->Html->safe($invoices[$i]->currency) : null), ['html_code' => true]);?></td>
                <td>
                    <?php
                    $this->Form->fieldText('applyamount[' . (isset($invoices[$i]->id) ? $invoices[$i]->id : null) . ']', (isset($vars->applyamount[$invoices[$i]->id]) ? $vars->applyamount[$invoices[$i]->id] : $this->CurrencyFormat->format((isset($vars->applyamount[$invoices[$i]->id]) ? $vars->applyamount[$invoices[$i]->id] : $invoices[$i]->due), $invoices[$i]->currency, ['prefix' => false,'suffix' => false,'with_separator' => false,'code' => false])), ['id' => 'invoice-' . (isset($invoices[$i]->id) ? $invoices[$i]->id : null), 'class' => 'form-control form-control-sm']);
                    ?>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i><?php $this->_('AdminClients.makepaymentamount.no_results');?>
</div>
<?php
}
