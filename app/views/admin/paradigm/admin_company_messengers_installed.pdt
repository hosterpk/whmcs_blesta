<?php /** @var View $this **/ ?>


<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>
<?php
}
?>
    <?php
    $tabs = [];
    foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
        $tabs[] = [
            'name' => $tab['name'],
            'current' => ($tab['uri'] == 'installed'),
            'attributes' => [
                'href' => $this->Html->safe($this->base_uri . 'settings/company/messengers/' . $tab['uri'] . '/')
            ]
        ];
    }
    $this->Widget->clear();
    $this->Widget->setTabs($tabs);
    $this->Widget->setFilterHtml((isset($filters) ? $filters->getHtml() : ''));
    $this->Widget->create($this->_('AdminCompanyMessengers.installed.boxtitle_installed', true), ['id' => 'admin_company_messengers_installed']);?>

            <?php
            $num_messengers = count((isset($messengers) ? $messengers : []));
            if ($num_messengers > 0) {
                for ($i = 0; $i < $num_messengers; $i++) {
                    $messenger = $messengers[$i];
                    $is_last = ($i == $num_messengers - 1);
            ?>
            <!-- Messenger Item -->
            <div class="d-flex align-items-start gap-3 pb-3<?php echo !$is_last ? ' mb-3' : '';?>"<?php echo !$is_last ? ' style="border-bottom: 1px solid var(--border-color);"' : '';?> data-extension-item>
                <div style="width: 200px; flex-shrink: 0;">
                    <?php if (!empty($messenger->icon)) { ?>
                    <div class="extension-logo extension-logo-dual">
                        <div class="extension-logo-blesta">
                            <img src="<?php echo $this->view_dir;?>images/logo.svg" class="logo-dark" alt="Blesta">
                            <img src="<?php echo $this->view_dir;?>images/logo-color.svg" class="logo-light" alt="Blesta">
                        </div>
                        <div class="extension-logo-icon">
                            <i class="bi <?php echo $this->Html->safe($messenger->icon);?>"></i>
                        </div>
                    </div>
                    <?php } else { ?>
                    <div class="extension-logo extension-logo-single">
                        <?php if (!empty($messenger->logo)) { ?>
                        <img src="<?php echo $this->Html->safe($messenger->logo);?>" alt="<?php echo $this->Html->safe($messenger->name);?>">
                        <?php } ?>
                    </div>
                    <?php } ?>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-1"><?php echo $this->Html->safe($messenger->name);?> <span class="text-muted" style="font-weight: normal; font-size: 0.875rem;"><?php $this->_('AdminCompanyMessengers.installed.text_version', false, $this->Html->safe($messenger->installed_version ?? $messenger->version));?></span></h6>
                    <div class="text-muted small mb-1">
                        <?php $this->_('AdminCompanyMessengers.installed.text_author');?>
                        <?php
                        $authors = (array)($messenger->authors ?? []);
                        foreach ($authors as $index => $author) {
                        ?>
                        <a href="<?php echo $this->Html->safe($author['url'] ?? '#');?>" class="text-primary"><?php echo $this->Html->safe($author['name'] ?? '');?></a><?php echo isset($authors[$index + 1]) ? ', ' : '';?>
                        <?php
                        }
                        ?>
                    </div>
                    <p class="mb-0 text-secondary" style="font-size: 0.875rem;"><?php echo nl2br($this->Html->safe($messenger->description ?? ''));?></p>
                </div>
                <div class="d-flex gap-2" style="flex-shrink: 0;">
                    <?php
                    // Show upgrade button if version mismatch
                    if (($messenger->version ?? null) !== ($messenger->installed_version ?? null)) {
                        $this->Form->create($this->base_uri . 'settings/company/messengers/upgrade/' . $messenger->id . '/', ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', $messenger->id);
                        $this->Form->fieldSubmit('save', $this->_('AdminCompanyMessengers.installed.btn_upgrade', true), ['class' => 'btn btn-sm btn-success']);
                        $this->Form->end();
                    }
                    ?>
                    <a href="<?php echo $this->base_uri . 'settings/company/messengers/manage/' . $messenger->id . '/';?>" class="btn btn-sm btn-outline-secondary"><?php $this->_('AdminCompanyMessengers.installed.btn_manage');?></a>
                    <?php
                    $this->Form->create($this->base_uri . 'settings/company/messengers/uninstall/', ['class' => 'd-inline']);
                    $this->Form->fieldHidden('id', $messenger->id);
                    ?>
                    <button type="button" class="btn btn-sm btn-danger modal-confirm-delete"
                            data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyMessengers.installed.confirm_uninstall', true));?>"
                            data-confirm-title="<?php echo $this->Html->safe($this->_('AdminCompanyMessengers.installed.btn_uninstall', true));?>"
                            data-confirm-button="<?php echo $this->Html->safe($this->_('AdminCompanyMessengers.installed.btn_uninstall', true));?>">
                        <?php $this->_('AdminCompanyMessengers.installed.btn_uninstall');?>
                    </button>
                    <?php
                    $this->Form->end();
                    ?>
                </div>
            </div>
            <?php
                }
            } else {
            ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyMessengers.installed.text_none');?></p>
            </div>
            <?php
            }
            ?>
            <div class="text-center text-muted py-5 extension-filter-no-results" style="display: none;">
                <i class="bi bi-search" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyMessengers.text_filter_no_results');?></p>
            </div>
    <?php $this->Widget->end();?>
<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
</div>
<?php
}
?>
