$this->Widget->end();
?>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips for elements currently in DOM
    const transactionsTable = document.getElementById('transactions');
    if (transactionsTable) {
        const tooltipTriggerList = transactionsTable.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
    }
});

// Lazy-load transaction details when expandable row opens
document.addEventListener('show.bs.collapse', function(e) {
    var container = e.target.querySelector('.transaction-applied-container');
    if (!container) return;

    var transactionId = container.getAttribute('data-transaction-id');
    if (!transactionId || container.hasAttribute('data-loaded')) return;

    fetch('<?php echo $this->base_uri;?>billing/transactionapplied/' + transactionId, {
        headers: {'X-Requested-With': 'XMLHttpRequest'}
    })
    .then(function(response) {
        if (!response.ok) throw new Error('HTTP error ' + response.status);
        return response.text();
    })
    .then(function(html) {
        container.innerHTML = html;
        container.setAttribute('data-loaded', 'true');
    })
    .catch(function(error) {
        container.innerHTML = '<div class="alert alert-danger m-3">Error loading transaction details.</div>';
    });
});
</script>
