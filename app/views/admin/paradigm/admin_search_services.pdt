<?php
$has_results = ($services ?? false) && count($services) > 0;

if (($smart_search ?? false) && !$has_results) {
    return;
}
?>
<div class="card-body pb-0">
    <h6 class="form-section-header"><?php $this->_('AdminSearch.services.heading');?></h6>
</div>
<?php if ($has_results) { ?>
<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th><?php $this->_('AdminSearch.services.heading_client_id');?></th>
                <th><?php $this->_('AdminSearch.services.heading_client');?></th>
                <th><?php $this->_('AdminSearch.services.heading_package');?></th>
                <th><?php $this->_('AdminSearch.services.heading_date_added');?></th>
                <th><?php $this->_('AdminSearch.services.heading_date_renews');?></th>
                <th><?php $this->_('AdminSearch.services.heading_status');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $num_services = count($services);
            for ($i = 0; $i < $num_services; $i++) {
            ?>
            <tr>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/editservice/' . ($services[$i]->client_id ?? null) . '/' . ($services[$i]->id ?? null) . '/');?>">
                        <?php echo $this->Html->safe($services[$i]->client_id_code ?? null);?>
                    </a>
                </td>
                <td><?php echo $this->Html->concat(' ', $this->Html->safe($services[$i]->client_first_name ?? null), $this->Html->safe($services[$i]->client_last_name ?? null));?></td>
                <td><?php echo $this->Html->safe($services[$i]->name ?? null);?></td>
                <td><?php echo $this->Date->cast($services[$i]->date_added ?? null);?></td>
                <td><?php echo (empty($services[$i]->date_renews) ? $this->_('AdminSearch.services.text_never', true) : $this->Date->cast($services[$i]->date_renews ?? null));?></td>
                <td><?php echo $this->Html->safe($service_status[$services[$i]->status] ?? null);?></td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="text-center py-5 text-muted">
    <i class="bi bi-server" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminSearch.services.no_results');?></p>
</div>
<?php } ?>
