                    ?>
                    <!-- Packages section -->
                    <div class="p-3">
                        <h6 class="fw-bold mb-3"><?php $this->_('AdminPackages.groups.heading_packages');?></h6>
                        <?php
                        if (!empty($package_groups[$i]->packages)) {
                        ?>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 packages-table" data-group-id="<?php echo (isset($package_groups[$i]->id) ? $this->Html->safe($package_groups[$i]->id) : null);?>">
                                <thead>
                                    <tr>
                                        <th style="width: 40px;"></th>
                                        <th><?php $this->_('AdminPackages.groups.heading_package_name');?></th>
                                        <th style="width: 100px;"><?php $this->_('AdminPackages.groups.heading_options');?></th>
                                    </tr>
                                </thead>
                                <tbody class="packages-sortable">
                                    <?php
                                    foreach ($package_groups[$i]->packages as $package) {
                                    ?>
                                    <tr id="packages_<?php echo (isset($package->id) ? $this->Html->safe($package->id) : null);?>" class="package-row">
                                        <td class="text-center">
                                            <i class="bi bi-grip-vertical movable" style="cursor: grab; opacity: 0.5;"></i>
                                        </td>
                                        <td><?php echo (isset($package->name) ? $this->Html->safe($package->name) : null);?></td>
                                        <td>
                                            <a href="<?php echo $this->Html->safe($this->base_uri . 'packages/edit/' . (isset($package->id) ? $package->id : null));?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminPackages.groups.option_edit');?>">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    <?php
                                    }
                                    ?>
                                </tbody>
                            </table>
                        </div>
                        <?php
                        } else {
                        ?>
                        <div class="text-muted fst-italic"><?php $this->_('AdminPackages.groups.packages_no_results');?></div>
                        <?php
