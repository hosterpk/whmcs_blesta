                        ?>
                    </div>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>

<?php
if (isset($this->Pagination) && $this->Pagination->hasPages()) {
    $this->Widget->footer();
    $this->Pagination->build();
}
?>
<?php
} else {
?>
<div class="text-center py-5 text-muted">
    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminPackages.groups.no_results');?></p>
</div>
<?php
}

$this->Widget->end();
?>

<script>
document.addEventListener('DOMContentLoaded', function() {
    initPackageGroups();
});

// Re-initialize after AJAX updates
document.addEventListener('blestaAjaxComplete', function() {
    initPackageGroups();
});

function initPackageGroups() {
    // Initialize Sortable for package reordering
    if (typeof Sortable !== 'undefined') {
        document.querySelectorAll('.packages-sortable').forEach(function(tbody) {
            // Skip if already initialized
            if (tbody.hasAttribute('data-sortable-init')) return;
            tbody.setAttribute('data-sortable-init', 'true');

            new Sortable(tbody, {
                handle: '.movable',
                animation: 150,
                ghostClass: 'sortable-ghost',
                onEnd: function(evt) {
                    const table = tbody.closest('.packages-table');
                    if (!table) return;

                    const groupId = table.getAttribute('data-group-id');
                    const packages = Array.from(tbody.querySelectorAll('[id^="packages_"]'))
                        .map(function(row) {
                            return row.id.replace('packages_', '');
                        });

                    // Send reorder request
                    const formData = new URLSearchParams();
                    formData.append('group_id', groupId);
                    formData.append('_csrf_token', '<?php echo $this->Form->getCsrfToken();?>');
                    packages.forEach(function(packageId) {
                        formData.append('packages[]', packageId);
                    });

                    fetch('<?php echo $this->base_uri;?>packages/orderpackages/', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData.toString()
                    });
                }
            });
        });
    }

    // Show movable icon on hover
    document.querySelectorAll('.package-row').forEach(function(row) {
        const movable = row.querySelector('.movable');
        if (!movable) return;

        row.addEventListener('mouseenter', function() {
            movable.style.opacity = '1';
        });
        row.addEventListener('mouseleave', function() {
            movable.style.opacity = '0.5';
        });
    });
}
</script>

<style>
.sortable-ghost {
    opacity: 0.4;
    background-color: var(--bs-primary-bg-subtle);
}
.packages-table .movable {
    transition: opacity 0.2s;
}
</style>
