                                            <a href="<?php echo $this->base_uri . 'packages/editgroup/' . (isset($parent->id) ? $this->Html->safe($parent->id) : null) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminPackages.groups.option_edit');?>">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    <?php
                                    }
                                    ?>
                                </tbody>
                            </table>
                        </div>
                        <?php
                        } else {
                        ?>
                        <div class="text-muted fst-italic"><?php $this->_('AdminPackages.groups.parents_no_results');?></div>
