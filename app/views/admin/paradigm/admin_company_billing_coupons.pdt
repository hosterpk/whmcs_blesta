<?php /** @var View $this **/ ?>


<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>
<?php
}
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => '',
        'icon' => 'bi-plus-lg',
        'attributes' => ['href' => $this->base_uri . 'settings/company/billing/addcoupon/', 'title' => $this->_('AdminCompanyBilling.coupons.categorylink_addcoupon', true)]
    ]
]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminCompanyBilling.coupons.boxtitle_coupons', true), ['id' => 'admin_company_billing_coupons'], ($render_section ?? null));
?>

        <?php if ((isset($coupons) ? $coupons : false) && ($num_coupons = count($coupons)) > 0) { ?>
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="coupons">
                    <thead>
                        <tr>
                            <th style="width: 40px;"></th>
                            <th><?php $this->_('AdminCompanyBilling.coupons.text_code');?></th>
                            <th><?php $this->_('AdminCompanyBilling.coupons.text_discount');?></th>
                            <th><?php $this->_('AdminCompanyBilling.coupons.text_used');?></th>
                            <th><?php $this->_('AdminCompanyBilling.coupons.text_max');?></th>
                            <th><?php $this->_('AdminCompanyBilling.coupons.text_start_date');?></th>
                            <th><?php $this->_('AdminCompanyBilling.coupons.text_end_date');?></th>
                            <th style="width: 100px;"><?php $this->_('AdminCompanyBilling.coupons.text_options');?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php
                        // Loop through each coupon
                        for ($i = 0; $i < $num_coupons; $i++) {
                            $icon_class = ((isset($coupons[$i]->status) ? $this->Html->safe($coupons[$i]->status) : null) == 'active') ? 'bi-check-circle text-success' : 'bi-slash-circle text-danger';
                        ?>
                        <tr class="cursor-pointer" data-collapse-row aria-expanded="false">
                            <td><i class="bi <?php echo $icon_class;?>"></i></td>
                            <td><?php echo (isset($coupons[$i]->code) ? $this->Html->safe($coupons[$i]->code) : null);?></td>
                            <?php
                            $multiple = count($coupons[$i]->discounts) > 1;

                            // Set discount amounts to the first available
                            $amount = $coupons[$i]->discounts[0]->amount;
                            $type = $coupons[$i]->discounts[0]->type;
                            $currency = $coupons[$i]->discounts[0]->currency;
                            ?>
                            <td><?php echo $multiple ? $this->_('AdminCompanyBilling.coupons.text_multiple', true) : (($type == 'percent') ? $this->Html->concat('', $amount, '%') : $this->CurrencyFormat->format($amount, $currency, ['html_code' => true]));?></td>
                            <td><?php echo (isset($coupons[$i]->used_qty) ? $this->Html->safe($coupons[$i]->used_qty) : null);?></td>
                            <td><?php echo (isset($coupons[$i]->max_qty) ? $this->Html->safe($coupons[$i]->max_qty) : null);?></td>
                            <td><?php echo $this->Date->cast($coupons[$i]->start_date);?></td>
                            <td><?php echo $this->Date->cast($coupons[$i]->end_date);?></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="<?php echo $this->base_uri . 'settings/company/billing/editcoupon/' . (isset($coupons[$i]->id) ? $this->Html->safe($coupons[$i]->id) : null) . '/';?>"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="<?php echo $this->Html->safe($this->_('AdminCompanyBilling.coupons.option_edit', true));?>">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <?php
                                    $this->Form->create($this->base_uri . 'settings/company/billing/deletecoupon/', ['class' => 'd-inline']);
                                    $this->Form->fieldHidden('id', (isset($coupons[$i]->id) ? $this->Html->safe($coupons[$i]->id) : null));
                                    ?>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                            data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyBilling.coupons.confirm_delete', true));?>"
                                            title="<?php echo $this->Html->safe($this->_('AdminCompanyBilling.coupons.option_delete', true));?>">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <?php
                                    $this->Form->end();
                                    ?>
                                </div>
                            </td>
                        </tr>
                        <tr class="collapse">
                            <td colspan="8" style="padding: 0; background-color: var(--bg-secondary);">
                                <div style="padding: .5rem;">
                                        <table class="table table-sm mb-0">
                                            <thead>
                                                <tr>
                                                    <th><?php $this->_('AdminCompanyBilling.coupons.text_currency');?></th>
                                                    <th><?php $this->_('AdminCompanyBilling.coupons.text_discount');?></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            <?php
                                            // Display all discounts
                                            for ($j = 0, $num_currencies = count($coupons[$i]->discounts); $j < $num_currencies; $j++) {
                                                $coupon = $coupons[$i]->discounts[$j];
                                            ?>
                                                <tr>
                                                    <td><?php echo (isset($coupon->currency) ? $this->Html->safe($coupon->currency) : null);?></td>
                                                    <td><?php echo ($coupon->type == 'percent') ? $this->Html->safe($this->Html->concat('', $coupon->amount, '%')) : $this->CurrencyFormat->format($this->Html->safe($coupon->amount), $this->Html->safe($coupon->currency), ['html_code' => true]);?></td>
                                                </tr>
                                            <?php
                                            }
                                            ?>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <?php
                        }
                        ?>
                    </tbody>
                </table>
            </div>

            <?php
            if (isset($this->Pagination) && $this->Pagination->hasPages()) {
                $this->Widget->footer();
                $this->Pagination->build();
            }
            ?>
        <?php
        } else {
        ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyBilling.coupons.no_results');?></p>
            </div>
        <?php } ?>
<?php
$this->Widget->end();

if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
</div>
<?php
}
?>
