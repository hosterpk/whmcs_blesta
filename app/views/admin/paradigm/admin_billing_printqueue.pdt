$this->Widget->end();
?>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const printqueueTable = document.getElementById('printqueue');
    const bulkActionsBar = document.getElementById('bulkActionsBar');
    const selectedCount = document.getElementById('selectedCount');
    const selectAllCheckbox = document.getElementById('print_all');
    var textItemSelected = <?php echo json_encode($this->_('AdminBilling.printqueue.text_item_selected', true));?>;
    var textItemsSelected = <?php echo json_encode($this->_('AdminBilling.printqueue.text_items_selected', true));?>;

    if (!printqueueTable) return;

    // Initialize tooltips
    const tooltipTriggerList = printqueueTable.querySelectorAll('[data-bs-toggle="tooltip"]');
    tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));

    // Handle select all checkbox
    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function() {
            const checkboxes = printqueueTable.querySelectorAll('.print-box');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateBulkActions();
        });
    }

    // Handle individual checkboxes
    const rowCheckboxes = printqueueTable.querySelectorAll('.print-box');
    rowCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            // Uncheck select all if any checkbox is unchecked
            if (!this.checked && selectAllCheckbox) {
                selectAllCheckbox.checked = false;
            }
            updateBulkActions();
        });
    });

    // Update bulk actions bar visibility and count
    function updateBulkActions() {
        const checkedBoxes = printqueueTable.querySelectorAll('.print-box:checked');
        if (checkedBoxes.length > 0) {
            bulkActionsBar.style.display = 'block';
            var text = checkedBoxes.length === 1 ? textItemSelected : textItemsSelected;
            selectedCount.textContent = checkedBoxes.length + ' ' + text;
        } else {
            bulkActionsBar.style.display = 'none';
        }
    }

    // Initialize on page load
    updateBulkActions();
});
</script>
