<?php /** @var View $this **/ ?>

        <div class="main-content-padding">
            <?php echo (isset($message) ? $message : null);?>

            <?php
            $this->Widget->clear();
            $this->Widget->setLinkButtons([
                [
                    'name' => '',
                    'icon' => 'bi-plus-lg',
                    'attributes' => ['href' => $this->base_uri . 'settings/company/taxes/add/', 'title' => $this->_('AdminCompanyTaxes.rules.categorylink_addrule', true)]
                ]
            ]);
            $this->Widget->setBodyWrapper(false);
            $this->Widget->create($this->_('AdminCompanyTaxes.rules.boxtitle_rules', true), ['id' => 'admin_company_taxes_rules'], ($render_section ?? null));
            ?>

                <div class="card-body pb-0">
                    <h6 class="form-section-header"><?php $this->_('AdminCompanyTaxes.rules.heading_level1');?></h6>
                </div>

                <?php
                // Level 1 tax rules
                if ((isset($rules['level_1']) ? $rules['level_1'] : false) && ($num_level1_rules = count($rules['level_1'])) > 0) {
                ?>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_name');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_type');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_amount');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_country');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_state');?></th>
                                    <th style="width: 100px;"><?php $this->_('AdminCompanyTaxes.rules.text_options');?></th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                // Display each level 1 tax rule
                                for ($i = 0; $i < $num_level1_rules; $i++) {
                                    $rule = $rules['level_1'][$i];
                                    $rule_type = (isset($rule->type) ? $this->Html->safe($rule->type, true) : null);
                                ?>
                                <tr>
                                    <td><?php echo (isset($rule->name) ? $this->Html->safe($rule->name) : null);?></td>
                                    <td><?php echo (isset($tax_types[$rule_type]) ? $tax_types[$rule_type] : null);?></td>
                                    <td><?php echo (isset($rule->amount) ? $this->Html->safe($rule->amount) : null);?>%</td>
                                    <td><?php echo (!empty($rule->country) ? (isset($rule->country) ? $this->Html->safe($rule->country) : null) : $this->_('AdminCompanyTaxes.rules.text_all', true));?></td>
                                    <td><?php echo (!empty($rule->state) ? (isset($rule->state) ? $this->Html->safe($rule->state) : null) : $this->_('AdminCompanyTaxes.rules.text_all', true));?></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="<?php echo $this->base_uri . 'settings/company/taxes/edit/' . (isset($rule->id) ? $this->Html->safe($rule->id) : null) . '/';?>"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="<?php echo $this->Html->safe($this->_('AdminCompanyTaxes.rules.option_edit', true));?>">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <?php
                                            $this->Form->create($this->base_uri . 'settings/company/taxes/delete/', ['class' => 'd-inline']);
                                            $this->Form->fieldHidden('id', (isset($rule->id) ? $rule->id : null));
                                            ?>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                                    data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyTaxes.rules.confirm_delete', true));?>"
                                                    title="<?php echo $this->Html->safe($this->_('AdminCompanyTaxes.rules.option_delete', true));?>">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            <?php
                                            $this->Form->end();
                                            ?>
                                        </div>
                                    </td>
                                </tr>
                                <?php
                                }
                                ?>
                            </tbody>
                        </table>
                    </div>
                <?php
                } else {
                ?>
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                    <p class="mt-3 mb-0"><?php $this->_('AdminCompanyTaxes.rules.no_results', false, 1);?></p>
                </div>
                <?php
                }
                ?>

                <div class="card-body pb-0">
                    <h6 class="form-section-header"><?php $this->_('AdminCompanyTaxes.rules.heading_level2');?></h6>
                </div>

                <?php
                // Level 2 tax rules
                if ((isset($rules['level_2']) ? $rules['level_2'] : false) && ($num_level2_rules = count($rules['level_2'])) > 0) {
                ?>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_name');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_type');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_amount');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_country');?></th>
                                    <th><?php $this->_('AdminCompanyTaxes.rules.text_state');?></th>
                                    <th style="width: 100px;"><?php $this->_('AdminCompanyTaxes.rules.text_options');?></th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                // Display each level 2 tax rule
                                for ($i = 0; $i < $num_level2_rules; $i++) {
                                    $rule = $rules['level_2'][$i];
                                    $rule_type = (isset($rule->type) ? $this->Html->safe($rule->type, true) : null);
                                ?>
                                <tr>
                                    <td><?php echo (isset($rule->name) ? $this->Html->safe($rule->name) : null);?></td>
                                    <td><?php echo (isset($tax_types[$rule_type]) ? $tax_types[$rule_type] : null);?></td>
                                    <td><?php echo (isset($rule->amount) ? $this->Html->safe($rule->amount) : null);?>%</td>
                                    <td><?php echo (!empty($rule->country) ? (isset($rule->country) ? $this->Html->safe($rule->country) : null) : $this->_('AdminCompanyTaxes.rules.text_all', true));?></td>
                                    <td><?php echo (!empty($rule->state) ? (isset($rule->state) ? $this->Html->safe($rule->state) : null) : $this->_('AdminCompanyTaxes.rules.text_all', true));?></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/taxes/edit/' . (isset($rule->id) ? $rule->id : null) . '/');?>"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="<?php echo $this->Html->safe($this->_('AdminCompanyTaxes.rules.option_edit', true));?>">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <?php
                                            $this->Form->create($this->base_uri . 'settings/company/taxes/delete/', ['class' => 'd-inline']);
                                            $this->Form->fieldHidden('id', (isset($rule->id) ? $rule->id : null));
                                            ?>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                                    data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyTaxes.rules.confirm_delete', true));?>"
                                                    title="<?php echo $this->Html->safe($this->_('AdminCompanyTaxes.rules.option_delete', true));?>">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            <?php
                                            $this->Form->end();
                                            ?>
                                        </div>
                                    </td>
                                </tr>
                                <?php
                                }
                                ?>
                            </tbody>
                        </table>
                    </div>
                <?php
                } else {
                ?>
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
