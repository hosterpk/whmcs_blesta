<script>
// Initialize color picker and manage group settings
document.addEventListener('DOMContentLoaded', function() {
    // Initialize native HTML5 color picker
    const colorPickers = document.querySelectorAll('.color-picker-input');
    colorPickers.forEach(function(colorPicker) {
        const textInputId = colorPicker.getAttribute('data-color-field');
        const textInput = document.getElementById(textInputId);

        if (!textInput) return;

        colorPicker.addEventListener('input', function() {
            textInput.value = this.value.substring(1);
        });

        colorPicker.addEventListener('change', function() {
            textInput.value = this.value.substring(1);
        });

        textInput.addEventListener('input', function() {
            let hexValue = this.value.trim();
            if (/^#?[0-9A-Fa-f]{6}$/.test(hexValue)) {
                if (!hexValue.startsWith('#')) {
                    hexValue = '#' + hexValue;
                }
                colorPicker.value = hexValue;
            }
        });

        textInput.addEventListener('change', function() {
            let hexValue = this.value.trim();
            if (/^#?[0-9A-Fa-f]{6}$/.test(hexValue)) {
                if (!hexValue.startsWith('#')) {
                    hexValue = '#' + hexValue;
                }
                colorPicker.value = hexValue;
                this.value = hexValue.substring(1);
            } else {
                const currentColor = colorPicker.value;
                this.value = currentColor.substring(1);
            }
        });
    });

    // Enable/disable setting fields
    const useCompanySettings = document.getElementById('use_company_settings');
    const groupSettings = document.getElementById('group_settings');

    if (useCompanySettings && groupSettings) {
        function updateSettingFields() {
            const inputs = groupSettings.querySelectorAll('input, select');

            if (useCompanySettings.checked) {
                // Disable all settings
                inputs.forEach(function(input) {
                    input.disabled = true;
                });
            } else {
                // Enable settings except for specific fields
                inputs.forEach(function(input) {
                    const id = input.getAttribute('id');
                    if (id === 'email' || id === 'first_name' || id === 'last_name' ||
                        id === 'delivery_method_email' || input.classList.contains('disabled')) {
                        input.disabled = true;
                    } else {
                        input.disabled = false;
                    }
                });

                // Disable the minimum field if the fee type is fixed
                groupSettings.querySelectorAll('.fee_type:checked').forEach(function(feeType) {
                    const minimumField = feeType.closest('div').querySelector('.minimum');
                    if (minimumField) {
                        if (feeType.value === 'fixed') {
                            minimumField.disabled = true;
                        } else {
                            minimumField.disabled = false;
                        }
                    }
                });

                // Disable the prevent payments checkbox if email verification is unchecked
                const emailVerification = document.getElementById('email_verification');
                const preventUnverifiedPayments = document.getElementById('prevent_unverified_payments');
                if (emailVerification && preventUnverifiedPayments) {
                    preventUnverifiedPayments.disabled = !emailVerification.checked;
                }
            }
        }

        // Initialize on page load
        updateSettingFields();

        // Update when checkbox changes
        useCompanySettings.addEventListener('change', updateSettingFields);
    }
});
</script>

<style>
.color-picker-input-group {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    width: fit-content;
}

.color-picker-input {
    width: 50px;
    height: 38px;
    padding: 2px;
    border: 1px solid var(--border-color, #dee2e6);
    border-radius: 0.375rem;
    cursor: pointer;
}

.color-text-input {
    font-family: monospace;
    width: 120px;
}

[data-bs-theme="dark"] .color-picker-input {
    border-color: var(--border-color, #2a2a2a);
}
</style>
