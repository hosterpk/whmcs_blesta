        <?php
        // Pinned Notes Data and JavaScript - show on any client page with notes
        if (!empty($sticky_notes_data) && count($sticky_notes_data) > 0) {
        ?>
        <script>
            var pinnedNotesData = <?php echo json_encode(array_map(function($note) {
                return [
                    'id' => $note->id,
                    'client_id' => $note->client_id,
                    'title' => $note->title ?? 'Note',
                    'description' => $note->description ?? '',
                    'author' => trim(($note->staff_first_name ?? '') . ' ' . ($note->staff_last_name ?? '')),
                    'date' => $this->Date->cast($note->date_updated ?? ''),
                    'link' => $this->base_uri . 'clients/editnote/' . $note->client_id . '/' . $note->id . '/'
                ];
            }, $sticky_notes_data));?>;
            var unpinUrl = '<?php echo $this->base_uri;?>clients/stickynotes/';
            var unpinText = <?php echo json_encode($this->_('AdminClients.pinnednotes.text_unpin', true));?>;

            document.addEventListener('DOMContentLoaded', function() {
                initPinnedNotes();
            });

            function initPinnedNotes() {
                var toggleBtn = document.getElementById('pinnedNotesToggle');
                if (!toggleBtn) return;

                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    showAllPinnedNotes();
                });
            }

            function showAllPinnedNotes() {
                var container = document.getElementById('toastContainer');
                if (!container) return;

                // Clear existing toasts
                container.innerHTML = '';

                // Create toasts for each note
                pinnedNotesData.forEach(function(note, index) {
                    var toast = createPinnedNoteToast(note);
                    container.appendChild(toast);

                    // Initialize and show the Bootstrap toast with staggered delay
                    setTimeout(function() {
                        var bsToast = new bootstrap.Toast(toast, {
                            autohide: true,
                            delay: 6000
                        });
                        bsToast.show();
                    }, index * 100);
                });
            }

            function createPinnedNoteToast(note) {
                var toast = document.createElement('div');
                toast.className = 'toast pinned-note-toast';
                toast.setAttribute('role', 'alert');
                toast.setAttribute('aria-live', 'assertive');
                toast.setAttribute('aria-atomic', 'true');
                toast.setAttribute('data-note-id', note.id);

                var truncatedTitle = note.title.length > 150
                    ? note.title.substring(0, 150) + '...'
                    : note.title;

                var truncatedDesc = note.description.length > 180
                    ? note.description.substring(0, 180) + '...'
                    : note.description;

                toast.innerHTML = '<div class="toast-header">' +
                    '<i class="bi bi-pin-angle-fill text-warning me-2"></i>' +
                    '<strong class="me-auto" title="' + escapeHtml(note.title) + '">' + escapeHtml(truncatedTitle) + '</strong>' +
                    '<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>' +
                '</div>' +
                '<div class="toast-body" onclick="window.location.href=\'' + note.link + '\'" style="cursor: pointer;">' +
                    '<div>' + escapeHtml(truncatedDesc) + '</div>' +
                    '<div class="note-meta">' +
                        '<span><i class="bi bi-person me-1"></i>' + escapeHtml(note.author) + '</span>' +
                        '<span><i class="bi bi-clock me-1"></i>' + escapeHtml(note.date) + '</span>' +
                    '</div>' +
                '</div>' +
                '<div class="toast-footer p-2">' +
                    '<button type="button" class="unpin-btn w-100" onclick="unpinNote(' + note.id + ', ' + note.client_id + ')">' +
                        '<i class="bi bi-pin-angle me-1"></i>' + unpinText +
                    '</button>' +
                '</div>';

                return toast;
            }

            function unpinNote(noteId, clientId) {
                var url = unpinUrl + clientId + '/' + noteId + '/';

                fetch(url, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(function(response) {
                    if (response.ok) {
                        // Remove the toast
                        var toast = document.querySelector('.toast[data-note-id="' + noteId + '"]');
                        if (toast) {
                            var bsToast = bootstrap.Toast.getInstance(toast);
                            if (bsToast) {
                                bsToast.hide();
                            }
                            toast.remove();
                        }

                        // Remove from data array
                        pinnedNotesData = pinnedNotesData.filter(function(note) {
                            return note.id != noteId;
                        });

                        // Update badge count
                        updatePinnedNotesBadge();
                    }
                })
                .catch(function(error) {
                    console.error('Error unpinning note:', error);
                });
            }

            function updatePinnedNotesBadge() {
                var badge = document.getElementById('pinnedNotesBadge');
                var toggleBtn = document.getElementById('pinnedNotesToggle');

                if (pinnedNotesData.length === 0) {
                    // Hide the icon completely if no notes left
                    if (toggleBtn) {
                        toggleBtn.style.display = 'none';
                    }
                } else if (badge) {
                    badge.textContent = pinnedNotesData.length;
                }
            }

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        </script>
        <?php
        }
        ?>

        <?php if (!empty($quick_jump_enabled)) { ?>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                initQuickJump();
            });

            function initQuickJump() {
                var quickJumpToggle = document.getElementById('quickJumpToggle');
                var quickJumpMenu = document.getElementById('quickJumpMenu');
                var quickJumpDropdown = quickJumpToggle ? quickJumpToggle.closest('.dropdown') : null;

                if (!quickJumpToggle || !quickJumpMenu || !quickJumpDropdown) return;

                // Build menu each time it opens to keep current sorted order.
                quickJumpDropdown.addEventListener('shown.bs.dropdown', function() {
                    buildQuickJumpMenu();
                });

                // Also refresh after any AJAX widget updates on client pages.
                document.addEventListener('blestaAjaxComplete', function() {
                    buildQuickJumpMenu();
                });

                buildQuickJumpMenu();
            }

            function buildQuickJumpMenu() {
                var container = document.getElementById('quickJumpMenuItems');
                var rightContainer = document.getElementById('right_container');

                if (!container) return;
                container.innerHTML = '';

                if (!rightContainer) {
                    appendQuickJumpEmpty(container);
                    return;
                }

                var widgets = rightContainer.querySelectorAll(<?php echo json_encode($quick_jump_widget_selector ?? '.column section.card[id]'); ?>);
                if (!widgets.length) {
                    appendQuickJumpEmpty(container);
                    return;
                }

                widgets.forEach(function(widget) {
                    var targetId = widget.getAttribute('id');
                    if (!targetId) return;

                    var headerTitle = widget.querySelector(<?php echo json_encode($quick_jump_header_selector ?? '.card-header h5'); ?>);
                    var title = headerTitle ? headerTitle.textContent.trim() : targetId;

                    var item = document.createElement('a');
                    item.className = 'dropdown-item';
                    item.href = '#' + targetId;
                    item.setAttribute('data-target-id', targetId);

                    var widgetId = widget.getAttribute('data-widget-id') || getFallbackWidgetId(widget);
                    if (widgetId) {
                        item.setAttribute('data-widget-id', widgetId);
                    }

                    item.textContent = title;
                    item.addEventListener('click', handleQuickJumpClick);
                    container.appendChild(item);
                });
            }

            function appendQuickJumpEmpty(container) {
                var emptyState = document.createElement('div');
                emptyState.className = 'dropdown-item-text text-secondary';
                emptyState.textContent = <?php echo json_encode($this->_('AdminClients.view.quick_jump_empty', true));?>;
                container.appendChild(emptyState);
            }

            function getFallbackWidgetId(widget) {
                if (!widget || !widget.id) return '';

                if (widget.id.indexOf('admin_clients_') === 0) {
                    return widget.id.substring('admin_clients_'.length);
                }

                return widget.id;
            }

            function handleQuickJumpClick(event) {
                event.preventDefault();

                var link = event.currentTarget;
                if (!link) return;

                var targetId = link.getAttribute('data-target-id');
                if (!targetId) return;

                var target = document.getElementById(targetId);
                if (!target) return;

                var topBar = document.querySelector('.top-bar');
                var offset = topBar ? topBar.offsetHeight + 16 : 16;
                var targetTop = target.getBoundingClientRect().top + window.pageYOffset - offset;

                window.scrollTo({
                    top: targetTop,
                    behavior: 'smooth'
                });
            }
        </script>
        <?php } ?>

        <?php
        if (isset($this->Css)) {
            echo $this->Css->getFiles('body');
            echo $this->Css->getInline();
        }

        if (isset($this->Javascript)) {
            echo $this->Javascript->getFiles('body');
            echo $this->Javascript->getInline();
        }

        echo ($body_end ?? null);
        ?>
    </body>
</html>
