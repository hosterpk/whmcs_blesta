    </div>
</div>

<script type="text/javascript">
(function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var clientId = <?php echo json_encode($client->id ?? null);?>;
    var textItemSelected = <?php echo json_encode($this->_('AdminClients.invoices.text_item_selected', true));?>;
    var textItemsSelected = <?php echo json_encode($this->_('AdminClients.invoices.text_items_selected', true));?>;

    // Update bulk actions bar visibility and count - looks up elements fresh each time
    function updateBulkActions() {
        var widgetContainer = document.getElementById('admin_clients_invoices');
        var invoiceAction = document.getElementById('invoice_action');
        var selectedCount = document.getElementById('invoicesSelectedCount');

        if (!widgetContainer || !invoiceAction) return;

        var checkedBoxes = widgetContainer.querySelectorAll('.row-checkbox:checked');
        if (checkedBoxes.length > 0) {
            invoiceAction.classList.remove('d-none');
            if (selectedCount) {
                var text = checkedBoxes.length === 1 ? textItemSelected : textItemsSelected;
                selectedCount.textContent = checkedBoxes.length + ' ' + text;
            }
        } else {
            invoiceAction.classList.add('d-none');
        }
    }

    // Update action input visibility
    function updateActionOptions() {
        var actionOptions = document.getElementById('action_options');
        var actionSelect = document.getElementById('action_select');
        var actionInputs = document.querySelectorAll('#action_options .action');

        // Hide all action inputs first
        actionInputs.forEach(function(input) {
            input.classList.add('d-none');
        });

        if (!actionSelect || !actionOptions) return;

        var selectedAction = actionSelect.value;

        // Show action options container if an action needs additional input
        if (selectedAction === 'electronic_invoice') {
            actionOptions.style.display = 'flex';
            var formatSelect = document.querySelector("#action_options select[name='electronic_invoice_format']");
            if (formatSelect) {
                formatSelect.classList.remove('d-none');
            }
        } else {
            var targetInput = document.querySelector("#action_options input[name='" + selectedAction + "']");
            if (targetInput) {
                actionOptions.style.display = 'flex';
                targetInput.classList.remove('d-none');
            } else {
                actionOptions.style.display = 'none';
            }
        }
    }

    // Use document-level event delegation so events work after AJAX content replacement
    document.addEventListener('change', function(e) {
        var target = e.target;
        var widgetContainer = document.getElementById('admin_clients_invoices');
        if (!widgetContainer || !widgetContainer.contains(target)) return;

        // Handle checkbox changes
        if (target.type === 'checkbox') {
            // Handle "select all" checkbox
            if (target.id === 'select-all') {
                var rowCheckboxes = widgetContainer.querySelectorAll('.row-checkbox');
                rowCheckboxes.forEach(function(cb) {
                    cb.checked = target.checked;
                });
            } else if (target.classList.contains('row-checkbox')) {
                // Uncheck "select all" if individual checkbox is unchecked
                var selectAllCheckbox = document.getElementById('select-all');
                if (!target.checked && selectAllCheckbox) {
                    selectAllCheckbox.checked = false;
                }
            }
            updateBulkActions();
            return;
        }

        // Handle action select change
        if (target.id === 'action_select' && target.closest('#invoice_action')) {
            updateActionOptions();
        }
    });

    // Handle click events with document-level delegation
    document.addEventListener('click', function(e) {
        var widgetContainer = document.getElementById('admin_clients_invoices');
        if (!widgetContainer) return;

        // Handle confirmation links
        var manageLink = e.target.closest('a.manage[rel]');
        if (manageLink && widgetContainer.contains(manageLink)) {
            e.stopPropagation();
            var message = manageLink.getAttribute('rel');
            if (message && !confirm(message)) {
                e.preventDefault();
            }
            return;
        }

    });

    // Lazy-load invoice details when expandable row opens
    document.addEventListener('show.bs.collapse', function(e) {
        var container = e.target.querySelector('.invoice-applied-container');
        if (!container) return;

        var invoiceId = container.getAttribute('data-invoice-id');
        if (!invoiceId || container.hasAttribute('data-loaded')) return;

        fetch(baseUri + 'clients/invoiceapplied/' + clientId + '/' + invoiceId + '/', {
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) {
            if (!response.ok) throw new Error('HTTP error ' + response.status);
            return response.text();
        })
        .then(function(html) {
            container.innerHTML = html;
            container.setAttribute('data-loaded', 'true');
        })
        .catch(function(error) {
            container.innerHTML = '<div class="alert alert-danger m-3">Error loading invoice details.</div>';
        });
    });

    // Validate invoices before voiding
    function submitInvoices(event) {
        var form = document.getElementById('invoices_form');
        var actionSelect = document.getElementById('action_select');

        if (actionSelect && actionSelect.value === 'void') {
            event.preventDefault();

            fetch(baseUri + 'clients/validateinvoices/', {
                method: 'POST',
                body: new FormData(form),
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (!data.continue) {
                    // Show validation modal
                    var modalContent = document.getElementById('validation_modal').innerHTML;
                    var modal = document.createElement('div');
                    modal.className = 'modal';
                    modal.innerHTML = '<div class="modal-dialog"><div class="modal-content">' + modalContent + '</div></div>';
                    document.body.appendChild(modal);

                    var modalInstance = new bootstrap.Modal(modal);
                    modalInstance.show();

                    modal.querySelector('.btn.continue').addEventListener('click', function() {
                        modalInstance.hide();
                        resubmitInvoices();
                    });

                    modal.querySelector('.btn.cancel').addEventListener('click', function() {
                        modalInstance.hide();
                    });

                    modal.addEventListener('hidden.bs.modal', function() {
                        document.body.removeChild(modal);
                    });
                } else {
                    resubmitInvoices();
                }
            })
            .catch(function(error) { console.error('Error:', error); });
        }
    }

    function resubmitInvoices() {
        var form = document.getElementById('invoices_form');
        if (form) {
            form.removeEventListener('submit', submitInvoices);
            form.submit();
        }
    }

    // Handle form submit for void validation
    document.addEventListener('submit', function(e) {
        var form = e.target;
        if (form.id === 'invoices_form') {
            var actionSelect = document.getElementById('action_select');
            if (actionSelect && actionSelect.value === 'void') {
                submitInvoices(e);
            }
        }
    });

    // Initialize on page load
    function init() {
        updateBulkActions();
        updateActionOptions();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
        // Content was loaded via AJAX after page load — notify expandable-rows.js
        document.dispatchEvent(new Event('blestaAjaxComplete'));
    }
})();
</script>
