    </div>
</div>

<script>
    // AI Generation functionality
    var aiState = {
        currentTarget: null,
        currentType: null,
        currentAction: null,
        currentLang: null,
        generatedContent: '',
        generatedHtml: '',
        generatedText: '',
        modal: null
    };

    var cachedPromptPreview = null;

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[data-ai-action]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();

                aiState.currentTarget = this.dataset.aiTarget;
                aiState.currentType = this.dataset.aiType;
                aiState.currentAction = this.dataset.aiAction;
                aiState.currentLang = this.dataset.aiLang;

                var modalEl = document.getElementById('aiEmailModal');
                aiState.modal = bootstrap.Modal.getOrCreateInstance(modalEl);

                document.getElementById('aiModalTitle').textContent = '<?php echo addslashes($this->_('AdminCompanyEmails.ai.modal_title_generate', true)); ?>';

                document.getElementById('aiGeneratedContent').innerHTML =
                    '<div class="text-center py-4 text-muted"><i class="bi bi-stars d-block mb-2" style="font-size: 2rem;"></i><p class="mb-0"><?php echo addslashes($this->_('AdminCompanyEmails.ai.initial_instructions', true)); ?></p></div>';

                document.getElementById('aiGenerateBtn').classList.remove('d-none');
                document.getElementById('aiGenerateBtn').disabled = false;
                document.getElementById('aiGenerateBtn').innerHTML = '<i class="bi bi-stars me-1"></i><?php echo addslashes($this->_('AdminCompanyEmails.ai.generate_button', true)); ?>';
                document.getElementById('aiUseContentBtn').classList.add('d-none');

                // Clear any previous Additional Instructions BEFORE fetching the prompt
                // preview — updatePromptPreview() reads the textarea value, and a stale
                // value from a prior modal session would otherwise be sent to the server
                // and shown as the preview context.
                document.getElementById('aiAdditionalPrompt').value = '';

                // Invalidate prompt preview on every modal open so language/target changes
                // and additional instructions are reflected if the user expands the context.
                cachedPromptPreview = null;
                updatePromptPreview();

                aiState.modal.show();
            });
        });

        function getExistingContent() {
            var existingContent = '';
            if (aiState.currentTarget && aiState.currentTarget.startsWith('html-')) {
                var langCode = aiState.currentTarget.replace('html-', '');
                var editorId = 'editor-' + langCode;
                var editorEl = document.getElementById(editorId);
                if (editorEl && window.ace) {
                    var editor = ace.edit(editorEl);
                    existingContent = editor.getValue();
                }
            }
            return existingContent;
        }

        function updatePromptPreview() {
            if (cachedPromptPreview) {
                document.getElementById('aiFullPrompt').textContent = cachedPromptPreview;
                return;
            }

            var additionalPrompt = document.getElementById('aiAdditionalPrompt').value.trim();
            var basePrompt = 'Generate professional HTML email wrapper content for this template type.';

            if (additionalPrompt) {
                basePrompt += '\n\nAdditional instructions: ' + additionalPrompt;
            }

            var formData = new URLSearchParams();
            var csrfToken = document.querySelector('input[name="_csrf_token"]');
            if (csrfToken) {
                formData.append('_csrf_token', csrfToken.value);
            }

            formData.append('prompt', basePrompt);
            formData.append('email_type', 'HTML Wrapper Template');
            formData.append('email_group_id', '0');
            formData.append('language', aiState.currentLang);
            formData.append('generate_html', aiState.currentType === 'email-html' ? 'true' : 'false');
            formData.append('generate_text', aiState.currentType === 'email-text' ? 'true' : 'false');
            formData.append('is_html_template', 'true');
            formData.append('tone', 'professional');

            document.getElementById('aiFullPrompt').innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span><?php echo addslashes($this->_('AdminCompanyEmails.ai.prompt_loading', true)); ?></span>';

            fetch('<?php echo $this->Html->safe($this->base_uri . "settings/company/emails/previewEmailPrompt/"); ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.success && data.full_prompt) {
                    cachedPromptPreview = data.full_prompt;
                    document.getElementById('aiFullPrompt').textContent = data.full_prompt;
                } else {
                    document.getElementById('aiFullPrompt').textContent = data.error || 'Failed to load prompt preview';
                }
            })
            .catch(function(error) {
                document.getElementById('aiFullPrompt').textContent = 'Error loading prompt: ' + error.message;
            });
        }

        function generateAiContent() {
            var formData = new URLSearchParams();
            var csrfToken = document.querySelector('input[name="_csrf_token"]');
            if (csrfToken) {
                formData.append('_csrf_token', csrfToken.value);
            }

            var additionalPrompt = document.getElementById('aiAdditionalPrompt').value.trim();
            var basePrompt = 'Generate professional HTML email wrapper content for this template type.';

            if (additionalPrompt) {
                basePrompt += '\n\nAdditional instructions: ' + additionalPrompt;
            }

            formData.append('prompt', basePrompt);
            formData.append('email_type', 'HTML Wrapper Template');
            formData.append('email_group_id', '0');
            formData.append('language', aiState.currentLang);
            formData.append('generate_html', aiState.currentType === 'email-html' ? 'true' : 'false');
            formData.append('generate_text', aiState.currentType === 'email-text' ? 'true' : 'false');
            formData.append('is_html_template', 'true');
            formData.append('tone', 'professional');

            fetch('<?php echo $this->Html->safe($this->base_uri . "settings/company/emails/generateEmailContent/"); ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                var generateBtn = document.getElementById('aiGenerateBtn');
                generateBtn.disabled = false;
                generateBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i><?php echo addslashes($this->_('AdminCompanyEmails.ai.regenerate_button', true)); ?>';

                if (data.success) {
                    aiState.generatedHtml = data.html || '';
                    aiState.generatedText = data.text || '';
                    aiState.generatedContent = aiState.generatedHtml || aiState.generatedText;

                    var previewHtml = '';
                    if (aiState.generatedHtml) {
                        var sanitizedHtml = aiState.generatedHtml;
                        if (typeof DOMPurify !== 'undefined') {
                            sanitizedHtml = DOMPurify.sanitize(aiState.generatedHtml, {
                                ALLOWED_TAGS: ['p', 'br', 'b', 'strong', 'i', 'em', 'u', 'a', 'ul', 'ol', 'li', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'div', 'span', 'table', 'tr', 'td', 'th', 'tbody', 'thead'],
                                ALLOWED_ATTR: ['href', 'style', 'class']
                            });
                        }
                        previewHtml += '<div class="mb-3"><strong class="d-block mb-2"><?php echo addslashes($this->_('AdminCompanyEmails.ai.preview_html', true)); ?></strong><div class="border rounded p-3 bg-body-secondary ai-email-preview">' + sanitizedHtml + '</div></div>';
                    }
                    
                    document.getElementById('aiGeneratedContent').innerHTML = previewHtml || '<div class="text-muted">No content generated</div>';
                    document.getElementById('aiUseContentBtn').classList.remove('d-none');
                } else {
                    document.getElementById('aiGeneratedContent').innerHTML =
                        '<div class="alert alert-danger mb-0">' + escapeHtml(data.error || '<?php echo addslashes($this->_('AdminCompanyEmails.ai.error_generation_failed', true)); ?>') + '</div>';
                }
            })
            .catch(function(error) {
                var generateBtn = document.getElementById('aiGenerateBtn');
                generateBtn.disabled = false;
                generateBtn.innerHTML = '<i class="bi bi-stars me-1"></i><?php echo addslashes($this->_('AdminCompanyEmails.ai.generate_button', true)); ?>';

                document.getElementById('aiGeneratedContent').innerHTML =
                    '<div class="alert alert-danger mb-0"><?php echo addslashes($this->_('AdminCompanyEmails.ai.error_prefix', true)); ?> ' + escapeHtml(error.message) + '</div>';
            });
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        var useContentBtn = document.getElementById('aiUseContentBtn');
        if (useContentBtn) {
            useContentBtn.addEventListener('click', function() {
                if (!aiState.generatedContent) {
                    return;
                }

                if (aiState.currentTarget && aiState.currentTarget.startsWith('html-') && aiState.generatedHtml) {
                    var langCode = aiState.currentTarget.replace('html-', '');
                    var editorId = 'editor-' + langCode;
                    var editorEl = document.getElementById(editorId);
                    if (editorEl && window.ace) {
                        var editor = ace.edit(editorEl);
                        editor.setValue(aiState.generatedHtml, -1);
                    }
                }

                aiState.modal.hide();
            });
        }

        var generateBtn = document.getElementById('aiGenerateBtn');
        if (generateBtn) {
            generateBtn.addEventListener('click', function() {
                generateBtn.disabled = true;
                generateBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span><?php echo addslashes($this->_('AdminCompanyEmails.ai.generating', true)); ?>';

                document.getElementById('aiGeneratedContent').innerHTML =
                    '<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted"><?php echo addslashes($this->_('AdminCompanyEmails.ai.generating', true)); ?></p></div>';

                generateAiContent();
            });
        }

        // Refetch the prompt preview whenever the context accordion is expanded
        // so it reflects any Additional Instructions the user has typed.
        var promptContext = document.getElementById('aiPromptContext');
        if (promptContext) {
            promptContext.addEventListener('show.bs.collapse', function() {
                cachedPromptPreview = null;
                updatePromptPreview();
            });
        }
    });
</script>
<?php endif; ?>
