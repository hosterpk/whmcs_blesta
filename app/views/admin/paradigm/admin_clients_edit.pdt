<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var clientId = <?php echo json_encode((isset($client->id) ? $client->id : null));?>;
    var taxCountries = <?php echo json_encode(($tax_countries ?? []));?>;
    var taxExemptionEnabled = <?php echo (($tax_exemption_enabled ?? false) ? 'true' : 'false');?>;
    var clientGroupCreditEnabled = <?php echo json_encode(($client_group_settings['payment_credit_enabled'] ?? '0') == '1');?>;

    var countryCode = document.getElementById('country');
    var stateSelect = document.getElementById('state');
    var clientGroupId = document.getElementById('client_group_id');
    var usernameTypeEmail = document.getElementById('username_type_email');
    var usernameTypeUsername = document.getElementById('username_type_username');
    var usernameFieldWrapper = document.querySelector('.username-field-wrapper');
    var usernameNoteAlert = document.getElementById('username-note-alert');
    var inheritGatewayRestrictions = document.getElementById('inherit_gateway_restrictions');
    var gatewayRestrictionsForm = document.getElementById('gateway-restrictions-form');
    var inheritCreditHandling = document.getElementById('inherit_credit_handling');
    var creditHandlingForm = document.getElementById('credit-handling-form');
    var lowBalanceNotificationsSection = document.getElementById('low-balance-notifications-section');
    var customFieldsContainer = document.getElementById('custom-fields');
    var taxExempt = document.getElementById('tax_exempt');
    var taxId = document.getElementById('tax_id');
    var taxExemptTooltip = document.querySelector('.tax-exempt-tooltip');

    // Initialize
    updateCustomFields({group_id: clientGroupId ? clientGroupId.value : '', client_id: clientId});
    if (taxExemptionEnabled) {
        updateTaxExempt();
    }

    // Show/hide username field based on selection
    if (usernameTypeEmail && usernameTypeEmail.checked) {
        if (usernameFieldWrapper) usernameFieldWrapper.style.display = 'none';
    }

    if (usernameTypeEmail) {
        usernameTypeEmail.addEventListener('change', function() {
            if (this.checked && usernameFieldWrapper) {
                usernameFieldWrapper.style.display = 'none';
            }
        });
    }

    if (usernameTypeUsername) {
        usernameTypeUsername.addEventListener('change', function() {
            if (this.checked && usernameFieldWrapper) {
                usernameFieldWrapper.style.display = 'block';
            }
        });
    }

    // Country change - fetch states
    if (countryCode) {
        countryCode.addEventListener('change', function() {
            var country = this.value;
            fetch(baseUri + 'clients/getstates/' + country, {
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(response => response.json())
            .then(data => {
                if (stateSelect && data) {
                    stateSelect.innerHTML = '';
                    Object.keys(data).sort().forEach(function(key) {
                        var option = document.createElement('option');
                        option.value = key;
                        option.textContent = data[key];
                        stateSelect.appendChild(option);
                    });
                }
                if (taxExemptionEnabled) {
                    updateTaxExempt();
                }
            })
            .catch(error => console.error('Error fetching states:', error));
        });
    }

    // Client group change - update custom fields
    if (clientGroupId) {
        clientGroupId.addEventListener('change', function() {
            updateCustomFields({group_id: this.value, client_id: clientId});
        });
    }

    // Gateway restrictions toggle
    if (inheritGatewayRestrictions && gatewayRestrictionsForm) {
        inheritGatewayRestrictions.addEventListener('change', function() {
            if (this.checked) {
                gatewayRestrictionsForm.style.display = 'none';
            } else {
                gatewayRestrictionsForm.style.display = 'block';
            }
        });

        // Initial state
        if (inheritGatewayRestrictions.checked) {
            gatewayRestrictionsForm.style.display = 'none';
        } else {
            gatewayRestrictionsForm.style.display = 'block';
        }
    }

    // Credit handling toggle
    if (inheritCreditHandling && creditHandlingForm && lowBalanceNotificationsSection) {
        inheritCreditHandling.addEventListener('change', function() {
            updateCreditHandlingVisibility();
        });

        // Initial state
        updateCreditHandlingVisibility();

        // Listen for payment_credit_enabled changes
        document.addEventListener('change', function(e) {
            if (e.target && e.target.id === 'payment_credit_enabled') {
                updateCreditHandlingVisibility();
            }
        });
    }

    function updateCreditHandlingVisibility() {
        if (!inheritCreditHandling || !creditHandlingForm || !lowBalanceNotificationsSection) return;

        var creditEnabled = false;
        if (inheritCreditHandling.checked) {
            creditHandlingForm.style.display = 'none';
            creditEnabled = clientGroupCreditEnabled;
        } else {
            creditHandlingForm.style.display = 'block';
            var paymentCreditEnabled = document.getElementById('payment_credit_enabled');
            creditEnabled = paymentCreditEnabled ? paymentCreditEnabled.checked : false;
        }

        lowBalanceNotificationsSection.style.display = creditEnabled ? 'block' : 'none';

        // Update credit limits visibility
        var creditLimitsSection = document.getElementById('credit_limits_section');
        if (creditLimitsSection) {
            creditLimitsSection.style.display = inheritCreditHandling.checked ? 'none' : 'block';
        }
    }

    function updateCustomFields(params) {
        var queryString = new URLSearchParams(params).toString();
        fetch(baseUri + 'clients/getcustomfields/?' + queryString, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data && customFieldsContainer) {
                if (data.custom_fields) {
                    customFieldsContainer.innerHTML = data.custom_fields;
                }

                if (usernameFieldWrapper && usernameNoteAlert) {
                    if (data.force_email_usernames === 'true') {
                        usernameFieldWrapper.style.display = 'none';
                        usernameNoteAlert.classList.remove('d-none');
                    } else {
                        usernameFieldWrapper.style.display = (usernameTypeEmail && usernameTypeEmail.checked) ? 'none' : 'block';
                        usernameNoteAlert.classList.add('d-none');
                    }
                }
            }
        })
        .catch(error => console.error('Error fetching custom fields:', error));
    }

    function updateTaxExempt() {
        if (!taxExempt || !countryCode || !taxId) return;

        var country = countryCode.value;
        var taxIdValue = taxId.value;

        if (taxCountries.includes(country) && taxIdValue !== '') {
            taxExempt.disabled = true;
            if (taxExemptTooltip) taxExemptTooltip.classList.remove('d-none');
        } else {
            taxExempt.disabled = false;
            if (taxExemptTooltip) taxExemptTooltip.classList.add('d-none');
        }
    }

    // Listen for tax_id changes
    if (taxId && taxExemptionEnabled) {
        taxId.addEventListener('change', updateTaxExempt);
    }
});
</script>
