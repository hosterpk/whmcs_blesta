<?php /** @var View $this **/ ?>

<?php
$link_buttons = [
    [
        'icon' => 'bi bi-plus-lg',
        'name' => '',
        'attributes' => [
            'title' => $this->_('AdminClients.contacts.categorylink_create', true),
            'href' => $this->base_uri . 'clients/addcontact/' . ($client->id ?? null) . '/'
        ]
    ]
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);

$this->Widget->create($this->_('AdminClients.contacts.boxtitle_contacts', true), ['id' => 'admin_clients_contacts'], ($render_section ?? null));

if (($contacts ?? false) && ($num_contacts = count($contacts)) > 0) {
?>
<div class="table-responsive">
    <table class="table table-hover mb-0" id="contacts_table">
        <thead>
            <tr>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/contacts/' . ($client->id ?? null) . '/?sort=last_name&order=' . ($sort == 'last_name' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminClients.contacts.heading_name');?>
                        <?php if ($sort == 'last_name') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/contacts/' . ($client->id ?? null) . '/?sort=email&order=' . ($sort == 'email' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminClients.contacts.heading_email');?>
                        <?php if ($sort == 'email') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th><?php $this->_('AdminClients.contacts.heading_type');?></th>
                <th class="text-end" style="width: 100px;"><?php $this->_('AdminClients.contacts.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php for ($i = 0; $i < $num_contacts; $i++) { ?>
            <tr>
                <td><?php echo $this->Html->concat(' ', ($contacts[$i]->first_name ?? null), ($contacts[$i]->last_name ?? null));?></td>
                <td><?php echo $this->Html->safe($contacts[$i]->email ?? null);?></td>
                <td>
                    <?php
                    if (($contacts[$i]->contact_type ?? null) !== 'other') {
                        echo $this->Html->safe($contact_types[$contacts[$i]->contact_type] ?? $contacts[$i]->contact_type);
                    } else {
                        echo $this->Html->safe($contact_types[$contacts[$i]->contact_type_id ?? ''] ?? ($contact_types['other'] ?? ''));
                    }
                    ?>
                </td>
                <td class="text-end">
                    <div class="d-flex gap-1 justify-content-end">
                        <a href="<?php echo $this->base_uri . 'clients/editcontact/' . ($contacts[$i]->client_id ?? null) . '/' . ($contacts[$i]->id ?? null) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminClients.contacts.option_edit');?>">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <?php
                        $this->Form->create($this->base_uri . 'clients/deletecontact/' . ($contacts[$i]->client_id ?? null) . '/' . ($contacts[$i]->id ?? null) . '/', ['class' => 'd-inline']);
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                            data-confirm-message="<?php echo $this->Html->safe($this->_('AdminClients.contacts.confirm_delete', true));?>"
                            title="<?php $this->_('AdminClients.contacts.option_delete');?>">
                            <i class="bi bi-trash"></i>
                        </button>
                        <?php $this->Form->end();?>
                    </div>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>
<?php
    if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        $this->Widget->footer();
        $this->Pagination->build();
    }
} else {
?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-people" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminClients.contacts.no_results');?></p>
</div>
<?php
}

$this->Widget->end();
?>
