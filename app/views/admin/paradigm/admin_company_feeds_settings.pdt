<?php /** @var View $this **/ ?>

        <div class="main-content-padding">
            <?php echo (isset($message) ? $message : null);?>

            <?php
            $this->Widget->clear();
            $this->Widget->create($this->_('AdminCompanyFeeds.settings.boxtitle_feed_settings', true), ['id' => 'admin_company_feeds_settings']);

            $this->Form->create(null, ['class' => 'disable-on-submit']);
            ?>

                    <?php
                    if (!empty($feeds)) {
                        $i = 0;
                        foreach ($feeds as $feed) {
                    ?>
                    <h6 class="form-section-header<?php echo ($i > 0 ? ' mt-4' : '');?>"><?php echo $this->Html->safe($feed->name);?></h6>
                    <p class="text-muted mb-3"><?php echo $this->Html->safe($feed->description);?></p>

                    <?php
                    if (!empty($feed->endpoints)) {
                    ?>
                    <h6 class="form-section-header mt-4"><?php $this->_('AdminCompanyFeeds.settings.header_endpoints');?></h6>
                    <?php
                        foreach ($feed->endpoints as $endpoint) {
                    ?>
                    <div class="form-check mb-2">
                        <?php
                        $this->Form->fieldCheckbox(
                            'endpoint[' . $endpoint->id . ']',
                            '1',
                            ($vars['endpoint'][$endpoint->id] ?? $endpoint->enabled) == '1',
                            ['id' => 'endpoint_' . $endpoint->id, 'class' => 'form-check-input']
                        );
                        ?>
                        <label for="endpoint_<?php echo $this->Html->safe($endpoint->id);?>" class="form-check-label">
                            <?php echo $this->Html->safe($endpoint->feed . '/' . $endpoint->endpoint);?>
                        </label>
                    </div>
                    <?php
                        }
                    ?>
                    <?php
                    }

                    // Show data feed fields
                    if (isset($feed->fields) && ($feed_field_html = $feed->fields->generate(null, $this->view))) {
                    ?>
                    <div class="mt-4">
                        <?php echo $feed_field_html;?>
                    </div>
                    <?php
                    }
                    ?>

                    <?php
                            $i++;
                        }
                    } else {
                    ?>
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3 mb-0"><?php $this->_('AppController.noResults');?></p>
                    </div>
                    <?php
                    }
                    ?>

                <?php if (!empty($feeds)) { ?>
                <?php $this->Widget->footer(); ?>
                <div class="d-flex justify-content-end">
                    <?php
                    $this->Form->fieldSubmit(
                        'save',
                        $this->_('AdminCompanyFeeds.settings.field_submit', true),
                        ['class' => 'btn btn-primary']
                    );
                    ?>
                </div>
                <?php } ?>
                <?php
                $this->Form->end();
                $this->Widget->end();
                ?>
        </div>
