                    <td><?php $this->Form->fieldText('lines[amount][]', $this->CurrencyFormat->format(($vars->line_items[$i]->amount ?? null), (isset($vars->currency) ? $vars->currency : null), ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false, 'decimals' => 4]), ['class' => 'form-control form-control-sm line-item-unit-cost']);?></td>
