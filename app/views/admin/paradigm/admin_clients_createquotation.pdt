                        $this->Form->label($this->_('AdminClients.createquotation.field_notes', true), 'notes', ['class' => 'form-label']);
                        $this->Form->fieldTextarea('notes', ($vars->notes ?? null), ['id' => 'notes', 'class' => 'form-control']);
