<?php /** @var View $this **/ ?>


        <?php
        if (!(isset($is_ajax) ? $is_ajax : false)) {
        ?>
        <div class="main-content-padding">
            <?php echo (isset($message) ? $message : null);?>
        <?php
        }
        $this->Widget->clear();
        $this->Widget->setLinkButtons([
            [
                'name' => '',
                'icon' => 'bi-plus-lg',
                'attributes' => [
                    'href' => $this->base_uri . 'settings/system/companies/add/',
                    'title' => $this->_('AdminSystemCompanies.index.categorylink_addcompany', true)
                ]
            ]
        ]);
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminSystemCompanies.index.boxtitle_companies', true), ['id' => 'admin_system_companies'], ($render_section ?? null));
        ?>
    <?php
    if ((isset($companies) ? $companies : false) && count($companies) > 0) {
    ?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/companies/index/?sort=name&order=' . ($sort == 'name' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'name' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemCompanies.index.text_name');?>
                            <?php if ($sort == 'name') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/companies/index/?sort=hostname&order=' . ($sort == 'hostname' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'hostname' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemCompanies.index.text_hostname');?>
                            <?php if ($sort == 'hostname') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/companies/index/?sort=address&order=' . ($sort == 'address' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'address' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemCompanies.index.text_address');?>
                            <?php if ($sort == 'address') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/companies/index/?sort=phone&order=' . ($sort == 'phone' ? $negate_order : $order));?>"
                           class="ajax text-decoration-none<?php echo $sort == 'phone' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminSystemCompanies.index.text_phone');?>
                            <?php if ($sort == 'phone') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th style="width: 100px;"><?php $this->_('AdminSystemCompanies.index.text_options');?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                foreach ($companies as $company) {
                    $current_company_id = Configure::get('Blesta.company_id');
                ?>
                <tr>
                    <td><?php echo $this->Html->safe($company->name ?? '');?></td>
                    <td><?php echo $this->Html->safe($company->hostname ?? '');?></td>
                    <td><?php echo $this->Html->safe($company->address ?? '');?></td>
                    <td><?php echo $this->Html->safe($company->phone ?? '');?></td>
                    <td>
                        <div class="d-flex gap-2">
                            <a href="<?php echo $this->base_uri . 'settings/system/companies/edit/' . $this->Html->safe($company->id ?? '') . '/';?>"
                               class="btn btn-sm btn-outline-secondary"
                               title="<?php echo $this->Html->safe($this->_('AdminSystemCompanies.index.option_edit', true));?>">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <?php
                            // Don't allow deleting the current company
                            if (($company->id ?? 0) != $current_company_id) {
                                $this->Form->create($this->base_uri . 'settings/system/companies/delete/', ['class' => 'd-inline']);
                                $this->Form->fieldHidden('id', $this->Html->safe($company->id ?? ''));
                            ?>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                    data-confirm-message="<?php echo $this->Html->safe($this->_('AdminSystemCompanies.index.confirm_delete', true));?>"
                                    title="<?php echo $this->Html->safe($this->_('AdminSystemCompanies.index.option_delete', true));?>">
                                <i class="bi bi-trash"></i>
                            </button>
                            <?php
                                $this->Form->end();
                            }
                            ?>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
            </tbody>
        </table>
    </div>
    <?php
    if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        $this->Widget->footer();
        $this->Pagination->build();
    }
    ?>
    <?php } else { ?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('AdminSystemCompanies.index.no_results');?></p>
    </div>
    <?php } ?>
        <?php
        $this->Widget->end();

        if (!(isset($is_ajax) ? $is_ajax : false)) {
        ?>
        </div>
        <?php
        }
        ?>
