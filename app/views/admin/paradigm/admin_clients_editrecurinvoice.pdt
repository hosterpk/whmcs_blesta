<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Handle confirmation
    var deleteLink = document.querySelector('#admin_clients_editrecurinvoice a.btn[rel]');
    if (deleteLink) {
        deleteLink.addEventListener('click', function(e) {
            var message = this.getAttribute('rel');
            if (message && !confirm(message)) {
                e.preventDefault();
                return false;
            }
        });
    }

    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function(el) {
        return new bootstrap.Tooltip(el);
    });

    // Set the invoice totals
    var totalsUri = '<?php echo (isset($this->base_uri) ? $this->Html->safe($this->base_uri) : null) . 'clients/calcLineTotals/' . (isset($client->id) ? $this->Html->safe($client->id) : null);?>';
    var form = document.getElementById('edit-recur-invoice');

    calculateTotals();

    // Initialize date pickers
    if (typeof blestaBindDatePicker === 'function') {
        blestaBindDatePicker();
    }

    // Whenever the tax box is checked, we need to set the line tax to update
    var taxCheckboxes = document.querySelectorAll('input[name="tax[]"]');
    taxCheckboxes.forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
            var hiddenTax = this.parentElement.querySelector('input[name="lines[tax][]"]');
            if (hiddenTax) {
                hiddenTax.value = this.checked ? 'true' : 'false';
            }
            calculateTotals();
        });
    });

    // Set invoice totals when amount quantity, tax status, or currency changes
    var changeFields = document.querySelectorAll('input[name="lines[amount][]"], input[name="lines[qty][]"], #currency');
    changeFields.forEach(function(field) {
        field.addEventListener('change', calculateTotals);
    });

    // Allow sort of invoice lines
    var tbody = document.querySelector('table.table.invoice tbody');
    if (tbody && typeof Sortable !== 'undefined') {
        new Sortable(tbody, {
            handle: '.movable',
            animation: 150,
            onEnd: function() {
                formatLineRows();
            }
        });
    }

    // Show/hide movable icon on hover
    var lineRows = document.querySelectorAll('table.table.invoice tbody tr');
    lineRows.forEach(function(row) {
        row.addEventListener('mouseenter', function() {
            var movable = this.querySelector('.movable');
            if (movable) movable.style.display = 'inline-block';
        });
        row.addEventListener('mouseleave', function() {
            var movable = this.querySelector('.movable');
            if (movable) movable.style.display = 'none';
        });
    });

    // Check the 'number of times' field
    var durationTime = document.getElementById('duration_time');
    if (durationTime) {
        durationTime.addEventListener('focus', function() {
            var durationRadio = document.getElementById('duration');
            if (durationRadio) {
                durationRadio.checked = true;
            }
        });
    }

    // Add line row
    var addLinks = document.querySelectorAll('.line_row_add');
    addLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            var firstRow = document.querySelector('tr.line_row:first-child');
            if (!firstRow) return;

            var fields = firstRow.cloneNode(true);
            fields.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function(el) {
                el.value = '';
            });
            fields.querySelectorAll('input[type="checkbox"], input[type="radio"]').forEach(function(el) {
                el.checked = false;
            });
            fields.querySelectorAll('option:selected').forEach(function(el) {
                el.selected = false;
            });

            var currentRow = this.closest('tr');
            currentRow.insertAdjacentElement('afterend', fields);

            var lineId = fields.querySelector('.line_id');
            if (lineId) lineId.remove();

            var movable = fields.querySelector('.movable');
            if (movable) movable.style.display = 'none';

            formatLineRows();
        });
    });

    // Delete line row
    var deleteLinks = document.querySelectorAll('.line_row_delete');
    deleteLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            var lineRows = document.querySelectorAll('tr.line_row');
            if (lineRows.length <= 1) return;

            var currentRow = this.closest('tr');
            var lineItem = currentRow.querySelector('.line_id');
            var lastRow = document.querySelector('tr.line_row:last-child');

            if (lineItem && lastRow) {
                var cloned = lineItem.cloneNode(true);
                lastRow.insertAdjacentElement('afterend', cloned);
            }

            currentRow.remove();
            calculateTotals();
            formatLineRows();
        });
    });

    function formatLineRows() {
        var lineRows = document.querySelectorAll('tr.line_row');
        lineRows.forEach(function(row) {
            row.classList.remove('odd_row');
        });
        lineRows.forEach(function(row, index) {
            if (index % 2 === 1) {
                row.classList.add('odd_row');
            }
        });
    }

    function calculateTotals() {
        var formData = new FormData(form);
        fetch(totalsUri, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(response => response.json())
        .then(function(data) {
            if (data.subtotal !== undefined) {
                document.querySelector('.pricing-line em').textContent = data.subtotal;
            }
            if (data.total !== undefined) {
                document.querySelector('.pricing-total em').textContent = data.total;
            }
            if (data.taxes && Array.isArray(data.taxes)) {
                var taxRows = document.querySelectorAll('.pricing-tax');
                taxRows.forEach(function(row) {
                    row.style.display = 'none';
                });
                data.taxes.forEach(function(tax, i) {
                    var taxRow = taxRows[i];
                    if (taxRow) {
                        taxRow.style.display = 'flex';
                        taxRow.querySelector('.pricing-label').textContent = tax.name;
                        taxRow.querySelector('em').textContent = tax.amount;
                    }
                });
            }
        })
        .catch(error => console.error('Error:', error));
    }
});
</script>
