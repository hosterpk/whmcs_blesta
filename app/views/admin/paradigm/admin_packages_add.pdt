<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize popovers
    var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
    var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
        return new bootstrap.Popover(popoverTriggerEl);
    });

    // Show/hide package group type
    function showPackageGroupType(value) {
        if (value == 'new') {
            var groupSelection = document.getElementById('groupSelectionContainer');
            var addPackageGroup = document.getElementById('add_package_group');
            if (groupSelection) groupSelection.style.display = 'none';
            if (addPackageGroup) addPackageGroup.style.display = 'block';
        } else {
            var groupSelection = document.getElementById('groupSelectionContainer');
            var addPackageGroup = document.getElementById('add_package_group');
            if (addPackageGroup) addPackageGroup.style.display = 'none';
            if (groupSelection) groupSelection.style.display = 'block';
        }
    }

    var checkedGroupType = document.querySelector('.select_group_type:checked');
    if (checkedGroupType) {
        showPackageGroupType(checkedGroupType.value);
    }
    document.querySelectorAll('.select_group_type').forEach(function(el) {
        el.addEventListener('change', function() {
            showPackageGroupType(this.value);
        });
    });

    // Quantity field focus handlers
    var qty = document.getElementById('qty');
    if (qty) {
        qty.addEventListener('focus', function() {
            var qtyLimited = document.getElementById('qty_limited');
            if (qtyLimited) qtyLimited.checked = true;
        });
    }

    var clientQty = document.getElementById('client_qty');
    if (clientQty) {
        clientQty.addEventListener('focus', function() {
            var clientQtyLimited = document.getElementById('client_qty_limited');
            if (clientQtyLimited) clientQtyLimited.checked = true;
        });
    }

    // Pro rata options visibility
    function showProrataOptions() {
        var prorata = document.getElementById('prorata');
        var prorataOptions = document.getElementById('prorata_options');
        if (prorata && prorataOptions) {
            if (prorata.checked) {
                prorataOptions.style.display = 'block';
            } else {
                prorataOptions.style.display = 'none';
            }
        }
    }

    showProrataOptions();
    var prorata = document.getElementById('prorata');
    if (prorata) {
        prorata.addEventListener('change', showProrataOptions);
    }

    // Price row management
    function updatePriceRows() {
        var i = 0;
        document.querySelectorAll('tr.price_row').forEach(function(row) {
            if (i++ % 2 == 1) {
                row.classList.add('table-secondary');
            } else {
                row.classList.remove('table-secondary');
            }
        });
    }

    updatePriceRows();

    // Add/Remove price row logic via event delegation
    document.addEventListener('click', function(e) {
        if (e.target.closest('.price_row_add')) {
            var firstRow = document.querySelector('tr.price_row');
            if (!firstRow) return;
            var newRow = firstRow.cloneNode(true);
            
            // Remove input text/hidden and textarea data
            newRow.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function(el) {
                el.value = '';
                el.disabled = false;
            });
            // Remove checkbox/radio data
            newRow.querySelectorAll('input[type="checkbox"], input[type="radio"]').forEach(function(el) {
                el.checked = false;
            });

            // Remove pricing ID
            newRow.querySelectorAll('input.pricing_id').forEach(function(el) {
                el.remove();
            });

            // Set the first row's currency/period
            var currencySelect = firstRow.querySelector('select[name="pricing[currency][]"]');
            var periodSelect = firstRow.querySelector('select[name="pricing[period][]"]');
            var currency = currencySelect ? currencySelect.value : null;
            var period = periodSelect ? periodSelect.value : null;
            
            if (period) {
                var newPeriodOption = newRow.querySelector('select[name="pricing[period][]"] option[value="' + period + '"]');
                if (newPeriodOption) newPeriodOption.selected = true;
            }
            if (currency) {
                var newCurrencyOption = newRow.querySelector('select[name="pricing[currency][]"] option[value="' + currency + '"]');
                if (newCurrencyOption) newCurrencyOption.selected = true;
            }

            // Disable the term if it's one time
            if (period == 'onetime') {
                newRow.querySelectorAll('input.term').forEach(function(el) { el.disabled = true; });
                newRow.querySelectorAll('input.price_enable_renews').forEach(function(el) { el.disabled = true; });
            }

            // Disable renewal price
            newRow.querySelectorAll('input.price_renews').forEach(function(el) { el.disabled = true; });
            newRow.querySelectorAll('input.price_enable_renews').forEach(function(el) { el.value = '1'; });

            // Set value to default checkboxes
            newRow.querySelectorAll('input[name="pricing[default][]"]').forEach(function(el) { el.value = '1'; });

            var allRows = document.querySelectorAll('tr.price_row');
            var lastRow = allRows[allRows.length - 1];
            lastRow.parentNode.insertBefore(newRow, lastRow.nextSibling);
            
            updatePriceRows();
            if (typeof updateDefaultCheckboxes === 'function') updateDefaultCheckboxes();
            e.preventDefault();
        }

        if (e.target.closest('.price_row_remove')) {
            var rows = document.querySelectorAll('tr.price_row');
            if (rows.length > 1) {
                var tr = e.target.closest('tr');
                // Keep ID, remove everything else
                var pricingId = tr.querySelector('input.pricing_id');
                if (pricingId) {
                    var lastRow = rows[rows.length - 1];
                    lastRow.parentNode.insertBefore(pricingId, lastRow.nextSibling);
                }
                tr.remove();
            }
            updatePriceRows();
            if (typeof updateDefaultCheckboxes === 'function') updateDefaultCheckboxes();
            e.preventDefault();
        }
    });

    // Period change handler
    document.addEventListener('change', function(e) {
        if (e.target.matches('.price_row select.period')) {
            var row = e.target.closest('.price_row');
            if (e.target.value == 'onetime') {
                var term = row.querySelector('input.term');
                if (term) {
                    term.disabled = true;
                    term.value = '';
                }

                var enableRenews = row.querySelector('input.price_enable_renews');
                if (enableRenews) {
                    enableRenews.disabled = true;
                    enableRenews.checked = false;
                }

                var priceRenews = row.querySelector('input.price_renews');
                if (priceRenews) {
                    priceRenews.disabled = true;
                    priceRenews.value = '';
                }
            } else {
                var term = row.querySelector('input.term');
                if (term) term.disabled = false;
                
                var enableRenews = row.querySelector('input.price_enable_renews');
                if (enableRenews) enableRenews.disabled = false;

                var priceRenews = row.querySelector('input.price_renews');
                var price = row.querySelector('input[name="pricing[price][]"]');
                if (priceRenews && price) {
                    priceRenews.value = price.value;
                }
            }
        }
    });

    // Renewal price checkbox handler
    document.addEventListener('change', function(e) {
        if (e.target.matches('.price_enable_renews')) {
            var row = e.target.closest('tr.price_row');
            var priceRenews = row.querySelector('.price_renews');
            
            if (e.target.checked) {
                if (priceRenews) priceRenews.disabled = false;
            } else {
                var period = row.querySelector('.period');
                if (period && period.value != 'onetime') {
                    var price = row.querySelector('input[name="pricing[price][]"]');
                    if (priceRenews && price) priceRenews.value = price.value;
                }
                if (priceRenews) priceRenews.disabled = true;
            }
        }
    });

    // Initialize unchecked renewal prices
    document.querySelectorAll('.price_enable_renews:not(:checked)').forEach(function(el) {
        var row = el.closest('tr.price_row');
        var priceRenews = row.querySelector('.price_renews');
        var period = row.querySelector('.period');
        
        if (period && period.value != 'onetime') {
            var price = row.querySelector('input[name="pricing[price][]"]');
            if (priceRenews && price) priceRenews.value = price.value;
        } else {
            if (priceRenews) priceRenews.value = '';
        }
        if (priceRenews) priceRenews.disabled = true;
    });

    // Make sure the value of the renewal field matches that of the price field
    function updateRenewalPrice(e) {
        if (e.target.matches('input[name="pricing[price][]"]')) {
            var row = e.target.closest('tr.price_row');
            var enableRenews = row.querySelector('.price_enable_renews');
            var period = row.querySelector('.period');
            
            if (enableRenews && !enableRenews.checked && period && period.value != 'onetime') {
                var priceRenews = row.querySelector('.price_renews');
                if (priceRenews) priceRenews.value = e.target.value;
            }
        }
    }
    document.addEventListener('change', updateRenewalPrice);
    document.addEventListener('keyup', updateRenewalPrice);

    // Module management
    function fetchModuleOptions() {
        var form = document.getElementById('module_id') ? document.getElementById('module_id').closest('form') : null;
        if (!form) return;
        
        var formDataStr = new URLSearchParams(new FormData(form)).toString();
        
        // Set meta values on initial load
        var metaData = form.querySelectorAll('input[name^="meta"]');
        var meta_values = '&<?php echo http_build_query(['meta' => (isset($vars->meta) ? $vars->meta : [])]); ?>';
        if (metaData.length > 0)
            meta_values = '';

        var formData = formDataStr + meta_values;

        fetch('<?php echo $this->Html->safe($this->base_uri . 'packages/moduleoptions/'); ?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(function(response) {
            if (!response.ok) {
                throw new Error('Network response was not ok: ' + response.status);
            }
            return response.json();
        })
        .then(function(data) {
            if (data) {
                var moduleOptions = document.getElementById('module_options');
                if (moduleOptions) {
                    moduleOptions.innerHTML = data.module_options;
                    // Execute scripts from fetched content (innerHTML doesn't execute <script> tags)
                    moduleOptions.querySelectorAll('script').forEach(function(oldScript) {
                        var newScript = document.createElement('script');
                        newScript.textContent = oldScript.textContent;
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                }

                var moduleEmailTags = document.getElementById('module_email_tags');
                if (moduleEmailTags) moduleEmailTags.innerHTML = data.module_email_tags;

                if (typeof data.module_template == 'undefined' || data.module_template.length == 0) {
                    document.querySelectorAll('.load_sample_email').forEach(function(el) { el.style.display = 'none'; });
                } else {
                    document.querySelectorAll('.load_sample_email').forEach(function(el) { el.style.display = 'inline-block'; });
                }

                // Initialize Bootstrap tooltips
                var tooltipTriggerList = document.querySelectorAll('#module_options [data-bs-toggle="tooltip"]');
                tooltipTriggerList.forEach(function(tooltipTriggerEl) {
                    new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }
        })
        .catch(function(error) {
            console.error('Error fetching module options:', error);
            var moduleOptions = document.getElementById('module_options');
            if (moduleOptions) moduleOptions.innerHTML = '<div class="alert alert-danger">Error loading module options: ' + error.message + '</div>';
        });
    }

    // Fetch module email template
    function fetchModuleEmailTemplate() {
        var form = document.getElementById('module_id') ? document.getElementById('module_id').closest('form') : null;
        if (!form) return;
        
        var formDataStr = new URLSearchParams(new FormData(form)).toString();

        // Set meta values on initial load
        var metaData = form.querySelectorAll('input[name^="meta"]');
        var meta_values = '&<?php echo http_build_query(['meta' => (isset($vars->meta) ? $vars->meta : [])]); ?>';
        if (metaData.length > 0)
            meta_values = '';

        var formData = formDataStr + meta_values;

        fetch('<?php echo $this->Html->safe($this->base_uri . 'packages/moduleoptions/'); ?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data && data.module_template) {
                Object.keys(data.module_template).forEach(function(lang_code) {
                    var template = data.module_template[lang_code];
                    
                    var htmlTextarea = document.querySelector('#email-' + lang_code + '-html textarea');
                    if (htmlTextarea) htmlTextarea.value = template.html;
                    
                    var textTextarea = document.querySelector('#email-' + lang_code + '-text textarea');
                    if (textTextarea) textTextarea.value = template.text;

                    var ck_editor = document.querySelector('#email-' + lang_code + '-html .ck-editor__editable');
                    if (ck_editor && ck_editor.ckeditorInstance) {
                        ck_editor.ckeditorInstance.setData(template.html);
                    }
                });
            }
        })
        .catch(function(error) { console.error('Error fetching module email template:', error); });
    }

    // Fetch modules list
    function fetchModules() {
        var moduleIdEl = document.getElementById('module_id');
        var module_id = moduleIdEl ? moduleIdEl.value : '';

        fetch('<?php echo $this->Html->safe($this->base_uri . 'packages/getmodules/'); ?>', {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data && moduleIdEl) {
                // Remove all existing items
                while (moduleIdEl.options.length > 0) {
                    moduleIdEl.remove(0);
                }

                // Sort object by value
                var sortedData = Object.keys(data)
                    .map(function(key) { return { key: key, value: data[key] }; })
                    .sort(function(a, b) { return a.value.localeCompare(b.value); });

                // Append all new items
                sortedData.forEach(function(item) {
                    var option = document.createElement("option");
                    option.text = item.value;
                    option.value = item.key;
                    moduleIdEl.add(option);
                });

                moduleIdEl.value = module_id;
            }
        })
        .catch(function(error) { console.error('Error fetching modules:', error); });
    }

    // Onload fetch module options
    fetchModuleOptions();

    // On change fetch module options
    var moduleIdEl = document.getElementById('module_id');
    if (moduleIdEl) {
        moduleIdEl.addEventListener('change', function() {
            var moduleRow = document.getElementById('module_row');
            if (moduleRow) moduleRow.remove();
            var moduleGroup = document.getElementById('module_group');
            if (moduleGroup) moduleGroup.remove();
            fetchModuleOptions();
        });
    }

    // Update module options when the server or group changes
    document.addEventListener('change', function(e) {
        if (e.target.id === 'module_group' || e.target.id === 'module_row') {
            fetchModuleOptions();
        }
    });

    // Update module list
    var refreshModulesEl = document.getElementById('refresh_modules');
    if (refreshModulesEl) {
        refreshModulesEl.addEventListener('click', function(e) {
            fetchModules();
            e.preventDefault();
        });
    }

    // Set the module email template as the email content
    document.querySelectorAll('.load_sample_email').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            var confirmMsg = '<?php echo addslashes($this->_('AdminPackages.add.text_confirm_load_email', true)); ?>';
            if (document.getElementById('edit_package')) {
                confirmMsg = '<?php echo addslashes($this->_('AdminPackages.edit.text_confirm_load_email', true)); ?>';
            }
            if (confirm(confirmMsg)) {
                document.querySelectorAll('.email_content_html textarea, .email_content_text textarea').forEach(function(textarea) {
                    textarea.value = '';
                });

                fetchModuleEmailTemplate();
            }
            e.preventDefault();
        });
    });

    // Dual-select drag and drop functionality
    (function() {
        let draggedItem = null;

        function setupDualSelect(container) {
            const leftList = container.querySelector('.dual-select-panel:first-child .drag-list');
            const rightList = container.querySelector('.dual-select-panel:last-child .drag-list');
            const moveLeftBtn = container.querySelector('.move-left');
            const moveRightBtn = container.querySelector('.move-right');

            if (!leftList || !rightList) return;

            // Setup drag items
            function setupDragItems() {
                container.querySelectorAll('.drag-item').forEach(item => {
                    // Click to select
                    item.addEventListener('click', function(e) {
                        e.stopPropagation();
                        if (e.ctrlKey || e.metaKey) {
                            this.classList.toggle('selected');
                        } else {
                            container.querySelectorAll('.drag-item').forEach(i => i.classList.remove('selected'));
                            this.classList.add('selected');
                        }
                    });

                    // Double-click to move
                    item.addEventListener('dblclick', function(e) {
                        e.stopPropagation();
                        const currentList = this.closest('.drag-list');
                        const targetList = currentList === leftList ? rightList : leftList;
                        targetList.appendChild(this);
                        this.classList.remove('selected');
                    });

                    // Drag events
                    item.addEventListener('dragstart', function(e) {
                        draggedItem = this;
                        this.classList.add('dragging');
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/plain', this.textContent);
                    });

                    item.addEventListener('dragend', function() {
                        this.classList.remove('dragging');
                        container.querySelectorAll('.drag-list').forEach(l => l.classList.remove('drag-over'));
                    });
                });
            }

            // Setup drop zones
            [leftList, rightList].forEach(list => {
                list.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    this.classList.add('drag-over');
                });

                list.addEventListener('dragleave', function(e) {
                    if (!this.contains(e.relatedTarget)) {
                        this.classList.remove('drag-over');
                    }
                });

                list.addEventListener('drop', function(e) {
                    e.preventDefault();
                    this.classList.remove('drag-over');
                    if (draggedItem && draggedItem.parentNode !== this) {
                        this.appendChild(draggedItem);
                        draggedItem.classList.remove('selected');
                        draggedItem = null;
                    }
                });
            });

            // Arrow button functionality
            moveLeftBtn?.addEventListener('click', function() {
                const selectedItems = rightList.querySelectorAll('.drag-item.selected');
                selectedItems.forEach(item => {
                    leftList.appendChild(item);
                    item.classList.remove('selected');
                });
            });

            moveRightBtn?.addEventListener('click', function() {
                const selectedItems = leftList.querySelectorAll('.drag-item.selected');
                selectedItems.forEach(item => {
                    rightList.appendChild(item);
                    item.classList.remove('selected');
                });
            });

            setupDragItems();
        }

        // Initialize all dual-select containers
        document.querySelectorAll('.dual-select-container').forEach(setupDualSelect);

        // Clear selection when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.drag-item')) {
                document.querySelectorAll('.drag-item.selected').forEach(item => item.classList.remove('selected'));
            }
        });

        // Before form submit, create hidden inputs for selected values
        document.getElementById('add_package')?.addEventListener('submit', function() {
            // Package groups
            const assignedGroups = document.getElementById('assigned_groups');
            if (assignedGroups) {
                assignedGroups.querySelectorAll('input[name="groups[]"]').forEach(i => i.remove());
                assignedGroups.querySelectorAll('.drag-item').forEach(item => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'groups[]';
                    input.value = item.dataset.value;
                    assignedGroups.appendChild(input);
                });
            }

            // Plugins
            const assignedPlugins = document.getElementById('assigned_plugins');
            if (assignedPlugins) {
                assignedPlugins.querySelectorAll('input[name="plugins[]"]').forEach(i => i.remove());
                assignedPlugins.querySelectorAll('.drag-item').forEach(item => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'plugins[]';
                    input.value = item.dataset.value;
                    assignedPlugins.appendChild(input);
                });
            }

            // Option groups
            const optionGroups = document.getElementById('option_groups');
            if (optionGroups) {
                optionGroups.querySelectorAll('input[name="option_groups[]"]').forEach(i => i.remove());
                optionGroups.querySelectorAll('.drag-item').forEach(item => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'option_groups[]';
                    input.value = item.dataset.value;
                    optionGroups.appendChild(input);
                });
            }
        });
    })();

    // Disable other default checkboxes for the same currency
    function updateDefaultCheckboxes() {
        // Set an array with all the currencies with a default pricing selected
        var selected_currencies = [];
        document.querySelectorAll('.price_table .price_row').forEach(function(row) {
            var checkbox = row.querySelector('input[name="pricing[default][]"]');
            if (checkbox && checkbox.checked) {
                var currencySelect = row.querySelector('select[name="pricing[currency][]"]');
                if (currencySelect) {
                    selected_currencies.push(currencySelect.value);
                }
            }
        });

        // Disable all other checkboxes for currencies with one selected already
        document.querySelectorAll('input[name="pricing[default][]"]').forEach(function(checkbox) {
            checkbox.disabled = false;
        });
        document.querySelectorAll('input[type="hidden"][name="pricing[default][]"]').forEach(function(hidden) {
            hidden.remove();
        });

        for (var i = 0; i < selected_currencies.length; ++i) {
            document.querySelectorAll('input[name="pricing[default][]"]').forEach(function(checkbox) {
                var row = checkbox.closest('tr');
                var currencySelect = row ? row.querySelector('select[name="pricing[currency][]"]') : null;
                
                if (currencySelect && currencySelect.value == selected_currencies[i]) {
                    if (!checkbox.checked) {
                        checkbox.disabled = true;
                        var hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'pricing[default][]';
                        hidden.value = '';
                        checkbox.parentNode.appendChild(hidden);
                    }
                }
            });
        }
    }

    updateDefaultCheckboxes();
    document.addEventListener('change', function(e) {
        if (e.target.matches('select[name="pricing[currency][]"]')) {
            updateDefaultCheckboxes();
        }
    });
    document.addEventListener('click', function(e) {
        if (e.target.matches('input[name="pricing[default][]"]')) {
            updateDefaultCheckboxes();
        }
    });

    // Associate pricings with the correct fields
    function updatePricingOrder() {
        // Set proper indices
        var row = 0;
        document.querySelectorAll('table.price_table tr.price_row').forEach(function(tr) {
            tr.querySelectorAll('input').forEach(function(input) {
                input.name = input.name.replace('[]', '[' + row + ']');
            });
            row++;
        });
    }

    // Form submission handler
    var packageForm = document.getElementById('add_package') || document.getElementById('edit_package');
    if (packageForm) {
        packageForm.addEventListener('submit', function() {
            // Associate the order of prices with fields
            updatePricingOrder();

            document.querySelectorAll('#assigned option, #assigned_plugins option').forEach(function(opt) {
                opt.selected = true;
            });

            // Enable fields so that they can be submitted
            document.querySelectorAll('input.term, input.price_renews, input.price_enable_renews').forEach(function(input) {
                input.disabled = false;
            });
            
            document.querySelectorAll('input.price_enable_renews:not(:checked)').forEach(function(input) {
                input.value = '0';
                input.checked = true;
            });
        });
    }

    // CKEditor initialization for wysiwyg textareas
    var editorOptions = {language: '<?php echo substr(Configure::get('Blesta.language'), 0, 2);?>'};

    function initCKEditorOnTextarea(textarea) {
        if (!textarea || textarea.ckeditorInstance) {
            return; // Already initialized
        }

        blestaBindWysiwygEditor(textarea, editorOptions);
    }

    // Initialize CKEditor on all visible wysiwyg textareas
    function initAllWysiwygEditors() {
        document.querySelectorAll('textarea.wysiwyg').forEach(function(textarea) {
            // Only initialize if textarea is visible and not already initialized
            if (!textarea.ckeditorInstance && textarea.offsetParent !== null) {
                initCKEditorOnTextarea(textarea);
            }
        });
    }

    // Initialize on page load
    initAllWysiwygEditors();

    // Re-initialize when collapse is shown
    document.querySelectorAll('.collapse').forEach(function(collapseEl) {
        collapseEl.addEventListener('shown.bs.collapse', function() {
            var textareas = this.querySelectorAll('textarea.wysiwyg');
            textareas.forEach(function(textarea) {
                if (!textarea.ckeditorInstance) {
                    initCKEditorOnTextarea(textarea);
                }
            });
        });
    });

    // Re-initialize when tab is shown
    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(tabEl) {
        tabEl.addEventListener('shown.bs.tab', function(event) {
            var targetId = event.target.getAttribute('data-bs-target');
            if (targetId) {
                var targetPane = document.querySelector(targetId);
                if (targetPane) {
                    var textareas = targetPane.querySelectorAll('textarea.wysiwyg');
                    textareas.forEach(function(textarea) {
                        if (!textarea.ckeditorInstance) {
                            initCKEditorOnTextarea(textarea);
                        }
                    });
                }
            }
        });
    });

    // Before form submit, write decoded CKEditor data back to each
    // email_content[*][html] textarea so the encoded tags don't persist.
    document.getElementById('add_package')?.addEventListener('submit', function() {
        document.querySelectorAll('textarea[name^="email_content["][name$="[html]"]').forEach(function(ta) {
            if (ta.ckeditorInstance && typeof ta.ckeditorInstance.getData === 'function') {
                ta.value = blestaDecodeHrefTemplateTags(ta.ckeditorInstance.getData());
            }
        });
    });

    <?php if ($ai_feature_enabled ?? false): ?>
    // AI Generation functionality
    var aiState = {
        currentTarget: null,
        currentType: null,
        currentAction: null,
        currentLang: null,
        generatedContent: '',
        generatedHtml: '',
        generatedText: '',
        modal: null
    };

    // AI button click handler
    document.querySelectorAll('[data-ai-action]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            aiState.currentTarget = this.dataset.aiTarget;
            aiState.currentType = this.dataset.aiType;
            aiState.currentAction = this.dataset.aiAction;
            aiState.currentLang = this.dataset.aiLang;

            // Show modal
            var modalEl = document.getElementById('aiPackageModal');
            aiState.modal = new bootstrap.Modal(modalEl);

            // Update title
            document.getElementById('aiModalTitle').textContent =
                aiState.currentAction === 'generate'
                    ? '<?php echo addslashes($this->_('AdminPackages.ai.modal_title_generate', true)); ?>'
                    : '<?php echo addslashes($this->_('AdminPackages.ai.modal_title_rewrite', true)); ?>';

            // Build and show the prompt preview
            updatePromptPreview();

            // Show initial state with instructions
            document.getElementById('aiGeneratedContent').innerHTML =
                '<div class="text-center py-4 text-muted"><i class="bi bi-stars d-block mb-2" style="font-size: 2rem;"></i><p class="mb-0"><?php echo addslashes($this->_('AdminPackages.ai.initial_instructions', true)); ?></p></div>';

            // Reset button states
            document.getElementById('aiGenerateBtn').classList.remove('d-none');
            document.getElementById('aiGenerateBtn').disabled = false;
            document.getElementById('aiGenerateBtn').innerHTML = '<i class="bi bi-stars me-1"></i><?php echo addslashes($this->_('AdminPackages.ai.generate_button', true)); ?>';
            document.getElementById('aiUseContentBtn').classList.add('d-none');

            // Show/hide checkboxes for email content
            var isEmailContent = aiState.currentType.startsWith('email-');
            var checkboxes = document.getElementById('aiContentCheckboxes');
            if (isEmailContent) {
                checkboxes.classList.remove('d-none');
                document.getElementById('aiApplyHtml').checked = true;
                document.getElementById('aiApplyHtml').disabled = true;
                document.getElementById('aiApplyText').checked = true;
                document.getElementById('aiApplyText').disabled = true;
            } else {
                checkboxes.classList.add('d-none');
            }

            // Clear additional instructions
            document.getElementById('aiAdditionalPrompt').value = '';

            aiState.modal.show();
        });
    });

    // Gather existing content for rewrite (shared between preview and generate)
    function getExistingContent() {
        var isEmailContent = aiState.currentType.startsWith('email-');

        if (isEmailContent) {
            var targetName = aiState.currentTarget;
            var baseFieldMatch = targetName.match(/^(.+)\[(html|text)\]$/);
            var baseFieldName = baseFieldMatch ? baseFieldMatch[1] : targetName.replace(/\[html\]$/, '').replace(/\[text\]$/, '');

            var parts = [];
            var htmlTextarea = document.querySelector('[name="' + baseFieldName + '[html]"]');
            if (htmlTextarea) {
                var htmlContent = htmlTextarea.ckeditorInstance
                    ? blestaDecodeHrefTemplateTags(htmlTextarea.ckeditorInstance.getData())
                    : htmlTextarea.value;
                if (htmlContent.trim()) {
                    parts.push('Current HTML version:\n' + htmlContent);
                }
            }
            var textTextarea = document.querySelector('[name="' + baseFieldName + '[text]"]');
            if (textTextarea) {
                var toastUiContainer = textTextarea.nextElementSibling;
                var textContent = (toastUiContainer && toastUiContainer._editor)
                    ? toastUiContainer._editor.getMarkdown()
                    : textTextarea.value;
                if (textContent.trim()) {
                    parts.push('Current text version:\n' + textContent);
                }
            }
            return parts.join('\n\n');
        } else {
            var textarea = document.querySelector('[name="' + aiState.currentTarget + '"]');
            if (textarea) {
                return textarea.ckeditorInstance
                    ? textarea.ckeditorInstance.getData()
                    : textarea.value;
            }
            return '';
        }
    }

    // Update prompt preview by fetching from server
    function updatePromptPreview() {
        var nameField = document.querySelector('input[name^="names"][name$="[name]"]');
        var moduleSelect = document.getElementById('module_id');
        var isEmailContent = aiState.currentType.startsWith('email-');
        var existingContent = '';

        if (aiState.currentAction === 'rewrite') {
            existingContent = getExistingContent();
        }

        // Build the base prompt same as generateAiContent does
        var additionalPrompt = document.getElementById('aiAdditionalPrompt').value.trim();
        var basePrompt;

        if (aiState.currentAction === 'rewrite') {
            basePrompt = 'Rewrite and improve this content while maintaining the same general information:\n\n' + existingContent;
        } else if (isEmailContent) {
            basePrompt = 'Generate a professional welcome email for this product/service package that welcomes the customer and provides helpful information about their new service';
        } else {
            basePrompt = 'Generate a professional description for this product/service package';
        }

        if (additionalPrompt) {
            basePrompt += '\n\nAdditional instructions: ' + additionalPrompt;
        }

        // Build form data for preview request
        var formData = new URLSearchParams();
        var csrfToken = document.querySelector('input[name="_csrf_token"]');
        if (csrfToken) {
            formData.append('_csrf_token', csrfToken.value);
        }

        formData.append('prompt', basePrompt);
        formData.append('package_name', nameField ? nameField.value : '');
        formData.append('module_name', moduleSelect ? moduleSelect.options[moduleSelect.selectedIndex].text : '');
        formData.append('language', aiState.currentLang);
        if (isEmailContent) {
            formData.append('generate_html', 'true');
            formData.append('generate_text', 'true');
        } else {
            formData.append('generate_html', aiState.currentType.includes('html') ? 'true' : 'false');
            formData.append('generate_text', !aiState.currentType.includes('html') ? 'true' : 'false');
        }
        formData.append('tone', 'professional');
        formData.append('content_type', isEmailContent ? 'email' : 'description');

        // Add email tags if applicable
        if (isEmailContent) {
            var tagsAlert = document.querySelector('#tab-email .alert-info .d-flex.flex-wrap');
            if (tagsAlert) {
                formData.append('email_tags', tagsAlert.textContent.trim());
            }
        }

        // Show loading state
        document.getElementById('aiFullPrompt').innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span><?php echo addslashes($this->_('AdminPackages.ai.prompt_loading', true)); ?></span>';

        // Fetch prompt preview from server
        fetch('<?php echo $this->Html->safe($this->base_uri . "packages/previewPrompt/"); ?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success && data.full_prompt) {
                document.getElementById('aiFullPrompt').textContent = data.full_prompt;
            } else {
                document.getElementById('aiFullPrompt').textContent = data.error || 'Failed to load prompt preview';
            }
        })
        .catch(function(error) {
            document.getElementById('aiFullPrompt').textContent = 'Error loading prompt: ' + error.message;
        });
    }

    // Debounce function for input handling
    var promptPreviewTimeout = null;
    function debouncedUpdatePromptPreview() {
        if (promptPreviewTimeout) {
            clearTimeout(promptPreviewTimeout);
        }
        promptPreviewTimeout = setTimeout(updatePromptPreview, 500);
    }

    // Listen for changes to additional instructions to update preview
    document.getElementById('aiAdditionalPrompt').addEventListener('input', debouncedUpdatePromptPreview);

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function generateAiContent() {
        var nameField = document.querySelector('input[name^="names"][name$="[name]"]');
        var moduleSelect = document.getElementById('module_id');
        var existingContent = '';

        // Determine if this is email content
        var isEmailContent = aiState.currentType.startsWith('email-');

        // Get existing content for rewrite
        if (aiState.currentAction === 'rewrite') {
            existingContent = getExistingContent();
        }

        var formData = new URLSearchParams();
        // Include CSRF token
        var csrfToken = document.querySelector('input[name="_csrf_token"]');
        if (csrfToken) {
            formData.append('_csrf_token', csrfToken.value);
        }

        // Build the prompt with optional additional instructions
        var additionalPrompt = document.getElementById('aiAdditionalPrompt').value.trim();
        var basePrompt;

        if (aiState.currentAction === 'rewrite') {
            basePrompt = 'Rewrite and improve this content while maintaining the same general information:\n\n' + existingContent;
        } else if (isEmailContent) {
            basePrompt = 'Generate a professional welcome email for this product/service package that welcomes the customer and provides helpful information about their new service';
        } else {
            basePrompt = 'Generate a professional description for this product/service package';
        }

        if (additionalPrompt) {
            basePrompt += '\n\nAdditional instructions: ' + additionalPrompt;
        }

        formData.append('prompt', basePrompt);
        formData.append('package_name', nameField ? nameField.value : '');
        formData.append('module_name', moduleSelect ? moduleSelect.options[moduleSelect.selectedIndex].text : '');
        formData.append('language', aiState.currentLang);

        // For email content, always generate both HTML and text; for descriptions, use the type
        if (isEmailContent) {
            formData.append('generate_html', 'true');
            formData.append('generate_text', 'true');
        } else {
            formData.append('generate_html', aiState.currentType.includes('html') ? 'true' : 'false');
            formData.append('generate_text', !aiState.currentType.includes('html') ? 'true' : 'false');
        }
        formData.append('tone', 'professional');

        // Add email tags if generating email content
        if (isEmailContent) {
            var emailTagsContainer = document.getElementById('module_email_tags');
            var emailTags = emailTagsContainer ? emailTagsContainer.textContent.trim() : '';
            // Also get any tags from the info alert
            var tagsAlert = document.querySelector('#tab-email .alert-info .d-flex.flex-wrap');
            if (tagsAlert) {
                emailTags = tagsAlert.textContent.trim();
            }
            formData.append('email_tags', emailTags);
        }

        // Use appropriate endpoint based on content type
        var endpoint = isEmailContent
            ? '<?php echo $this->Html->safe($this->base_uri . "packages/generateEmail/"); ?>'
            : '<?php echo $this->Html->safe($this->base_uri . "packages/generateDescription/"); ?>';

        fetch(endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            // Update the full prompt in the collapsible section
            if (data.full_prompt) {
                document.getElementById('aiFullPrompt').textContent = data.full_prompt;
            }

            // Reset generate button
            var generateBtn = document.getElementById('aiGenerateBtn');
            generateBtn.disabled = false;
            generateBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i><?php echo addslashes($this->_('AdminPackages.ai.regenerate_button', true)); ?>';

            if (data.success) {
                // Store both HTML and text content
                aiState.generatedHtml = data.html || '';
                aiState.generatedText = data.text || '';
                aiState.generatedContent = aiState.generatedHtml || aiState.generatedText;

                // Build preview showing both versions
                var previewHtml = '';
                if (data.feedback) {
                    previewHtml += '<div class="alert alert-info mb-3"><i class="bi bi-info-circle me-2"></i>' + escapeHtml(data.feedback) + '</div>';
                }
                if (aiState.generatedHtml) {
                    previewHtml += '<div class="mb-3"><strong class="d-block mb-2"><?php echo addslashes($this->_('AdminPackages.ai.preview_html', true)); ?></strong><div class="border rounded p-3 bg-body-secondary">' + aiState.generatedHtml + '</div></div>';
                }
                if (aiState.generatedText) {
                    previewHtml += '<div><strong class="d-block mb-2"><?php echo addslashes($this->_('AdminPackages.ai.preview_text', true)); ?></strong><pre class="border rounded p-3 bg-body-secondary mb-0" style="white-space: pre-wrap; font-family: inherit;">' + escapeHtml(aiState.generatedText) + '</pre></div>';
                }
                document.getElementById('aiGeneratedContent').innerHTML = previewHtml || '<div class="text-muted">No content generated</div>';

                // Enable apply checkboxes for email content
                if (isEmailContent) {
                    document.getElementById('aiApplyHtml').disabled = !aiState.generatedHtml;
                    document.getElementById('aiApplyText').disabled = !aiState.generatedText;
                }

                // Show the Use Content button
                document.getElementById('aiUseContentBtn').classList.remove('d-none');
            } else {
                document.getElementById('aiGeneratedContent').innerHTML =
                    '<div class="alert alert-danger mb-0">' + escapeHtml(data.error || '<?php echo addslashes($this->_('AdminPackages.ai.error_generation_failed', true)); ?>') + '</div>';
            }
        })
        .catch(function(error) {
            // Reset generate button on error
            var generateBtn = document.getElementById('aiGenerateBtn');
            generateBtn.disabled = false;
            generateBtn.innerHTML = '<i class="bi bi-stars me-1"></i><?php echo addslashes($this->_('AdminPackages.ai.generate_button', true)); ?>';

            document.getElementById('aiGeneratedContent').innerHTML =
                '<div class="alert alert-danger mb-0"><?php echo addslashes($this->_('AdminPackages.ai.error_prefix', true)); ?> ' + escapeHtml(error.message) + '</div>';
        });
    }

    // Use content button — applies selectively based on checkboxes for email content
    var useContentBtn = document.getElementById('aiUseContentBtn');
    if (useContentBtn) {
        useContentBtn.addEventListener('click', function() {
            if (!aiState.generatedContent) return;

            // Determine the base field name (e.g., "descriptions[0]" from "descriptions[0][html]")
            var targetName = aiState.currentTarget;
            var baseFieldMatch = targetName.match(/^(.+)\[(html|text)\]$/);
            var baseFieldName = baseFieldMatch ? baseFieldMatch[1] : targetName.replace(/\[html\]$/, '').replace(/\[text\]$/, '');

            var isEmailContent = aiState.currentType.startsWith('email-');

            // Check if we should apply HTML (always for descriptions, checkbox for emails)
            var applyHtml = !isEmailContent || document.getElementById('aiApplyHtml').checked;
            var applyText = !isEmailContent || document.getElementById('aiApplyText').checked;

            // Set HTML content
            if (applyHtml && aiState.generatedHtml) {
                var htmlTextarea = document.querySelector('[name="' + baseFieldName + '[html]"]');
                if (htmlTextarea) {
                    var htmlContent = isEmailContent ? blestaDecodeHrefTemplateTags(aiState.generatedHtml) : aiState.generatedHtml;
                    if (htmlTextarea.ckeditorInstance) {
                        htmlTextarea.ckeditorInstance.setData(htmlContent);
                    } else {
                        htmlTextarea.value = htmlContent;
                    }
                    htmlTextarea.dispatchEvent(new Event('input'));
                }
            }

            // Set text/markdown content
            if (applyText && aiState.generatedText) {
                var textTextarea = document.querySelector('[name="' + baseFieldName + '[text]"]');
                if (textTextarea) {
                    var toastUiContainer = textTextarea.nextElementSibling;
                    if (toastUiContainer && toastUiContainer._editor) {
                        toastUiContainer._editor.setMarkdown(aiState.generatedText);
                    } else {
                        textTextarea.value = aiState.generatedText;
                    }
                    textTextarea.dispatchEvent(new Event('input'));
                }
            }

            aiState.modal.hide();
        });
    }

    // Generate button
    var generateBtn = document.getElementById('aiGenerateBtn');
    if (generateBtn) {
        generateBtn.addEventListener('click', function() {
            // Disable button and show generating state
            generateBtn.disabled = true;
            generateBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span><?php echo addslashes($this->_('AdminPackages.ai.generating', true)); ?>';

            document.getElementById('aiGeneratedContent').innerHTML =
                '<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted"><?php echo addslashes($this->_('AdminPackages.ai.generating', true)); ?></p></div>';

            generateAiContent();
        });
    }

    // Watch textareas for rewrite button enable/disable
    function updateRewriteButtons() {
        document.querySelectorAll('[data-ai-action="rewrite"]').forEach(function(btn) {
            var isEmailBtn = (btn.dataset.aiType || '').startsWith('email-');
            var targetName = btn.dataset.aiTarget;

            if (isEmailBtn) {
                // For email buttons, enable when either HTML or text has content
                var baseFieldMatch = targetName.match(/^(.+)\[(html|text)\]$/);
                var baseFieldName = baseFieldMatch ? baseFieldMatch[1] : targetName.replace(/\[html\]$/, '').replace(/\[text\]$/, '');

                var hasContent = false;
                var htmlTextarea = document.querySelector('[name="' + baseFieldName + '[html]"]');
                if (htmlTextarea) {
                    var htmlContent = htmlTextarea.ckeditorInstance
                        ? htmlTextarea.ckeditorInstance.getData()
                        : htmlTextarea.value;
                    if (htmlContent.trim()) hasContent = true;
                }
                if (!hasContent) {
                    var textTextarea = document.querySelector('[name="' + baseFieldName + '[text]"]');
                    if (textTextarea && textTextarea.value.trim()) hasContent = true;
                }
                btn.disabled = !hasContent;
            } else {
                // For description buttons, check the single target
                var textarea = document.querySelector('[name="' + targetName + '"]');
                if (textarea) {
                    var content = textarea.ckeditorInstance
                        ? textarea.ckeditorInstance.getData()
                        : textarea.value;
                    btn.disabled = !content.trim();
                }
            }
        });
    }

    // Check rewrite buttons periodically
    setInterval(updateRewriteButtons, 1000);
    <?php endif; ?>
});
</script>
