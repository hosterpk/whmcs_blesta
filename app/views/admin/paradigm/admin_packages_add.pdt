                                <td>
                                    <?php
                                    $this->Form->fieldText('pricing[term][]', (isset($vars->pricing['term'][$i]) ? $vars->pricing['term'][$i] : null), array_merge(['class' => 'form-control form-control-sm term'], $disabled));
                                    ?>
                                </td>
                                <td>
                                    <?php $this->Form->fieldSelect('pricing[period][]', (isset($periods) ? $periods : null), (isset($vars->pricing['period'][$i]) ? $vars->pricing['period'][$i] : 'month'), ['class' => 'form-select form-select-sm period']);?>
                                </td>
                                <td>
                                    <?php (!empty($currencies) ? $this->Form->fieldSelect('pricing[currency][]', (isset($currencies) ? $currencies : null), (isset($vars->pricing['currency'][$i]) ? $vars->pricing['currency'][$i] : null), ['class' => 'form-select form-select-sm']) : (print (isset($default_currency) ? $this->Html->safe($default_currency) : null)));?>
                                </td>
                                <td>
                                    <?php $this->Form->fieldText('pricing[price][]', $this->CurrencyFormat->format((isset($vars->pricing['price'][$i]) ? $vars->pricing['price'][$i] : null), (isset($vars->pricing['currency'][$i]) ? $vars->pricing['currency'][$i] : null), ['prefix' => false,'suffix' => false,'with_separator' => false,'code' => false,'decimals' => 4]), ['class' => 'form-control form-control-sm']);?>
                                </td>
                                <td>
