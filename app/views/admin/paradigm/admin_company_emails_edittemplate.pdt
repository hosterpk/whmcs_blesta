<script>
    // Store CKEditor instances by element ID for multi-editor support
    // Email template data from database
    var emailTemplateTags = <?php echo json_encode($template->tags ?? []); ?>;
    var emailGroupId = <?php echo (int)($template->email_group_id ?? 0); ?>;

    // Cache for prompt preview (persists for page lifetime)
    var cachedPromptPreview = null;

    // Helper to get editor by element ID or textarea element
    function getEditor(elementOrId) {
        var element = elementOrId;

        if (typeof elementOrId === 'string') {
            element = document.getElementById(elementOrId);
        }

        return element && element.ckeditorInstance ? element.ckeditorInstance : null;
    }

    // Initialize the editor using Blesta's binder, which attaches the instance to the textarea.
    blestaBindWysiwygEditor('#ckeditor', {
        language: '<?php echo substr(Configure::get('Blesta.language'), 0, 2);?>'
    });

    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize all tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

        // Sync CKEditor content to textarea before form submission
        const form = document.getElementById('admin_company_emails_edittemplate');
        if (form) {
            form.addEventListener('submit', function(e) {
                const editor = getEditor('ckeditor');
                if (editor && typeof editor.getData === 'function') {
                    const textarea = document.getElementById('ckeditor');
                    if (textarea) {
                        textarea.value = blestaDecodeHrefTemplateTags(editor.getData());
                    }
                }
            });
        }

        // Native drag-and-drop for the file upload zone (Paradigm has no jQuery/Dropzone.js)
        var dropZone = document.getElementById('fileDropZone');
        var fileInput = document.getElementById('emailFileInput');
        var fileListEl = document.getElementById('fileList');

        if (dropZone && fileInput) {
            ['dragenter', 'dragover'].forEach(function(evt) {
                dropZone.addEventListener(evt, function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.add('drag-over');
                });
            });

            ['dragleave', 'drop'].forEach(function(evt) {
                dropZone.addEventListener(evt, function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.remove('drag-over');
                });
            });

            dropZone.addEventListener('drop', function(e) {
                fileInput.files = e.dataTransfer.files;
                updateFileList();
            });

            fileInput.addEventListener('change', function() {
                updateFileList();
            });

            function updateFileList() {
                fileListEl.innerHTML = '';
                if (!fileInput.files.length) return;

                Array.from(fileInput.files).forEach(function(file) {
                    var item = document.createElement('div');
                    item.className = 'd-flex align-items-center gap-2 mb-1 small text-muted';

                    var icon = document.createElement('i');
                    icon.className = 'bi bi-paperclip';
                    item.appendChild(icon);

                    var nameSpan = document.createElement('span');
                    nameSpan.textContent = file.name;
                    item.appendChild(nameSpan);

                    var sizeSpan = document.createElement('span');
                    sizeSpan.className = 'text-muted';
                    sizeSpan.textContent = '(' + (file.size / 1024).toFixed(1) + ' KB)';
                    item.appendChild(sizeSpan);

                    fileListEl.appendChild(item);
                });
            }
        }

        // Handle attachment deletion with confirmation modal
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteAttachmentModal'));
        let deleteUrl = '';
        let deleteId = '';
        let deleteRow = null;

        document.querySelectorAll('#attachments a.manage').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                deleteUrl = this.getAttribute('href');
                deleteId = this.getAttribute('data-id');
                deleteRow = this.closest('tr');
                deleteModal.show();
            });
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            const csrfToken = document.querySelector('#admin_company_emails_edittemplate input[name=_csrf_token]').value;

            var formData = new URLSearchParams();
            formData.append('_csrf_token', csrfToken);
            formData.append('id', deleteId);

            fetch(deleteUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData.toString()
            })
            .then(response => response.json())
            .then(data => {
                if (deleteRow) {
                    deleteRow.remove();

                    if (document.querySelectorAll('#attachments tbody tr').length < 1) {
                        document.getElementById('attachments').closest('.table-responsive').style.display = 'none';
                    }
                }
                deleteModal.hide();
            })
            .catch(error => {
                console.error('Error deleting attachment:', error);
                deleteModal.hide();
            });
        });

        // Handle snapshot restore
        const restoreSnapshotModal = new bootstrap.Modal(document.getElementById('restoreSnapshotModal'));
        let restoreSnapshotId = '';
        let restoreEmailId = '';

        document.querySelectorAll('.restoreSnapshot').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                restoreEmailId = this.getAttribute('data-email-id');
                restoreSnapshotId = this.getAttribute('data-snapshot-id');
                restoreSnapshotModal.show();
            });
        });

        document.getElementById('confirmRestoreSnapshotBtn').addEventListener('click', function() {
            const form = document.getElementById('restoreSnapshotForm');
            const csrfToken = document.querySelector('#admin_company_emails_edittemplate input[name=_csrf_token]').value;

            form.querySelector('#restoreEmailId').value = restoreEmailId;
            form.querySelector('#restoreSnapshotId').value = restoreSnapshotId;
            form.querySelector('input[name=_csrf_token]').value = csrfToken;

            form.submit();
        });
    });

    <?php if ($ai_feature_enabled ?? false): ?>
    // AI Generation functionality
    var aiState = {
        currentTarget: null,      // Name of the field being edited (html or text)
        currentType: null,        // Type of content (email-html, email-text)
        currentAction: null,      // 'generate' or 'rewrite'
        currentLang: null,        // Language code
        generatedContent: '',     // Combined content
        generatedHtml: '',        // Generated HTML content
        generatedText: '',        // Generated text content
        modal: null               // Bootstrap modal instance
    };

    // AI button click handler
    document.querySelectorAll('[data-ai-action]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();

            // Store context from data attributes
            aiState.currentTarget = this.dataset.aiTarget;
            aiState.currentType = this.dataset.aiType;
            aiState.currentAction = this.dataset.aiAction;
            aiState.currentLang = this.dataset.aiLang;

            // Show modal
            var modalEl = document.getElementById('aiEmailModal');
            aiState.modal = new bootstrap.Modal(modalEl);

            // Update title based on action
            document.getElementById('aiModalTitle').textContent =
                aiState.currentAction === 'generate'
                    ? '<?php echo addslashes($this->_('AdminCompanyEmails.ai.modal_title_generate', true)); ?>'
                    : '<?php echo addslashes($this->_('AdminCompanyEmails.ai.modal_title_rewrite', true)); ?>';

            // Build and show the prompt preview
            updatePromptPreview();

            // Show initial state with instructions
            document.getElementById('aiGeneratedContent').innerHTML =
                '<div class="text-center py-4 text-muted"><i class="bi bi-stars d-block mb-2" style="font-size: 2rem;"></i><p class="mb-0"><?php echo addslashes($this->_('AdminCompanyEmails.ai.initial_instructions', true)); ?></p></div>';

            // Reset button states
            document.getElementById('aiGenerateBtn').classList.remove('d-none');
            document.getElementById('aiGenerateBtn').disabled = false;
            document.getElementById('aiGenerateBtn').innerHTML = '<i class="bi bi-stars me-1"></i><?php echo addslashes($this->_('AdminCompanyEmails.ai.generate_button', true)); ?>';
            document.getElementById('aiUseContentBtn').classList.add('d-none');

            // Reset checkboxes (checked but disabled until content is generated)
            document.getElementById('aiApplySubject').checked = true;
            document.getElementById('aiApplySubject').disabled = true;
            document.getElementById('aiApplySubjectRow').classList.add('d-none');
            document.getElementById('aiApplyHtml').checked = true;
            document.getElementById('aiApplyHtml').disabled = true;
            document.getElementById('aiApplyText').checked = true;
            document.getElementById('aiApplyText').disabled = true;

            // Clear additional instructions
            document.getElementById('aiAdditionalPrompt').value = '';

            aiState.modal.show();
        });
    });

    // Update prompt preview by fetching from server
    function updatePromptPreview() {
        // If we have a cached preview, use it (only loads once per page)
        if (cachedPromptPreview) {
            document.getElementById('aiFullPrompt').textContent = cachedPromptPreview;
            return;
        }

        var existingContent = '';

        // Get existing content for rewrite (gather both HTML and text)
        if (aiState.currentAction === 'rewrite') {
            var parts = [];

            // Get current subject
            var subjectField = document.getElementById('subject');
            if (subjectField && subjectField.value.trim()) {
                parts.push('Current subject: ' + subjectField.value.trim());
            }

            // Get HTML content
            var editor = getEditor('ckeditor');
            var htmlContent = '';
            if (editor && typeof editor.getData === 'function') {
                htmlContent = blestaDecodeHrefTemplateTags(editor.getData());
            } else {
                var htmlTextarea = document.querySelector('#ckeditor');
                htmlContent = htmlTextarea ? htmlTextarea.value : '';
            }
            if (htmlContent.trim()) {
                parts.push('Current HTML version:\n' + htmlContent);
            }

            // Get text content
            var textTextarea = document.querySelector('#text');
            var textContent = textTextarea ? textTextarea.value : '';
            if (textContent.trim()) {
                parts.push('Current text version:\n' + textContent);
            }

            existingContent = parts.join('\n\n');
        }

        // Build the base prompt
        var additionalPrompt = document.getElementById('aiAdditionalPrompt').value.trim();
        var basePrompt;

        if (aiState.currentAction === 'rewrite') {
            basePrompt = 'Rewrite and improve this email content while maintaining the same general information:\n\n' + existingContent;
        } else {
            basePrompt = 'Generate professional email content for this email template type.';
        }

        if (additionalPrompt) {
            basePrompt += '\n\nAdditional instructions: ' + additionalPrompt;
        }

        // Get email type from the page title/header
        var emailType = '<?php echo addslashes($template_name ?? ''); ?>';

        // Build form data for preview request
        var formData = new URLSearchParams();
        var csrfToken = document.querySelector('input[name="_csrf_token"]');
        if (csrfToken) {
            formData.append('_csrf_token', csrfToken.value);
        }

        formData.append('prompt', basePrompt);
        formData.append('email_type', emailType);
        formData.append('email_group_id', emailGroupId);
        formData.append('language', aiState.currentLang);
        formData.append('generate_html', aiState.currentType === 'email-html' ? 'true' : 'false');
        formData.append('generate_text', aiState.currentType === 'email-text' ? 'true' : 'false');
        formData.append('tone', 'professional');

        // Show loading state
        document.getElementById('aiFullPrompt').innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span><?php echo addslashes($this->_('AdminCompanyEmails.ai.prompt_loading', true)); ?></span>';

        // Fetch prompt preview from server
        fetch('<?php echo $this->Html->safe($this->base_uri . "settings/company/emails/previewEmailPrompt/"); ?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success && data.full_prompt) {
                // Cache the preview for the page lifetime
                cachedPromptPreview = data.full_prompt;
                document.getElementById('aiFullPrompt').textContent = data.full_prompt;
            } else {
                document.getElementById('aiFullPrompt').textContent = data.error || 'Failed to load prompt preview';
            }
        })
        .catch(function(error) {
            document.getElementById('aiFullPrompt').textContent = 'Error loading prompt: ' + error.message;
        });
    }

    // Note: Preview is cached and only loaded once per page load.
    // Additional instructions don't affect the context preview, so no need to reload it.

    // Generate AI content
    function generateAiContent() {
        var existingContent = '';

        // Get existing content for rewrite (gather both HTML and text with labeled sections)
        if (aiState.currentAction === 'rewrite') {
            var parts = [];

            // Get current subject
            var subjectField = document.getElementById('subject');
            if (subjectField && subjectField.value.trim()) {
                parts.push('Current subject: ' + subjectField.value.trim());
            }

            // Get HTML content
            var editor = getEditor('ckeditor');
            var htmlContent = '';
            if (editor && typeof editor.getData === 'function') {
                htmlContent = blestaDecodeHrefTemplateTags(editor.getData());
            } else {
                var htmlTextarea = document.querySelector('#ckeditor');
                htmlContent = htmlTextarea ? htmlTextarea.value : '';
            }
            if (htmlContent.trim()) {
                parts.push('Current HTML version:\n' + htmlContent);
            }

            // Get text content
            var textTextarea = document.querySelector('#text');
            var textContent = textTextarea ? textTextarea.value : '';
            if (textContent.trim()) {
                parts.push('Current text version:\n' + textContent);
            }

            existingContent = parts.join('\n\n');
        }

        var formData = new URLSearchParams();
        // Include CSRF token
        var csrfToken = document.querySelector('input[name="_csrf_token"]');
        if (csrfToken) {
            formData.append('_csrf_token', csrfToken.value);
        }

        // Build the prompt with optional additional instructions
        var additionalPrompt = document.getElementById('aiAdditionalPrompt').value.trim();
        var basePrompt;

        if (aiState.currentAction === 'rewrite') {
            basePrompt = 'Rewrite and improve this email content while maintaining the same general information:\n\n' + existingContent;
        } else {
            basePrompt = 'Generate professional email content for this email template type.';
        }

        if (additionalPrompt) {
            basePrompt += '\n\nAdditional instructions: ' + additionalPrompt;
        }

        // Get email type from database
        var emailType = '<?php echo addslashes($template_name ?? ''); ?>';

        formData.append('prompt', basePrompt);
        formData.append('email_type', emailType);
        formData.append('email_group_id', emailGroupId);
        formData.append('language', aiState.currentLang);
        formData.append('generate_html', 'true');
        formData.append('generate_text', 'true');
        formData.append('tone', 'professional');

        fetch('<?php echo $this->Html->safe($this->base_uri . "settings/company/emails/generateEmailContent/"); ?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            // Reset generate button
            var generateBtn = document.getElementById('aiGenerateBtn');
            generateBtn.disabled = false;
            generateBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i><?php echo addslashes($this->_('AdminCompanyEmails.ai.regenerate_button', true)); ?>';

            if (data.success) {
                // Store content
                aiState.generatedHtml = data.html || '';
                aiState.generatedText = data.text || '';
                aiState.generatedSubject = data.subject || '';
                aiState.generatedContent = aiState.generatedHtml || aiState.generatedText;

                // Build preview
                var previewHtml = '';

                // Subject preview
                if (aiState.generatedSubject) {
                    previewHtml += '<div class="mb-3"><strong class="d-block mb-2"><?php echo addslashes($this->_('AdminCompanyEmails.ai.preview_subject', true)); ?></strong><div class="border rounded p-2 bg-body-secondary">' + escapeHtml(aiState.generatedSubject) + '</div></div>';
                }

                // HTML preview
                if (aiState.generatedHtml) {
                    var sanitizedHtml = aiState.generatedHtml;
                    if (typeof DOMPurify !== 'undefined') {
                        sanitizedHtml = DOMPurify.sanitize(aiState.generatedHtml, {
                            ALLOWED_TAGS: ['p', 'br', 'b', 'strong', 'i', 'em', 'u', 'a', 'ul', 'ol', 'li', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'div', 'span', 'table', 'tr', 'td', 'th', 'tbody', 'thead'],
                            ALLOWED_ATTR: ['href', 'style', 'class']
                        });
                    }
                    previewHtml += '<div class="mb-3"><strong class="d-block mb-2"><?php echo addslashes($this->_('AdminCompanyEmails.ai.preview_html', true)); ?></strong><div class="border rounded p-3 bg-body-secondary ai-email-preview">' + sanitizedHtml + '</div></div>';
                }

                // Text preview
                if (aiState.generatedText) {
                    previewHtml += '<div><strong class="d-block mb-2"><?php echo addslashes($this->_('AdminCompanyEmails.ai.preview_text', true)); ?></strong><pre class="border rounded p-3 bg-body-secondary mb-0" style="white-space: pre-wrap; font-family: inherit;">' + escapeHtml(aiState.generatedText) + '</pre></div>';
                }

                // Feedback from AI
                if (data.feedback) {
                    previewHtml += '<div class="mt-3"><div class="alert alert-info mb-0 small"><i class="bi bi-info-circle me-1"></i>' + escapeHtml(data.feedback) + '</div></div>';
                }

                document.getElementById('aiGeneratedContent').innerHTML = previewHtml || '<div class="text-muted">No content generated</div>';

                // Enable apply checkboxes
                if (aiState.generatedSubject) {
                    document.getElementById('aiApplySubjectRow').classList.remove('d-none');
                    document.getElementById('aiApplySubject').disabled = false;
                }
                document.getElementById('aiApplyHtml').disabled = !aiState.generatedHtml;
                document.getElementById('aiApplyText').disabled = !aiState.generatedText;

                // Show the Use Content button
                document.getElementById('aiUseContentBtn').classList.remove('d-none');
            } else {
                document.getElementById('aiGeneratedContent').innerHTML =
                    '<div class="alert alert-danger mb-0">' + escapeHtml(data.error || '<?php echo addslashes($this->_('AdminCompanyEmails.ai.error_generation_failed', true)); ?>') + '</div>';
            }
        })
        .catch(function(error) {
            // Reset generate button on error
            var generateBtn = document.getElementById('aiGenerateBtn');
            generateBtn.disabled = false;
            generateBtn.innerHTML = '<i class="bi bi-stars me-1"></i><?php echo addslashes($this->_('AdminCompanyEmails.ai.generate_button', true)); ?>';

            document.getElementById('aiGeneratedContent').innerHTML =
                '<div class="alert alert-danger mb-0"><?php echo addslashes($this->_('AdminCompanyEmails.ai.error_prefix', true)); ?> ' + escapeHtml(error.message) + '</div>';
        });
    }

    // Utility function for HTML escaping
    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Use content button — applies selectively based on checkboxes
    var useContentBtn = document.getElementById('aiUseContentBtn');
    if (useContentBtn) {
        useContentBtn.addEventListener('click', function() {
            if (!aiState.generatedContent) {
                return;
            }

            // Apply HTML if checkbox is checked
            if (document.getElementById('aiApplyHtml').checked && aiState.generatedHtml) {
                var editor = getEditor('ckeditor');

                if (editor && typeof editor.setData === 'function') {
                    editor.setData(aiState.generatedHtml);
                } else {
                    var htmlTextarea = document.querySelector('#ckeditor');
                    if (htmlTextarea) {
                        htmlTextarea.value = aiState.generatedHtml;
                        htmlTextarea.dispatchEvent(new Event('input'));
                    }
                }
            }

            // Apply text if checkbox is checked
            if (document.getElementById('aiApplyText').checked && aiState.generatedText) {
                var textTextarea = document.querySelector('#text');
                if (textTextarea) {
                    textTextarea.value = aiState.generatedText;
                    textTextarea.dispatchEvent(new Event('input'));
                }
            }

            // Apply subject if checkbox is checked
            if (document.getElementById('aiApplySubject').checked && aiState.generatedSubject) {
                var subjectField = document.getElementById('subject');
                if (subjectField) {
                    subjectField.value = aiState.generatedSubject;
                }
            }

            // Update rewrite button state
            updateRewriteButtons();

            aiState.modal.hide();
        });
    }

    // Generate button
    var generateBtn = document.getElementById('aiGenerateBtn');
    if (generateBtn) {
        generateBtn.addEventListener('click', function() {
            // Disable button and show generating state
            generateBtn.disabled = true;
            generateBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span><?php echo addslashes($this->_('AdminCompanyEmails.ai.generating', true)); ?>';

            document.getElementById('aiGeneratedContent').innerHTML =
                '<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted"><?php echo addslashes($this->_('AdminCompanyEmails.ai.generating', true)); ?></p></div>';

            generateAiContent();
        });
    }

    // Watch textareas for rewrite button enable/disable
    // Enable rewrite when either HTML or text editor has content
    function updateRewriteButtons() {
        var htmlContent = '';
        var editor = getEditor('ckeditor');
        if (editor && typeof editor.getData === 'function') {
            htmlContent = editor.getData();
        } else {
            var htmlTextarea = document.querySelector('#ckeditor');
            htmlContent = htmlTextarea ? htmlTextarea.value : '';
        }

        var textTextarea = document.querySelector('#text');
        var textContent = textTextarea ? textTextarea.value : '';

        var hasContent = htmlContent.trim() || textContent.trim();

        document.querySelectorAll('[data-ai-action="rewrite"]').forEach(function(btn) {
            btn.disabled = !hasContent;
        });
    }

    // Check rewrite buttons periodically and on editor changes
    setInterval(updateRewriteButtons, 1000);

    // Also check on text textarea input
    var textTextarea = document.querySelector('#text');
    if (textTextarea) {
        textTextarea.addEventListener('input', updateRewriteButtons);
    }

    // Initial check
    setTimeout(updateRewriteButtons, 1500);
    <?php endif; ?>
</script>
