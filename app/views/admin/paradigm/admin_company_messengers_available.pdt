<?php /** @var View $this **/ ?>


<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>
<?php
}
?>
    <?php
    $tabs = [];
    foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
        $tabs[] = [
            'name' => $tab['name'],
            'current' => ($tab['uri'] == 'available'),
            'attributes' => [
                'href' => $this->Html->safe($this->base_uri . 'settings/company/messengers/' . $tab['uri'] . '/')
            ]
        ];
    }
    $this->Widget->clear();
    $this->Widget->setTabs($tabs);
    $this->Widget->setFilterHtml((isset($filters) ? $filters->getHtml() : ''));
    $this->Widget->create($this->_('AdminCompanyMessengers.available.boxtitle_messenger', true), ['id' => 'admin_company_messengers_available']);?>

            <?php
            $available_messengers = [];
            foreach ((isset($messengers) ? $messengers : []) as $messenger) {
                if (!($messenger->installed ?? false)) {
                    $available_messengers[] = $messenger;
                }
            }

            $num_messengers = count($available_messengers);
            if ($num_messengers > 0) {
                for ($i = 0; $i < $num_messengers; $i++) {
                    $messenger = $available_messengers[$i];
                    $is_last = ($i == $num_messengers - 1);
            ?>
            <!-- Messenger Item -->
            <div class="d-flex align-items-start gap-3 pb-3<?php echo !$is_last ? ' mb-3' : '';?>"<?php echo !$is_last ? ' style="border-bottom: 1px solid var(--border-color);"' : '';?> data-extension-item>
                <div style="width: 200px; flex-shrink: 0;">
                    <?php if (!empty($messenger->icon)) { ?>
                    <div class="extension-logo extension-logo-dual">
                        <div class="extension-logo-blesta">
                            <img src="<?php echo $this->view_dir;?>images/logo.svg" class="logo-dark" alt="Blesta">
                            <img src="<?php echo $this->view_dir;?>images/logo-color.svg" class="logo-light" alt="Blesta">
                        </div>
                        <div class="extension-logo-icon">
                            <i class="bi <?php echo $this->Html->safe($messenger->icon);?>"></i>
                        </div>
                    </div>
                    <?php } else { ?>
                    <div class="extension-logo extension-logo-single">
                        <?php if (!empty($messenger->logo)) { ?>
                        <img src="<?php echo $this->Html->safe($messenger->logo);?>" alt="<?php echo $this->Html->safe($messenger->name);?>">
                        <?php } ?>
                    </div>
                    <?php } ?>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-1"><?php echo $this->Html->safe($messenger->name);?> <span class="text-muted" style="font-weight: normal; font-size: 0.875rem;"><?php $this->_('AdminCompanyMessengers.available.text_version', false, $this->Html->safe($messenger->version));?></span></h6>
                    <div class="text-muted small mb-1">
                        <?php $this->_('AdminCompanyMessengers.available.text_author');?>
                        <?php
                        $authors = (array)($messenger->authors ?? []);
                        foreach ($authors as $index => $author) {
                        ?>
                        <a href="<?php echo $this->Html->safe($author['url'] ?? '#');?>" class="text-primary"><?php echo $this->Html->safe($author['name'] ?? '');?></a><?php echo isset($authors[$index + 1]) ? ', ' : '';?>
                        <?php
                        }
                        ?>
                    </div>
                    <p class="mb-0 text-secondary" style="font-size: 0.875rem;"><?php echo nl2br($this->Html->safe($messenger->description ?? ''));?></p>
                </div>
                <div class="d-flex gap-2" style="flex-shrink: 0;">
                    <?php
                    $this->Form->create($this->base_uri . 'settings/company/messengers/install/' . ($messenger->dir ?? '') . '/');
                    $this->Form->fieldHidden('id', $messenger->dir ?? '');
                    $this->Form->fieldSubmit('save', $this->_('AdminCompanyMessengers.available.btn_install', true), ['class' => 'btn btn-sm btn-primary']);
                    $this->Form->end();
                    ?>
                </div>
            </div>
            <?php
                }
            } else {
            ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyMessengers.available.text_none');?></p>
            </div>
            <?php
            }
            ?>
            <div class="text-center text-muted py-5 extension-filter-no-results" style="display: none;">
                <i class="bi bi-search" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyMessengers.text_filter_no_results');?></p>
            </div>
    <?php $this->Widget->end();?>
<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
</div>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Disable submit button after clicking to prevent double submissions
    document.querySelectorAll('.card-body form').forEach(form => {
        form.addEventListener('submit', function() {
            const submitBtn = this.querySelector('input[type="submit"]');
            if (submitBtn) {
                submitBtn.style.pointerEvents = 'none';
                submitBtn.style.cursor = 'default';
            }
        });
    });
});
</script>
<?php
}
?>
