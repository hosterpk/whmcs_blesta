<?php
if ((isset($applied) ? $applied : false) && ($num_applied = count($applied)) > 0) {
?>
<div class="p-3">
    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th style="width: 40px;"><i class="bi bi-arrow-return-right"></i></th>
                <th><?php $this->_('AdminBilling.invoices.headingexpand_paymenttype');?></th>
                <th><?php $this->_('AdminBilling.invoices.headingexpand_amount');?></th>
                <th><?php $this->_('AdminBilling.invoices.headingexpand_applied');?></th>
                <th><?php $this->_('AdminBilling.invoices.headingexpand_appliedon');?></th>
                <th style="width: 80px;"><?php $this->_('AdminBilling.invoices.headingexpand_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_applied; $i++) {
                $transaction_type = ($applied[$i]->type_name != '' ? $applied[$i]->type_name : $applied[$i]->type);
            ?>
            <tr>
                <td>&nbsp;</td>
                <td><?php echo (isset($transaction_type) ? $this->Html->safe($transaction_types[$transaction_type]) : null);?></td>
                <td><?php echo $this->CurrencyFormat->format((isset($applied[$i]->amount) ? $this->Html->safe($applied[$i]->amount) : null), (isset($applied[$i]->currency) ? $this->Html->safe($applied[$i]->currency) : null), ['html_code' => true]);?></td>
                <td><?php echo $this->CurrencyFormat->format((isset($applied[$i]->applied_amount) ? $this->Html->safe($applied[$i]->applied_amount) : null), (isset($applied[$i]->currency) ? $this->Html->safe($applied[$i]->currency) : null), ['html_code' => true]);?></td>
                <td><?php echo $this->Date->cast((isset($applied[$i]->applied_date) ? $this->Html->safe($applied[$i]->applied_date) : null), 'date_time');?></td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/edittransaction/' . (isset($client->id) ? $client->id : null) . '/' . (isset($applied[$i]->id) ? $applied[$i]->id : null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminBilling.invoices.text_edit');?>">
                        <i class="bi bi-pencil"></i>
                    </a>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php
} else {
?>
<div class="text-center py-4 text-muted">
    <p class="mb-0"><?php $this->_('AdminBilling.invoices.applied_no_results');?></p>
</div>
<?php
}
?>
