<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'accountaccess'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/accountaccess/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logaccountaccess'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if ((isset($access_logs) ? $access_logs : false) && ($num_logs = count($access_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/accountaccess/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'first_name' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logaccountaccess.name');?>
                                <?php if ($sort == 'first_name') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/accountaccess/?sort=type&order=' . ($sort == 'type' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'type' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logaccountaccess.type');?>
                                <?php if ($sort == 'type') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/accountaccess/?sort=date_accessed&order=' . ($sort == 'date_accessed' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_accessed' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logaccountaccess.date');?>
                                <?php if ($sort == 'date_accessed') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                    $access_id = (isset($access_logs[$i]->id) ? $this->Html->safe($access_logs[$i]->id) : null);
                ?>
                <tr style="cursor: pointer;" data-collapse-row aria-expanded="false">
                    <td><?php echo (isset($access_logs[$i]->staff_first_name) ? $this->Html->safe($access_logs[$i]->staff_first_name) : null) . ' ' . (isset($access_logs[$i]->staff_last_name) ? $this->Html->safe($access_logs[$i]->staff_last_name) : null);?></td>
                    <td>
                        <span class="badge bg-<?php echo (isset($access_logs[$i]->type) && $access_logs[$i]->type == 'ach') ? 'info' : 'primary';?>">
                            <?php $this->_('AdminTools.logaccountaccess.text_' . (isset($access_logs[$i]->type) ? $this->Html->safe($access_logs[$i]->type) : null));?>
                        </span>
                    </td>
                    <td><?php echo $this->Date->cast((isset($access_logs[$i]->date_accessed) ? $this->Html->safe($access_logs[$i]->date_accessed) : null), 'date_time');?></td>
                </tr>
                <tr class="collapse" data-collapse-src="<?php echo $this->Html->safe($this->base_uri . 'tools/accountaccess/' . $access_id);?>">
                    <td colspan="3" style="padding: 0; background-color: var(--bg-secondary);">
                        <div class="access-details-container p-3" data-access-id="<?php echo $access_id;?>">
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logaccountaccess.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>
