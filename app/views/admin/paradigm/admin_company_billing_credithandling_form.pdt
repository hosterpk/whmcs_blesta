<?php /** @var View $this **/ ?>


            <p>
                <?php $this->_('AdminCompanyBilling.credithandling.text_description');?>
            </p>

            <div class="mb-3 form-check">
                <?php
                $this->Form->fieldCheckbox(
                    'payment_credit_enabled',
                    '1',
                    ($vars['payment_credit_enabled'] ?? null) == '1',
                    ['id' => 'payment_credit_enabled', 'class' => 'form-check-input']
                );
                ?>
                <label for="payment_credit_enabled" class="form-check-label">
                    <?php $this->_('AdminCompanyBilling.credithandling.field.payment_credit_enabled');?>
                    <i class="bi bi-info-circle ms-1"
   data-bs-toggle="tooltip"
   data-bs-placement="top"
   title="<?php echo $this->Html->safe($this->_('AdminCompanyBilling.!tooltip.payment_credit_enabled', true));?>"></i>
                </label>
            </div>

            <div id="credit_limits_section">
                <h6 class="form-section-header"><?php $this->_('AdminCompanyBilling.credithandling.heading_limits');?></h6>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th><?php $this->_('AdminCompanyBilling.credithandling.field.currency');?></th>
                                <th>
                                    <?php $this->_('AdminCompanyBilling.credithandling.field.min_amount');?>
                                    <i class="bi bi-info-circle ms-1"
   data-bs-toggle="tooltip"
   data-bs-placement="top"
   title="<?php echo $this->Html->safe($this->_('AdminCompanyBilling.!tooltip.min_amount', true));?>"></i>
                                </th>
                                <th>
                                    <?php $this->_('AdminCompanyBilling.credithandling.field.max_amount');?>
                                    <i class="bi bi-info-circle ms-1"
   data-bs-toggle="tooltip"
   data-bs-placement="top"
   title="<?php echo $this->Html->safe($this->_('AdminCompanyBilling.!tooltip.max_amount', true));?>"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php
                            $i = 0;
                            foreach ($currencies ?? [] as $currency) {
                                $min_value = isset($credit_limits[$currency->code]['min']) && ($credit_limits[$currency->code]['min'] !== '') ? $this->CurrencyFormat->format($credit_limits[$currency->code]['min'], $currency->code, ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false]) : null;
                                $max_value = isset($credit_limits[$currency->code]['max']) && ($credit_limits[$currency->code]['max'] !== '') ? $this->CurrencyFormat->format($credit_limits[$currency->code]['max'], $currency->code, ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false]) : null;
                            ?>
                                <tr<?php echo (($i % 2 == 1) ? ' class="table-secondary"' : '');?>>
                                    <td>
                                        <strong><?php echo $this->Html->safe($currency->code);?></strong>
                                    </td>
                                    <td>
                                        <?php
                                        $this->Form->fieldText(
                                            'payment_credit_limits[' . $this->Html->safe($currency->code) . '][min]',
                                            $min_value,
                                            [
                                                'class' => 'form-control form-control-sm',
                                                'placeholder' => $this->CurrencyFormat->format(0, $currency->code, ['prefix' => false, 'suffix' => false, 'code' => false])
                                            ]
                                        );
                                        ?>
                                    </td>
                                    <td>
                                        <?php
                                        $this->Form->fieldText(
                                            'payment_credit_limits[' . $this->Html->safe($currency->code) . '][max]',
                                            $max_value,
                                            [
                                                'class' => 'form-control form-control-sm',
                                                'placeholder' => $this->CurrencyFormat->format(0, $currency->code, ['prefix' => false, 'suffix' => false, 'code' => false])
                                            ]
                                        );
                                        ?>
                                    </td>
                                </tr>
                            <?php
                                $i++;
                            }
                            ?>
                        </tbody>
                    </table>
                </div>
            </div>
