<!-- Widget Selector Modal -->
<div class="modal fade" id="widget-selector-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-grid-3x3-gap me-2"></i>
                    <?php $this->_('AdminMain.index.modal_manage_widgets_title');?>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="close-widget-selector" data-bs-dismiss="modal">
                    <?php $this->_('AdminMain.index.modal_manage_widgets_close');?>
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // Show widget selector modal
    var widgetManagementLink = document.querySelector('a[href="#widget-management"]');
    if (widgetManagementLink) {
        widgetManagementLink.addEventListener('click', function(e) {
            e.preventDefault();
            var modal = document.getElementById('widget-selector-modal');
            var body = modal.querySelector('.modal-body');

            fetch(base_uri + 'main/managewidgets/', {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(function(response) {
                return response.text();
            })
            .then(function(html) {
                body.innerHTML = html;

                // Execute scripts from fetched content (innerHTML doesn't execute <script> tags)
                body.querySelectorAll('script').forEach(function(oldScript) {
                    var newScript = document.createElement('script');
                    newScript.textContent = oldScript.textContent;
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });

                bootstrap.Modal.getOrCreateInstance(modal).show();
            })
            .catch(function(error) {
                console.error('Error loading widget selector:', error);
            });
        });
    }

    // Reload page when widget selector modal is closed (any method: button, backdrop click, or Escape key)
    document.getElementById('widget-selector-modal').addEventListener('hidden.bs.modal', function() {
        location.reload();
    });
</script>