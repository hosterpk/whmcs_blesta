<?php /** @var View $this **/ ?>

<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->create($this->_('AdminCompanyMessengers.manage.boxtitle_manage', true, $messenger_info->name), ['id' => 'admin_company_messengers_manage']);
    ?>

    <?php
    // Show messenger fields
    if (isset($input_html) && ($messenger_field_html = $input_html->generate(null, $this->view))) {
        $this->Form->create(null, ['class' => 'disable-on-submit']);
        echo $messenger_field_html;
    ?>
        <?php $this->Widget->footer(); ?>
        <div class="d-flex justify-content-end">
            <?php
            echo $this->Form->fieldSubmit('save', $this->_('AdminCompanyMessengers.manage.field_update', true), ['class' => 'btn btn-primary']);
            ?>
        </div>
    <?php
        $this->Form->end();
    } else {
    ?>
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminCompanyMessengers.manage.none_text');?></p>
        </div>
    <?php
    }
    ?>
    <?php $this->Widget->end();?>
</div>
