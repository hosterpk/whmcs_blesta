<?php
$has_results = ($clients ?? false) && count($clients) > 0;

if (($smart_search ?? false) && !$has_results) {
    return;
}
?>
<div class="card-body pb-0">
    <h6 class="form-section-header"><?php $this->_('AdminSearch.clients.heading');?></h6>
</div>
<?php if ($has_results) { ?>
<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th><?php $this->_('AdminSearch.clients.heading_client_id');?></th>
                <th><?php $this->_('AdminSearch.clients.heading_group');?></th>
                <th><?php $this->_('AdminSearch.clients.heading_name');?></th>
                <th><?php $this->_('AdminSearch.clients.heading_company');?></th>
                <th><?php $this->_('AdminSearch.clients.heading_email');?></th>
                <th style="width: 100px;"><?php $this->_('AdminSearch.transactions.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $num_clients = count($clients);
            for ($i = 0; $i < $num_clients; $i++) {
                $bg_color = $this->Color->hex(($clients[$i]->group->color ?? '#6c757d'))->asHtml();
                $text_color = $this->Color->hex(($clients[$i]->group->color ?? '#6c757d'))->contrastYiq()->asHtml();
            ?>
            <tr>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/view/' . ($clients[$i]->id ?? null) . '/');?>">
                        <?php echo $this->Html->safe($clients[$i]->id_code ?? null);?>
                    </a>
                </td>
                <td>
                    <span class="badge" style="background-color: <?php echo $bg_color;?>; color: <?php echo $text_color;?>;">
                        <?php echo $this->Html->safe($clients[$i]->group->name ?? null);?>
                    </span>
                </td>
                <td><?php echo $this->Html->safe($clients[$i]->first_name ?? null) . ' ' . $this->Html->safe($clients[$i]->last_name ?? null);?></td>
                <td><?php echo $this->Html->safe($clients[$i]->company ?? null);?></td>
                <td>
                    <a href="mailto:<?php echo $this->Html->safe($clients[$i]->email ?? null);?>">
                        <?php echo $this->Html->safe($clients[$i]->email ?? null);?>
                    </a>
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/view/' . ($clients[$i]->id ?? null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminSearch.invoice.option_view');?>">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="text-center py-5 text-muted">
    <i class="bi bi-person" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminSearch.clients.no_results');?></p>
</div>
<?php } ?>
