<?php
$js_contacts = (isset($js_contacts) ? $js_contacts : null);
if ((isset($edit) ? $edit : false) && (isset($is_local_storage) ? $is_local_storage : false)) {
    $this->Javascript->setInline("
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof blestaModal === 'undefined') return;

        function bindShowAccountForm(api) {
            var form = api.elements.content.querySelector('#showAccountForm');
            if (!form) return;

            form.addEventListener('submit', function(e) {
                e.preventDefault();

                var formData = new FormData(form);
                var submitBtn = form.querySelector('[type=\"submit\"]');
                if (submitBtn && submitBtn.name) {
                    formData.append(submitBtn.name, submitBtn.value);
                }

                fetch(form.action, {
                    method: 'POST',
                    body: new URLSearchParams(formData),
                    headers: {'X-Requested-With': 'XMLHttpRequest'}
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.view) {
                        api.set('content.text', data.view);
                        bindShowAccountForm(api);
                        return;
                    }

                    if (data.account) {
                        if (data.account.account) {
                            var accountField = document.getElementById('account');
                            if (accountField) {
                                accountField.value = data.account.account;
                            }
                        }
                        if (data.account.routing) {
                            var routingField = document.getElementById('routing');
                            if (routingField) {
                                routingField.value = data.account.routing;
                            }
                        }
                    }

                    api.hide();
                })
                .catch(function(error) { console.error('Error:', error); });
            });
        }

        document.querySelectorAll('.show-account').forEach(function(link) {
            blestaModal(link, {
                title: '" . addslashes($this->_('AdminClients.showaccount.modal_title', true)) . "',
                close: '" . addslashes($this->_('AppController.modal.text_close', true)) . "',
                onRender: function(event, api) {
                    bindShowAccountForm(api);
                }
            });
        });
    });
    ");
}
?>
