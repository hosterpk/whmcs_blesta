<?php
if ((isset($gateway_form) ? $gateway_form : null)) {
    echo $gateway_form;
} else {
?>
<div class="row g-3">
    <div class="col-12">
        <?php
        $this->Form->label($this->_('AdminClients.accountachinfo.field_type', true), 'type', ['class' => 'form-label']);
        $this->Form->fieldSelect('type', (isset($types) ? $types : null), (isset($vars->type) ? $vars->type : null), ['id' => 'type', 'class' => 'form-select']);
        ?>
    </div>
    <div class="col-12">
        <?php
        $this->Form->label($this->_('AdminClients.accountachinfo.field_routingnum', true), 'routing', ['class' => 'form-label']);
        $this->Form->fieldText('routing', isset($vars->last4) ? str_pad(null, 9, '*', STR_PAD_LEFT) : (isset($vars->routing) ? $vars->routing : null), ['id' => 'routing', 'class' => 'form-control']);
        ?>
    </div>
    <div class="col-12">
        <?php
        $this->Form->label($this->_('AdminClients.accountachinfo.field_accountnum', true), 'account', ['class' => 'form-label']);
        ?>
        <div class="input-group">
            <?php
            $this->Form->fieldText('account', isset($vars->last4) ? str_pad($vars->last4, 9, '*', STR_PAD_LEFT) : (isset($vars->account) ? $vars->account : null), ['id' => 'account', 'class' => 'form-control']);
            if ((isset($edit) ? $edit : false) && (isset($is_local_storage) ? $is_local_storage : false)) {
            ?>
            <a href="<?php echo $this->base_uri . 'clients/showaccount/' . (isset($client->id) ? $this->Html->safe($client->id) : null) . '/' . (isset($vars->id) ? $this->Html->safe($vars->id) : null);?>" class="btn btn-outline-secondary input-group-text show-account">
                <i class="bi bi-eye"></i>
            </a>
            <?php
            }
            ?>
        </div>
    </div>
</div>
<?php
}

if (isset($save_account) && $save_account) {
?>
<div class="form-check mt-3">
    <?php
    $this->Form->fieldCheckbox('save_details', 'true', isset($vars->save_details), ['id' => 'save_details_ach', 'class' => 'form-check-input']);
    $this->Form->label($this->_('AdminClients.accountachinfo.field_savedetails', true), 'save_details_ach', ['class' => 'form-check-label']);
    ?>
</div>
