<?php /** @var View $this **/ ?>

<?php
$geoip_database_path = ((isset($uploads_dir) ? $uploads_dir : null) . 'system' . DS . (isset($geoip_database_filename) ? $geoip_database_filename : null));
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

<?php
$this->Widget->clear();
$this->Widget->create($this->_('AdminSystemGeneral.geoip.boxtitle_geoip', true), ['id' => 'admin_system_general_geoip']);
?>
    <?php
    $this->Form->create(null, ['class' => 'disable-on-submit']);
    // Set a placeholder value so submissions may be posted when no checkboxes are checked
    $this->Form->fieldHidden('update', 'true');
    ?>

    <!-- Setup Instructions -->
    <p><?php $this->_('AdminSystemGeneral.geoip.text_setup');?></p>

    <p class="mb-3">
        <?php $this->_('AdminSystemGeneral.geoip.text_geolite', false, 'https://www.maxmind.com');?>
        <br />
        <code class="text-body"><?php (print (isset($geoip_database_path) ? $this->Html->safe($geoip_database_path) : null)); ?></code>
    </p>

    <!-- Setup Steps -->
    <ol class="mb-4">
        <li><a target="_blank" href="https://www.maxmind.com/en/geolite2/signup"><?php $this->_('AdminSystemGeneral.geoip.text_geolite_step_1');?></a></li>
        <li><?php $this->_('AdminSystemGeneral.geoip.text_geolite_step_2');?></li>
        <li><?php $this->_('AdminSystemGeneral.geoip.text_geolite_step_3');?></li>
        <li><?php $this->_('AdminSystemGeneral.geoip.text_geolite_step_4');?></li>
        <li><?php $this->_('AdminSystemGeneral.geoip.text_geolite_step_5');?></li>
    </ol>

    <!-- Database Status -->
    <div class="mb-3">
        <?php
        if ((isset($geoip_database_exists) ? $geoip_database_exists : false)) {
        ?>
        <div class="alert alert-success d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <div><?php echo $this->_('AdminSystemGeneral.geoip.text_database_exists', false, $this->Html->safe($geoip_database_path));?></div>
        </div>
        <?php
        } else {
        ?>
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            <div><?php echo $this->_('AdminSystemGeneral.geoip.text_database_not_exists', false, $this->Html->safe($geoip_database_path));?></div>
        </div>
        <?php
        }
        ?>
    </div>

    <!-- GeoIP Enabled Checkbox -->
    <div class="mb-3">
        <div class="form-check">
            <?php
            $this->Form->fieldCheckbox(
                'geoip_enabled',
                'true',
                ((isset($vars['geoip_enabled']) ? $vars['geoip_enabled'] : null) == 'true'),
                ['id' => 'geoip_enabled', 'class' => 'form-check-input']
            );
            ?>
            <?php
            $this->Form->label(
                $this->_('AdminSystemGeneral.geoip.field_geoip_enabled', true),
                'geoip_enabled',
                ['class' => 'form-check-label']
            );
            ?>
        </div>
    </div>

    <!-- Submit Button -->
    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end">
        <?php
        $this->Form->fieldSubmit('save', $this->_('AdminSystemGeneral.geoip.field_geoipsubmit', true), ['class' => 'btn btn-primary']);
        ?>
    </div>

    <?php $this->Form->end(); ?>
<?php $this->Widget->end(); ?>
</div>
