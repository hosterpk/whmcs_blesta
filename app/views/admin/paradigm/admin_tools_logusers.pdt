<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'users'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/users/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logusers'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if ((isset($user_logs) ? $user_logs : false) && ($num_logs = count($user_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/users/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'first_name' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logusers.text_name');?>
                                <?php if ($sort == 'first_name') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/users/?sort=username&order=' . ($sort == 'username' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'username' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logusers.text_username');?>
                                <?php if ($sort == 'username') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/users/?sort=type&order=' . ($sort == 'type' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'type' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logusers.text_type');?>
                                <?php if ($sort == 'type') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/users/?sort=result&order=' . ($sort == 'result' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'result' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logusers.text_result');?>
                                <?php if ($sort == 'result') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th><?php $this->_('AdminTools.logusers.text_ipaddress');?></th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/users/?sort=date_added&order=' . ($sort == 'date_added' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_added' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logusers.text_date');?>
                                <?php if ($sort == 'date_added') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                ?>
                <tr>
                    <td><?php echo (isset($user_logs[$i]->first_name) ? $this->Html->safe($user_logs[$i]->first_name) : null) . ' ' . (isset($user_logs[$i]->last_name) ? $this->Html->safe($user_logs[$i]->last_name) : null);?></td>
                    <td><?php (print (isset($user_logs[$i]->username) ? $this->Html->safe($user_logs[$i]->username) : null));?></td>
                    <td><?php $this->_('AdminTools.logusers.text_' . (isset($user_logs[$i]->type) ? $user_logs[$i]->type : null));?></td>
                    <td>
                        <?php if ((isset($user_logs[$i]->result) ? $this->Html->safe($user_logs[$i]->result) : null) == 'success') { ?>
                        <span class="badge bg-success"><?php $this->_('AdminTools.logusers.text_success');?></span>
                        <?php } else { ?>
                        <span class="badge bg-danger"><?php $this->_('AdminTools.logusers.text_failure');?></span>
                        <?php } ?>
                    </td>
                    <td>
                        <?php
                        if ((isset($user_logs[$i]->geo_ip['location']) ? $user_logs[$i]->geo_ip['location'] : null)) {
                            $location = $user_logs[$i]->geo_ip['location'];
                        ?>
                        <span data-bs-toggle="tooltip" data-bs-html="true" title="<strong><?php $this->_('AdminTools.logusers.text_location');?></strong><br><?php echo $this->Html->safe($this->Html->concat(', ', (isset($location['city']) ? $location['city'] : null), (isset($location['region']) ? $location['region'] : null)));?> <?php (print (isset($location['postal_code']) ? $this->Html->safe($location['postal_code']) : null));?><br><?php (print (isset($location['country_name']) ? $this->Html->safe($location['country_name']) : null));?><br><?php echo $this->Html->safe($this->Html->concat(', ', (isset($location['latitude']) ? $location['latitude'] : null), (isset($location['longitude']) ? $location['longitude'] : null)));?>">
                            <?php (print (isset($user_logs[$i]->ip_address) ? $this->Html->safe($user_logs[$i]->ip_address) : null));?>
                            <i class="bi bi-geo-alt text-muted"></i>
                        </span>
                        <?php
                        } else {
                        ?>
                        <?php (print (isset($user_logs[$i]->ip_address) ? $this->Html->safe($user_logs[$i]->ip_address) : null));?>
                        <?php
                        }
                        ?>
                    </td>
                    <td><?php echo $this->Date->cast((isset($user_logs[$i]->date_added) ? $this->Html->safe($user_logs[$i]->date_added) : null), 'date_time');?></td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logusers.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>

<script type="text/javascript">
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });
</script>
