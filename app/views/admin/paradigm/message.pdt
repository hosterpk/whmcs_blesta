<?php /** @var View $this **/ ?>

<?php
$types = [
    'success' => [
        'show' => (isset($success) || isset($message)),
        'message' => ($success ?? $message ?? ''),
        'icon' => 'bi bi-check-circle-fill',
    ],
    'danger' => [
        'show' => isset($error),
        'message' => ($error ?? ''),
        'icon' => 'bi-x-circle-fill',
    ],
    'warning' => [
        'show' => isset($notice),
        'message' => ($notice ?? ''),
        'icon' => 'bi bi-exclamation-triangle-fill',
    ],
    'info' => [
        'show' => isset($info),
        'message' => ($info ?? ''),
        'icon' => 'bi bi bi-info-circle-fill',
    ]
];

foreach ($types as $type => $content) {
    if (!$content['show']) {
        continue;
    }

    $message = $content['message'];
    ?>
    <div class="alert alert-<?php echo $this->Html->safe($type ?? 'info');?> alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="<?php echo $this->Html->safe($content['icon'] ?? 'bi bi bi-info-circle-fill');?> me-3 fs-5"></i>
        <div class="flex-grow-1">
            <?php
            if (is_array($message)) {
                foreach ($message as $field => $messages) {
                    foreach ($messages as $key => $message_text) {
                        ?>
                <p class="m-0"><?php echo (isset($message_text) ? $this->Html->safe($message_text, ($preserve_tags ?? false)) : null);?></p>
                        <?php
                    }
                }
            } else {
                ?>
                <p class="m-0"><?php echo (isset($message) ? $this->Html->safe($message, ($preserve_tags ?? false)) : null);?></p>
                <?php
            }
            ?>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <?php
}
?>
