<?php /** @var View $this **/ ?>


<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>
<?php
}
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => '',
        'icon' => 'bi-plus-lg',
        'attributes' => [
            'href' => $this->base_uri . 'settings/company/currencies/add/',
            'title' => $this->_('AdminCompanyCurrencies.active.categorylink_addcurrency', true)
        ]
    ]
]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminCompanyCurrencies.active.boxtitle_active', true), ['id' => 'admin_company_currencies_active'], ($render_section ?? null));
?>

            <?php if ((isset($currencies) ? $currencies : false) && ($num_currencies = count($currencies)) > 0) { ?>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/currencies/active/?sort=code&order=' . ($sort == 'code' ? $negate_order : $order));?>"
                                       class="ajax text-decoration-none<?php echo $sort == 'code' ? ' ' . $order : '';?>">
                                        <?php $this->_('AdminCompanyCurrencies.active.text_currency_code');?>
                                        <?php if ($sort == 'code') { ?>
                                            <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                        <?php } ?>
                                    </a>
                                </th>
                                <th><?php $this->_('AdminCompanyCurrencies.active.text_format');?></th>
                                <th>
                                    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/currencies/active/?sort=precision&order=' . ($sort == 'precision' ? $negate_order : $order));?>"
                                       class="ajax text-decoration-none<?php echo $sort == 'precision' ? ' ' . $order : '';?>">
                                        <?php $this->_('AdminCompanyCurrencies.active.text_precision');?>
                                        <?php if ($sort == 'precision') { ?>
                                            <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                        <?php } ?>
                                    </a>
                                </th>
                                <th>
                                    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/currencies/active/?sort=exchange_rate&order=' . ($sort == 'exchange_rate' ? $negate_order : $order));?>"
                                       class="ajax text-decoration-none<?php echo $sort == 'exchange_rate' ? ' ' . $order : '';?>">
                                        <?php $this->_('AdminCompanyCurrencies.active.text_exchange_rate');?>
                                        <?php if ($sort == 'exchange_rate') { ?>
                                            <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                        <?php } ?>
                                    </a>
                                </th>
                                <th>
                                    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/currencies/active/?sort=exchange_updated&order=' . ($sort == 'exchange_updated' ? $negate_order : $order));?>"
                                       class="ajax text-decoration-none<?php echo $sort == 'exchange_updated' ? ' ' . $order : '';?>">
                                        <?php $this->_('AdminCompanyCurrencies.active.text_exchange_updated');?>
                                        <?php if ($sort == 'exchange_updated') { ?>
                                            <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                        <?php } ?>
                                    </a>
                                </th>
                                <th style="width: 100px;"><?php $this->_('AdminCompanyCurrencies.active.text_options');?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php
                            for ($i = 0; $i < $num_currencies; $i++) {
                            ?>
                            <tr>
                                <td><?php (print (isset($currencies[$i]->code) ? $this->Html->safe($currencies[$i]->code) : null));?></td>
                                <td><span class="currency_value"><?php echo (isset($currencies[$i]->prefix) ? $this->Html->safe($currencies[$i]->prefix) : null) . (isset($currencies[$i]->format) ? $this->Html->safe($currencies[$i]->format) : null) . (isset($currencies[$i]->suffix) ? $this->Html->safe($currencies[$i]->suffix) : null);?></span></td>
                                <td><?php (print (isset($currencies[$i]->precision) ? $this->Html->safe($currencies[$i]->precision) : null));?></td>
                                <td><?php (print (isset($currencies[$i]->exchange_rate) ? $this->Html->safe($currencies[$i]->exchange_rate) : null));?></td>
                                <td><?php echo (empty($currencies[$i]->exchange_updated) ? $this->_('AdminCompanyCurrencies.active.no_exchange_updated', true) : $this->Date->cast((isset($currencies[$i]->exchange_updated) ? $currencies[$i]->exchange_updated : null), 'date_time'));?></td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="<?php echo $this->base_uri . 'settings/company/currencies/edit/' . (isset($currencies[$i]->code) ? $this->Html->safe($currencies[$i]->code) : null) . '/';?>"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="<?php echo $this->Html->safe($this->_('AdminCompanyCurrencies.active.option_edit', true));?>">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <?php
                                        // Do not display link to delete the default currency
                                        if ((isset($currencies[$i]->code) ? $this->Html->safe($currencies[$i]->code) : null) != (isset($default_currency) ? $default_currency : null)) {
                                            $this->Form->create($this->base_uri . 'settings/company/currencies/delete/', ['class' => 'd-inline']);
                                            $this->Form->fieldHidden('id', (isset($currencies[$i]->code) ? $this->Html->safe($currencies[$i]->code) : null));
                                        ?>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                                data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyCurrencies.active.confirm_delete', true));?>"
                                                title="<?php echo $this->Html->safe($this->_('AdminCompanyCurrencies.active.option_delete', true));?>">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <?php
                                            $this->Form->end();
                                        }
                                        ?>
                                    </div>
                                </td>
                            </tr>
                            <?php
                            }
                            ?>
                        </tbody>
                    </table>
                </div>
            <?php
            if (isset($this->Pagination) && $this->Pagination->hasPages()) {
                $this->Widget->footer();
                $this->Pagination->build();
            }
            ?>
            <?php } else { ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyCurrencies.active.no_results');?></p>
            </div>
            <?php } ?>
<?php
$this->Widget->end();

if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
</div>
<?php
}
?>
