<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();

// Build tabs for admin/client (admin first)
$customize_tabs = [];
$tab_order = ['admin', 'client'];
foreach ($tab_order as $i => $type) {
    if (!isset($theme_types[$type])) {
        continue;
    }
    $customize_tabs[] = [
        'name' => $this->Html->safe($theme_types[$type]),
        'current' => ($i === 0),
        'attributes' => [
            'href' => '#' . $type . '_customize',
            'data-bs-toggle' => 'tab',
        ]
    ];
}
$this->Widget->setTabs($customize_tabs);

$this->Widget->create($this->_('AdminCompanyLookandfeel.customize.box_title', true), ['id' => 'admin_company_lookandfeel_customize'], ($render_section ?? null));

$this->Form->create(null, ['enctype' => 'multipart/form-data', 'class' => 'disable-on-submit']);
?>
