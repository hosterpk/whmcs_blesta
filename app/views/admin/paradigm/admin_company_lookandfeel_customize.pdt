                                $this->Form->fieldRadio('client_icon_type', 'url', false, ['id' => 'client_icon_type_url', 'class' => 'form-check-input']);
                                $this->Form->label($this->_('AdminCompanyLookandfeel.customize.field.client_icon_type_url', true), 'client_icon_type_url', ['class' => 'form-check-label']);
                                ?>
                            </div>
                        </div>
                        <div id="client_icon_upload">
                            <?php $this->Form->fieldFile('client_icon_image', ['id' => 'client_icon_image', 'class' => 'form-control mb-2']);?>
                        </div>
                        <div class="d-none" id="client_icon_url_input">
                            <?php $this->Form->fieldText('client_icon_url', (isset($client_icon_url) ? $client_icon_url : null), ['id' => 'client_icon_url', 'class' => 'form-control mb-2', 'placeholder' => 'https://']);?>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger mt-1 remove-image-btn" data-target="icon_client"<?php echo !$has_client_icon ? ' style="display: none;"' : '';?>>
                            <i class="bi bi-trash"></i> <?php $this->_('AdminCompanyLookandfeel.customize.field.remove_image');?>
                        </button>
                        <?php $this->Form->fieldHidden('remove_icon_client', '0', ['id' => 'remove_icon_client']);?>
                    </div>
                </div>

                <!-- Client Favicon -->
                <h6 class="form-section-header"><?php $this->_('AdminCompanyLookandfeel.customize.heading_favicon');?></h6>
                <?php
                $has_client_favicon = !empty($client_favicon);
                ?>
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="file-preview-container<?php echo !$has_client_favicon ? ' file-preview-empty' : ' has-image';?>" id="client_favicon_preview_container" style="width: 80px; height: 80px; padding: 20px;">
                        <img id="client_favicon_file_preview"
                             src="<?php echo $has_client_favicon ? $this->Html->safe($client_favicon) : '';?>"
                             alt="Preview"
                             class="file-preview-image"
                             style="object-fit: contain;<?php echo !$has_client_favicon ? ' display: none;' : '';?>">
                    </div>
                    <div class="flex-grow-1">
                        <div class="mb-2">
                            <div class="form-check form-check-inline">
                                <?php
                                $this->Form->fieldRadio('client_favicon_type', 'image', true, ['id' => 'client_favicon_type_image', 'class' => 'form-check-input']);
                                $this->Form->label($this->_('AdminCompanyLookandfeel.customize.field.client_favicon_type_image', true), 'client_favicon_type_image', ['class' => 'form-check-label']);
                                ?>
                            </div>
                            <div class="form-check form-check-inline">
                                <?php
                                $this->Form->fieldRadio('client_favicon_type', 'url', false, ['id' => 'client_favicon_type_url', 'class' => 'form-check-input']);
                                $this->Form->label($this->_('AdminCompanyLookandfeel.customize.field.client_favicon_type_url', true), 'client_favicon_type_url', ['class' => 'form-check-label']);
                                ?>
                            </div>
                        </div>
                        <div id="client_favicon_upload">
                            <?php $this->Form->fieldFile('client_favicon_image', ['id' => 'client_favicon_image', 'class' => 'form-control mb-2']);?>
                        </div>
                        <div class="d-none" id="client_favicon_url_input">
                            <?php $this->Form->fieldText('client_favicon_url', ($client_favicon ?? null), ['id' => 'client_favicon_url', 'class' => 'form-control mb-2', 'placeholder' => 'https://']);?>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger mt-1 remove-image-btn" data-target="favicon_client"<?php echo !$has_client_favicon ? ' style="display: none;"' : '';?>>
                            <i class="bi bi-trash"></i> <?php $this->_('AdminCompanyLookandfeel.customize.field.remove_image');?>
                        </button>
                        <?php $this->Form->fieldHidden('remove_favicon_client', '0', ['id' => 'remove_favicon_client']);?>
                    </div>
                </div>
        </div>
    </div>

    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end">
        <?php
        $this->Form->fieldSubmit(
            'save',
            $this->_('AdminCompanyLookandfeel.customize.text_submit', true),
            ['class' => 'btn btn-primary']
        );
        ?>
    </div>
<?php
$this->Form->end();
$this->Widget->end();
?>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Current theme helper
    function getCurrentTheme() {
        return document.documentElement.getAttribute('data-theme') || 'dark';
    }

    // Update a theme-aware mockup image to show the correct variant
    function updateMockupForTheme(mockupImg) {
        if (!mockupImg) return;
        var theme = getCurrentTheme();
        var customSrc = mockupImg.getAttribute('data-custom-src-' + theme);
        var customSrcLight = mockupImg.getAttribute('data-custom-src-light');
        var defaultSrc = mockupImg.getAttribute('data-default-src-' + theme)
            || mockupImg.getAttribute('data-default-src');

        // Prefer theme-specific custom, fall back to light custom, then default
        if (customSrc) {
            mockupImg.src = customSrc;
            mockupImg.style.display = '';
            mockupImg.classList.remove('default');
        } else if (customSrcLight) {
            mockupImg.src = customSrcLight;
            mockupImg.style.display = '';
            mockupImg.classList.remove('default');
        } else if (defaultSrc) {
            mockupImg.src = defaultSrc;
            mockupImg.style.display = '';
            mockupImg.classList.add('default');
        }
    }

    // Listen for theme changes via MutationObserver on data-theme attribute
    var adminLogoMockup = document.getElementById('admin_logo_preview');
    if (adminLogoMockup) {
        // Set correct logo on initial load
        updateMockupForTheme(adminLogoMockup);

        new MutationObserver(function() {
            updateMockupForTheme(adminLogoMockup);
        }).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['data-theme']
        });
    }

    // Generic toggle helper for upload/url radio switches
    function setupToggle(radioA, radioB, showOnA, showOnB) {
        var elA = document.getElementById(radioA);
        var elB = document.getElementById(radioB);
        var divA = document.getElementById(showOnA);
        var divB = document.getElementById(showOnB);

        if (elA && elB && divA && divB) {
            elB.addEventListener('change', function() {
                divA.classList.add('d-none');
                divB.classList.remove('d-none');
            });
            elA.addEventListener('change', function() {
                divA.classList.remove('d-none');
                divB.classList.add('d-none');
            });
        }
    }

    setupToggle('admin_type_logo', 'admin_type_url', 'admin_logo_upload', 'admin_url_input');
    setupToggle('admin_dark_type_logo', 'admin_dark_type_url', 'admin_logo_dark_upload', 'admin_url_dark_input');
    setupToggle('admin_icon_type_image', 'admin_icon_type_url', 'admin_icon_upload', 'admin_icon_url_input');
    setupToggle('admin_icon_dark_type_image', 'admin_icon_dark_type_url', 'admin_icon_dark_upload', 'admin_icon_dark_url_input');
    setupToggle('admin_favicon_type_image', 'admin_favicon_type_url', 'admin_favicon_upload', 'admin_favicon_url_input');
    setupToggle('client_type_logo', 'client_type_url', 'client_logo_upload', 'client_url_input');
    setupToggle('client_icon_type_image', 'client_icon_type_url', 'client_icon_upload', 'client_icon_url_input');
    setupToggle('client_favicon_type_image', 'client_favicon_type_url', 'client_favicon_upload', 'client_favicon_url_input');

    // File preview + remove button logic (mirrors myinfo avatar pattern)
    var imageFields = [
        {key: 'logo_admin', file: 'admin_logo', url: 'admin_url', preview: 'admin_logo_file_preview', container: 'admin_logo_preview_container', mockup: 'admin_logo_preview', mockupAttr: 'light', removeMockupDefault: true},
        {key: 'logo_admin_dark', file: 'admin_logo_dark', url: 'admin_url_dark', preview: 'admin_logo_dark_file_preview', container: 'admin_logo_dark_preview_container', mockup: 'admin_logo_preview', mockupAttr: 'dark'},
        {key: 'icon_admin', file: 'admin_icon_image', url: 'admin_icon_url', preview: 'admin_icon_file_preview', container: 'admin_icon_preview_container'},
        {key: 'icon_admin_dark', file: 'admin_icon_image_dark', url: 'admin_icon_url_dark', preview: 'admin_icon_dark_file_preview', container: 'admin_icon_dark_preview_container'},
        {key: 'favicon_admin', file: 'admin_favicon_image', url: 'admin_favicon_url', preview: 'admin_favicon_file_preview', container: 'admin_favicon_preview_container', mockup: 'admin_favicon_preview'},
        {key: 'logo_client', file: 'client_logo', url: 'client_url', preview: 'client_logo_file_preview', container: 'client_logo_preview_container', mockup: 'client_logo_preview', removeMockupDefault: true},
        {key: 'icon_client', file: 'client_icon_image', url: 'client_icon_url', preview: 'client_icon_file_preview', container: 'client_icon_preview_container'},
        {key: 'favicon_client', file: 'client_favicon_image', url: 'client_favicon_url', preview: 'client_favicon_file_preview', container: 'client_favicon_preview_container', mockup: 'client_favicon_preview'}
    ];

    imageFields.forEach(function(field) {
        var fileInput = document.getElementById(field.file);
        var urlInput = document.getElementById(field.url);
        var previewImg = document.getElementById(field.preview);
        var container = document.getElementById(field.container);
        var removeBtn = document.querySelector('.remove-image-btn[data-target="' + field.key + '"]');
        var hiddenField = document.getElementById('remove_' + field.key);
        var mockupImg = field.mockup ? document.getElementById(field.mockup) : null;

        // Helper to update the mockup (theme-aware for admin logo, direct for others)
        function setMockupSrc(src) {
            if (!mockupImg) return;
            if (field.mockupAttr) {
                // Theme-aware: update the data attribute and refresh
                mockupImg.setAttribute('data-custom-src-' + field.mockupAttr, src);
                updateMockupForTheme(mockupImg);
            } else {
                mockupImg.src = src;
                mockupImg.style.display = '';
            }
            if (field.removeMockupDefault) mockupImg.classList.remove('default');
        }

        function clearMockup() {
            if (!mockupImg) return;
            if (field.mockupAttr) {
                // Clear the custom src for this variant and refresh
                mockupImg.setAttribute('data-custom-src-' + field.mockupAttr, '');
                updateMockupForTheme(mockupImg);
            } else {
                var defaultSrc = mockupImg.getAttribute('data-default-src')
                    || mockupImg.getAttribute('data-default-src-light');
                if (defaultSrc) {
                    mockupImg.src = defaultSrc;
                    mockupImg.style.display = '';
                } else {
                    mockupImg.style.display = 'none';
                }
            }
            if (field.removeMockupDefault) mockupImg.classList.add('default');
        }

        // File input preview
        if (fileInput && previewImg && container) {
            fileInput.addEventListener('change', function(e) {
                if (e.target.files && e.target.files[0]) {
                    var objectUrl = URL.createObjectURL(e.target.files[0]);
                    previewImg.src = objectUrl;
                    previewImg.style.display = 'block';
                    container.classList.remove('file-preview-empty');
                    container.classList.add('has-image');
                    if (removeBtn) removeBtn.style.display = 'inline-block';
                    if (hiddenField) hiddenField.value = '0';
                    setMockupSrc(objectUrl);
                }
            });
        }

        // URL input preview
        if (urlInput && previewImg && container) {
            urlInput.addEventListener('input', function() {
                if (this.value) {
                    previewImg.src = this.value;
                    previewImg.style.display = 'block';
                    container.classList.remove('file-preview-empty');
                    container.classList.add('has-image');
                    if (removeBtn) removeBtn.style.display = 'inline-block';
                    if (hiddenField) hiddenField.value = '0';
                    setMockupSrc(this.value);
                }
            });
        }

        // Remove button
        if (removeBtn && previewImg && container && hiddenField) {
            removeBtn.addEventListener('click', function() {
                if (fileInput) fileInput.value = '';
                if (urlInput) urlInput.value = '';
                previewImg.src = '';
                previewImg.style.display = 'none';
                container.classList.add('file-preview-empty');
                container.classList.remove('has-image');
                removeBtn.style.display = 'none';
                hiddenField.value = '1';
                clearMockup();
            });
        }
    });
});
</script>
