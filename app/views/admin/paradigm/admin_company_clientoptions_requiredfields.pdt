<?php /** @var View $this **/ ?>

<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->setBodyWrapper(false);
    $this->Widget->create($this->_('AdminCompanyClientoptions.requiredfields.boxtitle', true), ['id' => 'admin_company_clientoptions_requiredfields'], ($render_section ?? null));
    ?>
    <?php $this->Form->create(null, ['class' => 'disable-on-submit']); ?>
            <!-- Dynamic Required Fields Form -->
            <?php echo (isset($required_fields_form) ? $required_fields_form : null);?>
        <?php $this->Widget->footer(); ?>
        <div class="d-flex justify-content-end">
            <?php
            $this->Form->fieldSubmit('save', $this->_('AdminCompanyClientoptions.requiredfields.text_submit', true), ['class' => 'btn btn-primary']);
            ?>
        </div>
        <?php $this->Form->end(); ?>
    <?php $this->Widget->end(); ?>
</div>
