            $this->Form->label($this->_('AdminClients.recordpayment.field_currency', true), 'currency', ['class' => 'form-label']);
            $this->Form->fieldSelect('currency', (isset($currencies) ? $currencies : null), (isset($vars->currency) ? $vars->currency : null), ['id' => 'currency', 'class' => 'form-select']);
            ?>
        </div>
        <div class="col-md-6">
            <?php
            $this->Form->label($this->_('AdminClients.recordpayment.field_status', true), 'status', ['class' => 'form-label']);
            $this->Form->fieldSelect('status', (isset($statuses) ? $statuses : null), (isset($vars->status) ? $vars->status : 'approved'), ['id' => 'status', 'class' => 'form-select']);
            ?>
        </div>
        <div class="col-12">
            <a class="collapse-trigger" data-bs-toggle="collapse" href="#dateReceivedCollapse" role="button" aria-expanded="false" aria-controls="dateReceivedCollapse">
                <i class="bi bi-chevron-down"></i>
                <?php $this->_('AdminClients.recordpayment.text_datereceived');?>
            </a>
