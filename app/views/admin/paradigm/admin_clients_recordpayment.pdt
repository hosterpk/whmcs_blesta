            <?php
            $this->Form->label($this->_('AdminClients.recordpayment.field_amount', true), 'amount', ['class' => 'form-label']);
            $this->Form->fieldText('amount', (isset($vars->amount) ? $vars->amount : null), ['id' => 'amount', 'class' => 'form-control']);
            ?>
        </div>
        <div class="col-md-6 transaction-id-field">
            <?php
            $this->Form->label($this->_('AdminClients.recordpayment.field_transaction_id', true), 'transaction_id', ['class' => 'form-label']);
            $this->Form->fieldText('transaction_id', (isset($vars->transaction_id) ? $vars->transaction_id : null), ['id' => 'transaction_id', 'class' => 'form-control']);
            ?>
        </div>
        <div class="col-md-6 transaction-type-field">
            <?php
            $this->Form->label($this->_('AdminClients.recordpayment.field_transactiontype', true), 'transaction_type', ['class' => 'form-label']);
            $this->Form->fieldSelect('transaction_type', (isset($transaction_types) ? $transaction_types : null), (isset($vars->transaction_type) ? $vars->transaction_type : 'check'), ['id' => 'transaction_type', 'class' => 'form-select']);
            ?>
        </div>
        <div class="col-md-6 gateway-field" style="display: none;">
            <?php
            $this->Form->label($this->_('AdminClients.recordpayment.field_gateway_id', true), 'gateway_id', ['class' => 'form-label']);
            $this->Form->fieldHidden('gateway_id', (isset($vars->gateway_id) ? $vars->gateway_id : null), ['id' => 'gateway_id']);
            ?>
            <div class="input-group">
