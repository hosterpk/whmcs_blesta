        <div class="collapse" id="dateReceivedCollapse">
            <div class="col-md-6">
                <?php
                $this->Form->label($this->_('AdminClients.recordpayment.field_datereceived', true), 'date_received', ['class' => 'form-label']);
                $this->Form->fieldText('date_received', (isset($vars->date_received) ? $vars->date_received : $this->Date->cast(date('c'), 'Y-m-d')), ['id' => 'date_received', 'class' => 'form-control date']);
                ?>
            </div>
        </div>
    </div>

    <div id="invoices-to-pay">
        <?php
        echo (isset($invoice_info) ? $invoice_info : null);
        ?>
    </div>

    <div class="email-receipt-section">
        <div class="form-check">
            <?php
            $this->Form->fieldCheckbox('email_receipt', 'true', (isset($vars->email_receipt) ? $vars->email_receipt : null), ['id' => 'email_receipt', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminClients.recordpayment.field_receipt', true), 'email_receipt', ['class' => 'form-check-label']);
            ?>
        </div>
    </div>
