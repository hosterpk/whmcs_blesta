<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <a href="<?php echo $this->base_uri . 'clients/view/' . ($client->id ?? '');?>/" class="btn btn-secondary">
        <?php $this->_('AppController.modal.btn_cancel');?>
    </a>
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminClients.recordpayment.field_submit', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Form->end();
$this->Widget->end();
?>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var clientId = <?php echo json_encode((isset($client->id) ? $client->id : null));?>;
    var amountField = document.getElementById('amount');
    var currencySelect = document.getElementById('currency');
    var transactionTypeSelect = document.getElementById('transaction_type');
    var statusSelect = document.getElementById('status');
    var gatewayField = document.querySelector('.gateway-field');
    var merchantGw = document.getElementById('merchant_gw');
    var nonmerchantGw = document.getElementById('nonmerchant_gw');
    var gatewayId = document.getElementById('gateway_id');
    var invoicesToPay = document.getElementById('invoices-to-pay');
    var emailReceiptSection = document.querySelector('.email-receipt-section');
    var emailReceiptCheckbox = document.getElementById('email_receipt');

    // Set initial gateway visibility
    setGateway();

    // Amount focus
    if (amountField) {
        amountField.focus();
    }

    // Transaction type change
    if (transactionTypeSelect) {
        transactionTypeSelect.addEventListener('change', setGateway);
    }

    function setGateway() {
        if (!gatewayField) return;

        var type = transactionTypeSelect ? transactionTypeSelect.value : '';

        // Hide all gateway selects
        if (merchantGw) merchantGw.style.display = 'none';
        if (nonmerchantGw) nonmerchantGw.style.display = 'none';

        switch(type) {
            case 'cc':
            case 'ach':
                gatewayField.style.display = '';
                if (merchantGw) {
                    merchantGw.style.display = '';
                    if (gatewayId) gatewayId.value = merchantGw.value;
                }
                break;
            case 'other':
                gatewayField.style.display = '';
                if (nonmerchantGw) {
                    nonmerchantGw.style.display = '';
                    if (gatewayId) gatewayId.value = nonmerchantGw.value;
                }
                break;
            default:
                gatewayField.style.display = 'none';
                if (gatewayId) gatewayId.value = '';
                break;
        }
    }

    // Gateway select changes
    if (merchantGw) {
        merchantGw.addEventListener('change', function() {
            if (gatewayId) gatewayId.value = this.value;
        });
    }
    if (nonmerchantGw) {
        nonmerchantGw.addEventListener('change', function() {
            if (gatewayId) gatewayId.value = this.value;
        });
    }

    // Currency change
    if (currencySelect) {
        currencySelect.addEventListener('change', function() {
            var form = this.closest('form');
            var formData = new FormData(form);

            // Update invoices
            fetch(baseUri + 'clients/makepaymentinvoices/' + clientId + '/', {
                method: 'POST',
                body: new URLSearchParams(formData),
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(response => response.json())
            .then(data => {
                if (invoicesToPay && data.content) {
                    invoicesToPay.innerHTML = data.content;
                }
            })
            .catch(error => console.error('Error:', error));

            // Update credit fields
            fetch(baseUri + 'clients/getrecordcreditfields/' + clientId + '/', {
                method: 'POST',
                body: new URLSearchParams(formData),
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(response => response.json())
            .then(data => {
                if (data.content) {
                    var recordCreditDiv = document.querySelector('#record_payment_fields') || document.querySelector('.record-payment-fields');
                    if (recordCreditDiv) {
                        recordCreditDiv.innerHTML = data.content;
                        setPaymentType();
                    }
                }
            })
            .catch(error => console.error('Error:', error));
        });
    }

    // Status change
    if (statusSelect) {
        statusSelect.addEventListener('change', toggleInvoiceAndEmail);
    }

    function toggleInvoiceAndEmail() {
        var isApproved = statusSelect && statusSelect.value === 'approved';
        var isCredit = isPaymentTypeCredit();

        if (invoicesToPay) {
            invoicesToPay.style.display = isApproved ? '' : 'none';
            invoicesToPay.querySelectorAll('input').forEach(function(input) {
                input.disabled = !isApproved;
            });
        }

        if (emailReceiptSection) {
            emailReceiptSection.style.display = (isApproved && !isCredit) ? '' : 'none';
            if (emailReceiptCheckbox) {
                emailReceiptCheckbox.disabled = !(isApproved && !isCredit);
            }
        }
    }

    function isPaymentTypeCredit() {
        return document.querySelector('#payment_type_credit:checked') !== null;
    }

    function setPaymentType() {
        var isCredit = isPaymentTypeCredit();
        var amountFieldParent = amountField ? amountField.closest('.col-md-6') : null;
        var transactionIdFieldParent = document.querySelector('.transaction-id-field');
        var transactionTypeFieldParent = document.querySelector('.transaction-type-field');

        if (amountFieldParent) {
            amountFieldParent.style.display = isCredit ? 'none' : '';
        }
        if (transactionIdFieldParent) {
            transactionIdFieldParent.style.display = isCredit ? 'none' : '';
        }
        if (transactionTypeFieldParent) {
            transactionTypeFieldParent.style.display = isCredit ? 'none' : '';
        }

        toggleInvoiceAndEmail();
    }

    // Payment type change delegation
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('payment_type')) {
            setPaymentType();
        }
    });

    // Invoice "all" checkbox handling
    document.addEventListener('change', function(e) {
        if (e.target.name === 'invoice_id[]' && e.target.value === 'all') {
            var checkboxes = document.querySelectorAll('input[name="invoice_id[]"]');
            checkboxes.forEach(function(cb) {
                cb.checked = e.target.checked;
            });
        }
    });

    // Initial calls
    setPaymentType();
    toggleInvoiceAndEmail();
});
</script>
