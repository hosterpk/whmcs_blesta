<!-- Ace Editor for Custom CSS -->
<script src="<?php echo VENDORWEBDIR;?>ace/src-min-noconflict/ace.js"></script>

<script>
(function() {
    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Initialize Ace editor for Custom CSS (deferred until manual section is visible,
    // because Ace cannot calculate dimensions on a hidden container)
    let aceInitialized = false;
    function initAceEditor() {
        if (aceInitialized) return;

        const customCssTextarea = document.getElementById('custom_css');
        if (!customCssTextarea || typeof ace === 'undefined') return;

        aceInitialized = true;

        const editorDiv = document.createElement('div');
        editorDiv.id = 'ace_custom_css';
        editorDiv.style.height = '300px';
        editorDiv.style.width = '100%';
        editorDiv.style.border = '1px solid var(--border-color, #dee2e6)';
        editorDiv.style.borderRadius = '0.375rem';

        customCssTextarea.style.display = 'none';
        customCssTextarea.parentNode.insertBefore(editorDiv, customCssTextarea.nextSibling);

        const editor = ace.edit('ace_custom_css');
        editor.setTheme('ace/theme/tomorrow');
        editor.session.setMode('ace/mode/css');
        editor.setOptions({
            fontSize: '14px',
            showPrintMargin: false,
            enableBasicAutocompletion: true,
            enableLiveAutocompletion: true
        });

        editor.setValue(customCssTextarea.value || '', -1);

        editor.session.on('change', function() {
            customCssTextarea.value = editor.getValue();
        });

        function updateAceTheme() {
            const isDarkMode = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            editor.setTheme(isDarkMode ? 'ace/theme/tomorrow_night' : 'ace/theme/tomorrow');
        }

        updateAceTheme();

        const observer = new MutationObserver(updateAceTheme);
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['data-bs-theme']
        });
    }

    // Function to toggle import/manual sections
    function changeAddOptions() {
        const importType = document.querySelector('.import_type');
        const manualType = document.querySelector('.manual_type');
        const checkedRadio = document.querySelector('.add_type:checked');

        if (!importType || !manualType) return;

        if (checkedRadio && checkedRadio.value === 'import') {
            importType.style.display = 'block';
            manualType.style.display = 'none';
        } else {
            importType.style.display = 'none';
            manualType.style.display = 'block';
            initAceEditor();
        }
    }

    // Initialize on page load
    changeAddOptions();

    // Add event listeners to radio buttons
    const addTypeRadios = document.querySelectorAll('.add_type');
    addTypeRadios.forEach(function(radio) {
        radio.addEventListener('change', changeAddOptions);
    });

    // Initialize native HTML5 color pickers
    const colorPickers = document.querySelectorAll('.color-picker-input');
    colorPickers.forEach(function(colorPicker) {
        const textInputId = colorPicker.getAttribute('data-color-field');
        const textInput = document.getElementById(textInputId);

        if (!textInput) return;

        // Sync color picker to text input on color picker change
        colorPicker.addEventListener('input', function() {
            const hexValue = this.value;
            textInput.value = hexValue.substring(1);
        });

        colorPicker.addEventListener('change', function() {
            const hexValue = this.value;
            textInput.value = hexValue.substring(1);
        });

        // Sync text input to color picker on text input change
        textInput.addEventListener('input', function() {
            let hexValue = this.value.trim();

            if (/^#?[0-9A-Fa-f]{6}$/.test(hexValue)) {
                if (!hexValue.startsWith('#')) {
                    hexValue = '#' + hexValue;
                }
                colorPicker.value = hexValue;
            }
        });

        textInput.addEventListener('change', function() {
            let hexValue = this.value.trim();

            if (/^#?[0-9A-Fa-f]{6}$/.test(hexValue)) {
                if (!hexValue.startsWith('#')) {
                    hexValue = '#' + hexValue;
                }
                colorPicker.value = hexValue;
                this.value = hexValue.substring(1);
            } else {
                const currentColor = colorPicker.value;
                this.value = currentColor.substring(1);
            }
        });
    });
})();
</script>

<style>
/* Color picker styling for Paradigm theme */
.color-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.color-picker-input-group {
    display: flex;
    gap: 0.5rem;
    align-items: center;
}

.color-picker-input {
    width: 50px;
    height: 38px;
    padding: 2px;
    border: 1px solid var(--border-color, #dee2e6);
    border-radius: 0.375rem;
    cursor: pointer;
}

.color-text-input {
    font-family: monospace;
    width: 120px;
}

/* Dark mode adjustments for color picker */
[data-bs-theme="dark"] .color-picker-input {
    border-color: var(--border-color, #2a2a2a);
}
/* Ace editor styling */
#ace_custom_css {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', 'source-code-pro', monospace;
}
/* Dark mode adjustments for Ace editor border */
[data-bs-theme="dark"] #ace_custom_css {
    border-color: var(--border-color, #2a2a2a) !important;
}
</style>
