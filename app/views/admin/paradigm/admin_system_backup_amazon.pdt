<script>
// Initialize Bootstrap tooltips
document.addEventListener('DOMContentLoaded', function() {
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Test Amazon S3 functionality
    const testAmazonButton = document.querySelector('.test-amazons3');
    const amazonForm = document.getElementById('amazons3');

    if (testAmazonButton && amazonForm) {
        testAmazonButton.addEventListener('click', function() {
            // Disable the form
            const formElements = amazonForm.querySelectorAll('input, select, button, textarea');
            formElements.forEach(element => {
                element.disabled = true;
            });

            // Create FormData from the form
            const formData = new FormData(amazonForm);

            // Send AJAX request
            fetch('<?php echo $this->base_uri . 'settings/system/backup/amazontest/';?>', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(data => {
                // Hide any existing error sections
                const existingErrors = document.querySelectorAll('.card-body .error_section, .card-body .alert-danger, .card-body .alert-success');
                existingErrors.forEach(error => error.remove());

                // Insert the response message at the top of the card body
                const cardBody = document.querySelector('.card-body');
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = data;
                cardBody.insertBefore(tempDiv.firstElementChild, cardBody.firstChild);

                // Re-enable the form
                formElements.forEach(element => {
                    element.disabled = false;
                });
            })
            .catch(error => {
                console.error('Error:', error);
                // Re-enable the form
                formElements.forEach(element => {
                    element.disabled = false;
                });
            });
        });
    }
});
</script>
