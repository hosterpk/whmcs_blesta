<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'clientsettings'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/clientsettings/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logclientsettings'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if ((isset($client_settings_logs) ? $client_settings_logs : false) && ($num_logs = count($client_settings_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/clientsettings/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'first_name' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logclientsettings.text_client');?>
                                <?php if ($sort == 'first_name') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/clientsettings/?sort=user_first_name&order=' . ($sort == 'user_first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'user_first_name' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logclientsettings.text_user');?>
                                <?php if ($sort == 'user_first_name') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/clientsettings/?sort=ip_address&order=' . ($sort == 'ip_address' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'ip_address' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logclientsettings.text_ip_address');?>
                                <?php if ($sort == 'ip_address') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/clientsettings/?sort=date_changed&order=' . ($sort == 'date_changed' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_changed' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logclientsettings.text_date');?>
                                <?php if ($sort == 'date_changed') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                    $client_settings_log_id = (isset($client_settings_logs[$i]->id) ? $this->Html->safe($client_settings_logs[$i]->id) : $i);
                ?>
                <tr class="clientsettings_list" style="cursor: pointer;" data-collapse-row aria-expanded="false">
                    <td><a href="<?php echo $this->base_uri . 'clients/edit/' . (isset($client_settings_logs[$i]->client_id) ? $this->Html->safe($client_settings_logs[$i]->client_id) : null) . '/';?>"><?php echo (isset($client_settings_logs[$i]->first_name) ? $this->Html->safe($client_settings_logs[$i]->first_name) : null) . ' ' . (isset($client_settings_logs[$i]->last_name) ? $this->Html->safe($client_settings_logs[$i]->last_name) : null);?></a></td>
                    <td><?php
                    if ((isset($client_settings_logs[$i]->user_staff_id) ? $client_settings_logs[$i]->user_staff_id : null)) {
                    ?>
                        <a href="<?php echo $this->base_uri . 'settings/system/staff/edit/' . (isset($client_settings_logs[$i]->user_staff_id) ? $this->Html->safe($client_settings_logs[$i]->user_staff_id) : null) . '/';?>"><?php echo (isset($client_settings_logs[$i]->user_first_name) ? $this->Html->safe($client_settings_logs[$i]->user_first_name) : null) . ' ' . (isset($client_settings_logs[$i]->user_last_name) ? $this->Html->safe($client_settings_logs[$i]->user_last_name) : null);?></a>
                    <?php
                    } elseif ((isset($client_settings_logs[$i]->user_client_id) ? $client_settings_logs[$i]->user_client_id : null)) {
                    ?>
                        <a href="<?php echo $this->base_uri . 'clients/editcontact/' . (isset($client_settings_logs[$i]->user_client_id) ? $this->Html->safe($client_settings_logs[$i]->user_client_id) : null) . '/' . (isset($client_settings_logs[$i]->user_contact_id) ? $this->Html->safe($client_settings_logs[$i]->user_contact_id) : null) . '/';?>"><?php echo (isset($client_settings_logs[$i]->user_first_name) ? $this->Html->safe($client_settings_logs[$i]->user_first_name) : null) . ' ' . (isset($client_settings_logs[$i]->user_last_name) ? $this->Html->safe($client_settings_logs[$i]->user_last_name) : null);?></a>
                    <?php
                    }
                    ?></td>
                    <td>
                        <?php
                        if ((isset($client_settings_logs[$i]->geo_ip['location']) ? $client_settings_logs[$i]->geo_ip['location'] : null)) {
                            $location = $client_settings_logs[$i]->geo_ip['location'];
                        ?>
                        <span data-bs-toggle="tooltip" data-bs-html="true" title="<strong><?php $this->_('AdminTools.logusers.text_location');?></strong><br><?php echo $this->Html->safe($this->Html->concat(', ', (isset($location['city']) ? $location['city'] : null), (isset($location['region']) ? $location['region'] : null)));?> <?php (print (isset($location['postal_code']) ? $this->Html->safe($location['postal_code']) : null));?><br><?php (print (isset($location['country_name']) ? $this->Html->safe($location['country_name']) : null));?><br><?php echo $this->Html->safe($this->Html->concat(', ', (isset($location['latitude']) ? $location['latitude'] : null), (isset($location['longitude']) ? $location['longitude'] : null)));?>">
                            <?php (print (isset($client_settings_logs[$i]->ip_address) ? $this->Html->safe($client_settings_logs[$i]->ip_address) : null));?>
                            <i class="bi bi-geo-alt text-muted"></i>
                        </span>
                        <?php
                        } else {
                        ?>
                        <?php (print (isset($client_settings_logs[$i]->ip_address) ? $this->Html->safe($client_settings_logs[$i]->ip_address) : null));?>
                        <?php
                        }
                        ?>
                    </td>
                    <td><?php echo $this->Date->cast((isset($client_settings_logs[$i]->date_changed) ? $this->Html->safe($client_settings_logs[$i]->date_changed) : null), 'date_time');?></td>
                </tr>
                <tr class="collapse">
                    <td colspan="4" style="padding: 0; background-color: var(--bg-secondary);">
                        <div class="p-3">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th><?php $this->_('AdminTools.logclientsettings.text_field');?></th>
                                    <th><?php $this->_('AdminTools.logclientsettings.text_previous');?></th>
                                    <th><?php $this->_('AdminTools.logclientsettings.text_new');?></th>
                                </tr>
                            </thead>
                            <tbody>
                            <?php
                            foreach ($client_settings_logs[$i]->change as $field => $values) {
                            ?>
                            <tr>
                                <td><code><?php (print (isset($field) ? $this->Html->safe($field) : null));?></code></td>
                                <td class="text-danger"><?php (print (isset($values['prev']) ? $this->Html->safe($values['prev']) : null));?></td>
                                <td class="text-success"><?php (print (isset($values['cur']) ? $this->Html->safe($values['cur']) : null));?></td>
                            </tr>
                            <?php
                            }
                            ?>
                            </tbody>
                        </table>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logclientsettings.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
    // Bootstrap 5 collapse handles row expansion automatically via data-bs-toggle
</script>
