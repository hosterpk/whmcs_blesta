                $this->Form->fieldText('postalmethods', ($this->Html->concat(' ', ($client->address1 ?? null), ($client->address2 ?? null), ($client->city ?? null), ($client->state ?? null), ($client->zip ?? null))), ['class' => 'action d-none form-control form-control-sm', 'disabled' => 'disabled', 'style' => 'width: 200px;']);
                $this->Form->fieldText('sms', ($contact_mobile[0]->number ?? null), ['class' => 'action d-none form-control form-control-sm', 'disabled' => 'disabled', 'style' => 'width: 200px;']);
                $this->Form->fieldSelect('status', ($quotation_statuses ?? null), ($vars->status ?? null), ['class' => 'action d-none form-select form-select-sm', 'style' => 'width: 150px;']);
