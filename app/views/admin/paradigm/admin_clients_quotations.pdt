?>

<script type="text/javascript">
(function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var clientId = <?php echo json_encode($client->id ?? null);?>;
    var widgetId = 'admin_clients_quotations';
    var textItemSelected = <?php echo json_encode($this->_('AdminClients.quotations.text_item_selected', true));?>;
    var textItemsSelected = <?php echo json_encode($this->_('AdminClients.quotations.text_items_selected', true));?>;

    // Handle action input visibility
    function updateActionFields() {
        var actionInputs = document.querySelectorAll('#quotation_action .action');
        var actionSelect = document.querySelector("#quotation_action select[name='action']");

        if (!actionSelect) return;

        actionInputs.forEach(function(input) {
            input.classList.add('d-none');
        });

        var currentValue = actionSelect.value;
        if (currentValue) {
            var targetInput = document.querySelector("#quotation_action input[name='" + currentValue + "']");
            if (targetInput) {
                targetInput.classList.remove('d-none');
            }

            var targetSelect = document.querySelector("#quotation_action select[name='" + currentValue + "']");
            if (targetSelect) {
                targetSelect.classList.remove('d-none');
            }
        }
    }

    // Update bulk actions bar visibility and count - looks up elements fresh each time
    function updateBulkActions() {
        var widgetContainer = document.getElementById(widgetId);
        var quotationAction = document.getElementById('quotation_action');
        var selectedCount = document.getElementById('quotationsSelectedCount');

        if (!widgetContainer || !quotationAction) return;

        var checkedCount = widgetContainer.querySelectorAll('input[type="checkbox"]:checked:not([value="all"])').length;
        if (checkedCount > 0) {
            quotationAction.classList.remove('d-none');
            if (selectedCount) {
                var text = checkedCount === 1 ? textItemSelected : textItemsSelected;
                selectedCount.textContent = checkedCount + ' ' + text;
            }
            updateActionFields();
        } else {
            quotationAction.classList.add('d-none');
        }
    }

    // Initialize on page load
    updateActionFields();

    // Register persistent event handlers only once (survives AJAX content replacement)
    var widget = document.getElementById(widgetId);
    if (widget && !widget.hasAttribute('data-handlers-init')) {
        widget.setAttribute('data-handlers-init', 'true');

        // Checkbox change handler for bulk actions
        document.addEventListener('change', function(e) {
            var target = e.target;
            if (target.type !== 'checkbox' && !target.matches("#quotation_action select[name='action']")) return;

            var w = document.getElementById(widgetId);

            // Handle action select change
            if (target.matches("#quotation_action select[name='action']")) {
                updateActionFields();
                return;
            }

            // Handle checkbox changes
            if (!w || !w.contains(target)) return;

            if (target.value === 'all') {
                var allCheckboxes = w.querySelectorAll('input[type="checkbox"]');
                allCheckboxes.forEach(function(cb) {
                    if (cb !== target) {
                        cb.checked = target.checked;
                    }
                });
            } else if (!target.checked) {
                var allCheckbox = w.querySelector('input[value="all"]');
                if (allCheckbox) {
                    allCheckbox.checked = false;
                }
            }

            updateBulkActions();
        });

        // Lazy-load quotation invoices when collapse row is shown
        document.addEventListener('show.bs.collapse', function(e) {
            var collapseRow = e.target.closest('tr.collapse');
            var w = document.getElementById(widgetId);
            if (!collapseRow || !w || !w.contains(collapseRow)) return;

            var container = collapseRow.querySelector('.quotation-invoices-container');
            if (!container || container.hasAttribute('data-loaded')) return;

            var quotationId = container.getAttribute('data-quotation-id');
            container.setAttribute('data-loaded', 'true');

            fetch(baseUri + 'clients/quotationinvoices/' + clientId + '/' + quotationId + '/', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(response) { return response.text(); })
            .then(function(html) {
                container.innerHTML = html;
            })
            .catch(function() {
                container.innerHTML = '<div class="alert alert-danger m-3">Error loading quotation details.</div>';
                container.removeAttribute('data-loaded');
            });
        });

        // Click handler for confirmation links and invoice modal
        document.addEventListener('click', function(e) {
            var w = document.getElementById(widgetId);
            if (!w) return;

            // Handle approve quotation confirmation
            var approveBtn = e.target.closest('.approve-quotation');
            if (approveBtn && w.contains(approveBtn)) {
                e.preventDefault();
                var message = approveBtn.getAttribute('data-confirm-message') || '';
                var href = approveBtn.getAttribute('href');

                var modalEl = document.createElement('div');
                modalEl.className = 'modal fade';
                modalEl.setAttribute('tabindex', '-1');
                modalEl.innerHTML =
                    '<div class="modal-dialog modal-dialog-centered">' +
                    '<div class="modal-content">' +
                    '<div class="modal-header border-0 pb-0">' +
                    '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<?php $this->_("AppController.modal.text_close");?>"></button>' +
                    '</div>' +
                    '<div class="modal-body text-center py-4">' +
                    '<div class="mb-3"><i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i></div>' +
                    '<h5 class="modal-title mb-3"><?php $this->_("AppController.modal.text_confirm");?></h5>' +
                    '<p class="text-secondary">' + message + '</p>' +
                    '</div>' +
                    '<div class="modal-footer border-0 justify-content-center">' +
                    '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><?php $this->_("AppController.modal.btn_cancel");?></button>' +
                    '<button type="button" class="btn btn-success btn-confirm">Confirm</button>' +
                    '</div>' +
                    '</div>' +
                    '</div>';

                document.body.appendChild(modalEl);
                var modal = new bootstrap.Modal(modalEl);
                var confirmed = false;

                modalEl.querySelector('.btn-confirm').addEventListener('click', function() {
                    confirmed = true;
                    this.blur();
                    modal.hide();
                });

                modalEl.addEventListener('hidden.bs.modal', function() {
                    modalEl.remove();
                    if (confirmed) {
                        window.location = href;
                    }
                });

                modal.show();
                return;
            }

            // Handle invoice quotation modal
            var invoiceQuotationLink = e.target.closest('a.invoice_quotation');
            if (invoiceQuotationLink && w.contains(invoiceQuotationLink)) {
                e.preventDefault();
                var href = invoiceQuotationLink.getAttribute('href');

                var modal = document.getElementById('quotationInvoiceModal');
                if (!modal) {
                    modal = document.createElement('div');
                    modal.id = 'quotationInvoiceModal';
                    modal.className = 'modal fade';
                    modal.tabIndex = -1;
                    modal.innerHTML =
                        '<div class="modal-dialog modal-lg">' +
                            '<div class="modal-content">' +
                                '<div class="modal-header">' +
                                    '<h5 class="modal-title"><?php $this->_('AdminClients.quotations.option_invoice');?></h5>' +
                                    '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<?php $this->_('AppController.modal.text_close');?>"></button>' +
                                '</div>' +
                                '<div class="modal-body"></div>' +
                                '<div class="modal-footer">' +
                                    '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><?php $this->_('AppController.modal.btn_cancel');?></button>' +
                                    '<button type="button" class="btn btn-primary btn-submit"><?php $this->_('AdminClients.invoicequotation.field_submit');?></button>' +
                                '</div>' +
                            '</div>' +
                        '</div>';
                    document.body.appendChild(modal);

                    modal.querySelector('.btn-submit').addEventListener('click', function() {
                        var form = modal.querySelector('form');
                        if (form) form.submit();
                    });
                }

                var modalBody = modal.querySelector('.modal-body');
                modalBody.innerHTML =
                    '<div class="text-center py-4">' +
                        '<div class="spinner-border" role="status">' +
                            '<span class="visually-hidden">Loading...</span>' +
                        '</div>' +
                    '</div>';

                var bsModal = new bootstrap.Modal(modal);
                bsModal.show();

                fetch(href, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(response) { return response.text(); })
                .then(function(html) {
                    modalBody.innerHTML = html;

                    // Execute scripts from fetched content (innerHTML doesn't execute <script> tags)
                    modalBody.querySelectorAll('script').forEach(function(oldScript) {
                        var newScript = document.createElement('script');
                        newScript.textContent = oldScript.textContent;
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                })
                .catch(function() {
                    modalBody.innerHTML = '<div class="alert alert-danger">Error loading content.</div>';
                });
                return;
            }
        });
    }

    // Re-initialize expandable rows for AJAX-loaded widget
    document.dispatchEvent(new Event('blestaAjaxComplete'));
})();
</script>
