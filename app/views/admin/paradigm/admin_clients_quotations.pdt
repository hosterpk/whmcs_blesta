                        <?php if ($status == 'approved') { ?>
                        <a href="<?php echo $this->base_uri . 'clients/invoicequotation/' . ($quotations[$i]->client_id ?? null) . '/' . ($quotations[$i]->id ?? null) . '/';?>" class="btn btn-sm btn-outline-primary invoice_quotation" title="<?php $this->_('AdminClients.quotations.option_invoice');?>">
                            <i class="bi bi-file-earmark-text"></i>
                        </a>
