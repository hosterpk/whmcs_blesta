                        <?php if ($status == 'pending') { ?>
                        <a href="<?php echo $this->base_uri . 'clients/approvequotation/' . ($quotations[$i]->client_id ?? null) . '/' . ($quotations[$i]->id ?? null) . '/';?>" class="btn btn-sm btn-outline-success approve-quotation" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminClients.quotations.confirm_approve', true));?>" title="<?php $this->_('AdminClients.quotations.option_approve');?>">
                            <i class="bi bi-check-lg"></i>
