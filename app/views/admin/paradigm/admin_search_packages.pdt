<?php
$has_results = ($packages ?? false) && count($packages) > 0;

if (($smart_search ?? false) && !$has_results) {
    return;
}
?>
<div class="card-body pb-0">
    <h6 class="form-section-header"><?php $this->_('AdminSearch.packages.heading');?></h6>
</div>
<?php if ($has_results) { ?>
<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th><?php $this->_('AdminSearch.packages.heading_package_id');?></th>
                <th><?php $this->_('AdminSearch.packages.heading_name');?></th>
                <th><?php $this->_('AdminSearch.packages.heading_module');?></th>
                <th><?php $this->_('AdminSearch.packages.heading_quantity');?></th>
                <th><?php $this->_('AdminSearch.packages.heading_status');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $num_packages = count($packages);
            for ($i = 0; $i < $num_packages; $i++) {
            ?>
            <tr>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'packages/edit/' . ($packages[$i]->id ?? null) . '/');?>">
                        <?php echo $this->Html->safe($packages[$i]->id_code ?? null);?>
                    </a>
                </td>
                <td><?php echo $this->Html->safe($packages[$i]->name ?? null);?></td>
                <td><?php echo $this->Html->safe($packages[$i]->module_name ?? null);?></td>
                <td><?php echo $this->Html->safe($packages[$i]->qty ?? null);?></td>
                <td><?php echo ($package_status[$packages[$i]->status] ?? null);?></td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php } else { ?>
<div class="text-center py-5 text-muted">
    <i class="bi bi-box-seam" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminSearch.packages.no_results');?></p>
</div>
<?php } ?>
