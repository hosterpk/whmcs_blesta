            <?php
            if ((isset($plugin_actions) ? $plugin_actions : null)) {
                foreach ($plugin_actions as $plugin_action) {
                    $icon = (isset($plugin_action->options['icon']) ? $plugin_action->options['icon'] : null);
                    $icon_class = 'bi-puzzle';
                    if (!empty($icon) && strpos($icon, 'fa-') !== 0) {
                        $icon_class = $icon;
                    }
                    ?>
                    <a href="<?php echo $this->Html->safe($this->base_uri . $plugin_action->url . (isset($client->id) ? $client->id : null));?>" class="side-content-link hidden-action" data-action-id="plugin-<?php echo $this->Html->safe($plugin_action->url . $client->id);?>">
