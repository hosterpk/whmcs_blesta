<?php
$js_contacts = (isset($js_contacts) ? $js_contacts : null);
$this->Javascript->setInline("
document.addEventListener('DOMContentLoaded', function() {
    var contacts = " . (isset($js_contacts) ? $js_contacts : 'null') . ";
    var contactSelect = document.getElementById('contact_id');
    var countrySelect = document.getElementById('country');
    var stateSelect = document.getElementById('state');
    var pendingState = null;

    if (contactSelect) {
        contactSelect.addEventListener('change', function() {
            if (this.value !== '' && this.value !== 'none') {
                // Populate contacts data onto form
                var selectedContact = null;
                if (contacts) {
                    for (var id in contacts) {
                        if (contacts[id].id == this.value) {
                            selectedContact = contacts[id];
                            break;
                        }
                    }
                }

                if (selectedContact) {
                    var firstName = document.getElementById('first_name');
                    var lastName = document.getElementById('last_name');
                    var address1 = document.getElementById('address1');
                    var address2 = document.getElementById('address2');
                    var city = document.getElementById('city');
                    var zip = document.getElementById('zip');

                    if (firstName) firstName.value = selectedContact.first_name || '';
                    if (lastName) lastName.value = selectedContact.last_name || '';
                    if (address1) address1.value = selectedContact.address1 || '';
                    if (address2) address2.value = selectedContact.address2 || '';
                    if (city) city.value = selectedContact.city || '';
                    if (zip) zip.value = selectedContact.zip || '';

                    if (countrySelect) {
                        // Store the desired state so the fetch callback can apply it
                        pendingState = selectedContact.state || null;
                        countrySelect.value = selectedContact.country || '';
                        var event = new Event('change', {bubbles: true});
                        countrySelect.dispatchEvent(event);
                    }
                }
            }
        });
    }

    if (countrySelect) {
        countrySelect.addEventListener('change', function() {
            var country = this.value;
            fetch('" . $this->Html->safe($this->base_uri . 'clients/getstates/') . "' + country, {
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(response => response.json())
            .then(data => {
                if (stateSelect && data) {
                    stateSelect.innerHTML = '';
                    Object.keys(data).sort().forEach(function(key) {
                        var option = document.createElement('option');
                        option.value = key;
                        option.textContent = data[key];
                        stateSelect.appendChild(option);
                    });

                    // Apply the pending state from contact copy
                    if (pendingState) {
                        stateSelect.value = pendingState;
                        pendingState = null;
                    }
                }
            })
            .catch(error => console.error('Error fetching states:', error));
        });
    }
});
");
?>
