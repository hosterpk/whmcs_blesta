<script>
(function() {
    var widgetContainer = document.getElementById('admin_clients');

    function initBulkActions() {
        if (!widgetContainer) {
            widgetContainer = document.getElementById('admin_clients');
        }
        if (!widgetContainer) return;

        var bulkActionsBar = widgetContainer.querySelector('#bulkActionsBar');
        var selectedCount = widgetContainer.querySelector('#selectedCount');
        var selectAllCheckbox = widgetContainer.querySelector('#select-all');
        var actionSelect = widgetContainer.querySelector('#action_select');

        function updateBulkActions() {
            var checkedBoxes = widgetContainer.querySelectorAll('.row-checkbox:checked');
            if (bulkActionsBar) {
                if (checkedBoxes.length > 0) {
                    bulkActionsBar.style.display = 'block';
                    if (selectedCount) {
                        selectedCount.textContent = checkedBoxes.length + ' <?php $this->_('AdminClients.index.items_selected');?>';
                    }
                } else {
                    bulkActionsBar.style.display = 'none';
                }
            }
        }

        function syncActionValue() {
            var hiddenField = widgetContainer.querySelector('#action_value_hidden');
            if (!hiddenField || !actionSelect) return;
            var visibleGroup = widgetContainer.querySelector('#' + actionSelect.value + '_options');
            if (visibleGroup) {
                var visibleSelect = visibleGroup.querySelector('.action-value-field');
                if (visibleSelect) {
                    hiddenField.value = visibleSelect.value;
                }
            }
        }

        function switchClientActions() {
            if (!actionSelect) return;
            var action = actionSelect.value;
            var optionGroups = widgetContainer.querySelectorAll('.bulk-action-options');
            optionGroups.forEach(function(group) {
                group.classList.add('d-none');
            });
            var targetOptions = widgetContainer.querySelector('#' + action + '_options');
            if (targetOptions) {
                targetOptions.classList.remove('d-none');
            }
            syncActionValue();
        }

        // Event delegation on the widget container
        widgetContainer.addEventListener('change', function(e) {
            var target = e.target;

            // Select all checkbox
            if (target.id === 'select-all') {
                var checkboxes = widgetContainer.querySelectorAll('.row-checkbox');
                checkboxes.forEach(function(checkbox) {
                    checkbox.checked = target.checked;
                });
                updateBulkActions();
                return;
            }

            // Individual row checkbox
            if (target.classList.contains('row-checkbox')) {
                if (!target.checked && selectAllCheckbox) {
                    selectAllCheckbox.checked = false;
                }
                updateBulkActions();
                return;
            }

            // Action dropdown
            if (target.id === 'action_select') {
                switchClientActions();
                return;
            }

            // Sub-field value changed — sync to hidden field
            if (target.classList.contains('action-value-field')) {
                syncActionValue();
                return;
            }
        });

        // Sync hidden field on form submit
        var clientsForm = widgetContainer.querySelector('#clients_form');
        if (clientsForm) {
            clientsForm.addEventListener('submit', function() {
                syncActionValue();
            });
        }

        // Initialize action visibility
        if (actionSelect) {
            switchClientActions();
        }
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBulkActions);
    } else {
        initBulkActions();
    }

    // Re-initialize after AJAX content replacement
    document.addEventListener('blestaAjaxComplete', function() {
        widgetContainer = document.getElementById('admin_clients');
        initBulkActions();
    });
})();
</script>
