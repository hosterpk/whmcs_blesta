<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var countrySelect = document.getElementById('country');
    var stateSelect = document.getElementById('state');
    var enableLogin = document.getElementById('enable_login');
    var loginFields = document.querySelectorAll('.login-fields');

    function toggleLoginFields() {
        if (enableLogin && enableLogin.checked) {
            loginFields.forEach(function(field) {
                field.style.display = '';
            });
        } else {
            loginFields.forEach(function(field) {
                field.style.display = 'none';
            });
        }
    }

    // Initial state
    toggleLoginFields();

    // Country change
    if (countrySelect) {
        countrySelect.addEventListener('change', function() {
            var country = this.value;
            fetch(baseUri + 'clients/getstates/' + country, {
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(response => response.json())
            .then(data => {
                if (stateSelect && data) {
                    stateSelect.innerHTML = '';
                    Object.keys(data).sort().forEach(function(key) {
                        var option = document.createElement('option');
                        option.value = key;
                        option.textContent = data[key];
                        stateSelect.appendChild(option);
                    });
                }
            })
            .catch(error => console.error('Error fetching states:', error));
        });
    }

    // Enable login toggle
    if (enableLogin) {
        enableLogin.addEventListener('change', toggleLoginFields);
    }
});
</script>
