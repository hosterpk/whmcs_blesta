<?php /** @var View $this **/ ?>

<?php
echo (isset($message) ? $message : null);

$this->Form->create(null, ['id' => 'showCardForm']);
?>
<div class="mb-3">
    <?php
    $this->Form->label($passphrase_required ? $this->_('AdminClients.showcard.field_passphrase', true) : $this->_('AdminClients.showcard.field_staff_password', true), 'passphrase', ['class' => 'form-label']);
    $this->Form->fieldPassword('passphrase', ['id' => 'passphrase', 'class' => 'form-control']);
    ?>
</div>
<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><?php $this->_('AppController.modal.text_close');?></button>
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminClients.showcard.field_submit', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Form->end();
?>
