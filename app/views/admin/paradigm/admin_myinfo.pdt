<style>
/* QR Code Card Styling */
.qr-code-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
}

.qr-code-container {
    display: inline-block;
    background: white;
    padding: 1rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.qr-code-image {
    display: block;
    width: 200px;
    height: 200px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Bootstrap tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Two Factor Authentication Toggle
    const twoFactorMode = document.getElementById('two_factor_mode');
    const totpSection = document.getElementById('totpSection');
    const factorKey = document.getElementById('factor_key');
    const factorPin = document.getElementById('factor_pin');
    const factorOtp = document.getElementById('factor_otp');
    const qrCodeSection = document.getElementById('qr_code_section');

    function toggleTwoFactorFields() {
        const selectedValue = twoFactorMode.value;

        switch(selectedValue) {
            case 'motp':
                totpSection.style.display = 'block';
                qrCodeSection.style.display = 'none';
                factorPin.style.display = 'block';
                factorKey.style.display = 'block';
                factorOtp.style.display = 'block';
                break;
            case 'totp':
                totpSection.style.display = 'block';
                qrCodeSection.style.display = 'block';
                factorKey.style.display = 'block';
                factorPin.style.display = 'none';
                factorOtp.style.display = 'block';
                break;
            case 'none':
            default:
                totpSection.style.display = 'none';
                break;
        }
    }

    twoFactorMode.addEventListener('change', toggleTwoFactorFields);
    toggleTwoFactorFields();

    // Profile Picture Upload
    const avatarInput = document.getElementById('avatar');
    const profileImagePreview = document.getElementById('profileImagePreview');
    const previewContainer = document.getElementById('previewContainer');
    const removeProfileImageBtn = document.getElementById('removeProfileImageBtn');
    const removeAvatarInput = document.getElementById('remove_avatar');

    // Image preview on file selection
    avatarInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function(e) {
                profileImagePreview.src = e.target.result;
                profileImagePreview.style.display = 'block';
                previewContainer.classList.remove('file-preview-empty');
                previewContainer.classList.add('has-image');
                removeProfileImageBtn.style.display = 'inline-block';
                removeAvatarInput.value = '0';
            };
            reader.readAsDataURL(file);
        }
    });

    // Remove image functionality
    removeProfileImageBtn.addEventListener('click', function() {
        avatarInput.value = '';
        profileImagePreview.src = '';
        profileImagePreview.style.display = 'none';
        previewContainer.classList.add('file-preview-empty');
        previewContainer.classList.remove('has-image');
        removeProfileImageBtn.style.display = 'none';
        removeAvatarInput.value = '1';
    });
});
</script>
