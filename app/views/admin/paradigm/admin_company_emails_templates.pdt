<?php /** @var View $this **/ ?>

<?php
// Build tabs array for email template groups
$tabs = [];
if (!empty($groups)) {
    // Get the active tab from URL or default to first group
    $group_types = array_keys($groups);
    $active_type = isset($_GET['type']) && isset($groups[$_GET['type']]) ? $_GET['type'] : $group_types[0];

    foreach ($groups as $type => $templates) {
        $tabs[] = [
            'name' => $this->_('AdminCompanyEmails.templates.heading_' . $type, true),
            'current' => ($type == $active_type),
            'attributes' => [
                'href' => $this->base_uri . 'settings/company/emails/templates/?type=' . $this->Html->safe($type)
            ]
        ];
    }
}

$this->Widget->clear();
$this->Widget->setTabs($tabs);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminCompanyEmails.templates.boxtitle_templates', true), ['id' => 'admin_company_emails_templates'], ($render_section ?? null));
?>
    <?php
    if (!empty($groups)) {
    ?>
    <?php
    $this->Form->create(null, ['id' => 'templates', 'class' => 'disable-on-submit']);
    ?>
    <?php
    // Display templates for the active tab
        $templates = $groups[$active_type];
        if (!empty($templates)) {
        ?>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width: 50px;" class="text-center">
                            <?php $this->Form->fieldCheckbox('template_id[]', 'all', false, ['class' => 'form-check-input select-all']);?>
                        </th>
                        <th style="width: 40px;"></th>
                        <th><?php $this->_('AdminCompanyEmails.templates.text_name');?></th>
                        <?php
                        // Show plugin column if set
                        if ($active_type == 'plugins') {
                        ?>
                        <th><?php $this->_('AdminCompanyEmails.templates.text_plugin');?></th>
                        <?php
                        }
                        ?>
                        <th><?php $this->_('AdminCompanyEmails.templates.text_description');?></th>
                        <th style="width: 60px;"><?php $this->_('AdminCompanyEmails.templates.text_options');?></th>
                    </tr>
                </thead>
                <tbody>
                <?php
                // Display templates for this group
                for ($i = 0, $num_templates = count($templates); $i < $num_templates; $i++) {
                    $icon = (($templates[$i]->status ?? null) == 'active') ? 'check-circle' : 'slash-circle';
                    $icon_color = (($templates[$i]->status ?? null) == 'active') ? 'text-success' : 'text-muted';
                ?>
                    <tr>
                        <td class="text-center">
                            <?php $this->Form->fieldCheckbox('template_id[]', ($templates[$i]->email_group_id ?? null), in_array(($templates[$i]->email_group_id ?? null), $vars->template_id ?? []), ['class' => 'form-check-input template-checkbox']);?>
                        </td>
                        <td class="text-center">
                            <i class="bi bi-<?php echo $this->Html->safe($icon);?> <?php echo $icon_color;?>"></i>
                        </td>
                        <td>
                            <a href="<?php echo $this->base_uri . 'settings/company/emails/edittemplate/' . $this->Html->safe($templates[$i]->email_group_id ?? '') . '/';?>">
                                <?php echo $this->Html->safe($templates[$i]->group_name ?? '');?>
                            </a>
                        </td>
                        <?php
                        // Show plugin name if set
                        if ($active_type == 'plugins') {
                        ?>
                        <td><?php echo $this->Html->safe($templates[$i]->plugin_name ?? '');?></td>
                        <?php
                        }
                        ?>
                        <td><?php echo $this->Html->safe($templates[$i]->group_desc ?? '');?></td>
                        <td>
                            <a href="<?php echo $this->base_uri . 'settings/company/emails/edittemplate/' . $this->Html->safe($templates[$i]->email_group_id ?? '') . '/';?>"
                               class="btn btn-sm btn-outline-secondary"
                               data-bs-toggle="tooltip"
                               title="<?php echo $this->Html->safe($this->_('AdminCompanyEmails.templates.option_edit', true));?>">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
        </div>
        <?php
        } else {
        ?>
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminCompanyEmails.templates.no_results');?></p>
        </div>
        <?php
        }
        ?>

    <!-- Bulk Actions Bar -->
    <div class="bulk-actions-bar" id="template_action" style="display: none;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="selected-count" id="selectedCount">0 <?php $this->_('AdminCompanyEmails.templates.text_items_selected');?></span>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <?php
                $this->Form->fieldSelect('action', ($template_actions ?? null), ($vars->type ?? null), ['id' => 'action', 'class' => 'form-select form-select-sm', 'style' => 'width: 180px;']);
                ?>

                <!-- From Field (for from_email/from_name actions) -->
                <div id="from_field" class="bulk-action-fields d-none d-flex">
                    <?php
                    $this->Form->fieldText('from', ($vars->from ?? null), ['id' => 'from', 'class' => 'form-control form-control-sm', 'style' => 'width: 200px;', 'placeholder' => $this->_('AdminCompanyEmails.templates.text_from', true)]);
                    ?>
                </div>

                <!-- Template Field (for html_template action) -->
                <div id="template_field" class="bulk-action-fields d-none d-flex">
                    <?php
                    $this->Form->fieldSelect('email_template_group_id', ($html_templates ?? null), ($vars->email_template_group_id ?? null), ['id' => 'email_template_group_id', 'class' => 'form-select form-select-sm', 'style' => 'width: 200px;']);
                    ?>
                </div>

                <button type="submit" name="save" class="btn btn-sm btn-primary">
                    <i class="bi bi-check-lg me-1"></i><?php $this->_('AdminCompanyEmails.templates.field_templatesubmit');?>
                </button>
            </div>
        </div>
    </div>

    <?php
    $this->Form->end();
    } else {
    ?>
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminCompanyEmails.templates.no_results');?></p>
        </div>
    <?php
    }
    ?>
<?php
$this->Widget->end();
?>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var templatesForm = document.getElementById('templates');
    var templateAction = document.getElementById('template_action');
    var selectedCount = document.getElementById('selectedCount');
    var actionSelect = document.getElementById('action');
    var fromField = document.getElementById('from_field');
    var templateField = document.getElementById('template_field');

    if (!templatesForm || !templateAction || !actionSelect) return;

    // Handle individual checkbox clicks
    templatesForm.addEventListener('click', function(e) {
        if (e.target && e.target.type === 'checkbox') {
            var table = e.target.closest('table');

            // Handle "select all" checkbox
            if (e.target.classList.contains('select-all')) {
                var checkboxes = table.querySelectorAll('.template-checkbox');
                checkboxes.forEach(function(checkbox) {
                    checkbox.checked = e.target.checked;
                });
            } else if (e.target.classList.contains('template-checkbox')) {
                // Uncheck "select all" if any individual checkbox is unchecked
                if (!e.target.checked) {
                    var selectAll = table.querySelector('.select-all');
                    if (selectAll) {
                        selectAll.checked = false;
                    }
                }
            }

            // Show/hide action section based on checkbox selection
            updateActionVisibility();
        }
    });

    // Update action section visibility and selected count
    function updateActionVisibility() {
        var checkedBoxes = templatesForm.querySelectorAll('.template-checkbox:checked');
        var count = checkedBoxes.length;

        if (count > 0) {
            templateAction.style.display = 'block';
            selectedCount.textContent = count + ' <?php $this->_('AdminCompanyEmails.templates.text_items_selected');?>';
        } else {
            templateAction.style.display = 'none';
        }
    }

    // Toggle action related fields
    function toggleFields() {
        var actionValue = actionSelect.value;

        // Hide all conditional fields first
        fromField.classList.add('d-none');
        templateField.classList.add('d-none');

        if (actionValue === 'from_email' || actionValue === 'from_name') {
            fromField.classList.remove('d-none');
        } else if (actionValue === 'html_template') {
            templateField.classList.remove('d-none');
        }
    }

    // Initialize visibility on page load
    updateActionVisibility();
    toggleFields();

    // Handle action select change
    actionSelect.addEventListener('change', toggleFields);

    // Initialize Bootstrap tooltips
    var tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>
