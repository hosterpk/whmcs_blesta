<?php /** @var View $this **/ ?>

<?php
if (($invoices ?? false) && ($num_invoices = count($invoices)) > 0) {
?>
<div class="p-3">
    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th style="width: 40px;"><i class="bi bi-arrow-return-right"></i></th>
                <th><?php $this->_('AdminClients.quotationinvoices.headingexpand_invoice');?></th>
                <th><?php $this->_('AdminClients.quotationinvoices.headingexpand_amount');?></th>
                <th><?php $this->_('AdminClients.quotationinvoices.headingexpand_paid');?></th>
                <th><?php $this->_('AdminClients.quotationinvoices.headingexpand_date_billed');?></th>
                <th style="width: 80px;"><?php $this->_('AdminClients.quotationinvoices.headingexpand_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_invoices; $i++) {
            ?>
            <tr>
                <td>&nbsp;</td>
                <td><?php (print (isset($invoices[$i]->id_code) ? $this->Html->safe($invoices[$i]->id_code) : null));?></td>
                <td><?php echo $this->CurrencyFormat->format((isset($invoices[$i]->total) ? $this->Html->safe($invoices[$i]->total) : null), (isset($invoices[$i]->currency) ? $this->Html->safe($invoices[$i]->currency) : null), ['html_code' => true]);?></td>
                <td><?php echo $this->CurrencyFormat->format((isset($invoices[$i]->paid) ? $this->Html->safe($invoices[$i]->paid) : null), (isset($invoices[$i]->currency) ? $this->Html->safe($invoices[$i]->currency) : null), ['html_code' => true]);?></td>
                <td><?php echo $this->Date->cast((isset($invoices[$i]->date_billed) ? $this->Html->safe($invoices[$i]->date_billed) : null), 'date_time');?></td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/editinvoice/' . ($client->id ?? null) . '/' . ($invoices[$i]->id ?? null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminClients.quotationinvoices.option_view');?>">
                        <i class="bi bi-eye"></i>
                    </a>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php
} else {
?>
<div class="text-center py-4 text-muted">
    <p class="mb-0"><?php $this->_('AdminClients.quotationinvoices.invoices_no_results');?></p>
</div>
<?php
}
?>
