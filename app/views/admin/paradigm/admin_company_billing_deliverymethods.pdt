        <?php $this->Form->end(); ?>
    <?php $this->Widget->end(); ?>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    const replyEnvelopeCheckbox = document.getElementById('postalmethods_replyenvelope');
    const returnCountrySelect = document.getElementById('postalmethods_return_country');

    // Show/hide return address fields based on reply envelope checkbox
    if (replyEnvelopeCheckbox) {
        replyEnvelopeCheckbox.addEventListener('change', function() {
            const returnFields = document.querySelectorAll('.postalmethods_return');
            returnFields.forEach(field => {
                field.style.display = this.checked ? 'block' : 'none';
            });
        });
        // Trigger on page load
        replyEnvelopeCheckbox.dispatchEvent(new Event('change'));
    }

    // Load states when country changes
    if (returnCountrySelect) {
        returnCountrySelect.addEventListener('change', function() {
            const countryCode = this.value;
            const stateSelect = document.getElementById('postalmethods_return_state');

            if (stateSelect) {
                fetch('<?php echo $this->Html->safe($this->base_uri . 'settings/company/taxes/getstates/');?>' + countryCode)
                    .then(response => response.json())
                    .then(data => {
                        // Remove all existing options
                        stateSelect.innerHTML = '';

                        // Sort and add new options
                        const sortedData = Object.entries(data).sort((a, b) => a[1].localeCompare(b[1]));
                        sortedData.forEach(([key, value]) => {
                            const option = new Option(value, key);
                            stateSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Error loading states:', error));
            }
        });
    }
});
</script>
