<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips for elements currently in DOM
    const invoicesTable = document.getElementById('invoices');
    if (invoicesTable) {
        const tooltipTriggerList = invoicesTable.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
    }
});

// Lazy-load invoice details when expandable row opens
document.addEventListener('show.bs.collapse', function(e) {
    var container = e.target.querySelector('.invoice-applied-container');
    if (!container) return;

    var invoiceId = container.getAttribute('data-invoice-id');
    if (!invoiceId || container.hasAttribute('data-loaded')) return;

    fetch('<?php echo $this->base_uri;?>billing/invoiceapplied/' + invoiceId, {
        headers: {'X-Requested-With': 'XMLHttpRequest'}
    })
    .then(function(response) {
        if (!response.ok) throw new Error('HTTP error ' + response.status);
        return response.text();
    })
    .then(function(html) {
        container.innerHTML = html;
        container.setAttribute('data-loaded', 'true');
    })
    .catch(function(error) {
        container.innerHTML = '<div class="alert alert-danger m-3">Error loading invoice details.</div>';
    });
});
</script>
