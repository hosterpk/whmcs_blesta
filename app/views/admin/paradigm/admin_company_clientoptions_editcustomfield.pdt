<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    const form = document.getElementById('edit-custom-field');
    const typeSelect = document.getElementById('type');
    const requiredSelect = document.getElementById('required');
    const showClientCheckbox = document.getElementById('show_client');
    const configWarning = document.getElementById('configuration_warning');

    // Update form fields before submission
    form.addEventListener('submit', function() {
        updateFieldOrder();
    });

    // Show/hide custom regex field
    function updateRegexVisibility() {
        const regexEnabled = document.querySelector('.regex_enabled');
        if (requiredSelect.value !== 'regex') {
            regexEnabled.style.display = 'none';
        } else {
            regexEnabled.style.display = 'block';
        }
    }

    // Show the selected type
    function showType(value) {
        hideAllTypes();

        switch (value) {
            case 'checkbox':
                document.querySelectorAll('.checkbox-type').forEach(el => el.style.display = 'block');
                break;
            case 'select':
                document.querySelectorAll('.select-type').forEach(el => el.style.display = 'block');
                break;
            case 'text':
                document.querySelectorAll('.text-type').forEach(el => el.style.display = 'block');
                break;
            case 'textarea':
                document.querySelectorAll('.textarea-type').forEach(el => el.style.display = 'block');
                break;
        }
    }

    // Hides all custom field types
    function hideAllTypes() {
        document.querySelectorAll('.checkbox-type, .select-type, .text-type, .textarea-type').forEach(el => {
            el.style.display = 'none';
        });
    }

    // Update the Select rows
    function updateRows() {
        const rows = document.querySelectorAll('.select-type table tr.select_row');
        rows.forEach((row, index) => {
            if (index % 2 === 1) {
                row.classList.add('table-secondary');
            } else {
                row.classList.remove('table-secondary');
            }
        });
    }

    // Set option indices for each row
    function updateFieldOrder() {
        const rows = document.querySelectorAll('#edit-custom-field table tr.select_row');
        rows.forEach((row, rowIndex) => {
            const inputs = row.querySelectorAll('input');
            inputs.forEach(input => {
                input.name = input.name.replace('[]', '[' + rowIndex + ']');
            });
        });
    }

    // Display warning message when the field is marked as both required and not visible
    function updateConfigWarning() {
        if (requiredSelect.value !== '' && !showClientCheckbox.checked) {
            configWarning.style.display = 'block';
        } else {
            configWarning.style.display = 'none';
        }
    }

    // Initialize
    updateRegexVisibility();
    showType(typeSelect.value);
    updateRows();
    updateConfigWarning();

    // Event listeners
    requiredSelect.addEventListener('change', function() {
        updateRegexVisibility();
        updateConfigWarning();
    });

    typeSelect.addEventListener('change', function() {
        showType(this.value);
    });

    showClientCheckbox.addEventListener('change', updateConfigWarning);

    // Add select row
    document.addEventListener('click', function(e) {
        if (e.target.closest('.select_row_add')) {
            e.preventDefault();
            const firstRow = document.querySelector('tr.select_row');
            const newRow = firstRow.cloneNode(true);

            // Clear input values and uncheck radio
            newRow.querySelectorAll('input[type=text]').forEach(input => input.value = '');
            newRow.querySelectorAll('input[type=radio]').forEach(input => input.checked = false);

            // Add the new row
            const lastRow = document.querySelector('tr.select_row:last-of-type');
            lastRow.parentNode.insertBefore(newRow, lastRow.nextSibling);
            updateRows();
        }
    });

    // Remove select row
    document.addEventListener('click', function(e) {
        if (e.target.closest('.select_row_remove')) {
            e.preventDefault();
            const rows = document.querySelectorAll('tr.select_row');
            if (rows.length > 1) {
                e.target.closest('tr').remove();
                updateRows();
            }
        }
    });
});
</script>
