<?php /** @var View $this **/ ?>


<?php
if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>
<?php
}
$this->Widget->clear();
$this->Widget->setTabs([
    [
        'name' => $this->_('AdminSystemStaff.manage.category_active', true),
        'current' => ((isset($status) ? $status : null) == 'active'),
        'attributes' => [
            'href' => $this->base_uri . 'settings/system/staff/manage/active/'
        ]
    ],
    [
        'name' => $this->_('AdminSystemStaff.manage.category_inactive', true),
        'current' => ((isset($status) ? $status : null) == 'inactive'),
        'attributes' => [
            'href' => $this->base_uri . 'settings/system/staff/manage/inactive/'
        ]
    ]
]);
$this->Widget->setLinkButtons([
    [
        'name' => '',
        'icon' => 'bi-plus-lg',
        'attributes' => [
            'href' => $this->base_uri . 'settings/system/staff/add/',
            'title' => $this->_('AdminSystemStaff.manage.categorylink_addstaff', true)
        ]
    ]
]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminSystemStaff.manage.boxtitle_manage', true), ['id' => 'admin_system_staff_manage'], ($render_section ?? null));
?>

        <?php if ((isset($staff) ? $staff : false) && ($num_staff = count($staff)) > 0) { ?>
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="staff">
                    <thead>
                        <tr>
                            <th>
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/staff/manage/' . (isset($status) ? $status : null) . '/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>"
                                   class="ajax text-decoration-none<?php echo $sort == 'first_name' ? ' ' . $order : '';?>">
                                    <?php $this->_('AdminSystemStaff.manage.heading_name');?>
                                    <?php if ($sort == 'first_name') { ?>
                                        <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                    <?php } ?>
                                </a>
                            </th>
                            <th>
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/system/staff/manage/' . (isset($status) ? $status : null) . '/?sort=email&order=' . ($sort == 'email' ? $negate_order : $order));?>"
                                   class="ajax text-decoration-none<?php echo $sort == 'email' ? ' ' . $order : '';?>">
                                    <?php $this->_('AdminSystemStaff.manage.heading_email');?>
                                    <?php if ($sort == 'email') { ?>
                                        <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                    <?php } ?>
                                </a>
                            </th>
                            <th class="text-end"><?php $this->_('AdminSystemStaff.manage.heading_options');?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php for ($i = 0; $i < $num_staff; $i++) { ?>
                        <tr>
                            <td><?php echo $this->Html->concat(' ', (isset($staff[$i]->first_name) ? $this->Html->safe($staff[$i]->first_name) : null), (isset($staff[$i]->last_name) ? $this->Html->safe($staff[$i]->last_name) : null));?></td>
                            <td><?php echo $this->Html->safe($staff[$i]->email);?></td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="<?php echo $this->base_uri . 'settings/system/staff/edit/' . $this->Html->safe($staff[$i]->id) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminSystemStaff.manage.option_edit');?>">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <?php
                                    if ($status == 'active') {
                                        // Do not show the deactivate link for the current staff user
                                        if ((isset($staff_id) ? $staff_id : null) != (isset($staff[$i]->id) ? $staff[$i]->id : null)) {
                                            $this->Form->create($this->base_uri . 'settings/system/staff/status/', ['class' => 'd-inline']);
                                            $this->Form->fieldHidden('id', (isset($staff[$i]->id) ? $staff[$i]->id : null));
                                            $this->Form->fieldHidden('status', 'inactive');
                                    ?>
                                        <button type="button" class="btn btn-sm btn-outline-warning modal-confirm-warning"
                                           data-confirm-message="<?php echo $this->Html->safe($this->_('AdminSystemStaff.manage.confirm_deactivate', true));?>"
                                           data-confirm-title="<?php $this->_('AdminSystemStaff.manage.option_deactivate');?>"
                                           data-confirm-button="<?php $this->_('AdminSystemStaff.manage.option_deactivate');?>"
                                           title="<?php $this->_('AdminSystemStaff.manage.option_deactivate');?>">
                                            <i class="bi bi-ban"></i>
                                        </button>
                                    <?php
                                            $this->Form->end();
                                        }
                                    } else {
                                        $this->Form->create($this->base_uri . 'settings/system/staff/status/', ['class' => 'd-inline']);
                                        $this->Form->fieldHidden('id', (isset($staff[$i]->id) ? $staff[$i]->id : null));
                                        $this->Form->fieldHidden('status', 'active');
                                    ?>
                                    <button type="button" class="btn btn-sm btn-outline-success modal-confirm-success"
                                       data-confirm-message="<?php echo $this->Html->safe($this->_('AdminSystemStaff.manage.confirm_reactivate', true));?>"
                                       data-confirm-title="<?php $this->_('AdminSystemStaff.manage.option_reactivate');?>"
                                       data-confirm-button="<?php $this->_('AdminSystemStaff.manage.option_reactivate');?>"
                                       title="<?php $this->_('AdminSystemStaff.manage.option_reactivate');?>">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                    <?php
                                        $this->Form->end();
                                    }
                                    ?>
                                </div>
                            </td>
                        </tr>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php } else { ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminSystemStaff.manage.no_results');?></p>
            </div>
        <?php } ?>
<?php
$this->Widget->end();

if (!(isset($is_ajax) ? $is_ajax : false)) {
?>
</div>
<?php
}
?>
