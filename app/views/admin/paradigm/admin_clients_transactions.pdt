                        <?php $this->_('AdminClients.transactions.heading_applied');?>
                        <?php if ($sort == 'applied_amount') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/transactions/' . ($client->id ?? null) . '/' . ($status ?? null) . '/?sort=transaction_id&order=' . ($sort == 'transaction_id' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminClients.transactions.heading_number');?>
                        <?php if ($sort == 'transaction_id') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/transactions/' . ($client->id ?? null) . '/' . ($status ?? null) . '/?sort=reference_id&order=' . ($sort == 'reference_id' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminClients.transactions.heading_reference_id');?>
                        <?php if ($sort == 'reference_id') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/transactions/' . ($client->id ?? null) . '/' . ($status ?? null) . '/?sort=date_added&order=' . ($sort == 'date_added' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminClients.transactions.heading_date');?>
                        <?php if ($sort == 'date_added') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th class="text-end" style="width: 80px;"><?php $this->_('AdminClients.transactions.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_transactions; $i++) {
                if (($transactions[$i]->type ?? null) == 'other' && ($transactions[$i]->gateway_type ?? null) == 'nonmerchant') {
                    $trans_type = $transactions[$i]->gateway_name;
                } else {
                    $raw_type = (($transactions[$i]->type_name ?? '') != '' ? $transactions[$i]->type_name : $transactions[$i]->type);
                    $trans_type = $transaction_types[$raw_type] ?? null;
                }
            ?>
            <tr style="cursor: pointer;" data-collapse-row aria-expanded="false">
                <td><?php echo $this->Html->safe($trans_type ?? null);?></td>
                <td><?php echo $this->CurrencyFormat->format(($transactions[$i]->amount ?? null), ($transactions[$i]->currency ?? null), ['html_code' => true]);?></td>
                <td><?php echo $this->CurrencyFormat->format(($transactions[$i]->credited_amount ?? null), ($transactions[$i]->currency ?? null), ['html_code' => true]);?></td>
                <td><?php echo $this->CurrencyFormat->format(($transactions[$i]->applied_amount ?? null), ($transactions[$i]->currency ?? null), ['html_code' => true]);?></td>
                <td><?php echo $this->Html->safe($transactions[$i]->transaction_id ?? null);?></td>
                <td><?php echo $this->Html->safe($transactions[$i]->reference_id ?? null);?></td>
                <td><?php echo $this->Date->cast(($transactions[$i]->date_added ?? null), 'date_time');?></td>
                <td class="text-end">
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/edittransaction/' . ($client->id ?? null) . '/' . ($transactions[$i]->id ?? null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminClients.transactions.option_edit');?>">
                        <i class="bi bi-pencil"></i>
                    </a>
                </td>
            </tr>
            <tr class="collapse" id="transaction-details-<?php echo $this->Html->safe($transactions[$i]->id ?? null);?>">
                <td colspan="8" style="padding: 0; background-color: var(--bg-secondary);">
                    <div class="transaction-applied-container" data-transaction-id="<?php echo $this->Html->safe($transactions[$i]->id ?? null);?>">
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-secondary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>
<?php
    if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        $this->Widget->footer();
        $this->Pagination->build();
    }
} else {
?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-receipt" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminClients.transactions.no_results');?></p>
</div>
<?php
}

$this->Widget->end();
?>

<script type="text/javascript">
(function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var clientId = <?php echo json_encode($client->id ?? null);?>;

    // Lazy-load transaction details when expandable row opens
    document.addEventListener('show.bs.collapse', function(e) {
        var container = e.target.querySelector('.transaction-applied-container');
        if (!container) return;

        var transactionId = container.getAttribute('data-transaction-id');
        if (!transactionId || container.hasAttribute('data-loaded')) return;

        fetch(baseUri + 'clients/transactionapplied/' + clientId + '/' + transactionId + '/', {
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) {
            if (!response.ok) throw new Error('HTTP error ' + response.status);
            return response.text();
        })
        .then(function(html) {
            container.innerHTML = html;
            container.setAttribute('data-loaded', 'true');
        })
        .catch(function(error) {
            container.innerHTML = '<div class="alert alert-danger m-3">Error loading transaction details.</div>';
        });
    });

    // Notify expandable-rows.js when loaded via AJAX
    if (document.readyState !== 'loading') {
        document.dispatchEvent(new Event('blestaAjaxComplete'));
    }
})();
</script>
