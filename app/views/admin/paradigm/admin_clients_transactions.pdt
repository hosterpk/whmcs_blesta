    ['name' => $this->_('AdminClients.transactions.category_error', true) . '<span class="badge bg-secondary ms-2">' . ($status_count['error'] ?? 0) . '</span>', 'current' => ($status ?? null) == 'error', 'highlight' => true, 'attributes' => ['href' => $this->base_uri . 'clients/transactions/' . ($client->id ?? null) . '/error/', 'class' => 'ajax']],
    ['name' => $this->_('AdminClients.transactions.category_pending', true) . '<span class="badge bg-secondary ms-2">' . ($status_count['pending'] ?? 0) . '</span>', 'current' => ($status ?? null) == 'pending', 'attributes' => ['href' => $this->base_uri . 'clients/transactions/' . ($client->id ?? null) . '/pending/', 'class' => 'ajax']],
