    ['name' => $this->_('AdminClients.transactions.category_returned', true) . '<span class="badge bg-secondary ms-2">' . ($status_count['returned'] ?? 0) . '</span>', 'current' => ($status ?? null) == 'returned', 'attributes' => ['href' => $this->base_uri . 'clients/transactions/' . ($client->id ?? null) . '/returned/', 'class' => 'ajax']]
