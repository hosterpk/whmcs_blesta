                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/transactions/' . ($client->id ?? null) . '/' . ($status ?? null) . '/?sort=amount&order=' . ($sort == 'amount' ? $negate_order : $order));?>" class="ajax text-decoration-none">
