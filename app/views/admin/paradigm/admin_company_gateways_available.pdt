<?php
if ((isset($show_left_nav) ? $show_left_nav : null)) {
    echo (isset($left_nav) ? $left_nav : null);
}

$tabs = [];
foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
    $tabs[] = [
        'name' => $tab['name'],
        'current' => ($tab['uri'] == 'available'),
        'attributes' => [
            'href' => $this->base_uri . 'settings/company/gateways/' . $tab['uri'] . '/'
        ]
    ];
}
?>

<div <?php echo (isset($show_left_nav) ? $show_left_nav : null) ? 'class="main-content-padding"' : 'class="main-content-padding"';?>>
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->setTabs($tabs);
    $this->Widget->setFilterHtml((isset($filters) ? $filters->getHtml() : ''));
    $this->Widget->create($this->_('AdminCompanyGateways.available.boxtitle_gateway', true), ['id' => 'admin_company_gateways_available']);
    ?>
            <?php
            if ((isset($gateways) ? $gateways : false)) {
                $k = 0;
                foreach ($gateways as $type => $gateway_list) {
                    // Filter out already-installed gateways
                    $available_gateways = [];
                    foreach ((isset($gateway_list) ? $gateway_list : []) as $gateway) {
                        if (!($gateway->installed ?? false)) {
                            $available_gateways[] = $gateway;
                        }
                    }
                    ?>
                    <div data-extension-section>
                    <h6 class="form-section-header<?php echo ($k++ > 0 ? ' mt-4' : '');?>">
                        <?php $this->_('AdminCompanyGateways.available.heading_' . $type);?>
                    </h6>
                    <?php
                    $num_gateways = count($available_gateways);
                    if ($num_gateways > 0) {
                        for ($i = 0; $i < $num_gateways; $i++) {
                            $gateway = $available_gateways[$i];
                            $is_last = ($i == $num_gateways - 1);
                        ?>
                        <div class="d-flex align-items-start gap-3 pb-3<?php echo !$is_last ? ' mb-3' : '';?>"<?php echo !$is_last ? ' style="border-bottom: 1px solid var(--border-color);"' : '';?> data-extension-item>
                            <div style="width: 200px; flex-shrink: 0;">
                                <?php if (!empty($gateway->icon)) { ?>
                                <div class="extension-logo extension-logo-dual">
                                    <div class="extension-logo-blesta">
                                        <img src="<?php echo $this->view_dir;?>images/logo.svg" class="logo-dark" alt="Blesta">
                                        <img src="<?php echo $this->view_dir;?>images/logo-color.svg" class="logo-light" alt="Blesta">
                                    </div>
                                    <div class="extension-logo-icon">
                                        <i class="bi <?php echo $this->Html->safe($gateway->icon);?>"></i>
                                    </div>
                                </div>
                                <?php } else { ?>
                                <div class="extension-logo extension-logo-single">
                                    <?php if (!empty($gateway->logo)) { ?>
                                    <img src="<?php echo $this->Html->safe($gateway->logo);?>" alt="<?php echo $this->Html->safe($gateway->name);?>">
                                    <?php } ?>
                                </div>
                                <?php } ?>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1"><?php echo $this->Html->safe($gateway->name);?> <span class="text-muted" style="font-weight: normal; font-size: 0.875rem;"><?php $this->_('AdminCompanyGateways.available.text_version', false, $this->Html->safe($gateway->version));?></span>
                                    <?php if ($gateway->signup_url ?? null) { ?>
                                    <a href="<?php echo $this->Html->safe($gateway->signup_url);?>" target="_blank" class="ms-2" style="font-size: 0.875rem;">
                                        <?php $this->_('AdminCompanyGateways.available.signup_url');?>
                                    </a>
                                    <?php } ?>
                                </h6>
                                <div class="text-muted small mb-1">
                                    <?php $this->_('AdminCompanyGateways.available.text_author');?>
                                    <?php
                                    $authors = (array)($gateway->authors ?? []);
                                    foreach ($authors as $index => $author) {
                                    ?>
                                    <a href="<?php echo $this->Html->safe($author['url'] ?? '#');?>" class="text-primary"><?php echo $this->Html->safe($author['name'] ?? '');?></a><?php echo isset($authors[$index + 1]) ? ', ' : '';?>
                                    <?php
                                    }
                                    ?>
                                </div>
                                <?php if ($type == 'merchant' && !empty($gateway->interfaces)) { ?>
                                <div class="text-muted small mb-1">
                                    <strong><?php $this->_('AdminCompanyGateways.available.text_supports');?></strong>
                                    <?php
                                    $num_interfaces = count($gateway->interfaces);
                                    for ($j = 0; $j < $num_interfaces; $j++) {
                                        echo ($j > 0 ? ', ' : '') . $this->_('AdminCompanyGateways.available.text_' . strtolower($gateway->interfaces[$j]), true);
                                    }
                                    ?>
                                </div>
                                <?php } ?>
                                <p class="mb-0 text-secondary" style="font-size: 0.875rem;"><?php echo nl2br($this->Html->safe($gateway->description ?? ''));?></p>
                            </div>
                            <div class="d-flex gap-2" style="flex-shrink: 0;">
                                <?php
                                $this->Form->create(
                                    $this->base_uri . 'settings/company/gateways/install/' . ($gateway->class ?? '') . '/' . $type . '/',
                                    ['class' => 'gateway-install-form']
                                );
                                $this->Form->fieldHidden('id', $gateway->class ?? '');
                                $this->Form->fieldHidden('type', $type);
                                $this->Form->fieldSubmit('save', $this->_('AdminCompanyGateways.available.btn_install', true), ['class' => 'btn btn-sm btn-primary']);
                                $this->Form->end();
                                ?>
                            </div>
                        </div>
                        <?php
                        }
                    } else {
                        ?>
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                            <p class="mt-3 mb-0"><?php $this->_('AdminCompanyGateways.available.text_' . $type . '_none');?></p>
                        </div>
                        <?php
                    }
                    ?>
                    </div>
                    <?php
                }
            }
            ?>
            <div class="text-center text-muted py-5 extension-filter-no-results" style="display: none;">
                <i class="bi bi-search" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyGateways.text_filter_no_results');?></p>
            </div>
    <?php $this->Widget->end(); ?>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.gateway-install-form').forEach(form => {
        form.addEventListener('submit', function() {
            const submitButton = this.querySelector('input[type="submit"]');
            if (submitButton) {
                submitButton.style.pointerEvents = 'none';
                submitButton.style.cursor = 'default';
            }
        });
    });
});
</script>
