                    $color_with_hash = $color_value && !str_starts_with($color_value, '#') ? '#' . $color_value : ($color_value ?: '#FFFFFF');
                    // Store without # for form submission
                    $color_without_hash = ltrim($color_value, '#') ?: 'FFFFFF';
                ?>
                <div class="color-picker-input-group">
                    <input type="color"
                           class="form-control form-control-color color-picker-input"
                           id="color_picker_<?php echo (isset($color) ? $color : null);?>"
                           value="<?php echo $this->Html->safe($color_with_hash);?>"
                           data-color-field="colors_<?php echo (isset($color) ? $color : null);?>">
                    <?php
                    $this->Form->fieldText(
                        'colors[' . (isset($color) ? $color : null) . ']',
                        $color_without_hash,
                        ['id' => 'colors_' . (isset($color) ? $color : null), 'class' => 'form-control form-control-sm color-text-input']
                    );
                    ?>
                </div>
                <?php
                }
                ?>
                </div>
            </div>
            <?php
            }
            ?>
            <?php } ?>

            <?php if ((isset($vars->type) ? $vars->type : null) != 'admin') { ?>
            <!-- Logo URL (client themes only) -->
            <div class="mb-3">
                <label for="logo_url" class="form-label">
