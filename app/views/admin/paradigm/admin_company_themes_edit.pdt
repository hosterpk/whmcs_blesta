                       title="<?php echo $this->Html->safe($this->_('AdminCompanyThemes.!theme.tooltip_logo_url', true));?>"></i>
                </label>
                <?php
                $this->Form->fieldText('logo_url', (isset($vars->logo_url) ? $vars->logo_url : null), ['id' => 'logo_url', 'class' => 'form-control']);
                ?>
            </div>
            <?php } ?>

            <!-- Custom CSS -->
            <div class="mb-3">
                <label for="custom_css" class="form-label">
                    <?php $this->_('AdminCompanyThemes.edit.field_custom_css');?>
                </label>
                <?php
                $this->Form->fieldTextarea('custom_css', (isset($vars->custom_css) ? $vars->custom_css : null), ['id' => 'custom_css', 'class' => 'form-control']);
                ?>
            </div>

            <!-- Submit Button -->
            </div>

            <?php $this->Widget->footer(); ?>
            <div class="d-flex justify-content-end">
                <?php
                echo $this->Form->fieldSubmit('save', $this->_('AdminCompanyThemes.edit.field_editthemesubmit', true), ['class' => 'btn btn-primary']);
