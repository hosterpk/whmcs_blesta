<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'contacts'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/contacts/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logcontacts'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if ((isset($contact_logs) ? $contact_logs : false) && ($num_logs = count($contact_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/contacts/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'first_name' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logcontacts.text_name');?>
                                <?php if ($sort == 'first_name') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/contacts/?sort=date_changed&order=' . ($sort == 'date_changed' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_changed' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logcontacts.text_date');?>
                                <?php if ($sort == 'date_changed') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                    $contact_log_id = (isset($contact_logs[$i]->id) ? $this->Html->safe($contact_logs[$i]->id) : $i);
                ?>
                <tr class="contact_list" style="cursor: pointer;" data-collapse-row aria-expanded="false">
                    <td><a href="<?php echo $this->base_uri . 'clients/editcontact/' . (isset($contact_logs[$i]->client_id) ? $this->Html->safe($contact_logs[$i]->client_id) : null) . '/' . (isset($contact_logs[$i]->contact_id) ? $this->Html->safe($contact_logs[$i]->contact_id) : null) . '/';?>"><?php echo (isset($contact_logs[$i]->first_name) ? $this->Html->safe($contact_logs[$i]->first_name) : null) . ' ' . (isset($contact_logs[$i]->last_name) ? $this->Html->safe($contact_logs[$i]->last_name) : null);?></a></td>
                    <td><?php echo $this->Date->cast((isset($contact_logs[$i]->date_changed) ? $this->Html->safe($contact_logs[$i]->date_changed) : null), 'date_time');?></td>
                </tr>
                <tr class="collapse">
                    <td colspan="2" style="padding: 0; background-color: var(--bg-secondary);">
                        <div class="p-3">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th><?php $this->_('AdminTools.logcontacts.text_field');?></th>
                                    <th><?php $this->_('AdminTools.logcontacts.text_previous');?></th>
                                    <th><?php $this->_('AdminTools.logcontacts.text_new');?></th>
                                </tr>
                            </thead>
                            <tbody>
                            <?php
                            foreach ($contact_logs[$i]->change as $field => $values) {
                            ?>
                            <tr>
                                <td><code><?php (print (isset($field) ? $this->Html->safe($field) : null));?></code></td>
                                <td class="text-danger"><?php (print (isset($values['prev']) ? $this->Html->safe($values['prev']) : null));?></td>
                                <td class="text-success"><?php (print (isset($values['cur']) ? $this->Html->safe($values['cur']) : null));?></td>
                            </tr>
                            <?php
                            }
                            ?>
                            </tbody>
                        </table>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logcontacts.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>

<script type="text/javascript">
    // Bootstrap 5 collapse handles row expansion automatically via data-bs-toggle
</script>
