    }
    ?>

    <!-- Use Module checkbox + Save (shared across actions) -->
    <div id="use-module-container" style="display: none;">
        <div class="form-check mb-3">
            <?php
            $this->Form->fieldCheckbox('use_module', 'true', (isset($vars->use_module) ? $vars->use_module : 'true') == ($service->status == 'canceled' ? 'false' : 'true'), ['id' => 'use_module_action', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminClients.editservice.field_use_module', true), 'use_module_action', ['class' => 'form-check-label']);
            ?>
        </div>
        <div class="d-flex justify-content-end gap-2" id="action-save">
            <button type="button" class="btn btn-outline-secondary action-cancel-btn"><?php $this->_('AppController.modal.btn_cancel');?></button>
            <?php $this->Form->fieldSubmit('save', $this->_('AdminClients.editservice.field_module_save', true), ['class' => 'btn btn-primary']);?>
        </div>
        <div class="d-flex justify-content-end gap-2 d-none" id="cancel-confirm-save">
            <button type="button" class="btn btn-outline-secondary action-cancel-btn"><?php $this->_('AppController.modal.btn_cancel');?></button>
            <button type="button" class="btn btn-danger modal-confirm-delete"
                data-confirm-message="<?php echo $this->Html->safe($this->_('AdminClients.editservice.confirm_cancel', true));?>"
                data-form="service_actions">
                <?php $this->_('AdminClients.editservice.field_cancel_service');?>
            </button>
        </div>
    </div>
</div>
<?php } ?>

<?php
$this->Form->end();
?>

