        ?>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <?php $this->Form->label($this->_('AdminClients.editservice.field_invoice_method', true), null, ['class' => 'form-label']);?>

                <div class="form-check">
                    <?php $this->Form->fieldRadio('invoice_method', 'create', !isset($vars->invoice_method) || (isset($vars->invoice_method) ? $vars->invoice_method : null) == 'create', ['id' => 'invoice_method_create', 'class' => 'form-check-input']);?>
