    $this->Form->end();
}
?>

<script type="text/javascript">
(function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var serviceId = <?php echo json_encode((isset($service->id) ? $service->id : null));?>;
    var clientId = <?php echo json_encode((isset($service->client_id) ? $service->client_id : null));?>;

    // Action button group toggle
    var actionButtons = document.querySelectorAll('.action-button-group [data-action]');
    var actionForms = document.querySelectorAll('.action-form[data-action-form]');
    var actionEmptyState = document.getElementById('action-empty');
    var actionHidden = document.getElementById('action_hidden');
    var useModuleAction = document.getElementById('use_module_action');
    var useModuleContainer = document.getElementById('use-module-container');
    var actionSave = document.getElementById('action-save');
    var cancelConfirmSave = document.getElementById('cancel-confirm-save');
    // Actions that disable use_module
    var disableModuleActions = { 'change_renew': true, 'update_coupon': true };
    // Actions that force use_module checked + disabled
    var forceModuleActions = { 'schedule_cancel': true };

    function resetActionForms() {
        actionForms.forEach(function(form) { form.style.display = 'none'; });
        if (actionEmptyState) actionEmptyState.style.display = 'block';
        if (useModuleContainer) useModuleContainer.style.display = 'none';
        if (cancelConfirmSave) cancelConfirmSave.classList.add('d-none');
        if (actionSave) actionSave.classList.remove('d-none');
        actionButtons.forEach(function(btn) { btn.classList.remove('active'); });
        if (actionHidden) actionHidden.value = '';
        if (useModuleAction) {
            useModuleAction.disabled = false;
            useModuleAction.checked = true;
        }
    }

    function showActionForm(action, button) {
        resetActionForms();
        var form = document.querySelector('[data-action-form="' + action + '"]');
        if (form) {
            form.style.display = 'block';
            if (actionEmptyState) actionEmptyState.style.display = 'none';
            if (button) button.classList.add('active');
            if (actionHidden) actionHidden.value = action;

            // Show use_module checkbox
            if (useModuleContainer) useModuleContainer.style.display = 'block';

            // Handle use_module state per action
            if (useModuleAction) {
                if (disableModuleActions[action]) {
                    useModuleAction.checked = false;
                    useModuleAction.disabled = true;
                } else if (forceModuleActions[action]) {
                    useModuleAction.checked = true;
                    useModuleAction.disabled = true;
                } else {
                    useModuleAction.disabled = false;
                }
            }

            // Show confirmation save for cancel, standard save for others
            if (action === 'cancel') {
                if (actionSave) actionSave.classList.add('d-none');
                if (cancelConfirmSave) cancelConfirmSave.classList.remove('d-none');
            }

            // Trigger totals update for change_renew
            if (action === 'change_renew') {
                updateActionTotals();
            }
        }
    }

    actionButtons.forEach(function(button) {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            var action = this.getAttribute('data-action');
            showActionForm(action, this);
        });
    });

    document.querySelectorAll('.action-cancel-btn').forEach(function(button) {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            resetActionForms();
        });
    });

    // Price override toggle
    var priceOverride = document.getElementById('price_override');
    var overridePriceFields = document.getElementById('override-price-fields');
    var pricingId = document.getElementById('pricing_id');
    var prorateUpgrade = document.getElementById('prorate_upgrade');
    var prorateRenew = document.getElementById('prorate_renew');
    var renewDate = document.getElementById('renew_date');

    // Initialize
    showPriceOverrideFields();

    if (priceOverride) {
        priceOverride.addEventListener('change', function() {
            showPriceOverrideFields();
            showUpgradeProration();
        });
    }

    function showPriceOverrideFields() {
        if (!priceOverride || !overridePriceFields || !pricingId) return;

        if (priceOverride.checked) {
            overridePriceFields.style.display = 'block';
            pricingId.disabled = true;
        } else {
            overridePriceFields.style.display = 'none';
            pricingId.disabled = false;
        }
    }

    function showUpgradeProration() {
        if (!prorateUpgrade || !priceOverride) return;

        if (priceOverride.checked) {
            prorateUpgrade.checked = false;
            prorateUpgrade.disabled = true;
        } else {
            prorateUpgrade.disabled = false;
        }
    }

    // Action totals update (change_renew)
    if (renewDate) {
        renewDate.addEventListener('change', function() {
            if (actionHidden && actionHidden.value === 'change_renew') {
                updateActionTotals();
            }
        });
    }
    if (prorateRenew) {
        prorateRenew.addEventListener('change', function() {
            if (actionHidden && actionHidden.value === 'change_renew') {
                updateActionTotals();
            }
        });
    }

    function updateActionTotals() {
        var form = document.getElementById('service_actions');
        if (!form) return;
        var formData = new FormData(form);
        fetch(baseUri + 'clients_service/updatetotals/' + clientId + '/' + serviceId + '/', {
            method: 'POST',
            body: formData,
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            var totalsEl = document.getElementById('service-action-totals');
            if (totalsEl) totalsEl.innerHTML = data || '';
        })
        .catch(function(error) { console.error('Error updating action totals:', error); });
    }

    // Package options
    packageOptions();
    if (pricingId) {
        pricingId.addEventListener('change', function() {
            packageOptions();
        });
    }
    var disableOptionLogic = document.getElementById('disable_option_logic');
    if (disableOptionLogic) {
        disableOptionLogic.addEventListener('change', function() {
            packageOptions();
        });
    }

    function packageOptions() {
        var pricingIdVal = pricingId ? pricingId.value : '';
        if (pricingIdVal) {
            var container = document.querySelector('.package_options');
            if (!container) {
                container = document.querySelector('.package-options');
            }
            if (!container) return;

            var parentForm = container.closest('form');
            if (!parentForm) return;

            // Serialize configoptions and disable_option_logic as URL query params
            // (controller reads from $this->get, not $this->post)
            var fields = parentForm.querySelectorAll(
                '[name^="configoptions"],[name="disable_option_logic"]'
            );
            var params = 'service_id=' + encodeURIComponent(serviceId);
            fields.forEach(function(field) {
                if (field.type === 'checkbox' && !field.checked) return;
                params += '&' + encodeURIComponent(field.name)
                    + '=' + encodeURIComponent(field.value);
            });

            fetch(baseUri + 'clients/packageoptions/' + pricingIdVal + '?' + params, {
                method: 'GET',
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(function(response) { return response.text(); })
            .then(function(text) {
                if (!text) return;
                try { text = JSON.parse(text); } catch(e) { /* use raw text */ }
                container.innerHTML = text;
                container.querySelectorAll('script').forEach(function(oldScript) {
                    var newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(function(attr) {
                        newScript.setAttribute(attr.name, attr.value);
                    });
                    newScript.textContent = oldScript.textContent;
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });
                initTooltips();
                updateTotals();
            })
            .catch(function(error) { console.error('Error fetching package options:', error); });
        }
    }

    // Service changes totals update
    var serviceChangesForm = document.getElementById('service_changes');
    if (serviceChangesForm) {
        serviceChangesForm.addEventListener('change', function(e) {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') {
                updateTotals();
            }
        });

        serviceChangesForm.addEventListener('submit', function(e) {
            var pricingIdEl = document.getElementById('pricing_id');
            if (pricingIdEl && pricingIdEl.disabled) {
                pricingIdEl.disabled = false;
            }
            return true;
        });
    }

    function updateTotals() {
        var form = document.getElementById('service_changes');
        if (!form) return;

        var pricingIdEl = document.getElementById('pricing_id');
        var wasDisabled = pricingIdEl && pricingIdEl.disabled;
        if (wasDisabled) {
            pricingIdEl.disabled = false;
        }

        var formData = new FormData(form);

        if (wasDisabled) {
            pricingIdEl.disabled = true;
        }

        fetch(baseUri + 'clients_service/updatetotals/' + clientId + '/' + serviceId + '/', {
            method: 'POST',
            body: formData,
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            var totalsEl = document.getElementById('service-change-totals');
            if (totalsEl) totalsEl.innerHTML = data || '';
        })
        .catch(function(error) { console.error('Error updating totals:', error); });
    }

    // Initialize Bootstrap tooltips & popovers
    initTooltips();

    function initTooltips() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
        popoverTriggerList.map(function (popoverTriggerEl) {
            return new bootstrap.Popover(popoverTriggerEl);
        });
    }
})();
</script>
