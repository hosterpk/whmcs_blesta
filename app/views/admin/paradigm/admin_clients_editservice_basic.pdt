    $this->Form->fieldCheckbox('use_module', 'true', (isset($vars->use_module) ? $vars->use_module : 'true') == 'true', ['id' => 'use_module_package', 'class' => 'form-check-input']);
    $this->Form->label($this->_('AdminClients.editservice.field_use_module', true), 'use_module_package', ['class' => 'form-check-label']);
