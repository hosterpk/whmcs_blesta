<?php
$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Form->fieldHidden('section', 'information');
?>

<!-- Service Information Section -->
<h6 class="form-section-header"><?php $this->_('AdminClients.editservice.service_heading');?></h6>

<!-- Package Info Bar -->
<div class="service-info-bar mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h6 class="mb-1"><?php (print (isset($service->package->name) ? $this->Html->safe($service->package->name) : null));?></h6>
            <div class="text-muted"><?php (print (isset($service->name) ? $this->Html->safe($service->name) : null));?></div>
        </div>
        <?php
        $statusClass = 'secondary';
        $statusIcon = 'bi-circle';
        if (isset($service->status) && $service->status == 'active') {
            $statusClass = 'success';
            $statusIcon = 'bi-check-circle';
        } elseif (isset($service->status) && $service->status == 'suspended') {
            $statusClass = 'warning';
            $statusIcon = 'bi-pause-circle';
        } elseif (isset($service->status) && $service->status == 'canceled') {
            $statusClass = 'danger';
            $statusIcon = 'bi-x-circle';
        }
        ?>
        <span class="badge bg-<?php echo $statusClass; ?>">
            <i class="bi <?php echo $statusIcon; ?> me-1"></i><?php echo $this->Html->safe((isset($statuses[$service->status]) ? $statuses[$service->status] : null));?>
        </span>
    </div>
</div>

<!-- Service Details - Read-only Info -->
<div class="service-info-details-container mb-4">
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_qty');?></label>
            <div class="form-control-plaintext"><?php (print (isset($service->qty) ? $this->Html->safe($service->qty) : null));?></div>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_term');?></label>
            <div class="form-control-plaintext">
            <?php
            if ((isset($service->package_pricing->period) ? $service->package_pricing->period : null) == 'onetime') {
                (print (isset($periods[$service->package_pricing->period]) ? $this->Html->safe($periods[$service->package_pricing->period]) : null));
            } else {
                $term = (isset($service->package_pricing->term) ? $this->Html->safe($service->package_pricing->term) : null);
                echo $this->Html->safe($this->Html->concat(' ', $term, ($term == 1 ? (isset($periods[$service->package_pricing->period]) ? $periods[$service->package_pricing->period] : null) : (isset($periods[$service->package_pricing->period . '_plural']) ? $periods[$service->package_pricing->period . '_plural'] : null))));
            }
            ?>
            </div>
        </div>
        <?php
        if ((isset($service->package_pricing->period) ? $service->package_pricing->period : null) != 'onetime') {
        ?>
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_renewal_price');?></label>
            <div class="form-control-plaintext"><?php echo $this->CurrencyFormat->format((isset($service->renewal_price) ? $service->renewal_price : null), (isset($service->override_currency) ? $service->override_currency : (isset($service->package_pricing->currency) ? $service->package_pricing->currency : null)));?></div>
        </div>
        <?php
        }
        ?>
    </div>

    <!-- Date Timeline -->
    <div class="row g-3 mb-0">
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_date_added');?></label>
            <div class="form-control-plaintext"><?php echo (!empty($service->date_added) ? $this->Date->cast($service->date_added) : '');?></div>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_date_renews');?></label>
            <div class="form-control-plaintext">
            <?php
            $date_renews_text = (!empty($service->date_renews) ? $this->Date->cast($service->date_renews) : $this->_('AdminClients.services.text_never', true));
            echo $date_renews_text;

            if ($service->date_paid_through && $service->date_paid_through != $service->date_renews) {
            ?>
                <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.!tooltip.text_date_paid_through', false, !empty($service->date_paid_through) ? $this->Date->cast($service->date_paid_through) : $date_renews_text);?>"></i>
            <?php
            }
            ?>
            </div>
        </div>
        <?php
        if (!empty($service->date_last_renewed)) {
        ?>
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_date_last_renewed');?></label>
            <div class="form-control-plaintext"><?php echo $this->Date->cast($service->date_last_renewed);?></div>
        </div>
        <?php
        }
        ?>
    </div>

    <?php
    if (!empty($service->date_suspended) || !empty($service->date_canceled)) {
    ?>
    <div class="row g-3 mt-3">
        <?php
        if (!empty($service->date_suspended)) {
        ?>
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_date_suspended');?></label>
            <div class="form-control-plaintext"><?php echo $this->Date->cast($service->date_suspended);?></div>
        </div>
        <?php
        }
        if (!empty($service->date_canceled)) {
        ?>
        <div class="col-md-4">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_date_canceled');?></label>
            <div class="form-control-plaintext"><?php echo $this->Date->cast($service->date_canceled);?></div>
        </div>
        <?php
        }
        ?>
    </div>
    <?php
    }
    ?>

    <?php
    // Display the coupon that should apply when the service renews
    if ((isset($recurring_coupon) ? $recurring_coupon : null)) {
    ?>
    <div class="row g-3 mt-3">
        <div class="col-12">
            <label class="form-label text-muted small mb-1"><?php $this->_('AdminClients.editservice.text_recurring_coupon');?></label>
            <div class="form-control-plaintext">
                <span class="badge bg-info">
                <?php
                if ((isset($recurring_coupon->recurring_amount->type) ? $recurring_coupon->recurring_amount->type : null) == 'percent') {
                    $this->_('AdminClients.editservice.text_coupon_percent', false, $this->Html->safe((isset($recurring_coupon->code) ? $recurring_coupon->code : null)), $this->CurrencyFormat->cast((isset($recurring_coupon->recurring_amount->amount) ? $recurring_coupon->recurring_amount->amount : null), (isset($recurring_coupon->recurring_amount->currency) ? $recurring_coupon->recurring_amount->currency : null)));
                } else {
                    $this->_('AdminClients.editservice.text_coupon_amount', false, $this->Html->safe((isset($recurring_coupon->code) ? $recurring_coupon->code : null)), $this->CurrencyFormat->format((isset($recurring_coupon->recurring_amount->amount) ? $recurring_coupon->recurring_amount->amount : null), (isset($recurring_coupon->recurring_amount->currency) ? $recurring_coupon->recurring_amount->currency : null)));
                }
                ?>
                </span>
            </div>
        </div>
    </div>
    <?php
    }
    ?>
</div>

<?php
if ((isset($service->status) ? $service->status : null) != 'canceled' && !empty($module_row_fields)) {
?>
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <?php
        $this->Form->label((isset($module_row_name) ? $module_row_name : null), 'module_row_id', ['class' => 'form-label']);
        ?>
        <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.!tooltip.module_row_id');?>"></i>
        <?php
        $this->Form->fieldSelect('module_row_id', (isset($module_row_fields) ? $module_row_fields : []), (isset($vars->module_row_id) ? $vars->module_row_id : null), ['id' => 'module_row_id', 'class' => 'form-select']);
        ?>
    </div>
</div>
<?php
}
?>

<?php
if ((isset($service->status) ? $service->status : null) != 'canceled' && !empty($module_row_fields)) {
?>
<div class="d-flex justify-content-end mb-4">
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminClients.editservice.field_module_save', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
}
$this->Form->end();
?>

<?php
$this->Form->create(null, ['id' => 'service_actions', 'class' => 'disable-on-submit']);
$this->Form->fieldHidden('section', 'action');
$this->Form->fieldHidden('action', '', ['id' => 'action_hidden']);
?>

<!-- Actions Section -->
<h6 class="form-section-header"><?php $this->_('AdminClients.editservice.action_heading');?></h6>

<?php
// Icon map for action buttons
$action_icons = [
    'suspend' => 'bi-pause-circle',
    'unsuspend' => 'bi-play-circle',
    'cancel' => 'bi-x-circle',
    'schedule_cancel' => 'bi-calendar-x',
    'change_renew' => 'bi-calendar-check',
    'update_coupon' => 'bi-ticket-perforated',
    'uncancel' => 'bi-arrow-counterclockwise',
];

// Filter out the empty '' placeholder entry from $actions
$action_buttons = array_filter((isset($actions) ? $actions : []), function($key) {
    return $key !== '';
}, ARRAY_FILTER_USE_KEY);
?>

<?php if (!empty($action_buttons)) { ?>
<!-- Action Button Group -->
<div class="btn-group action-button-group mb-3" role="group" aria-label="<?php $this->_('AdminClients.editservice.action_heading');?>">
    <?php foreach ($action_buttons as $key => $label) { ?>
    <button type="button" class="btn btn-outline-secondary" data-action="<?php echo $this->Html->safe($key);?>">
        <i class="bi <?php echo isset($action_icons[$key]) ? $action_icons[$key] : 'bi-gear';?> me-2"></i><?php echo $this->Html->safe($label);?>
    </button>
    <?php } ?>
</div>

<!-- Expandable Action Form Container -->
<div class="action-form-container mb-3">
    <!-- Empty State -->
    <div class="action-empty-state" id="action-empty">
        <div class="text-center py-5">
            <i class="bi bi-hand-index" style="font-size: 3rem; color: var(--text-secondary);"></i>
            <p class="text-muted mt-3 mb-0"><?php $this->_('AdminClients.editservice.action_empty_state');?></p>
        </div>
    </div>

    <?php
    if ((isset($service->status) ? $service->status : null) != 'canceled') {
    ?>
    <!-- Suspend Form -->
    <div class="action-form" data-action-form="suspend" style="display:none;">
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('AdminClients.editservice.action.field_suspension_reason', true), 'suspension_reason', ['class' => 'form-label']);
            $this->Form->fieldTextArea('suspension_reason', (isset($vars->suspension_reason) ? $vars->suspension_reason : null), ['id' => 'suspension_reason', 'class' => 'form-control']);
            ?>
        </div>
    </div>

    <!-- Unsuspend Form -->
    <div class="action-form" data-action-form="unsuspend" style="display:none;">
    </div>

    <!-- Cancel Form -->
    <div class="action-form" data-action-form="cancel" style="display:none;">
        <?php
        if (!empty($service->children)) {
        ?>
        <div class="alert alert-warning d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <?php $this->_('AdminClients.editservice.text_children');?>
        </div>
        <?php
        }
        ?>

        <div class="form-check mb-2">
            <?php $this->Form->fieldCheckbox('notify_cancel', 'true', (isset($vars->notify_cancel) ? $vars->notify_cancel : 'true') === 'true', ['id' => 'notify_cancel_cancel', 'class' => 'form-check-input']);?>
            <?php $this->Form->label($this->_('AdminClients.editservice.action.field_notify_cancel', true), 'notify_cancel_cancel', ['class' => 'form-check-label']);?>
            <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.!tooltip.notify_cancel');?>"></i>
        </div>

        <div class="mb-3">
            <?php
            $this->Form->label($this->_('AdminClients.editservice.action.field_cancellation_reason', true), 'cancellation_reason_cancel', ['class' => 'form-label']);
            $this->Form->fieldTextArea('cancellation_reason', (isset($vars->cancellation_reason) ? $vars->cancellation_reason : null), ['id' => 'cancellation_reason_cancel', 'class' => 'form-control']);
            ?>
        </div>
    </div>

    <!-- Schedule Cancel Form -->
    <div class="action-form" data-action-form="schedule_cancel" style="display:none;">
        <div class="mb-3">
            <div class="form-check mb-2">
                <?php
                $disabled_field = [];
                if (!$service->date_renews) {
                    $disabled_field = ['disabled' => 'disabled'];
                }

                $this->Form->fieldRadio('cancel', 'term', ($service->date_renews && (isset($vars->cancel) ? $vars->cancel : null) == 'term'), array_merge(['id' => 'action_cancel_term', 'class' => 'form-check-input'], $disabled_field));

                if ($service->date_renews) {
                    $this->Form->label($this->_('AdminClients.editservice.action.field_cancel_term_date', true, $this->Date->cast((isset($service->date_renews) ? $service->date_renews : null), 'date')), 'action_cancel_term', ['class' => 'form-check-label ms-2']);
                } else {
                    $this->Form->label($this->_('AdminClients.editservice.action.field_cancel_term', true), 'action_cancel_term', ['class' => 'form-check-label ms-2']);
                }
                ?>
            </div>
            <div class="form-check mb-2">
                <?php
                $this->Form->fieldRadio('cancel', 'date', ((isset($vars->cancel) ? $vars->cancel : null) == 'date'), ['id' => 'action_cancel_date', 'class' => 'form-check-input']);
                $this->Form->label($this->_('AdminClients.editservice.action.field_cancel_date', true), 'action_cancel_date', ['class' => 'form-check-label ms-2']);
                $this->Form->fieldText('date_canceled', (isset($vars->date_canceled) ? $vars->date_canceled : null), ['class' => 'form-control form-control-sm d-inline-block w-auto ms-2', 'id' => 'date_canceled', 'type' => 'date']);
                ?>
            </div>
            <div class="form-check">
                <?php
                $this->Form->fieldRadio('cancel', 'none', !isset($vars->cancel) || (isset($vars->cancel) ? $vars->cancel : null) == 'none', ['id' => 'action_cancel_none', 'class' => 'form-check-input']);
                $this->Form->label($this->_('AdminClients.editservice.action.field_cancel_none', true), 'action_cancel_none', ['class' => 'form-check-label ms-2']);
                ?>
            </div>
        </div>

        <div class="form-check mb-2">
            <?php $this->Form->fieldCheckbox('notify_cancel', 'true', (isset($vars->notify_cancel) ? $vars->notify_cancel : 'true') === 'true', ['id' => 'notify_cancel_schedule', 'class' => 'form-check-input']);?>
            <?php $this->Form->label($this->_('AdminClients.editservice.action.field_notify_cancel', true), 'notify_cancel_schedule', ['class' => 'form-check-label']);?>
            <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.!tooltip.notify_cancel');?>"></i>
        </div>

        <div class="mb-3">
            <?php
            $this->Form->label($this->_('AdminClients.editservice.action.field_cancellation_reason', true), 'cancellation_reason_schedule', ['class' => 'form-label']);
            $this->Form->fieldTextArea('cancellation_reason', (isset($vars->cancellation_reason) ? $vars->cancellation_reason : null), ['id' => 'cancellation_reason_schedule', 'class' => 'form-control']);
            ?>
        </div>
    </div>

    <!-- Change Renew Date Form -->
    <div class="action-form" data-action-form="change_renew" style="display:none;">
        <div class="row mb-3">
            <div class="col-md-3">
                <?php
                $this->Form->label($this->_('AdminClients.editservice.action.field_date_renews', true), 'renew_date', ['class' => 'form-label']);
                $this->Form->fieldText('date_renews', (isset($vars->date_renews) ? $vars->date_renews : $this->Date->cast($service->date_renews, 'Y-m-d')), ['class' => 'form-control', 'id' => 'renew_date', 'type' => 'date']);
                ?>
            </div>
        </div>
        <div class="form-check mb-3">
            <?php
            $this->Form->fieldCheckbox('prorate', 'true', (isset($vars->prorate) ? $vars->prorate : 'true') == 'true', ['id' => 'prorate_renew', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminClients.editservice.field_prorate', true), 'prorate_renew', ['class' => 'form-check-label']);
            ?>
            <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.editservice.tooltip_prorate_renewal');?>"></i>
        </div>

        <div class="d-flex justify-content-end" id="service-action-totals"></div>
    </div>

    <!-- Update Coupon Form -->
    <div class="action-form" data-action-form="update_coupon" style="display:none;">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <?php
                $this->Form->label($this->_('AdminClients.editservice.action.field_coupon_code', true), 'coupon_code_update', ['class' => 'form-label']);
                ?>
                <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.editservice.tooltip_coupon_code');?>"></i>
                <?php
                $this->Form->fieldText('coupon_code_update', (isset($vars->coupon_code_update) ? $vars->coupon_code_update : null), ['id' => 'coupon_code_update', 'class' => 'form-control']);
                ?>
            </div>
        </div>
    </div>

    <?php
    } else {
    ?>
    <!-- Uncancel Form -->
    <div class="action-form" data-action-form="uncancel" style="display:none;">
        <div class="alert alert-warning d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <?php $this->_('AdminClients.editservice.text_uncancel');?>
        </div>

        <?php
        // Show module fields
        if (isset($input_html) && ($module_field_html = $input_html->generate(null, $this->view))) {
            echo $module_field_html;
