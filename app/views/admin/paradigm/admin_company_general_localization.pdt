<script>
// Initialize Bootstrap tooltips - vanilla JavaScript only
document.addEventListener('DOMContentLoaded', function() {
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Dynamic date format preview
    const dateFormatInput = document.getElementById('date_format');
    const dateFormatPreview = document.getElementById('date_format_preview');
    const datetimeFormatInput = document.getElementById('datetime_format');
    const datetimeFormatPreview = document.getElementById('datetime_format_preview');

    // Function to convert PHP date format to JavaScript-displayable format
    function formatDatePreview(phpFormat) {
        if (!phpFormat) return '';

        const now = new Date();
        let result = '';
        let escaped = false;

        // Common PHP date format mappings
        const replacements = {
            'Y': now.getFullYear(),
            'y': String(now.getFullYear()).slice(-2),
            'm': String(now.getMonth() + 1).padStart(2, '0'),
            'n': now.getMonth() + 1,
            'd': String(now.getDate()).padStart(2, '0'),
            'j': now.getDate(),
            'H': String(now.getHours()).padStart(2, '0'),
            'G': now.getHours(),
            'h': String(now.getHours() % 12 || 12).padStart(2, '0'),
            'g': now.getHours() % 12 || 12,
            'i': String(now.getMinutes()).padStart(2, '0'),
            's': String(now.getSeconds()).padStart(2, '0'),
            'A': now.getHours() >= 12 ? 'PM' : 'AM',
            'a': now.getHours() >= 12 ? 'pm' : 'am',
            'F': now.toLocaleString('default', { month: 'long' }),
            'M': now.toLocaleString('default', { month: 'short' }),
            'l': now.toLocaleString('default', { weekday: 'long' }),
            'D': now.toLocaleString('default', { weekday: 'short' })
        };

        // Process format string character by character
        for (let i = 0; i < phpFormat.length; i++) {
            const char = phpFormat[i];

            // Handle escaped characters
            if (escaped) {
                result += char;
                escaped = false;
                continue;
            }

            if (char === '\\') {
                escaped = true;
                continue;
            }

            // Replace format character if it exists in mappings
            if (replacements.hasOwnProperty(char)) {
                result += replacements[char];
            } else {
                result += char;
            }
        }

        return result;
    }

    // Update date format preview
    if (dateFormatInput && dateFormatPreview) {
        dateFormatInput.addEventListener('input', function() {
            dateFormatPreview.textContent = formatDatePreview(this.value);
        });
    }

    // Update datetime format preview
    if (datetimeFormatInput && datetimeFormatPreview) {
        datetimeFormatInput.addEventListener('input', function() {
            datetimeFormatPreview.textContent = formatDatePreview(this.value);
        });
    }
});
</script>
