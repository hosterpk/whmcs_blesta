<?php /** @var View $this **/ ?>

        <div class="main-content-padding">
            <?php echo (isset($message) ? $message : null);?>

            <?php
            $this->Widget->clear();
            $this->Widget->setBodyWrapper(false);
            $this->Widget->create($this->_('AdminCompanyElectronicInvoices.index.boxtitle_electronic_invoices', true), ['id' => 'admin_company_electronic_invoices'], ($render_section ?? null));

            $this->Form->create(null, ['class' => 'disable-on-submit']);

            if (empty($formats)) {
            ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminCompanyElectronicInvoices.index.no_formats');?></p>
            </div>
            <?php
            } else {
            ?>
            <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width: 50px;"></th>
                                <th><?php $this->_('AdminCompanyElectronicInvoices.index.heading_format');?></th>
                                <th><?php $this->_('AdminCompanyElectronicInvoices.index.heading_description');?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php
                            foreach ($formats as $format) {
                            ?>
                            <tr>
                                <td>
                                    <div class="form-check">
                                        <?php
                                        $this->Form->fieldCheckbox(
                                            'formats[]',
                                            $this->Html->safe($format['key']),
                                            $format['enabled'],
                                            ['id' => 'format_' . $this->Html->safe($format['key']), 'class' => 'form-check-input']
                                        );
                                        ?>
                                    </div>
                                </td>
                                <td>
                                    <label for="format_<?php echo $this->Html->safe($format['key']);?>" class="mb-0">
                                        <?php echo $this->Html->safe($format['name'] ?? '');?>
                                    </label>
                                </td>
                                <td>
                                    <?php echo $this->Html->safe($format['description'] ?? '');?>
                                </td>
                            </tr>
                            <?php
                            }
                            ?>
                        </tbody>
                    </table>
            </div>

            <?php $this->Widget->footer(); ?>
            <div class="d-flex justify-content-end">
                <?php
                $this->Form->fieldSubmit(
                    'save',
                    $this->_('AdminCompanyElectronicInvoices.index.field_submit', true),
                    ['class' => 'btn btn-primary']
                );
                ?>
            </div>
            <?php
            }

            $this->Form->end();
            $this->Widget->end();
            ?>
        </div>
