<?php /** @var View $this **/ ?>

<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php $this->Form->create(null, ['class' => 'disable-on-submit']); ?>
    <?php
    $this->Widget->clear();
    $this->Widget->create($this->_('AdminCompanyBilling.invoices.boxtitle_invoices', true), ['id' => 'admin_company_billing_invoices']);
    ?>

            <?php echo (isset($invoice_form) ? $invoice_form : null); ?>

    <?php $this->Widget->footer(); ?>
        <div class="d-flex justify-content-end">
            <?php
            $this->Form->fieldSubmit(
                'save',
                $this->_('AdminCompanyBilling.invoices.field.invoicessubmit', true),
                ['class' => 'btn btn-primary']
            );
            ?>
        </div>
    <?php
    $this->Widget->end();
    $this->Form->end();
    ?>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    const voidInvoiceCheckbox = document.getElementById('void_invoice_canceled_service');
    const clientsCancelCheckbox = document.getElementById('clients_cancel_services');

    function toggleVoidDays() {
        const voidDaysField = document.querySelector('.void_inv_canceled_service_days');
        if (voidDaysField) {
            voidDaysField.style.display = voidInvoiceCheckbox && voidInvoiceCheckbox.checked ? 'block' : 'none';
        }
    }

    function toggleCancelOptions() {
        const cancelOptionsField = document.querySelector('.clients_cancel_options');
        if (cancelOptionsField) {
            cancelOptionsField.style.display = clientsCancelCheckbox && clientsCancelCheckbox.checked ? 'block' : 'none';
        }
    }

    // Initial state
    toggleVoidDays();
    toggleCancelOptions();

    // Event listeners
    if (voidInvoiceCheckbox) {
        voidInvoiceCheckbox.addEventListener('change', toggleVoidDays);
    }

    if (clientsCancelCheckbox) {
        clientsCancelCheckbox.addEventListener('change', toggleCancelOptions);
    }
});
</script>
