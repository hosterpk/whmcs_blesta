<?php if (!($in_modal ?? false)) { ?>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tab switching
    var tabSlider = document.querySelector('.tab_slider');
    if (tabSlider) {
        tabSlider.querySelectorAll('li').forEach(function(li) {
            li.addEventListener('click', function() {
                var tabClass = this.querySelector('a').className;
                tabSlider.querySelectorAll('li').forEach(function(item) { item.classList.remove('current'); });
                this.classList.add('current');
                document.querySelectorAll('.tab_content').forEach(function(tab) { tab.style.display = 'none'; });
                var target = document.getElementById('tab_' + tabClass);
                if (target) target.style.display = 'block';
            });
        });
    }

    // Dual-select drag and drop functionality
    (function() {
        let draggedItem = null;

        function setupDualSelect(container) {
            const leftList = container.querySelector('.dual-select-panel:first-child .drag-list');
            const rightList = container.querySelector('.dual-select-panel:last-child .drag-list');
            const moveLeftBtn = container.querySelector('.move-left');
            const moveRightBtn = container.querySelector('.move-right');

            if (!leftList || !rightList) return;

            function setupDragItems() {
                container.querySelectorAll('.drag-item').forEach(item => {
                    item.addEventListener('click', function(e) {
                        e.stopPropagation();
                        if (e.ctrlKey || e.metaKey) {
                            this.classList.toggle('selected');
                        } else {
                            container.querySelectorAll('.drag-item').forEach(i => i.classList.remove('selected'));
                            this.classList.add('selected');
                        }
                    });

                    item.addEventListener('dblclick', function(e) {
                        e.stopPropagation();
                        const currentList = this.closest('.drag-list');
                        const targetList = currentList === leftList ? rightList : leftList;
                        targetList.appendChild(this);
                        this.classList.remove('selected');
                    });

                    item.addEventListener('dragstart', function(e) {
                        draggedItem = this;
                        this.classList.add('dragging');
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/plain', this.textContent);
                    });

                    item.addEventListener('dragend', function() {
                        this.classList.remove('dragging');
                        container.querySelectorAll('.drag-list').forEach(l => l.classList.remove('drag-over'));
                    });
                });
            }

            [leftList, rightList].forEach(list => {
                list.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    this.classList.add('drag-over');
                });

                list.addEventListener('dragleave', function(e) {
                    if (!this.contains(e.relatedTarget)) {
                        this.classList.remove('drag-over');
                    }
                });

                list.addEventListener('drop', function(e) {
                    e.preventDefault();
                    this.classList.remove('drag-over');
                    if (draggedItem && draggedItem.parentNode !== this) {
                        this.appendChild(draggedItem);
                        draggedItem.classList.remove('selected');
                        draggedItem = null;
                    }
                });
            });

            moveLeftBtn?.addEventListener('click', function() {
                rightList.querySelectorAll('.drag-item.selected').forEach(item => {
                    leftList.appendChild(item);
                    item.classList.remove('selected');
                });
            });

            moveRightBtn?.addEventListener('click', function() {
                leftList.querySelectorAll('.drag-item.selected').forEach(item => {
                    rightList.appendChild(item);
                    item.classList.remove('selected');
                });
            });

            setupDragItems();
        }

        document.querySelectorAll('.dual-select-container').forEach(setupDualSelect);

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.drag-item')) {
                document.querySelectorAll('.drag-item.selected').forEach(item => item.classList.remove('selected'));
            }
        });

        // Before form submit, create hidden inputs for assigned packages
        document.getElementById('add_package_option_group')?.addEventListener('submit', function() {
            const assignedList = document.getElementById('assigned_packages');
            if (assignedList) {
                assignedList.querySelectorAll('input[name="packages[]"]').forEach(i => i.remove());
                assignedList.querySelectorAll('.drag-item').forEach(item => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'packages[]';
                    input.value = item.dataset.value;
                    assignedList.appendChild(input);
                });
            }
        });
    })();
});
</script>
<?php } ?>
