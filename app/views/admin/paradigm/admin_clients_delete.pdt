<?php /** @var View $this **/ ?>

echo (isset($message) ? $message : null);

$this->Widget->clear();
$this->Widget->create($this->_('AdminClients.delete.boxtitle_delete', true), ['id' => 'admin_clients_delete']);
?>
    <?php $this->Form->create(null, ['id' => 'admin_client_delete', 'class' => 'disable-on-submit']);?>

    <div class="alert alert-warning mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong><?php $this->_('AdminClients.delete.heading_warning');?></strong>
        <p class="mb-0"><?php $this->_('AdminClients.delete.text_warning');?></p>
    </div>

    <div id="client_deletion_error"></div>

    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminClients.delete.field_password', true), 'password', ['class' => 'form-label']);
        $this->Form->fieldPassword('password', (isset($vars->password) ? $vars->password : null), ['id' => 'password', 'class' => 'form-control']);
        ?>
    </div>

    <?php $this->Form->fieldHidden('client_id', (isset($client_id) ? $client_id : null), ['id' => 'client_id']);?>
</div>
<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <a href="<?php echo $this->base_uri . 'clients/view/' . ($client->id ?? '');?>/" class="btn btn-secondary">
        <?php $this->_('AppController.modal.btn_cancel');?>
    </a>
    <?php
    $this->Form->fieldSubmit('submit', $this->_('AdminClients.delete.field_submit', true), ['class' => 'btn btn-danger']);
    ?>
</div>
    <?php $this->Form->end();?>
<?php
$this->Widget->end();
?>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('admin_client_delete');
    var errorDiv = document.getElementById('client_deletion_error');

    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            var formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: new URLSearchParams(formData),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    errorDiv.innerHTML = '<div class="alert alert-danger" role="alert">' + data.error + '</div>';
                } else if (data.redirect) {
                    window.location.replace(data.redirect);
                }
            })
            .catch(error => console.error('Error:', error));
        });
    }
});
</script>
