    ['name' => $this->_('AdminClients.services.category_active', true) . '<span class="badge bg-secondary ms-2">' . ($status_count['active'] ?? 0) . '</span>', 'current' => ($status ?? null) == 'active', 'attributes' => ['href' => $this->base_uri . 'clients/services/' . ($client->id ?? null) . '/active/', 'class' => 'ajax']],
    ['name' => $this->_('AdminClients.services.category_pending', true) . '<span class="badge bg-secondary ms-2">' . ($status_count['pending'] ?? 0) . '</span>', 'current' => ($status ?? null) == 'pending', 'attributes' => ['href' => $this->base_uri . 'clients/services/' . ($client->id ?? null) . '/pending/', 'class' => 'ajax']],
    ['name' => $this->_('AdminClients.services.category_suspended', true) . '<span class="badge bg-secondary ms-2">' . ($status_count['suspended'] ?? 0) . '</span>', 'current' => ($status ?? null) == 'suspended', 'highlight' => true, 'attributes' => ['href' => $this->base_uri . 'clients/services/' . ($client->id ?? null) . '/suspended/', 'class' => 'ajax']],
    ['name' => $this->_('AdminClients.services.category_canceled', true) . '<span class="badge bg-secondary ms-2">' . ($status_count['canceled'] ?? 0) . '</span>', 'current' => ($status ?? null) == 'canceled', 'attributes' => ['href' => $this->base_uri . 'clients/services/' . ($client->id ?? null) . '/canceled/', 'class' => 'ajax']],
];
