<script type="text/javascript">
(function() {
    var baseUri = <?php echo json_encode($this->base_uri);?>;
    var textItemSelected = <?php echo json_encode($this->_('AdminBilling.services.text_item_selected', true));?>;
    var textItemsSelected = <?php echo json_encode($this->_('AdminBilling.services.text_items_selected', true));?>;

    // Show/hide bulk actions bar based on checkbox state
    function showBulkActions() {
        var servicesContainer = document.getElementById('admin_billing_services');
        var bulkActionsBar = document.getElementById('bulkActionsBar');
        var selectedCountEl = document.getElementById('selectedCount');

        if (!servicesContainer || !bulkActionsBar) return;

        var checkedBoxes = servicesContainer.querySelectorAll('input.row-checkbox:checked');
        if (checkedBoxes.length > 0) {
            bulkActionsBar.style.display = 'block';
            if (selectedCountEl) {
                var text = checkedBoxes.length === 1 ? textItemSelected : textItemsSelected;
                selectedCountEl.textContent = checkedBoxes.length + ' ' + text;
            }
        } else {
            bulkActionsBar.style.display = 'none';
        }
    }

    // Switch action options visibility based on selected action
    function switchServiceActions() {
        var bulkActionsBar = document.getElementById('bulkActionsBar');
        if (!bulkActionsBar) return;

        var actionSelectEl = bulkActionsBar.querySelector('select[name="action"]');
        if (!actionSelectEl) return;

        var actionOptions = bulkActionsBar.querySelectorAll('.action-option');
        actionOptions.forEach(function(opt) {
            opt.style.display = 'none';
        });

        var action = actionSelectEl.value;
        if (action) {
            var targetElement = document.getElementById(action);
            if (targetElement) {
                targetElement.style.display = 'flex';
            }
        }
    }

    // Initialize tooltips in container
    function initTooltips(container) {
        if (!container) return;
        var tooltipTriggerList = container.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(function(el) {
            if (!el._tooltipInitialized) {
                new bootstrap.Tooltip(el);
                el._tooltipInitialized = true;
            }
        });
    }

    // Initialize on page load or after AJAX content replacement
    function init() {
        var servicesContainer = document.getElementById('admin_billing_services');
        if (servicesContainer) {
            initTooltips(servicesContainer);
            switchServiceActions();
            showBulkActions();
        }
    }

    // Handle checkbox changes via event delegation
    document.addEventListener('change', function(e) {
        var checkbox = e.target;
        if (checkbox.type !== 'checkbox') return;

        var servicesContainer = document.getElementById('admin_billing_services');
        if (!servicesContainer || !servicesContainer.contains(checkbox)) return;

        // Handle "select all" checkbox
        if (checkbox.id === 'select-all') {
            var isChecked = checkbox.checked;
            var rowCheckboxes = servicesContainer.querySelectorAll('input.row-checkbox');
            rowCheckboxes.forEach(function(cb) {
                cb.checked = isChecked;
            });
        } else if (checkbox.classList.contains('row-checkbox')) {
            var selectAllCheckbox = document.getElementById('select-all');
            if (!checkbox.checked && selectAllCheckbox) {
                selectAllCheckbox.checked = false;
            }
        }

        showBulkActions();
    });

    // Handle action select change via event delegation
    document.addEventListener('change', function(e) {
        var target = e.target;
        if (target.name === 'action' && target.closest('#bulkActionsBar')) {
            switchServiceActions();
        }
    });

    // Handle service delete buttons with confirmation modal
    document.addEventListener('click', function(e) {
        var deleteBtn = e.target.closest('.service-delete-btn');
        if (!deleteBtn) return;

        var servicesContainer = document.getElementById('admin_billing_services');
        if (!servicesContainer || !servicesContainer.contains(deleteBtn)) return;

        e.preventDefault();
        e.stopPropagation();

        var clientId = deleteBtn.getAttribute('data-client-id');
        var serviceId = deleteBtn.getAttribute('data-delete-id');
        var confirmMessage = deleteBtn.getAttribute('data-confirm-message');

        document.getElementById('delete_service_client_id').value = clientId;
        document.getElementById('delete_service_service_id').value = serviceId;

        var modalEl = document.createElement('div');
        modalEl.className = 'modal fade';
        modalEl.setAttribute('tabindex', '-1');
        modalEl.innerHTML =
            '<div class="modal-dialog modal-dialog-centered">' +
                '<div class="modal-content">' +
                    '<div class="modal-header border-0 pb-0">' +
                        '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>' +
                    '</div>' +
                    '<div class="modal-body text-center py-4">' +
                        '<div class="mb-3"><i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i></div>' +
                        '<h5 class="modal-title mb-3">' + <?php echo json_encode($this->_('AppController.modal.confirm_delete', true));?> + '</h5>' +
                        '<p class="text-secondary">' + confirmMessage + '</p>' +
                    '</div>' +
                    '<div class="modal-footer border-0 justify-content-center">' +
                        '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">' + <?php echo json_encode($this->_('AppController.modal.btn_cancel', true));?> + '</button>' +
                        '<button type="button" class="btn btn-danger btn-confirm">' + <?php echo json_encode($this->_('AppController.modal.btn_delete', true));?> + '</button>' +
                    '</div>' +
                '</div>' +
            '</div>';

        document.body.appendChild(modalEl);
        var modal = new bootstrap.Modal(modalEl);
        var confirmed = false;

        modalEl.querySelector('.btn-confirm').addEventListener('click', function() {
            confirmed = true;
            modal.hide();
        });

        modalEl.addEventListener('hidden.bs.modal', function() {
            modalEl.remove();
            if (confirmed) {
                document.getElementById('delete_service_form').submit();
            }
        });

        modal.show();
    });

    // Load service info when expanding a row
    document.addEventListener('show.bs.collapse', function(e) {
        var servicesContainer = document.getElementById('admin_billing_services');
        if (!servicesContainer || !servicesContainer.contains(e.target)) return;

        var container = e.target.querySelector('.service-info-container');
        if (!container || container.hasAttribute('data-loaded')) return;

        var serviceId = container.getAttribute('data-service-id');
        fetch(baseUri + 'billing/serviceinfo/' + serviceId, {
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) {
            if (!response.ok) throw new Error('HTTP error ' + response.status);
            return response.json();
        })
        .then(function(html) {
            container.innerHTML = html;
            container.setAttribute('data-loaded', 'true');
            document.dispatchEvent(new Event('blestaAjaxComplete'));
        })
        .catch(function(error) {
            container.innerHTML = '<div class="alert alert-danger m-3">Error loading service details.</div>';
        });
    });

    // Client autocomplete for "Push to Client" action
    var debounceTimer;
    document.addEventListener('input', function(e) {
        var clientInput = e.target;
        if (clientInput.id !== 'client' || !clientInput.closest('#push_to_client')) return;

        clearTimeout(debounceTimer);
        var query = clientInput.value;
        var resultsContainer = document.getElementById('client_autocomplete_results');

        if (query.length < 3) {
            if (resultsContainer) {
                resultsContainer.innerHTML = '';
                resultsContainer.style.display = 'none';
            }
            return;
        }

        debounceTimer = setTimeout(function() {
            var formData = new FormData();
            formData.append('search', query);

            var form = clientInput.closest('form');
            var csrfToken = form ? form.querySelector('input[name="_csrf_token"]') : null;
            if (csrfToken) {
                formData.append('_csrf_token', csrfToken.value);
            }

            fetch(baseUri + 'clients/getclients/', {
                method: 'POST',
                headers: {'X-Requested-With': 'XMLHttpRequest'},
                body: formData
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data && data.clients && resultsContainer) {
                    var html = '';
                    var hasResults = false;
                    for (var id in data.clients) {
                        hasResults = true;
                        html += '<a href="#" class="list-group-item list-group-item-action py-2" data-client-id="' + id + '">' + data.clients[id] + '</a>';
                    }

                    if (hasResults) {
                        resultsContainer.innerHTML = '<div class="list-group list-group-flush">' + html + '</div>';
                        resultsContainer.style.display = 'block';
                    } else {
                        resultsContainer.innerHTML = '';
                        resultsContainer.style.display = 'none';
                    }
                }
            })
            .catch(function(error) {
                console.error('Error:', error);
            });
        }, 300);
    });

    // Handle clicks on autocomplete results
    document.addEventListener('click', function(e) {
        var resultsContainer = document.getElementById('client_autocomplete_results');
        var clientInput = document.getElementById('client');
        var clientIdInput = document.getElementById('client_id');

        var listItem = e.target.closest('#client_autocomplete_results .list-group-item');
        if (listItem && clientInput && clientIdInput) {
            e.preventDefault();
            clientInput.value = listItem.textContent.trim();
            clientIdInput.value = listItem.getAttribute('data-client-id');
            if (resultsContainer) {
                resultsContainer.style.display = 'none';
            }
            return;
        }

        if (resultsContainer && clientInput && !clientInput.contains(e.target) && !resultsContainer.contains(e.target)) {
            resultsContainer.style.display = 'none';
        }
    });

    // Run init on DOMContentLoaded, or immediately if loaded via AJAX
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
        document.dispatchEvent(new Event('blestaAjaxComplete'));
    }

    // Re-init when widget content is replaced via AJAX
    var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                mutation.addedNodes.forEach(function(node) {
                    if (node.nodeType === 1) {
                        var servicesContainer = document.getElementById('admin_billing_services');
                        if (servicesContainer && (servicesContainer.contains(node) || node === servicesContainer || (node.querySelector && node.querySelector('#admin_billing_services')))) {
                            setTimeout(function() { init(); }, 0);
                        }
                    }
                });
            }
        });
    });

    observer.observe(document.body, { childList: true, subtree: true });
})();
</script>

