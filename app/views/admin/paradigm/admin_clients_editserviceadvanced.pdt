<?php /** @var View $this **/ ?>

<?php
$this->Form->create(null, ['class' => 'disable-on-submit', 'id' => 'service_fields']);

$this->Widget->clear();
$this->Widget->setTabs((isset($tabs) ? $tabs : []));
$this->Widget->create($this->_('AdminClients.editservice.boxtitle_editservice', true, (isset($package->name) ? $package->name : null), (isset($service->name) ? $service->name : null)), ['id' => 'admin_clients_editservice'], (isset($render_section) ? $render_section : null));
?>

<!-- Warning Alert -->
<div class="alert alert-warning d-flex align-items-start mb-4" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
    <div>
        <?php $this->_('AdminClients.!notice.edit_service_advanced');?>
    </div>
</div>

<!-- Advanced Options Section -->
<h6 class="form-section-header">
    <?php $this->_('AdminClients.editservice.advanced_heading');?>
</h6>

<div class="row g-3 mb-4">
    <?php
    $fields = ['date_added', 'date_renews', 'date_last_renewed', 'date_paid_through', 'date_suspended', 'date_canceled'];
    foreach ($fields as $index => $field) {
        $label = $this->_('AdminClients.editservice.field_' . $field, true);
        $fieldId = $field;
        if ($index % 2 === 0) {
            if ($index > 0) {
                echo '</div><div class="row g-3 mb-4">';
            }
        }
    ?>
    <div class="col-md-6">
        <?php
        $this->Form->label($label . ' <span class="text-muted small">(' . $field . ')</span>', $fieldId, ['class' => 'form-label'], true);
        $this->Form->fieldText($field, isset($vars->{$field}) ? substr($vars->{$field}, 0, 10) : null, ['class' => 'form-control date', 'id' => $fieldId]);
        ?>
    </div>
    <?php
    }
    ?>
</div>

<!-- Service Fields Section -->
<h6 class="form-section-header">
    <?php $this->_('AdminClients.editservice.service_fields_heading');?>
</h6>

<div class="service-fields-list" id="serviceFieldsList">
    <?php
    $fieldIndex = 0;
    foreach ($service->fields ?: [(object)[]] as $key => $field) {
    ?>
    <div class="service-field-item card mb-3" data-field-index="<?php echo $this->Html->safe($fieldIndex);?>">
        <div class="card-body position-relative">
            <button type="button" class="btn-close remove-service-field position-absolute" style="top: 0.75rem; right: 0.75rem;" aria-label="Remove"></button>
            <div class="row g-3 pe-4">
                <div class="col-md-6">
                    <?php
                    $this->Form->label($this->_('AdminClients.editservice.field_key', true), 'key_' . $fieldIndex, ['class' => 'form-label']);
                    $this->Form->fieldText('fields[key][]', ($vars->fields['key'][$key] ?? $field->key ?? null), ['id' => 'key_' . $fieldIndex, 'class' => 'form-control']);
                    ?>
                </div>
                <div class="col-md-6">
                    <?php
                    $this->Form->label($this->_('AdminClients.editservice.field_value', true), 'value_' . $fieldIndex, ['class' => 'form-label']);
                    $isSerialized = ($vars->fields['serialized'][$key] ?? $field->serialized ?? null) == '1' || !is_scalar($field->value ?? '');
                    if ($isSerialized) {
                        $this->Form->fieldTextarea('fields[value][]', serialize($vars->fields['value'][$key] ?? $field->value ?? null), ['id' => 'value_' . $fieldIndex, 'class' => 'form-control font-monospace', 'rows' => 3]);
                    } else {
                        $this->Form->fieldText('fields[value][]', ($vars->fields['value'][$key] ?? $field->value ?? null), ['id' => 'value_' . $fieldIndex, 'class' => 'form-control']);
                    }
                    ?>
                </div>
            </div>

            <div class="mt-3">
                <?php
                $isCheckedSerialized = ($vars->fields['serialized'][$key] ?? $field->serialized ?? null) == '1';
                $isCheckedEncrypted = ($vars->fields['encrypted'][$key] ?? $field->encrypted ?? null) == '1';
                ?>
                <div class="form-check form-check-inline me-3">
                    <input class="form-check-input serialize-service-field" type="checkbox" id="serialized_<?php echo $this->Html->safe($fieldIndex);?>" name="fields[serialized][]" value="1"<?php echo $isCheckedSerialized ? ' checked' : '';?>>
                    <label class="form-check-label" for="serialized_<?php echo $this->Html->safe($fieldIndex);?>"><?php $this->_('AdminClients.editservice.field_serialized');?></label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="encrypted_<?php echo $this->Html->safe($fieldIndex);?>" name="fields[encrypted][]" value="1"<?php echo $isCheckedEncrypted ? ' checked' : '';?>>
                    <label class="form-check-label" for="encrypted_<?php echo $this->Html->safe($fieldIndex);?>"><?php $this->_('AdminClients.editservice.field_encrypted');?></label>
                </div>
            </div>
        </div>
    </div>
    <?php
        $fieldIndex++;
    }
    ?>
</div>

<div class="mb-3">
    <button type="button" class="btn btn-outline-secondary btn-sm add-service-field">
        <i class="bi bi-plus-lg me-1"></i><?php $this->_('AdminClients.editservice.field_add');?>
    </button>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminClients.editservice.field_module_save', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Widget->end();
$this->Form->end();
?>

<script type="text/javascript">
(function() {
    var serviceFieldsList = document.getElementById('serviceFieldsList');
    var fieldIndex = <?php echo max($fieldIndex, 1);?>;

    // Remove service field
    serviceFieldsList.addEventListener('click', function(e) {
        var removeButton = e.target.closest('.remove-service-field');
        if (removeButton) {
            var fieldItem = removeButton.closest('.service-field-item');
            fieldItem.remove();
        }
    });

    // Toggle serialized checkbox
    serviceFieldsList.addEventListener('change', function(e) {
        if (e.target.classList.contains('serialize-service-field')) {
            var fieldItem = e.target.closest('.service-field-item');
            var valueInput = fieldItem.querySelector('[id^="value_"]');
            var name = valueInput.getAttribute('name');
            var id = valueInput.getAttribute('id');
            var value = valueInput.value;
            var classes = valueInput.className;

            if (e.target.checked) {
                // Replace text input with textarea
                var textarea = document.createElement('textarea');
                textarea.name = name;
                textarea.id = id;
                textarea.className = classes + ' font-monospace';
                textarea.rows = 3;
                textarea.value = value;
                valueInput.parentNode.replaceChild(textarea, valueInput);
            } else {
                // Replace textarea with text input
                var input = document.createElement('input');
                input.type = 'text';
                input.name = name;
                input.id = id;
                input.className = classes.replace(' font-monospace', '');
                input.value = value;
                valueInput.parentNode.replaceChild(input, valueInput);
            }
        }
    });

    // Add new service field
    var addButton = document.querySelector('.add-service-field');
    if (addButton) {
        addButton.addEventListener('click', function() {
            var firstField = serviceFieldsList.querySelector('.service-field-item');
            if (!firstField) return;

            var newField = firstField.cloneNode(true);
            var newIndex = fieldIndex++;

            newField.setAttribute('data-field-index', newIndex);
            newField.querySelectorAll('[id^="key_"], [id^="value_"], [id^="serialized_"], [id^="encrypted_"]').forEach(function(input) {
                var oldId = input.id;
                var baseName = oldId.replace(/_\d+$/, '');
                input.id = baseName + '_' + newIndex;
            });

            // Clear all values
            newField.querySelectorAll('input, textarea').forEach(function(formField) {
                if (formField.type === 'checkbox') {
                    formField.checked = false;
                } else {
                    formField.value = '';
                }
            });

            // Ensure textarea is converted back to text input
            var textarea = newField.querySelector('textarea[id^="value_"]');
            if (textarea) {
                var input = document.createElement('input');
                input.type = 'text';
                input.name = textarea.name;
                input.id = textarea.id;
                input.className = textarea.className.replace(' font-monospace', '');
                input.value = '';
                textarea.parentNode.replaceChild(input, textarea);
            }

            serviceFieldsList.appendChild(newField);
        });
    }

    // Handle form submission - ensure unchecked checkboxes send '0'
    var serviceFieldsForm = document.getElementById('service_fields');
    if (serviceFieldsForm) {
        serviceFieldsForm.addEventListener('submit', function() {
            var checkboxes = serviceFieldsForm.querySelectorAll('input[type="checkbox"]');
            checkboxes.forEach(function(checkbox) {
                if (!checkbox.checked) {
                    var existing = checkbox.parentElement.querySelector('input[type="hidden"][name="' + checkbox.name + '"]');
                    if (!existing) {
                        var hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = checkbox.name;
                        hidden.value = '0';
                        checkbox.parentNode.insertBefore(hidden, checkbox.nextSibling);
                    }
                }
            });
        });
    }
})();
</script>
