<?php /** @var View $this **/ ?>


        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'cron'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/cron/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logcron'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="table-responsive">
            <?php
            if ((isset($cron_logs) ? $cron_logs : false) && ($num_logs = count($cron_logs)) > 0) {
            ?>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminTools.logcron.task');?></th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/cron/?sort=start_date&order=' . ($sort == 'start_date' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'start_date' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logcron.start_date');?>
                                <?php if ($sort == 'start_date') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/cron/?sort=end_date&order=' . ($sort == 'end_date' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'end_date' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.logcron.end_date');?>
                                <?php if ($sort == 'end_date') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                    $cron_id = (isset($cron_logs[$i]->id) ? $this->Html->safe($cron_logs[$i]->id) : $i);
                ?>
                <tr style="cursor: pointer;" data-collapse-row aria-expanded="false">
                    <td><?php (print (isset($cron_logs[$i]->real_name) ? $this->Html->safe($cron_logs[$i]->real_name) : null));?></td>
                    <td><?php echo $this->Date->cast((isset($cron_logs[$i]->start_date) ? $this->Html->safe($cron_logs[$i]->start_date) : null), 'date_time');?></td>
                    <td><?php echo $this->Date->cast((isset($cron_logs[$i]->end_date) ? $this->Html->safe($cron_logs[$i]->end_date) : null), 'date_time');?></td>
                </tr>
                <tr class="collapse" id="cron-details-<?php echo $cron_id;?>">
                    <td colspan="3" style="padding: 0; background-color: var(--bg-secondary);">
                        <div style="padding: .5rem;">
                            <h6 class="mb-2"><?php $this->_('AdminTools.logcron.output');?></h6>
                            <?php
                            // Display cron log output for this task
                            if (!empty($cron_logs[$i]->output)) {
                            ?>
                            <pre class="mb-0 bg-body p-3 rounded border" style="max-height: 300px; overflow-y: auto;"><?php echo $this->Html->safe($cron_logs[$i]->output);?></pre>
                            <?php
                            } else {
                            ?>
                            <p class="text-muted mb-0"><?php $this->_('AdminTools.logcron.no_output');?></p>
                            <?php
                            }
                            ?>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            <?php
            } else {
            ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTools.logcron.no_results');?></p>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>

