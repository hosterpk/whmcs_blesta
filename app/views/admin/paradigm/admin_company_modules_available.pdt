<?php /** @var View $this **/ ?>

<?php
$tabs = [];
foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
    $tabs[] = [
        'name' => $tab['name'],
        'current' => ($tab['uri'] == 'available'),
        'attributes' => [
            'href' => $this->base_uri . 'settings/company/modules/' . $tab['uri'] . '/'
        ]
    ];
}

$this->Widget->clear();
$this->Widget->setTabs($tabs);
$this->Widget->setFilterHtml((isset($filters) ? $filters->getHtml() : ''));
$this->Widget->create($this->_('AdminCompanyModules.available.boxtitle_module', true), ['id' => 'admin_company_modules_available']);
?>
    <?php
    $available_modules = [];
    foreach ((isset($modules) ? $modules : []) as $module) {
        if (!($module->installed ?? false)) {
            $available_modules[] = $module;
        }
    }

    $num_modules = count($available_modules);
    if ($num_modules > 0) {
        for ($i = 0; $i < $num_modules; $i++) {
            $module = $available_modules[$i];
            $is_last = ($i == $num_modules - 1);
    ?>
    <!-- Module Item -->
    <div class="d-flex align-items-start gap-3 pb-3<?php echo !$is_last ? ' mb-3' : '';?>"<?php echo !$is_last ? ' style="border-bottom: 1px solid var(--border-color);"' : '';?> data-extension-item>
        <div style="width: 200px; flex-shrink: 0;">
            <?php if (!empty($module->icon)) { ?>
            <div class="extension-logo extension-logo-dual">
                <div class="extension-logo-blesta">
                    <img src="<?php echo $this->view_dir;?>images/logo.svg" class="logo-dark" alt="Blesta">
                    <img src="<?php echo $this->view_dir;?>images/logo-color.svg" class="logo-light" alt="Blesta">
                </div>
                <div class="extension-logo-icon">
                    <i class="bi <?php echo $this->Html->safe($module->icon);?>"></i>
                </div>
            </div>
            <?php } else { ?>
            <div class="extension-logo extension-logo-single">
                <?php if (!empty($module->logo)) { ?>
                <img src="<?php echo $this->Html->safe($module->logo);?>" alt="<?php echo $this->Html->safe($module->name);?>">
                <?php } ?>
            </div>
            <?php } ?>
        </div>
        <div class="flex-grow-1">
            <h6 class="mb-1"><?php echo $this->Html->safe($module->name);?> <span class="text-muted" style="font-weight: normal; font-size: 0.875rem;"><?php $this->_('AdminCompanyModules.available.text_version', false, $this->Html->safe($module->version));?></span></h6>
            <div class="text-muted small mb-1">
                <?php $this->_('AdminCompanyModules.available.text_author');?>
                <?php
                $authors = (array)($module->authors ?? []);
                foreach ($authors as $index => $author) {
                ?>
                <a href="<?php echo $this->Html->safe($author['url'] ?? '#');?>" class="text-primary"><?php echo $this->Html->safe($author['name'] ?? '');?></a><?php echo isset($authors[$index + 1]) ? ', ' : '';?>
                <?php
                }
                ?>
            </div>
            <p class="mb-0 text-secondary" style="font-size: 0.875rem;"><?php echo nl2br($this->Html->safe($module->description ?? ''));?></p>
        </div>
        <div class="d-flex gap-2" style="flex-shrink: 0;">
            <?php
            $this->Form->create($this->base_uri . 'settings/company/modules/install/' . ($module->class ?? '') . '/', ['class' => '']);
            $this->Form->fieldHidden('id', $module->class ?? '');
            $this->Form->fieldSubmit('save', $this->_('AdminCompanyModules.available.btn_install', true), ['class' => 'btn btn-sm btn-primary']);
            $this->Form->end();
            ?>
        </div>
    </div>
    <?php
        }
    } else {
    ?>
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('AdminCompanyModules.available.text_none');?></p>
    </div>
    <?php
    }
    ?>
    <div class="text-center text-muted py-5 extension-filter-no-results" style="display: none;">
        <i class="bi bi-search" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('AdminCompanyModules.text_filter_no_results');?></p>
    </div>
<?php
$this->Widget->end();
?>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Disable submit button after clicking to prevent double submissions
    document.querySelectorAll('.card-body form').forEach(form => {
        form.addEventListener('submit', function() {
            const submitBtn = this.querySelector('input[type="submit"]');
            if (submitBtn) {
                submitBtn.style.pointerEvents = 'none';
                submitBtn.style.cursor = 'default';
            }
        });
    });
});
</script>
