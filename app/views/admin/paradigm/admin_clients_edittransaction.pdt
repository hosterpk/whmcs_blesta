                    <td><?php echo $this->CurrencyFormat->format((isset($transaction->credited_amount) ? $this->Html->safe($transaction->credited_amount) : null), (isset($transaction->currency) ? $this->Html->safe($transaction->currency) : null), ['html_code' => true]);?></td>
                    <td><?php echo $this->CurrencyFormat->format((isset($transaction->applied_amount) ? $this->Html->safe($transaction->applied_amount) : null), (isset($transaction->currency) ? $this->Html->safe($transaction->currency) : null), ['html_code' => true]);?></td>
                    <td><?php (print (isset($transaction->transaction_id) ? $this->Html->safe($transaction->transaction_id) : null));?></td>
                    <td><?php (print (isset($transaction_status[$transaction->status]) ? $this->Html->safe($transaction_status[$transaction->status]) : null));?></td>
                    <td><?php echo $this->Date->cast((isset($transaction->date_added) ? $this->Html->safe($transaction->date_added) : null), 'date_time');?></td>
                </tr>
            </tbody>
        </table>
    </div>

    <?php
    if ((isset($applied) ? $applied : null)) {
    ?>
    <h6 class="form-section-header">
        <?php $this->_('AdminClients.edittransaction.subheading_invoice');?>
    </h6>
    <div class="table-responsive mb-3">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><?php $this->_('AdminClients.edittransaction.subheading_invoice');?></th>
                    <th><?php $this->_('AdminClients.edittransaction.subheading_amount');?></th>
                    <th><?php $this->_('AdminClients.edittransaction.subheading_appliedon');?></th>
                    <th style="width: 80px;"><?php $this->_('AdminClients.edittransaction.subheading_options');?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                $num_applied = count($applied);
                for ($i = 0; $i < $num_applied; $i++) {
                ?>
                <tr>
                    <td><a href="<?php echo $this->Html->safe($this->base_uri . 'clients/viewinvoice/' . (isset($transaction->client_id) ? $transaction->client_id : null) . '/' . (isset($applied[$i]->invoice_id) ? $applied[$i]->invoice_id : null) . '/');?>"><?php (print (isset($applied[$i]->invoice_id_code) ? $this->Html->safe($applied[$i]->invoice_id_code) : null));?></a></td>
                    <td><?php echo $this->CurrencyFormat->format((isset($applied[$i]->applied_amount) ? $this->Html->safe($applied[$i]->applied_amount) : null), (isset($applied[$i]->currency) ? $this->Html->safe($applied[$i]->currency) : null), ['html_code' => true]);?></td>
                    <td><?php echo $this->Date->cast((isset($applied[$i]->applied_date) ? $this->Html->safe($applied[$i]->applied_date) : null), 'date_time');?></td>
                    <td>
                        <?php
                        $this->Form->create($this->base_uri . 'clients/unapplytransaction/' . (isset($transaction->id) ? $transaction->id : null) . '/' . (isset($applied[$i]->invoice_id) ? $applied[$i]->invoice_id : null) . '/', ['class' => 'd-inline', 'method' => 'get']);
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-warning modal-confirm-warning" title="<?php $this->_('AdminClients.edittransaction.option_unapply');?>" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminClients.edittransaction.confirm_unapply', true));?>">
                            <i class="bi bi-dash-circle"></i>
                        </button>
                        <?php $this->Form->end();?>
                    </td>
                </tr>
                <?php
                }
                ?>
            </tbody>
        </table>
    </div>
    <?php
    } else {
    ?>
    <div class="alert alert-info mt-3"><?php $this->_('AdminClients.edittransaction.applied_no_results');?></div>
    <?php
    }
    ?>

    <?php $this->Form->create(null, ['class' => 'disable-on-submit']);?>
    <div class="row g-3">
        <div class="col-md-4">
            <?php
            $this->Form->label($this->_('AdminClients.edittransaction.field_status', true), 'status', ['class' => 'form-label']);
            $this->Form->fieldSelect('status', $transaction_status, (isset($vars->status) ? $vars->status : null), ['id' => 'status', 'class' => 'form-select']);
            ?>
        </div>
        <?php
        if ((isset($transaction->gateway_id) ? $transaction->gateway_id : false) && (isset($transaction->status) ? $transaction->status : null) != 'void' && (isset($transaction->status) ? $transaction->status : null) != 'returned') {
        ?>
        <div class="col-md-4 process-remotely" style="display: none;">
            <div class="form-check mt-4">
                <?php
                $this->Form->fieldCheckbox('process_remotely', 'true', (isset($vars->process_remotely) ? $vars->process_remotely : 'true') == 'true', ['id' => 'process_remotely', 'class' => 'form-check-input']);
                $this->Form->label($this->_('AdminClients.edittransaction.field_processremotely', true, (isset($transaction->gateway_name) ? $transaction->gateway_name : null)), 'process_remotely', ['class' => 'form-check-label']);
                ?>
            </div>
        </div>
        <?php
        }
        ?>
    </div>
</div>
<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <a href="<?php echo $this->base_uri . 'clients/view/' . ($client->id ?? $transaction->client_id ?? '');?>/" class="btn btn-secondary">
        <?php $this->_('AppController.modal.btn_cancel');?>
    </a>
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminClients.edittransaction.field_submit', true), ['class' => 'btn btn-primary']);
    ?>
</div>
    <?php $this->Form->end();?>
<?php $this->Widget->end();?>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var statusSelect = document.getElementById('status');
    var processRemotely = document.querySelector('.process-remotely');

    function changeStatus(status) {
        if (processRemotely) {
            if (status === 'void' || status === 'refunded') {
                processRemotely.style.display = '';
            } else {
                processRemotely.style.display = 'none';
            }
        }
    }

    // Initial state
    if (statusSelect) {
        changeStatus(statusSelect.value);
        statusSelect.addEventListener('change', function() {
            changeStatus(this.value);
        });
    }
});
</script>
