<?php /** @var View $this **/ ?>

<?php
// Use a unique ID for the fields in case this template is loaded multiple times
$id = uniqid();
?>

<div class="modal fade" id="passwordGeneratorModal-<?php echo $id;?>" tabindex="-1" aria-labelledby="passwordGeneratorModalLabel-<?php echo $id;?>" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="passwordGeneratorModalLabel-<?php echo $id;?>">
                    <?php $this->_('AdminDialog.password.title');?>
                </h5>
                <button type="button" class="btn-close cancel" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <?php
                    $this->Form->label($this->_('AdminDialog.password.field_modal_password', true), 'modal-password-' . $id, ['class' => 'form-label']);
                    ?>
                    <div class="input-group">
                        <?php
                        $this->Form->fieldText('modal-password', '', ['id' => 'modal-password-' . $id, 'class' => 'form-control modal-password', 'readonly' => 'readonly']);
                        ?>
                        <button type="button" class="btn btn-primary generate">
                            <i class="bi bi-arrow-clockwise me-1"></i><?php $this->_('AdminDialog.password.btn_generate');?>
                        </button>
                    </div>
                    <div class="form-text"><?php $this->_('AdminDialog.password.text_click_generate');?></div>
                </div>
                <div class="form-check">
                    <?php
                    $this->Form->fieldCheckbox('modal-password-copied', '1', false, ['id' => 'modal-password-copied-' . $id, 'class' => 'form-check-input modal-password-copied']);
                    $this->Form->label($this->_('AdminDialog.password.field_modal_password_copied', true), 'modal-password-copied-' . $id, ['class' => 'form-check-label']);
                    ?>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary cancel" data-bs-dismiss="modal">
                    <?php $this->_('AdminDialog.password.btn_cancel');?>
                </button>
                <button type="button" class="btn btn-primary save" disabled>
                    <?php $this->_('AdminDialog.password.btn_use_password');?>
                </button>
            </div>
        </div>
    </div>
</div>
