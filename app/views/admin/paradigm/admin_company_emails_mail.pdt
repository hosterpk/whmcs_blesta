<div id="message_unauthorized" style="display:none;"><?php echo (isset($message_unauthorized) ? $message_unauthorized : null)?></div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // Show/hide mail settings based on delivery method
    function showMailSettings() {
        const settingsSections = document.querySelectorAll('[id$="_settings"]');
        settingsSections.forEach(section => {
            section.style.display = 'none';
        });

        const deliveryMethod = document.getElementById('mail_delivery').value;
        const selectedSection = document.getElementById(deliveryMethod + '_settings');
        if (selectedSection) {
            selectedSection.style.display = 'block';
        }
    }

    showMailSettings();

    document.getElementById('mail_delivery').addEventListener('change', function() {
        showMailSettings();
    });

    // Auto-fill SMTP server for OAuth providers
    function autofillOauthSmtpServer() {
        const provider = document.getElementById('oauth2_provider').value;
        const smtpServers = <?php echo json_encode($smtp_servers ?? []); ?>;

        if (smtpServers.hasOwnProperty(provider)) {
            document.getElementById('oauth2_host').value = smtpServers[provider];
        }
    }

    autofillOauthSmtpServer();

    const oauth2ProviderSelect = document.getElementById('oauth2_provider');
    if (oauth2ProviderSelect) {
        oauth2ProviderSelect.addEventListener('change', function() {
            autofillOauthSmtpServer();
        });
    }

    // Test mail functionality
    const testMailButtons = document.querySelectorAll('.test_mail');
    testMailButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();

            const form = document.getElementById('mail');
            const messageDiv = document.getElementById('message');

            if (typeof blestaDisableFormSubmission === 'function' && blestaDisableFormSubmission(form)) {
                fetch('<?php echo $this->base_uri . 'settings/company/emails/mailtest/'; ?>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams(new FormData(form)).toString()
                })
                .then(response => response.text())
                .then(data => {
                    messageDiv.innerHTML = '';
                    messageDiv.innerHTML = data;

                    if (typeof blestaBindCloseMessage === 'function') {
                        blestaBindCloseMessage(messageDiv);
                    }

                    const errorSection = messageDiv.querySelector('.error_section');
                    if (errorSection) {
                        errorSection.style.display = 'block';
                    }
                })
                .catch(error => {
                    messageDiv.innerHTML = '';
                    const unauthorizedMsg = document.getElementById('message_unauthorized').innerHTML;
                    messageDiv.innerHTML = unauthorizedMsg;

                    if (typeof blestaBindCloseMessage === 'function') {
                        blestaBindCloseMessage(messageDiv);
                    }

                    const errorSection = messageDiv.querySelector('.error_section');
                    if (errorSection) {
                        errorSection.style.display = 'block';
                    }
                })
                .finally(() => {
                    if (typeof blestaEnableFormSubmission === 'function') {
                        blestaEnableFormSubmission(form);
                    }
                });
            }

            return false;
        });
    });
});
</script>
