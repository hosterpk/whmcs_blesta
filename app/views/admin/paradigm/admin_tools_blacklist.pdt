<?php /** @var View $this **/ ?>
        <?php
        echo ($message ?? null);

        $link_buttons = [
            [
                'icon' => 'bi bi-plus-lg',
                'name' => '',
                'attributes' => [
                    'title' => $this->_('AdminTools.blacklist.categorylink_add', true),
                    'href' => $this->base_uri . 'tools/blacklistadd/'
                ]
            ]
        ];

        $this->Widget->clear();
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.blacklist.boxtitle_blacklist', true), ['id' => 'admin_tools_blacklist'], ($render_section ?? null));

        if (!empty($rules ?? [])) {
        ?>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminTools.blacklist.heading_rule');?></th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/blacklist/?sort=type&order=' . ($sort == 'type' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'type' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.blacklist.heading_type');?>
                                <?php if ($sort == 'type') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/blacklist/?sort=plugin_dir&order=' . ($sort == 'plugin_dir' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'plugin_dir' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.blacklist.heading_list');?>
                                <?php if ($sort == 'plugin_dir') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/blacklist/?sort=block_outgoing&order=' . ($sort == 'block_outgoing' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'block_outgoing' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.blacklist.heading_block_outgoing');?>
                                <?php if ($sort == 'block_outgoing') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th><?php $this->_('AdminTools.blacklist.heading_note');?></th>
                        <th class="text-end"><?php $this->_('AdminTools.blacklist.heading_options');?></th>
                    </tr>
                </thead>
                <tbody>
                <?php
                foreach ($rules as $rule) {
                ?>
                    <tr>
                        <td>
                            <code><?php echo $this->Html->safe($rule->rule ?? '*');?></code>
                        </td>
                        <td>
                            <span class="badge bg-<?php echo ($rule->type ?? '') == 'ip' ? 'primary' : 'secondary';?>">
                                <?php $this->_('AdminTools.blacklist.text_type_' . ($rule->type ?? ''));?>
                            </span>
                        </td>
                        <td>
                            <?php
                            if (empty($rule->plugin_dir)) {
                                $this->_('AdminTools.blacklist.text_system');
                            } else {
                                echo $this->Html->safe($rule->plugin_name ?? '');
                            }
                            ?>
                        </td>
                        <td>
                            <i class="bi <?php echo $rule->block_outgoing == '1' ? 'bi-check-lg text-success' : 'bi-x-lg text-danger';?>"></i>
                        </td>
                        <td><?php echo $this->Html->safe($rule->note ?? '');?></td>
                        <td class="text-end">
                            <?php
                            $this->Form->create($this->base_uri . 'tools/blacklistdelete/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', (isset($rule->id) ? $this->Html->safe($rule->id) : null));
                            ?>
                            <a href="#" class="btn btn-sm btn-outline-danger modal-confirm-delete" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminTools.blacklist.modal_delete', true));?>">
                                <i class="bi bi-trash"></i>
                            </a>
                            <?php
                            $this->Form->end();
                            ?>
                        </td>
                    </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
        </div>
        <?php
        } else {
        ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminTools.blacklist.no_results');?></p>
        </div>
        <?php
        }
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        $this->Widget->end();
        ?>
