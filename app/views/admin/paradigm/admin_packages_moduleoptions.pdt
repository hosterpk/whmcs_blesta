<?php /** @var View $this **/ ?>


<div class="mb-3">
    <?php
    $this->Form->label($group_name, 'module_group', ['class' => 'form-label']);
    $this->Form->fieldSelect('module_group', ['select' => $this->_('AppController.select.please', true)] + ['' => $this->_('AdminPackages.add.field_modulegroup_any', true)] + (isset($groups) ? $groups : []), (isset($vars->module_group) ? $vars->module_group : null), ['id' => 'module_group', 'class' => 'form-select']);
    ?>
</div>

<?php
if (!empty($groups)) {
?>
<div class="mb-3 module_group_client_field">
    <div class="form-check">
        <?php
        $this->Form->fieldCheckbox('module_group_client', '1', ($vars->module_group_client ?? '0') == '1', ['id' => 'module_group_client', 'class' => 'form-check-input']);
        $this->Form->label($this->_('AdminPackages.moduleoptions.field_module_group_client', true, $group_name), 'module_group_client', ['class' => 'form-check-label']);
        ?>
    </div>
</div>
<div class="mb-3 module_groups_field">
    <?php
    $this->Form->label($this->_('AdminPackages.moduleoptions.field_module_groups', true, $group_name), 'module_groups', ['class' => 'form-label']);
    $this->Form->fieldMultiSelect('module_groups[]', ($groups ?? []), ($vars->module_groups ?? []), ['class' => 'form-select']);
    ?>
</div>
<?php
}
?>

<?php
if (!empty($rows)) {
?>
<div class="mb-3 module_row_field">
    <?php
    $this->Form->label($row_name, 'module_row', ['class' => 'form-label']);
    $this->Form->fieldSelect('module_row', $rows, ($vars->module_row ?? 0), ['id' => 'module_row', 'class' => 'form-select']);
    ?>
</div>
<?php
} else {
    $this->Form->fieldHidden('module_row', ($vars->module_row ?? 0), ['id' => 'module_row']);
}

// Show module fields
if (isset($input_html) && ($module_field_html = $input_html->generate(null, $this->view))) {
?>
<div class="mb-3">
    <?php
    echo $module_field_html;
    ?>
</div>
<?php
}
?>

<script type="text/javascript">
    // Initialize Bootstrap tooltips
    document.querySelectorAll('#module_options [data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
    });

    // If no group selected hide row listing
    <?php
    if (!empty($groups)) {
    ?>
    if (document.getElementById('module_group').value != "") {
        document.querySelectorAll('.module_row_field').forEach(function(el) { el.style.display = 'none'; });
        document.querySelectorAll('.module_group_client_field').forEach(function(el) { el.style.display = 'none'; });
    }
    if (document.getElementById('module_group_client').checked) {
        document.querySelectorAll('.module_row_field').forEach(function(el) { el.style.display = 'none'; });
    }
    <?php
    }
    ?>

    // If group changes, determine if row listing should be shown
    document.getElementById('module_group').addEventListener('change', function() {
        if (this.value != "") {
            document.querySelectorAll('.module_row_field').forEach(function(el) { el.style.display = 'none'; });
            document.querySelectorAll('.module_group_client_field').forEach(function(el) { el.style.display = 'none'; });
        } else {
            document.querySelectorAll('.module_row_field').forEach(function(el) { el.style.display = ''; });
            document.querySelectorAll('.module_group_client_field').forEach(function(el) { el.style.display = ''; });
        }
    });

    // Hide row fields if client can select the module group
    <?php
    if (!empty($groups)) {
    ?>
    document.getElementById('module_group_client').addEventListener('change', function() {
        if (this.checked) {
            document.querySelectorAll('.module_row_field').forEach(function(el) { el.style.display = 'none'; });
            document.querySelectorAll('.module_groups_field').forEach(function(el) { el.style.display = ''; });
        } else {
            document.querySelectorAll('.module_row_field').forEach(function(el) { el.style.display = ''; });
            document.querySelectorAll('.module_groups_field').forEach(function(el) { el.style.display = 'none'; });
        }
    });
    document.getElementById('module_group_client').dispatchEvent(new Event('change'));
    <?php
    }
    ?>
</script>
