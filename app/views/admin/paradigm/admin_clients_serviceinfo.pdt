<?php /** @var View $this **/ ?>

<?php
if ((isset($service->cancellation_reason) ? $service->cancellation_reason : null)) {
?>
<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle me-2"></i><?php $this->_('AdminClients.serviceinfo.cancellation_reason', false, $service->cancellation_reason);?>
</div>
<?php }

if ((isset($content) ? $content : null)) {
?>
<div class="p-3 service-info-content">
    <?php echo $content;?>
</div>
<?php
} else {
?>
<div class="text-center py-4 text-muted">
    <p class="mb-0"><?php $this->_('AdminClients.serviceinfo.no_results');?></p>
</div>
<?php
}

// List add-on services
if (($num_services = count((isset($services) ? $services : []))) > 0) {
?>
<div id="service-info-list<?php echo (isset($service->id) ? $service->id : null); ?>" class="px-3 pb-3 mt-4">
    <h6 class="form-section-header">
        <?php $this->_('AdminClients.services.heading_addons');?>
    </h6>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th class="text-center" style="width: 40px;"></th>
                    <th><?php $this->_('AdminClients.services.heading_package');?></th>
                    <th><?php $this->_('AdminClients.services.heading_label');?></th>
                    <th><?php $this->_('AdminClients.services.heading_term');?></th>
                    <th class="text-end"><?php $this->_('AdminClients.services.heading_options');?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                for ($i = 0; $i < $num_services; $i++) {
                    $icon = 'check-circle';
                    switch ((isset($services[$i]->status) ? $services[$i]->status : null)) {
                        case 'pending':
                            $icon = 'clock';
                            break;
                        case 'suspended':
                            $icon = 'exclamation-triangle';
                            break;
                        case 'canceled':
                            $icon = 'x-circle';
                            break;
                        case 'active':
                            if (!empty($services[$i]->date_canceled)) {
                                $icon = 'calendar-x';
                            }
                            break;
                    }
                ?>
                <tr data-collapse-row aria-expanded="false" data-service-id="<?php echo $this->Html->safe((isset($services[$i]->id) ? $services[$i]->id : null));?>" style="cursor: pointer;">
                    <td class="text-center">
                        <i class="bi bi-<?php (print (isset($icon) ? $this->Html->safe($icon) : null));?> text-muted"></i>
                    </td>
                    <td><?php (print (isset($services[$i]->package->name) ? $this->Html->safe($services[$i]->package->name) : null));?></td>
                    <td><?php (print (isset($services[$i]->name) ? $this->Html->safe($services[$i]->name) : null));?></td>
                    <td>
                        <?php
                        if ((isset($services[$i]->package_pricing->period) ? $services[$i]->package_pricing->period : null) == 'onetime') {
                            (print (isset($periods[$services[$i]->package_pricing->period]) ? $this->Html->safe($periods[$services[$i]->package_pricing->period]) : null));
                        } else {
                            $term = (isset($services[$i]->package_pricing->term) ? $this->Html->safe($services[$i]->package_pricing->term) : null);
                            $period = ($term == 1 ? (isset($periods[$services[$i]->package_pricing->period]) ? $periods[$services[$i]->package_pricing->period] : null) : (isset($periods[$services[$i]->package_pricing->period . '_plural']) ? $periods[$services[$i]->package_pricing->period . '_plural'] : null));
                            $renewal_price = $this->CurrencyFormat->format((isset($services[$i]->renewal_price) ? $services[$i]->renewal_price : null), (isset($services[$i]->override_currency) ? $services[$i]->override_currency : (isset($services[$i]->package_pricing->currency) ? $services[$i]->package_pricing->currency : null)));
                            $this->_('AdminClients.services.recurring_term', false, $this->Html->safe($term), $this->Html->safe($period), $this->Html->safe($renewal_price));
                        }
                        ?>
                    </td>
                    <td class="text-end">
                        <a href="<?php echo $this->base_uri . 'clients/editservice/' . (isset($client->id) ? $this->Html->safe($client->id) : null) . '/' . (isset($services[$i]->id) ? $this->Html->safe($services[$i]->id) : null) . '/';?>" class="btn btn-sm btn-outline-secondary manage-link">
                            <i class="bi bi-gear"></i>
                        </a>
                        <?php
                        if (in_array(($services[$i]->status ?? null), ['pending', 'canceled'])) {
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-danger service-delete-btn"
                            data-delete-id="<?php echo $this->Html->safe(isset($services[$i]->id) ? $services[$i]->id : null);?>"
                            data-confirm-message="<?php echo $this->Html->safe($this->_('AdminClients.services.confirm_delete', true));?>"
                            title="<?php $this->_('AdminClients.services.option_delete');?>">
                            <i class="bi bi-trash"></i>
                        </button>
                        <?php
                        }
                        ?>
                    </td>
                </tr>
                <tr class="collapse">
                    <td colspan="5" style="padding: 0; background-color: var(--bg-secondary);">
                        <div class="service-info-container" data-service-id="<?php echo $this->Html->safe((isset($services[$i]->id) ? $services[$i]->id : null));?>">
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm text-secondary" role="status">
                                    <span class="visually-hidden"><?php $this->_('AppController.text_loading');?></span>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
            </tbody>
        </table>
    </div>
</div>
<?php
}
