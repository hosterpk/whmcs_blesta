<?php /** @var View $this **/ ?>


<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

<?php
$this->Widget->clear();
$this->Widget->create($this->_('AdminSystemCompanies.add.boxtitle_addcompany', true), ['id' => 'admin_system_companies_add']);
?>
    <?php $this->Form->create(null, ['class' => 'disable-on-submit']);?>

