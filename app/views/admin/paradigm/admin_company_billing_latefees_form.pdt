<?php /** @var View $this **/ ?>


            <div class="mb-3 form-check">
                <?php
                $this->Form->fieldCheckbox(
                    'late_fee_total_amount',
                    '1',
                    (isset($vars['late_fee_total_amount']) ? $vars['late_fee_total_amount'] : null) == '1',
                    ['id' => 'late_fee_total_amount', 'class' => 'form-check-input']
                );
                ?>
                <label for="late_fee_total_amount" class="form-check-label">
                    <?php $this->_('AdminCompanyBilling.latefees.field.late_fee_total_amount');?>
                    <i class="bi bi-info-circle ms-1"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="<?php echo $this->Html->safe($this->_('AdminCompanyBilling.!tooltip.late_fee_total_amount', true));?>"></i>
                </label>
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 80px;"><?php $this->_('AdminCompanyBilling.latefees.text_enabled');?></th>
                            <th class="text-center" style="width: 100px;"><?php $this->_('AdminCompanyBilling.latefees.text_currency');?></th>
                            <th><?php $this->_('AdminCompanyBilling.latefees.text_fee_type');?></th>
                            <th><?php $this->_('AdminCompanyBilling.latefees.text_amount');?></th>
                            <th><?php $this->_('AdminCompanyBilling.latefees.text_minimum');?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php
                        $i = 0;
                        foreach ((isset($currencies) ? $currencies : []) as $currency) {
                            $disabled = [];
                            if ((isset($vars['late_fees'][$currency->code]['fee_type']) ? $vars['late_fees'][$currency->code]['fee_type'] : null) == 'fixed') {
                                $disabled = ['disabled' => 'disabled'];
                            }
                        ?>
                            <tr<?php echo (($i % 2 == 1) ? ' class="table-secondary"' : '');?>>
                                <td class="text-center">
                                    <?php
                                    $this->Form->fieldCheckbox(
                                        'late_fees[' . $currency->code . '][enabled]',
                                        'true',
                                        (isset($vars['late_fees'][$currency->code]['enabled']) ? $vars['late_fees'][$currency->code]['enabled'] : null) == 'true',
                                        ['id' => 'enabled_' . $currency->code, 'class' => 'form-check-input']
                                    );
                                    ?>
                                </td>
                                <td class="text-center">
                                    <strong><?php (print (isset($currency->code) ? $this->Html->safe($currency->code) : null));?></strong>
                                </td>
                                <td>
                                    <div class="form-check form-check-inline">
                                        <?php
                                        $this->Form->fieldRadio(
                                            'late_fees[' . $currency->code . '][fee_type]',
                                            'percent',
                                            (isset($vars['late_fees'][$currency->code]['fee_type']) ? $vars['late_fees'][$currency->code]['fee_type'] : 'percent') == 'percent',
                                            ['id' => 'fee_type_percent_' . $currency->code, 'class' => 'form-check-input fee_type']
                                        );
                                        ?>
                                        <label for="fee_type_percent_<?php echo $this->Html->safe($currency->code);?>" class="form-check-label">
                                            <?php $this->_('AdminCompanyBilling.latefees.field.percent');?>
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <?php
                                        $this->Form->fieldRadio(
                                            'late_fees[' . $currency->code . '][fee_type]',
                                            'fixed',
                                            (isset($vars['late_fees'][$currency->code]['fee_type']) ? $vars['late_fees'][$currency->code]['fee_type'] : 'percent') == 'fixed',
                                            ['id' => 'fee_type_fixed_' . $currency->code, 'class' => 'form-check-input fee_type']
                                        );
                                        ?>
                                        <label for="fee_type_fixed_<?php echo $this->Html->safe($currency->code);?>" class="form-check-label">
                                            <?php $this->_('AdminCompanyBilling.latefees.field.fixed');?>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <?php
                                    $this->Form->fieldText(
                                        'late_fees[' . $currency->code . '][amount]',
                                        (isset($vars['late_fees'][$currency->code]['amount']) ? $vars['late_fees'][$currency->code]['amount'] : null),
                                        ['class' => 'form-control form-control-sm amount', 'id' => 'amount_' . $currency->code]
                                    );
                                    ?>
                                </td>
                                <td>
                                    <?php
                                    $this->Form->fieldText(
                                        'late_fees[' . $currency->code . '][minimum]',
                                        (isset($vars['late_fees'][$currency->code]['minimum']) ? $vars['late_fees'][$currency->code]['minimum'] : null),
                                        array_merge(['class' => 'form-control form-control-sm minimum', 'id' => 'minimum_' . $currency->code], $disabled)
                                    );
                                    ?>
                                </td>
                            </tr>
                        <?php
                            $i++;
                        }
                        ?>
                    </tbody>
                </table>
            </div>
