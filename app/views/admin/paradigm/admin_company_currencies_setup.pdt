        <script>
        /**
         * Toggle exchange rate processor API key field
         */
        document.addEventListener('DOMContentLoaded', function() {
            const processorSelect = document.getElementById('exchange_rates_processor');
            const erpKeyField = document.getElementById('erp_key');

            if (!processorSelect || !erpKeyField) return;

            // Create array of processors that require keys
            const requiresKey = [
                <?php
                $processor_keys = [];
                foreach ((isset($exchange_rate_processor_data) ? $exchange_rate_processor_data : []) as $data) {
                    if ($data->requires_key) {
                        $processor_keys[] = '"' . $this->Html->safe($data->processor) . '"';
                    }
                }
                echo implode(',', $processor_keys);
                ?>
            ];

            function toggleErpKey() {
                if (requiresKey.includes(processorSelect.value)) {
                    erpKeyField.style.display = 'block';
                } else {
                    erpKeyField.style.display = 'none';
                }
            }

            // Initialize on page load
            toggleErpKey();

            // Update when selection changes
            processorSelect.addEventListener('change', toggleErpKey);
        });
        </script>
