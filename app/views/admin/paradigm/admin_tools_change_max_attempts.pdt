<?php /** @var View $this **/ ?>

<div class="card m-0">
    <div class="card-body">
        <?php
        $this->Form->create(null, ['id' => 'edit_max_attempts_' . ($service->id ?? null)]);
        ?>
            <div class="mb-3">
                <?php
                $this->Form->label($this->_('AdminTools.change_max_attempts.field_max_attempts', true), 'max_attempts_' . ($service->id ?? null), ['class' => 'form-label']);
                $this->Form->fieldText('max_attempts', $service->maximum_attempts, ['id' => 'max_attempts_' . ($service->id ?? null), 'class' => 'form-control']);
                ?>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a href="#" class="btn btn-secondary close"><?php $this->_('AdminTools.change_max_attempts.field_cancel');?></a>
                <?php
                $this->Form->fieldSubmit('save', $this->_('AdminTools.change_max_attempts.btn_save', true), ['class' => 'btn btn-primary']);
                ?>
            </div>
        <?php
        $this->Form->end();
        ?>
    </div>
</div>

