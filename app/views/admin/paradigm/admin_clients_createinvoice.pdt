<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var totalsUri = <?php echo json_encode((isset($this->base_uri) ? $this->Html->safe($this->base_uri) : null) . 'clients/calcLineTotals/' . (isset($client->id) ? $this->Html->safe($client->id) : null));?>;
    var form = document.getElementById('create-invoice');
    var lineItemsBody = document.getElementById('invoiceLineItemsBody');
    var autoSaveInterval = 60000;
    var focused = false;

    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function(el) {
        return new bootstrap.Tooltip(el);
    });

    // On load calculate totals
    calculateTotals();

    // Initialize date pickers
    if (typeof blestaBindDatePicker === 'function') {
        blestaBindDatePicker();
    }

    // Initialize SortableJS for line items
    if (typeof Sortable !== 'undefined' && lineItemsBody) {
        Sortable.create(lineItemsBody, {
            animation: 150,
            handle: '.sortable-drag-handle',
            ghostClass: 'sortable-ghost',
            onEnd: function() {
                calculateTotals();
            }
        });
    }

    // Event delegation for tax checkbox changes
    lineItemsBody.addEventListener('change', function(e) {
        if (e.target.classList.contains('line-item-tax-cb')) {
            var row = e.target.closest('tr');
            var hiddenTax = row.querySelector('.line-tax');
            if (hiddenTax) {
                hiddenTax.value = e.target.checked ? 'true' : 'false';
            }
            calculateTotals();
        }

        // Update totals when quantity or amount changes
        if (e.target.classList.contains('line-item-quantity') || e.target.classList.contains('line-item-unit-cost')) {
            calculateTotals();
        }
    });

    // Currency change handler
    document.getElementById('currency').addEventListener('change', calculateTotals);

    // Handle Shift+Enter in description input to convert to textarea
    lineItemsBody.addEventListener('keydown', function(e) {
        if (
            e.key === 'Enter'
            && e.shiftKey
            && e.target.classList.contains('line-item')
            && e.target.tagName === 'INPUT'
        ) {
            e.preventDefault();
            var input = e.target;
            var textarea = document.createElement('textarea');
            for (var i = 0; i < input.attributes.length; i++) {
                if (input.attributes[i].name !== 'type') {
                    textarea.setAttribute(input.attributes[i].name, input.attributes[i].value);
                }
            }
            textarea.value = input.value;
            input.parentNode.replaceChild(textarea, input);
            textarea.focus();
        }
    });

    // Check the 'number of times' field
    var durationTime = document.getElementById('duration_time');
    if (durationTime) {
        durationTime.addEventListener('focus', function() {
            var durationRadio = document.getElementById('duration');
            if (durationRadio) {
                durationRadio.checked = true;
            }
        });
    }

    // Remove blank lines when the form is submitted
    form.addEventListener('submit', function(e) {
        var lineRows = document.querySelectorAll('.line-row');
        lineRows.forEach(function(row) {
            var lineItem = row.querySelector('input.line-item');
            var lineQty = row.querySelector('input.line-item-quantity');
            var lineAmount = row.querySelector('input.line-item-unit-cost');

            if (lineItem && lineQty && lineAmount &&
                lineItem.value.length <= 0 &&
                lineQty.value.length <= 0 &&
                lineAmount.value.length <= 0) {
                var deleteBtn = row.querySelector('.line-row-delete');
                if (deleteBtn) {
                    deleteBtn.click();
                }
            }
        });
    });

    // Event delegation for add/delete buttons and auto-add functionality
    lineItemsBody.addEventListener('click', function(e) {
        var addBtn = e.target.closest('.line-row-add');
        var deleteBtn = e.target.closest('.line-row-delete');

        if (addBtn) {
            e.preventDefault();
            var firstRow = document.querySelector('tr.line-row');
            if (!firstRow) return;

            var fields = firstRow.cloneNode(true);
            fields.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function(el) {
                el.value = '';
            });
            fields.querySelectorAll('input[type="checkbox"], input[type="radio"]').forEach(function(el) {
                el.checked = false;
            });

            var descriptionField = fields.querySelector('textarea.line-item');
            if (descriptionField) {
                var input = document.createElement('input');
                input.type = 'text';
                for (var i = 0; i < descriptionField.attributes.length; i++) {
                    var attr = descriptionField.attributes[i];
                    if (attr.name !== 'type' && attr.name !== 'rows' && attr.name !== 'cols') {
                        input.setAttribute(attr.name, attr.value);
                    }
                }
                descriptionField.parentNode.replaceChild(input, descriptionField);
            }

            var currentRow = addBtn.closest('tr');
            currentRow.insertAdjacentElement('afterend', fields);

            var lineId = fields.querySelector('.line_id');
            if (lineId) lineId.remove();
        }

        if (deleteBtn) {
            e.preventDefault();
            var lineRows = document.querySelectorAll('tr.line-row');
            if (lineRows.length <= 1) return;

            var currentRow = deleteBtn.closest('tr');
            var lineItem = currentRow.querySelector('.line_id');
            var lastRow = document.querySelector('tr.line-row:last-child');

            if (lineItem && lastRow && lineItem.value) {
                var cloned = lineItem.cloneNode(true);
                lastRow.insertAdjacentElement('afterend', cloned);
            }

            currentRow.remove();
            calculateTotals();
        }
    });

    // Auto-add new line when typing in description
    lineItemsBody.addEventListener('input', function(e) {
        if (e.target.classList.contains('line-item')) {
            if (e.target.value.length > 1) return;

            var currentRow = e.target.closest('.line-row');
            var nextRow = currentRow.nextElementSibling;
            var blankLineAfter = nextRow ? nextRow.querySelector('input.line-item') : null;
            if (!blankLineAfter) {
                var addBtn = currentRow.querySelector('.line-row-add');
                if (addBtn) addBtn.click();
            }
        }
    });

    function calculateTotals() {
        var formData = new FormData(form);
        fetch(totalsUri, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data) {
                // Update subtotal
                var subtotalEl = document.getElementById('invoiceSubtotal');
                if (subtotalEl && data.subtotal) subtotalEl.textContent = data.subtotal.amount_formatted;

                // Update tax lines
                for (var i = 0; i < 2; i++) {
                    var taxLine = document.getElementById('taxLine' + (i + 1));
                    var taxLabel = document.getElementById('taxLabel' + (i + 1));
                    var taxAmount = document.getElementById('taxAmount' + (i + 1));

                    if (taxLine && taxLabel && taxAmount) {
                        if (data.tax && data.tax[i]) {
                            taxLabel.textContent = data.tax[i].name;
                            taxAmount.textContent = data.tax[i].amount_formatted;
                            taxLine.style.display = 'flex';
                        } else {
                            taxLine.style.display = 'none';
                        }
                    }
                }

                // Update total
                var totalEl = document.getElementById('invoiceTotal');
                if (totalEl && data.total) totalEl.textContent = data.total.amount_formatted;

                // Update paid/due if applicable
                var paidLine = document.getElementById('paidLine');
                var dueLine = document.getElementById('dueLine');
                var paidEl = document.getElementById('invoicePaid');
                var dueEl = document.getElementById('invoiceDue');
                var totalLabel = document.getElementById('totalLabel');

                if (data.total_paid && data.total_paid.amount > 0) {
                    if (paidEl) paidEl.textContent = data.total_paid.amount_formatted;
                    if (dueEl) dueEl.textContent = data.total_due.amount_formatted;
                    if (paidLine) paidLine.style.display = 'flex';
                    if (dueLine) dueLine.style.display = 'flex';
                } else {
                    if (paidLine) paidLine.style.display = 'none';
                    if (dueLine) dueLine.style.display = 'none';
                }
            }
        })
        .catch(function(error) {
            console.error('Error updating totals:', error);
        });
    }

    function autoSave() {
        var formData = new FormData(form);
        var autoSaveStatus = document.querySelector('.auto-save-status');

        fetch(form.action, {
            method: form.method || 'POST',
            body: new URLSearchParams(formData),
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            var text = <?php echo json_encode($this->_('AdminClients.createinvoice.auto_save_error', true));?>;
            var icon = 'bi bi-x-circle';
            if (data.success) {
                text = <?php echo json_encode($this->_('AdminClients.createinvoice.auto_save_saved', true));?>;
                icon = 'bi bi-check-circle';

                var invoiceIdField = document.getElementById('invoice_id');
                if (invoiceIdField && data.invoice_id) {
                    invoiceIdField.value = data.invoice_id;
                }

                document.querySelectorAll('.line-row .line_id').forEach(function(el) {
                    el.remove();
                });

                if (data.invoice && data.invoice.line_items) {
                    document.querySelectorAll('.line-row').forEach(function(row, index) {
                        if (data.invoice.line_items[index]) {
                            var input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = 'lines[id][]';
                            input.value = data.invoice.line_items[index].id;
                            input.className = 'line_id';
                            row.insertBefore(input, row.firstChild);
                        }
                    });
                }
            }

            if (autoSaveStatus) {
                autoSaveStatus.innerHTML = '<i class="' + icon + '"></i> ' + text;
                autoSaveStatus.style.display = 'block';
                setTimeout(function() {
                    autoSaveStatus.style.display = 'none';
                }, 2000);
            }

            setTimeout(autoSave, autoSaveInterval);
        })
        .catch(function() {
            setTimeout(autoSave, autoSaveInterval);
        });
    }

    // Begin auto save after form gains focus
    var inputs = form.querySelectorAll('input');
    inputs.forEach(function(input) {
        input.addEventListener('focus', function() {
            if (!focused) {
                setTimeout(autoSave, autoSaveInterval);
                focused = true;
            }
        });
    });
});
</script>
