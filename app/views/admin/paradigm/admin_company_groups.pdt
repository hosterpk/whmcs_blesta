<?php /** @var View $this **/ ?>

        <?php
        if (!(isset($is_ajax) ? $is_ajax : false)) {
        ?>
        <div class="main-content-padding">
            <?php echo (isset($message) ? $message : null);?>
        <?php
        }
        $this->Widget->clear();
        $this->Widget->setLinkButtons([
            [
                'name' => '',
                'icon' => 'bi-plus-lg',
                'attributes' => ['href' => $this->base_uri . 'settings/company/groups/add/', 'title' => $this->_('AdminCompanyGroups.index.categorylink_addgroup', true)]
            ]
        ]);
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminCompanyGroups.index.boxtitle_groups', true), ['id' => 'admin_company_groups'], ($render_section ?? null));
        ?>

                <?php
                if ((isset($groups) ? $groups : false) && count($groups) > 0) {
                ?>
                <div class="table-responsive">
                        <table class="table table-hover mb-0" id="groups">
                            <thead>
                                <tr>
                                    <th style="width: 150px;">
                                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/groups/?sort=name&order=' . ($sort == 'name' ? $negate_order : $order));?>"
                                           class="ajax text-decoration-none<?php echo $sort == 'name' ? ' ' . $order : '';?>">
                                            <?php $this->_('AdminCompanyGroups.index.text_name');?>
                                            <?php if ($sort == 'name') { ?>
                                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                            <?php } ?>
                                        </a>
                                    </th>
                                    <th>
                                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/groups/?sort=description&order=' . ($sort == 'description' ? $negate_order : $order));?>"
                                           class="ajax text-decoration-none<?php echo $sort == 'description' ? ' ' . $order : '';?>">
                                            <?php $this->_('AdminCompanyGroups.index.text_description');?>
                                            <?php if ($sort == 'description') { ?>
                                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                            <?php } ?>
                                        </a>
                                    </th>
                                    <th style="width: 180px;">
                                        <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/groups/?sort=num_clients&order=' . ($sort == 'num_clients' ? $negate_order : $order));?>"
                                           class="ajax text-decoration-none<?php echo $sort == 'num_clients' ? ' ' . $order : '';?>">
                                            <?php $this->_('AdminCompanyGroups.index.text_clients');?>
                                            <?php if ($sort == 'num_clients') { ?>
                                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                            <?php } ?>
                                        </a>
                                    </th>
                                    <th style="width: 1%;"><?php $this->_('AdminCompanyGroups.index.text_options');?></th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                foreach ($groups as $group) {
                                    // Truncate long descriptions
                                    $description = $this->Html->safe($group->description ?? '');
                                    if (strlen($description) > 40) {
                                        if (function_exists('mb_strimwidth')) {
                                            $description = mb_strimwidth($description, 0, 40) . '...';
                                        } else {
                                            $description = substr($description, 0, 40) . '...';
                                        }
                                    }

                                    // Get group color
                                    $bg_color = $this->Color->hex($group->color ?? '#6c757d')->asHtml();
                                    $text_color = $this->Color->hex($group->color ?? '#6c757d')->contrastYiq()->asHtml();
                                ?>
                                <tr>
                                    <td>
                                        <span class="badge" style="background-color: <?php echo $bg_color;?>; color: <?php echo $text_color;?>;">
                                            <?php echo $this->Html->safe($group->name ?? '');?>
                                        </span>
                                    </td>
                                    <td><?php echo $description;?></td>
                                    <td><?php echo $this->Html->safe($group->num_clients ?? '0');?></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="<?php echo $this->base_uri . 'settings/company/groups/edit/' . $this->Html->safe($group->id ?? '') . '/';?>"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="<?php echo $this->Html->safe($this->_('AdminCompanyGroups.index.option_edit', true));?>">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <?php
                                            // Don't allow deleting the default client group (ID 1)
                                            if (($group->id ?? 0) != 1) {
                                                $this->Form->create($this->base_uri . 'settings/company/groups/delete/', ['class' => 'd-inline']);
                                                $this->Form->fieldHidden('id', $this->Html->safe($group->id ?? ''));
                                            ?>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                                    data-confirm-message="<?php echo $this->Html->safe($this->_('AdminCompanyGroups.index.confirm_delete', true));?>"
                                                    title="<?php echo $this->Html->safe($this->_('AdminCompanyGroups.index.option_delete', true));?>">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            <?php
                                                $this->Form->end();
                                            }
                                            ?>
                                        </div>
                                    </td>
                                </tr>
                                <?php
                                }
                                ?>
                            </tbody>
                        </table>
                </div>
                <?php
                if (isset($this->Pagination) && $this->Pagination->hasPages()) {
                    $this->Widget->footer();
                    $this->Pagination->build();
                }
                ?>
                <?php } else { ?>
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                    <p class="mt-3 mb-0"><?php $this->_('AdminCompanyGroups.index.no_results');?></p>
                </div>
                <?php } ?>
        <?php
        $this->Widget->end();

        if (!(isset($is_ajax) ? $is_ajax : false)) {
        ?>
        </div>
        <?php
        }
        ?>
