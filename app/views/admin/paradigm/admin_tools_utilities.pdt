                            <div class="stat-card-icon me-3">
                                <i class="bi bi-archive"></i>
                            </div>
                            <h6 class="mb-0"><?php $this->_('AdminTools.utilities.clear_file_cache');?></h6>
                        </div>
                        <p class="text-secondary flex-grow-1">
                            <?php $this->_('AdminTools.utilities.text_clear_file_cache');?>
                        </p>
                        <button type="submit" name="clear_file_cache" class="btn btn-primary w-100">
                            <i class="bi bi-arrow-repeat me-2"></i><?php $this->_('AdminTools.utilities.field_clear_file_cache');?>
                        </button>
                    </div>
                </div>
            </div>

            <!-- System Integrity Check Utility -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
