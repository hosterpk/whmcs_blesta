<!-- Fetch API Key Modal -->
<div class="modal fade" id="fetchApiKeyModal" tabindex="-1" aria-labelledby="fetchApiKeyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fetchApiKeyModalLabel"><?php $this->_('AdminSystemAi.modal.heading_fetch');?></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<?php $this->_('AppController.modal.text_close');?>"></button>
            </div>
            <div class="modal-body" id="fetchApiKeyModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Initialize Bootstrap tooltips
document.addEventListener('DOMContentLoaded', function() {
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    // API Key elements
    const apiKeyInput = document.getElementById('ai_api_key');
    const toggleApiKeyBtn = document.getElementById('toggleApiKey');
    const apiKeyStatus = document.getElementById('apiKeyStatus');
    const apiKeySpinner = document.getElementById('apiKeySpinner');
    const apiKeySuccess = document.getElementById('apiKeySuccess');
    const apiKeyError = document.getElementById('apiKeyError');
    const apiKeyFeedback = document.getElementById('apiKeyFeedback');
    const modelSection = document.getElementById('modelParametersSection');
    const modelSelect = document.getElementById('ai_default_model');

    let validateTimeout = null;
    let lastValidatedKey = null; // Track what we've successfully validated
    let validatedKeys = {}; // Cache of validated keys and their results
    const initialKey = '<?php echo $this->Html->safe($vars['ai_api_key'] ?? ''); ?>';

    // If we have models loaded, the initial key is already validated
    if (initialKey && modelSection && modelSection.style.display !== 'none') {
        lastValidatedKey = initialKey;
        validatedKeys[initialKey] = true;
    }

    // Toggle API Key visibility
    if (toggleApiKeyBtn && apiKeyInput) {
        toggleApiKeyBtn.addEventListener('click', function() {
            const icon = this.querySelector('i');
            if (apiKeyInput.type === 'password') {
                apiKeyInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                apiKeyInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });
    }

    // Show validation status
    function showValidationStatus(status, message) {
        apiKeyStatus.classList.remove('d-none');
        apiKeySpinner.classList.add('d-none');
        apiKeySuccess.classList.add('d-none');
        apiKeyError.classList.add('d-none');

        if (status === 'loading') {
            apiKeySpinner.classList.remove('d-none');
            apiKeyFeedback.innerHTML = '<span class="text-muted"><?php echo $this->Html->safe($this->_('AdminSystemAi.index.text_validating', true)); ?></span>';
        } else if (status === 'success') {
            apiKeySuccess.classList.remove('d-none');
            apiKeyFeedback.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i><?php echo $this->Html->safe($this->_('AdminSystemAi.index.text_key_valid', true)); ?></span>';
        } else if (status === 'error') {
            apiKeyError.classList.remove('d-none');
            apiKeyFeedback.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>' + message + '</span>';
        } else {
            apiKeyStatus.classList.add('d-none');
            apiKeyFeedback.innerHTML = '';
        }
    }

    // Populate models dropdown
    function populateModels(models, currentModel) {
        modelSelect.innerHTML = '';
        models.forEach(function(model) {
            const option = document.createElement('option');
            option.value = model.id;
            option.textContent = model.label;
            if (currentModel && model.id === currentModel) {
                option.selected = true;
            }
            modelSelect.appendChild(option);
        });
    }

    // Validate and save API key
    function validateApiKey(key, force) {
        if (!key || key.trim() === '') {
            showValidationStatus('hide');
            modelSection.style.display = 'none';
            return;
        }

        // Check cache - don't re-validate keys we've already validated
        if (!force && validatedKeys[key] !== undefined) {
            if (validatedKeys[key] === true) {
                // Already validated successfully
                lastValidatedKey = key;
                showValidationStatus('success');
                modelSection.style.display = 'block';
            } else {
                // Previously failed
                showValidationStatus('error', validatedKeys[key]);
                modelSection.style.display = 'none';
            }
            return;
        }

        showValidationStatus('loading');

        fetch('<?php echo $this->Html->safe($this->base_uri . 'settings/system/ai/validateapikey/'); ?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'api_key=' + encodeURIComponent(key) + '&_csrf_token=<?php echo $this->Form->getCsrfToken(); ?>'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                lastValidatedKey = key;
                validatedKeys[key] = true; // Cache success
                showValidationStatus('success');
                populateModels(data.models, modelSelect.value || '<?php echo $this->Html->safe($vars['ai_default_model'] ?? ''); ?>');
                modelSection.style.display = 'block';

                // Update balance display if available
                if (data.balance) {
                    updateBalanceDisplay(data.balance);
                }
            } else {
                validatedKeys[key] = data.error || 'Invalid API key'; // Cache error message
                showValidationStatus('error', validatedKeys[key]);
                modelSection.style.display = 'none';
            }
        })
        .catch(error => {
            // Don't cache network errors - allow retry
            showValidationStatus('error', 'Failed to validate key. Please try again.');
            modelSection.style.display = 'none';
        });
    }

    // Update balance display (if the card exists)
    function updateBalanceDisplay(balance) {
        const creditsRemaining = document.getElementById('credits-remaining');
        const creditsUsed = document.getElementById('credits-used');
        const creditsProgressBar = document.getElementById('credits-progress-bar');

        if (creditsRemaining) {
            const remaining = parseFloat(balance.remaining || 0).toFixed(2);
            const limit = parseFloat(balance.limit || 1000).toFixed(2);
            creditsRemaining.textContent = remaining + ' / ' + limit;
        }
        if (creditsUsed) {
            creditsUsed.textContent = parseFloat(balance.used || 0).toFixed(2);
        }
        if (creditsProgressBar) {
            const percentage = balance.limit > 0 ? (balance.remaining / balance.limit) * 100 : 0;
            creditsProgressBar.style.width = percentage + '%';
            creditsProgressBar.classList.remove('bg-success', 'bg-warning', 'bg-danger');
            creditsProgressBar.classList.add(percentage > 50 ? 'bg-success' : (percentage > 25 ? 'bg-warning' : 'bg-danger'));
        }
    }

    // Auto-validate on input change (debounced)
    if (apiKeyInput) {
        let pendingValidation = false;

        apiKeyInput.addEventListener('input', function() {
            clearTimeout(validateTimeout);
            const key = this.value.trim();

            if (!key) {
                pendingValidation = false;
                showValidationStatus('hide');
                modelSection.style.display = 'none';
                return;
            }

            // Mark that we have a pending validation
            pendingValidation = true;

            // Debounce - wait 800ms after user stops typing
            validateTimeout = setTimeout(function() {
                pendingValidation = false;
                validateApiKey(key);
            }, 800);
        });

        // On blur: only validate immediately if there's a pending debounced validation
        apiKeyInput.addEventListener('blur', function() {
            if (pendingValidation) {
                clearTimeout(validateTimeout);
                pendingValidation = false;
                const key = this.value.trim();
                if (key) {
                    validateApiKey(key);
                }
            }
        });
    }

    // Toggle staff groups visibility based on chatbot checkbox
    const chatbotCheckbox = document.getElementById('ai_feature_chatbot');
    const staffGroupsContainer = document.getElementById('chatbot_staff_groups_container');

    function toggleChatbotStaffGroups() {
        if (chatbotCheckbox && staffGroupsContainer) {
            staffGroupsContainer.style.display = chatbotCheckbox.checked ? 'block' : 'none';
        }
    }

    // Initial state
    toggleChatbotStaffGroups();

    // On change
    if (chatbotCheckbox) {
        chatbotCheckbox.addEventListener('change', toggleChatbotStaffGroups);
    }

    // Fetch API Key Modal
    const fetchBtn = document.getElementById('fetchApiKeyBtn');
    const modalElement = document.getElementById('fetchApiKeyModal');
    const modalBody = document.getElementById('fetchApiKeyModalBody');

    if (fetchBtn && modalElement) {
        const modal = new bootstrap.Modal(modalElement);

        fetchBtn.addEventListener('click', function(e) {
            e.preventDefault();

            // Show loading spinner
            modalBody.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';

            // Show modal
            modal.show();

            // Load content via AJAX
            fetch('<?php echo $this->Html->safe($this->base_uri . 'settings/system/ai/fetchmodal/');?>')
                .then(response => response.text())
                .then(html => {
                    modalBody.innerHTML = html;
                })
                .catch(error => {
                    modalBody.innerHTML = '<div class="alert alert-danger">Failed to load content. Please try again.</div>';
                });
        });

        // Listen for successful API key fetch from modal
        modalElement.addEventListener('apiKeyFetched', function(e) {
            if (e.detail && e.detail.api_key) {
                apiKeyInput.value = e.detail.api_key;
                validateApiKey(e.detail.api_key);
                modal.hide();
            }
        });
    }
});
</script>
