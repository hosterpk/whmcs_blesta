<?php /** @var View $this **/ ?>

<?php
if ((isset($applied) ? $applied : false) && ($num_applied = count($applied)) > 0) {
?>
<div class="p-3">
    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th style="width: 40px;"><i class="bi bi-arrow-return-right"></i></th>
                <th><?php $this->_('AdminClients.invoices.headingexpand_paymenttype');?></th>
                <th><?php $this->_('AdminClients.invoices.headingexpand_amount');?></th>
                <th><?php $this->_('AdminClients.invoices.headingexpand_applied');?></th>
                <th><?php $this->_('AdminClients.invoices.headingexpand_appliedon');?></th>
                <th style="width: 80px;"><?php $this->_('AdminClients.invoices.headingexpand_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_applied; $i++) {
                if ((isset($applied[$i]->type) ? $applied[$i]->type : null) == 'other' && (isset($applied[$i]->gateway_type) ? $applied[$i]->gateway_type : null) == 'nonmerchant') {
                    $trans_type = $applied[$i]->gateway_name;
                } else {
                    $trans_type = (isset($transaction_types[($applied[$i]->type_name != '' ? $applied[$i]->type_name : $applied[$i]->type)]) ? $transaction_types[($applied[$i]->type_name != '' ? $applied[$i]->type_name : $applied[$i]->type)] : null);
                }
            ?>
            <tr>
                <td>&nbsp;</td>
                <td><?php (print (isset($trans_type) ? $this->Html->safe($trans_type) : null));?></td>
                <td><?php echo $this->CurrencyFormat->format($applied[$i]->amount, $applied[$i]->currency, ['html_code' => true]);?></td>
                <td><?php echo $this->CurrencyFormat->format($applied[$i]->applied_amount, $applied[$i]->currency, ['html_code' => true]);?></td>
                <td><?php echo $this->Date->cast((isset($applied[$i]->applied_date) ? $this->Html->safe($applied[$i]->applied_date) : null), 'date_time');?></td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/edittransaction/' . (isset($client->id) ? $client->id : null) . '/' . (isset($applied[$i]->transaction_id) ? $applied[$i]->transaction_id : null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminClients.invoices.option_edit');?>">
                        <i class="bi bi-pencil"></i>
                    </a>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php
} else {
?>
<div class="text-center py-4 text-muted">
    <p class="mb-0"><?php $this->_('AdminClients.invoices.applied_no_results');?></p>
</div>
<?php
}
?>
