<?php /** @var View $this **/ ?>


                    <?php
                    if ((isset($messenger_logs) ? $messenger_logs : false)) {
                    ?>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width: 120px;"><?php $this->_('AdminTools.messengerloglist.text_direction');?></th>
                                <th><?php $this->_('AdminTools.messengerloglist.text_data');?></th>
                                <th style="width: 200px;"><?php $this->_('AdminTools.messengerloglist.text_date');?></th>
                                <th style="width: 120px;"><?php $this->_('AdminTools.messengerloglist.text_status');?></th>
                            </tr>
                        </thead>
                        <tbody>
                        <?php
                        foreach ($messenger_logs as $messenger_log) {
                            $status = (isset($messenger_log->success) ? $messenger_log->success : null) ? 'success' : 'error';
                            $icon = ($status == 'success') ? 'bi-check-lg text-success' : 'bi-x-circle text-danger';
                        ?>
                        <tr>
                            <td><?php $this->_('AdminTools.messengerloglist.text_' . (isset($messenger_log->direction) ? $this->Html->safe($messenger_log->direction) : null));?></td>
                            <td>
                                <?php
                                $this->Form->create(null, ['class' => 'disable-on-submit']);
                                $this->Form->fieldTextarea('data', (isset($messenger_log->url) ? $messenger_log->url : null) . "\n" . (isset($messenger_log->data) ? $messenger_log->data : null), ['class' => 'form-control form-control-sm', 'rows' => '7', 'style' => 'font-family: monospace; font-size: 0.85em;']);
                                $this->Form->end();
                                ?>
                            </td>
                            <td><?php echo $this->Date->cast((isset($messenger_log->date_added) ? $this->Html->safe($messenger_log->date_added) : null), 'date_time');?></td>
                            <td>
                                <i class="bi <?php (print (isset($icon) ? $this->Html->safe($icon) : null));?>"></i>
                                <?php $this->_('AdminTools.messengerloglist.text_' . $status);?>
                            </td>
                        </tr>
                        <?php
                        }
                        ?>
                        </tbody>
                    </table>
                    <?php
                    } else {
                    ?>
                    <div class="p-3 text-center text-muted">
                        <?php $this->_('AdminTools.messengerloglist.no_results');?>
                    </div>
                    <?php
                    }
                    ?>
