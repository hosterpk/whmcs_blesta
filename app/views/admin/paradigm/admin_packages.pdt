<script>
// Update bulk actions bar visibility and count
function updateBulkActions() {
    var packagesTable = document.getElementById('packages');
    var bulkActionsBar = document.getElementById('bulkActionsBar');
    var selectedCount = document.getElementById('selectedCount');

    if (!packagesTable || !bulkActionsBar) return;

    var checkedBoxes = packagesTable.querySelectorAll('.row-checkbox:checked');
    if (checkedBoxes.length > 0) {
        bulkActionsBar.style.display = 'block';
        selectedCount.textContent = checkedBoxes.length + ' <?php $this->_('AdminPackages.index.items_selected');?>';
    } else {
        bulkActionsBar.style.display = 'none';
    }
}

// Event delegation for checkboxes - works after AJAX pagination
document.addEventListener('change', function(e) {
    var packagesTable = document.getElementById('packages');
    if (!packagesTable) return;

    // Handle select all checkbox
    if (e.target.id === 'select-all') {
        var checkboxes = packagesTable.querySelectorAll('.row-checkbox');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = e.target.checked;
        });
        updateBulkActions();
        return;
    }

    // Handle individual row checkboxes
    if (e.target.classList.contains('row-checkbox')) {
        var selectAllCheckbox = document.getElementById('select-all');
        if (!e.target.checked && selectAllCheckbox) {
            selectAllCheckbox.checked = false;
        }
        updateBulkActions();
    }
});

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    updateBulkActions();
});

// Load pricing data when expandable row starts to show (uses Bootstrap collapse event)
document.addEventListener('show.bs.collapse', function(e) {
    var expandedRow = e.target;
    if (!expandedRow.classList.contains('collapse')) return;

    var container = expandedRow.querySelector('.package-pricing-container');
    if (!container) return;

    var packageId = container.getAttribute('data-package-id');

    // Only load if not already loaded
    if (!container.hasAttribute('data-loaded')) {
        fetch('<?php echo $this->base_uri;?>packages/packagepricing/' + packageId, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) {
            if (!response.ok) {
                throw new Error('HTTP error ' + response.status);
            }
            return response.text();
        })
        .then(function(html) {
            container.innerHTML = html;
            container.setAttribute('data-loaded', 'true');
        })
        .catch(function(error) {
            container.innerHTML = '<div class="alert alert-danger m-3">Error loading pricing information.</div>';
        });
    }
});

// Handle package delete buttons with custom modal to avoid bulk form conflict
document.addEventListener('click', function(e) {
    var deleteBtn = e.target.closest('.package-delete-btn');
    if (!deleteBtn) return;

    e.preventDefault();
    e.stopPropagation();

    var packageId = deleteBtn.getAttribute('data-delete-id');
    var confirmMessage = deleteBtn.getAttribute('data-confirm-message');

    // Set the package ID in the form
    document.getElementById('delete_package_id').value = packageId;

    // Create confirmation modal
    var modalEl = document.createElement('div');
    modalEl.className = 'modal fade';
    modalEl.setAttribute('tabindex', '-1');
    modalEl.innerHTML =
        '<div class="modal-dialog modal-dialog-centered">' +
            '<div class="modal-content">' +
                '<div class="modal-header border-0 pb-0">' +
                    '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>' +
                '</div>' +
                '<div class="modal-body text-center py-4">' +
                    '<div class="mb-3"><i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i></div>' +
                    '<h5 class="modal-title mb-3">Confirm Delete</h5>' +
                    '<p class="text-secondary">' + confirmMessage + '</p>' +
                '</div>' +
                '<div class="modal-footer border-0 justify-content-center">' +
                    '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>' +
                    '<button type="button" class="btn btn-danger btn-confirm">Delete</button>' +
                '</div>' +
            '</div>' +
        '</div>';

    document.body.appendChild(modalEl);
    var modal = new bootstrap.Modal(modalEl);
    var confirmed = false;

    modalEl.querySelector('.btn-confirm').addEventListener('click', function() {
        confirmed = true;
        modal.hide();
    });

    modalEl.addEventListener('hidden.bs.modal', function() {
        modalEl.remove();
        if (confirmed) {
            document.getElementById('delete_package_form').submit();
        }
    });

    modal.show();
});
</script>
