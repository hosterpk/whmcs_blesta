                                    <h6 class="mb-2"><?php $this->_('AdminPackageOptions.edit.heading_prices'); ?></h6>
                                    <table class="table table-sm price_table mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 100px;"><?php $this->_('AdminPackageOptions.edit.price_term'); ?> <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="hover focus" data-bs-content="<?php echo $this->Html->safe($this->_('AdminPackageOptions.!tooltip.option_pricing_term', true)); ?>"><i class="bi bi-info-circle text-secondary"></i></button></th>
                                                <th><?php $this->_('AdminPackageOptions.edit.price_period'); ?></th>
                                                <th><?php $this->_('AdminPackageOptions.edit.price_currency'); ?></th>
                                                <th><?php $this->_('AdminPackageOptions.edit.price_price'); ?></th>
                                                <th><?php $this->_('AdminPackageOptions.edit.price_price_renews'); ?> <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="hover focus" data-bs-content="<?php echo $this->Html->safe($this->_('AdminPackageOptions.!tooltip.price_renews', true)); ?>"><i class="bi bi-info-circle text-secondary"></i></button></th>
                                                <th><?php $this->_('AdminPackageOptions.edit.price_setup'); ?></th>
                                                <th style="width: 100px;"><?php $this->_('AdminPackageOptions.edit.price_options'); ?></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        <?php
                                        $price_rows = 1;
                                        if (isset($vars->values['pricing'][$i]['term']) && $vars->values['pricing'][$i]['term']) {
                                            $price_rows = count($vars->values['pricing'][$i]['term']);
                                        }
                                        $price = ($vars->values['pricing'][$i] ?? []);

                                        for ($j = 0; $j < $price_rows; $j++) {
                                        ?>
                                        <tr class="price_row">
                                            <td>
                                                <?php
                                                $disabled = [];
                                                if (($price['period'][$j] ?? null) == 'onetime') {
                                                    $disabled = ['disabled' => 'disabled'];
                                                }
                                                $this->Form->fieldHidden('values[pricing][][id][]', ($price['id'][$j] ?? null), ['class' => 'value_price_id']);
                                                $this->Form->fieldText('values[pricing][][term][]', ($price['term'][$j] ?? null), array_merge(['class' => 'form-control form-control-sm term'], $disabled));
                                                ?>
                                            </td>
                                            <td><?php $this->Form->fieldSelect('values[pricing][][period][]', ($periods ?? null), ($price['period'][$j] ?? 'month'), ['class' => 'form-select form-select-sm period']); ?></td>
                                            <td><?php (!empty($currencies) ? $this->Form->fieldSelect('values[pricing][][currency][]', ($currencies ?? null), ($price['currency'][$j] ?? null), ['class' => 'form-select form-select-sm']) : (print ($this->Html->safe($default_currency ?? '')))); ?></td>
                                            <td><?php $this->Form->fieldText('values[pricing][][price][]', $this->CurrencyFormat->format(($price['price'][$j] ?? null), ($price['currency'][$j] ?? null), ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false, 'decimals' => 4]), ['class' => 'form-control form-control-sm price']); ?></td>
                                            <td>
                                                <?php
                                                $renewal_price_enabled = (isset($price['price_enable_renews'][$j])
                                                        ? $price['price_enable_renews'][$j]
                                                        : (($price['price_renews'][$j] ?? null)
                                                                == ($price['price'][$j] ?? null)
                                                            || ($price['price_renews'][$j] ?? null)
                                                                === null
                                                            ? '0'
                                                            : '1')
                                                ) == '1' && ($price['period'][$j] ?? null) != 'onetime';
                                                $this->Form->fieldCheckbox('values[pricing][][price_enable_renews][]', '1', $renewal_price_enabled, array_merge(['class' => 'form-check-input price_enable_renews'], $disabled));
                                                $this->Form->fieldText('values[pricing][][price_renews][]', $this->CurrencyFormat->format(($price['price_renews'][$j] ?? null), ($price['currency'][$j] ?? null), ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false, 'decimals' => 4]), array_merge(['class' => 'form-control form-control-sm price_renews d-inline-block', 'style' => 'width: 100px;'], $disabled));
                                                ?>
                                            </td>
                                            <td><?php $this->Form->fieldText('values[pricing][][setup_fee][]', $this->CurrencyFormat->format(($price['setup_fee'][$j] ?? null), ($price['currency'][$j] ?? null), ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false, 'decimals' => 4]), ['class' => 'form-control form-control-sm setup_fee']); ?></td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-success price-row-add"><i class="bi bi-plus-circle"></i></a>
                                                <a href="#" class="btn btn-sm btn-outline-danger price-row-remove"><i class="bi bi-trash"></i></a>
                                            </td>
                                        </tr>
                                        <?php
                                        }

                                        // Repopulate removed pricing IDs so they can be deleted on submit
                                        for ($j = $price_rows; $j < count(($vars->values['pricing'][$i]['id'] ?? [])); $j++) {
                                            $this->Form->fieldHidden('values[pricing][][id][]', ($price['id'][$j] ?? null), ['class' => 'value_price_id']);
                                        }
                                        ?>
