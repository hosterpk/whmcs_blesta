                    for ($i = 0; $i < $rows; $i++) {
                    ?>
                        <tr class="option_row" style="cursor: pointer;" data-collapse-row aria-expanded="true">
                            <td class="text-center"><i class="bi bi-grip-vertical text-secondary" style="cursor: grab;"></i></td>
                            <td>
                                <?php
                                $this->Form->fieldHidden('values[id][]', ($vars->values['id'][$i] ?? null), ['class' => 'option_value_id']);
                                $this->Form->fieldText('values[name][]', ($vars->values['name'][$i] ?? null), ['class' => 'form-control form-control-sm name']);
                                ?>
                            </td>
                            <td class="value"><?php $this->Form->fieldText('values[value][]', ($vars->values['value'][$i] ?? null), ['class' => 'form-control form-control-sm']); ?></td>
                            <td class="min" style="display:none;"><?php $this->Form->fieldText('values[min][]', ($vars->values['min'][$i] ?? null), ['class' => 'form-control form-control-sm']); ?></td>
                            <td class="max" style="display:none;"><?php $this->Form->fieldText('values[max][]', ($vars->values['max'][$i] ?? null), ['class' => 'form-control form-control-sm']); ?></td>
                            <td class="step" style="display:none;"><?php $this->Form->fieldText('values[step][]', ($vars->values['step'][$i] ?? null), ['class' => 'form-control form-control-sm']); ?></td>
                            <td class="default">
                                <?php
                                if (in_array(($vars->type ?? null), ['', 'select', 'radio'])) {
                                    $this->Form->fieldRadio('values[default][]', '1', ($vars->values['default'][$i] ?? '0') == '1');
                                } elseif (($vars->type ?? null) == 'quantity') {
                                    $this->Form->fieldText('values[default][]', ($vars->values['default'][$i] ?? null), ['class' => 'form-control form-control-sm']);
                                } elseif (($vars->type ?? null) == 'checkbox') {
                                    $this->Form->fieldCheckbox('values[default][]', '1', ($vars->values['default'][$i] ?? null) == '1', ['class' => 'form-check-input']);
                                }
                                ?>
                            </td>
                            <td class="status"><?php $this->Form->fieldSelect('values[status][]', ($value_statuses ?? []), ($vars->values['status'][$i] ?? null), ['class' => 'form-select form-select-sm']); ?></td>
                            <td class="image" style="display:none;">
                                <?php
                                $existing_image = $vars->values['image'][$i] ?? null;
                                $this->Form->fieldHidden('values[existing_image][]', ($existing_image ?? ''), ['class' => 'option-value-existing-image']);
                                $this->Form->fieldHidden('values[remove_image][]', '0', ['class' => 'option-value-remove-image']);
                                ?>
                                <div class="d-flex align-items-center gap-1">
                                    <?php if ($existing_image) { ?>
                                    <img src="<?php echo $this->Html->safe(($option_image_url ?? '') . $existing_image); ?>" alt="" class="option-value-thumb" style="width:32px;height:32px;object-fit:cover;border-radius:4px;">
                                    <?php } ?>
                                    <label class="btn btn-sm btn-outline-secondary mb-0" title="Upload image">
                                        <i class="bi bi-upload"></i>
                                        <input type="file" name="values_image_<?php echo $i; ?>" accept="image/jpeg,image/png,image/gif,image/webp" class="option-value-image-input" style="display:none;">
                                    </label>
                                    <?php if ($existing_image) { ?>
                                    <button type="button" class="btn btn-sm btn-outline-danger option-value-image-remove" title="Remove image"><i class="bi bi-x-lg"></i></button>
                                    <?php } ?>
                                </div>
