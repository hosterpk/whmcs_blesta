<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    const invTypeSelect = document.getElementById('inv_type');
    const invCacheSelect = document.getElementById('inv_cache');
    const invTemplateSelect = document.getElementById('inv_template');

    // Display/hide proforma fields based on invoice type
    function displayInvType() {
        const proformaFields = document.querySelectorAll('.proforma');
        proformaFields.forEach(field => {
            field.style.display = invTypeSelect.value === 'proforma' ? 'block' : 'none';
        });
    }

    // Display/hide cache compress option
    function displayInvCacheCompress() {
        const compressWrapper = document.getElementById('inv_cache_compress_wrapper');
        if (compressWrapper) {
            compressWrapper.style.display = invCacheSelect.value === 'json_pdf' ? 'block' : 'none';
        }
    }

    // Display file type options based on template
    function displayFileType(value) {
        const templateFields = document.querySelectorAll('.inv_template');
        templateFields.forEach(field => field.style.display = 'none');

        const selectedTemplate = document.querySelector('.template_' + value);
        if (selectedTemplate) {
            selectedTemplate.style.display = 'block';
            changeMimeType(value);
        }
    }

    // Show/hide PDF-specific fields based on mimetype
    function changeMimeType(templateValue) {
        const invPdfSections = document.querySelectorAll('.inv_pdf');
        const mimetypeSelect = document.querySelector('.template_' + templateValue + ' .inv_mimetype_select');

        if (mimetypeSelect && mimetypeSelect.value === 'application/pdf') {
            invPdfSections.forEach(section => section.style.display = 'block');
        } else {
            invPdfSections.forEach(section => section.style.display = 'none');
        }
    }

    // Remove image handler
    document.addEventListener('click', function(e) {
        if (e.target.closest('.remove-image')) {
            e.preventDefault();
            const link = e.target.closest('.remove-image');
            const target = link.getAttribute('data-target');
            const section = link.closest('.' + target);

            if (section) {
                section.style.display = 'none';
                const removeInput = document.querySelector('input[name="remove_' + target + '"]');
                if (removeInput) {
                    removeInput.value = 'true';
                }
            }
        }
    });

    // Initialize displays
    displayInvType();
    displayInvCacheCompress();
    if (invTemplateSelect) {
        displayFileType(invTemplateSelect.value);
    }

    // Event listeners
    if (invTypeSelect) {
        invTypeSelect.addEventListener('change', displayInvType);
    }

    if (invCacheSelect) {
        invCacheSelect.addEventListener('change', displayInvCacheCompress);
    }

    if (invTemplateSelect) {
        invTemplateSelect.addEventListener('change', function() {
            displayFileType(this.value);
        });
    }

    // Mimetype change listeners
    document.querySelectorAll('.inv_mimetype_select').forEach(select => {
        select.addEventListener('change', function() {
            const template = this.getAttribute('data-template');
            if (template) {
                changeMimeType(template);
            }
        });
    });
});
</script>
