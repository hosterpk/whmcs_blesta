<?php /** @var View $this **/ ?>


<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->create($this->_('AdminCompanyGeneral.addcontacttype.boxtitle_addcontacttype', true), ['id' => 'admin_company_general_addcontacttype']);
    ?>
            <?php $this->Form->create(null, ['class' => 'disable-on-submit']);?>

            <div class="mb-3">
                <label for="name" class="form-label">
                    <?php $this->_('AdminCompanyGeneral.addcontacttype.field_name');?>
                </label>
                <?php
                $this->Form->fieldText(
                    'name',
                    (isset($vars->name) ? $vars->name : null),
                    ['id' => 'name', 'class' => 'form-control']
                );
                ?>
            </div>

            <div class="mb-3 form-check">
                <?php
                $this->Form->fieldCheckbox(
                    'is_lang',
                    '1',
                    ((isset($vars->is_lang) ? $vars->is_lang : null) == '1'),
                    ['id' => 'is_lang', 'class' => 'form-check-input']
                );
                ?>
                <label for="is_lang" class="form-check-label">
                    <?php $this->_('AdminCompanyGeneral.addcontacttype.field_is_lang');?>
                    <i class="bi bi-info-circle ms-1"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="<?php echo $this->Html->safe($this->_('AdminCompanyGeneral.!contacttypes.is_lang', true));?>"></i>
                </label>
            </div>

        </div>
        <?php $this->Widget->footer(); ?>
        <div class="d-flex justify-content-end">
            <?php
            $this->Form->fieldSubmit(
                'save',
                $this->_('AdminCompanyGeneral.addcontacttype.field_contacttypesubmit', true),
                ['class' => 'btn btn-primary']
            );
            ?>
        </div>
        <?php $this->Form->end();?>
<?php
$this->Widget->end();
?>
</div>

<script>
// Initialize Bootstrap tooltips
document.addEventListener('DOMContentLoaded', function() {
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
});
</script>
