<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var totalsUri = <?php echo json_encode((isset($this->base_uri) ? $this->Html->safe($this->base_uri) : null) . 'clients/calcLineTotals/' . (isset($client->id) ? $this->Html->safe($client->id) : null));?>;
    var lineItemsBody = document.getElementById('invoiceLineItemsBody');
    var selectAllCheckbox = document.getElementById('selectAllLineItems');
    var bulkActionsBar = document.getElementById('bulkActionsBar');
    var selectedItemsCount = document.getElementById('selectedItemsCount');
    var form = document.getElementById('edit-invoice');

    // Initialize SortableJS for line items
    if (typeof Sortable !== 'undefined' && lineItemsBody) {
        Sortable.create(lineItemsBody, {
            animation: 150,
            handle: '.sortable-drag-handle',
            ghostClass: 'sortable-ghost',
            onEnd: function() {
                updateLineTotals();
            }
        });
    }

    // Select All checkbox functionality
    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function() {
            var checkboxes = lineItemsBody.querySelectorAll('.line-item-checkbox');
            checkboxes.forEach(function(cb) {
                cb.checked = selectAllCheckbox.checked;
            });
            updateBulkActionsBar();
        });
    }

    // Individual checkboxes - event delegation
    lineItemsBody.addEventListener('change', function(e) {
        if (e.target.classList.contains('line-item-checkbox')) {
            var checkboxes = lineItemsBody.querySelectorAll('.line-item-checkbox');
            var allChecked = Array.from(checkboxes).every(function(cb) { return cb.checked; });
            var someChecked = Array.from(checkboxes).some(function(cb) { return cb.checked; });
            selectAllCheckbox.checked = allChecked;
            selectAllCheckbox.indeterminate = someChecked && !allChecked;
            updateBulkActionsBar();
        }

        // Sync tax checkbox with hidden field
        if (e.target.classList.contains('line-item-tax-cb')) {
            var row = e.target.closest('tr');
            var hiddenTax = row.querySelector('.line-tax');
            if (hiddenTax) {
                hiddenTax.value = e.target.checked ? 'true' : 'false';
            }
            updateLineTotals();
        }
    });

    function updateBulkActionsBar() {
        var checkboxes = lineItemsBody.querySelectorAll('.line-item-checkbox');
        var checkedCount = Array.from(checkboxes).filter(function(cb) { return cb.checked; }).length;
        selectedItemsCount.textContent = checkedCount + ' line items selected';

        if (checkedCount > 0) {
            bulkActionsBar.classList.remove('d-none');
        } else {
            bulkActionsBar.classList.add('d-none');
        }
    }

    // Add line item - event delegation
    lineItemsBody.addEventListener('click', function(e) {
        var addBtn = e.target.closest('.line-row-add');
        if (addBtn) {
            e.preventDefault();
            var firstRow = document.querySelector('tr.line-row');
            if (!firstRow) return;

            var fields = firstRow.cloneNode(true);
            fields.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function(el) {
                el.value = '';
            });
            fields.querySelectorAll('input[type="checkbox"], input[type="radio"]').forEach(function(el) {
                el.checked = false;
            });

            var descriptionField = fields.querySelector('textarea.line-item');
            if (descriptionField) {
                var input = document.createElement('input');
                input.type = 'text';
                for (var i = 0; i < descriptionField.attributes.length; i++) {
                    var attr = descriptionField.attributes[i];
                    if (attr.name !== 'type' && attr.name !== 'rows' && attr.name !== 'cols') {
                        input.setAttribute(attr.name, attr.value);
                    }
                }
                descriptionField.parentNode.replaceChild(input, descriptionField);
            }

            var currentRow = addBtn.closest('tr');
            currentRow.insertAdjacentElement('afterend', fields);

            var lineId = fields.querySelector('.line_id');
            if (lineId) {
                lineId.remove();
            }

            var serviceId = fields.querySelector('.line_service_id');
            if (serviceId) {
                serviceId.remove();
            }

            var serviceLink = fields.querySelector('td:last-child a');
            if (serviceLink) {
                serviceLink.closest('td').innerHTML = '';
            }

            updateLineTotals();
        }
    });

    // Delete line item - event delegation
    lineItemsBody.addEventListener('click', function(e) {
        var deleteBtn = e.target.closest('.line-row-delete');
        if (deleteBtn) {
            e.preventDefault();
            var rows = lineItemsBody.querySelectorAll('tr');
            if (rows.length > 1) {
                var row = deleteBtn.closest('tr');
                var lineId = row.querySelector('.line_id');
                if (lineId && lineId.value) {
                    // Move the hidden ID field to another row for deletion
                    var lastRow = rows[rows.length - 1];
                    if (lastRow !== row) {
                        var clone = lineId.cloneNode(true);
                        lastRow.insertBefore(clone, lastRow.firstChild);
                    }
                }
                row.remove();
                updateLineTotals();
                updateBulkActionsBar();
            }
        }
    });

    // Handle Shift+Enter in description input to convert to textarea
    lineItemsBody.addEventListener('keydown', function(e) {
        if (
            e.key === 'Enter'
            && e.shiftKey
            && e.target.classList.contains('line-item')
            && e.target.tagName === 'INPUT'
        ) {
            e.preventDefault();
            var input = e.target;
            var textarea = document.createElement('textarea');
            for (var i = 0; i < input.attributes.length; i++) {
                if (input.attributes[i].name !== 'type') {
                    textarea.setAttribute(input.attributes[i].name, input.attributes[i].value);
                }
            }
            textarea.value = input.value;
            input.parentNode.replaceChild(textarea, input);
            textarea.focus();
        }
    });

    // Update totals when quantity, amount, or currency changes
    lineItemsBody.addEventListener('change', function(e) {
        if (e.target.classList.contains('line-item-quantity') || e.target.classList.contains('line-item-unit-cost')) {
            updateLineTotals();
        }
    });

    document.getElementById('currency').addEventListener('change', updateLineTotals);

    function updateLineTotals() {
        if (!form) return;

        var formData = new FormData(form);
        fetch(totalsUri, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data) {
                // Update subtotal
                var subtotalEl = document.getElementById('invoiceSubtotal');
                if (subtotalEl && data.subtotal) subtotalEl.textContent = data.subtotal.amount_formatted;

                // Update tax lines
                for (var i = 0; i < 2; i++) {
                    var taxLine = document.getElementById('taxLine' + (i + 1));
                    var taxLabel = document.getElementById('taxLabel' + (i + 1));
                    var taxAmount = document.getElementById('taxAmount' + (i + 1));

                    if (taxLine && taxLabel && taxAmount) {
                        if (data.tax && data.tax[i]) {
                            taxLabel.textContent = data.tax[i].name;
                            taxAmount.textContent = data.tax[i].amount_formatted;
                            taxLine.style.display = 'flex';
                        } else {
                            taxLine.style.display = 'none';
                        }
                    }
                }

                // Update total
                var totalEl = document.getElementById('invoiceTotal');
                if (totalEl && data.total) totalEl.textContent = data.total.amount_formatted;

                // Update paid/due if applicable
                var paidLine = document.getElementById('paidLine');
                var dueLine = document.getElementById('dueLine');
                var paidEl = document.getElementById('invoicePaid');
                var dueEl = document.getElementById('invoiceDue');
                var totalLabel = document.getElementById('totalLabel');

                if (data.total_paid && data.total_paid.amount > 0) {
                    if (paidEl) paidEl.textContent = data.total_paid.amount_formatted;
                    if (dueEl) dueEl.textContent = data.total_due.amount_formatted;
                    if (paidLine) paidLine.style.display = 'flex';
                    if (dueLine) dueLine.style.display = 'flex';
                    if (totalLabel) totalLabel.textContent = <?php echo json_encode($this->_('AdminClients.editinvoice.price_total', true));?>;
                } else if (data.total_due && data.total_due.amount != data.total.amount) {
                    if (dueEl) dueEl.textContent = data.total_due.amount_formatted;
                    if (dueLine) dueLine.style.display = 'flex';
                    if (totalLabel) totalLabel.textContent = <?php echo json_encode($this->_('AdminClients.editinvoice.price_due', true));?>;
                } else {
                    if (paidLine) paidLine.style.display = 'none';
                    if (dueLine) dueLine.style.display = 'none';
                    if (totalLabel) totalLabel.textContent = <?php echo json_encode($this->_('AdminClients.editinvoice.price_total', true));?>;
                }
            }
        })
        .catch(function(error) {
            console.error('Error updating totals:', error);
        });
    }

    // Initial totals update
    updateLineTotals();

    // Handle split invoice button
    var splitBtn = document.querySelector('.split-invoice-btn');
    if (splitBtn) {
        splitBtn.addEventListener('click', function(e) {
            var confirmMessage = this.getAttribute('rel');
            if (!confirm(confirmMessage)) {
                e.preventDefault();
                return false;
            }

            var hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'submit_split';
            hiddenInput.value = '1';
            form.appendChild(hiddenInput);

            // Remove split checkboxes before submitting
            form.querySelectorAll('input[name="split[]"]').forEach(function(el) {
                el.remove();
            });
        });
    }

    // Initialize popovers
    var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
    if (typeof bootstrap !== 'undefined' && bootstrap.Popover) {
        popoverTriggerList.map(function(popoverTriggerEl) {
            return new bootstrap.Popover(popoverTriggerEl);
        });
    }
});
</script>
