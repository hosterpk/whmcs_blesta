<?php /** @var View $this **/ ?>


<div class="main-content-padding">
    <?php echo (isset($message) ? $message : null);?>

    <?php
    $this->Widget->clear();
    $this->Widget->create($this->_('AdminCompanyEmails.editsignature.boxtitle_editsignature', true), ['id' => 'admin_company_emails_editsignature']);
    $this->Form->create(null, ['class' => 'disable-on-submit']);
    ?>
            <!-- Name -->
            <div class="mb-3">
                <label for="name" class="form-label">
                    <?php $this->_('AdminCompanyEmails.editsignature.field_name');?>
                </label>
                <?php $this->Form->fieldText('name', (isset($vars->name) ? $vars->name : null), ['id' => 'name', 'class' => 'form-control']);?>
            </div>

            <!-- HTML/Text Editor Tabs -->
            <ul class="nav nav-tabs-connected" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="html-tab" data-bs-toggle="tab" data-bs-target="#html-editor" type="button" role="tab" aria-controls="html-editor" aria-selected="true"><?php $this->_('AdminCompanyEmails.editsignature.field_html');?></button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="text-tab" data-bs-toggle="tab" data-bs-target="#text-editor" type="button" role="tab" aria-controls="text-editor" aria-selected="false"><?php $this->_('AdminCompanyEmails.editsignature.field_text');?></button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content tab-content-connected">
                <div class="tab-pane fade show active" id="html-editor" role="tabpanel" aria-labelledby="html-tab">
                    <textarea id="html" name="html" style="display:none;"><?php echo (isset($vars->html) ? $this->Html->safe($vars->html) : null);?></textarea>
                </div>
                <div class="tab-pane fade" id="text-editor" role="tabpanel" aria-labelledby="text-tab">
                    <?php $this->Form->fieldTextarea('text', (isset($vars->text) ? $vars->text : null), ['id' => 'text', 'class' => 'form-control', 'rows' => 10]);?>
                </div>
            </div>
        <?php $this->Widget->footer(); ?>
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-secondary" href="<?php echo $this->base_uri;?>settings/company/emails/signatures/"><?php $this->_('AdminCompanyEmails.!cancel.field.cancel');?></a>
            <?php
            $this->Form->fieldSubmit('save', $this->_('AdminCompanyEmails.editsignature.field_editsignaturesubmit', true), ['class' => 'btn btn-primary']);
            ?>
        </div>
        <?php
        $this->Form->end();
        $this->Widget->end();
        ?>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    blestaBindWysiwygEditor('#html', {language: '<?php echo substr(Configure::get('Blesta.language'), 0, 2);?>'});
});
</script>
