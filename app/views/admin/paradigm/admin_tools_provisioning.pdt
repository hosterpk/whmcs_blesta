<?php /** @var View $this **/ ?>


        <?php
        // Don't show the message if the widget content is being replaced via AJAX
        if (!($render_section ?? null) && !($is_ajax ?? null)) {
            echo ($message ?? null);
        }

        $tabs = [
            ['name' => $this->_('AdminTools.renewals.category_provision', true), 'current' => ((isset($category) ? $category : null) == 'provision' ? true : false), 'attributes' => ['href' => $this->base_uri . 'tools/provisioning/provision/']],
            ['name' => $this->_('AdminTools.renewals.category_renewal', true), 'current' => ((isset($category) ? $category : null) == 'renewal' ? true : false), 'attributes' => ['href' => $this->base_uri . 'tools/provisioning/renewal/']],
            ['name' => $this->_('AdminTools.renewals.category_unpaid_renewal', true), 'current' => ((isset($category) ? $category : null) == 'unpaid_renewal' ? true : false), 'attributes' => ['href' => $this->base_uri . 'tools/provisioning/unpaid_renewal/']],
            ['name' => $this->_('AdminTools.renewals.category_suspension', true), 'current' => ((isset($category) ? $category : null) == 'suspension' ? true : false), 'attributes' => ['href' => $this->base_uri . 'tools/provisioning/suspension/']],
            ['name' => $this->_('AdminTools.renewals.category_unsuspension', true), 'current' => ((isset($category) ? $category : null) == 'unsuspension' ? true : false), 'attributes' => ['href' => $this->base_uri . 'tools/provisioning/unsuspension/']],
            ['name' => $this->_('AdminTools.renewals.category_cancelation', true), 'current' => ((isset($category) ? $category : null) == 'cancelation' ? true : false), 'attributes' => ['href' => $this->base_uri . 'tools/provisioning/cancelation/']],
            ['name' => $this->_('AdminTools.renewals.category_changes', true), 'current' => ((isset($category) ? $category : null) == 'changes' ? true : false), 'attributes' => ['href' => $this->base_uri . 'tools/provisioning/changes/']]
        ];

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTools.renewals.boxtitle_service_queue', true), ['id' => 'admin_tools_provisioning'], ($render_section ?? null));
        ?>

    <div class="table-responsive">
        <?php
        if (($num_services = count($services ?? [])) > 0) {
        ?>
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/provisioning/' . $category . '?sort=client_id_code&order=' . ($sort == 'client_id_code' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'client_id_code' ? ' ' . $order : '';?>">
                            <?php $this->_('AdminTools.renewals.heading_client');?>
                            <?php if ($sort == 'client_id_code') { ?>
                            <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                            <?php } ?>
                        </a>
                    </th>
                    <th><?php $this->_('AdminTools.renewals.heading_service_id');?></th>
                    <th><?php $this->_('AdminTools.renewals.heading_invoice');?></th>

                    <?php
                    if ($category !== 'changes') {
                    ?>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/provisioning/' . $category . '?sort=failed_attempts&order=' . ($sort == 'failed_attempts' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'failed_attempts' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.renewals.heading_failed_attempts');?>
                                <?php if ($sort == 'failed_attempts') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/provisioning/' . $category . '?sort=maximum_attempts&order=' . ($sort == 'maximum_attempts' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'maximum_attempts' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.renewals.heading_maximum_attempts');?>
                                <?php if ($sort == 'maximum_attempts') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    <?php
                    } else {
                    ?>
                        <th><?php $this->_('AdminTools.renewals.heading_status');?></th>
                    <?php
                    }
                    ?>

                    <?php
                    if ($category == 'changes') {
                    ?>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/provisioning/' . $category . '?sort=date_added&order=' . ($sort == 'date_added' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_added' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.renewals.heading_date_' . $category);?>
                                <?php if ($sort == 'date_added') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/provisioning/' . $category . '?sort=date_status&order=' . ($sort == 'date_status' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_status' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.renewals.heading_date_status');?>
                                <?php if ($sort == 'date_status') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th><?php $this->_('AdminTools.renewals.heading_date_next_attempt');?></th>
                    <?php
                    } else {
                    ?>
                        <th><?php $this->_('AdminTools.renewals.heading_date_' . $category);?></th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'tools/provisioning/' . $category . '?sort=date_next_attempt&order=' . ($sort == 'date_next_attempt' ? $negate_order : $order));?>" class="ajax text-decoration-none<?php echo $sort == 'date_next_attempt' ? ' ' . $order : '';?>">
                                <?php $this->_('AdminTools.renewals.heading_date_next_attempt');?>
                                <?php if ($sort == 'date_next_attempt') { ?>
                                <i class="bi bi-arrow-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                    <?php
                    }
                    ?>
                    <th class="text-end"><?php $this->_('AdminTools.renewals.heading_options');?></th>
                </tr>
            </thead>
            <tbody>
            <?php
            // Display all services
            for ($i = 0; $i < $num_services; $i++) {
            ?>
            <tr>
                <td>
                    <span data-bs-toggle="tooltip" title="<?php echo $this->Html->safe($services[$i]->client->first_name ?? $services[$i]->client_first_name ?? null) . ' ' . $this->Html->safe($services[$i]->client->last_name ?? $services[$i]->client_last_name ?? null);?>">
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/view/' . ($services[$i]->client->id ?? $services[$i]->client_id ?? null) . '/');?>"><?php (print $this->Html->safe($services[$i]->client->id_code ?? $services[$i]->client_id_code ?? null));?></a>
                    </span>
                </td>
                <td>
                    <span data-bs-toggle="tooltip" title="<?php echo $this->Html->safe($services[$i]->service->name ?? $services[$i]->name ?? null);?>">
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/editservice/' . ($services[$i]->client->id ?? $services[$i]->client_id ?? null) . '/' . ($services[$i]->service->id ?? $services[$i]->id ?? null) . '/');?>"><?php (print $this->Html->safe($services[$i]->service->id_code ?? $services[$i]->id_code ?? null));?></a>
                    </span>
                </td>
                <td><a href="<?php echo $this->base_uri . 'clients/editinvoice/' . ($services[$i]->client->id ?? $services[$i]->client_id ?? null) . '/' . ($services[$i]->invoice->id ?? $services[$i]->invoice_id ?? null) . '/';?>"><?php echo $this->Html->safe($services[$i]->invoice->id_code ?? null);?></a></td>

                <?php
                if ($category !== 'changes') {
                ?>
                    <td><span class="badge bg-<?php echo ($services[$i]->failed_attempts ?? 0) > 0 ? 'danger' : 'secondary';?>"><?php echo $services[$i]->failed_attempts ?? 0; ?></span></td>
                    <td><span class="badge bg-secondary"><?php echo $services[$i]->maximum_attempts ?? 0; ?></span></td>
                <?php
                } else {
                ?>
                    <td>
                        <span class="badge bg-<?php
                            $status = $services[$i]->status ?? 'pending';
                            echo $status == 'error' ? 'danger' : ($status == 'pending' ? 'warning' : 'secondary');
                        ?>">
                            <?php $this->_('AdminTools.renewals.status_' . $status);?>
                        </span>
                    </td>
                <?php
                }
                ?>

                <td>
                    <?php
                    if ($category == 'provision') {
                        echo $this->Date->cast($services[$i]->date_added ?? null, 'date_time');
                    }
                    if ($category == 'renewal') {
                        echo $this->Date->cast($services[$i]->date_renews ?? null, 'date_time');
                    }
                    if ($category == 'suspension') {
                        echo $this->Date->cast($services[$i]->invoice->date_due ?? null, 'date_time');
                    }
                    if ($category == 'unsuspension') {
                        echo $this->Date->cast($services[$i]->invoice->date_closed ?? null, 'date_time');
                    }
                    if ($category == 'cancelation') {
                        echo $this->Date->cast($services[$i]->date_canceled ?? null, 'date_time');
                    }
                    if ($category == 'changes') {
                        echo $this->Date->cast($services[$i]->date_added ?? null, 'date_time');
                    }
                    ?>
                </td>

                <?php
                if ($category == 'changes') {
                ?>
                    <td><?php echo $this->Date->cast($services[$i]->date_status ?? null);?></td>
                <?php
                }
                ?>

                <td><?php echo $this->Date->cast($services[$i]->date_next_attempt ?? $next_execution ?? null);?></td>
                <td class="text-end">
                    <?php
                    if ($category == 'changes') {
                        $invoice_paid = !empty($services[$i]->invoice->date_closed);
                        $void_checkbox_id = 'void_invoice_' . (isset($services[$i]->id) ? $this->Html->safe($services[$i]->id) : null);
                        $checkbox_attributes = ['id' => $void_checkbox_id, 'class' => 'form-check-input'];
                        $label_attributes = ['class' => 'form-check-label small'];
                        if ($invoice_paid) {
                            $paid_tooltip = $this->_('AdminTools.renewals.field_void_invoice_paid_tooltip', true);
                            $checkbox_attributes['disabled'] = 'disabled';
                            $checkbox_attributes['data-bs-toggle'] = 'tooltip';
                            $checkbox_attributes['title'] = $paid_tooltip;
                            $label_attributes['data-bs-toggle'] = 'tooltip';
                            $label_attributes['title'] = $paid_tooltip;
                        }
                        $confirm_message = $invoice_paid
                            ? $this->_('AdminTools.renewals.modal_cancel_paid', true)
                            : $this->_('AdminTools.renewals.modal_cancel', true);

                        $this->Form->create($this->base_uri . 'tools/servicechangescancel/', ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', (isset($services[$i]->id) ? $this->Html->safe($services[$i]->id) : null));
                        ?>
                        <div class="form-check form-check-inline mb-0">
                            <?php
                            $this->Form->fieldCheckbox('void_invoice', 'true', ($invoice_paid ? false : ($vars->void_invoice ?? null)), $checkbox_attributes);
                            $this->Form->label($this->_('AdminTools.renewals.field_void_invoice', true), $void_checkbox_id, $label_attributes);
                            ?>
                        </div>
                        <a class="btn btn-sm btn-outline-danger modal-confirm-delete ms-1" href="<?php echo $this->base_uri . 'tools/servicechangescancel/' . (isset($services[$i]->id) ? $this->Html->safe($services[$i]->id) : null) . '/';?>" data-confirm-message="<?php echo $this->Html->safe($confirm_message);?>">
                            <i class="bi bi-x-circle"></i> <?php $this->_('AdminTools.renewals.option_cancel');?>
                        </a>
                        <?php
                        $this->Form->end();

                        if (($services[$i]->status ?? null) == 'error') {
                            $this->Form->create($this->base_uri . 'tools/servicechangesretry/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', (isset($services[$i]->id) ? $this->Html->safe($services[$i]->id) : null));
                        ?>
                        <a class="btn btn-sm btn-outline-primary modal-confirm-delete ms-1" href="<?php echo $this->base_uri . 'tools/servicechangesretry/' . (isset($services[$i]->id) ? $this->Html->safe($services[$i]->id) : null) . '/';?>" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminTools.renewals.modal_retry', true));?>">
                            <i class="bi bi-arrow-clockwise"></i> <?php $this->_('AdminTools.renewals.option_retry');?>
                        </a>
                        <?php
                            $this->Form->end();
                        }
                        ?>
                    <?php
                    } else {
                    ?>
                        <a class="btn btn-sm btn-outline-danger modal-confirm-delete" href="<?php echo $this->base_uri . 'tools/dequeue/' . $this->Html->safe($services[$i]->id) . '/';?>" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminTools.renewals.confirm_dequeue', true));?>">
                            <i class="bi bi-x-circle"></i> <?php $this->_('AdminTools.renewals.option_dequeue');?>
                        </a>
                        <a href="<?php echo $this->base_uri . 'tools/changemaxattempts/' . $this->Html->safe($services[$i]->id) . '/';?>" class="btn btn-sm btn-outline-secondary max-attempts-modal ms-1">
                            <i class="bi bi-gear"></i> <?php $this->_('AdminTools.renewals.option_change_max');?>
                        </a>
                    <?php
                    }
                    ?>
                </td>
            </tr>
            <?php
            }
            ?>
            </tbody>
        </table>
        <?php
        } else {
        ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminTools.renewals.no_results_' . $category);?></p>
        </div>
        <?php
        }
        ?>
    </div>
        <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
        ?>
        <?php
        $this->Widget->end();
        ?>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Load modal content for change max attempts
        document.querySelectorAll('#admin_tools_provisioning .table a.max-attempts-modal').forEach(function(el) {
            if (typeof blestaModal === 'function') {
                blestaModal(el, {
                    close: '<?php $this->_('AppController.modal.text_close');?>',
                    url: el.getAttribute('href'),
                    onShow: function (event, api) {
                        api.elements.tooltip.classList.add('common_box_modal');
                    }
                });
            }
        });
    });
</script>
