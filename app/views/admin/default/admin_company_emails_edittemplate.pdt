<?php
$this->Javascript->setInline("
$(document).ready(function() {
    $('#html').blestaBindWysiwygEditor({language: '" . substr(Configure::get('Blesta.language'), 0, 2) . "'});
    $('div.tab_content').blestaTabbedContent();
    $(this).blestaBindDropZone();
    
    $('#attachments a.manage[rel]').on('click', function (event) {
        var line = $(this).parent().parent();
        var attachment_id = $(this).attr('data-id');
        var url = $(this).attr('href');

        event.preventDefault();
    
        $('#attachments a.manage[rel]').blestaModal({
            close: '" . $this->_('AppController.modal.text_close', true) . "',
            url: false,
            text: $('#confirmation_modal').html(),
            open: true,
            onRender: function (event, api) {
                // If 'continue' is clicked, forward to where we wanted to go
                $('.btn.continue', api.elements.content).click(function () {
                    $(this).blestaRequest('POST', url,
                        {
                            _csrf_token: $('#admin_company_emails_edittemplate').find('input[name=_csrf_token]').val(),
                            id: attachment_id
                        },
                        function(data) {
                            $(line).remove();
                            
                            if ($('#attachments tbody tr').length < 1) {
                                $('#attachments').hide();
                            }
                        },
                        null,
                        {dataType: 'json'}
                    );
                    
                    api.hide();
                    return false;
                });
    
                // If 'cancel' is clicked, close the modal
                $('.btn.cancel', api.elements.content).click(function () {
                    api.hide();
                    return false;
                });
            },
            onHide: function (event, api) {
                api.destroy();
            }
        });
    });
});
");
?>