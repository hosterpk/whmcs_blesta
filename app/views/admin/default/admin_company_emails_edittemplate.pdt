                        <a href="#" class="btn btn-default pull-right cancel"><?php $this->_('AdminCompanyEmails.edittemplate.field_cancel');?></a>
                        <a href="#" class="btn btn-primary pull-right continue"><?php $this->_('AdminCompanyEmails.edittemplate.field_continue');?></a>
