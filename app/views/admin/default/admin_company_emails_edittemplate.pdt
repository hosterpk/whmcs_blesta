                                    <?php
                                    for ($i = 0, $num_tags = count($template->tags); $i < $num_tags; $i++) {
                                    ?>
                                    <?php (print (isset($template->tags[$i]) ? $this->Html->safe($template->tags[$i]) : null));?>
                                    <?php
