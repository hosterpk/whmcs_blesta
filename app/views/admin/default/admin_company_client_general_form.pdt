<script type="text/javascript">
    $(document).ready(function() {
        if ($('#email_verification').is(':checked')) {
            $('#prevent_unverified_payments').prop('disabled', false);
        } else {
            $('#prevent_unverified_payments').prop('disabled', true);
        }

        $('#email_verification').change(function() {
            if ($(this).is(':checked')) {
                $('#prevent_unverified_payments').prop('disabled', false);
            } else {
                $('#prevent_unverified_payments').prop('disabled', true);
            }
        });

        if ($('#password_format').val() == 'custom') {
            $('#password_rule').show();
            $('#password_length').hide();
        } else {
            $('#password_rule').hide();
            $('#password_length').show();
        }
        $('#password_format').change(function() {
            if ($(this).val() == 'custom') {
                $('#password_rule').show();
                $('#password_length').hide();
            } else {
                $('#password_rule').hide();
                $('#password_length').show();
            }
        });
    });
</script>
