<?php
$this->Javascript->setInline("
    $(document).ready(function() {
        showMailSettings();

        $('#mail_delivery').change(function() {
            showMailSettings();
        });

        function showMailSettings() {
            $('ul[id$=\"_settings\"]').hide();
            $('#' + $('#mail_delivery').val() + '_settings').show();
        }

        // Auto-fill SMTP server for OAuth providers
        autofillOauthSmtpServer();
        $('#oauth2_provider').change(function() {
            autofillOauthSmtpServer();
        });
        function autofillOauthSmtpServer() {
            var provider = $('#oauth2_provider').val();
            var smtp_servers = " . json_encode($smtp_servers ?? []) . ";

            if (smtp_servers.hasOwnProperty(provider)) {
                $('#oauth2_host').val(smtp_servers[provider]);
            }
        }

        // Copy redirect URI to clipboard
        $('#copy_redirect_uri').click(function() {
            var redirectUri = $('#oauth2_redirect_uri');
            redirectUri.select();

            try {
                // Try using modern clipboard API
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(redirectUri.val()).then(function() {
                        showCopySuccess();
                    });
                } else {
                    // Fallback for older browsers
                    document.execCommand('copy');
                    showCopySuccess();
                }
            } catch (err) {
                console.error('Failed to copy:', err);
            }

            function showCopySuccess() {
                var btn = $('#copy_redirect_uri');
                var originalHtml = btn.html();
                btn.html('<i class=\"fas fa-check\"></i> " . $this->_('AdminCompanyEmails.mail.text_copied', true) . "');
                btn.addClass('btn-success').removeClass('btn-default');

                setTimeout(function() {
                    btn.html(originalHtml);
                    btn.removeClass('btn-success').addClass('btn-default');
                }, 2000);
            }
        });

        // Request to validate the SMTP info entered in this form
        $('.test_mail').click(function() {
            if ($('#mail').blestaDisableFormSubmission($('#mail'))) {
                $(this).blestaRequest('POST', '" . $this->base_uri . 'settings/company/emails/mailtest/' . "', $('#mail').serialize(),
                    function(data) {
                        $('#message').html('');
                        // On success, draw the success or error message
                        $('#message').html(data).blestaBindCloseMessage();
                        $('#message .error_section').show();
                    },
                    function(data) {
                        $('#message').html('');
                        // On success, draw the success or error message
                        $('#message').html($('#message_unauthorized').html()).blestaBindCloseMessage();
                        $('#message .error_section').show();
                    },
                    {complete: function() { $('#mail').blestaEnableFormSubmission($('#mail')); }}
                );
            }

            return false;
        });
    });
");
?>