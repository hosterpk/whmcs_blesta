        <?php echo (isset($left_nav) ? $left_nav : null);?>
        <div id="right_outer">
            <?php echo (isset($message) ? $message : null);?>
            <section id="right_container">
                <?php
                $this->Widget->clear();

                $this->Widget->create($this->_('AdminCompanyElectronicInvoices.index.boxtitle_electronic_invoices', true));
                $this->Form->create(null, ['class' => 'disable-on-submit']);
                ?>
                <div class="inner">
                    <?php
                    if (empty($formats)) {
                    ?>
                        <div class="empty_section">
                            <div class="empty_box">
                                <?php $this->_('AdminCompanyElectronicInvoices.index.no_formats');?>
                            </div>
                        </div>
                    <?php
                    } else {
                    ?>
                        <table class="table">
                            <thead>
                                <tr class="heading_row">
                                    <td class="icon"></td>
                                    <td><?php $this->_('AdminCompanyElectronicInvoices.index.heading_format');?></td>
                                    <td class="last"><?php $this->_('AdminCompanyElectronicInvoices.index.heading_description');?></td>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                $i = 0;
                                foreach ($formats as $format) {
                                ?>
                                <tr<?php echo ($i % 2 == 1) ? ' class="odd_row"' : '';?>>
                                    <td>
                                        <?php
                                        $this->Form->fieldCheckbox('formats[]', $this->Html->safe($format['key']), $format['enabled'], ['id' => 'format_' . $this->Html->safe($format['key'])]);
                                        ?>
                                    </td>
                                    <td>
                                        <?php echo $this->Html->safe($format['name'] ?? '');?>
                                    </td>
                                    <td>
                                        <?php echo $this->Html->safe($format['description'] ?? '');?>
                                    </td>
                                </tr>
                                <?php
                                    $i++;
                                }
                                ?>
                            </tbody>
                        </table>
                    <?php
                    }
                    ?>

                    <?php
                    if (!empty($formats)) {
                    ?>
                    <div class="button_row">
                        <?php
                        $this->Form->fieldSubmit('save', $this->_('AdminCompanyElectronicInvoices.index.field_submit', true), ['class' => 'btn btn-primary pull-right']);
                        ?>
                    </div>
                    <?php
                    }
                    ?>
                </div>
                <?php
                $this->Form->end();
                $this->Widget->end();
                ?>
            </section>
        </div>