
        <?php echo (isset($left_nav) ? $left_nav : null);?>
        <div id="right_outer">
            <?php echo (isset($message) ? $message : null);?>
            <section id="right_container">
                <?php
                $link_buttons = [
                    [
                        'icon' => 'fas fa-plus',
                        'name' => '',
                        'attributes' => [
                            'title' => $this->_('AdminCompanyEmails.htmltemplates.categorylink_addhtmltemplate', true),
                            'href' => $this->base_uri . 'settings/company/emails/addhtmltemplate/'
                        ]
                    ]
                ];

                $this->Widget->clear();
                $this->Widget->setLinkButtons($link_buttons);
                $this->Widget->create($this->_('AdminCompanyEmails.htmltemplates.boxtitle_templates', true));
                ?>
                <div class="inner">
                    <?php
                    // List all template groups
                    if (!empty($groups)) {
                    ?>
                        <div class="clear"></div>
                        <table class="table">
                            <tr class="heading_row">
                                <td><span><?php $this->_('AdminCompanyEmails.htmltemplates.text_name');?></span></td>
                                <td class="last"><span><?php $this->_('AdminCompanyEmails.htmltemplates.text_options');?></span></td>
                            </tr>
                            <?php
                            $i = 0 ;
                            foreach ($groups as $group) {
                            ?>
                                <tr<?php echo ($i % 2 == 1) ? ' class="odd_row"' : '';?>>
                                    <td><?php (print (isset($group->name) ? $this->Html->safe($group->name) : null));?></td>
                                    <td class="last">
                                        <a href="<?php echo $this->base_uri . 'settings/company/emails/edithtmltemplate/' . (isset($group->id) ? $this->Html->safe($group->id) : null) . '/';?>"><?php $this->_('AdminCompanyEmails.htmltemplates.option_edit');?></a>,

                                        <?php
                                        $this->Form->create($this->base_uri . 'settings/company/emails/deletehtmltemplate/');
                                        $this->Form->fieldHidden('id', ($group->id ?? null));
                                        ?>
                                        <a href="<?php echo $this->base_uri . 'settings/company/emails/deletehtmltemplate/' . (isset($group->id) ? $this->Html->safe($group->id) : null) . '/';?>" class="manage" rel="<?php echo $this->Html->safe($this->_('AdminCompanyEmails.htmltemplates.confirm_delete', true));?>"><?php $this->_('AdminCompanyEmails.htmltemplates.option_delete');?></a>
                                        <?php
                                        $this->Form->end();
                                        ?>
                                    </td>
                                </tr>
                            <?php
                                $i++;
                            }
                            ?>
                        </table>
                    <?php
                    } else {
                    ?>
                    <div class="empty_section">
                        <div class="empty_box">
                            <?php $this->_('AdminCompanyEmails.htmltemplates.no_results');?>
                        </div>
                    </div>
                    <?php
                    }
                    ?>
                </div>

                <?php
                $this->Widget->end();
                ?>
            </section>
        </div>

<script type="text/javascript">
    $(document).ready(function() {
        $('a.manage[rel]').blestaModalConfirm({base_url: '<?php echo $this->base_uri;?>', close: '<?php $this->_('AppController.modal.text_close');?>', submit: true});
    });
</script>
