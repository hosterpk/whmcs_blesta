<script type="text/javascript">
$(document).ready(function() {
    showRenewLimitation();

    // Select all assigned packages on submit
    $('#coupon').submit(function() {
        $('#assigned option').prop('selected', true);
    });

    $('.currency_row_add').click(function() {
        var fields = $('tr.currency_row:first').clone(true);
        fields.removeClass('orig');
        fields.find('select,input').each(function() {
            $(this).val('');
        });
        $('tr.currency_row:last').after(fields);

        updateCurrencyRows();
        return false;
    });

    $('.currency_row_remove').click(function() {
        if ($('tr.currency_row').length > 1)
            $(this).closest('tr').remove();

        updateCurrencyRows();
        return false;
    });

    $('.generate_code').click(function() {
        $('#code').attr('value', $(this).blestaRandomString(8));
        return false;
    });

    // Show/hide renew limitation
    $('.recurring').change(function() {
        showRenewLimitation();
    });

    setAvailablePackages();

    $('#package_group_id').change(function() {
        // Remove all available packages
        $('#pool').append($('#available option'));

        setAvailablePackages();
    });

    // Move packages from right to left
    $('.move_left').click(function() {
        // Move right to left
        $('#available option:selected').appendTo($('#assigned'));
        return false;
    });
    // Move packages from left to right
    $('.move_right').click(function() {
        $('#assigned option:selected').appendTo($('#available'));
        return false;
    });

    $('.terms').on('input', function() {
        var index = $(this).attr('id').replace('terms_', '');
        if ($(this).val() === '') {
            $('#enabled_' + index).prop('checked', false);
        } else {
            $('#enabled_' + index).prop('checked', true);
        }
    });

    $('.option_select').change();
    setTimeout(2000, function(){ initialLoad = false; });
});

// Package Options functionality
var initialLoad = true;
var packageOptionIndex = 0;
var packageOptionId = '<?php echo ($vars->package_options[0]['option_id'] ?? null);?>';
var packageOptionValue = '<?php echo !isset($vars->package_options[0]) ? null : (!empty($vars->package_options[0]['option_value_ids']) ? json_encode($vars->package_options[0]['option_value_ids']) : ($vars->package_options[0]['regex_pattern'] ?? $vars->package_options[0]['min_quantity']));?>';
var selectOptionText = '<?php echo $this->_('AdminCompanyBilling.editcoupon.text_select_option', true);?>';
var baseUri = '<?php echo $this->Html->_($this->base_uri, true);?>';
var optionValuesLabel = '<?php echo $this->_('AdminCompanyBilling.editcoupon.field_option_values', true);?>';
var minQuantityLabel = '<?php echo $this->_('AdminCompanyBilling.editcoupon.field_min_quantity', true);?>';
var regexPatternLabel = '<?php echo $this->_('AdminCompanyBilling.editcoupon.field_regex_pattern', true);?>';
var anyValueText = '<?php echo $this->_('AdminCompanyBilling.editcoupon.text_any_value', true);?>';
var tooltipText = '<?php echo $this->_('AppController.tooltip.text', true);?>';
var regexTooltip = '<?php echo $this->_('AdminCompanyBilling.editcoupon.tooltip_regex_pattern', true);?>';

// Future: Add/Remove functionality for multiple config option limitations
/*
// Add new package option row
$(document).on('click', '.add_package_option_row', function(e) {
    e.preventDefault();
    addPackageOptionRow();
});

// Remove package option row
$(document).on('click', '.remove_package_option_row', function(e) {
    e.preventDefault();
    var row = $(this).closest('tr');
    // Never remove the last remaining row
    if ($('#package_options_table tbody tr').length > 1) {
        row.remove();
        updatePackageOptionRowStripes();
    }
});
*/

// Handle option group selection
$(document).on('change', '.option_group_select', function() {
    var groupId = $(this).val();
    var row = $(this).closest('tr');
    var optionSelect = row.find('.option_select');
    var valuesField = row.find('.option_values_field');

    // Reset option select and values
    optionSelect.html('<option value=\"\">' + selectOptionText + '</option>');
    valuesField.empty();

    if (groupId) {
        // Enable option select and load options
        optionSelect.prop('disabled', false);
        $.get(baseUri + 'settings/company/billing/getpackageoptions/' + groupId, function(data) {
            $.each(data, function(id, name) {
                if (packageOptionId == id) {
                    optionSelect.append('<option value=\"' + id + '\" selected=\"selected\">' + name + '</option>');
                    $('.option_select').change();
                } else {
                    optionSelect.append('<option value=\"' + id + '\">' + name + '</option>');
                }
            });
        }, 'json');
    } else {
        optionSelect.prop('disabled', true);
    }
});

// Handle option selection
$(document).on('change', '.option_select', function() {
    var optionId = $(this).val();
    var row = $(this).closest('tr');
    var valuesField = row.find('.option_values_field');
    var rowIndex = row.index();

    valuesField.empty();

    if (optionId) {
        $.get(baseUri + 'settings/company/billing/getpackageoptiondetails/' + optionId, function(data) {
            if (data.type) {
                buildOptionValuesField(valuesField, data, rowIndex);
            }
        }, 'json');
    }
});

// Future: Functions for multiple config option limitations
/*
function addPackageOptionRow() {
    var template = $('#package_options_table tbody tr').first().clone();
    var newIndex = $('#package_options_table tbody tr').length;

    // Reset all values in the cloned row and update index
    template.find('select').each(function() {
        $(this).val('').prop('disabled', function() {
            return $(this).hasClass('option_select');
        });
        var name = $(this).attr('name');
        if (name) {
            $(this).attr('name', name.replace(/\[0\]/, '[' + newIndex + ']'));
        }
    });
    template.find('.option_values_field').empty();

    // Append the new row
    $('#package_options_table tbody').append(template);
}

function updatePackageOptionRowStripes() {
    $('#package_options_table tbody tr').each(function(index) {
        if (index % 2 == 1) {
            $(this).addClass('odd_row');
        } else {
            $(this).removeClass('odd_row');
        }
    });
}
*/

function buildOptionValuesField(container, optionData, rowIndex) {
    var html = '';
    var baseName = 'package_options[' + rowIndex + ']';

    switch(optionData.type) {
        case 'radio':
        case 'select':
        case 'checkbox':
            // Build values array for the multiselect
            var selectHtml = '<label for=\"option_values\">' + optionValuesLabel + '</label>';
            selectHtml += '<select name=\"' + baseName + '[option_value_ids][]\" class=\"stretch\" multiple>';
            $.each(optionData.values, function(id, name) {
                var selected = initialLoad && packageOptionValue.includes(id);
                selectHtml += '<option value=\"' + id + '\"' + (selected ? 'selected=\"selected\"' : '') + '>' + name + '</option>';
            });
            selectHtml += '</select>';

            container.html(selectHtml);
            break;

        case 'quantity':
            container.html(
                '<label for=\"min_quantity\">' + minQuantityLabel + '</label>' +
                '<input type=\"number\" name=\"' + baseName + '[min_quantity]\" value=\"' + (initialLoad ? packageOptionValue : '') + '\" class=\"stretch\" min=\"0\" />'
            );
            break;

        case 'text':
        case 'textarea':
        case 'password':
            container.html(
                '<label for=\"regex_pattern\" class=\"inline\">' + regexPatternLabel + '</label>' +
                '<span class=\"tooltip\">' + tooltipText + '<div>' + regexTooltip + '</div></span>' +
                '<input type=\"text\" name=\"' + baseName + '[regex_pattern]\" class=\"stretch\" value=\"' + (initialLoad ? packageOptionValue : '') + '\" placeholder=\"' + anyValueText + '\" />'
            );
            $('.option_values_field').blestaBindToolTips();
            break;
    }
}

// Shows/hides renew limitation options
function showRenewLimitation() {
    if ($('#recurring_yes').prop('checked'))
        $('#renew_limitation').show();
    else {
        $('#renew_limitation').hide();
        // Reset limit recurring value
        $('#limit_recurring_no').prop('checked', true);
    }
}

// Set the available packages
function setAvailablePackages() {
    // Show the available items for this group
    var selected_group_id = $('#package_group_id option:selected').val();

    // Select all packages
    if (selected_group_id == '')
        $('#available').append($('#pool option'));
    // Select specific group packages
    else
        $('#available').append($('#pool option.group_' + selected_group_id));
}

// Zebra-stripe pricing rows
function updateCurrencyRows() {
    var i = 0;
    $('tr.currency_row').each(function() {
        if (i++%2 == 1)
            $(this).addClass('odd_row');
        else
            $(this).removeClass('odd_row');
    });
}
</script>
