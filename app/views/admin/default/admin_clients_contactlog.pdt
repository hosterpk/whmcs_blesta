        <?php
        $this->Widget->clear();
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'clients/contactlog/' . $client->id . '/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->create($this->_('AdminClients.contactlog.boxtitle_logs', true), ['id' => 'admin_clients_contactlog'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="inner">
            <?php
            if ((isset($contact_logs) ? $contact_logs : false) && ($num_logs = count($contact_logs)) > 0) {
            ?>
            <table class="table">
                <tr class="heading_row">
                    <td><span><a href="<?php echo $this->Html->safe($this->base_uri . 'clients/contactlog/' . $client->id . '/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'first_name' ? ' ' . $order : '');?>"><?php $this->_('AdminClients.contactlog.text_name');?></a></span></td>
                    <td><span><?php $this->_('AdminClients.contactlog.text_type');?></span></td>
                    <td class="last"><span><a href="<?php echo $this->Html->safe($this->base_uri . 'clients/contactlog/' . $client->id . '/?sort=date_changed&order=' . ($sort == 'date_changed' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'date_changed' ? ' ' . $order : '');?>"><?php $this->_('AdminClients.contactlog.text_date');?></a></span></td>
                </tr>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                ?>
                <tr class="<?php echo $this->Html->concat(' ', ($i % 2 == 1) ? 'odd_row' : '', 'expand');?>">
                    <td><a href="<?php echo $this->base_uri . 'clients/editcontact/' . (isset($contact_logs[$i]->client_id) ? $this->Html->safe($contact_logs[$i]->client_id) : null) . '/' . (isset($contact_logs[$i]->contact_id) ? $this->Html->safe($contact_logs[$i]->contact_id) : null) . '/';?>"><?php echo (isset($contact_logs[$i]->first_name) ? $this->Html->safe($contact_logs[$i]->first_name) : null) . ' ' . (isset($contact_logs[$i]->last_name) ? $this->Html->safe($contact_logs[$i]->last_name) : null);?></a></td>
                    <td>
                        <?php
                        if (!empty($contact_logs[$i]->contact->contact_type_name)) {
                            if ($contact_logs[$i]->contact->contact_type_is_lang) {
                                $this->_($contact_logs[$i]->contact->contact_type_name);
                            } else {
                                echo $this->Html->safe($contact_logs[$i]->contact->contact_type_name);
                            }
                        } else {
                            $this->_('AdminClients.contactlog.contact_type_' . $contact_logs[$i]->contact->contact_type);
                        }
                        ?>
                    </td>
                    <td><?php echo $this->Date->cast((isset($contact_logs[$i]->date_changed) ? $this->Html->safe($contact_logs[$i]->date_changed) : null), 'date_time');?></td>
                </tr>
                <tr class="expand_details">
                    <td class="subtable" colspan="3">
                        <table class="table">
                            <tr class="heading_row">
                                <td class="border_left"><?php $this->_('AdminClients.contactlog.text_field');?></td>
                                <td><?php $this->_('AdminClients.contactlog.text_previous');?></td>
                                <td class="last"><?php $this->_('AdminClients.contactlog.text_new');?></td>
                            </tr>
                            <?php
                            $j = 0;
                            foreach ($contact_logs[$i]->change as $field => $values) {
                            ?>
                            <tr<?php echo ($j++ % 2 == 1) ? ' class="odd_row"' : '';?>>
                                <td><?php (print (isset($field) ? $this->Html->safe($field) : null));?></td>
                                <td><?php (print (isset($values['prev']) ? $this->Html->safe($values['prev']) : null));?></td>
                                <td><?php (print (isset($values['cur']) ? $this->Html->safe($values['cur']) : null));?></td>
                            </tr>
                            <?php
                            }
                            unset($j);
                            ?>
                        </table>
                    </td>
                </tr>
                <?php
                }
                ?>
            </table>
            <?php
                $this->Pagination->build();
            } else {
            ?>
            <div class="empty_section">
                <div class="empty_box">
                    <?php $this->_('AdminClients.contactlog.no_results');?>
                </div>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        $this->Widget->end();
        ?>