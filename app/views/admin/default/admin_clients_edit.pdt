<?php
$this->Javascript->setInline('
    $(document).ready(function() {
        updateCustomFields({group_id:$("#client_group_id").val(),client_id:"' . (isset($client->id) ? $client->id : null) . '"});

        $("#country").change(function() {
            $(this).blestaRequest("get", "' . $this->Html->safe($this->base_uri . 'clients/getstates/') . '" + $(this).val(), null, function(data) {
                    // Remove all existing items
                    $("option", "#state").remove();

                    // Append all new items
                    $.each($(this).blestaSortObject(data), function(index, item) {
                        $("#state").append(new Option(item.value, item.key));
                    });
                },
                null,
                {dataType: "json"}
            );
        });

        $("#client_group_id").change(function() {
            var params = {group_id:$(this).val(),client_id:"' . (isset($client->id) ? $client->id : null) . '"};

            updateCustomFields(params);

            return false;
        });

        if ($("#username_type_email").prop("checked"))
            $(".username").hide();

        // Show/hide the username input
        $("#username_type_username").click(function() {
            $(".username").show();
        });
        $("#username_type_email").click(function() {
            $(".username").hide();
        });

        // Get the custom fields
        function updateCustomFields(params) {
            $(this).blestaRequest("get", "' . $this->Html->safe($this->base_uri . 'clients/getcustomfields/') . '", params, function(data) {
                    if (data.custom_fields) {
                        $("#custom_fields").html(data.custom_fields);
                    }

                    if (data.force_email_usernames == "true") {
                        $("#field_username").hide();
                        $("#field_username_note").show();
                    } else {
                        $("#field_username").show();
                        $("#field_username_note").hide();
                    }
                },
                function(data) { },
                {dataType:"json"}
            );

            return false;
        }

        // Disable tax exempt checkbox, if tax id validation is enabled
        function updateTaxExempt() {
            var tax_countries = ' . json_encode(($tax_countries ?? null)) . ';
            var tax_id = $("#tax_id").val();

            if (tax_countries.includes($("#country").val()) && tax_id !== "") {
                $("#tax_exempt").prop("disabled", true);
                $("#tax_exempt").parent().find(".tooltip").removeClass("hidden");
            } else {
                $("#tax_exempt").prop("disabled", false);
                $("#tax_exempt").parent().find(".tooltip").addClass("hidden");
            }
        }

        if (' . (($tax_exemption_enabled ?? false) ? 'true' : 'false') . ') {
            updateTaxExempt();

            $("#country").change(function() {
                updateTaxExempt();
            });

            $("#tax_id").change(function() {
                updateTaxExempt();
            });
        }

        // Show/hide gateway restrictions
        if ($("#inherit_gateway_restrictions").is(":checked")) {
            $("#gateway_restrictions_form").hide();
        } else {
            $("#gateway_restrictions_form").show();
        }

        $("#inherit_gateway_restrictions").change(function() {
            if ($(this).is(":checked")) {
                $("#gateway_restrictions_form").hide();
            } else {
                $("#gateway_restrictions_form").show();
            }
        });

        // Show/hide credit handling
        if ($("#inherit_credit_handling").is(":checked")) {
            $("#credit_handling_form").hide();
        } else {
            $("#credit_handling_form").show();
        }

        // Function to update low balance notifications visibility
        function updateLowBalanceNotificationsVisibility() {
            var shouldShow = false;

            if ($("#inherit_credit_handling").is(":checked")) {
                // When inheriting, check the client group setting
                shouldShow = ' . json_encode(($client_group_settings['payment_credit_enabled'] ?? '0') == '1') . ';
            } else {
                // When not inheriting, check the client\'s own checkbox
                shouldShow = $("#payment_credit_enabled").is(":checked");
            }

            if (shouldShow) {
                $("#low_balance_notifications_section").show();
            } else {
                $("#low_balance_notifications_section").hide();
            }
        }

        // Function to update credit limits visibility (only shown when not inheriting)
        function updateCreditLimitsVisibility() {
            if ($("#inherit_credit_handling").is(":checked")) {
                $("#credit_limits_section").hide();
            } else {
                // Show credit limits section when not inheriting
                $("#credit_limits_section").show();
            }
        }

        $("#inherit_credit_handling").change(function() {
            if ($(this).is(":checked")) {
                $("#credit_handling_form").hide();
            } else {
                $("#credit_handling_form").show();
            }
            // Update visibility for both sections
            updateCreditLimitsVisibility();
            updateLowBalanceNotificationsVisibility();
        });

        // Update low balance notifications visibility when payment_credit_enabled checkbox changes
        $(document).on("change", "#payment_credit_enabled", function() {
            updateLowBalanceNotificationsVisibility();
            updateCreditLimitsVisibility();
        });

        // Initial visibility on page load
        updateCreditLimitsVisibility();
        updateLowBalanceNotificationsVisibility();

        if ($("#enable_gateway_restrictions").is(":checked")) {
            $("#gateway_restrictions input").prop("disabled", false);
        } else {
            $("#gateway_restrictions input").prop("disabled", true);
        }
    });
');
?>
