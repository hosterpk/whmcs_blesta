
        <?php
        echo ($message ?? null);

        $tabs = [
            ['name' => $this->_('AdminPackageOptions.addgroup.tab_add', true), 'current' => true, 'attributes' => ['href' => '#', 'id' => 'add_tab', 'class' => 'add']],
            ['name' => $this->_('AdminPackageOptions.addgroup.tab_import', true), 'current' => false, 'attributes' => ['href' => '#', 'id' => 'import_tab', 'class' => 'import']]
        ];

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->create($this->_('AdminPackageOptions.addgroup.boxtitle_addgroup', true));
        ?>

        <div class="inner">
            <div class="tab" id="tab_add">
                <?php $this->Form->create(null, ['id' => 'add_package_option_group', 'class' => 'disable-on-submit']); ?>

                <div class="title_row first"><h3><?php $this->_('AdminPackageOptions.addgroup.heading_basic');?></h3></div>
                <div class="pad">
                    <ul>
                        <li>
                            <?php $this->Form->label($this->_('AdminPackageOptions.addgroup.field_name', true), 'name'); ?>
                            <?php $this->Form->fieldText('name', ($vars->name ?? null), ['id' => 'name']); ?>
                        </li>
                        <li>
                            <?php $this->Form->label($this->_('AdminPackageOptions.addgroup.field_description', true), 'description'); ?>
                            <?php $this->Form->fieldTextarea('description', ($vars->description ?? null), ['id' => 'description']); ?>
                        </li>
                    </ul>
                </div>

                <div class="title_row">
                    <h3>
                        <?php $this->_('AdminPackageOptions.addgroup.heading_packages');?>
                        <span class="tooltip"><?php $this->_('AppController.tooltip.text');?><div><?php $this->_('AdminPackageOptions.!tooltip.package_membership');?></div></span>
                    </h3>
                </div>
                <div class="pad">
                    <table>
                        <tr>
                            <td><?php $this->Form->label($this->_('AdminPackageOptions.addgroup.text_memberpackages', true), 'assigned');?></td>
                            <td></td>
                            <td><?php $this->Form->label($this->_('AdminPackageOptions.addgroup.text_availablepackages', true), 'available');?></td>
                        </tr>
                        <tr>
                            <td>
                                <?php $this->Form->fieldMultiSelect('packages[]', ($vars->packages ?? null), [], ['id' => 'assigned']);?>
                            </td>
                            <td><a href="#" class="move_left">&nbsp;</a> &nbsp; <a href="#" class="move_right">&nbsp;</a></td>
                            <td>
                                <?php $this->Form->fieldMultiSelect('available[]', ($packages ?? null), [], ['id' => 'available']);?>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="button_row">
                    <?php
                    $this->Form->fieldSubmit('save', $this->_('AdminPackageOptions.addgroup.field_addgroupsubmit', true), ['class' => 'btn btn-primary pull-right']);
                    ?>
                </div>
                <?php $this->Form->end();?>
            </div>

            <div class="tab" id="tab_import">
                <?php
                $this->Form->create(null, ['id' => 'import_package_option_group', 'enctype' => 'multipart/form-data', 'class' => 'disable-on-submit']);
                ?>

                <div class="import_type">
                    <div class="title_row first">
                        <h3><?php $this->_('AdminPackageOptions.addgroup.heading_import');?></h3>
                    </div>
                    <div class="pad">
                        <ul>
                            <li>
                                <?php
                                $this->Form->label($this->_('AdminPackageOptions.addgroup.field_import_file', true), 'import_file');
                                $this->Form->fieldFile('import_file', ['id' => 'import_file']);
                                ?>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="button_row">
                    <?php
                    $this->Form->fieldSubmit('import', $this->_('AdminPackageOptions.addgroup.field_importgroupsubmit', true), ['class' => 'btn btn-primary pull-right']);
                    ?>
                </div>
                <?php
                $this->Form->end();
                ?>
            </div>
        </div>

        <?php
        $this->Widget->end();

        $this->Javascript->setInline("
        $(document).ready(function() {
            $('#add_package_option_group').submit(function() {
                $('#assigned option').prop('selected', true);
            });

            // Move packages from right to left
            $('.move_left').click(function() {
                $('#available option:selected').appendTo($('#assigned'));
                return false;
            });
            
            // Move packages from left to right
            $('.move_right').click(function() {
                $('#assigned option:selected').appendTo($('#available'));
                return false;
            });
            
            // Set tabs
            $('.tabs_content .tab').hide();
            $('.tabs_content #tab_add').show();
            $('.tab_slider ul li').on('click', function() {
                var tab = $(this).find('a').attr('class');
    
                $('.tab_slider ul li').removeClass('current');
                $(this).addClass('current');
                $('.tabs_content .tab').hide();
                $('.tabs_content .tab#tab_' + tab).show();
            });
        });
        ");
        ?>
