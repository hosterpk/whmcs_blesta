        <?php
        if ((isset($show_left_nav) ? $show_left_nav : null)) {
            echo (isset($left_nav) ? $left_nav : null);
        }

        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'installed'),
                'attributes' => [
                    'href' => $this->base_uri . 'settings/company/gateways/' . $tab['uri'] . '/',
                    'class' => 'ajax'
                ]
            ];
        }
        ?>

        <div <?php echo (isset($show_left_nav) ? $show_left_nav : null) ? 'id="right_outer"' : '';?>>
            <?php echo (isset($message) ? $message : null);?>
            <section id="right_container">

                <?php
                $this->Widget->clear();
                $this->Widget->setTabs($tabs);
                $this->Widget->create(
                    $this->_('AdminCompanyGateways.installed.boxtitle_gateway', true),
                    ['id' => 'admin_company_gateways_installed'],
                    (isset($render_section) ? $render_section : null)
                );
                ?>
                <div class="inner pad" id="gateways">
                    <?php
                    if ((isset($gateway_types) ? $gateway_types : null)) {
                        $k = 0;
                        foreach ($gateway_types as $type) {
                            ?>
                            <div class="title_row<?php echo ($k++ > 0 ? '' : ' first');?>">
                                <h3>
                                    <?php $this->_('AdminCompanyGateways.installed.heading_' . $type);?>
                                    <?php
                                    if (isset($gateways[$type]) && !empty($gateways[$type]) && $type == 'merchant') {
                                    ?>
                                    <div class="setting"><i class="fas fa-cog fa-fw"></i></div>
                                    <?php
                                    }
                                    ?>
                                </h3>
                            </div>
                            <?php
                            $gateway_list = [];
                            if (isset($gateways[$type])) {
                                $gateway_list = $gateways[$type];
                            }
                            $num_gateways = count($gateway_list);
                            if ($num_gateways > 0) {
                                // Clear heading
                                ?>
                                <div class="clear"></div>
                                <?php
                                if ($type == 'merchant' && !empty($gateway_currencies)) {
                                ?>
                                    <div class="itemlist bg-light p-3" id="merchant_settings" style="display: none">
                                        <?php
                                        $this->Form->create(null, ['class' => 'float-none disable-on-submit']);
                                        ?>
                                        <ul class="p-0 m-0">
                                            <li class="mb-2">
                                                <strong><?php $this->_('AdminCompanyGateways.installed.heading_default_gateways');?></strong>
                                                <p><?php $this->_('AdminCompanyGateways.installed.text_default_gateways_desc');?></p>
                                            </li>
                                            <?php
                                            foreach ($gateway_currencies as $currency => $currency_gateways) {
                                            ?>
                                                <li>
                                                    <div class="row">
                                                        <div class="col-1 py-1">
                                                            <?php echo $this->Html->safe($currency);?>
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <?php
                                                            $this->Form->fieldSelect('default_gateways[' . $this->Html->safe($currency) . ']', $currency_gateways, ($vars->default_gateways[$currency] ?? $default_gateways[$currency] ?? null), ['id' => 'default_gateways_' . $currency, 'class' => 'w-100']);
                                                            ?>
                                                        </div>
                                                    </div>
                                                </li>
                                            <?php
                                            }
                                            ?>
                                            <li class="text-right">
                                                <?php
                                                $this->Form->fieldSubmit('save', $this->_('AdminCompanyGateways.installed.btn_save', true), ['class' => 'btn btn-primary']);
                                                ?>
                                            </li>
                                        </ul>
                                        <?php
                                        $this->Form->end();
                                        ?>
                                    </div>
                                <?php
                                }
                                ?>
                                <?php
                                for ($i = 0; $i < $num_gateways; $i++) {
                                ?>
                                <div class="itemlist<?php echo ($i == $num_gateways - 1) ? ' last' : ''; ?>">
                                    <div class="logo">
                                        <span><img src="<?php (print (isset($gateway_list[$i]->logo) ? $this->Html->safe($gateway_list[$i]->logo) : null));?>" /></span>
                                    </div>
                                    <ul>
                                        <li>
                                            <strong><?php (print (isset($gateway_list[$i]->name) ? $this->Html->safe($gateway_list[$i]->name) : null));?></strong>
                                            <?php $this->_('AdminCompanyGateways.installed.text_version', false, $gateway_list[$i]->installed_version);?>

                                            <?php
                                            if ((isset($gateway_list[$i]->signup_url) ? $gateway_list[$i]->signup_url : null)) {
                                            ?>
                                            <a href="<?php echo $this->Html->safe($gateway_list[$i]->signup_url);?>" target="_blank"><?php $this->_('AdminCompanyGateways.installed.signup_url');?></a>
                                            <?php
                                            }
                                            ?>
                                        </li>
                                        <li>
                                            <?php $this->_('AdminCompanyGateways.installed.text_author');?>
                                            <?php
                                            foreach ((array)(isset($gateway_list[$i]->authors) ? $gateway_list[$i]->authors : null) as $index => $author) {
                                            ?>
                                            <a href="<?php (print (isset($author['url']) ? $this->Html->safe($author['url']) : null));?>" target="_blank"><?php (print (isset($author['name']) ? $this->Html->safe($author['name']) : null));?></a><?php echo isset($gateway_list[$i]->authors[$index + 1]) ? ',' : '';?>
                                            <?php
                                            }
                                            ?>
                                        </li>
                                        <?php
                                        if ($type == 'merchant') {
                                        ?>
                                        <li>
                                            <?php $this->_('AdminCompanyGateways.installed.text_supports');?>
                                            <?php
                                            if (isset($gateway_list[$i]->interfaces) && is_array($gateway_list[$i]->interfaces)) {
                                                $num_interfaces = count($gateway_list[$i]->interfaces);

                                                for ($j = 0; $j < $num_interfaces; $j++) {
                                                    echo ($j > 0 ? ', ' : '') . $this->_('AdminCompanyGateways.installed.text_' . strtolower($gateway_list[$i]->interfaces[$j]), true);
                                                }
                                            }
                                            ?>
                                        </li>
                                        <?php
                                        }
                                        ?>
                                        <li><?php echo nl2br((isset($gateway_list[$i]->description) ? $this->Html->safe($gateway_list[$i]->description) : ''))?></li>
                                    </ul>
                                    <div class="button_row_inline h-100 pt-0 d-flex align-items-center">
                                        <?php
                                        if ((isset($gateway_list[$i]->version) ? $gateway_list[$i]->version : null) !== (isset($gateway_list[$i]->installed_version) ? $gateway_list[$i]->installed_version : null)) {
                                        ?>
                                            <?php
                                            $this->Form->create($this->base_uri . 'settings/company/gateways/upgrade/' . (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null) . '/', ['class' => 'disable-on-submit']);
                                            $this->Form->fieldHidden('id', (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null));
                                            $this->Form->fieldSubmit('save', $this->_('AdminCompanyGateways.installed.btn_upgrade', true), ['class' => 'btn btn-primary mx-1']);
                                            $this->Form->end();
                                            ?>
                                        <?php
                                        }
                                        ?>

                                        <a class="btn btn-default mx-1" href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/gateways/manage/' . (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null) . '/');?>"><?php $this->_('AdminCompanyGateways.installed.btn_manage');?></a>

                                        <?php
                                        $this->Form->create($this->base_uri . 'settings/company/gateways/uninstall/');
                                        $this->Form->fieldHidden('id', (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null));
                                        ?>
                                        <a class="btn btn-danger mx-1 manage" href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/gateways/uninstall/' . (isset($gateway_list[$i]->id) ? $gateway_list[$i]->id : null) . '/');?>" rel="<?php echo $this->Html->safe($this->_('AdminCompanyGateways.installed.confirm_uninstall', true));?>"><?php $this->_('AdminCompanyGateways.installed.btn_uninstall');?></a>
                                        <?php
                                        $this->Form->end();
                                        ?>
                                    </div>
                                    <div class="clear"></div>
                                </div>
                            <?php
                                }
                            } else {
                            ?>
                                <div class="empty_section">
                                    <div class="empty_box">
                                        <?php $this->_('AdminCompanyGateways.installed.text_' . $type . '_none');?>
                                    </div>
                                </div>
                            <?php
                            }
                        }
                    }
                    ?>
                </div>
                <?php $this->Widget->end();?>
            </section>
        </div>
<?php
$this->Javascript->setInline("
    $(document).ready(function() {
        // Handle confirmation on delete action
        $('#gateways a.manage[rel]').blestaModalConfirm({base_url: '" . $this->base_uri . "', close: '" . addslashes($this->_('AppController.modal.text_close', true)) . "', submit: true});

        // Toggle merchant_settings when clicking the settings button
        $('.title_row .setting').on('click', function() {
            $('#merchant_settings').toggle();
        });
    });
");
?>
