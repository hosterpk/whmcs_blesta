
        <?php
        $tabs = [];
        foreach ((isset($link_tabs) ? $link_tabs : []) as $tab) {
            $tabs[] = [
                'name' => $tab['name'],
                'current' => ($tab['uri'] == 'servicechanges'),
                'attributes' => [
                    'href' => $this->base_uri . 'tools/logs/' . $tab['uri'] . '/'
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setTabs($tabs);
        $this->Widget->setFilters(($filters ?? null), $this->Html->safe($this->base_uri . 'tools/logs/servicechanges/'), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->create($this->_('AdminTools.logs.boxtitle_logs', true), ['id' => 'admin_tools_logservicechanges'], (isset($render_section) ? $render_section : null));
        ?>
        <div class="inner">
            <?php
            if ((isset($service_change_logs) ? $service_change_logs : false) && ($num_logs = count($service_change_logs)) > 0) {
            ?>
            <table class="table">
                <tr class="heading_row">
                    <td><span><a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/servicechanges/?sort=service_id&order=' . ($sort == 'service_id' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'service_id' ? ' ' . $order : '');?>"><?php $this->_('AdminTools.logservicechanges.text_service_id');?></a></span></td>
                    <td><span><?php $this->_('AdminTools.logservicechanges.text_name');?></span></td>
                    <td><span><?php $this->_('AdminTools.logservicechanges.text_package');?></span></td>
                    <td><span><?php $this->_('AdminTools.logservicechanges.text_amount');?></span></td>
                    <td class="last"><span><a href="<?php echo $this->Html->safe($this->base_uri . 'tools/logs/servicechanges/?sort=date_changed&order=' . ($sort == 'date_changed' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'date_changed' ? ' ' . $order : '');?>"><?php $this->_('AdminTools.logservicechanges.text_date');?></a></span></td>
                </tr>
                <?php
                for ($i = 0; $i < $num_logs; $i++) {
                ?>
                <tr class="<?php echo $this->Html->concat(' ', ($i % 2 == 1) ? 'odd_row' : '', 'expand');?>">
                    <td><a href="<?php echo $this->base_uri . 'clients/editservice/' . (isset($service_change_logs[$i]->new_service['client_id']) ? $this->Html->safe($service_change_logs[$i]->new_service['client_id']) : null) . '/' . (isset($service_change_logs[$i]->service_id) ? $this->Html->safe($service_change_logs[$i]->service_id) : null) . '/';?>"><?php echo (isset($service_change_logs[$i]->service_id) ? $this->Html->safe($service_change_logs[$i]->service_id) : null);?></a></td>
                    <td><a href="<?php echo $this->base_uri . 'clients/editservice/' . (isset($service_change_logs[$i]->new_service['client_id']) ? $this->Html->safe($service_change_logs[$i]->new_service['client_id']) : null) . '/' . (isset($service_change_logs[$i]->service_id) ? $this->Html->safe($service_change_logs[$i]->service_id) : null) . '/';?>"><?php echo (isset($service_change_logs[$i]->name) ? $this->Html->safe($service_change_logs[$i]->name) : null);?></a></td>
                    <td><a href="<?php echo $this->base_uri . 'packages/edit/' . (isset($service_change_logs[$i]->new_service['client_id']) ? $this->Html->safe($service_change_logs[$i]->new_service['package']->id) : null) . '/';?>"><?php echo (isset($service_change_logs[$i]->new_service['package']->name) ? $this->Html->safe($service_change_logs[$i]->new_service['package']->name) : null);?></a></td>
                    <td>
                        <?php
                        $amount = 0;
                        $currency = $default_currency ?? null;
                        foreach ($service_change_logs[$i]->transactions as $transaction) {
                            $currency = $transaction->currency;

                            if ($transaction->transaction_type == 'credit') {
                                $amount = $amount - $transaction->amount;
                            } else {
                                $amount = $amount + $transaction->amount;
                            }
                        }

                        echo $this->CurrencyFormat->format($amount, $currency, ['html_code' => true]);
                        ?>
                    </td>
                    <td><?php echo $this->Date->cast((isset($service_change_logs[$i]->date_changed) ? $this->Html->safe($service_change_logs[$i]->date_changed) : null), 'date_time');?></td>
                </tr>
                <tr class="expand_details">
                    <td class="subtable" colspan="5">
                        <?php
                        if (!empty($service_change_logs[$i]->transactions)) {
                        ?>
                            <table class="table mb-2">
                                <tr class="heading_row">
                                    <td class="border_left"><?php $this->_('AdminTools.logservicechanges.text_transaction_id');?></td>
                                    <td><?php $this->_('AdminTools.logservicechanges.text_gateway');?></td>
                                    <td><?php $this->_('AdminTools.logservicechanges.text_amount');?></td>
                                    <td class="last"><?php $this->_('AdminTools.logservicechanges.text_type');?></td>
                                </tr>
                                <?php
                                $j = 0;
                                foreach ($service_change_logs[$i]->transactions as $transaction) {
                                ?>
                                <tr<?php echo ($j++ % 2 == 1) ? ' class="odd_row"' : '';?>>
                                    <td>
                                        <a href="<?php echo $this->base_uri . 'clients/edittransaction/' . (isset($transaction->client_id) ? $this->Html->safe($transaction->client_id) : null) . '/' . (isset($transaction->id) ? $this->Html->safe($transaction->id) : null) . '/';?>">
                                            <?php echo $this->Html->safe($transaction->transaction_id ?? $transaction->id);?>
                                        </a>
                                    </td>
                                    <td><?php echo $this->Html->safe($transaction->gateway_name ?? '');?></td>
                                    <td><?php echo $this->CurrencyFormat->format($transaction->amount, $transaction->currency, ['html_code' => true]);?></td>
                                    <td><?php echo $this->Html->safe($transaction_types[$transaction->type_name] ?? '');?></td>
                                </tr>
                                <?php
                                }
                                unset($j);
                                ?>
                            </table>
                        <?php
                        }
                        ?>

                        <table class="table">
                            <tr class="heading_row">
                                <td class="border_left"><?php $this->_('AdminTools.logservicechanges.text_field');?></td>
                                <td><?php $this->_('AdminTools.logservicechanges.text_previous');?></td>
                                <td class="last"><?php $this->_('AdminTools.logservicechanges.text_new');?></td>
                            </tr>
                            <?php
                            $j = 0;
                            foreach ($service_change_logs[$i]->new_service as $field => $values) {
                                if ($service_change_logs[$i]->new_service[$field] == $service_change_logs[$i]->old_service[$field]) {
                                    continue;
                                }
                            ?>
                            <tr<?php echo ($j++ % 2 == 1) ? ' class="odd_row"' : '';?>>
                                <td><?php (print (isset($field) ? $this->Html->safe($field) : null));?></td>
                                <td>
                                    <?php
                                    if (!is_scalar($service_change_logs[$i]->old_service[$field])) {
                                        echo '<pre>' . $this->Html->safe(print_r($service_change_logs[$i]->old_service[$field], true)) . '</pre>';
                                    } else {
                                        echo $this->Html->safe($service_change_logs[$i]->old_service[$field]);
                                    }
                                    ?>
                                </td>
                                <td>
                                    <?php
                                    if (!is_scalar($service_change_logs[$i]->new_service[$field])) {
                                        echo '<pre>' . $this->Html->safe(print_r($service_change_logs[$i]->new_service[$field], true)) . '</pre>';
                                    } else {
                                        echo $this->Html->safe($service_change_logs[$i]->new_service[$field]);
                                    }
                                    ?>
                                </td>
                            </tr>
                            <?php
                            }
                            unset($j);
                            ?>
                        </table>
                    </td>
                </tr>
                <?php
                }
                ?>
            </table>
            <?php
                $this->Pagination->build();
            } else {
            ?>
            <div class="empty_section">
                <div class="empty_box">
                    <?php $this->_('AdminTools.logservicechanges.no_results');?>
                </div>
            </div>
            <?php
            }
            ?>
        </div>
        <?php
        $this->Widget->end();
        ?>