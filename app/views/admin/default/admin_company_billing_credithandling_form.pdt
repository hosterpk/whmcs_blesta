
                    <p>
                        <?php $this->_('AdminCompanyBilling.credithandling.text_description');?>
                    </p>
                    <ul>
                        <li>
                            <?php
                            $this->Form->fieldCheckbox('payment_credit_enabled', '1', ($vars['payment_credit_enabled'] ?? null) == '1', ['id' => 'payment_credit_enabled']);
                            $this->Form->label($this->_('AdminCompanyBilling.credithandling.field.payment_credit_enabled', true), 'payment_credit_enabled', ['class' => 'inline']);
                            ?>
                            <span class="tooltip block"><?php $this->_('AppController.tooltip.text');?><div><?php $this->_('AdminCompanyBilling.!tooltip.payment_credit_enabled');?></div></span>
                        </li>
                    </ul>

                    <div id="credit_limits_section">
                    <div class="title_row first">
                        <h3><?php $this->_('AdminCompanyBilling.credithandling.heading_limits');?></h3>
                    </div>
                    <table class="table">
                        <tbody>
                            <tr class="heading_row">
                                <td><span><?php $this->_('AdminCompanyBilling.credithandling.field.currency');?></span></td>
                                <td>
                                    <span><?php $this->_('AdminCompanyBilling.credithandling.field.min_amount');?></span>
                                    <span class="tooltip block mb-0"><?php $this->_('AppController.tooltip.text');?><div><?php $this->_('AdminCompanyBilling.!tooltip.min_amount');?></div></span>
                                </td>
                                <td>
                                    <span><?php $this->_('AdminCompanyBilling.credithandling.field.max_amount');?></span>
                                    <span class="tooltip block mb-0"><?php $this->_('AppController.tooltip.text');?><div><?php $this->_('AdminCompanyBilling.!tooltip.max_amount');?></div></span>
                                </td>
                            </tr>
                            <?php
                            $i = 0;
                            foreach ($currencies ?? [] as $currency) {
                                $min_value = isset($credit_limits[$currency->code]['min']) && ($credit_limits[$currency->code]['min'] !== '') ? $this->CurrencyFormat->format($credit_limits[$currency->code]['min'], $currency->code, ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false]) : null;
                                $max_value = isset($credit_limits[$currency->code]['max']) && ($credit_limits[$currency->code]['max'] !== '') ? $this->CurrencyFormat->format($credit_limits[$currency->code]['max'], $currency->code, ['prefix' => false, 'suffix' => false, 'with_separator' => false, 'code' => false]) : null;
                            ?>
                                <tr<?php echo (($i % 2 == 1) ? ' class="odd_row"' : '');?>>
                                    <td>
                                        <strong><?php echo $this->Html->safe($currency->code);?></strong>
                                    </td>
                                    <td>
                                        <?php $this->Form->fieldText('payment_credit_limits[' . $this->Html->safe($currency->code) . '][min]', $min_value, ['class' => 'small', 'placeholder' => $this->CurrencyFormat->format(0, $currency->code, ['prefix' => false, 'suffix' => false, 'code' => false])]);?>
                                    </td>
                                    <td>
                                        <?php $this->Form->fieldText('payment_credit_limits[' . $this->Html->safe($currency->code) . '][max]', $max_value, ['class' => 'small', 'placeholder' => $this->CurrencyFormat->format(0, $currency->code, ['prefix' => false, 'suffix' => false, 'code' => false])]);?>
                                    </td>
                                </tr>
                            <?php
                                $i++;
                            }
                            ?>
                        </tbody>
                    </table>
                    </div>
