    <div class="col-md-6">
        <label for="gateway" class="form-label"><?php $this->_('TransactionsReceived.options.field_gateway');?></label>
        <?php
        $this->Form->fieldSelect('gateway', (isset($gateways) ? $gateways : null), (isset($vars->gateway) ? $vars->gateway : null), ['id' => 'gateway', 'class' => 'form-select']);
        ?>
    </div>
    <div class="col-md-6">
        <label for="status" class="form-label"><?php $this->_('TransactionsReceived.options.field_status');?></label>
        <?php
        $this->Form->fieldSelect('status', (isset($statuses) ? $statuses : null), (isset($vars->status) ? $vars->status : null), ['id' => 'status', 'class' => 'form-select']);
