
<div class="row g-3">
    <div class="col-md-6">
        <label for="report" class="form-label"><?php $this->_('CustomReports.options.field_report');?></label>
        <?php
        $this->Form->fieldSelect('report', (isset($reports) ? $reports : null), (isset($vars->report) ? $vars->report : null), ['id' => 'report', 'class' => 'form-select']);
        ?>
    </div>
    <?php
    if ((isset($fields) ? $fields : null)) {
        foreach ($fields as $field) {
    ?>
    <div class="col-md-6">
        <label for="field_<?php echo $this->Html->safe($field->name);?>" class="form-label"><?php echo $this->Html->safe($field->label);?></label>
        <?php
        switch ($field->type) {
            case 'text':
                $this->Form->fieldText('field[' . $field->name . ']', (isset($vars->field[$field->name]) ? $vars->field[$field->name] : null), ['id' => 'field_' . $field->name, 'class' => 'form-control']);
                break;
            case 'date':
                $this->Form->fieldText('field[' . $field->name . ']', (isset($vars->field[$field->name]) ? $vars->field[$field->name] : null), ['id' => 'field_' . $field->name, 'type' => 'date', 'class' => 'form-control']);
                break;
            case 'select':
                $this->Form->fieldSelect('field[' . $field->name . ']', $field->values, (isset($vars->field[$field->name]) ? $vars->field[$field->name] : null), ['id' => 'field_' . $field->name, 'class' => 'form-select']);
                break;
        }
        ?>
    </div>
    <?php
        }
    }
    ?>
</div>
