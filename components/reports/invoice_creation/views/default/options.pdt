
<div class="row g-3">
    <div class="col-md-6">
        <label for="start_date" class="form-label"><?php $this->_('InvoiceCreation.options.field_start_date');?></label>
        <?php
        $this->Form->fieldText('start_date', (isset($vars->start_date) ? $vars->start_date : null), ['id' => 'start_date', 'type' => 'date', 'class' => 'form-control']);
        ?>
    </div>
    <div class="col-md-6">
        <label for="end_date" class="form-label"><?php $this->_('InvoiceCreation.options.field_end_date');?></label>
        <?php
        $this->Form->fieldText('end_date', (isset($vars->end_date) ? $vars->end_date : null), ['id' => 'end_date', 'type' => 'date', 'class' => 'form-control']);
        ?>
    </div>
    <div class="col-md-6">
        <label for="status" class="form-label"><?php $this->_('InvoiceCreation.options.field_status');?></label>
        <?php
        $this->Form->fieldSelect('status', (isset($statuses) ? $statuses : null), (isset($vars->status) ? $vars->status : null), ['id' => 'status', 'class' => 'form-select']);
        ?>
    </div>
</div>
