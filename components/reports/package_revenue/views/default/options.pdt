
<p class="mb-3"><?php $this->_('PackageRevenue.description'); ?></p>
<div class="row g-3">
    <div class="col-md-6">
        <label for="currency" class="form-label"><?php $this->_('PackageRevenue.options.currency');?></label>
        <?php
        $this->Form->fieldSelect('currency', (isset($currencies) ? $currencies : null), (isset($vars->currency) ? $vars->currency : (isset($default_currency) ? $default_currency : 'USD')), ['id' => 'currency', 'class' => 'form-select']);
        ?>
    </div>
    <div class="col-md-6">
        <label for="start_date" class="form-label"><?php $this->_('PackageRevenue.options.field_start_date');?></label>
        <?php
        $this->Form->fieldText('start_date', (isset($vars->start_date) ? $vars->start_date : null), ['id' => 'start_date', 'type' => 'date', 'class' => 'form-control']);
        ?>
    </div>
    <div class="col-md-6">
        <label for="end_date" class="form-label"><?php $this->_('PackageRevenue.options.field_end_date');?></label>
        <?php
        $this->Form->fieldText('end_date', (isset($vars->end_date) ? $vars->end_date : null), ['id' => 'end_date', 'type' => 'date', 'class' => 'form-control']);
        ?>
    </div>
</div>
