<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Cpanel.tab_stats.info_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Cpanel.tab_stats.info_heading.field'); ?></th>
                <th><?php $this->_('Cpanel.tab_stats.info_heading.value'); ?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $keys = ['domain', 'ip'];
            foreach ($keys as $i => $key) {
                if (isset($stats->account_info->acct[0]->{$key})) { ?>
            <tr>
                <td><?php $this->_('Cpanel.tab_stats.info.' . $key); ?></td>
                <td><?php echo isset($stats->account_info->acct[0]->{$key})
                    ? $this->Html->safe($stats->account_info->acct[0]->{$key})
                    : null; ?></td>
            </tr>
                    <?php }
            }
            ?>
        </tbody>
    </table>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Cpanel.tab_stats.bandwidth_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Cpanel.tab_stats.bandwidth_heading.used'); ?></th>
                <th><?php $this->_('Cpanel.tab_stats.bandwidth_heading.limit'); ?></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <?php
                    $usage = (float) ($stats->bandwidth_usage['used'] ?? 0);
                    $this->_('Cpanel.tab_stats.bandwidth_value', false, round($usage, 2));
                    ?>
                </td>
                <td>
                    <?php
                    $limit = is_numeric($stats->bandwidth_usage['limit'] ?? 0)
                        ? (float) ($stats->bandwidth_usage['limit'] ?? 0)
                        : $stats->bandwidth_usage['limit'];

                    if ($limit == 0 || !is_numeric($limit)) {
                        $this->_('Cpanel.tab_stats.bandwidth_unlimited', false);
                    } else {
                        $this->_('Cpanel.tab_stats.bandwidth_value', false, round($limit, 2));
                    }
                    ?>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Cpanel.tab_stats.disk_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Cpanel.tab_stats.disk_heading.used'); ?></th>
                <th><?php $this->_('Cpanel.tab_stats.disk_heading.limit'); ?></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <?php
                    $usage = (float) ($stats->disk_usage['used'] ?? 0);
                    $this->_('Cpanel.tab_stats.disk_value', false, round($usage, 2));
                    ?>
                </td>
                <td>
                    <?php
                    $limit = is_numeric($stats->disk_usage['limit'] ?? 0)
                        ? (float) ($stats->disk_usage['limit'] ?? 0)
                        : $stats->disk_usage['limit'];

                    if ($limit == 0 || !is_numeric($limit)) {
                        $this->_('Cpanel.tab_stats.disk_unlimited', false);
                    } else {
                        $this->_('Cpanel.tab_stats.disk_value', false, round($limit, 2));
                    }
                    ?>
                </td>
            </tr>
        </tbody>
    </table>
</div>