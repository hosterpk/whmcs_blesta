<?php /** @var View $this **/ ?>

<?php if ($enabled ?? false) { ?>
<h6 class="form-section-header"><?php $this->_('RealtimeRegister.tab_dns.heading'); ?></h6>

<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><?php $this->_('RealtimeRegister.tab_dns.heading_name'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dns.heading_type'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dns.heading_content'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dns.heading_ttl'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dns.heading_priority'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dns.heading_options'); ?></th>
            </tr>
        </thead>
        <tbody>

            <?php if (!empty($dns_records)) {
                foreach ($dns_records as $record) { ?>
            <tr>
                <td><?php echo $this->Html->safe($record->name ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record->type ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record->content ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record->ttl ?? ''); ?></td>
                <td><?php echo $this->Html->safe($record->prio ?? ''); ?></td>
                <td>
                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('action', 'delete');
                    $this->Form->fieldHidden('name', $record->name ?? '');
                    $this->Form->fieldHidden('type', $record->type ?? '');
                    ?>
                    <button class="btn btn-sm btn-outline-danger" type="submit" title="<?php $this->_('RealtimeRegister.tab_dns.field_delete'); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
                <?php }
            } else {
                ?>
            <tr>
                <td colspan="6">
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3 mb-0"><?php $this->_('RealtimeRegister.tab_dns.text_no_dns_records'); ?></p>
                    </div>
                </td>
            </tr>
                        <?php
            } ?>
        </tbody>
    </table>
</div>

                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('action', 'add');
                    ?>
<h6 class="form-section-header"><?php $this->_('RealtimeRegister.tab_dns.heading_add_record'); ?></h6>

<div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dns.field_name', true), 'name', ['class' => 'form-label']);
    $this->Form->fieldText('name', $vars->name ?? '', [
        'id' => 'name',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_dns.field_name', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dns.field_type', true), 'type', ['class' => 'form-label']);
    $this->Form->fieldSelect('type', $record_types ?? [], $vars->type ?? '', [
        'id' => 'type',
        'class' => 'form-select',
        'placeholder' => $this->_('RealtimeRegister.tab_dns.field_type', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dns.field_content', true), 'content', ['class' => 'form-label']);
    $this->Form->fieldTextArea('content', $vars->content ?? '', [
        'id' => 'content',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_dns.field_content', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dns.field_ttl', true), 'ttl', ['class' => 'form-label']);
    $this->Form->fieldText('ttl', $vars->ttl ?? '3600', [
        'id' => 'ttl',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_dns.field_ttl', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dns.field_prio', true), 'prio', ['class' => 'form-label']);
    $this->Form->fieldText('prio', $vars->ttl ?? '', [
        'id' => 'prio',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_dns.field_prio', true),
    ]);
    ?>
    </div>
</div>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('RealtimeRegister.tab_dns.field_add', true), [
        'class' => 'btn btn-primary'
    ]); ?>
</div>
                    <?php $this->Form->end(); ?>
<?php } else { ?>
<div class="text-center py-5 text-muted">
    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('RealtimeRegister.tab_dns.text_dns_disabled'); ?></p>
</div>
<?php }
?>
