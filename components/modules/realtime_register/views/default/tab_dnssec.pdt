<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('RealtimeRegister.tab_dnssec.heading'); ?></h6>

<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><?php $this->_('RealtimeRegister.tab_dnssec.heading_protocol'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dnssec.heading_flags'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dnssec.heading_algorithm'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dnssec.heading_public_key'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_dnssec.heading_options'); ?></th>
            </tr>
        </thead>
        <tbody>

            <?php if (!empty($dnssec_key)) {
                foreach ($dnssec_key as $key) { ?>
            <tr>
                <td><?php echo $this->Html->safe($key->protocol ?? ''); ?></td>
                <td><?php echo $this->Html->safe($dnssec_flags[$key->flags] ?? ($key->flags ?? '')); ?></td>
                <td><?php echo $this->Html->safe(
                    $dnssec_algorithms[$key->algorithm] ?? ($key->algorithm ?? ''),
                ); ?></td>
                <td><?php echo $this->Html->safe($key->publicKey ?? ''); ?></td>
                <td>
                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('action', 'delete');
                    $this->Form->fieldHidden('public_key', $key->publicKey ?? '');
                    ?>
                    <button class="btn btn-sm btn-outline-danger" type="submit" title="<?php $this->_('RealtimeRegister.tab_dnssec.field_delete'); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
                    <?php }
            } else {
                 ?>
            <tr>
                <td colspan="5">
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3 mb-0"><?php $this->_('RealtimeRegister.tab_dnssec.text_no_dnssec_keys'); ?></p>
                    </div>
                </td>
            </tr>
                        <?php
            } ?>
        </tbody>
    </table>
</div>

                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('action', 'add');
                    ?>
<h6 class="form-section-header"><?php $this->_('RealtimeRegister.tab_dnssec.heading_add_dnssec'); ?></h6>

<div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dnssec.field_protocol', true), 'protocol', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldText('protocol', $vars->protocol ?? '3', [
        'id' => 'protocol',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_dnssec.field_protocol', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dnssec.field_flags', true), 'flags', ['class' => 'form-label']);
    $this->Form->fieldSelect('flags', $dnssec_flags ?? [], $vars->flags ?? '', [
        'id' => 'flags',
        'class' => 'form-select',
        'placeholder' => $this->_('RealtimeRegister.tab_dnssec.field_flags', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dnssec.field_algorithm', true), 'algorithm', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldSelect('algorithm', $dnssec_algorithms ?? [], $vars->algorithm ?? '', [
        'id' => 'algorithm',
        'class' => 'form-select',
        'placeholder' => $this->_('RealtimeRegister.tab_dnssec.field_algorithm', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_dnssec.field_publicKey', true), 'publicKey', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldTextArea('publicKey', $vars->publicKey ?? '', [
        'id' => 'publicKey',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_dnssec.field_publicKey', true),
    ]);
    ?>
    </div>
</div>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('RealtimeRegister.tab_dnssec.field_add', true), [
        'class' => 'btn btn-primary'
    ]); ?>
</div>
                    <?php
$this->Form->end();
?>
