<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('RealtimeRegister.tab_hosts.heading'); ?></h6>

<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><?php $this->_('RealtimeRegister.tab_hosts.heading_host'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_hosts.heading_ip_address'); ?></th>
                <th><?php $this->_('RealtimeRegister.tab_hosts.heading_options'); ?></th>
            </tr>
        </thead>
        <tbody>

            <?php if (!empty($hosts)) {
                $i = 0;
                foreach ($hosts as $host) { ?>
            <tr>
                <td><?php echo $this->Html->safe($host['host'] ?? ''); ?></td>
                <td>
                    <?php foreach ($host['ips'] as $ip) { ?>
                    <?php echo $this->Html->safe($ip['ip'] ?? ''); ?>
                    <?php } ?>
                </td>
                <td>
                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('action', 'delete');
                    $this->Form->fieldHidden('host', $host['host'] ?? '');
                    ?>
                    <button class="btn btn-sm btn-outline-danger" type="submit" title="<?php $this->_('RealtimeRegister.tab_hosts.field_delete'); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
                    <?php $i++;}
            } else {
                 ?>
            <tr>
                <td colspan="3">
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3 mb-0"><?php $this->_('RealtimeRegister.tab_hosts.text_no_hosts'); ?></p>
                    </div>
                </td>
            </tr>
                        <?php
            } ?>
        </tbody>
    </table>
</div>

                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('action', 'add');
                    ?>
<h6 class="form-section-header"><?php $this->_('RealtimeRegister.tab_hosts.heading_add'); ?></h6>

<div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_hosts.field_host', true), 'host', ['class' => 'form-label']);
    $this->Form->fieldText('host', $vars->host ?? '', [
        'id' => 'host',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_hosts.field_host', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_hosts.field_ip_address', true), 'ip_address', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldText('ip_address[0]', $vars->ip_address[0] ?? '', [
        'id' => 'ip_address_0',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_hosts.field_ip_address', true),
    ]);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('RealtimeRegister.tab_hosts.field_ip_address', true), 'ip_address', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldText('ip_address[1]', $vars->ip_address[1] ?? '', [
        'id' => 'ip_address_1',
        'class' => 'form-control',
        'placeholder' => $this->_('RealtimeRegister.tab_hosts.field_ip_address', true),
    ]);
    ?>
    </div>
</div>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('RealtimeRegister.tab_hosts.field_add', true), [
        'class' => 'btn btn-primary'
    ]); ?>
</div>
                    <?php
$this->Form->end();
?>
