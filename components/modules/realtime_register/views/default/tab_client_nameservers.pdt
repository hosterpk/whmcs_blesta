<?php /** @var View $this **/ ?>

<?php $this->Form->create(); ?>
<h6 class="form-section-header"><?php $this->_('RealtimeRegister.tab_client_nameservers.heading'); ?></h6>

<div>
    <?php foreach ($nameserver_fields ?? [] as $name => $field) { ?>
    <div class="mb-3">
        <?php
        $this->Form->label($field['label'], $name, ['class' => 'form-label']);
        $this->Form->fieldText($name, $vars->{$name} ?? '', [
            'id' => $name,
            'class' => 'form-control',
            'placeholder' => $field['label'],
        ]);
        ?>
    </div>
    <?php } ?>
</div>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('RealtimeRegister.tab_client_nameservers.field_update', true), [
        'class' => 'btn btn-primary'
    ]); ?>
</div>
<?php $this->Form->end(); ?>
