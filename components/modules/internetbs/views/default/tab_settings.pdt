<?php /** @var View $this **/ ?>

<?php $this->Form->create(); ?>
<h6 class="form-section-header first"><?php $this->_('Internetbs.tab_settings.heading_settings'); ?></h6>
<div>
    <div class="mb-3">
    <?php $this->Form->label($this->_('Internetbs.tab_settings.field_registrar_lock', true), 'registrarlock', [
        'class' => 'form-label',
    ]); ?>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio('registrarlock', 'ENABLED', ($vars->registrarlock ?? null) == 'ENABLED', [
                'id' => 'registrarlock_yes',
                'class' => 'form-check-input',
            ]);
            $this->Form->label(
                $this->_('Internetbs.tab_settings.field_registrar_lock_yes', true),
                'registrarlock_yes',
                ['class' => 'form-check-label'],
            );
            ?>
        </div>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio('registrarlock', 'DISABLED', ($vars->registrarlock ?? null) == 'DISABLED', [
                'id' => 'registrarlock_no',
                'class' => 'form-check-input',
            ]);
            $this->Form->label($this->_('Internetbs.tab_settings.field_registrar_lock_no', true), 'registrarlock_no', [
                'class' => 'form-check-label',
            ]);
            ?>
        </div>
    </div>

    <?php if ($id_protection ?? false) { ?>
    <div class="mb-3">
        <?php $this->Form->label($this->_('Internetbs.tab_settings.field_whois_privacy', true), 'privatewhois', [
        'class' => 'form-label',
    ]); ?>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio('privatewhois', 'ENABLED', ($vars->privatewhois ?? null) == 'ENABLED', [
                'id' => 'privatewhois_yes',
                'class' => 'form-check-input',
            ]);
            $this->Form->label(
                $this->_('Internetbs.tab_settings.field_whois_privacy_state_yes', true),
                'privatewhois_yes',
                ['class' => 'form-check-label'],
            );
            ?>
        </div>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio('privatewhois', 'DISABLED', ($vars->privatewhois ?? null) == 'DISABLED', [
                'id' => 'privatewhois_no',
                'class' => 'form-check-input',
            ]);
            $this->Form->label(
                $this->_('Internetbs.tab_settings.field_whois_privacy_state_no', true),
                'privatewhois_no',
                ['class' => 'form-check-label'],
            );
            ?>
        </div>
    </div>
    <?php } ?>
</div>

<?php if ($epp_code ?? false) { ?>
<h6 class="form-section-header"><?php $this->_('Internetbs.tab_settings.heading_auth_code'); ?></h6>
<div class="pad">
    <p><?php $this->_('Internetbs.tab_settings.text_auth_code'); ?></p>
    <div><span class="badge bg-info"><?php echo $this->Html->safe($vars->transferauthinfo ?? ''); ?></span></div>
</div>
<?php } ?>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Internetbs.tab_settings.field_submit', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>
    <?php $this->Form->end();
    ?>
