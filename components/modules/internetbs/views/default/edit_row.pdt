<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Internetbs.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);
$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('Internetbs.edit_row.box_title', true));
?>

<div class="mb-3">
    <label for="api_key" class="form-label">
        <?php $this->_('Internetbs.row_meta.api_key'); ?>
    </label>
    <?php $this->Form->fieldText('api_key', $vars->api_key ?? null, ['id' => 'api_key', 'class' => 'form-control']); ?>
</div>

<div class="mb-3">
    <label for="password" class="form-label">
        <?php $this->_('Internetbs.row_meta.password'); ?>
    </label>
    <?php $this->Form->fieldText('password', $vars->password ?? null, [
        'id' => 'password',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <div class="form-check">
        <?php $this->Form->fieldCheckbox('sandbox', 'true', ($vars->sandbox ?? 'false') == 'true', [
            'id' => 'sandbox',
            'class' => 'form-check-input',
        ]); ?>
        <label for="sandbox" class="form-check-label">
            <?php $this->_('Internetbs.row_meta.sandbox'); ?>
        </label>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Internetbs.edit_row.edit_btn', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>

<?php
$this->Widget->end();
$this->Form->end();


?>
