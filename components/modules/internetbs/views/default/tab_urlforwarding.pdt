<?php /** @var View $this **/ ?>

<?php
$this->Form->create();
?>
<h6 class="form-section-header"><?php $this->_('Internetbs.tab_urlforwarding.heading_current_rules'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th><?php $this->_('Internetbs.tab_urlforwarding.heading_source'); ?></th>
                <th><?php $this->_('Internetbs.tab_urlforwarding.heading_destination'); ?></th>
                <th><?php $this->_('Internetbs.tab_urlforwarding.heading_title'); ?></th>
                <th><?php $this->_('Internetbs.tab_urlforwarding.heading_options'); ?></th>
            </tr>
        </thead>
        <tbody>

            <?php if (!empty($domain_rules)) {
                foreach ($domain_rules as $rule) { ?>
            <tr>
                <td><?php echo $this->Html->safe($rule->source); ?></td>
                <td><?php echo $this->Html->safe($rule->destination); ?></td>
                <td><?php echo $this->Html->safe($rule->title); ?></td>
                <td>
                    <a href="?delete=<?php echo urlencode($rule->source); ?>" class="btn btn-sm btn-outline-danger" title="<?php $this->_('Internetbs.tab_urlforwarding.option_delete', true); ?>">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
                    <?php }
            } else {
                 ?>
            <tr>
                <td colspan="4">
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3 mb-0"><?php $this->_(
                            'Internetbs.tab_urlforwarding.text_no_forwarding_rules',
                        ); ?></p>
                    </div>
                </td>
            </tr>
                    <?php
            } ?>
        </tbody>
    </table>
</div>

<h6 class="form-section-header"><?php $this->_('Internetbs.tab_urlforwarding.heading_add_rule'); ?></h6>
<div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('Internetbs.tab_urlforwarding.field_source', true), 'source', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldText('Source', $vars->Source ?? '', ['id' => 'source', 'class' => 'form-control']);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('Internetbs.tab_urlforwarding.field_destination', true), 'destination', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldText('Destination', $vars->Destination ?? '', ['id' => 'destination', 'class' => 'form-control']);
    ?>
    </div>
    <div class="mb-3">
    <?php
    $this->Form->label($this->_('Internetbs.tab_urlforwarding.field_title', true), 'site_title', [
        'class' => 'form-label',
    ]);
    $this->Form->fieldText('siteTitle', $vars->Title ?? '', ['id' => 'site_title', 'class' => 'form-control']);
    ?>
    </div>
</div>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit(null, $this->_('Internetbs.tab_urlforwarding.field_submit', true), [
        'class' => 'btn btn-primary'
    ]); ?>
</div>
                    <?php
$this->Form->end();
?>
