<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Plesk.tab_stats.info_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Plesk.tab_stats.info_heading.field'); ?></th>
                <th><?php $this->_('Plesk.tab_stats.info_heading.value'); ?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $keys = ['domain', 'ip_address'];
            foreach ($keys as $i => $key) {
                if (array_key_exists($key, $stats->account_info)) { ?>
            <tr>
                <td><?php $this->_('Plesk.tab_stats.info.' . $key); ?></td>
                <td><?php echo isset($stats->account_info[$key])
                    ? $this->Html->safe($stats->account_info[$key])
                    : null; ?></td>
            </tr>
                    <?php }
            }
            ?>
        </tbody>
    </table>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Plesk.tab_stats.bandwidth_title'); ?></h6>
<div class="mb-3">
