            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php echo isset($stats->bandwidth_usage['used_formatted'])
                    ? $this->Html->safe($stats->bandwidth_usage['used_formatted'])
                    : null; ?></td>
                <td><?php echo isset($stats->bandwidth_usage['limit_formatted'])
                    ? $this->Html->safe($stats->bandwidth_usage['limit_formatted'])
                    : null; ?></td>
            </tr>
        </tbody>
    </table>
</div>

