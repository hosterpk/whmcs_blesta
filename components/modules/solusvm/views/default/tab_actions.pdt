<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Solusvm.tab_actions.heading_actions'); ?></h6>
<div class="mb-3">
    <div class="options" id="solusvm_actions">
        <p>
            <?php $this->_('Solusvm.tab_actions.server_status'); ?> <span class="buff <?php echo isset($server->state)
     ? $this->Html->safe($server->state)
     : null; ?>"><?php $this->_(
    'Solusvm.tab_actions.status_' . (isset($server->state) ? $this->Html->safe($server->state) : null),
); ?></span>
            <br />
            <?php $this->_(
                'Solusvm.tab_actions.node',
                false,
                isset($server->node) ? $this->Html->safe($server->node) : null,
            ); ?>
        </p>

        <?php if ((isset($server->state) ? $server->state : null) == 'online') { ?>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                (isset($client_id) ? $client_id : null) .
                '/' .
                (isset($service_id) ? $service_id : null) .
                '/tabActions/reboot/',
        ); ?>" class="reboot btn btn-success"><i class="bi bi-arrow-clockwise"></i> <?php $this->_(
    'Solusvm.!actions.reboot',
); ?></a>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                (isset($client_id) ? $client_id : null) .
                '/' .
                (isset($service_id) ? $service_id : null) .
                '/tabActions/shutdown/',
        ); ?>" class="shutdown btn btn-danger"><i class="bi bi-power"></i> <?php $this->_(
    'Solusvm.!actions.shutdown',
); ?></a>
        <?php } elseif ((isset($server->state) ? $server->state : null) == 'offline') { ?>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                (isset($client_id) ? $client_id : null) .
                '/' .
                (isset($service_id) ? $service_id : null) .
                '/tabActions/boot/',
        ); ?>" class="boot btn btn-outline-secondary"><i class="bi bi-power"></i> <?php $this->_(
    'Solusvm.!actions.boot',
); ?></a>
        <?php } ?>
        <a href="#" class="reinstall btn btn-outline-secondary"><i class="bi bi-download"></i> <?php $this->_(
            'Solusvm.!actions.reinstall',
        ); ?></a>
        <a href="#" class="hostname btn btn-outline-secondary"><i class="bi bi-pencil"></i> <?php $this->_(
            'Solusvm.!actions.hostname',
        ); ?></a>
        <?php // Due to a bug with SolusVM, KVM support for resetting passwords does not work properly

if ((isset($type) ? $type : null) != 'kvm') { ?>
        <a href="#" class="password btn btn-outline-secondary"><i class="bi bi-lock"></i> <?php $this->_(
            'Solusvm.!actions.password',
        ); ?></a>
        <?php } ?>
    </div>
</div>

<div id="reinstall" style="display:none;">
    <h6 class="form-section-header mt-4"><?php $this->_('Solusvm.tab_actions.heading_reinstall'); ?></h6>
    <?php $this->Form->create(
        $this->base_uri .
            'clients/servicetab/' .
            (isset($client_id) ? $client_id : null) .
            '/' .
            (isset($service_id) ? $service_id : null) .
            '/tabActions/reinstall/',
    ); ?>
    <div>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Solusvm.tab_actions.field_template', true), 'template', [
                'class' => 'form-label',
            ]);
            $this->Form->fieldSelect(
                'template',
                isset($templates) ? $templates : null,
                isset($vars->template) ? $vars->template : null,
                ['id' => 'template', 'class' => 'form-select'],
            );
            ?>
        </div>
        <div class="mb-3">
            <div class="form-check">
                <?php
                $this->Form->fieldCheckbox('confirm', '1', '0', ['id' => 'confirm', 'class' => 'form-check-input']);
                $this->Form->label($this->_('Solusvm.tab_actions.field_confirm', true), 'confirm', [
                    'class' => 'form-check-label',
                ]);
                ?>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Solusvm.tab_actions.field_reinstall_submit', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>

<div id="hostname" style="display:none;">
    <h6 class="form-section-header mt-4"><?php $this->_('Solusvm.tab_actions.heading_hostname'); ?></h6>
    <?php $this->Form->create(
        $this->base_uri .
            'clients/servicetab/' .
            (isset($client_id) ? $client_id : null) .
            '/' .
            (isset($service_id) ? $service_id : null) .
            '/tabActions/hostname/',
    ); ?>
    <?php if ((isset($type) ? $type : null) != 'openvz') { ?>
    <p><?php $this->_('Solusvm.tab_actions.text_hostname_reboot'); ?></p>
    <?php } ?>
    <div>
        <?php
        $this->Form->label($this->_('Solusvm.tab_actions.field_hostname', true), 'host', ['class' => 'form-label']);
        $this->Form->fieldText('hostname', isset($vars->hostname) ? $vars->hostname : null, [
            'id' => 'host',
            'class' => 'form-control',
        ]);
        ?>
    </div>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Solusvm.tab_actions.field_hostname_submit', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>

<div id="password" style="display:none;">
    <h6 class="form-section-header mt-4"><?php $this->_('Solusvm.tab_actions.heading_password'); ?></h6>
    <?php $this->Form->create(
        $this->base_uri .
            'clients/servicetab/' .
            (isset($client_id) ? $client_id : null) .
            '/' .
            (isset($service_id) ? $service_id : null) .
            '/tabActions/password/',
    ); ?>
    <div>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Solusvm.tab_actions.field_password', true), 'pass', ['class' => 'form-label']);
            $this->Form->fieldPassword('password', ['class' => 'solusvm_password form-control', 'id' => 'pass']);
            ?>
            <a class="generate-password" href="#" data-options="<?php echo isset($password_options)
                ? $this->Html->safe($password_options)
                : null; ?>" data-length="25" data-base-url="<?php echo isset($this->base_uri)
    ? $this->Html->safe($this->base_uri)
    : null; ?>" data-for-class="solusvm_password">
                <i class="bi bi-arrow-clockwise"></i> <?php $this->_('Solusvm.tab_actions.text_generate_password'); ?>
            </a>
        </div>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Solusvm.tab_actions.field_confirm_password', true), 'confirm_password', [
                'class' => 'form-label',
            ]);
            $this->Form->fieldPassword('confirm_password', [
                'class' => 'solusvm_password form-control',
                'id' => 'confirm_password',
            ]);
            ?>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Solusvm.tab_actions.field_password_submit', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        setSolusVMInterval('<?php echo Configure::get('Solusvm.page_refresh_rate_fast'); ?>', '');
        if (typeof blestaSetHeadTag === 'function') {
            blestaSetHeadTag("link", {
                media: "screen",
                type: "text/css",
                rel: "stylesheet",
                href: "<?php echo $this->Html->safe($this->view_dir . 'css/styles.css'); ?>"
            });
        }
<?php
        if ((isset($reinstall) ? $reinstall : false)) {
?>
        showSection('reinstall');
<?php
        }
        if ((isset($hostname) ? $hostname : false)) {
?>
        showSection('hostname');
<?php
        }
        if ((isset($password) ? $password : false)) {
?>
        showSection('password');
<?php
        }
?>

        document.querySelector('.options').addEventListener('click', function(e) {
            var target = e.target.closest('a.reinstall, a.hostname, a.password');
            if (!target) return;
            var classes = target.className.split(' ');
            var option = '';
            classes.some(function(value) {
                if (['reinstall', 'hostname', 'password'].includes(value)) {
                    option = value;
                    return true;
                }
            });
            hideSections();
            showSection(option);
        });

        function hideSections() {
            document.getElementById('reinstall').style.display = 'none';
            document.getElementById('hostname').style.display = 'none';
            document.getElementById('password').style.display = 'none';
        }

        function showSection(id) {
            document.getElementById(id).style.display = '';
        }

        function setSolusVMInterval(solusvm_refresh_rate, solusvm_old_action_data) {
            var interval = '';
            interval = setInterval(function() {
                blestaRequest("GET",
                    '<?php echo $this->base_uri .
                        'clients/servicetab/' .
                        (isset($client_id) ? $client_id : null) .
                        '/' .
                        (isset($service_id) ? $service_id : null) .
                        '/tabActions/'; ?>',
                    null,
                    // Success response
                    function(data) {
                        if (data.replacer && data.content) {
                            var temp = document.createElement('div');
                            temp.innerHTML = data.content;
                            var html = temp.querySelector('#solusvm_actions').innerHTML;
                            document.getElementById('solusvm_actions').innerHTML = html;
                            solusvm_refresh_rate = (html == solusvm_old_action_data) ? '<?php echo Configure::get('Solusvm.page_refresh_rate'); ?>': '<?php echo Configure::get('Solusvm.page_refresh_rate_fast'); ?>';

                            clearInterval(interval);
                            setSolusVMInterval(solusvm_refresh_rate, html);
                        }
                    },
                    null, {
                        dataType: 'json'
                    }
                );
            }, solusvm_refresh_rate);
        }
    });
</script>