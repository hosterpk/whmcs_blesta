<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Solusvm.tab_ips.heading_ips'); ?></h6>
<div class="mb-3">
    <p><?php $this->_(
        'Solusvm.tab_ips.primary_ip',
        false,
        isset($ips->main) ? $this->Html->safe($ips->main) : null,
    ); ?></p>
</div>

<?php if (!empty($ips->extra) || !empty($ips->base)) { ?>
<h6 class="form-section-header mt-4"><?php $this->_('Solusvm.tab_ips.heading_extra_ips'); ?></h6>
<div id="solusvm-ips" class="pad">
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Solusvm.tab_ips.heading_ip'); ?></span></th>
                <th><span><?php $this->_('Solusvm.tab_ips.heading_options'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <?php
            // Set all base IPs, which may not be removed
            $i = 0;
            foreach (isset($ips->base) ? $ips->base : [] as $ip) { ?>
            <tr>
                <td><?php echo isset($ip) ? $this->Html->safe($ip) : null; ?></td>
                <td></td>
            </tr>
                    <?php $i++;}
            // Set all extra IPs
            foreach (isset($ips->extra) ? $ips->extra : [] as $ip) { ?>
            <tr>
                <td><?php echo isset($ip) ? $this->Html->safe($ip) : null; ?></td>
                <td>
                    <?php
                    $this->Form->create(
                        $this->base_uri .
                            'clients/servicetab/' .
                            (isset($client_id) ? $client_id : null) .
                            '/' .
                            (isset($service_id) ? $service_id : null) .
                            '/tabIps/',
                        ['class' => 'd-inline'],
                    );
                    $this->Form->fieldHidden('ip_address', isset($ip) ? $ip : null);
                    ?>
                    <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                        data-confirm-message="<?php echo $this->Html->safe(
                            $this->_('Solusvm.tab_ips.confirm_remove', true),
                        ); ?>"
                        title="<?php $this->_('Solusvm.tab_ips.option_remove'); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php $this->Form->end(); ?>
                </td>
            </tr>
                    <?php $i++;}
            ?>
        </tbody>
    </table>
</div>
                    <?php } ?>
