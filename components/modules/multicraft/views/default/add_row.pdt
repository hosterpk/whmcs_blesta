<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
            new bootstrap.Tooltip(el);
        });
        var default_port = "<?php echo $default_port ?? null; ?>";

        // Add a row
        document.querySelector('.ip_row_add').addEventListener('click', function() {
            var fields = document.querySelector('tr.ip_row').cloneNode(true);
            fields.querySelectorAll('input').forEach(function(el) {
                el.value = '';
            });
            var portInput = fields.querySelector('input.port');
            if (portInput && !portInput.value) {
                portInput.value = default_port;
            }
            var ip_rows = document.querySelectorAll('tr.ip_row');
            ip_rows[ip_rows.length - 1].insertAdjacentElement('afterend', fields);
            return false;
        });

        // Remove a row - using event delegation
        document.addEventListener('click', function(e) {
            if (e.target && e.target.classList.contains('ip_row_remove')) {
                if (document.querySelectorAll('tr.ip_row').length > 1) {
                    e.target.closest('tr').remove();
                }
                e.preventDefault();
                return false;
            }
        });
    });
</script>
