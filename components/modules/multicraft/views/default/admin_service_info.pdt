<?php /** @var View $this **/ ?>

<table class="table">
    <thead>
        <tr>
            <th><?php $this->_('Multicraft.service_info.options'); ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <?php
                $have_login =
                    !empty($service_fields->multicraft_login_username) &&
                    !empty($service_fields->multicraft_login_password);
                $panel_url = rtrim(isset($module_row->meta->panel_url) ? $module_row->meta->panel_url : null, '/');
                $href = $panel_url . '/index.php?r=site/login';
                if ($have_login) {
                    $this->Form->create(isset($href) ? $href : null, ['target' => '_blank']);
                    $this->Form->fieldHidden(
                        'LoginForm[name]',
                        isset($service_fields->multicraft_login_username)
                            ? $service_fields->multicraft_login_username
                            : null,
                    );
                    $this->Form->fieldHidden(
                        'LoginForm[password]',
                        isset($service_fields->multicraft_login_password)
                            ? $service_fields->multicraft_login_password
                            : null,
                    );
                    ?>
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <?php $this->_('Multicraft.service_info.option_login'); ?>
                    </button>
                    <?php
                    $this->Form->end();
                } else {
                    ?>
                    <a href="<?php echo isset($href) ? $this->Html->safe($href) : null; ?>"
                        class="btn btn-sm btn-outline-primary" target="_blank">
                        <?php $this->_('Multicraft.service_info.option_login'); ?>
                    </a>
                    <?php
                }
                ?>
            </td>
        </tr>
    </tbody>
</table>
