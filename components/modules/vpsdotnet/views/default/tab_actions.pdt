<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Vpsdotnet.tab_actions.heading_actions'); ?></h6>
<div class="mb-3">
    <div class="options">
        <p><?php $this->_('Vpsdotnet.tab_actions.server_status'); ?> <span class="buff <?php echo $this->Html->safe(
            $server_state ?? null,
        ); ?>"><?php $this->_(
            'Vpsdotnet.tab_actions.status_' . ($server_state ?? null),
        ); ?></span></p>
        <?php if (($server_state ?? null) == 'online') { ?>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                ($client_id ?? null) .
                '/' .
                ($service_id ?? null) .
                '/tabActions/reboot/',
        ); ?>" class="reboot btn btn-success"><i class="bi bi-arrow-clockwise"></i> <?php $this->_(
            'Vpsdotnet.!actions.reboot',
        ); ?></a>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                ($client_id ?? null) .
                '/' .
                ($service_id ?? null) .
                '/tabActions/shutdown/',
        ); ?>" class="shutdown btn btn-danger"><i class="bi bi-power"></i> <?php $this->_(
            'Vpsdotnet.!actions.shutdown',
        ); ?></a>
        <?php } elseif (($server_state ?? null) == 'offline') { ?>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                ($client_id ?? null) .
                '/' .
                ($service_id ?? null) .
                '/tabActions/boot/',
        ); ?>" class="boot btn btn-outline-secondary"><i class="bi bi-power"></i> <?php $this->_(
            'Vpsdotnet.!actions.boot',
        ); ?></a>
        <?php } ?>
        <a href="#" class="reinstall btn btn-outline-secondary"><i class="bi bi-download"></i> <?php $this->_(
            'Vpsdotnet.!actions.reinstall',
        ); ?></a>
        <a href="#" class="hostname btn btn-outline-secondary"><i class="bi bi-pencil"></i> <?php $this->_(
            'Vpsdotnet.!actions.hostname',
        ); ?></a>
        <a href="#" class="password btn btn-outline-secondary"><i class="bi bi-lock"></i> <?php $this->_(
            'Vpsdotnet.!actions.password',
        ); ?></a>
    </div>
</div>

<div id="reinstall" style="display:none;">
    <h6 class="form-section-header mt-4"><?php $this->_('Vpsdotnet.tab_actions.heading_reinstall'); ?></h6>
    <?php $this->Form->create(
        $this->base_uri .
            'clients/servicetab/' .
            ($client_id ?? null) .
            '/' .
            ($service_id ?? null) .
            '/tabActions/reinstall/',
    ); ?>
    <div>
        <div class="mb-3">
            <?php
            $this->Form->label(
                $this->_('Vpsdotnet.tab_actions.field_vpsdotnet_template_group', true),
                'vpsdotnet_template_group',
                ['class' => 'form-label'],
            );
            $this->Form->fieldSelect(
                'vpsdotnet_template_group',
                $template_groups ?? null,
                $vars->vpsdotnet_template_group ?? null,
                ['id' => 'vpsdotnet_template_group', 'class' => 'form-select'],
            );
            ?>
        </div>
        <div class="mb-3">
            <?php
            $this->Form->label(
                $this->_('Vpsdotnet.tab_actions.field_vpsdotnet_template', true),
                'vpsdotnet_template',
                ['class' => 'form-label'],
            );
            $this->Form->fieldSelect(
                'vpsdotnet_template',
                $templates ?? null,
                $vars->vpsdotnet_template ?? null,
                ['id' => 'vpsdotnet_template', 'class' => 'form-select'],
            );
            ?>
        </div>
        <div class="mb-3">
            <div class="form-check">
                <?php
                $this->Form->fieldCheckbox('confirm', '1', '0', ['id' => 'confirm', 'class' => 'form-check-input']);
                $this->Form->label($this->_('Vpsdotnet.tab_actions.field_confirm', true), 'confirm', [
                    'class' => 'form-check-label',
                ]);
                ?>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Vpsdotnet.tab_actions.field_reinstall_submit', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>

<div id="hostname" style="display:none;">
    <h6 class="form-section-header mt-4"><?php $this->_('Vpsdotnet.tab_actions.heading_hostname'); ?></h6>
    <?php $this->Form->create(
        $this->base_uri .
            'clients/servicetab/' .
            ($client_id ?? null) .
            '/' .
            ($service_id ?? null) .
            '/tabActions/hostname/',
    ); ?>
    <div>
        <div class="mb-3">
            <?php
            $this->Form->label(
                $this->_('Vpsdotnet.tab_actions.field_vpsdotnet_hostname', true),
                'vpsdotnet_hostname',
                ['class' => 'form-label'],
            );
            $this->Form->fieldText(
                'vpsdotnet_hostname',
                $vars->vpsdotnet_hostname ?? null,
                ['id' => 'vpsdotnet_hostname', 'class' => 'form-control'],
            );
            ?>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Vpsdotnet.tab_actions.field_hostname_submit', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>

<div id="password" style="display:none;">
    <h6 class="form-section-header mt-4"><?php $this->_('Vpsdotnet.tab_actions.heading_password'); ?></h6>
    <?php
    $this->Form->create(
        $this->base_uri .
            'clients/servicetab/' .
            ($client_id ?? null) .
            '/' .
            ($service_id ?? null) .
            '/tabActions/password/',
    );
    $this->Form->fieldHidden('vpsdotnet_reset_password', 1);
    ?>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('Vpsdotnet.tab_actions.field_password_submit', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof blestaSetHeadTag === 'function') {
            blestaSetHeadTag("link", {
                media: "screen",
                type: "text/css",
                rel: "stylesheet",
                href: "<?php echo $this->Html->safe($this->view_dir . 'css/styles.css'); ?>"
            });
        }
<?php if ($reinstall ?? false) { ?>
        showSection('reinstall');
<?php } if ($hostname ?? false) { ?>
        showSection('hostname');
<?php } if ($password ?? false) { ?>
        showSection('password');
<?php } ?>

        document.getElementById('vpsdotnet_template_group').addEventListener('change', function() {
            blestaRequest('get', '<?php echo $this->Html->safe(
                $this->base_uri .
                    'clients/servicetab/' .
                    ($client_id ?? null) .
                    '/' .
                    ($service_id ?? null) .
                    '/tabActions/gettemplatesfromgroup/' .
                    ($module_row_id ?? null) .
                    '/' .
                    ($cloud_id ?? null) .
                    '/'
            ); ?>' + this.value, null,
                function(data) {
                    if (data) {
                        var select = document.getElementById('vpsdotnet_template');
                        while (select.options.length) select.remove(0);
                        Object.entries(data).forEach(function([val, text]) {
                            select.add(new Option(text, val));
                        });
                    }
                },
                null, {
                    dataType: 'json'
                }
            );
        });

        ['reinstall', 'hostname', 'password'].forEach(function(section) {
            var btn = document.querySelector('.options a.' + section);
            if (btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    hideSections();
                    showSection(section);
                });
            }
        });

        function hideSections() {
            document.getElementById('reinstall').style.display = 'none';
            document.getElementById('hostname').style.display = 'none';
            document.getElementById('password').style.display = 'none';
        }

        function showSection(id) {
            document.getElementById(id).style.display = '';
        }
    });
</script>
