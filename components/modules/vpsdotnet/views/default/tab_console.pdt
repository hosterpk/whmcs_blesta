<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Vpsdotnet.tab_console.heading_console'); ?></h6>
<div class="mb-3">
    <div>
        <div class="mb-3">
            <?php $this->_('Vpsdotnet.tab_console.root_password'); ?> <?php echo $this->Html->safe(
                $service_fields->vpsdotnet_password ?? null,
            ); ?>
        </div>
    </div>
    <?php // Display the console applet

    if (($console ?? null) && $console) { ?>
    <applet width="100%" height="700" archive="https://console.vps.net/vnc.jar" code="VncViewer.class" codebase="https://console.vps.net/vnc/">
        <param name="PORT" value="<?php echo $this->Html->safe($console->port ?? null); ?>" />
        <param name="PASSWORD" value="<?php echo $this->Html->safe($console->password ?? null); ?>" />
    </applet>
    <?php } ?>
</div>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof blestaSetHeadTag === 'function') {
            blestaSetHeadTag("link", {
                media: "screen",
                type: "text/css",
                rel: "stylesheet",
                href: "<?php echo $this->Html->safe($this->view_dir . 'css/styles.css'); ?>"
            });
        }
    });
</script>
