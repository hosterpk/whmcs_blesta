<?php
/** @var View $this **/
?>

<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Vpsdotnet.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);

$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('Vpsdotnet.add_row.box_title', true));
?>

<h6 class="form-section-header"><?php $this->_('Vpsdotnet.add_row.basic_title'); ?></h6>

<div class="mb-3">
    <label for="server_name" class="form-label">
        <?php $this->_('Vpsdotnet.row_meta.server_name'); ?>
    </label>
    <?php $this->Form->fieldText('server_name', $vars->server_name ?? null, [
        'id' => 'server_name',
        'class' => 'form-control',
    ]); ?>
</div>

<div class="mb-3">
    <label for="email" class="form-label">
        <?php $this->_('Vpsdotnet.row_meta.email'); ?>
    </label>
    <?php $this->Form->fieldText('email', $vars->email ?? null, ['id' => 'email', 'class' => 'form-control']); ?>
</div>

<div class="mb-3">
    <label for="key" class="form-label">
        <?php $this->_('Vpsdotnet.row_meta.key'); ?>
    </label>
    <?php $this->Form->fieldText('key', $vars->key ?? null, ['id' => 'key', 'class' => 'form-control']); ?>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Vpsdotnet.add_row.add_btn', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>

<?php
$this->Widget->end();
$this->Form->end();


?>
