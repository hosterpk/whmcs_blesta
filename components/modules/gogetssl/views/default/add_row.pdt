<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Gogetssl.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);

$this->Widget->create($this->_('GoGetSSL.add_row.box_title', true));
?>
        <?php $this->Form->create(null, ['class' => 'disable-on-submit']); ?>
    <h6 class="form-section-header"><?php $this->_('GoGetSSL.add_row.basic_title'); ?></h6>

    <div class="mb-3">
        <label for="gogetssl_name" class="form-label">
            <?php $this->_('GoGetSSL.row_meta.gogetssl_name'); ?>
        </label>
        <?php $this->Form->fieldText('gogetssl_name', isset($vars->gogetssl_name) ? $vars->gogetssl_name : null, [
            'id' => 'gogetssl_name',
            'class' => 'form-control',
        ]); ?>
    </div>

    <div class="mb-3">
        <label for="api_username" class="form-label">
            <?php $this->_('GoGetSSL.row_meta.api_username'); ?>
        </label>
        <?php $this->Form->fieldText('api_username', isset($vars->api_username) ? $vars->api_username : null, [
            'id' => 'api_username',
            'class' => 'form-control',
        ]); ?>
    </div>

    <div class="mb-3">
        <label for="api_password" class="form-label">
            <?php $this->_('GoGetSSL.row_meta.api_password'); ?>
        </label>
        <?php $this->Form->fieldText('api_password', isset($vars->api_password) ? $vars->api_password : null, [
            'id' => 'api_password',
            'class' => 'form-control',
        ]); ?>
    </div>

    <div class="mb-3">
        <div class="form-check">
            <?php $this->Form->fieldCheckbox(
                'sandbox',
                'true',
                (isset($vars->sandbox) ? $vars->sandbox : null) == 'true',
                ['id' => 'sandbox', 'class' => 'form-check-input'],
            ); ?>
            <label for="sandbox" class="form-check-label">
                <?php $this->_('GoGetSSL.row_meta.sandbox'); ?>
            </label>
        </div>
    </div>

    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('save', $this->_('GoGetSSL.add_row.add_btn', true), [
