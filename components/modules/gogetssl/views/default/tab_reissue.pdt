<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('GoGetSSL.tab_reissue.heading_reissue'); ?></h6>
<?php $this->Form->create(
    $this->base_uri .
        'clients/servicetab/' .
        (isset($client_id) ? $client_id : null) .
        '/' .
        (isset($service_id) ? $service_id : null) .
        '/tabClientReissue/',
); ?>
<div class="row g-3">
    <div class="col-12">
        <?php
        $this->Form->label(
            $this->_('GoGetSSL.service_field.gogetssl_approver_email', true),
            'gogetssl_approver_email',
            ['class' => 'form-label'],
        );
        $this->Form->fieldSelect(
            'gogetssl_approver_email',
            isset($gogetssl_approver_emails) ? $gogetssl_approver_emails : null,
            isset($vars->gogetssl_approver_email) ? $vars->gogetssl_approver_email : null,
            ['id' => 'gogetssl_approver_email', 'class' => 'form-select'],
        );
        ?>
    </div>
    <div class="col-12">
        <?php
        $this->Form->label($this->_('GoGetSSL.service_field.gogetssl_csr', true), 'gogetssl_csr', [
            'class' => 'form-label',
        ]);
        $this->Form->fieldTextArea('gogetssl_csr', isset($vars->gogetssl_csr) ? $vars->gogetssl_csr : null, [
            'id' => 'gogetssl_csr',
            'class' => 'form-control',
        ]);
        ?>
    </div>
    <div class="col-12">
        <?php
        $this->Form->label(
            $this->_('GoGetSSL.service_field.gogetssl_webserver_type', true),
            'gogetssl_webserver_type',
            ['class' => 'form-label'],
        );
        $this->Form->fieldSelect(
            'gogetssl_webserver_type',
            isset($gogetssl_webserver_types) ? $gogetssl_webserver_types : null,
            isset($vars->gogetssl_webserver_type) ? $vars->gogetssl_webserver_type : null,
            ['id' => 'gogetssl_webserver_type', 'class' => 'form-select'],
        );
        ?>
    </div>
</div>
<div class="d-flex justify-content-end mt-3">
    <?php $this->Form->fieldSubmit('save', $this->_('GoGetSSL.tab_reissue.heading_reissue', true), [
