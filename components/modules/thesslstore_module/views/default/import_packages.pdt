<?php /** @var View $this **/ ?>

<?php
if (isset($_REQUEST['error']) && $_REQUEST['error'] == 'false') { ?>
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <?php echo $_REQUEST['count']; ?> <?php $this->_('ThesslstoreModule.!success.import_package_success'); ?>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<?php } ?>

<?php
if (isset($_REQUEST['error']) && $_REQUEST['error'] == 'true') { ?>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
    <?php $this->_('ThesslstoreModule.!error.import_package_error'); ?>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<?php } elseif (isset($_REQUEST['error']) && $_REQUEST['error'] == 'no_products') { ?>
<div class="alert alert-warning alert-dismissible fade show" role="alert">
    <?php $this->_('ThesslstoreModule.!error.import_no_products'); ?>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<?php } ?>

<?php
echo isset($message) ? $message : null;

$this->Form->create(null, ['class' => 'disable-on-submit']);

$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Thesslstore_module.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . ($module->id ?? '')],
    ],
]);
$this->Widget->create($this->_('ThesslstoreModule.add_row.box_title', true));
?>

<h6 class="form-section-header"><?php $this->_('ThesslstoreModule.add_row.import_packages'); ?></h6>

<?php if ($vars->packageGroupsArray == 'false') { ?>
<div class="alert alert-warning" role="alert">
    <?php $this->_('ThesslstoreModule.!error.empty_package_group'); ?>
</div>
<?php } else { ?>

<div class="mb-3">
    <label for="product_group" class="form-label">
        <?php $this->_('ThesslstoreModule.row_meta.product_group'); ?>
    </label>
    <?php $this->Form->fieldSelect('product_group', $vars->packageGroups, $vars->product_group ?? null, [
        'id' => 'product_group',
        'class' => 'form-select',
    ]); ?>
</div>

<div class="mb-3">
    <label for="profit_margin" class="form-label">
        <?php $this->_('ThesslstoreModule.row_meta.profit_margin'); ?>
    </label>
    <?php $this->Form->fieldText('profit_margin', $vars->profit_margin ?? null, [
        'id' => 'profit_margin',
        'class' => 'form-control',
    ]); ?>
    <div class="form-text"><?php $this->_('ThesslstoreModule.import_packages.margin_note'); ?></div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('ThesslstoreModule.import_packages_row.add_btn', true), ['class' => 'btn btn-primary']); ?>
</div>

<?php } ?>

<?php
$this->Widget->end();
$this->Form->end();
?>
