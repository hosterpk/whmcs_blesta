<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();
$this->Widget->create($this->_('ThesslstoreModule.reseller_price.box_title', true));
?>

<p class="mb-3">
    <strong>Note:</strong> Below is your "<?php echo isset($api_mode) ? $this->Html->safe($api_mode) : null; ?>" account pricing in USD.
</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Package Name</th>
                <th>Product Code</th>
                <th>Currency Code</th>
                <th>1 Year</th>
                <th>2 Year</th>
                <th>3 Year</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($reseller_pricing as $pcode => $pricing) { ?>
            <tr>
                <td><?php echo isset($pricing['name']) ? $this->Html->safe($pricing['name']) : null; ?></td>
                <td><?php echo $this->Html->safe($pcode); ?></td>
                <td>USD</td>
                <td>
                    <?php echo isset($pricing['1year_price']) ? $this->Html->safe($pricing['1year_price']) : 'N/A'; ?>
                </td>
                <td>
                    <?php echo isset($pricing['2year_price']) ? $this->Html->safe($pricing['2year_price']) : 'N/A'; ?>
                </td>
                <td>
                    <?php echo isset($pricing['3year_price']) ? $this->Html->safe($pricing['3year_price']) : 'N/A'; ?>
                </td>
            </tr>

            <?php if ($pricing['has_additional_san']) { ?>
            <tr>
                <td>+ Additional SAN</td>
                <td>-</td>
                <td>USD</td>
                <td>
                    <?php echo isset($pricing['1year_san_price']) ? $this->Html->safe($pricing['1year_san_price']) : 'N/A'; ?>
                </td>
                <td>
                    <?php echo isset($pricing['2year_san_price']) ? $this->Html->safe($pricing['2year_san_price']) : 'N/A'; ?>
                </td>
                <td>
                    <?php echo isset($pricing['3year_san_price']) ? $this->Html->safe($pricing['3year_san_price']) : 'N/A'; ?>
                </td>
            </tr>
            <?php } ?>

            <?php if ($pricing['has_additional_server']) { ?>
            <tr>
                <td>+ Additional Server</td>
                <td>-</td>
                <td>USD</td>
                <td>
                    <?php echo isset($pricing['1year_server_price']) ? $this->Html->safe($pricing['1year_server_price']) : 'N/A'; ?>
                </td>
                <td>
                    <?php echo isset($pricing['2year_server_price']) ? $this->Html->safe($pricing['2year_server_price']) : 'N/A'; ?>
                </td>
                <td>
                    <?php echo isset($pricing['3year_server_price']) ? $this->Html->safe($pricing['3year_server_price']) : 'N/A'; ?>
                </td>
            </tr>
            <?php } ?>

            <?php } ?>
        </tbody>
    </table>
</div>

<?php $this->Widget->end(); ?>
