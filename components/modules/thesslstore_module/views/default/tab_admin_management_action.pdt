<?php /** @var View $this **/ ?>

<div class="d-flex flex-wrap gap-2">
    <?php if (
        ($orderMajorStatus == 'Pending' || $orderMinorStatus == 'PENDING_REISSUE') &&
        $fileContent != '' &&
        $fileName != ''
    ) {
        $this->Form->create(
            $this->base_uri .
                'clients/servicetab/' .
                (isset($clientID) ? $clientID : null) .
                '/' .
                (isset($serviceID) ? $serviceID : null) .
                '/tabClientDownloadAuthFile/',
        ); ?>
    <button class="btn btn-outline-secondary" type="submit" name="save">
        <?php $this->_('ThesslstoreModule.tab_DownloadAuthFile'); ?>
    </button>
    <?php $this->Form->end();
    } ?>

    <?php if ($orderMajorStatus == 'Active') {
        $this->Form->create(
            $this->base_uri .
                'clients/servicetab/' .
                (isset($clientID) ? $clientID : null) .
                '/' .
                (isset($serviceID) ? $serviceID : null) .
                '/tabClientDownloadCertificate/',
        ); ?>
    <button class="btn btn-outline-secondary" type="submit" name="save">
        <?php $this->_('ThesslstoreModule.tab_DownloadCertificate'); ?>
    </button>
    <?php $this->Form->end();
    } ?>

    <?php if (
        ($orderMajorStatus == 'Pending' || $orderMinorStatus == 'PENDING_REISSUE') &&
        $fileContent == '' &&
        $fileName == ''
    ) {
        if ($VendorName != 'SYMANTEC' || ($VendorName == 'SYMANTEC' && $hide_changeapprover_option != 'YES')) {
            $this->Form->create(
                $this->base_uri .
                    'clients/servicetab/' .
                    (isset($clientID) ? $clientID : null) .
                    '/' .
                    (isset($serviceID) ? $serviceID : null) .
                    '/tabAdminChangeApproverEmail/',
            ); ?>
    <button class="btn btn-outline-secondary" type="submit" name="save">
        <?php $this->_('ThesslstoreModule.tab_ChangeApproverEmail'); ?>
    </button>
    <?php $this->Form->end();
        }
    } ?>

    <?php if (
        ($orderMajorStatus == 'Pending' || $orderMinorStatus == 'PENDING_REISSUE') &&
        $fileContent == '' &&
        $fileName == ''
    ) {
        $this->Form->create(
            $this->base_uri .
                'clients/servicetab/' .
                (isset($clientID) ? $clientID : null) .
                '/' .
                (isset($serviceID) ? $serviceID : null) .
                '/tabClientResendApproverEmail/',
        ); ?>
    <button class="btn btn-outline-secondary" type="submit" name="save">
        <?php $this->_('ThesslstoreModule.tab_ResendApproverEmail'); ?>
    </button>
    <?php $this->Form->end();
    } ?>
</div>
