<?php /** @var View $this **/ ?>

<?php $this->Form->create(); ?>

<h6 class="form-section-header"><?php $this->_('ThesslstoreModule.tab_select_approver_email'); ?></h6>

<div class="mb-3">
    <p class="fw-bold"><?php echo $this->Html->safe($domainName); ?></p>
    <?php $this->Form->fieldHidden('domains[0]', $domainName); ?>
    <?php $this->Form->fieldHidden('approverEmail[0]', $approverEmail); ?>
    <?php foreach ($approverEmailsListArray as $value => $key) { ?>
    <div class="form-check">
        <?php
        $checked = isset($key) && $key == $approverEmail;
        $this->Form->fieldRadio('email[0]', $key, $checked, ['id' => $domainName . $key, 'class' => 'form-check-input']);
        $this->Form->label($key, $domainName . $key, ['class' => 'form-check-label']);
        ?>
    </div>
    <?php } ?>
</div>

<?php
$domainsCount = count($domainNames);
for ($i = 0; $i < $domainsCount; $i++) {
    $j = $i + 1; ?>
<div class="mb-3">
    <p class="fw-bold"><?php echo $this->Html->safe($domainNames[$i]); ?></p>
    <?php $this->Form->fieldHidden("domains[$j]", $domainNames[$i]); ?>
    <?php $this->Form->fieldHidden("approverEmail[$j]", $approverEmails[$i]); ?>
    <?php foreach ($approverEmailsListArrays[$i] as $values => $keys) { ?>
    <div class="form-check">
        <?php
        $checked = isset($keys) && $keys == $approverEmails[$i];
        $this->Form->fieldRadio("email[$j]", $keys, $checked, [
            'id' => $domainNames[$i] . $keys,
            'class' => 'form-check-input',
        ]);
        $this->Form->label($keys, $domainNames[$i] . $keys, ['class' => 'form-check-label']);
        ?>
    </div>
    <?php } ?>
</div>
<?php } ?>

<div class="d-flex justify-content-start">
    <button class="btn btn-primary" type="submit" name="save">
        <?php $this->_('ThesslstoreModule.change_approver_email.save_btn'); ?>
    </button>
</div>

<?php $this->Form->end(); ?>
