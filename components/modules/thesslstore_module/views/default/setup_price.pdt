                            "price[{$data['san_pricing']['2year']['pricing_id']}]",
                            $data['san_pricing']['2year']['price'],
                            ['class' => 'form-control form-control-sm'],
                        );
                    } else {
                        echo 'N/A';
                    } ?>
                </td>
                <td>
                    <?php if (isset($data['san_pricing']['3year'])) {
                        $this->Form->fieldText(
                            "price[{$data['san_pricing']['3year']['pricing_id']}]",
                            $data['san_pricing']['3year']['price'],
                            ['class' => 'form-control form-control-sm'],
                        );
                    } else {
