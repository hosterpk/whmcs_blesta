<?php /** @var View $this **/ ?>

<?php
if (isset($_REQUEST['msg'])) {
    if ($_REQUEST['msg'] == 'success') { ?>
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <?php $this->_('ThesslstoreModule.setup_price.update_success'); ?>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
    <?php } elseif ($_REQUEST['msg'] == 'modeupdated') { ?>
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <?php $this->_('ThesslstoreModule.setup_price.update_mode'); ?>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
    <?php }
} ?>

<?php
$this->Form->create(null, ['class' => 'disable-on-submit']);

$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Thesslstore_module.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . ($module->id ?? '')],
    ],
]);
$this->Widget->create($this->_('ThesslstoreModule.add_row.box_title', true));
?>

<h6 class="form-section-header"><?php $this->_('ThesslstoreModule.add_row.setup_price'); ?></h6>

<div class="mb-3">
    <div class="form-check">
        <?php $this->Form->fieldCheckbox(
            'thesslstore_apply_margin',
            'yes',
            ($vars->thesslstore_apply_margin ?? null) == 'yes',
            ['id' => 'thesslstore_apply_margin', 'class' => 'form-check-input'],
        ); ?>
        <label for="thesslstore_apply_margin" class="form-check-label">
            <?php $this->_('ThesslstoreModule.setup_price.apply_margin'); ?>
        </label>
    </div>
</div>

<div class="mb-3">
    <?php
    $margin_attr = ['id' => 'thesslstore_margin_percentage', 'class' => 'form-control'];
    if (($vars->thesslstore_apply_margin ?? null) != 'yes') {
        $margin_attr['disabled'] = 'disabled';
    }
    ?>
    <label for="thesslstore_margin_percentage" class="form-label" id="label_margin_percentage">
        <?php $this->_('ThesslstoreModule.setup_price.margin_percentage'); ?>
    </label>
    <?php $this->Form->fieldText(
        'thesslstore_margin_percentage',
        $vars->thesslstore_margin_percentage ?? null,
        $margin_attr,
    ); ?>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Package Group</th>
                <th>Package Name</th>
                <th>Product Code</th>
                <th>Currency Code</th>
                <th>1 Year</th>
                <th>2 Year</th>
                <th>3 Year</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($package_data as $id => $data) { ?>
            <tr>
                <?php $this->Form->fieldHidden('packages_id[]', $id); ?>
                <td><?php echo $data['group_name'] ?? null; ?></td>
                <td><?php echo $data['name'] ?? null; ?></td>
                <td><?php echo $data['product_code'] ?? null; ?></td>
                <td>USD</td>
                <td>
                    <?php if (isset($data['pricing']['1year'])) {
                        $this->Form->fieldText(
                            "price[{$data['pricing']['1year']['pricing_id']}]",
                            $data['pricing']['1year']['price'],
                            ['class' => 'form-control form-control-sm'],
                        );
                    } else {
                        echo 'N/A';
                    } ?>
                </td>
                <td>
                    <?php if (isset($data['pricing']['2year'])) {
                        $this->Form->fieldText(
                            "price[{$data['pricing']['2year']['pricing_id']}]",
                            $data['pricing']['2year']['price'],
                            ['class' => 'form-control form-control-sm'],
                        );
                    } else {
                        echo 'N/A';
                    } ?>
                </td>
                <td>
                    <?php if (isset($data['pricing']['3year'])) {
                        $this->Form->fieldText(
                            "price[{$data['pricing']['3year']['pricing_id']}]",
                            $data['pricing']['3year']['price'],
                            ['class' => 'form-control form-control-sm'],
                        );
                    } else {
                        echo 'N/A';
                    } ?>
                </td>
            </tr>

            <?php if ($data['has_additional_san']) { ?>
            <tr>
                <td></td>
                <td>+ Additional SAN</td>
                <td>-</td>
                <td>USD</td>
                <td>
                    <?php if (isset($data['san_pricing']['1year'])) {
                        $this->Form->fieldText(
                            "price[{$data['san_pricing']['1year']['pricing_id']}]",
