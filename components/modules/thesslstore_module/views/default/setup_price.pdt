                            $data['server_pricing']['1year']['price'],
                            ['class' => 'form-control form-control-sm'],
                        );
                    } else {
                        echo 'N/A';
                    } ?>
                </td>
                <td>
                    <?php if (isset($data['server_pricing']['2year'])) {
                        $this->Form->fieldText(
                            "price[{$data['server_pricing']['2year']['pricing_id']}]",
                            $data['server_pricing']['2year']['price'],
