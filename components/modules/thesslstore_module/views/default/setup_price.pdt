                    } ?>
                </td>
            </tr>
            <?php } ?>

            <?php } ?>
        </tbody>
    </table>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <?php if (isset($reseller_price_link)) { ?>
    <a target="_blank" class="btn btn-outline-secondary" href="<?php echo $this->Html->safe($reseller_price_link); ?>">
        <?php $this->_('ThesslstoreModule.setup_price.view_reseller_price'); ?>
    </a>
    <?php } ?>
    <?php $this->Form->fieldSubmit('save', $this->_('ThesslstoreModule.credential_row.add_btn', true), [
        'class' => 'btn btn-primary',
        'id' => 'save_price_btn',
    ]); ?>
</div>

<?php
$this->Widget->end();
$this->Form->end();
?>
<script>
document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('thesslstore_apply_margin').addEventListener('change', function() {
        document.getElementById('thesslstore_margin_percentage').disabled = !this.checked;
    });

    document.getElementById('label_margin_percentage').addEventListener('click', function() {
        if (document.getElementById('thesslstore_margin_percentage').disabled) {
            alert('Please check the Apply Profit Margin checkbox first');
        }
    });

    document.getElementById('save_price_btn').addEventListener('click', function(e) {
        if (!window.confirm('Do you really want to update the price?')) {
            e.preventDefault();
        }
    });
});
</script>
