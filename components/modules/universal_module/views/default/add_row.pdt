<script type="text/javascript" src="<?php echo VENDORWEBDIR . 'blesta/ckeditor/build/ckeditor.js'; ?>"></script>
<script type="text/javascript" src="<?php echo VENDORWEBDIR . 'ace/src-min/ace.js'; ?>"></script>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Add a package field row
    var packageRowAdd = document.querySelector('.package_row_add');
    if (packageRowAdd) {
        packageRowAdd.addEventListener('click', function(e) {
            e.preventDefault();
            var tbody = this.closest('.mb-3').querySelector('table tbody');
            var firstRow = tbody.querySelector('tr.field_row');
            var newRow = firstRow.cloneNode(true);
            newRow.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function(el) {
                el.value = '';
            });
            newRow.querySelectorAll('select').forEach(function(el) { el.selectedIndex = 0; });
            tbody.appendChild(newRow);
            blestaBindToolTips(newRow);
        });
    }

    // Add a service field row
    var serviceRowAdd = document.querySelector('.service_row_add');
    if (serviceRowAdd) {
        serviceRowAdd.addEventListener('click', function(e) {
            e.preventDefault();
            var tbody = this.closest('.mb-3').querySelector('table tbody');
            var firstRow = tbody.querySelector('tr.field_row');
            var newRow = firstRow.cloneNode(true);
            newRow.querySelectorAll('input[type="text"], input[type="hidden"], textarea').forEach(function(el) {
                el.value = '';
            });
            newRow.querySelectorAll('select').forEach(function(el) { el.selectedIndex = 0; });
            tbody.appendChild(newRow);
            blestaBindToolTips(newRow);
        });
    }

    // Remove a row (event delegation)
    document.addEventListener('click', function(e) {
        var removeBtn = e.target.closest('.row_remove');
        if (!removeBtn) return;
        e.preventDefault();
        var table = removeBtn.closest('table');
        if (table.querySelectorAll('tr.field_row').length > 1) {
            removeBtn.closest('tr.field_row').remove();
        }
    });

    // Bind WYSIWYG editors
    var lang = '<?php echo substr(Configure::get('Blesta.language'), 0, 2); ?>';
    var editorInstances = {};
    ['service_email_html', 'package_email_html'].forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        blestaBindWysiwygEditor(el, {language: lang}).then(function(result) {
            if (result && result.editor) {
                editorInstances[id] = result.editor;
            }
        });
    });

    var form = document.querySelector('form.disable-on-submit');
    if (form) {
        form.addEventListener('submit', function() {
            ['service_email_html', 'package_email_html'].forEach(function(id) {
                var editor = editorInstances[id];
                if (editor && typeof editor.getData === 'function') {
                    var el = document.getElementById(id);
                    if (el) el.value = editor.getData();
                }
            });
        });
    }

    // Tabbed content
    document.querySelectorAll('div.tab_content').forEach(function(tabContent) {
        var tabs = tabContent.querySelectorAll('.tabs li');
        var panels = tabContent.querySelectorAll('.inner_content > div');
        panels.forEach(function(panel, i) {
            if (i > 0) panel.style.display = 'none';
        });
        tabs.forEach(function(tab, i) {
            tab.addEventListener('click', function(e) {
                e.preventDefault();
                tabs.forEach(function(t) { t.classList.remove('current'); });
                tab.classList.add('current');
                panels.forEach(function(p) { p.style.display = 'none'; });
                if (panels[i]) panels[i].style.display = '';
            });
        });
    });

    initializeEditor('service_client_info');
    initializeEditor('service_admin_info');
});

function initializeEditor(selector) {
    var textarea = document.getElementById(selector);
    if (!textarea) return;

    var editorDiv = document.createElement('div');
    editorDiv.id = 'ace_' + selector;
    editorDiv.style.minHeight = '250px';
    editorDiv.style.width = '100%';
    editorDiv.classList.add('border', 'rounded');

    textarea.style.display = 'none';
    textarea.parentNode.insertBefore(editorDiv, textarea.nextSibling);

    var editor = ace.edit('ace_' + selector);
    editor.session.setMode('ace/mode/html');
    editor.setOptions({
        fontSize: '14px',
        showPrintMargin: false,
        wrap: true
    });

    editor.setValue(textarea.value || '', -1);

    editor.session.on('change', function() {
        textarea.value = editor.getValue();
    });
}
</script>
