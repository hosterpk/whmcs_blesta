<?php /** @var View $this **/ ?>

<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Cwatch.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . $module->id],
    ],
]);

$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('CWatch.edit_row.box_title', true));
?>

    <h6 class="form-section-header"><?php $this->_('CWatch.edit_row.basic_title'); ?></h6>

    <div class="mb-3">
        <label for="username" class="form-label">
            <?php $this->_('CWatch.edit_row.field_username'); ?>
        </label>
        <?php $this->Form->fieldText('username', $vars->username ?? null, [
            'id' => 'username',
            'class' => 'form-control',
        ]); ?>
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">
            <?php $this->_('CWatch.edit_row.field_password'); ?>
        </label>
        <?php $this->Form->fieldPassword('password', [
            'id' => 'password',
            'class' => 'form-control',
            'value' => $vars->password ?? null,
        ]); ?>
    </div>

    <div class="mb-3">
        <div class="form-check">
            <?php $this->Form->fieldCheckbox(
                'cwatch_sandbox',
                'true',
                ($vars->cwatch_sandbox ?? null) == 'true',
                ['id' => 'cwatch_sandbox', 'class' => 'form-check-input'],
            ); ?>
            <label for="cwatch_sandbox" class="form-check-label">
                <?php $this->_('CWatch.edit_row.field_sandbox'); ?>
            </label>
        </div>
    </div>

    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('submit', $this->_('CWatch.edit_row.add_btn', true), [
            'class' => 'btn btn-primary',
        ]); ?>
    </div>

<?php $this->Widget->end(); ?>

<?php $this->Form->end();
