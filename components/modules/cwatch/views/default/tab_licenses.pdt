<?php /** @var View $this **/ ?>

<?php if (isset($message)) { ?>
<div><?php echo isset($message) ? $message : null; ?></div>
    <?php } ?>
<h6 class="form-section-header"><?php $this->_('CWatch.tab_licenses.licenses'); ?></h6>
    <?php if (!empty($licenses)) { ?>
<table class="table table-bordered table-striped" id="licenses">
    <thead>
        <tr>
            <th><?php $this->_('CWatch.tab_licenses.licenseKey'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.type'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.domain'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.status'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.malware_scanner'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.options'); ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($licenses as $key => $license) { ?>
        <tr>
            <td><?php echo isset($license->licenseKey) ? $this->Html->safe($license->licenseKey) : null; ?></td>
            <td><?php echo isset($license->productTitle) ? $this->Html->safe($license->productTitle) : null; ?></td>
            <td><?php echo isset($license->site->domain) ? $this->Html->safe($license->site->domain) : null; ?></td>
            <td><?php echo $this->Html->safe(
                isset($site_statuses[$license->site->status ?? null])
                    ? $site_statuses[$license->site->status ?? null]
                    : (isset($license->site->status)
                        ? $license->site->status
                        : null),
            ); ?></td>
            <td><?php echo (isset($license->site->scanner)
                    ? $license->site->scanner
                    : null)
                ? (isset($license->site->scanner->status)
                    ? $this->Html->safe($license->site->scanner->status)
                    : null)
                : $this->_('CWatch.tab_licenses.not_applicable', true); ?></td>
            <td>
                <?php if ((isset($license->site->status) ? $license->site->status : null) == 'Valid') {

                    $this->Form->create(
                        $this->base_uri .
                            'clients/serviceTab/' .
                            (isset($service->client_id) ? $service->client_id : null) .
                            '/' .
                            (isset($service->id) ? $service->id : null) .
                            '/tabLicenses/',
                        ['class' => 'd-inline'],
                    );
                    $this->Form->fieldHidden('domain', isset($license->site->domain) ? $license->site->domain : null);
                    $this->Form->fieldHidden('action', 'remove_domain');
                    ?>
                <a href="<?php echo $this->Html->safe(
                    $this->base_uri .
                        'clients/serviceTab/' .
                        (isset($service->client_id) ? $service->client_id : null) .
                        '/' .
                        (isset($service->id) ? $service->id : null) .
                        '/tabLicenses/?action=upgrade_site&key=' .
                        (isset($license->licenseKey) ? $license->licenseKey : null),
                ); ?>" class="btn btn-sm btn-outline-success" title="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.upgrade_site', true)); ?>">
                    <i class="bi bi-arrow-up-circle"></i>
                </a>
                <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                    data-confirm-message="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.confirm_delete', true)); ?>"
                    title="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.remove_site', true)); ?>">
                    <i class="bi bi-trash"></i>
                </button>
                <?php $this->Form->end(); ?>
                <?php
                } else {
                     ?>
                <a href="<?php echo $this->Html->safe(
                    $this->base_uri .
                        'clients/serviceTab/' .
                        (isset($service->client_id) ? $service->client_id : null) .
                        '/' .
                        (isset($service->id) ? $service->id : null) .
                        '/tabLicenses/?action=add_site&key=' .
                        (isset($license->licenseKey) ? $license->licenseKey : null),
                ); ?>" class="btn btn-sm btn-outline-secondary" title="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.add_site', true)); ?>">
                    <i class="bi bi-plus-circle"></i>
                </a>
                <?php
                } ?>
                <?php
                $this->Form->create(
                    $this->base_uri .
                        'clients/serviceTab/' .
                        (isset($service->client_id) ? $service->client_id : null) .
                        '/' .
                        (isset($service->id) ? $service->id : null) .
                        '/tabLicenses/',
                    ['class' => 'd-inline'],
                );
                $this->Form->fieldHidden('licenseKey', isset($license->licenseKey) ? $license->licenseKey : null);
                $this->Form->fieldHidden('action', 'deactivate_license');
                ?>
                <button type="button" class="btn btn-sm btn-outline-warning modal-confirm-delete"
                    data-confirm-message="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.confirm_deactivate', true)); ?>"
                    title="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.deactivate_license', true)); ?>">
                    <i class="bi bi-power"></i>
                </button>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
                <?php } ?>
    </tbody>
</table>
                <?php } else { ?>
<div class="empty_section">
    <div class="empty_box"><?php $this->_('CWatch.tab_licenses.no_results'); ?></div>
</div>
    <?php } ?>

    <?php if (!empty($inactive_licenses)) { ?>
<h6 class="form-section-header mt-4"><?php $this->_('CWatch.tab_licenses.inactive_licenses'); ?></h6>
<table class="table table-bordered table-striped" id="licenses">
    <thead>
        <tr>
            <th><?php $this->_('CWatch.tab_licenses.licenseKey'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.type'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.domain'); ?></th>
            <th><?php $this->_('CWatch.tab_licenses.options'); ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($inactive_licenses as $key => $license) {
            $site = isset($license->site); ?>
        <tr>
            <td><?php echo isset($license->licenseKey) ? $this->Html->safe($license->licenseKey) : null; ?></td>
            <td><?php echo isset($license->productTitle) ? $this->Html->safe($license->productTitle) : null; ?></td>
            <td><?php echo isset($license->site->domain) ? $this->Html->safe($license->site->domain) : null; ?></td>
            <td>
                <?php if ($site) {

                    $this->Form->create(
                        $this->base_uri .
                            'clients/serviceTab/' .
                            (isset($service->client_id) ? $service->client_id : null) .
                            '/' .
                            (isset($service->id) ? $service->id : null) .
                            '/tabLicenses/',
                        ['class' => 'd-inline'],
                    );
                    $this->Form->fieldHidden('domain', isset($license->site->domain) ? $license->site->domain : null);
                    $this->Form->fieldHidden('action', 'remove_domain');
                    ?>
                <a href="<?php echo $this->Html->safe(
                    $this->base_uri .
                        'clients/serviceTab/' .
                        (isset($service->client_id) ? $service->client_id : null) .
                        '/' .
                        (isset($service->id) ? $service->id : null) .
                        '/tabLicenses/?action=upgrade_site&key=' .
                        (isset($license->licenseKey) ? $license->licenseKey : null),
                ); ?>" class="btn btn-sm btn-outline-success" title="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.upgrade_site', true)); ?>">
                    <i class="bi bi-arrow-up-circle"></i>
                </a>
                <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                    data-confirm-message="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.confirm_delete', true)); ?>"
                    title="<?php echo $this->Html->safe($this->_('CWatch.tab_licenses.remove_site', true)); ?>">
                    <i class="bi bi-trash"></i>
                </button>
                <?php $this->Form->end();
                } ?>
            </td>
        </tr>
                <?php
        } ?>
    </tbody>
</table>
                <?php } ?>

