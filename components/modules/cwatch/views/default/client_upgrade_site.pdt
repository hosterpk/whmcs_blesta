<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('CWatch.tab_licenses.upgrade_site'); ?></h6>
<?php
$this->Form->create(
    $this->base_uri . 'services/manage/' . ($service->id ?? null) . '/tabClientLicenses/',
);
$this->Form->fieldHidden('action', 'upgrade_site');
?>
<div class="w-100">
    <div>
        <?php $this->Form->label($this->_('CWatch.tab_licenses.current_license', true)); ?>
        <p><?php $this->_(
            'CWatch.tab_licenses.license_name',
            false,
            $selected_license->licenseKey ?? null,
            $selected_license->productTitle ?? null,
        ); ?></p>
    </div>
    <div>
        <?php $this->Form->label($this->_('CWatch.tab_licenses.domain', true), 'domain'); ?>
        <p><?php echo isset($selected_license->site->domain)
            ? $this->Html->safe($selected_license->site->domain)
            : null; ?></p>
        <?php $this->Form->fieldHidden(
            'domain',
            $selected_license->site->domain ?? null,
            ['id' => 'domain'],
        ); ?>
    </div>
    <?php if (!empty($available_licenses)) { ?>
    <div class="form-group">
        <?php
        $this->Form->label($this->_('CWatch.tab_licenses.licenseKey', true), 'licenseKey');
        $this->Form->fieldSelect(
            'licenseKey',
            $available_licenses ?? null,
            $selected_license->licenseKey ?? null,
            ['class' => 'form-control', 'id' => 'licenseKey'],
        );
        ?>
    </div>
    <button class="btn btn-light float-right">
        <i class="fas fa-edit"></i> <?php $this->_('CWatch.tab_licenses.upgrade_site'); ?>
    </button>
    <?php } else { ?>
    <div class="alert alert-info">
        <p><?php $this->_('CWatch.tab_licenses.no_upgrade_options'); ?></p>
    </div>
    <?php } ?>
</div>
<?php $this->Form->end();
