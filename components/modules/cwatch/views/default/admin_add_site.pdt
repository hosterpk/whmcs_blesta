<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('CWatch.tab_licenses.add'); ?></h6>
<?php $this->Form->create(
    $this->base_uri .
        'clients/serviceTab/' .
        ($service->client_id ?? null) .
        '/' .
        ($service->id ?? null) .
        '/tablicenses/',
); ?>
<div>
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('CWatch.tab_licenses.licenseKey', true), 'licenseKey', ['class' => 'form-label']);
        $this->Form->fieldSelect(
            'licenseKey',
            $available_licenses ?? null,
            $selected_license->licenseKey ?? null,
            ['id' => 'licenseKey', 'class' => 'form-select'],
        );
        ?>
    </div>
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('CWatch.tab_licenses.domain', true), 'domain', ['class' => 'form-label']);
        $this->Form->fieldText('domain', '', ['id' => 'domain', 'class' => 'form-control']);
        ?>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <?php
            $this->Form->fieldCheckbox('initiateDns', null, '1', [
                'id' => 'initiateDns',
                'class' => 'form-check-input',
            ]);
            $this->Form->label($this->_('CWatch.tab_licenses.initiateDns', true), 'initiateDns', [
                'class' => 'form-check-label',
            ]);
            ?>
            <span class="tooltip"><?php $this->_('AppController.tooltip.text'); ?><div><?php $this->_(
                'CWatch.!tooltip.initiateDns',
); ?></div></span>
        </div>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <?php
            $this->Form->fieldCheckbox('autoSsl', null, '1', ['id' => 'autoSsl', 'class' => 'form-check-input']);
            $this->Form->label($this->_('CWatch.tab_licenses.autoSsl', true), 'autoSsl', [
                'class' => 'form-check-label',
            ]);
            ?>
            <span class="tooltip"><?php $this->_('AppController.tooltip.text'); ?><div><?php $this->_(
                'CWatch.!tooltip.autoSsl',
); ?></div></span>
        </div>
    </div>
</div>
<button class="btn btn-outline-secondary float-end">
    <i class="bi bi-pencil"></i> <?php $this->_('CWatch.tab_licenses.submit'); ?>
</button>
<?php $this->Form->end();
