<?php /** @var View $this **/ ?>

<?php
$link_buttons = [
    [
        'name' => $this->_('CWatch.manage.add_module_row', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . $module->id],
    ],
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_('CWatch.manage.boxtitle', true, isset($module->name) ? $this->Html->safe($module->name) : null),
    ['id' => 'manage_none'],
);
?>
<?php
$num_rows = count($module->rows ?? []);
if ($num_rows > 0) {
?>
    <table class='table'>
        <thead>
            <tr>
                <th><span><?php $this->_('CWatch.manage.heading_username'); ?></span></th>
                <th><span><?php $this->_('CWatch.manage.heading_options'); ?></span></th>
            </tr>
        </thead>
        <tbody>

            <?php for ($i = 0; $i < $num_rows; $i++) { ?>
            <tr>
                <td>
                    <?php echo isset($module->rows[$i]->meta->username) ? $this->Html->safe($module->rows[$i]->meta->username) : null; ?>
                </td>
                <td>
                    <a href="<?php echo $this->Html->safe(
                        $this->base_uri .
                            'settings/company/modules/editrow/' .
                            ($module->id ?? null) .
                            '/' .
                            ($module->rows[$i]->id ?? null) .
                            '/',
                    ); ?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('CWatch.manage.option_edit'); ?>">
                        <i class="bi bi-pencil"></i>
                    </a>

                    <?php
                    $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                    $this->Form->fieldHidden('id', $module->id ?? null);
                    $this->Form->fieldHidden('row_id', $module->rows[$i]->id ?? null);
                    ?>
                    <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                        data-confirm-message="<?php echo $this->Html->safe($this->_('CWatch.manage.confirm_delete', true) . (isset($module->rows[$i]->meta->username) ? $this->Html->safe($module->rows[$i]->meta->username) : null)); ?>"
                        title="<?php $this->_('CWatch.manage.delete'); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                    <?php
                    $this->Form->end();
                    ?>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
<?php
} else {
?>
    <div class='card-body text-center text-muted py-5'>
        <i class='bi bi-server' style='font-size: 3rem; opacity: 0.3;'></i>
        <p class='mt-3 mb-0'><?php $this->_('CWatch.manage.no_results'); ?></p>
    </div>
<?php
}

$this->Widget->end();
?>
