<?php /** @var View $this **/ ?>

<table class="table">
    <thead>
        <tr>
            <th><i class="bi bi-arrow-up"></i></th>
            <th><?php $this->_('Ispmanager.service_info.username'); ?></th>
            <th><?php $this->_('Ispmanager.service_info.password'); ?></th>
            <th><?php $this->_('Ispmanager.service_info.server'); ?></th>
            <th><?php $this->_('Ispmanager.service_info.options'); ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td></td>
            <td><?php echo isset($service_fields->ispmanager_username)
                ? $this->Html->safe($service_fields->ispmanager_username)
                : null; ?></td>
            <td><?php echo isset($service_fields->ispmanager_password)
                ? $this->Html->safe($service_fields->ispmanager_password)
                : null; ?></td>
            <td><?php echo isset($module_row->meta->host_name)
                ? $this->Html->safe($module_row->meta->host_name)
                : null; ?></td>
            <td>
                <?php
                $this->Form->create(
                    $this->Html->safe(
                        'http' .
                            ($module_row->meta->use_ssl == 'true' ? 's' : '') .
                            '://' .
                            ($module_row->meta->host_name ?? null) .
                            ':1500/ispmgr?func=logon',
                    ),
                    ['target' => '_blank'],
                );
                $this->Form->fieldHidden(
                    'username',
                    $service_fields->ispmanager_username ?? null,
                );
                $this->Form->fieldHidden(
                    'password',
                    $service_fields->ispmanager_password ?? null,
                );
                $this->Form->fieldHidden('lang', 'en');
                $this->Form->fieldHidden('forget', 'on');
                $this->Form->fieldHidden('func', 'auth');
                ?>
                <a id="ispmanager_login<?php echo isset($service->id)
                    ? $this->Html->safe($service->id)
                    : null; ?>" href="#"><?php $this->_('Ispmanager.service_info.option_login'); ?></a>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
    </tbody>
</table>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('ispmanager_login<?php echo isset($service->id)
            ? $this->Html->safe($service->id)
            : null; ?>').addEventListener('click', function(e) {
            e.preventDefault();

            this.closest('form').submit();
        });
    });
</script>
