<?php /** @var View $this **/ ?>

<?php
$this->Form->create();
?>
<div>
    <div class="mb-3">
        <?php $this->Form->label($this->_('Enom.tab_settings.field_registrar_lock', true), 'registrar_lock', [
            'class' => 'form-label',
        ]); ?>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio(
                'registrar_lock',
                'true',
                (isset($vars->registrar_lock) ? $vars->registrar_lock : null) == 'true',
                ['id' => 'registrar_lock_yes', 'class' => 'form-check-input'],
            );
            $this->Form->label($this->_('Enom.tab_settings.field_registrar_lock_yes', true), 'registrar_lock_yes', [
                'class' => 'form-check-label',
            ]);
            ?>
        </div>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio(
                'registrar_lock',
                'false',
                (isset($vars->registrar_lock) ? $vars->registrar_lock : null) == 'false',
                ['id' => 'registrar_lock_no', 'class' => 'form-check-input'],
            );
            $this->Form->label($this->_('Enom.tab_settings.field_registrar_lock_no', true), 'registrar_lock_no', [
                'class' => 'form-check-label',
            ]);
            ?>
        </div>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <?php
            $this->Form->fieldCheckbox(
                'request_epp',
                'true',
                (isset($vars->request_epp) ? $vars->request_epp : null) == 'true',
                ['id' => 'request_epp', 'class' => 'form-check-input'],
            );
            $this->Form->label($this->_('Enom.tab_settings.field_request_epp', true), 'request_epp', [
                'class' => 'form-check-label',
            ]);
            ?>
        </div>
    </div>
</div>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Enom.tab_settings.field_submit', true), [
        'class' => 'btn btn-primary'
    ]); ?>
</div>
<?php
$this->Form->end();
?>
