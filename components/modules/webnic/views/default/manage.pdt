<?php
$link_buttons = [
    [
        'name' => $this->_('Webnic.add_module_row', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . (isset($module->id) ? $module->id : null)],
    ],
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_(
        'AdminCompanyModules.manage.boxtitle_manage',
        true,
        isset($module->name) ? $this->Html->safe($module->name) : null,
    ),
    ['id' => 'manage_webnic'],
);
?>

<?php
$num_rows = count(isset($module->rows) ? $module->rows : []);
if ($num_rows > 0) { ?>
<table class="table">
    <thead>
        <tr>
            <th><span><?php $this->_('Webnic.manage.module_rows_heading.username'); ?></span></th>
            <th><span><?php $this->_('Webnic.manage.module_rows_heading.environment'); ?></span></th>
            <th><span><?php $this->_('Webnic.manage.module_rows_heading.options'); ?></span></th>
        </tr>
    </thead>
    <tbody>
        <?php for ($i = 0; $i < $num_rows; $i++) { ?>
        <?php $is_ote = ($module->rows[$i]->meta->environment ?? 'production') === 'ote'; ?>
        <tr>
            <td><?php echo isset($module->rows[$i]->meta->username)
                ? $this->Html->safe($module->rows[$i]->meta->username)
                : null; ?></td>
            <td>
                <span class="badge rounded-pill <?php echo $is_ote ? 'bg-warning' : 'bg-secondary'; ?>">
                    <?php $this->_($is_ote ? 'Webnic.env_badge.ote' : 'Webnic.env_badge.production'); ?>
                </span>
            </td>
            <td>
                <a href="<?php echo $this->Html->safe(
                    $this->base_uri .
                        'settings/company/modules/editrow/' .
                        (isset($module->id) ? $module->id : null) .
                        '/' .
                        (isset($module->rows[$i]->id) ? $module->rows[$i]->id : null) .
                        '/',
                ); ?>" class="btn btn-sm btn-outline-secondary"
                    aria-label="<?php $this->_('Webnic.manage.module_rows.edit'); ?>"
                    title="<?php $this->_(
    'Webnic.manage.module_rows.edit',
); ?>">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </a>
                <?php
                $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', [
                    'class' => 'd-inline',
                ]);
                $this->Form->fieldHidden('id', isset($module->id) ? $module->id : null);
                $this->Form->fieldHidden('row_id', isset($module->rows[$i]->id) ? $module->rows[$i]->id : null);
                ?>
                <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                    data-confirm-message="<?php echo $this->Html->safe(
                        $this->_('Webnic.manage.module_rows.confirm_delete', true),
                    ); ?>"
                    aria-label="<?php $this->_('Webnic.manage.module_rows.delete'); ?>"
                    title="<?php $this->_('Webnic.manage.module_rows.delete'); ?>">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
                <?php $this->Form->end(); ?>
            </td>
        </tr>
        <?php } ?>
    </tbody>
</table>
<?php } else { ?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('Webnic.manage.no_results'); ?></p>
</div>
<?php } ?>

<?php $this->Widget->end(); ?>
