<?php
/**
 * Client service-info lifecycle chrome (Story 3.4a, AC2/AC4).
 *
 * Renders webnic_orders.state server-side (no SPA/sockets; refresh-on-load): the amber
 * status badge + pending banner while in flight, or the dead-end failed callout. The
 * registrar emits native Blesta classes (Dev Notes §J), not the UI/UX shim. The
 * Domain Manager owns the rich active-domain view, so this is lifecycle chrome only.
 *
 * @var string $alias One of WebnicStatus::PENDING|FAILED|SUSPENDED|CANCELLED
 * @var string $banner_key Age-softened pending-banner copy key
 * @var string $suspended_reason_key Suspended reason copy key
 * @var stdClass|null $order Masked tracking record (failed admin variant)
 * @var bool $is_admin Always false here (client variant)
 * @var string $recovery_url Always '' here (no client recovery action)
 * @var array|null $summary Active-domain summary cells (WN-5-1), or null
 * @var bool $summary_unavailable True when the active summary's live read failed (WN-5-1)
 * @var bool $show_suspended_reason True only for locally suspended services
 */
$webnic_dir = __DIR__ . DIRECTORY_SEPARATOR;
?>
<div class="webnic-service-info my-2">
    <?php if (isset($alias) && $alias !== null) { ?>
    <div class="mb-2"><?php include $webnic_dir . 'status_badge.pdt'; ?></div>
    <?php } ?>
    <?php
    if (!empty($summary) || !empty($summary_unavailable)) {
        include $webnic_dir . 'service_summary.pdt';
    } elseif ($alias === 'pending' && !empty($order)) {
        include $webnic_dir . 'pending_banner.pdt';
    } elseif ($alias === 'failed') {
        include $webnic_dir . 'failed_callout.pdt';
    } elseif ($alias === 'suspended' && !empty($show_suspended_reason)) {
        include $webnic_dir . 'suspended_reason.pdt';
    }
    if (!empty($restore_prompt)) {
        include $webnic_dir . 'restore_prompt.pdt';
    }
    ?>
</div>
