<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Interworx.tab_stats.info_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Interworx.tab_stats.info_heading.field'); ?></th>
                <th><?php $this->_('Interworx.tab_stats.info_heading.value'); ?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $i = 0;
            foreach ($account_info as $key => $info) {
                $i++; ?>
            <tr>
                <td><?php $this->_('Interworx.tab_stats.info.' . $key); ?></td>
                <td><?php echo $info; ?></td>
            </tr>
                    <?php
            }
            ?>
        </tbody>
    </table>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Interworx.tab_stats.bandwidth_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Interworx.tab_stats.bandwidth_heading.used'); ?></th>
                <th><?php $this->_('Interworx.tab_stats.bandwidth_heading.limit'); ?></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php $this->_(
                    'Interworx.tab_stats.bandwidth_value',
                    false,
                    isset($bandwidth_usage['used']) ? $bandwidth_usage['used'] : null,
                ); ?></td>
                <td><?php $this->_(
                    (isset($bandwidth_usage['limit']) ? $bandwidth_usage['limit'] : null) === 'bandwidth_unlimited'
                        ? 'Interworx.tab_stats.bandwidth_unlimited'
                        : 'Interworx.tab_stats.bandwidth_value',
                    false,
                    isset($bandwidth_usage['limit']) ? $bandwidth_usage['limit'] : null,
                ); ?></td>
            </tr>
        </tbody>
    </table>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Interworx.tab_stats.disk_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Interworx.tab_stats.disk_heading.used'); ?></th>
                <th><?php $this->_('Interworx.tab_stats.disk_heading.limit'); ?></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php $this->_(
                    'Interworx.tab_stats.disk_value',
                    false,
                    isset($disk_usage['used']) ? $disk_usage['used'] : null,
                ); ?></td>
                <td><?php $this->_(
                    (isset($disk_usage['limit']) ? $disk_usage['limit'] : null) === 'disk_unlimited'
                        ? 'Interworx.tab_stats.disk_unlimited'
                        : 'Interworx.tab_stats.disk_value',
                    false,
                    isset($disk_usage['limit']) ? $disk_usage['limit'] : null,
                ); ?></td>
            </tr>
        </tbody>
    </table>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Interworx.tab_stats.package_title'); ?></h6>
<div class="mb-3">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 50%;"><?php $this->_('Interworx.tab_stats.info_heading.field'); ?></th>
                <th><?php $this->_('Interworx.tab_stats.info_heading.value'); ?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $i = 0;
            foreach ($package_info as $key => $info) {
                $i++; ?>
            <tr>
                <td><?php $this->_(
                    'Interworx.tab_stats.package_info.' . strtolower(str_replace('RSL_', '', $key)),
                ); ?></td>
                <td><?php echo $info === 'opt_unlimited'
                    ? $this->_('Interworx.tab_stats.package_info.opt_unlimited', true)
                    : $info; ?></td>
            </tr>
                    <?php
            }
            ?>
        </tbody>
    </table>
</div>