
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Blockonomics.api_key', true), 'api_key', ['class' => 'form-label']);
    $this->Form->fieldText('api_key', ($meta['api_key'] ?? null), ['id' => 'api_key', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <label class="form-label">
        <?php $this->_('Blockonomics.parent_uid'); ?>
        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
           title="<?php echo $this->Html->safe($this->_('Blockonomics.parent_uid_note', true)); ?>"></i>
    </label>

    <table class="table table-hover mb-0" id="parent_uid_table">
        <thead>
            <tr>
                <th>Currency</th>
                <th><?php $this->_('Blockonomics.parent_uid');?></th>
            </tr>
        </thead>
        <tbody>
            <tr style="display: none">
                <td></td>
                <td>
                    <?php
                    $this->Form->fieldText('parent_uid', null, ['id' => 'parent_uid', 'class' => 'form-control']);
                    ?>
                </td>
            </tr>
            <?php
                $currencies = $meta['currencies'] ?? [];
                foreach ($currencies as $currency) {
            ?>
                <tr class="cloned">
                    <td>
                        <strong><?php echo $this->Html->safe($currency ?? ''); ?></strong>
                    </td>
                    <td>
                        <?php
                        $this->Form->fieldText('parent_uid_' . $currency, ($meta['parent_uid_' . $currency] ?? null), ['id' => 'parent_uid_' . $currency, 'class' => 'form-control']);
                        ?>
                    </td>
                </tr>
            <?php
                }
                if (empty($currencies)) {
            ?>
                <tr id="parent_uid_placeholder">
                    <td colspan="2" class="text-muted">
                        <?php $this->_('Blockonomics.parent_uid_placeholder'); ?>
                    </td>
                </tr>
            <?php
                }
            ?>
        </tbody>
    </table>
</div>

<div class="title_row first">
    <h3><?php $this->_('Blockonomics.redirect'); ?></h3>
</div>
<div class="pad">
    <p><?php $this->_('Blockonomics.redirect_note'); ?></p>
    <code><?php echo 'http' . (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] != 'off' ? 's' : '') . '://' . (isset($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost') . WEBDIR . Configure::get('Route.client') . '/pay/received/blockonomics/'; ?></code>
</div>

<div class="title_row">
    <h3><?php $this->_('Blockonomics.callback'); ?></h3>
</div>
<div class="pad">
    <p><?php $this->_('Blockonomics.callback_note'); ?></p>
    <code><?php echo Configure::get('Blesta.gw_callback_url') . Configure::get('Blesta.company_id') . '/blockonomics/'; ?></code>
</div>

<script type="application/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('input[name="currencies[]"]').forEach(function(el) {
            el.addEventListener('change', function() {
                updateCurrenciesTable();
            });
        });
    });

    function updateCurrenciesTable() {
        var meta = <?php echo json_encode($meta); ?>;

        document.querySelectorAll('#parent_uid_table tr.cloned').forEach(function(el) { el.remove(); });

        var placeholder = document.getElementById('parent_uid_placeholder');

        var checked = document.querySelectorAll('input[name="currencies[]"]:checked');
        if (placeholder) {
            placeholder.style.display = checked.length > 0 ? 'none' : '';
        }

        checked.forEach(function(checkbox) {
            var currency = checkbox.value;
            var template_row = document.querySelector('#parent_uid_table tbody tr:first-child');
            var currency_row = template_row.cloneNode(true);

            currency_row.classList.add('cloned');
            currency_row.style.display = '';
            currency_row.querySelector('td:first-child').innerHTML = '<strong>' + currency + '</strong>';

            var input = currency_row.querySelector('input[type="text"]');
            input.name = 'parent_uid_' + currency;
            input.value = meta['parent_uid_' + currency] || '';

            document.querySelector('#parent_uid_table tbody').appendChild(currency_row);
        });
    }
</script>
