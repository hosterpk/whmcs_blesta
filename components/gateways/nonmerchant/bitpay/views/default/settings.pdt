<?php
if (!empty($pairing_code)) {
?>
<div class="alert alert-warning mb-3 d-flex justify-content-between align-items-start gap-3" id="bitpay_notice" role="alert">
    <div>
        <i class="bi bi-exclamation-triangle me-2"></i><strong><?php $this->_('Bitpay.pairing_code');?></strong>
        <p class="mb-0"><?php $this->_('Bitpay.pairing_code_note', false, (isset($pairing_code) ? $pairing_code : null));?></p>
    </div>
    <div class="flex-shrink-0">
        <?php
        if ((isset($meta['test_mode']) ? $meta['test_mode'] : 'false') == 'false') {
        ?>
        <a target="_blank" href="https://bitpay.com/api-access-request?pairingCode=<?php echo $this->Html->safe($pairing_code);?>" class="btn btn-warning">
            <?php $this->_('Bitpay.connect.button');?>
        </a>
        <?php
        } else {
        ?>
        <a target="_blank" href="https://test.bitpay.com/dashboard/merchant/api-tokens" class="btn btn-warning">
            <?php $this->_('Bitpay.connect.button');?>
        </a>
        <?php
        }
        ?>
    </div>
</div>
<?php
}
?>

<div class="mb-3">
    <label for="transaction_speed" class="form-label">
        <?php $this->_('Bitpay.transaction_speed'); ?>
        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
           title="<?php echo $this->Html->safe($this->_('Bitpay.transaction_speed_note', true)); ?>"></i>
    </label>
    <?php
    $this->Form->fieldSelect('transaction_speed', (isset($select_options) ? $select_options : []), (isset($meta['transaction_speed']) ? $meta['transaction_speed'] : null), ['id' => 'transaction_speed', 'class' => 'form-select']);
    $this->Form->fieldHidden('private_key', (isset($meta['private_key']) ? $meta['private_key'] : null));
    $this->Form->fieldHidden('key_id', (isset($meta['key_id']) ? $meta['key_id'] : null));
    $this->Form->fieldHidden('token', (isset($meta['token']) ? $meta['token'] : null));
    $this->Form->fieldHidden('client_id', (isset($meta['client_id']) ? $meta['client_id'] : null));
    ?>
</div>
<div class="mb-3">
    <?php
    if (!empty($pairing_code)) {
    ?>
        <div class="form-check">
            <?php
            $this->Form->fieldCheckbox('test_mode', 'true', ((isset($meta['test_mode']) ? $meta['test_mode'] : 'false') == 'true'), ['id' => 'test_mode', 'class' => 'form-check-input']);
            ?>
            <label for="test_mode" class="form-check-label">
                <?php $this->_('Bitpay.test_mode'); ?>
                <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                   title="<?php echo $this->Html->safe($this->_('Bitpay.test_mode_note', true)); ?>"></i>
            </label>
        </div>
    <?php
    } else {
        $this->Form->fieldHidden('test_mode', (isset($meta['test_mode']) ? $meta['test_mode'] : null));
    }
    ?>
</div>

<?php
if (empty($pairing_code)) {
?>
<div class="button_row">
    <?php
    $this->Form->fieldSubmit('disconnect', $this->_('Bitpay.disconnect.button', true), ['class' => 'btn btn-outline-secondary float-end']);
    ?>
</div>
<?php
}
?>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var test_mode = document.getElementById('test_mode');
        if (test_mode) {
            test_mode.addEventListener('change', function() {
                var form = this.closest('form');
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'refresh_fields';
                input.value = 'true';
                form.appendChild(input);

                blestaRequest('POST', form.getAttribute('action'), new FormData(form),
                    function(data) { location.reload(); },
                    function(data) { location.reload(); },
                    {dataType: 'json'}
                );
            });
        }
    });
</script>
