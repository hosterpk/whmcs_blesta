</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Authorize_net.api', true), 'api_to_use', ['class' => 'form-label']);
    $this->Form->fieldSelect('api', $apis, (isset($meta['api']) ? $meta['api'] : null), ['id' => 'api_to_use', 'class' => 'form-select']);
    ?>
</div>
<div class="mb-3 cim_options">
    <label for="validation_mode" class="form-label">
        <?php $this->_('Authorize_net.validation_mode'); ?>
        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
           title="<?php echo $this->Html->safe($this->_('Authorize_net.validation_note', true)); ?>"></i>
    </label>
    <?php
    $this->Form->fieldSelect('validation_mode', $validation_modes, (isset($meta['validation_mode']) ? $meta['validation_mode'] : null), ['id' => 'validation_mode', 'class' => 'form-select']);
    ?>
</div>
<div class="mb-3">
    <div class="form-check">
        <?php
        $this->Form->fieldCheckbox('test_mode', 'true', ((isset($meta['test_mode']) ? $meta['test_mode'] : 'false') == 'true'), ['id' => 'test_mode', 'class' => 'form-check-input']);
        ?>
        <label for="test_mode" class="form-check-label">
            <?php $this->_('Authorize_net.test_mode'); ?>
            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
               title="<?php echo $this->Html->safe($this->_('Authorize_net.test_mode_note', true)); ?>"></i>
        </label>
    </div>
</div>
<div class="mb-3">
    <div class="form-check">
        <?php
        $this->Form->fieldCheckbox('dev_mode', 'true', ((isset($meta['dev_mode']) ? $meta['dev_mode'] : 'false') == 'true'), ['id' => 'dev_mode', 'class' => 'form-check-input']);
        ?>
        <label for="dev_mode" class="form-check-label">
            <?php $this->_('Authorize_net.dev_mode'); ?>
            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
               title="<?php echo $this->Html->safe($this->_('Authorize_net.dev_mode_note', true)); ?>"></i>
        </label>
    </div>
</div>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var cim_options = document.querySelectorAll('.cim_options');

        cim_options.forEach(function(el) { el.style.display = 'none'; });

        var api_select = document.getElementById('api_to_use');

        if (api_select.value == 'cim') {
            cim_options.forEach(function(el) { el.style.display = ''; });
        }

        api_select.addEventListener('change', function() {
            if (this.value == 'cim') {
                cim_options.forEach(function(el) { el.style.display = ''; });
            } else {
                cim_options.forEach(function(el) { el.style.display = 'none'; });
            }
        });
    });
</script>
