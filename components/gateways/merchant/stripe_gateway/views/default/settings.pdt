
<div class="mb-3">
    <label class="form-label">
        <?php $this->_('Stripe_gateway.api_key'); ?>
        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
           title="<?php echo $this->Html->safe($this->_('Stripe_gateway.tooltip_api', true)); ?>"></i>
    </label>
    <?php
    $this->Form->fieldText('api_key', (isset($meta['api_key']) ? $meta['api_key'] : null), ['class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <div class="form-check">
        <?php
        $this->Form->fieldCheckbox('stored', 'true', ((isset($meta['stored']) ? $meta['stored'] : 'false') == 'true'), ['id' => 'stored', 'class' => 'form-check-input']);
        ?>
        <label for="stored" class="form-check-label">
            <?php $this->_('Stripe_gateway.stored'); ?>
            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
               title="<?php echo $this->Html->safe($this->_('Stripe_gateway.tooltip_stored', true)); ?>"></i>
        </label>
    </div>
</div>
