        <?php $this->_('Payflow.user'); ?>
        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
           title="<?php echo $this->Html->safe($this->_('Payflow.tooltip_user', true)); ?>"></i>
