<?php
$this->Form->create($this->Html->safe($this->base_uri . 'widget/system_overview/admin_main/update/')); ?>
<div class="card-body">
    <!-- Statistics Section -->
    <h6 class="form-section-header"><?php $this->_('AdminMain.settings.heading_statistics'); ?></h6>
    <p class="text-secondary mb-3"><?php $this->_('AdminMain.settings.text_options'); ?></p>

    <div class="mb-4">
        <?php
        $this->Form->fieldCheckbox('clients_active', '1', ($vars['clients_active'] ?? 0) == 1, [
            'id' => 'clients_active',
            'class' => 'form-check-input',
        ]);
        $this->Form->label($this->_('AdminMain.settings.clients_active', true), 'clients_active', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <div class="mb-4">
        <?php
        $this->Form->fieldCheckbox('active_users_today', '1', ($vars['active_users_today'] ?? 0) == 1, [
            'id' => 'active_users_today',
            'class' => 'form-check-input',
        ]);
        $this->Form->label($this->_('AdminMain.settings.active_users_today', true), 'active_users_today', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <div class="mb-4">
        <?php
        $this->Form->fieldCheckbox('services_active', '1', ($vars['services_active'] ?? 0) == 1, [
            'id' => 'services_active',
            'class' => 'form-check-input',
        ]);
        $this->Form->label($this->_('AdminMain.settings.services_active', true), 'services_active', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <div class="mb-4">
        <?php
        $this->Form->fieldCheckbox('recurring_invoices', '1', ($vars['recurring_invoices'] ?? 0) == 1, [
            'id' => 'recurring_invoices',
            'class' => 'form-check-input',
        ]);
        $this->Form->label($this->_('AdminMain.settings.recurring_invoices', true), 'recurring_invoices', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <div class="mb-4">
        <?php
        $attr = ['id' => 'pending_orders', 'class' => 'form-check-input'];
        if (!($plugins['order'] ?? null)) {
            $attr['disabled'] = 'disabled';
        }
        $this->Form->fieldCheckbox(
            'pending_orders',
            '1',
            ($plugins['order'] ?? null) && ($vars['pending_orders'] ?? 0) == 1,
            $attr,
        );
        $this->Form->label($this->_('AdminMain.settings.pending_orders', true), 'pending_orders', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <div class="mb-4">
        <?php
        $attr = ['id' => 'open_tickets', 'class' => 'form-check-input'];
        if (!($plugins['support_manager'] ?? null)) {
            $attr['disabled'] = 'disabled';
        }
        $this->Form->fieldCheckbox(
            'open_tickets',
            '1',
            ($plugins['support_manager'] ?? null) && ($vars['open_tickets'] ?? 0) == 1,
            $attr,
        );
        $this->Form->label($this->_('AdminMain.settings.open_tickets', true), 'open_tickets', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <!-- Clients Graph Section -->
    <h6 class="form-section-header"><?php $this->_('AdminMain.settings.heading_clients'); ?></h6>
    <p class="text-secondary mb-3"><?php $this->_('AdminMain.settings.text_graphs_clients'); ?></p>

    <div class="mb-4">
        <?php
        $this->Form->fieldCheckbox('graph_clients', '1', ($vars['graph_clients'] ?? 0) == 1, [
            'id' => 'graph_clients',
            'class' => 'form-check-input',
        ]);
        $this->Form->label($this->_('AdminMain.settings.graph_clients', true), 'graph_clients', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <!-- Services Graph Section -->
    <h6 class="form-section-header"><?php $this->_('AdminMain.settings.heading_services'); ?></h6>
    <p class="text-secondary mb-3"><?php $this->_('AdminMain.settings.text_graphs_services'); ?></p>

    <div class="mb-4">
        <?php
        $this->Form->fieldCheckbox('graph_services', '1', ($vars['graph_services'] ?? 0) == 1, [
            'id' => 'graph_services',
            'class' => 'form-check-input',
        ]);
        $this->Form->label($this->_('AdminMain.settings.graph_services', true), 'graph_services', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <!-- Settings Section -->
    <h6 class="form-section-header"><?php $this->_('AdminMain.settings.heading_settings'); ?></h6>
    <p class="text-secondary mb-3"><?php $this->_('AdminMain.settings.text_graph_settings'); ?></p>

    <div class="mb-4">
        <?php $this->Form->fieldCheckbox('show_one_tab', '1', ($vars['show_one_tab'] ?? 0) == 1, [
            'id' => 'show_one_tab',
            'class' => 'form-check-input',
        ]); ?>
        <label for="show_one_tab" class="form-check-label ms-2">
            <?php $this->_('AdminMain.settings.show_one_tab'); ?>
            <i class="bi bi-info-circle text-secondary ms-1" data-bs-toggle="tooltip" data-bs-title="<?php $this->_(
                'AdminMain.settings.tooltip_show_one_tab',
            ); ?>"></i>
        </label>
    </div>

    <div class="mb-4">
        <?php
        $this->Form->fieldCheckbox('show_legend', '1', ($vars['show_legend'] ?? 0) == 1, [
            'id' => 'show_legend',
            'class' => 'form-check-input',
        ]);
        $this->Form->label($this->_('AdminMain.settings.show_legend', true), 'show_legend', [
            'class' => 'form-check-label ms-2',
        ]);
        ?>
    </div>

    <div class="mb-4">
        <?php
        $this->Form->label($this->_('AdminMain.settings.date_range', true), 'date_range', ['class' => 'form-label']);
        $this->Form->fieldSelect('date_range', $date_ranges ?? null, $vars['date_range'] ?? null, [
            'id' => 'date_range',
            'class' => 'form-select',
        ]);
        ?>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 p-3 border-top">
    <a class="btn btn-outline-secondary ajax" href="<?php echo $this->Html->safe(
        $this->base_uri,
    ); ?>widget/system_overview/admin_main/"><?php $this->_('AdminMain.settings.submit_cancel'); ?></a>
    <?php $this->Form->fieldSubmit('save', $this->_('AdminMain.settings.submit_settings', true), [
        'class' => 'btn btn-primary',
    ]); ?>
</div>

<?php $this->Form->end(); ?>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Bootstrap tooltips
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
            new bootstrap.Tooltip(el);
        });
    });
</script>