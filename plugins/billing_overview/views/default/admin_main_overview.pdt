<!-- Charts Section -->
<?php
$graph_list = (isset($graphs['graphs']) ? $graphs['graphs'] : []);
if (!empty($graph_list)) {
    foreach ($graph_list as $graph_type => $graph) {
?>
<div class="graph-section">
    <h6 class="my-3"><?php echo (isset($graph['name']) ? $this->Html->safe($graph['name']) : null);?></h6>
    <div id="<?php echo (isset($graph_type) ? $this->Html->safe($graph_type) : null);?>"
         class="billing-overview-chart"
         data-chart-type="<?php echo (isset($graph_type) ? $this->Html->safe($graph_type) : null);?>"
         data-chart-data="<?php echo $this->Html->safe(json_encode((isset($graph['data']) ? $graph['data'] : [])));?>"
         data-currency-prefix="<?php echo (isset($currency->prefix) ? $this->Html->safe($currency->prefix) : null);?>"
         data-currency-precision="<?php echo (isset($currency->precision) ? $this->Html->safe($currency->precision) : 2);?>"
         data-show-legend="<?php echo (isset($graphs['settings']['show_legend']) ? $graphs['settings']['show_legend'] : 0);?>"></div>
</div>
<?php
    }
}
?>
<?php
$this->Form->end();
?>

<script type="text/javascript">
if (typeof window.BillingOverview === 'undefined') {
    window.BillingOverview = {
        charts: {},
        baseUri: '<?php echo $this->Html->safe($this->base_uri);?>',

        getCurrentTheme: function() {
            return document.documentElement.getAttribute('data-theme') || 'dark';
        },

        getBaseChartOptions: function() {
            var isDark = this.getCurrentTheme() === 'dark';

            return {
                chart: {
                    background: 'transparent',
                    foreColor: isDark ? '#a0a0a0' : '#666666',
                    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif',
                    toolbar: {
                        show: true,
                        tools: {
                            download: true,
                            selection: true,
                            zoom: true,
                            zoomin: true,
                            zoomout: true,
                            pan: true,
                            reset: true
                        }
                    }
                },
                theme: {
                    mode: isDark ? 'dark' : 'light'
                },
                grid: {
                    borderColor: isDark ? '#2a2a2a' : '#e0e0e0',
                    strokeDashArray: 3
                },
                tooltip: {
                    theme: isDark ? 'dark' : 'light'
                },
                legend: {
                    labels: {
                        colors: isDark ? '#a0a0a0' : '#666666'
                    }
                },
                xaxis: {
                    labels: {
                        style: {
                            colors: isDark ? '#a0a0a0' : '#666666'
                        }
                    },
                    axisBorder: {
                        color: isDark ? '#2a2a2a' : '#e0e0e0'
                    },
                    axisTicks: {
                        color: isDark ? '#2a2a2a' : '#e0e0e0'
                    }
                },
                yaxis: {
                    labels: {
                        style: {
                            colors: isDark ? '#a0a0a0' : '#666666'
                        }
                    }
                },
                dataLabels: {
                    enabled: false
                }
            };
        },

        createStackedAreaChart: function(container) {
            var chartDataStr = container.getAttribute('data-chart-data');
            var currencyPrefix = container.getAttribute('data-currency-prefix') || '';
            var currencyPrecision = parseInt(container.getAttribute('data-currency-precision') || '2', 10);
            var showLegend = container.getAttribute('data-show-legend') === '1';

            if (!chartDataStr) return null;

            var data;
            try {
                data = JSON.parse(chartDataStr);
            } catch (e) {
                return null;
            }

            var categories = [];
            var series = [];

            if (data.length > 0 && data[0].points) {
                var points = typeof data[0].points === 'string' ? JSON.parse(data[0].points) : data[0].points;
                points.forEach(function(point) {
                    var date = new Date(point[0]);
                    categories.push(date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
                });
            }

            var colors = ['#0d6efd', '#198754', '#0dcaf0', '#ffc107', '#dc3545', '#6f42c1'];

            data.forEach(function(seriesData) {
                if (seriesData.disabled) return;

                var points = typeof seriesData.points === 'string' ? JSON.parse(seriesData.points) : seriesData.points;
                var values = points.map(function(point) { return point[1]; });

                series.push({
                    name: seriesData.name,
                    data: values
                });
            });

            var options = this.getBaseChartOptions();
            options.chart.type = 'area';
            options.chart.stacked = true;
            options.chart.height = 280;
            options.series = series;
            options.xaxis.categories = categories;
            options.stroke = {
                curve: 'smooth', width: 2
            };
            options.fill = {
                type: 'gradient',
                gradient: {
                    opacityFrom: 0.6,
                    opacityTo: 0.1
                }
            };
            options.colors = colors;
            options.legend.show = showLegend;

            options.yaxis.labels.formatter = function(value) {
                if (value >= 1000000) {
                    return currencyPrefix + (value / 1000000).toFixed(1) + 'M';
                } else if (value >= 1000) {
                    return currencyPrefix + (value / 1000).toFixed(1) + 'K';
                }
                return currencyPrefix + value.toFixed(0);
            };

            options.tooltip.y = {
                formatter: function(value) {
                    return currencyPrefix + value.toFixed(currencyPrecision);
                }
            };

            return options;
        },

        destroyCharts: function() {
            var self = this;
            Object.keys(self.charts).forEach(function(chartId) {
                if (self.charts[chartId]) {
                    try {
                        self.charts[chartId].destroy();
                    } catch (e) {}
                }
            });
            self.charts = {};
        },

        initChartsFromDataAttributes: function() {
            var self = this;
            self.destroyCharts();

            document.querySelectorAll('.billing-overview-chart[data-chart-data]').forEach(function(container) {
                var chartType = container.getAttribute('data-chart-type');
                if (!chartType) return;

                try {
                    var options = self.createStackedAreaChart(container);
                    if (options) {
                        var chart = new ApexCharts(container, options);
                        chart.render();
                        self.charts[chartType] = chart;
                    }
                } catch (e) {
                    console.error('Failed to initialize chart:', e);
                }
            });
        },

        init: function() {
            var self = this;

            if (typeof ApexCharts !== 'undefined') {
                self.initChartsFromDataAttributes();
            }

            if (!self.themeObserver) {
                self.themeObserver = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.attributeName === 'data-theme') {
                            Object.keys(self.charts).forEach(function(chartId) {
                                if (self.charts[chartId]) {
                                    var baseOptions = self.getBaseChartOptions();
                                    self.charts[chartId].updateOptions({
                                        chart: baseOptions.chart,
                                        theme: baseOptions.theme,
                                        grid: baseOptions.grid,
                                        tooltip: baseOptions.tooltip,
                                        legend: baseOptions.legend,
                                        xaxis: baseOptions.xaxis,
                                        yaxis: baseOptions.yaxis
                                    });
                                }
                            });
                        }
                    });
                });

                self.themeObserver.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ['data-theme']
                });
            }

            if (!self.domObserver) {
                self.domObserver = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                            mutation.addedNodes.forEach(function(node) {
                                if (node.nodeType === 1) {
                                    var charts = node.querySelectorAll ? node.querySelectorAll('.billing-overview-chart[data-chart-data]') : [];
                                    if (charts.length > 0 || (node.classList && node.classList.contains('billing-overview-chart'))) {
                                        setTimeout(function() {
                                            self.initChartsFromDataAttributes();
                                        }, 100);
                                    }
                                }
                            });
                        }
                    });
                });

                self.domObserver.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            }
        }
    };
}

window.BillingOverview.init();
</script>