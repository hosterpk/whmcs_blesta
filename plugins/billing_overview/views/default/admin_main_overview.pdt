                    ?>
                    <i class="bi <?php echo (isset($statistics[$i]['icon']) ? $this->Html->safe($statistics[$i]['icon']) : null);?> me-2"></i>
                    <?php
                    }
                    ?>
                    <?php echo (isset($statistics[$i]['name']) ? $this->Html->safe($statistics[$i]['name']) : null);?>
                </span>
                <strong class="value <?php echo (isset($statistics[$i]['value_class']) ? $this->Html->safe($statistics[$i]['value_class']) : null);?>"><?php echo (isset($statistics[$i]['value']) ? $this->Html->safe($statistics[$i]['value']) : null);?></strong>
            </li>
            <?php
            }
            ?>
        </ul>
    </div>

    <!-- Right Column: Statistics -->
    <div class="col-md-6">
        <ul class="status-list">
            <?php
            for ($i = $statistics_mid_point; $i < $num_statistics; ++$i) {
                if (!isset($statistics[$i])) continue;
            ?>
            <li class="status-list-item">
                <span>
                    <?php
                    if (!empty($statistics[$i]['icon'])) {
                    ?>
                    <i class="bi <?php echo (isset($statistics[$i]['icon']) ? $this->Html->safe($statistics[$i]['icon']) : null);?> me-2"></i>
                    <?php
                    }
                    ?>
                    <?php echo (isset($statistics[$i]['name']) ? $this->Html->safe($statistics[$i]['name']) : null);?>
                </span>
                <strong class="value <?php echo (isset($statistics[$i]['value_class']) ? $this->Html->safe($statistics[$i]['value_class']) : null);?>"><?php echo (isset($statistics[$i]['value']) ? $this->Html->safe($statistics[$i]['value']) : null);?></strong>
            </li>
            <?php
            }
            ?>
        </ul>
    </div>
</div>

<!-- Currency and Date Selector -->
<div class="card-filter-bar mt-3">
    <div class="d-flex justify-content-end align-items-center gap-2">
        <?php $this->Form->fieldSelect('currency', (isset($currencies) ? $currencies : []), (isset($vars['currency']) ? $vars['currency'] : null), ['id' => 'currency', 'class' => 'form-select form-select-sm', 'style' => 'width: auto;']);?>
        <?php $this->Form->fieldSelect('graph_date', (isset($graph_dates) ? $graph_dates : []), (isset($vars['graph_date']) ? $vars['graph_date'] : null), ['id' => 'graph_date', 'class' => 'form-select form-select-sm', 'style' => 'width: auto;']);?>
