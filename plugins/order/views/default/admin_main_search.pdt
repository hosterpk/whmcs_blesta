                    <a href="<?php echo $this->Html->safe($this->base_uri . 'widget/order/admin_main/search/?search=' . ($search ?? null) . '&sort=total&order=' . ($sort == 'total' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminMain.index.heading_total');?>
                        <?php if ($sort == 'total') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
