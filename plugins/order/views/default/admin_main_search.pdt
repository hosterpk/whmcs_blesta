                    <a href="<?php echo $this->Html->safe($this->base_uri . 'widget/order/admin_main/search/?search=' . ($search ?? null) . '&sort=paid&order=' . ($sort == 'paid' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminMain.index.heading_paid');?>
