]]);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminForms.settings.boxtitle_order', true), ['id'=>'admin_forms'], (isset($render_section) ? $render_section : null));
?>
<?php
if ((isset($order_forms) ? $order_forms : null) && !empty($order_forms)) {
?>
<div class="table-responsive">
    <table class="table table-hover mb-0" id="order_forms_table">
        <thead>
            <tr>
                <th style="width: 40px;"></th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/index/?sort=name&order=' . ($sort == 'name' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminForms.index.heading_name');?>
                        <?php if ($sort == 'name') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/index/?sort=label&order=' . ($sort == 'label' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminForms.index.heading_label');?>
                        <?php if ($sort == 'label') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/index/?sort=template&order=' . ($sort == 'template' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminForms.index.heading_template');?>
                        <?php if ($sort == 'template') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/index/?sort=type&order=' . ($sort == 'type' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminForms.index.heading_type');?>
                        <?php if ($sort == 'type') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/index/?sort=date_added&order=' . ($sort == 'date_added' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminForms.index.heading_date_added');?>
                        <?php if ($sort == 'date_added') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/index/?sort=status&order=' . ($sort == 'status' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminForms.index.heading_status');?>
                        <?php if ($sort == 'status') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th><?php $this->_('AdminForms.index.heading_actions');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            foreach ($order_forms as $order_form) {
            ?>
            <tr id="order_forms_<?php echo (isset($order_form->id) ? $this->Html->safe($order_form->id) : null);?>">
                <td class="text-center"><i class="bi bi-grip-vertical movable" style="cursor: grab; display: none;"></i></td>
                <td><?php echo (isset($order_form->name) ? $this->Html->safe($order_form->name) : null);?></td>
                <td><a href="<?php echo $this->Html->safe((isset($base_order_url) ? $base_order_url : null) . (isset($order_form->label) ? $order_form->label : null));?>"><?php echo (isset($order_form->label) ? $this->Html->safe($order_form->label) : null);?></a></td>
                <td><?php echo (isset($templates[$order_form->template]->styles->{$order_form->template_style}->name) ? $this->Html->safe($templates[$order_form->template]->styles->{$order_form->template_style}->name) : null);?></td>
                <td><?php echo $this->Html->safe((isset($types[$order_form->type]) ? $types[$order_form->type] : null));?></td>
                <td><?php echo $this->Date->cast((isset($order_form->date_added) ? $order_form->date_added : null), 'date_time');?></td>
                <td><?php $this->_('AdminForms.index.field_status_' . (isset($order_form->status) ? $order_form->status : null));?></td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="<?php echo $this->base_uri . 'plugin/order/admin_forms/edit/' . (isset($order_form->id) ? $this->Html->safe($order_form->id) : null) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminForms.index.option_edit');?>">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <?php
                        $this->Form->create($this->base_uri . 'plugin/order/admin_forms/delete/', ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', (isset($order_form->id) ? $order_form->id : null));
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminForms.index.text_confirm_delete', true));?>" title="<?php $this->_('AdminForms.index.option_delete');?>">
                            <i class="bi bi-trash"></i>
                        </button>
                        <?php
                        $this->Form->end();
                        ?>
                    </div>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php
    if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        $this->Widget->footer();
        $this->Pagination->build();
    }
} else {
?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-file-earmark-text fs-1 mb-3 d-block"></i>
    <?php $this->_('AdminForms.index.order_forms_no_results');?>
</div>
<?php
}
$this->Widget->end();
?>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {

    // Initialize sortable
    var tbody = document.querySelector('#order_forms_table tbody');
    if (tbody && typeof Sortable !== 'undefined') {
        new Sortable(tbody, {
            animation: 150,
            handle: '.movable',
            ghostClass: 'table-active',
            onEnd: function() {
                var formData = new FormData();
                formData.append('_csrf_token', '<?php echo $this->Form->getCsrfToken();?>');

                var rows = tbody.querySelectorAll('tr[id^="order_forms_"]');
                rows.forEach(function(row) {
                    var id = row.id.replace('order_forms_', '');
                    formData.append('order_forms[]', id);
                });

                fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/sortorderforms/');?>', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
            }
        });
    }

    // Show/hide movable icons on hover
    var rows = document.querySelectorAll('#order_forms_table tbody tr');
    rows.forEach(function(row) {
        var movable = row.querySelector('.movable');
        if (movable) {
            row.addEventListener('mouseenter', function() {
                movable.style.display = 'inline-block';
            });
            row.addEventListener('mouseleave', function() {
                movable.style.display = 'none';
            });
        }
    });
});
</script>
