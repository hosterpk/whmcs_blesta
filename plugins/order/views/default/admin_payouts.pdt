<?php /** @var View $this */ ?>

<?php
echo (isset($message) ? $message : null);

$links = [
    ['name' => $this->_('AdminPayouts.index.category_approved', true) . ' <span class="badge bg-secondary ms-1">' . (($status_count['approved'] ?? null) ? $this->Html->safe($status_count['approved']) : '0') . '</span>', 'current' => (($status ?? 'approved') == 'approved' ? true : false), 'attributes' => ['href' => $this->base_uri . 'plugin/order/admin_payouts/index/approved', 'class' => 'ajax']],
    ['name' => $this->_('AdminPayouts.index.category_pending', true) . ' <span class="badge bg-secondary ms-1">' . (($status_count['pending'] ?? null) ? $this->Html->safe($status_count['pending']) : '0') . '</span>',  'current' => (($status ?? null) == 'pending' ? true : false), 'attributes' => ['href' => $this->base_uri . 'plugin/order/admin_payouts/index/pending', 'class' => 'ajax']],
    ['name' => $this->_('AdminPayouts.index.category_declined', true) . ' <span class="badge bg-secondary ms-1">' . (($status_count['declined'] ?? null) ? $this->Html->safe($status_count['declined']) : '0') . '</span>',  'current' => (($status ?? null) == 'declined' ? true : false), 'highlight' => true, 'attributes' => ['href' => $this->base_uri . 'plugin/order/admin_payouts/index/declined', 'class' => 'ajax']],
];
$this->Widget->clear();
$this->Widget->setLinks($links);
$this->Widget->setNavStyle('nav-tabs-custom');
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminPayouts.index.boxtitle_payouts', true), ['id'=>'admin_payouts'], (isset($render_section) ? $render_section : null));
if (($order_affiliate_payouts ?? null) && !empty($order_affiliate_payouts)) {
?>
<div class="table-responsive">
    <table class="table table-hover mb-0" id="payouts">
        <thead>
            <tr>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_payouts/index/' . ($status ?? null) . '/?sort=id&order=' . ($sort == 'id' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminPayouts.index.heading_payout_id');?>
                        <?php if ($sort == 'id') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_payouts/index/' . ($status ?? null) . '/?sort=contacts.first_name&order=' . ($sort == 'contacts.first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminPayouts.index.heading_name');?>
                        <?php if ($sort == 'contacts.first_name') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_payouts/index/' . ($status ?? null) . '/?sort=order_affiliates.code&order=' . ($sort == 'order_affiliates.code' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminPayouts.index.heading_code');?>
                        <?php if ($sort == 'order_affiliates.code') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_payouts/index/' . ($status ?? null) . '/?sort=order_affiliate_payment_method_names.name&order=' . ($sort == 'order_affiliate_payment_method_names.name' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminPayouts.index.heading_payment_method_id');?>
                        <?php if ($sort == 'order_affiliate_payment_method_names.name') { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <?php
                $columns = ['requested_amount', 'requested_currency', 'paid_amount', 'paid_currency', 'date_requested'];
                foreach ($columns as $column) {
                ?>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_payouts/index/' . ($status ?? null) . '/?sort=' . $column . '&order=' . ($sort == $column ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminPayouts.index.heading_' . $column);?>
                        <?php if ($sort == $column) { ?>
                            <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                        <?php } ?>
                    </a>
                </th>
                <?php
                }
                ?>
                <th style="width: 150px;"><?php $this->_('AdminPayouts.index.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            foreach ($order_affiliate_payouts as $order_affiliate_payout) {
            ?>
            <tr>
                <td><?php echo ($order_affiliate_payout->id ?? null) ? $this->Html->safe($order_affiliate_payout->id) : null; ?></td>
                <td><a href="<?php echo $this->Html->safe(($this->base_uri ?? null) . 'clients/view/' . ($order_affiliate_payout->client_id ?? null));?>"><?php echo ($order_affiliate_payout->affiliate_first_name ?? null) ? $this->Html->safe($order_affiliate_payout->affiliate_first_name) : null; ?> <?php echo ($order_affiliate_payout->affiliate_last_name ?? null) ? $this->Html->safe($order_affiliate_payout->affiliate_last_name) : null; ?></a></td>
                <td><?php echo ($order_affiliate_payout->affiliate_code ?? null) ? $this->Html->safe($order_affiliate_payout->affiliate_code) : null; ?></td>
                <td>
                    <?php echo ($order_affiliate_payout->payment_method_id ?? null)
                        ? $this->Html->safe(($payment_methods[$order_affiliate_payout->payment_method_id] ?? $order_affiliate_payout->payment_method_id))
                        : $this->_('AdminPayouts.index.payment_method_na');
                    ?>
                </td>
                <td><?php echo $this->CurrencyFormat->format($order_affiliate_payout->requested_amount, $order_affiliate_payout->requested_currency);?></td>
                <td><?php echo ($order_affiliate_payout->requested_currency ?? null) ? $this->Html->safe($order_affiliate_payout->requested_currency) : null; ?></td>
                <td><?php echo $this->CurrencyFormat->format($order_affiliate_payout->paid_amount, $order_affiliate_payout->paid_currency);?></td>
                <td><?php echo ($order_affiliate_payout->paid_currency ?? null) ? $this->Html->safe($order_affiliate_payout->paid_currency) : null; ?></td>
                <td><?php echo $this->Date->cast(($order_affiliate_payout->date_requested ?? null) ? $this->Html->safe($order_affiliate_payout->date_requested) : null);?></td>
                <td>
                    <div class="d-flex gap-2">
                        <?php
                        if ($order_affiliate_payout->status == 'declined' || $order_affiliate_payout->status == 'pending') {
                            $this->Form->create($this->base_uri . 'plugin/order/admin_payouts/approve/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', ($order_affiliate_payout->id ?? null));
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-success modal-confirm-success" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminPayouts.index.confirm_approve', true));?>" title="<?php $this->_('AdminPayouts.index.option_approve');?>">
                            <i class="bi bi-check-circle"></i>
                        </button>
                        <?php
                            $this->Form->end();
                        }
                        ?>
                        <?php
                        if ($order_affiliate_payout->status == 'approved' || $order_affiliate_payout->status == 'pending') {
                            $this->Form->create($this->base_uri . 'plugin/order/admin_payouts/decline/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', ($order_affiliate_payout->id ?? null));
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminPayouts.index.confirm_decline', true));?>" title="<?php $this->_('AdminPayouts.index.option_decline');?>">
                            <i class="bi bi-x-circle"></i>
                        </button>
                        <?php
                            $this->Form->end();
                        }
                        ?>
                        <a href="<?php echo $this->base_uri . 'plugin/order/admin_payouts/edit/' . (($order_affiliate_payout->id ?? null) ? $this->Html->safe($order_affiliate_payout->id) : null) . '/';?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminPayouts.index.option_edit');?>">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                </td>
            </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php
    if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        $this->Widget->footer();
        $this->Pagination->build();
    }
} else {
?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-cash-stack fs-1 mb-3 d-block"></i>
    <?php $this->_('AdminPayouts.index.no_results');?>
</div>
<?php
}
$this->Widget->end();
?>

<script type="text/javascript">
(function() {
    'use strict';

    function initModalConfirms() {
        if (typeof blestaModalConfirm === 'function') {
            blestaModalConfirm('.modal-confirm');
            blestaModalConfirm('.modal-confirm-delete');
            blestaModalConfirm('.modal-confirm-success');
        }
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initModalConfirms);
    } else {
        initModalConfirms();
    }

    // Re-initialize after AJAX tab switches
    document.addEventListener('blestaAjaxComplete', function() {
        initModalConfirms();
    });
})();
</script>
