<?php /** @var View $this */ ?>

<?php
    if (($message ?? null)) {
        echo ($message ?? null);
    }

    $tabs = [
        [
            'name' => $this->_('AdminExcludedPackages.index.tab_available_packages', true),
            'current' => (($tab ?? 'available_packages') == 'available_packages'),
            'attributes' => [
                'id' => 'tab-available-packages',
                'data-bs-toggle' => 'tab',
                'data-bs-target' => '#tab_available_packages',
                'href' => '#'
            ]
        ],
        [
            'name' => $this->_('AdminExcludedPackages.index.tab_hidden_packages', true),
            'current' => (($tab ?? null) == 'hidden_packages'),
            'attributes' => [
                'id' => 'tab-hidden-packages',
                'data-bs-toggle' => 'tab',
                'data-bs-target' => '#tab_hidden_packages',
                'href' => '#'
            ]
        ]
    ];

    $this->Form->create(null, ['class' => 'disable-on-submit']);

    $this->Widget->clear();
    $this->Widget->setTabs($tabs);
    $this->Widget->setStyleSheet($this->view_dir . 'css/styles.css', ['id' => 'order_form_styles']);
    $this->Widget->setBodyWrapper(false);
    $this->Widget->create($this->_('AdminExcludedPackages.index.boxtitle_excluded_packages', true), [], ($render_section ?? null));
    ?>
<div class="tab-content">
    <div class="tab-pane fade<?php echo (($tab ?? 'available_packages') == 'available_packages') ? ' show active' : ''; ?>" id="tab_available_packages" role="tabpanel">
        <?php
        if (!empty($packages)) {
        ?>
        <div class="card-body">
            <h6 class="form-section-header"><?php $this->_('AdminExcludedPackages.index.heading_available_packages');?></h6>
            <div class="row g-3">
                <?php
                foreach ($packages as $package) {
                ?>
                <div class="col-md-6 col-lg-4">
                    <div class="form-check">
                        <?php
                        $this->Form->fieldCheckbox('package_' . $package->id, $package->id, ($vars['package_' . $package->id] ?? null) == $package->id, ['id' => 'package_' . $package->id, 'class' => 'form-check-input']);
                        $this->Form->label($package->name, 'package_' . $package->id, ['class' => 'form-check-label']);
                        ?>
                        <small class="text-muted d-block"><?php echo $this->Html->safe(isset($package->module_name) ? '(' . $package->module_name . ')' : null);?></small>
                    </div>
                </div>
                <?php
                }
                ?>
            </div>
        </div>
        <?php
        } else {
        ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-box fs-1 mb-3 d-block"></i>
            <?php $this->_('AdminExcludedPackages.index.text_no_packages');?>
        </div>
        <?php
        }
        ?>
    </div>
    <div class="tab-pane fade<?php echo (($tab ?? null) == 'hidden_packages') ? ' show active' : ''; ?>" id="tab_hidden_packages" role="tabpanel">
        <?php
        if (!empty($hidden_packages)) {
        ?>
        <div class="card-body">
            <h6 class="form-section-header"><?php $this->_('AdminExcludedPackages.index.heading_hidden_packages');?></h6>
            <div class="row g-3">
                <?php
                foreach ($hidden_packages as $hidden_package) {
                ?>
                <div class="col-md-6 col-lg-4">
                    <div class="form-check">
                        <?php
                        $this->Form->fieldCheckbox('package_' . $hidden_package->id, $hidden_package->id, ($vars['package_' . $hidden_package->id] ?? null) == $hidden_package->id, ['id' => 'package_' . $hidden_package->id, 'class' => 'form-check-input']);
                        $this->Form->label($hidden_package->name, 'package_' . $hidden_package->id, ['class' => 'form-check-label']);
                        ?>
                        <small class="text-muted d-block"><?php echo $this->Html->safe(isset($hidden_package->module_name) ? '(' . $hidden_package->module_name . ')' : null);?></small>
                    </div>
                </div>
                <?php
                }
                ?>
            </div>
        </div>
        <?php
        } else {
        ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-box fs-1 mb-3 d-block"></i>
            <?php $this->_('AdminExcludedPackages.index.text_no_packages');?>
        </div>
        <?php
        }
        ?>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminExcludedPackages.index.field_updatesubmit', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Widget->end();
$this->Form->end();
?>
