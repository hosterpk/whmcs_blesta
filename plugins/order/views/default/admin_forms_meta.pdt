<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    blestaBindToolTips();

    // Initialize drag and drop for package groups
    var memberGroups = document.getElementById('memberGroups');
    var availableGroups = document.getElementById('availableGroups');

    function makeDraggable(item) {
        item.addEventListener('dragstart', function(e) {
            this.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', this.dataset.value);
        });

        item.addEventListener('dragend', function() {
            this.classList.remove('dragging');
            document.querySelectorAll('.drag-list').forEach(function(list) {
                list.classList.remove('drag-over');
            });
        });

        // Click to select/deselect
        item.addEventListener('click', function(e) {
            if (!e.ctrlKey && !e.metaKey) {
                // Clear other selections in the same list
                var siblings = this.parentElement.querySelectorAll('.drag-item');
                siblings.forEach(function(sibling) {
                    if (sibling !== item) {
                        sibling.classList.remove('selected');
                    }
                });
            }
            this.classList.toggle('selected');
        });

        // Double-click to move to other list
        item.addEventListener('dblclick', function() {
            var currentList = this.parentElement;
            var targetList = currentList.id === 'memberGroups' ? availableGroups : memberGroups;

            if (targetList) {
                this.classList.remove('selected');
                targetList.appendChild(this);
                updateInputName(this);
            }
        });
    }

    function updateInputName(item) {
        var input = item.querySelector('input[type="hidden"]');
        var listId = item.parentElement.id;
        if (input) {
            if (listId === 'memberGroups') {
                input.name = 'groups[]';
            } else {
                input.name = 'available[]';
            }
        }
    }

    function setupDragAndDrop(list) {
        if (!list) return;

        var items = list.querySelectorAll('.drag-item');
        items.forEach(function(item) {
            makeDraggable(item);
        });

        list.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            this.classList.add('drag-over');
        });

        list.addEventListener('dragleave', function(e) {
            if (e.target === this) {
                this.classList.remove('drag-over');
            }
        });

        list.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            this.classList.remove('drag-over');

            var draggingItem = document.querySelector('.drag-item.dragging');
            if (draggingItem && draggingItem.parentElement !== this) {
                this.appendChild(draggingItem);
                updateInputName(draggingItem);
            }
        });
    }

    setupDragAndDrop(memberGroups);
    setupDragAndDrop(availableGroups);

    // Button controls
    document.addEventListener('click', function(e) {
        var moveLeftBtn = e.target.closest('.move_left');
        var moveRightBtn = e.target.closest('.move_right');

        if (moveLeftBtn) {
            e.preventDefault();
            var selectedItems = availableGroups.querySelectorAll('.drag-item.selected');
            selectedItems.forEach(function(item) {
                item.classList.remove('selected');
                memberGroups.appendChild(item);
                updateInputName(item);
            });
        }

        if (moveRightBtn) {
            e.preventDefault();
            var selectedItems = memberGroups.querySelectorAll('.drag-item.selected');
            selectedItems.forEach(function(item) {
                item.classList.remove('selected');
                availableGroups.appendChild(item);
                updateInputName(item);
            });
        }
    });
});
</script>
