<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    blestaBindToolTips();

    var formType = document.getElementById('form_type');
    var orderForm = document.getElementById('order_form');
    var orderFormMeta = document.getElementById('order_form_meta');

    // Load meta on page load and when type changes
    loadMeta();
    if (formType) {
        formType.addEventListener('change', loadMeta);
    }

    // Load swappable meta section
    function loadMeta() {
        var formData = new FormData(orderForm);
        fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/meta/');?>', {
            method: 'POST',
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.content) {
                orderFormMeta.innerHTML = data.content;
                blestaBindToolTips();
                // Re-initialize dual-select after content loads
                initializeDualSelect();
            }
        })
        .catch(function(error) {
            console.error('Error loading meta:', error);
        });
    }

    // Initialize dual-select component (called after meta loads)
    function initializeDualSelect() {
        var memberGroups = document.getElementById('memberGroups');
        var availableGroups = document.getElementById('availableGroups');

        if (!memberGroups || !availableGroups) return;

        function makeDraggable(item) {
            item.addEventListener('dragstart', function(e) {
                this.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
            });

            item.addEventListener('dragend', function() {
                this.classList.remove('dragging');
                document.querySelectorAll('.drag-list').forEach(function(list) {
                    list.classList.remove('drag-over');
                });
            });

            // Click to select/deselect
            item.addEventListener('click', function(e) {
                if (!e.ctrlKey && !e.metaKey) {
                    var siblings = this.parentElement.querySelectorAll('.drag-item');
                    siblings.forEach(function(sibling) {
                        if (sibling !== item) {
                            sibling.classList.remove('selected');
                        }
                    });
                }
                this.classList.toggle('selected');
            });

            // Double-click to move to other list
            item.addEventListener('dblclick', function() {
                var currentList = this.parentElement;
                var targetList = currentList.id === 'memberGroups' ? availableGroups : memberGroups;

                if (targetList) {
                    this.classList.remove('selected');
                    targetList.appendChild(this);
                    updateInputName(this);
                }
            });
        }

        function updateInputName(item) {
            var input = item.querySelector('input[type="hidden"]');
            var listId = item.parentElement.id;
            if (input) {
                if (listId === 'memberGroups') {
                    input.name = 'groups[]';
                } else {
                    input.name = 'available[]';
                }
            }
        }

        function setupDragAndDrop(list) {
            if (!list) return;

            var items = list.querySelectorAll('.drag-item');
            items.forEach(function(item) {
                makeDraggable(item);
            });

            list.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                this.classList.add('drag-over');
            });

            list.addEventListener('dragleave', function(e) {
                if (e.target === this) {
                    this.classList.remove('drag-over');
                }
            });

            list.addEventListener('drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                this.classList.remove('drag-over');

                var draggingItem = document.querySelector('.drag-item.dragging');
                if (draggingItem && draggingItem.parentElement !== this) {
                    this.appendChild(draggingItem);
                    updateInputName(draggingItem);
                }
            });
        }

        setupDragAndDrop(memberGroups);
        setupDragAndDrop(availableGroups);
    }

    // Move packages between groups
    document.addEventListener('click', function(e) {
        var moveLeftBtn = e.target.closest('.move_left');
        var moveRightBtn = e.target.closest('.move_right');

        if (moveLeftBtn || moveRightBtn) {
            e.preventDefault();
            var memberGroups = document.getElementById('memberGroups');
            var availableGroups = document.getElementById('availableGroups');

            if (!memberGroups || !availableGroups) return;

            if (moveLeftBtn) {
                var selectedItems = availableGroups.querySelectorAll('.drag-item.selected');
                selectedItems.forEach(function(item) {
                    item.classList.remove('selected');
                    memberGroups.appendChild(item);
                    var input = item.querySelector('input[type="hidden"]');
                    if (input) input.name = 'groups[]';
                });
            }

            if (moveRightBtn) {
                var selectedItems = memberGroups.querySelectorAll('.drag-item.selected');
                selectedItems.forEach(function(item) {
                    item.classList.remove('selected');
                    availableGroups.appendChild(item);
                    var input = item.querySelector('input[type="hidden"]');
                    if (input) input.name = 'available[]';
                });
            }
        }
    });

    // Select all member groups on form submit
    if (orderForm) {
        orderForm.addEventListener('submit', function() {
            var memberGroups = document.getElementById('memberGroups');
            if (memberGroups) {
                var items = memberGroups.querySelectorAll('.drag-item input[type="hidden"]');
                items.forEach(function(input) {
                    input.name = 'groups[]';
                });
            }
            // Ensure all options in the assigned dual-selects are posted
            document.querySelectorAll('.domain-assigned option').forEach(function(opt) {
                opt.hidden = false;
                opt.disabled = false;
                opt.selected = true;
            });
            // Normalize names on the domain package-groups drag-list before submit
            var domainAssigned = document.getElementById('domain_assigned_packages');
            if (domainAssigned) {
                domainAssigned.querySelectorAll('.drag-item input[type="hidden"]').forEach(function(input) {
                    input.name = 'meta[package_groups][]';
                });
            }
        });
    }

    // Domain order type: delegated handlers survive AJAX re-render of the meta partial
    function isDomainPackageList(el) {
        return !!el && (el.id === 'domain_assigned_packages' || el.id === 'domain_available_packages');
    }

    function updateDomainPackageName(item) {
        var input = item.querySelector('input[type="hidden"]');
        if (!input || !item.parentElement) return;
        input.name = item.parentElement.id === 'domain_assigned_packages'
            ? 'meta[package_groups][]'
            : 'domain_available_packages[]';
    }

    document.addEventListener('change', function(e) {
        if (!e.target || e.target.id !== 'free_domain') return;
        var show = e.target.checked;
        ['free_domain_tlds', 'free_domain_packages', 'free_domain_term'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.style.display = show ? 'block' : 'none';
        });
        var limit = document.getElementById('limit_term');
        if (limit) limit.checked = show;
    });

    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.domain-move-left, .domain-move-right');
        if (!btn) return;
        var from = document.getElementById(btn.dataset.from);
        var to = document.getElementById(btn.dataset.to);
        if (!from || !to) return;
        e.preventDefault();
        if (from.tagName === 'SELECT') {
            Array.from(from.selectedOptions).forEach(function(opt) {
                to.appendChild(opt);
            });
        } else if (from.classList.contains('drag-list')) {
            from.querySelectorAll('.drag-item.selected').forEach(function(item) {
                item.classList.remove('selected');
                to.appendChild(item);
                updateDomainPackageName(item);
            });
        }
    });

    document.addEventListener('input', function(e) {
        if (!e.target.classList || !e.target.classList.contains('domain-search')) return;
        var target = document.getElementById(e.target.dataset.target);
        if (!target) return;
        var term = e.target.value.toLowerCase();
        var matching = [];
        var nonMatching = [];
        Array.from(target.options).forEach(function(opt) {
            var matches = !term || opt.textContent.toLowerCase().indexOf(term) !== -1;
            opt.hidden = !matches;
            opt.disabled = !matches;
            (matches ? matching : nonMatching).push(opt);
        });
        // Safari ignores option.hidden, so move matches to the top so they're scannable
        matching.concat(nonMatching).forEach(function(opt) {
            target.appendChild(opt);
        });
    });

    // Domain package groups drag-list: click-to-select, dblclick-to-move, drag/drop
    document.addEventListener('click', function(e) {
        var item = e.target.closest('.drag-item');
        if (!item || !isDomainPackageList(item.parentElement)) return;
        if (!e.ctrlKey && !e.metaKey) {
            item.parentElement.querySelectorAll('.drag-item').forEach(function(sib) {
                if (sib !== item) sib.classList.remove('selected');
            });
        }
        item.classList.toggle('selected');
    });

    document.addEventListener('dblclick', function(e) {
        var item = e.target.closest('.drag-item');
        if (!item || !isDomainPackageList(item.parentElement)) return;
        var toId = item.parentElement.id === 'domain_assigned_packages'
            ? 'domain_available_packages'
            : 'domain_assigned_packages';
        var to = document.getElementById(toId);
        if (!to) return;
        item.classList.remove('selected');
        to.appendChild(item);
        updateDomainPackageName(item);
    });

    document.addEventListener('dragstart', function(e) {
        var item = e.target.closest('.drag-item');
        if (!item || !isDomainPackageList(item.parentElement)) return;
        item.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
    });

    document.addEventListener('dragend', function(e) {
        var item = e.target.closest('.drag-item');
        if (!item || !item.classList.contains('dragging')) return;
        item.classList.remove('dragging');
        document.querySelectorAll('.drag-list').forEach(function(l) {
            l.classList.remove('drag-over');
        });
    });

    document.addEventListener('dragover', function(e) {
        var list = e.target.closest('.drag-list');
        if (!list || !isDomainPackageList(list)) return;
        var dragging = document.querySelector('.drag-item.dragging');
        if (!dragging || !isDomainPackageList(dragging.parentElement)) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        list.classList.add('drag-over');
    });

    document.addEventListener('dragleave', function(e) {
        var list = e.target.closest('.drag-list');
        if (!list || !isDomainPackageList(list)) return;
        if (e.target === list) list.classList.remove('drag-over');
    });

    document.addEventListener('drop', function(e) {
        var list = e.target.closest('.drag-list');
        if (!list || !isDomainPackageList(list)) return;
        var dragging = document.querySelector('.drag-item.dragging');
        if (!dragging || !isDomainPackageList(dragging.parentElement)) return;
        e.preventDefault();
        e.stopPropagation();
        list.classList.remove('drag-over');
        if (dragging.parentElement !== list) {
            list.appendChild(dragging);
            updateDomainPackageName(dragging);
        }
    });

    // Update label section of URL on load
    var formLabel = document.getElementById('form_label');
    var orderLabel = document.getElementById('order_label');
    var formLabelLink = document.getElementById('form_label_link');

    if (formLabel && orderLabel && formLabelLink) {
        orderLabel.textContent = encodeURIComponent(formLabel.value);
        formLabelLink.href = formLabelLink.textContent;

        formLabel.addEventListener('keyup', function() {
            orderLabel.textContent = encodeURIComponent(this.value);
            formLabelLink.href = formLabelLink.textContent;
        });
    }

    // Template style change
    document.querySelectorAll('.template_style').forEach(function(radio) {
        radio.addEventListener('change', function() {
            document.getElementById('form_template').value = this.getAttribute('data-template');
        });
    });

    // Abandoned cart cancellation toggle
    var abandonedCartCancellation = document.getElementById('abandoned_cart_cancellation');
    var inactiveClient = document.getElementById('inactive_client');

    function toggleInactiveClient() {
        if (abandonedCartCancellation && inactiveClient) {
            if (abandonedCartCancellation.value !== '' && parseInt(abandonedCartCancellation.value) > 0) {
                inactiveClient.style.display = 'block';
            } else {
                inactiveClient.style.display = 'none';
            }
        }
    }

    if (abandonedCartCancellation) {
        abandonedCartCancellation.addEventListener('change', toggleInactiveClient);
        toggleInactiveClient();
    }
});
</script>
