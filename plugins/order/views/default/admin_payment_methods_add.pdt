<?php /** @var View $this */ ?>

<?php
echo (isset($message) ? $message : null);

$this->Form->create(null, ['id' => 'admin_payment_methods_add', 'class' => 'disable-on-submit']);

$this->Widget->clear();
$this->Widget->setStyleSheet($this->view_dir . 'css/styles.css', ['id' => 'order_form_styles']);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminPaymentMethods.add.boxtitle_add_payment_method', true), [], ($render_section ?? null));
?>
<div class="card-body">
    <ul class="nav nav-tabs-connected" role="tablist">
        <?php
        foreach ($languages as $i => $lang) {
            $is_active = (($lang->code ?? null) == Configure::get('Blesta.language'));
            ?>
            <li class="nav-item" role="presentation">
                <button class="nav-link<?php echo $is_active ? ' active' : ''; ?>" id="lang-tab-<?php echo $this->Html->safe($lang->code); ?>" data-bs-toggle="tab" data-bs-target="#lang-pane-<?php echo $this->Html->safe($lang->code); ?>" type="button" role="tab">
                    <?php echo ($lang->name ?? null) ? $this->Html->safe($lang->name) : null; ?>
                </button>
            </li>
            <?php
        }
        ?>
    </ul>
    <div class="tab-content tab-content-connected mb-3">
        <?php
        foreach ($languages as $i => $lang) {
            $is_active = (($lang->code ?? null) == Configure::get('Blesta.language'));
            $name_value = '';

            foreach ((array)($vars->names ?? null) as $name) {
                $name = (object) $name;
                if (($name->lang ?? null) == $lang->code) {
                    $name_value = ($name->name ?? null);
                    break;
                }
            }
            ?>
            <div class="tab-pane fade<?php echo $is_active ? ' show active' : ''; ?>" id="lang-pane-<?php echo $this->Html->safe($lang->code); ?>" role="tabpanel">
                <div class="mb-3">
                    <?php
                    $this->Form->label($this->_('AdminPaymentMethods.add.field_name', true), 'name_' . ($lang->code ?? null), ['class' => 'form-label']);
                    $this->Form->fieldHidden('names[' . $i . '][lang]', ($lang->code ?? null));
                    $this->Form->fieldText('names[' . $i . '][name]', ($name_value ?? null), ['id' => 'name_' . ($lang->code ?? null), 'class' => 'form-control']);
                    ?>
                </div>
            </div>
            <?php
        }
        ?>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminPaymentMethods.add.field_payment_methodsubmit', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Widget->end();
$this->Form->end();
?>
