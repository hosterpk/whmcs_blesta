?>

<script type="text/javascript">
(function() {
    'use strict';

    var baseUri = '<?php echo $this->Html->safe($this->base_uri);?>';
    var orderInfoLoaded = {};
    var itemsSelectedText = '<?php echo $this->Html->safe($this->_('AdminMain.index.text_items_selected', true));?>';

    function initTooltips() {
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
            if (!el._tooltip) {
                el._tooltip = new bootstrap.Tooltip(el, {
                    html: true,
                    delay: { show: 300, hide: 100 }
                });
            }
        });
    }

    function updateOrderControls() {
        var checkedBoxes = document.querySelectorAll('#orders .order-checkbox:checked');
        var updateDiv = document.getElementById('update_orders');
        var selectedCount = document.getElementById('selectedCount');

        if (updateDiv) {
            updateDiv.classList.toggle('d-none', checkedBoxes.length === 0);
        }

        if (selectedCount) {
            selectedCount.textContent = checkedBoxes.length + ' ' + itemsSelectedText;
        }
    }

    function loadOrderDetails(orderId, container) {
        if (orderInfoLoaded[orderId]) return;

        fetch(baseUri + 'plugin/order/admin_main/orderinfo/' + orderId, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) {
            return response.text();
        })
        .then(function(html) {
            container.innerHTML = html;
            orderInfoLoaded[orderId] = true;
        })
        .catch(function(error) {
            container.innerHTML = '<div class="text-danger p-3">Failed to load order details</div>';
        });
    }

    function init() {
        initTooltips();
        updateOrderControls();
    }

    // Event delegation for select all checkboxes
    document.addEventListener('change', function(e) {
        if (e.target && e.target.id === 'select_all_orders') {
            var isChecked = e.target.checked;
            document.querySelectorAll('#orders .order-checkbox').forEach(function(checkbox) {
                checkbox.checked = isChecked;
            });
            updateOrderControls();
        }
    });

    // Checkbox change handler
    document.addEventListener('change', function(e) {
        if (e.target && e.target.classList.contains('order-checkbox')) {
            var selectAll = document.getElementById('select_all_orders');
            var allCheckboxes = document.querySelectorAll('#orders .order-checkbox');
            var checkedCheckboxes = document.querySelectorAll('#orders .order-checkbox:checked');

            if (selectAll) {
                selectAll.checked = allCheckboxes.length === checkedCheckboxes.length;
            }
            updateOrderControls();
        }
    });

    // Listen for Bootstrap collapse show event to load order details via AJAX
    document.addEventListener('show.bs.collapse', function(e) {
        var collapseRow = e.target;
        if (!collapseRow.classList.contains('collapse')) return;

        var container = collapseRow.querySelector('.order-details-content');
        if (!container) return;

        var orderId = container.getAttribute('data-order-id');
        if (orderId) {
            loadOrderDetails(orderId, container);
        }
    });

    // Click handler for expandable rows (using document-level delegation to survive AJAX pagination)
    document.addEventListener('click', function(e) {
        // Only handle clicks within the orders table
        if (!e.target.closest('#orders')) return;

        // Don't expand if clicking a link, button, or input
        if (e.target.closest('a, button, input, label')) return;

        // Find the row with data-collapse-row attribute
        var row = e.target.closest('tr[data-collapse-row]');
        if (!row) return;

        // Don't expand if clicking the first column (checkbox)
        var td = e.target.closest('td');
        var tds = row.querySelectorAll('td');
        if (td && tds[0] === td) return;

        // Get the next sibling row (the collapse row)
        var collapseRow = row.nextElementSibling;
        if (collapseRow && collapseRow.classList.contains('collapse')) {
            var bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseRow, { toggle: false });
            bsCollapse.toggle();
        }
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
