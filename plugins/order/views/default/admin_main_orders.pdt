<script type="text/javascript">
(function() {
    'use strict';

    var widgetId = 'plugin_order_admin_main_orders';
    var baseUri = '<?php echo $this->Html->safe($this->base_uri);?>';
    var orderInfoLoaded = {};
    var itemsSelectedText = '<?php echo $this->Html->safe($this->_('AdminMain.index.text_items_selected', true));?>';

    function updateOrderControls() {
        var widget = document.getElementById(widgetId);
        if (!widget) return;

        var checkedBoxes = widget.querySelectorAll('.order-checkbox:checked');
        var updateDiv = document.getElementById('update_orders');
        var selectedCount = document.getElementById('selectedCount');

        if (updateDiv) {
            updateDiv.classList.toggle('d-none', checkedBoxes.length === 0);
        }

        if (selectedCount) {
            selectedCount.textContent = checkedBoxes.length + ' ' + itemsSelectedText;
        }
    }

    function loadOrderDetails(orderId, container) {
        if (orderInfoLoaded[orderId]) return;

        container.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Loading...</span></div></div>';

        fetch(baseUri + 'plugin/order/admin_main/orderinfo/' + orderId, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(response) { return response.text(); })
        .then(function(html) {
            container.innerHTML = html;
            orderInfoLoaded[orderId] = true;
        })
        .catch(function() {
            container.innerHTML = '<div class="text-danger p-3">Failed to load order details</div>';
        });
    }

    // Select all checkbox
    document.addEventListener('change', function(e) {
        if (!e.target.closest('#' + widgetId)) return;

        if (e.target.matches('input[value="all"]')) {
            var widget = document.getElementById(widgetId);
            var isChecked = e.target.checked;
            widget.querySelectorAll('.order-checkbox').forEach(function(cb) {
                cb.checked = isChecked;
            });
            updateOrderControls();
        }

        if (e.target.classList.contains('order-checkbox')) {
            var widget = document.getElementById(widgetId);
            var allCheckboxes = widget.querySelectorAll('.order-checkbox');
            var checkedCheckboxes = widget.querySelectorAll('.order-checkbox:checked');
            var selectAll = widget.querySelector('input[value="all"]');
            if (selectAll) {
                selectAll.checked = allCheckboxes.length === checkedCheckboxes.length;
            }
            updateOrderControls();
        }
    });

    // Bootstrap collapse show event — load order details via AJAX
    document.addEventListener('show.bs.collapse', function(e) {
        if (!e.target.closest('#' + widgetId)) return;
        var container = e.target.querySelector('.order-details-content');
        if (!container) return;
        var orderId = container.getAttribute('data-order-id');
        if (orderId) {
            loadOrderDetails(orderId, container);
        }
    });

    // Click handler for expandable rows
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#' + widgetId)) return;
        if (!e.target.closest('#orders')) return;
        if (e.target.closest('a, button, input, label')) return;

        var row = e.target.closest('tr[data-collapse-row]');
        if (!row) return;

        // Don't expand if clicking the checkbox column
        var td = e.target.closest('td');
        var tds = row.querySelectorAll('td');
        if (td && tds[0] === td) return;

        var collapseRow = row.nextElementSibling;
        if (collapseRow && collapseRow.classList.contains('collapse')) {
            var bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapseRow, { toggle: false });
            bsCollapse.toggle();
        }
    });

    // Init tooltips
    blestaBindToolTips();
    updateOrderControls();
})();
</script>
