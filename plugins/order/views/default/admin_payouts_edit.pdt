    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminPayouts.edit.field_status', true), 'status', ['class' => 'form-label']);
        $this->Form->fieldSelect('status', (isset($statuses) ? $statuses : []), (isset($vars->status) ? $vars->status : null), ['id' => 'status', 'class' => 'form-select']);
        ?>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
