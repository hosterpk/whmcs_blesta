?>
<div class="card-body">
    <h6 class="form-section-header"><?php $this->_('AdminPayouts.edit.heading_payout_request');?></h6>

    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminPayouts.edit.field_payment_method_id', true), 'payment_method_id', ['class' => 'form-label']);
        $this->Form->fieldSelect('payment_method_id', (isset($payment_methods) ? $payment_methods : []), (isset($vars->payment_method_id) ? $vars->payment_method_id : null), ['id' => 'payment_method_id', 'class' => 'form-select']);
        ?>
    </div>
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminPayouts.edit.field_requested_amount', true), 'requested_amount', ['class' => 'form-label']);
        $this->Form->fieldText('requested_amount', (isset($vars->requested_amount) ? $vars->requested_amount : null), ['id' => 'requested_amount', 'class' => 'form-control']);
        ?>
    </div>
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminPayouts.edit.field_requested_currency', true), 'requested_currency', ['class' => 'form-label']);
        $this->Form->fieldSelect('requested_currency', (isset($currencies) ? $currencies : []), (isset($vars->requested_currency) ? $vars->requested_currency : null), ['id' => 'requested_currency', 'class' => 'form-select']);
        ?>
