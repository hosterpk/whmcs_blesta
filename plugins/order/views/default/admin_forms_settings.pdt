        $this->Form->label($this->_('AdminForms.settings.field_embed_code', true), 'embed_code', ['class' => 'form-label']);
        $this->Form->fieldTextarea('embed_code', ($vars['embed_code'] ?? null), ['id' => 'embed_code', 'class' => 'form-control font-monospace', 'rows' => '4']);
        ?>
    </div>

    <h6 class="form-section-header"><?php $this->_('AdminForms.settings.marketing_heading');?></h6>

    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminForms.settings.field_marketing_default', true), null, ['class' => 'form-label']);
        ?>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio('marketing_default', 'true', (($vars['marketing_default'] ?? null) == 'true'), ['id'=>'marketing_default_true', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminForms.settings.field_marketing_default.true', true), 'marketing_default_true', ['class'=>'form-check-label']);
            ?>
            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="<?php echo $this->_('AdminForms.settings.tooltip_marketing_default_true', true);?>"></i>
        </div>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio('marketing_default', 'false', (($vars['marketing_default'] ?? 'false') == 'false'), ['id'=>'marketing_default_false', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminForms.settings.field_marketing_default.false', true), 'marketing_default_false', ['class'=>'form-check-label']);
            ?>
            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="<?php echo $this->_('AdminForms.settings.tooltip_marketing_default_false', true);?>"></i>
        </div>
    </div>

    <h6 class="form-section-header"><?php $this->_('AdminForms.settings.registration_heading');?></h6>

    <p class="text-muted"><?php $this->_('AdminForms.settings.text_accepted_payment_types');?></p>
    <div class="mb-3 form-check">
        <?php
        $this->Form->fieldCheckbox('payments_allowed_cc', 'true', (($vars['payments_allowed_cc'] ?? ($payments_allowed_cc ?? null)) == 'true'), ['id' => 'cc', 'class' => 'form-check-input']);
        $this->Form->label($this->_('AdminForms.settings.payments_allowed_cc', true), 'cc', ['class' => 'form-check-label']);
        ?>
    </div>
    <div class="mb-3 form-check">
        <?php
        $this->Form->fieldCheckbox('payments_allowed_ach', 'true', (($vars['payments_allowed_ach'] ?? ($payments_allowed_ach ?? null)) == 'true'), ['id' => 'ach', 'class' => 'form-check-input']);
        $this->Form->label($this->_('AdminForms.settings.payments_allowed_ach', true), 'ach', ['class' => 'form-check-label']);
        ?>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminForms.settings.field_save', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Widget->end();
$this->Form->end();
?>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    blestaBindToolTips();

    var antifraudSelect = document.getElementById('antifraud');
    var antifraudSettings = document.querySelectorAll('.antifraud_settings');
    var antifraudOptions = document.getElementById('antifraud_options');

    function setAntifraud() {
        if (antifraudSelect.value === '') {
            antifraudSettings.forEach(function(el) {
                el.style.display = 'none';
            });
        } else {
            antifraudSettings.forEach(function(el) {
                el.style.display = 'block';
            });
        }

        var form = antifraudSelect.closest('form');
        var formData = new FormData(form);

        fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_forms/antifraudsettings/');?>' + antifraudSelect.value, {
            method: 'POST',
            body: formData
        })
        .then(function(response) { return response.text(); })
        .then(function(data) {
            antifraudOptions.innerHTML = data;
        })
        .catch(function(error) {
            console.error('Error:', error);
        });
    }

    setAntifraud();
    antifraudSelect.addEventListener('change', setAntifraud);
});
</script>
