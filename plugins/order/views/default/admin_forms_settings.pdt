            $this->Form->fieldRadio('antifraud_frequency', 'new', (($vars['antifraud_frequency'] ?? null) == 'new'), ['id'=>'antifraud_frequency_new', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminForms.settings.field_antifraud_frequency.new', true), 'antifraud_frequency_new', ['class'=>'form-check-label']);
            ?>
        </div>
        <div class="form-check">
            <?php
            $this->Form->fieldRadio('antifraud_frequency', 'always', (($vars['antifraud_frequency'] ?? 'always') == 'always'), ['id'=>'antifraud_frequency_always', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminForms.settings.field_antifraud_frequency.always', true), 'antifraud_frequency_always', ['class'=>'form-check-label']);
            ?>
        </div>
    </div>
    <div id="antifraud_options"></div>

    <h6 class="form-section-header"><?php $this->_('AdminForms.settings.email_verification_heading');?></h6>

    <div class="mb-3 form-check">
