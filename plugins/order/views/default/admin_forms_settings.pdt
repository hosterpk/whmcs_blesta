        $this->Form->fieldCheckbox('hold_unverified_orders', 'true', (($vars['hold_unverified_orders'] ?? 'false') == 'true'), ['id' => 'hold_unverified_orders', 'class' => 'form-check-input']);
        $this->Form->label($this->_('AdminForms.settings.hold_unverified_orders', true), 'hold_unverified_orders', ['class' => 'form-check-label']);
        ?>
    </div>

    <h6 class="form-section-header"><?php $this->_('AdminForms.settings.embed_code_heading');?></h6>

    <div class="mb-3">
        <?php
        if (is_array(($tags ?? null))) {
        ?>
            <div class="alert alert-info">
                <h6 class="alert-heading mb-2"><i class="bi bi-tags me-2"></i>Tags</h6>
                <div class="d-flex flex-wrap gap-2">
                <?php
                for ($i = 0, $num_tags = count($tags); $i < $num_tags; $i++) {
                ?>
                    <code><?php echo ($tags[$i] ?? null) ? $this->Html->safe($tags[$i]) : null; ?></code>
                <?php
                }
                ?>
                </div>
            </div>
        <?php
        }
        ?>
    </div>
