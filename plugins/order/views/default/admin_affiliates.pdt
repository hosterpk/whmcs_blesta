<?php /** @var View $this */ ?>

<?php
if (($affiliates_enabled ?? null) == 'true') {
    echo (isset($message) ? $message : null);

    $links = [
        ['name' => $this->_('AdminAffiliates.index.category_active', true) . ' <span class="badge bg-secondary ms-1">' . (($status_count['active'] ?? null) ? $this->Html->safe($status_count['active']) : '0') . '</span>', 'current' => (($status ?? 'active') == 'active' ? true : false), 'attributes' => ['href' => $this->base_uri . 'plugin/order/admin_affiliates/index/active', 'class' => 'ajax']],
        ['name' => $this->_('AdminAffiliates.index.category_inactive', true) . ' <span class="badge bg-secondary ms-1">' . (($status_count['inactive'] ?? null) ? $this->Html->safe($status_count['inactive']) : '0') . '</span>',  'current' => (($status ?? null) == 'inactive' ? true : false), 'highlight' => true, 'attributes' => ['href' => $this->base_uri . 'plugin/order/admin_affiliates/index/inactive', 'class' => 'ajax']],
    ];
    $link_buttons = [
        [
            'icon' => 'bi bi-plus-lg',
            'name' => '',
            'attributes' => [
                'title' => $this->_('AdminAffiliates.index.order_affiliate_add', true),
                'href' => $this->Html->safe($this->base_uri . 'plugin/order/admin_affiliates/add/')
            ]
        ]
    ];
    $this->Widget->clear();
    $this->Widget->setLinks($links);
    $this->Widget->setNavStyle('nav-tabs-custom');
    $this->Widget->setLinkButtons($link_buttons);
    $this->Widget->setBodyWrapper(false);
    $this->Widget->create($this->_('AdminAffiliates.index.boxtitle_affiliates', true), ['id'=>'admin_affiliates'], (isset($render_section) ? $render_section : null));

    if (($order_affiliates ?? null) && !empty($order_affiliates)) {
    ?>
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="affiliates">
                <thead>
                    <tr>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_affiliates/index/?sort=contacts.first_name&order=' . ($sort == 'contacts.first_name' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                                <?php $this->_('AdminAffiliates.index.heading_name');?>
                                <?php if ($sort == 'contacts.first_name') { ?>
                                    <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_affiliates/index/?sort=code&order=' . ($sort == 'code' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                                <?php $this->_('AdminAffiliates.index.heading_code');?>
                                <?php if ($sort == 'code') { ?>
                                    <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_affiliates/index/?sort=visits&order=' . ($sort == 'visits' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                                <?php $this->_('AdminAffiliates.index.heading_visits');?>
                                <?php if ($sort == 'visits') { ?>
                                    <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_affiliates/index/?sort=sales&order=' . ($sort == 'sales' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                                <?php $this->_('AdminAffiliates.index.heading_sales');?>
                                <?php if ($sort == 'sales') { ?>
                                    <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_affiliates/index/?sort=date_added&order=' . ($sort == 'date_added' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                                <?php $this->_('AdminAffiliates.index.heading_date_added');?>
                                <?php if ($sort == 'date_added') { ?>
                                    <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/order/admin_affiliates/index/?sort=date_updated&order=' . ($sort == 'date_updated' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                                <?php $this->_('AdminAffiliates.index.heading_date_updated');?>
                                <?php if ($sort == 'date_updated') { ?>
                                    <i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i>
                                <?php } ?>
                            </a>
                        </th>
                        <th style="width: 100px;"><?php $this->_('AdminAffiliates.index.heading_options');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    foreach ($order_affiliates as $order_affiliate) {
                    ?>
                    <tr>
                        <td><a href="<?php echo $this->Html->safe(($this->base_uri ?? null) . 'plugin/order/admin_main/affiliates/' . ($order_affiliate->client_id ?? null));?>"><?php echo ($order_affiliate->first_name ?? null) ? $this->Html->safe($order_affiliate->first_name) : null; ?> <?php echo ($order_affiliate->last_name ?? null) ? $this->Html->safe($order_affiliate->last_name) : null; ?></a></td>
                        <td><?php echo ($order_affiliate->code ?? null) ? $this->Html->safe($order_affiliate->code) : null; ?></td>
                        <td><?php echo ($order_affiliate->visits ?? null) ? $this->Html->safe($order_affiliate->visits) : null; ?></td>
                        <td><?php echo ($order_affiliate->sales ?? null) ? $this->Html->safe($order_affiliate->sales) : null; ?></td>
                        <td><?php echo $this->Date->cast(($order_affiliate->date_added ?? null) ? $this->Html->safe($order_affiliate->date_added) : null, 'date_time');?></td>
                        <td><?php echo $this->Date->cast(($order_affiliate->date_updated ?? null) ? $this->Html->safe($order_affiliate->date_updated) : null, 'date_time');?></td>
                        <td>
                            <?php
                            $action = ($order_affiliate->status == 'active' ? 'deactivate' : 'activate');
                            $this->Form->create($this->base_uri . 'plugin/order/admin_affiliates/' . $action . '/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', ($order_affiliate->id ?? null));
                            ?>
                            <button type="button" class="btn btn-sm btn-outline-secondary modal-confirm" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminAffiliates.index.confirm_' . $action, true));?>" title="<?php $this->_('AdminAffiliates.index.option_' . $action);?>">
                                <i class="bi bi-<?php echo $action == 'activate' ? 'check-circle' : 'x-circle'; ?>"></i>
                            </button>
                            <?php
                            $this->Form->end();
                            ?>
                        </td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
        </div>
    <?php
        if (isset($this->Pagination) && $this->Pagination->hasPages()) {
            $this->Widget->footer();
            $this->Pagination->build();
        }
    } else {
    ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-people fs-1 mb-3 d-block"></i>
            <?php $this->_('AdminAffiliates.index.no_results');?>
        </div>
    <?php
    }
    $this->Widget->end();

} else {
    ?>
    <?php
    $this->Widget->clear();
    $this->Widget->setStyleSheet($this->view_dir . 'css/styles.css', ['id' => 'order_form_styles']);
    $this->Widget->setBodyWrapper(false);
    $this->Widget->create($this->_('AdminAffiliates.index.boxtitle_affiliates', true), ['id'=>'admin_affiliates'], (isset($render_section) ? $render_section : null));

    $this->Form->create();
    ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-people fs-1 mb-3 d-block"></i>
            <?php $this->_('AdminAffiliates.index.text_enable');?>
        </div>
        <?php $this->Widget->footer(); ?>
        <div class="d-flex justify-content-end gap-2">
            <?php
            $this->Form->fieldSubmit('enable', $this->_('AdminAffiliates.index.enable', true), ['class' => 'btn btn-primary']);
            ?>
        </div>
    <?php
    $this->Form->end();
    $this->Widget->end();
    ?>
    <?php
}
?>

<script type="text/javascript">
(function() {
    'use strict';

    function initModalConfirms() {
        if (typeof blestaModalConfirm === 'function') {
            blestaModalConfirm('.modal-confirm');
            blestaModalConfirm('.modal-confirm-delete');
            blestaModalConfirm('.modal-confirm-success');
        }
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initModalConfirms);
    } else {
        initModalConfirms();
    }

    // Re-initialize after AJAX tab switches and pagination
    document.addEventListener('blestaAjaxComplete', function() {
        initModalConfirms();
    });
})();
</script>
