<?php /** @var View $this */ ?>

<div class="p-2">
    <?php
    $show_fraud = false;
    if (!empty($order->fraud_report) && is_array($order->fraud_report)) {
        $show_fraud = true;
    ?>
    <div class="mb-3">
        <h6 class="mb-2"><?php $this->_('AdminMain.orderinfo.fraudreport_heading');?></h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminMain.orderinfo.fraudreport_heading_key');?></th>
                        <th><?php $this->_('AdminMain.orderinfo.fraudreport_heading_value');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    foreach ($order->fraud_report as $key => $value) {
                    ?>
                    <tr>
                        <td><?php echo (isset($key) ? $this->Html->safe($key) : null);?></td>
                        <td><pre class="mb-0"><?php echo (isset($value) ? $this->Html->safe($value) : null);?></pre></td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
        </div>
    </div>
    <?php
    }
    ?>

    <!-- Transactions Table -->
    <div class="mb-3">
        <h6 class="mb-2"><?php $this->_('AdminMain.orderinfo.applied_heading');?></h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminMain.orderinfo.applied_heading_id');?></th>
                        <th><?php $this->_('AdminMain.orderinfo.applied_heading_amount');?></th>
                        <th><?php $this->_('AdminMain.orderinfo.applied_heading_status');?></th>
                        <th><?php $this->_('AdminMain.orderinfo.applied_heading_date');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    if ((isset($applied) ? $applied : false) && ($num_applied = count($applied)) > 0) {
                        for ($i=0; $i<$num_applied; $i++) {
                            if ((isset($applied[$i]->type) ? $applied[$i]->type : null) == 'other' && (isset($applied[$i]->gateway_type) ? $applied[$i]->gateway_type : null) == 'nonmerchant') {
                                $trans_type = $applied[$i]->gateway_name;
                            } else {
                                $trans_type = (isset($transaction_types[($applied[$i]->type_name != '' ? $applied[$i]->type_name : $applied[$i]->type)]) ? $transaction_types[($applied[$i]->type_name != '' ? $applied[$i]->type_name : $applied[$i]->type)] : null);
                            }
                    ?>
                    <tr>
                        <td>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/edittransaction/' . (isset($order->client_id) ? $order->client_id : null) . '/' . (isset($applied[$i]->transaction_id) ? $applied[$i]->transaction_id : null) . '/');?>">
                                <?php echo (isset($applied[$i]->transaction_id) ? $this->Html->safe($applied[$i]->transaction_id) : null);?>
                            </a>
                        </td>
                        <td><?php echo $this->CurrencyFormat->format($applied[$i]->applied_amount, $applied[$i]->currency, ['html_code'=>true]);?></td>
                        <td><?php echo (isset($trans_type) ? $this->Html->safe($trans_type) : null);?></td>
                        <td><?php echo $this->Date->cast((isset($applied[$i]->applied_date) ? $this->Html->safe($applied[$i]->applied_date) : null), 'date_time');?></td>
                    </tr>
                    <?php
                        }
                    } else {
                    ?>
                    <tr>
                        <td colspan="4" class="text-muted"><?php $this->_('AdminMain.orderinfo.applied_no_results');?></td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Services Table -->
    <div>
        <h6 class="mb-2"><?php $this->_('AdminMain.orderinfo.services_heading');?></h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminMain.orderinfo.services_heading_name');?></th>
                        <th><?php $this->_('AdminMain.orderinfo.services_heading_package');?></th>
                        <th><?php $this->_('AdminMain.orderinfo.services_heading_status');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    if ((isset($services) ? $services : false) && ($num_services = count($services)) > 0) {
                        for ($i = 0; $i < $num_services; $i++) {
                    ?>
                    <tr>
                        <td>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/editservice/' . (isset($services[$i]->client_id) ? $services[$i]->client_id : null) . '/' . (isset($services[$i]->id) ? $services[$i]->id : null));?>">
                                <?php echo (isset($services[$i]->name) ? $this->Html->safe($services[$i]->name) : $this->Html->safe($services[$i]->package->name));?>
                            </a>
                        </td>
                        <td><?php echo (isset($services[$i]->package->name) ? $this->Html->safe($services[$i]->package->name) : null);?></td>
                        <td><span class="badge bg-warning text-dark"><?php $this->_('AdminMain.orderinfo.services_status_pending');?></span></td>
                    </tr>
                    <?php
                        }
                    } else {
                    ?>
                    <tr>
                        <td colspan="3" class="text-muted"><?php $this->_('AdminMain.orderinfo.services_no_results');?></td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
        </div>
    </div>
</div>
