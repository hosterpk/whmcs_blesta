        <div class="mb-3">
            <label class="form-label"><?php $this->_('AdminMain.settings.field_email_notice');?></label>
            <div class="d-flex flex-wrap gap-3">
                <div class="form-check">
                    <?php
                    $this->Form->fieldRadio('email_notice', 'never', (isset($vars['email_notice']) ? $vars['email_notice'] : 'never') == 'never', ['id' => 'email_notice_never', 'class' => 'form-check-input']);
                    $this->Form->label($this->_('AdminMain.settings.field_email_notice_never', true), 'email_notice_never', ['class' => 'form-check-label']);
                    ?>
