                <div class="form-check">
                    <?php
                    $this->Form->fieldRadio('email_notice', 'manual', (isset($vars['email_notice']) ? $vars['email_notice'] : 'never') == 'manual', ['id' => 'email_notice_manual', 'class' => 'form-check-input']);
