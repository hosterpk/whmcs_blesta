<?php /** @var View $this */ ?>

        <?php
        echo ($message ?? null);

        $this->Widget->clear();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminMain.service.boxtitle_pricing', true, ($service->package->name ?? null), (isset($service->name) ? $service->name : null)), ['id'=>'reassign_pricing'], (isset($render_section) ? $render_section : null));
        ?>
            <?php
            $this->Form->create(null, ['id' => 'reassign_pricing_service']);
            ?>
            <div class="card-body">
                <h6 class="form-section-header mb-3"><i class="bi bi-info-circle"></i> <?php $this->_('AdminMain.service.heading_information');?></h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_package_name');?></strong>
                        <?php echo (isset($service->package->name) ? $this->Html->safe($service->package->name) : null);?>
                    </div>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_label');?></strong>
                        <?php echo (isset($service->name) ? $this->Html->safe($service->name) : null);?>
                    </div>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_qty');?></strong>
                        <?php echo (isset($service->qty) ? $this->Html->safe($service->qty) : null);?>
                    </div>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_term');?></strong>
                        <?php
                        if ((isset($service->package_pricing->period) ? $service->package_pricing->period : null) == 'onetime') {
                            echo (isset($periods[$service->package_pricing->period]) ? $this->Html->safe($periods[$service->package_pricing->period]) : null);
                        } else {
                            $term = (isset($service->package_pricing->term) ? $this->Html->safe($service->package_pricing->term) : null);
                            echo $this->Html->safe($this->Html->concat(' ', $term, ($term == 1 ? (isset($periods[$service->package_pricing->period]) ? $periods[$service->package_pricing->period] : null) : (isset($periods[$service->package_pricing->period . '_plural']) ? $periods[$service->package_pricing->period . '_plural'] : null))));
                        }
                        ?>
                    </div>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_status');?></strong>
                        <?php echo $this->Html->safe((isset($statuses[$service->status]) ? $statuses[$service->status] : null));?>
                    </div>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_date_added');?></strong>
                        <?php echo (!empty($service->date_added) ? $this->Date->cast($service->date_added) : '');?>
                    </div>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_date_renews');?></strong>
                        <?php echo (!empty($service->date_renews) ? $this->Date->cast($service->date_renews) : $this->_('AdminMain.index.text_never', true));?>
                    </div>
                    <?php
                    // Display the coupon that should apply when the service renews
                    if ((isset($recurring_coupon) ? $recurring_coupon : null) && (isset($recurring_coupon->type) ? $recurring_coupon->type : null) == 'exclusive') {
                    ?>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_recurring_coupon');?></strong>
                        <?php
                        if ((isset($recurring_coupon->recurring_amount->type) ? $recurring_coupon->recurring_amount->type : null) == 'percent') {
                            $this->_('AdminMain.service.text_coupon_percent', false, $this->Html->safe((isset($recurring_coupon->code) ? $recurring_coupon->code : null)), $this->CurrencyFormat->cast((isset($recurring_coupon->recurring_amount->amount) ? $recurring_coupon->recurring_amount->amount : null), (isset($recurring_coupon->recurring_amount->currency) ? $recurring_coupon->recurring_amount->currency : null)));
                        } else {
                            $this->_('AdminMain.service.text_coupon_amount', false, $this->Html->safe((isset($recurring_coupon->code) ? $recurring_coupon->code : null)), $this->CurrencyFormat->format((isset($recurring_coupon->recurring_amount->amount) ? $recurring_coupon->recurring_amount->amount : null), (isset($recurring_coupon->recurring_amount->currency) ? $recurring_coupon->recurring_amount->currency : null)));
                        }
                        ?>
                    </div>
                    <?php
                    }

                    if ((isset($service->package_pricing->period) ? $service->package_pricing->period : null) != 'onetime') {
                    ?>
                    <div class="col-md-6">
                        <strong><?php $this->_('AdminMain.service.text_renewal_price');?></strong>
                        <?php echo $this->CurrencyFormat->format((isset($service->renewal_price) ? $service->renewal_price : null), (isset($service->override_currency) ? $service->override_currency : (isset($service->package_pricing->currency) ? $service->package_pricing->currency : null)));?>
                    </div>
                    <?php
                    }
                    ?>
                </div>
            </div>

            <div class="card-body">
                <h6 class="form-section-header mb-3"><i class="bi bi-tags"></i> <?php $this->_('AdminMain.service.heading_pricing');?></h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <?php
                        $this->Form->label($this->_('AdminMain.service.field_pricing', true), 'pricing_id', ['class' => 'form-label']);
                        $this->Form->fieldSelect('pricing_id', (isset($terms) ? $terms : []), (isset($vars->pricing_id) ? $vars->pricing_id : null), ['id' => 'pricing_id', 'class' => 'form-select']);
                        ?>
                    </div>
                    <div class="col-md-6">
                        <?php
                        $this->Form->label($this->_('AdminMain.service.field_group', true), 'package_group_id', ['class' => 'form-label']);
                        $this->Form->fieldSelect('package_group_id', (isset($package_groups) ? $package_groups : []), (isset($vars->package_group_id) ? $vars->package_group_id : null), ['id' => 'package_group_id', 'class' => 'form-select']);
                        ?>
                    </div>
                </div>
            </div>
            <?php $this->Widget->footer(); ?>
            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-outline-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/reassign_pricing/admin_main/index/' . (isset($client->id) ? $client->id : null));?>"><?php $this->_('AdminMain.service.field_cancel');?></a>
                <?php
                $this->Form->fieldSubmit('save', $this->_('AdminMain.service.field_submit', true), ['class' => 'btn btn-primary']);
                ?>
            </div>
            <?php
            $this->Form->end();
            ?>
        <?php
        $this->Widget->end();

        $this->Javascript->setInline("
        document.addEventListener('DOMContentLoaded', function() {
            var pricingSelect = document.getElementById('pricing_id');
            if (pricingSelect) {
                pricingSelect.addEventListener('change', function() {
                    var url = '" . $this->Html->safe($this->base_uri . 'plugin/reassign_pricing/admin_main/getPackageGroups/') . (isset($client->id) ? $client->id : null) . "/' + this.value;
                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(function(response) {
                        return response.json();
                    })
                    .then(function(data) {
                        if (data.groups) {
                            var groupSelect = document.getElementById('package_group_id');
                            groupSelect.innerHTML = '';
                            for (var key in data.groups) {
                                var option = document.createElement('option');
                                option.value = key;
                                option.textContent = data.groups[key];
                                groupSelect.appendChild(option);
                            }
                        }
                    });
                });
            }
        });
        ");
        ?>
