
        <?php
        $link_buttons = [
            [
                'icon' => 'bi bi-plus-lg',
                'name' => '',
                'attributes' => [
                    'title' => $this->_('AdminMain.settings.add_feed', true),
                    'href' => $this->base_uri . 'widget/feed_reader/admin_main/add/',
                    'class' => 'ajax'
                ]
            ]
        ];

        $this->Widget->clear();
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->setWidgetButton('arrow');
        $this->Widget->setWidgetButton(['href'=>$this->base_uri . 'widget/feed_reader/admin_main/settings/', 'class'=>'ajax setting']);
        $this->Widget->create($this->_('AdminMain.index.boxtitle_feed', true), ['id'=>'feed_reader_main_settings'], (isset($render_section) ? $render_section : null));

        if (($num_feeds = count((isset($feeds) ? $feeds : []))) > 0) {
        ?>
            <table class="table table-striped mb-3">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminMain.settings.heading_url');?></th>
                        <th><?php $this->_('AdminMain.settings.heading_lastupdated');?></th>
                        <th class="text-end"><?php $this->_('AdminMain.settings.heading_options');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    for ($i = 0; $i < $num_feeds; $i++) {
                    ?>
                    <tr>
                        <td>
                            <a href="<?php echo (isset($feeds[$i]->url) ? $this->Html->safe($feeds[$i]->url) : null);?>" target="_blank"><?php echo (isset($feeds[$i]->url) ? $this->Html->safe($feeds[$i]->url) : null);?></a>
                        </td>
                        <td><?php echo $this->Date->cast((isset($feeds[$i]->updated) ? $this->Html->safe($feeds[$i]->updated) : null), 'date_time');?></td>
                        <td class="text-end">
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'widget/feed_reader/admin_main/refresh/?feed_id=' . (isset($feeds[$i]->id) ? $feeds[$i]->id : null));?>" class="btn btn-sm btn-primary ajax" title="<?php $this->_('AdminMain.settings.option_refresh');?>"><i class="bi bi-arrow-clockwise"></i></a>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'widget/feed_reader/admin_main/remove/?feed_id=' . (isset($feeds[$i]->id) ? $feeds[$i]->id : null));?>" class="btn btn-sm btn-danger manage ajax" title="<?php $this->_('AdminMain.settings.option_remove');?>"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
        <?php
        } else {
        ?>
            <div class="text-center p-4">
                <p class="text-muted mb-0"><?php $this->_('AdminMain.settings.no_feeds');?></p>
            </div>
        <?php
        }
        ?>

        <div class="d-flex justify-content-end">
            <a class="btn btn-outline-secondary ajax" href="<?php echo $this->Html->safe($this->base_uri . 'widget/feed_reader/admin_main/index/1/');?>"><?php $this->_('AdminMain.settings.submit_cancel');?></a>
        </div>
        <?php
        $this->Widget->end();
        ?>