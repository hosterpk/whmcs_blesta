
        <?php
        $this->Widget->clear();
        $this->Widget->setStyleSheet($this->view_dir . 'css/styles.css');
        $this->Widget->setWidgetButton('widget-width');
        $this->Widget->setWidgetButton('arrow');
        $this->Widget->setWidgetButton(['href'=>$this->base_uri . 'widget/feed_reader/admin_main/settings/', 'class'=>'ajax setting']);
        $this->Widget->create($this->_('AdminMain.index.boxtitle_feed', true), ['id'=>'widget_feed_reader_admin_main' . (($billing ?? 'false') == 'true' ? '_billing' : '')], (isset($render_section) ? $render_section : null));
        ?>
        <?php
        if (($num_articles = count(($articles ?? []))) > 0) {
        ?>
            <?php
            for ($i=0; $i<$num_articles; $i++) {
            ?>
                <div class="feed-item">
                    <div class="feed-item-date">
                        <i class="bi bi-calendar3 me-1"></i>
                        <?php echo $this->Date->cast(($articles[$i]->date ?? null), 'date');?>
                    </div>
                    <h6 class="feed-item-title">
                        <a href="<?php echo ($articles[$i]->data['link'] ?? null);?>" target="_blank" class="text-decoration-none">
                            <?php echo ($articles[$i]->data['title'] ?? null);?>
                            <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                        </a>
                    </h6>
                    <p class="feed-item-summary">
                        <?php echo \Illuminate\Support\Str::of($articles[$i]->data['description'] ?? null)->stripTags();?>
                    </p>
                </div>
            <?php
            }
            ?>
            <div class="feed-item text-small">
                <?php
                if (($last_updated ?? null)) {
                    $this->_('AdminMain.index.last_updated', false, $this->Date->cast($last_updated, 'date_time'));
                }
                ?>
            </div>
            <div class="text-center">
                <nav aria-label="Feed pagination">
                    <ul class="pagination pagination-sm mb-0 justify-content-center">
                        <?php
                        if (($total_pages ?? null) > 1) {
                        ?>
                            <?php
                            if (($page ?? null) > 1) {
                            ?>
                            <li class="page-item">
                                <a class="page-link ajax override" href="<?php echo $this->Html->safe($this->base_uri . 'widget/feed_reader/admin_main/index/' . ($page-1) . '/');?>">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <?php
                            }
                            ?>
                            <li class="page-item active">
                                <a class="page-link" href="#">
                                    <span><?php echo ($page ?? 1);?></span>
                                    <?php
                                    if (($total_pages ?? null) > 1) {
                                    ?>
                                    <span class="d-none d-sm-inline"> / <?php echo ($total_pages ?? 1);?></span>
                                    <?php
                                    }
                                    ?>
                                </a>
                            </li>
                            <?php
                            if (($page ?? null) < (isset($total_pages) ? $total_pages : null)) {
                            ?>
                            <li class="page-item">
                                <a class="page-link ajax override" href="<?php echo $this->Html->safe($this->base_uri . 'widget/feed_reader/admin_main/index/' . ($page+1) . '/');?>">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        <?php
                            }
                        }
                        ?>
                    </ul>
                </nav>
            </div>
        <?php
        } else {
        ?>
        <div class="text-center p-4">
            <div class="text-muted"><?php $this->_('AdminMain.index.no_results');?></div>
        </div>
        <?php
        }
        $this->Widget->end();
        ?>