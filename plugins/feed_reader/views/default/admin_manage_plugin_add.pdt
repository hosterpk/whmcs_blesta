
        <?php
        $this->Widget->clear();
        $this->Widget->create($this->_('FeedReaderManagePlugin.add.boxtitle_feed', true));

        $this->Form->create();
        ?>
        <div class="mb-3">
            <?php $this->Form->label($this->_('FeedReaderPlugin.add.field_url', true), 'url', ['class' => 'form-label']);?>
            <?php $this->Form->fieldText('url', '', ['class' => 'form-control', 'id' => 'url', 'placeholder' => $this->_('FeedReaderPlugin.add.field_url', true)]);?>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <?php
            $this->Form->fieldSubmit('save', $this->_('FeedReaderPlugin.add.submit_add', true), ['class' => 'btn btn-primary']);
            ?>
            <a class="btn btn-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/plugins/manage/' . (isset($plugin_id) ? $plugin_id : null));?>/"><?php $this->_('FeedReaderPlugin.add.submit_cancel');?></a>
        </div>
        <?php
        $this->Form->end();
        $this->Widget->end();
        ?>