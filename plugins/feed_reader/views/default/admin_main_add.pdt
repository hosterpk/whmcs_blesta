
        <?php
        $this->Widget->clear();
        $this->Widget->create($this->_('AdminMain.add.boxtitle_feed', true), ['id'=>'feed_reader_main_add'], (isset($render_section) ? $render_section : null));

        $this->Form->create();
        ?>
        <div class="mb-3">
            <?php $this->Form->label($this->_('AdminMain.add.field_url', true), 'url', ['class' => 'form-label']);?>
            <?php $this->Form->fieldText('url', '', ['class' => 'form-control', 'id' => 'url', 'placeholder' => $this->_('AdminMain.add.field_url', true)]);?>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <?php
            $this->Form->fieldSubmit('save', $this->_('AdminMain.add.submit_add', true), ['class' => 'btn btn-primary']);
            ?>
            <a class="btn btn-secondary ajax" href="<?php echo $this->Html->safe($this->base_uri . 'widget/feed_reader/admin_main/settings/');?>"><?php $this->_('AdminMain.add.submit_cancel');?></a>
        </div>
        <?php
        $this->Form->end();
        $this->Widget->end();
        ?>