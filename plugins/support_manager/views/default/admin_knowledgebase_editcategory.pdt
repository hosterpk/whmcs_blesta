
        <?php
        echo (isset($message) ? $message : null);

        $this->Widget->clear();
        $this->Widget->create($this->_('AdminKnowledgebase.editcategory.boxtitle_editcategory', true));

        $this->Form->create(null, ['class' => 'disable-on-submit']);
        ?>
                <div class="mb-3">
                    <label class="form-label" for="name"><?php $this->_('AdminKnowledgebase.editcategory.field_name');?></label>
                    <?php $this->Form->fieldText('name', (isset($vars->name) ? $vars->name : null), ['id'=>'name', 'class'=>'form-control']);?>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="parent_id"><?php $this->_('AdminKnowledgebase.editcategory.field_parent_id');?></label>
                    <?php $this->Form->fieldSelect('parent_id', (isset($categories) ? $categories : null), (isset($vars->parent_id) ? $vars->parent_id : null), ['id'=>'parent_id', 'class'=>'form-select']);?>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="access">
                        <?php $this->_('AdminKnowledgebase.editcategory.field_access');?>
                        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="<?php echo $this->Html->safe($this->_('AdminKnowledgebase.!tooltip.access_category', true));?>"></i>
                    </label>
                    <?php $this->Form->fieldSelect('access', (isset($access_types) ? $access_types : null), (isset($vars->access) ? $vars->access : null), ['id'=>'access', 'class'=>'form-select']);?>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <?php $this->Form->fieldCheckbox('update_articles', '1', (isset($vars->update_articles) ? $vars->update_articles : null) == '1', ['id' => 'update_articles', 'class' => 'form-check-input']);?>
                        <label class="form-check-label" for="update_articles"><?php $this->_('AdminKnowledgebase.editcategory.field_update_articles');?></label>
                    </div>
                </div>
                <div class="mb-3" style="display: none">
                    <div class="form-check">
                        <?php $this->Form->fieldCheckbox('update_recursive', '1', (isset($vars->update_articles) ? $vars->update_articles : null) == '1', ['id' => 'update_recursive', 'class' => 'form-check-input']);?>
                        <label class="form-check-label" for="update_recursive"><?php $this->_('AdminKnowledgebase.editcategory.field_update_recursive');?></label>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="description"><?php $this->_('AdminKnowledgebase.editcategory.field_description');?></label>
                    <?php $this->Form->fieldTextarea('description', (isset($vars->description) ? $vars->description : null), ['id'=>'description', 'data-markdown-editor' => '']);?>
                </div>
            </div><!-- end card-body -->
            <div class="card-footer d-flex justify-content-end gap-2">
                <a class="btn btn-outline-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_knowledgebase/index/' . ((isset($category) ? $category : null) ? (isset($category->parent_id) ? $category->parent_id : null) . '/' : ''));?>"><?php $this->_('AdminKnowledgebase.editcategory.submit_cancel');?></a>
                <?php
                $this->Form->fieldSubmit('save', $this->_('AdminKnowledgebase.editcategory.submit_edit', true), ['class' => 'btn btn-primary']);
                ?>
            </div>
        </div><!-- end card-content -->
        <?php
        $this->Form->end();
        ?></section>

        <script type="text/javascript">
            $(document).ready(function () {
                if ($('#update_articles').is(':checked')) {
                    $('#update_recursive').parent().show();
                } else {
                    $('#update_recursive').parent().hide();
                }

                $('#update_articles').on('change', function () {
                    if ($(this).is(':checked')) {
                        $('#update_recursive').parent().show();
                    } else {
                        $('#update_recursive').parent().hide();
                    }
                });
            });
        </script>