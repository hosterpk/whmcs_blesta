
        <?php
        $links = [
            ['name' => $this->_('AdminTickets.client.category_open', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['open']) ? $this->Html->safe($status_count['open']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'open' ? true : false), 'attributes' => ['href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/open/'), 'class' => 'ajax']],
            ['name' => $this->_('AdminTickets.client.category_awaiting_reply', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['awaiting_reply']) ? $this->Html->safe($status_count['awaiting_reply']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'awaiting_reply' ? true : false), 'attributes' => ['href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/awaiting_reply/'), 'class' => 'ajax']],
            ['name' => $this->_('AdminTickets.client.category_in_progress', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['in_progress']) ? $this->Html->safe($status_count['in_progress']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'in_progress' ? true : false), 'attributes' => ['href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/in_progress/'), 'class' => 'ajax']],
            ['name' => $this->_('AdminTickets.client.category_on_hold', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['on_hold']) ? $this->Html->safe($status_count['on_hold']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'on_hold' ? true : false), 'attributes' => ['href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/on_hold/'), 'class' => 'ajax']],
            ['name' => $this->_('AdminTickets.client.category_closed', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['closed']) ? $this->Html->safe($status_count['closed']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'closed' ? true : false), 'attributes' => ['href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/closed/'), 'class' => 'ajax']],
            ['name' => $this->_('AdminTickets.client.category_trash', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['trash']) ? $this->Html->safe($status_count['trash']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'trash' ? true : false), 'attributes' => ['href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/trash/'), 'class' => 'ajax']]
        ];
        $link_buttons = [
            [
                'icon' => 'bi bi-plus-lg',
                'name' => '',
                'attributes' => [
                    'title' => $this->_('AdminTickets.client.categorylink_createticket', true),
                    'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/add/' . (isset($client->id) ? $client->id : null) . '/')
                ]
            ]
        ];

        $this->Widget->clear();
        $this->Widget->setLinks($links);
        $this->Widget->setNavStyle('nav-tabs-custom');
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->setFilters($filters, $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $this->Html->safe($client->id) : null) . '/' . (isset($status) ? $this->Html->safe($status) : null)), !empty($filter_vars));
        $this->Widget->setAjaxFiltering();
        $this->Widget->setWidgetButton('arrow');
        $this->Widget->setBadgeUri($this->base_uri . 'plugin/support_manager/admin_tickets/clientticketcount/' . (isset($client->id) ? $this->Html->safe($client->id) : null) . '/' . (isset($status) ? $this->Html->safe($status) : null));
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTickets.client.boxtitle_tickets', true), ['id'=>'plugin_support_manager_admin_tickets_client'], (isset($render_section) ? $render_section : null));

        if ((isset($tickets) ? $tickets : false) && ($num_tickets = count($tickets)) > 0) {
        ?>
        <div class="table-responsive">
        <table class="table table-hover mb-0" id="tickets">
            <thead>
            <tr>
                <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/' . (isset($status) ? $status : null) . '/?sort=code&order=' . ($sort == 'code' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'code' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.client.heading_code');?><?php if ($sort == 'code') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/' . (isset($status) ? $status : null) . '/?sort=priority&order=' . ($sort == 'priority' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'priority' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.client.heading_priority');?><?php if ($sort == 'priority') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/' . (isset($status) ? $status : null) . '/?sort=department_name&order=' . ($sort == 'department_name' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'department_name' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.client.heading_department_name');?><?php if ($sort == 'department_name') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                <th><?php $this->_('AdminTickets.client.heading_summary');?></th>
                <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/client/' . (isset($client->id) ? $client->id : null) . '/' . (isset($status) ? $status : null) . '/?sort=last_reply_date&order=' . ($sort == 'last_reply_date' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'last_reply_date' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.client.heading_last_reply_date');?><?php if ($sort == 'last_reply_date') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
            </tr>
            </thead>
            <tbody>
            <?php
            // Display all tickets
            $i = 0;
            foreach ($tickets as $ticket) {
                $highlight = !empty($staff_id) && (($ticket->staff_id ?? null) == $staff_id);
                $odd_row = ($i++%2 == 1);
                $tr_class = $this->Html->concat(' ', ($highlight ? 'highlight' : ''), ($odd_row ? 'odd_row' : ''));
            ?>
            <tr<?php echo (!empty($tr_class) ? ' class="' . $tr_class . '"' : '');?>>
                <td><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/reply/' . (isset($ticket->id) ? $ticket->id : null) . '/');?>"><?php echo (isset($ticket->code) ? $this->Html->safe($ticket->code) : null);?></a></td>
                <td><?php echo (isset($priorities[$ticket->priority]) ? $priorities[$ticket->priority] : null);?></td>
                <td><?php echo (isset($ticket->department_name) ? $this->Html->safe($ticket->department_name) : null);?></td>
                <td>
                <?php
                    $summary = $string->truncate((isset($ticket->summary) ? $ticket->summary : null), ['word_length' => Configure::get('SupportManager.summary_truncate_length')]);
                    echo (isset($summary) ? $this->Html->safe($summary) : null) . ($summary != (isset($ticket->summary) ? $ticket->summary : null) ? '...' : '');
                ?>
                </td>
                <td><?php echo (isset($ticket->last_reply_time) ? $this->Html->safe($ticket->last_reply_time) : null);?></td>
            </tr>
            <?php
            }
            unset($i);
            ?>
            </tbody>
        </table>
        </div>
        <?php
            // Set pagination in card-footer
            if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        ?>
        <div class="card-footer">
            <?php $this->Pagination->build(); ?>
        </div>
        <?php
            }
        } else {
        ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminTickets.client.no_results');?></p>
        </div>
        <?php
        }

        $this->Widget->end();
