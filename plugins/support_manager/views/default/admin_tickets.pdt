            </div>
        </div>
        <?php
            // Set pagination in card-footer
            if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        ?>
        <div class="card-footer">
            <?php $this->Pagination->build(); ?>
        </div>
        <?php
            }
        } else {
        ?>
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
            <p class="mt-3 mb-0"><?php $this->_('AdminTickets.index.no_results');?></p>
        </div>
        <?php
        }

        $this->Form->end();
        ?>
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function() {
                // Fullscreen toggle functionality
                var fullscreenBtn = document.querySelector('#admin_tickets .widget-controls a.full_screen');
                if (fullscreenBtn) {
                    // Add icon if not present
                    if (!fullscreenBtn.querySelector('i')) {
                        fullscreenBtn.innerHTML = '<i class="bi bi-arrows-fullscreen"></i>';
                    }

                    // Toggle fullscreen function
                    var toggleFullscreen = function(btn) {
                        var card = btn.closest('.card, section.card');
                        var icon = btn.querySelector('i');

                        if (card) {
                            var isFullscreen = card.classList.contains('fullscreen-mode');

                            if (isFullscreen) {
                                // Exit fullscreen
                                card.classList.remove('fullscreen-mode');
                                if (icon) {
                                    icon.classList.remove('bi-fullscreen-exit');
                                    icon.classList.add('bi-arrows-fullscreen');
                                }
                                btn.setAttribute('title', '<?php echo $this->Html->safe($this->_('AdminTickets.index.text_fullscreen', true)); ?>');
                            } else {
                                // Enter fullscreen
                                card.classList.add('fullscreen-mode');
                                if (icon) {
                                    icon.classList.remove('bi-arrows-fullscreen');
                                    icon.classList.add('bi-fullscreen-exit');
                                }
                                btn.setAttribute('title', '<?php echo $this->Html->safe($this->_('AdminTickets.index.text_exit_fullscreen', true)); ?>');
                            }
                        }
                    };

                    // Add click handler for fullscreen toggle
                    fullscreenBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        toggleFullscreen(this);
                    });

                    // ESC key to exit fullscreen
                    document.addEventListener('keydown', function(e) {
                        if (e.key === 'Escape') {
                            var card = fullscreenBtn.closest('.card, section.card');
                            if (card && card.classList.contains('fullscreen-mode')) {
                                toggleFullscreen(fullscreenBtn);
                            }
                        }
                    });
                }

                // Clear old interval before ever starting a new one
                if (window.support_manager_ticket_time) {
                    clearInterval(window.support_manager_ticket_time);
                }

                <?php
                if ((isset($page) ? $page : null) == '1' && (isset($sort) ? $sort : null) == 'last_reply_date') {
                ?>
                // Refresh
                window.support_manager_ticket_time = startUpdateTimer();
                <?php
                }
                ?>

                // Stop refresh timer when clicking ajax links
                document.querySelectorAll('#tickets .ajax').forEach(function(el) {
                    el.addEventListener('click', function() {
                        stopUpdateTimer(window.support_manager_ticket_time);
                    });
                });

                // Checkbox select all functionality using event delegation
                // This ensures handlers work for AJAX-loaded content
                var widget = document.getElementById('admin_tickets');
                if (widget && !widget._ticketCheckboxHandlerBound) {
                    widget._ticketCheckboxHandlerBound = true;
                    widget.addEventListener('change', function(e) {
                        if (!e.target.classList.contains('tickets')) return;

                        var ticketsAll = document.getElementById('tickets_all');
                        var ticketActions = document.getElementById('ticket_actions');

                        if (e.target.value === 'all') {
                            var isChecked = ticketsAll.checked;
                            document.querySelectorAll('.tickets').forEach(function(cb) {
                                cb.checked = isChecked;
                            });
                        }

                        var checkedCount = document.querySelectorAll('.tickets:checked').length;
                        // Subtract 1 if "select all" is checked (it's included in the count)
                        if (ticketsAll && ticketsAll.checked) checkedCount--;

                        if (checkedCount > 0) {
                            stopUpdateTimer(window.support_manager_ticket_time);
                            if (ticketActions) {
                                ticketActions.style.display = 'block';
                                setTicketAction(); // Initialize action fields when bar becomes visible
                                initTicketAutocomplete(); // Initialize autocomplete for merge/reassign fields
                            }
                        } else {
                            if (window.support_manager_ticket_time) {
                                clearInterval(window.support_manager_ticket_time);
                                window.support_manager_ticket_time = startUpdateTimer();
                            }
                            if (ticketActions) ticketActions.style.display = 'none';
                        }
                    });
                }

                // Ticket action select handler using event delegation
                setTicketAction();
                if (widget && !widget._ticketActionHandlerBound) {
                    widget._ticketActionHandlerBound = true;
                    widget.addEventListener('change', function(e) {
                        if (e.target.id === 'ticket_action') {
                            setTicketAction();
                        }
                    });
                }

                // Initialize autocomplete widgets
                initTicketAutocomplete();
            });

            // Autocomplete initialization function (called on load and after AJAX updates)
            function initTicketAutocomplete() {
                var ticketNumberField = document.getElementById('ticket_number');
                var clientField = document.getElementById('client');
                var csrfToken = document.querySelector('#tickets input[name=_csrf_token]');

                // Use jQuery UI autocomplete if available, otherwise use vanilla JS
                if (typeof $ !== 'undefined' && $.fn.autocomplete) {
                    var $ticketNumberField = $('#ticket_actions #ticket_number');
                    var $clientField = $('#ticket_actions #client');

                    if ($ticketNumberField.length && !$ticketNumberField.data('ui-autocomplete')) {
                        $ticketNumberField.autocomplete({
                            minLength: 3,
                            appendTo: ".with_ticket",
                            position: { my: "left bottom", at: "left top"},
                            source: function(request, response) {
                                $(document).blestaRequest('POST', '<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/searchbycode/');?>',
                                    { _csrf_token: $('#tickets').find('input[name=_csrf_token]').val(), search: request.term},
                                    function(data) {
                                        if (data && data.tickets) {
                                            var tickets = [];
                                            for (var id in data.tickets)
                                                tickets.push({label:data.tickets[id], value:data.tickets[id], id:id});
                                            response(tickets);

                                            if (tickets.length === 0)
                                                document.getElementById('no_tickets').style.display = 'block';
                                            else
                                                document.getElementById('no_tickets').style.display = 'none';
                                        }
                                    },
                                    null,
                                    {dataType:'json'}
                                );
                            },
                            select: function(event, ui) {
                                document.getElementById('ticket_id').value = ui.item.id;
                            }
                        });
                    }

                    if ($clientField.length && !$clientField.data('ui-autocomplete')) {
                        $clientField.autocomplete({
                            minLength: 3,
                            appendTo: ".reassign",
                            position: { my: "left bottom", at: "left top"},
                            source: function(request, response) {
                                $(document).blestaRequest('POST', '<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getclients/');?>',
                                    { _csrf_token: $('#tickets').find('input[name=_csrf_token]').val(), search: request.term},
                                    function(data) {
                                        if (data && data.clients) {
                                            var clients = [];
                                            for (var id in data.clients)
                                                clients.push({label:data.clients[id], value:data.clients[id], id:id});
                                            response(clients);

                                            if (clients.length === 0)
                                                document.getElementById('no_clients').style.display = 'block';
                                            else
                                                document.getElementById('no_clients').style.display = 'none';
                                        }
                                    },
                                    null,
                                    {dataType:'json'}
                                );
                            },
                            select: function(event, ui) {
                                document.getElementById('client_id').value = ui.item.id;
                            }
                        });
                    }
                } else {
                    // Vanilla JS autocomplete fallback
                    if (ticketNumberField && !ticketNumberField._autocompleteInit) {
                        ticketNumberField._autocompleteInit = true;
                        setupVanillaAutocomplete(ticketNumberField, {
                            minLength: 3,
                            container: document.querySelector('.with_ticket'),
                            noResultsEl: document.getElementById('no_tickets'),
                            hiddenField: document.getElementById('ticket_id'),
                            searchUrl: '<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/searchbycode/');?>',
                            csrfToken: csrfToken ? csrfToken.value : '',
                            dataKey: 'tickets'
                        });
                    }

                    if (clientField && !clientField._autocompleteInit) {
                        clientField._autocompleteInit = true;
                        setupVanillaAutocomplete(clientField, {
                            minLength: 3,
                            container: document.querySelector('.reassign'),
                            noResultsEl: document.getElementById('no_clients'),
                            hiddenField: document.getElementById('client_id'),
                            searchUrl: '<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getclients/');?>',
                            csrfToken: csrfToken ? csrfToken.value : '',
                            dataKey: 'clients'
                        });
                    }
                }
            }

            // Vanilla JS autocomplete implementation
            function setupVanillaAutocomplete(input, options) {
                var dropdown = document.createElement('ul');
                dropdown.className = 'autocomplete-dropdown position-absolute';

                // Insert dropdown after input
                input.parentNode.style.position = 'relative';
                input.parentNode.appendChild(dropdown);

                var debounceTimer;
                input.addEventListener('input', function() {
                    var term = this.value.trim();
                    clearTimeout(debounceTimer);

                    if (term.length < options.minLength) {
                        dropdown.style.display = 'none';
                        if (options.noResultsEl) options.noResultsEl.style.display = 'none';
                        return;
                    }

                    debounceTimer = setTimeout(function() {
                        var formData = new FormData();
                        formData.append('_csrf_token', options.csrfToken);
                        formData.append('search', term);

                        fetch(options.searchUrl, {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        })
                        .then(function(response) { return response.json(); })
                        .then(function(data) {
                            dropdown.innerHTML = '';
                            var items = data[options.dataKey] || {};
                            var hasResults = false;

                            for (var id in items) {
                                hasResults = true;
                                var li = document.createElement('li');
                                li.textContent = items[id];
                                li.dataset.id = id;
                                li.dataset.value = items[id];
                                dropdown.appendChild(li);
                            }

                            if (hasResults) {
                                dropdown.style.display = 'block';
                                if (options.noResultsEl) options.noResultsEl.style.display = 'none';
                            } else {
                                dropdown.style.display = 'none';
                                if (options.noResultsEl) options.noResultsEl.style.display = 'block';
                            }
                        })
                        .catch(function() {
                            dropdown.style.display = 'none';
                        });
                    }, 300);
                });

                // Handle selection
                dropdown.addEventListener('click', function(e) {
                    var li = e.target.closest('li');
                    if (li) {
                        input.value = li.dataset.value;
                        if (options.hiddenField) options.hiddenField.value = li.dataset.id;
                        dropdown.style.display = 'none';
                    }
                });

                // Hide dropdown on outside click
                document.addEventListener('click', function(e) {
                    if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.style.display = 'none';
                    }
                });

                // Keyboard navigation
                input.addEventListener('keydown', function(e) {
                    var items = dropdown.querySelectorAll('li');
                    var active = dropdown.querySelector('li.active');
                    var index = active ? Array.from(items).indexOf(active) : -1;

                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        if (active) active.classList.remove('active');
                        index = (index + 1) % items.length;
                        if (items[index]) items[index].classList.add('active');
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        if (active) active.classList.remove('active');
                        index = index <= 0 ? items.length - 1 : index - 1;
                        if (items[index]) items[index].classList.add('active');
                    } else if (e.key === 'Enter' && active) {
                        e.preventDefault();
                        active.click();
                    } else if (e.key === 'Escape') {
                        dropdown.style.display = 'none';
                    }
                });
            }

            function startUpdateTimer() {
                return setTimeout(function() {
                    // Don't refresh if tickets are selected for bulk action
                    if (document.querySelectorAll('.tickets:checked').length > 0) {
                        return;
                    }

                    var filterData = getTicketFilterData();
                    var widgetUrl = getActiveTicketStatusUrl();

                    blestaRequest("POST", widgetUrl, filterData,
                        function(data) {
                            // Don't update DOM if user selected tickets while request was in flight
                            if (document.querySelectorAll('.tickets:checked').length > 0) {
                                return;
                            }

                            var adminTickets = document.getElementById('admin_tickets');
                            if (data.replacer == null) {
                                adminTickets.innerHTML = data.content;
                            } else {
                                var replacer = adminTickets.querySelector(data.replacer);
                                if (replacer) {
                                    replacer.innerHTML = data.content;
                                }
                            }
                            // Reinitialize components after AJAX update
                            setTicketAction();
                            initTicketAutocomplete();
                            // Restart the timer for the next refresh cycle
                            window.support_manager_ticket_time = startUpdateTimer();
                        },
                        null,
                        {dataType: 'json'}
                    );
                }, 30000);
            }

            function stopUpdateTimer(timer) {
                clearTimeout(timer);
            }

            function setTicketAction() {
                document.querySelectorAll('.ticket_action').forEach(function(el) {
                    el.style.display = 'none';
                });

                var action = "<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/')?>";
                var ticketActionSelect = document.getElementById('ticket_action');
                var actionValue = ticketActionSelect ? ticketActionSelect.value : '';

                switch (actionValue) {
                    case "merge":
                        document.querySelector('.with_ticket').style.display = 'block';
                        action += 'action/';
                        break;
                    case "update_status":
                        document.querySelector('.update_status').style.display = 'block';
                        action += 'action/';
                        break;
                    case "reassign":
                        document.querySelector('.reassign').style.display = 'block';
                        action += 'action/';
                        break;
                    case 'delete':
                        action += 'delete/';
                        break;
                    default:
                        break;
                }

                var ticketsForm = document.getElementById('tickets');
                if (ticketsForm) ticketsForm.action = action;
            }
        </script>
        <?php
        $this->Widget->end();

        if ((isset($set_ticket_time) ? $set_ticket_time : null)) {
        ?>
        <script type="text/javascript">
            // Create global ticket_time interval so we can clear before starting a new one
            var support_manager_ticket_time;

            // Bind GUI events using Blesta's core functionality if available
            if (typeof $ !== 'undefined' && $.fn.blestaBindGuiEvents) {
                $("#admin_tickets").blestaBindGuiEvents();
            }

            // Reinitialize components after AJAX tab switching
            if (typeof $ !== 'undefined') {
                $(document).on('ajaxComplete', function(event, xhr, settings) {
                    // Only handle AJAX requests targeting the admin_tickets widget
                    if (settings.url && settings.url.indexOf('plugin/support_manager/admin_tickets') !== -1) {
                        setTimeout(function() {
                            setTicketAction();
                            initTicketAutocomplete();
                        }, 100);
                    }
                });
            }

            // Sidebar filter handling via event delegation
            // (sidebar renders after main content in the DOM)
            document.addEventListener('submit', function(e) {
                if (e.target.id === 'ticket_filters') {
                    e.preventDefault();
                    applyTicketFilters();
                }
            });

            document.addEventListener('click', function(e) {
                if (e.target.closest('#clear_filters')) {
                    var form = document.getElementById('ticket_filters');
                    if (form) {
                        form.querySelectorAll('input[type="text"]').forEach(function(el) { el.value = ''; });
                        form.querySelectorAll('select').forEach(function(el) { el.selectedIndex = 0; });
                        applyTicketFilters();
                    }
                }
            });

            function getTicketFilterData() {
                var filterForm = document.getElementById('ticket_filters');
                var data = filterForm ? Object.fromEntries(new FormData(filterForm)) : {};

                // Include CSRF token from the tickets form
                var csrfInput = document.querySelector('#tickets input[name="_csrf_token"]');
                if (csrfInput) {
                    data['_csrf_token'] = csrfInput.value;
                }

                return data;
            }

            function getActiveTicketStatusUrl() {
                // Read the current active tab URL to handle tab switches
                var activeTab = document.querySelector('#admin_tickets .nav-tabs-custom .nav-link.active, #admin_tickets .nav-tabs-custom li a[class*="active"]');
                if (activeTab && activeTab.href) {
                    return activeTab.href;
                }
                return '<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/index/' . (isset($status) ? $status : 'open') . '/');?>';
            }

            function applyTicketFilters() {
                var filterData = getTicketFilterData();
                var widgetUrl = getActiveTicketStatusUrl();

                blestaRequest('POST', widgetUrl, filterData,
                    function(data) {
                        var adminTickets = document.getElementById('admin_tickets');
                        if (data.replacer == null) {
                            adminTickets.innerHTML = data.content;
                        } else {
                            var replacer = adminTickets.querySelector(data.replacer);
                            if (replacer) {
                                replacer.innerHTML = data.content;
                            }
                        }
                        setTicketAction();
                        initTicketAutocomplete();
                    },
                    null,
                    {dataType: 'json'}
                );
            }
        </script>
        <?php
        }
