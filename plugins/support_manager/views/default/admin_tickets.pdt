            ['name' => $this->_('AdminTickets.index.category_awaiting_reply', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['awaiting_reply']) ? $this->Html->safe($status_count['awaiting_reply']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'awaiting_reply' ? true : false), 'attributes' => ['href' => $this->base_uri . 'plugin/support_manager/admin_tickets/index/awaiting_reply/', 'class' => 'ajax']],
            ['name' => $this->_('AdminTickets.index.category_in_progress', true) . ' <span class="badge bg-secondary ms-2">' . (isset($status_count['in_progress']) ? $this->Html->safe($status_count['in_progress']) : '0') . '</span>', 'current' => ((isset($status) ? $status : null) == 'in_progress' ? true : false), 'attributes' => ['href' => $this->base_uri . 'plugin/support_manager/admin_tickets/index/in_progress/', 'class' => 'ajax']],
