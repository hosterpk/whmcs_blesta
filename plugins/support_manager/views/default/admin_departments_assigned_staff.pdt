
            <div>
                <h6 class="fw-bold mb-3"><?php $this->_('AdminDepartments.assigned_staff.heading_assigned_staff');?></h6>
                <?php
                if ((isset($staff) ? $staff : false) && ($num_staff = count($staff)) > 0) {
                ?>
                <table class="table table-hover mb-0">
                    <thead>
                    <tr>
                        <th><?php $this->_('AdminDepartments.assigned_staff.heading_staff');?></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php
                    // Display all staff
                    foreach ($staff as $member) {
                    ?>
                    <tr>
                        <td><?php echo $this->Html->concat(' ', (isset($member->first_name) ? $this->Html->safe($member->first_name) : null), (isset($member->last_name) ? $this->Html->safe($member->last_name) : null));?></td>
                    </tr>
                    <?php
                    }
                    ?>
                    </tbody>
                </table>
                <?php
                } else {
                ?>
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-people" style="font-size: 2rem; opacity: 0.3;"></i>
                    <p class="mt-2 mb-0 small"><?php $this->_('AdminDepartments.assigned_staff.no_results');?></p>
                </div>
                <?php
                }
                ?>
            </div>
