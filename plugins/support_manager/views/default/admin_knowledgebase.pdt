
        <?php
        echo (isset($message) ? $message : null);

        // Build link buttons for the filter bar
        $link_buttons = [];

        // Back button (only when inside a category)
        if (!empty($current_category)) {
            $link_buttons[] = [
                'icon' => 'bi bi-arrow-left',
                'name' => $this->_('AdminKnowledgebase.index.go_back', true),
                'attributes' => [
                    'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_knowledgebase/index/' . (empty($current_category->parent_id) ? '' : (isset($current_category->parent_id) ? $current_category->parent_id : null) . '/')),
                    'class' => 'btn-back'
                ]
            ];
        }

        // Add Category button
        $link_buttons[] = [
            'icon' => 'bi bi-folder-plus',
            'name' => $this->_('AdminKnowledgebase.index.add_category', true),
            'attributes' => [
                'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_knowledgebase/addcategory/' . (!empty($current_category) ? (isset($current_category->id) ? $current_category->id : null) . '/' : '')),
                'title' => $this->_('AdminKnowledgebase.index.add_category', true)
            ]
        ];

        // Add Article button
        $link_buttons[] = [
            'icon' => 'bi bi-plus-lg',
            'name' => $this->_('AdminKnowledgebase.index.add_article', true),
            'attributes' => [
                'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_knowledgebase/add/' . (!empty($current_category) ? (isset($current_category->id) ? $current_category->id : null) . '/' : '')),
                'title' => $this->_('AdminKnowledgebase.index.add_article', true)
            ]
        ];

        $this->Widget->clear();
        $this->Widget->setStyleSheet($this->view_dir . 'css/support.css', ['id' => 'support_manager_styles']);
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->create($this->_('AdminKnowledgebase.index.boxtitle_knowledgebase', true));

        // Display the listing
        echo (isset($article_list) ? $article_list : null);

        $this->Widget->end();
