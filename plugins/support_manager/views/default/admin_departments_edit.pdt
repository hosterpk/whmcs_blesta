                    <div class="card-footer d-flex justify-content-end">
                        <?php
                        $this->Form->fieldSubmit('save', $this->_('AdminDepartments.edit.field_addsubmit', true), ['class' => 'btn btn-primary']);
                        ?>
                    </div>
                </div><!-- end card-content -->
                <?php
                $this->Form->end();
                ?></section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Bootstrap tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
        new bootstrap.Tooltip(el);
    });

    // ===== TAB SWITCHING =====
    var departmentTabs = document.querySelectorAll('.card-content .department_tab');
    departmentTabs.forEach(function(tab) { tab.style.display = 'none'; });
    var activeTab = document.querySelector('.card-content #tab_<?php echo ($tab ?? 'general');?>');
    if (activeTab) activeTab.style.display = '';

    document.querySelectorAll('.card-filter-bar .nav .nav-link').forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            var classes = this.className.split(' ').filter(function(c) {
                return c && c !== 'nav-link' && c !== 'active' && c !== 'text-danger';
            });
            var tab = classes[0];

            document.querySelectorAll('.card-filter-bar .nav .nav-link').forEach(function(l) {
                l.classList.remove('active');
            });
            this.classList.add('active');

            departmentTabs.forEach(function(t) { t.style.display = 'none'; });
            var targetTab = document.querySelector('.card-content #tab_' + tab);
            if (targetTab) targetTab.style.display = '';
        });
    });

    // ===== PREDEFINED RESPONSE HANDLING =====
    var selectedResponse = document.getElementById('selected_response');
    var noSelectedResponse = document.getElementById('no_selected_response');
    var removeResponse = document.getElementById('remove_response');

    function updateResponseDisplay() {
        if (selectedResponse && selectedResponse.textContent.trim() === '') {
            if (noSelectedResponse) noSelectedResponse.style.display = '';
            if (removeResponse) removeResponse.style.display = 'none';
        } else {
            if (noSelectedResponse) noSelectedResponse.style.display = 'none';
            if (removeResponse) removeResponse.style.display = '';
        }
    }
    updateResponseDisplay();

    if (removeResponse) {
        removeResponse.addEventListener('click', function(e) {
            e.preventDefault();
            if (selectedResponse) selectedResponse.textContent = '';
            var responseId = document.getElementById('response_id');
            if (responseId) responseId.value = '';
            updateResponseDisplay();
        });
    }

    // Load responses when dropdown opens
    var addPredefinedBtn = document.getElementById('add_predefined_response');
    if (addPredefinedBtn) {
        addPredefinedBtn.addEventListener('shown.bs.dropdown', function() {
            isSearchMode = false;
            originalResponsesContent = null;
            setPredefinedResponses(null);
            var searchInput = document.getElementById('response_search_input');
            if (searchInput) {
                searchInput.value = '';
                searchInput.focus();
            }
        });
    }

    // Predefined responses - search functionality with server-side search
    var responseSearchInput = document.getElementById('response_search_input');
    var searchDebounceTimer = null;
    var isSearchMode = false;
    var originalResponsesContent = null;

    if (responseSearchInput) {
        responseSearchInput.addEventListener('input', function() {
            var searchTerm = this.value.trim();
            var responsesList = document.getElementById('predefined_responses');

            if (searchDebounceTimer) {
                clearTimeout(searchDebounceTimer);
            }

            // If search is empty or less than 2 chars, restore navigation mode
            if (searchTerm.length < 2) {
                if (isSearchMode && originalResponsesContent !== null) {
                    fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/getresponselisting/');?>', {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (data) responsesList.innerHTML = data;
                    });
                    isSearchMode = false;
                    originalResponsesContent = null;
                }
                return;
            }

            // Debounce the search (300ms)
            searchDebounceTimer = setTimeout(function() {
                if (!isSearchMode) {
                    originalResponsesContent = responsesList.innerHTML;
                    isSearchMode = true;
                }

                // Show loading state
                responsesList.innerHTML = '<div class="predefined-responses-loading"><div class="spinner-border spinner-border-sm" role="status"></div><div class="predefined-responses-loading-text"><?php $this->_('AdminDepartments.!text.searching');?></div></div>';

                fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/searchresponses/');?>?q=' + encodeURIComponent(searchTerm), {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data && data.results) {
                        if (data.results.length === 0) {
                            responsesList.innerHTML = '<div class="predefined-responses-no-results"><i class="bi bi-search"></i><div>No matching responses found</div></div>';
                        } else {
                            var html = '';
                            data.results.forEach(function(result) {
                                html += '<div class="predefined-response-item predefined-response-search-result" data-response-id="' + escapeHtml(result.id) + '">';
                                html += '<div class="response-main"><i class="bi bi-chat-left-text"></i> ' + escapeHtml(result.name) + '</div>';
                                if (result.category_path) {
                                    html += '<div class="response-category-path"><i class="bi bi-folder2"></i> ' + escapeHtml(result.category_path) + '</div>';
                                }
                                html += '</div>';
                            });
                            responsesList.innerHTML = html;
                        }
                    }
                })
                .catch(function() {
                    responsesList.innerHTML = '<div class="predefined-responses-no-results"><i class="bi bi-search"></i><div>No matching responses found</div></div>';
                });
            }, 300);
        });
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Response category and item clicks (delegated)
    document.addEventListener('click', function(e) {
        var categoryEl = e.target.closest('#predefined_responses .predefined-response-category[data-category-id]');
        if (categoryEl) {
            e.preventDefault();
            var catId = categoryEl.getAttribute('data-category-id');
            setPredefinedResponses(catId || null);
        }

        var responseEl = e.target.closest('#predefined_responses .predefined-response-item[data-response-id]');
        if (responseEl) {
            e.preventDefault();
            var responseId = responseEl.getAttribute('data-response-id');
            if (responseId) setPredefinedResponse(responseId);
        }
    });

    // ===== POP3/IMAP/OAUTH FIELDS =====
    var methodRadios = document.querySelectorAll('input[name="method"]');
    if (methodRadios.length) {
        showPop3Fields();
        methodRadios.forEach(function(radio) {
            radio.addEventListener('change', showPop3Fields);
        });
    }

    // ===== PIPING CONFIG SELECT =====
    var pipingConfig = document.getElementById('piping_config');
    if (pipingConfig) {
        pipingConfig.addEventListener('focus', function() { this.select(); });
    }

    // ===== CAPTCHA TOGGLE =====
    var clientsOnly = document.getElementById('clients_only');
    if (clientsOnly) {
        function toggleCaptcha() {
            var requireCaptcha = document.querySelector('.require_captcha');
            if (requireCaptcha) {
                requireCaptcha.style.display = clientsOnly.checked ? 'none' : '';
                var input = requireCaptcha.querySelector('input');
                if (input) input.disabled = clientsOnly.checked;
            }
        }
        clientsOnly.addEventListener('change', toggleCaptcha);
        toggleCaptcha();
    }

    // ===== ATTACHMENT SETTINGS TOGGLE =====
    var includeAttachments = document.getElementById('include_attachments');
    if (includeAttachments) {
        function toggleAttachments() {
            document.querySelectorAll('.attachment_settings').forEach(function(el) {
                el.style.display = includeAttachments.checked ? '' : 'none';
                el.querySelectorAll('input').forEach(function(input) {
                    input.disabled = !includeAttachments.checked;
                });
            });
        }
        includeAttachments.addEventListener('change', toggleAttachments);
        toggleAttachments();
    }

    // ===== CUSTOM FIELDS MANAGEMENT =====
    var customFieldsBody = document.getElementById('custom_fields_body');
    var fieldsEmptySection = document.getElementById('fields_empty_section');
    var fieldsTableWrapper = document.getElementById('custom_fields_table_wrapper');
    var fieldTemplate = document.getElementById('custom_field_template');
    var addFieldBtn = document.getElementById('add_custom_field');
    var deleteFieldModal = document.getElementById('deleteFieldModal');
    var deleteFieldBsModal = deleteFieldModal ? new bootstrap.Modal(deleteFieldModal) : null;
    var fieldRowToDelete = null;

    function updateEmptyState() {
        var fieldRows = customFieldsBody ? customFieldsBody.querySelectorAll('tr[data-field-id]') : [];
        if (fieldsEmptySection) {
            fieldsEmptySection.style.display = fieldRows.length === 0 ? '' : 'none';
        }
        if (fieldsTableWrapper) {
            fieldsTableWrapper.style.display = fieldRows.length === 0 ? 'none' : '';
        }
    }

    function updateFieldIndices() {
        if (!customFieldsBody) return;
        var fieldRows = customFieldsBody.querySelectorAll('tr[data-field-id]');
        fieldRows.forEach(function(row, index) {
            row.setAttribute('data-field-id', index);

            var expandableRow = row.nextElementSibling;
            if (expandableRow && expandableRow.classList.contains('collapse')) {
                expandableRow.id = 'field-options-' + index;
            }

            // Update checkbox IDs and labels
            row.querySelectorAll('[id^="client_add_"], [id^="required_"], [id^="encrypted_"], [id^="auto_delete_"]').forEach(function(el) {
                var baseName = el.id.replace(/_\d+$/, '');
                el.id = baseName + '_' + index;
            });
            row.querySelectorAll('label[for^="client_add_"], label[for^="required_"], label[for^="encrypted_"], label[for^="auto_delete_"]').forEach(function(el) {
                var baseName = el.getAttribute('for').replace(/_\d+$/, '');
                el.setAttribute('for', baseName + '_' + index);
            });

            // Update radio button names for options
            if (expandableRow) {
                expandableRow.querySelectorAll('.options-container .fields_options_default').forEach(function(radio) {
                    radio.name = 'fields[options][' + index + '][default][]';
                });
            }
        });
    }

    function handleFieldTypeChange(row) {
        var typeSelect = row.querySelector('.fields_type');
        if (!typeSelect) return;

        var type = typeSelect.value;
        var expandableRow = row.nextElementSibling;

        if (expandableRow && expandableRow.classList.contains('collapse')) {
            var content = expandableRow.querySelector('.field-options-content');
            if (content) {
                var quantityRow = content.querySelector('.quantity-options-row');
                var optionsRow = content.querySelector('.field-options-row');

                if (quantityRow) {
                    quantityRow.style.display = type === 'quantity' ? '' : 'none';
                }
                if (optionsRow) {
                    optionsRow.style.display = (type === 'select' || type === 'radio') ? '' : 'none';
                }
            }

            var collapse = bootstrap.Collapse.getOrCreateInstance(expandableRow, { toggle: false });
            if (type === 'quantity' || type === 'select' || type === 'radio') {
                collapse.show();
            } else {
                collapse.hide();
            }
        }

        // Emergency field handling
        if (type === 'emergency') {
            var visibilitySelect = row.querySelector('.fields_visibility');
            if (visibilitySelect) {
                visibilitySelect.value = 'client_only';
                visibilitySelect.disabled = true;
            }
            var clientAddCheckbox = row.querySelector('.client_add');
            if (clientAddCheckbox) {
                clientAddCheckbox.checked = true;
                clientAddCheckbox.disabled = true;
            }

            var emergencyCount = 0;
            customFieldsBody.querySelectorAll('.fields_type').forEach(function(sel) {
                if (sel.value === 'emergency') emergencyCount++;
            });
            if (emergencyCount > 1) {
                alert('<?php echo str_replace("'", "\\'", $this->_('AdminDepartments.add.text_emergency_field', true));?>');
                typeSelect.value = 'text';
                if (visibilitySelect) visibilitySelect.disabled = false;
                if (clientAddCheckbox) {
                    clientAddCheckbox.checked = false;
                    clientAddCheckbox.disabled = false;
                }
            }
        } else {
            var visibilitySelect = row.querySelector('.fields_visibility');
            if (visibilitySelect) visibilitySelect.disabled = false;
        }
    }

    function handleVisibilityChange(row) {
        var visibilitySelect = row.querySelector('.fields_visibility');
        var clientAddCheckbox = row.querySelector('.client_add');
        if (!visibilitySelect || !clientAddCheckbox) return;

        if (visibilitySelect.value === 'staff') {
            clientAddCheckbox.disabled = true;
            clientAddCheckbox.checked = false;
        } else if (visibilitySelect.value === 'client_only') {
            clientAddCheckbox.disabled = true;
            clientAddCheckbox.checked = true;
        } else {
            clientAddCheckbox.disabled = false;
        }
    }

    function initializeFieldRow(row) {
        var typeSelect = row.querySelector('.fields_type');
        if (typeSelect) {
            typeSelect.addEventListener('change', function() {
                handleFieldTypeChange(row);
            });
            handleFieldTypeChange(row);
        }

        var visibilitySelect = row.querySelector('.fields_visibility');
        if (visibilitySelect) {
            visibilitySelect.addEventListener('change', function() {
                handleVisibilityChange(row);
            });
            handleVisibilityChange(row);
        }

        // Initialize tooltips
        row.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
            new bootstrap.Tooltip(el);
        });
        var expandableRow = row.nextElementSibling;
        if (expandableRow && expandableRow.classList.contains('collapse')) {
            expandableRow.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
                new bootstrap.Tooltip(el);
            });
        }
    }

    // Add field button
    if (addFieldBtn && fieldTemplate && customFieldsBody) {
        addFieldBtn.addEventListener('click', function() {
            var clone = fieldTemplate.content.cloneNode(true);
            var fieldRow = clone.querySelector('tr[data-field-id]');
            customFieldsBody.appendChild(clone);
            initializeFieldRow(fieldRow);
            updateEmptyState();
            updateFieldIndices();
        });
    }

    // Delete field with modal confirmation
    if (deleteFieldModal) {
        document.getElementById('confirm_delete_field').addEventListener('click', function() {
            if (fieldRowToDelete) {
                var expandableRow = fieldRowToDelete.nextElementSibling;
                if (expandableRow && expandableRow.classList.contains('collapse')) {
                    expandableRow.remove();
                }
                fieldRowToDelete.remove();
                fieldRowToDelete = null;
                updateEmptyState();
                updateFieldIndices();
            }
            deleteFieldBsModal.hide();
        });
    }

    // Delegated event handlers on tbody
    if (customFieldsBody) {
        customFieldsBody.addEventListener('click', function(e) {
            // Delete button
            var removeBtn = e.target.closest('.remove-field-btn');
            if (removeBtn) {
                fieldRowToDelete = removeBtn.closest('tr[data-field-id]');
                if (deleteFieldBsModal) {
                    deleteFieldBsModal.show();
                }
                return;
            }

            // Add option button
            var addOptionBtn = e.target.closest('.add-option-btn');
            if (addOptionBtn) {
                var optionsContainer = addOptionBtn.previousElementSibling;
                if (optionsContainer && optionsContainer.classList.contains('options-container')) {
                    var firstOption = optionsContainer.querySelector('.option-row');
                    if (firstOption) {
                        var newOption = firstOption.cloneNode(true);
                        newOption.querySelectorAll('input[type="text"]').forEach(function(input) {
                            input.value = '';
                        });
                        newOption.querySelectorAll('input[type="radio"]').forEach(function(radio) {
                            radio.checked = false;
                        });
                        optionsContainer.appendChild(newOption);
                        updateFieldIndices();
                    }
                }
                return;
            }

            // Remove option button
            var removeOptionBtn = e.target.closest('.remove-option-btn');
            if (removeOptionBtn) {
                var optionRow = removeOptionBtn.closest('.option-row');
                var optionsContainer = optionRow ? optionRow.parentElement : null;
                if (optionsContainer && optionsContainer.querySelectorAll('.option-row').length > 1) {
                    optionRow.remove();
                    updateFieldIndices();
                }
                return;
            }

            // Row click to toggle expandable row
            var fieldRow = e.target.closest('tr[data-field-id]');
            if (fieldRow && !e.target.closest('input, select, textarea, button, label')) {
                var typeSelect = fieldRow.querySelector('.fields_type');
                if (typeSelect) {
                    var type = typeSelect.value;
                    if (type === 'quantity' || type === 'select' || type === 'radio') {
                        var expandableRow = fieldRow.nextElementSibling;
                        if (expandableRow && expandableRow.classList.contains('collapse')) {
                            var collapse = bootstrap.Collapse.getOrCreateInstance(expandableRow);
                            collapse.toggle();
                        }
                    }
                }
            }
        });
    }

    // Initialize Sortable
    if (customFieldsBody && typeof Sortable !== 'undefined') {
        Sortable.create(customFieldsBody, {
            animation: 150,
            handle: '.sortable-drag-handle',
            draggable: 'tr[data-field-id]',
            ghostClass: 'sortable-ghost',
            onEnd: function() {
                var fieldRows = customFieldsBody.querySelectorAll('tr[data-field-id]');
                fieldRows.forEach(function(row) {
                    var fieldId = row.getAttribute('data-field-id');
                    var expandableRow = document.getElementById('field-options-' + fieldId);
                    if (expandableRow) {
                        row.after(expandableRow);
                    }
                });
                updateFieldIndices();
            }
        });
    }

    // Initialize existing field rows
    if (customFieldsBody) {
        customFieldsBody.querySelectorAll('tr[data-field-id]').forEach(initializeFieldRow);
    }

    // ===== FORM SUBMIT HANDLING =====
    var departmentForm = document.getElementById('department');
    if (departmentForm) {
        departmentForm.addEventListener('submit', function() {
            updateFieldIndices();

            // Handle unchecked checkboxes - add hidden fields with 0 value
            this.querySelectorAll('#custom_fields_body tr[data-field-id] input[type="checkbox"]:not(:checked)').forEach(function(checkbox) {
                if (checkbox.name && !checkbox.disabled) {
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = checkbox.name;
                    hidden.value = '0';
                    checkbox.parentElement.appendChild(hidden);
                    checkbox.disabled = true;
                }
            });
        });
    }

    // ===== FORCE IMPORT TEST =====
    var forceImportBtn = document.querySelector('.force_import');
    if (forceImportBtn && departmentForm) {
        forceImportBtn.addEventListener('click', function(e) {
            e.preventDefault();
            var formData = new FormData(departmentForm);

            fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/importtest/' . ($department->id ?? null) . '/');?>', {
                method: 'POST',
                body: new URLSearchParams(formData),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(function(response) { return response.text(); })
            .then(function(data) {
                var errorSection = document.querySelector('.main-content-padding .error_section');
                if (errorSection) errorSection.remove();
                var mainContent = document.querySelector('.main-content-padding');
                if (mainContent) {
                    mainContent.insertAdjacentHTML('afterbegin', data);
                }
            });
        });
    }
});

// ===== HELPER FUNCTIONS =====
function showPop3Fields() {
    var methodChecked = document.querySelector('input[name="method"]:checked');
    if (!methodChecked) return;

    var pop3Fields = document.getElementById('pop3_fields');
    var oauthFields = document.getElementById('oauth_fields');
    var piping = document.getElementById('piping');
    var val = methodChecked.value;

    if (pop3Fields) {
        pop3Fields.style.display = (val === 'pop3' || val === 'imap') ? '' : 'none';
        pop3Fields.querySelectorAll('input, select').forEach(function(el) {
            el.disabled = !(val === 'pop3' || val === 'imap');
        });
    }

    if (oauthFields) {
        oauthFields.style.display = val === 'oauth2' ? '' : 'none';
        oauthFields.querySelectorAll('input, select').forEach(function(el) {
            el.disabled = val !== 'oauth2';
        });
    }

    if (piping) {
        piping.style.display = val === 'pipe' ? '' : 'none';
    }
}

function setPredefinedResponse(responseId) {
    fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/getresponse/');?>' + responseId, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data) {
            document.getElementById('response_id').value = data.id;
            document.getElementById('selected_response').textContent = data.name;
            document.getElementById('no_selected_response').style.display = 'none';
            document.getElementById('remove_response').style.display = '';

            // Close the dropdown
            var dropdownBtn = document.getElementById('add_predefined_response');
            if (dropdownBtn) {
                var dropdown = bootstrap.Dropdown.getInstance(dropdownBtn);
                if (dropdown) dropdown.hide();
            }
        }
    });
}

function setPredefinedResponses(categoryId) {
    var url = '<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/getresponselisting/');?>' + (categoryId || '');
    fetch(url, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data) {
            document.getElementById('predefined_responses').innerHTML = data;
        }
    });
}
</script>
<?php
