                            <?php
                            $fields = [];
                            foreach ($vars->fields as $j => $field) {
                                foreach ((array)$field as $key => $value) {
                                    $fields[$key][$j] = $value;
                                }
                            }
                            $vars->fields = $fields;

                            $rows = 0;
                            if ($vars->fields['label'] ?? false) {
                                $rows = count($vars->fields['label']);
                            }
                            ?>

