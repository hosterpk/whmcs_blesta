
                <?php
                echo (isset($message) ? $message : null);

                $this->Widget->clear();
                $this->Widget->setStyleSheet($this->view_dir . 'css/support.css', ['id' => 'support_manager_styles']);
                $this->Widget->create($this->_('AdminTickets.add.boxtitle_add', true, (isset($ticket->code) ? $ticket->code : null)), ['id' => 'admin_tickets_add']);

                $this->Form->create(null, ['id' => 'create_ticket', 'enctype' => 'multipart/form-data', 'class' => 'disable-on-submit']);
                ?>
                    <div class="mb-4">
                        <label class="form-label" for="summary"><?php $this->_('AdminTickets.add.heading_summary');?></label>
                        <?php $this->Form->fieldText('summary', (isset($vars->summary) ? $vars->summary : null), ['id' => 'summary', 'class' => 'form-control']);?>
                    </div>

                    <!-- Predefined Responses Dropdown -->
                    <div class="mb-3">
                        <div class="d-flex gap-2 flex-wrap">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="predefinedResponsesBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    <i class="bi bi-chat-square-text me-1"></i>
                                    <?php $this->_('AdminTickets.add.text_add_response');?>
                                    <span class="ms-2 badge bg-secondary">Ctrl+Shift+R</span>
                                </button>
                                <div class="dropdown-menu predefined-responses-dropdown" aria-labelledby="predefinedResponsesBtn">
                                    <!-- Search Box -->
                                    <div class="predefined-responses-search">
                                        <input type="text" class="form-control form-control-sm" id="responseSearchInput" placeholder="<?php $this->_('AdminTickets.add.search_responses');?>" autocomplete="off">
                                    </div>

                                    <!-- Response List -->
                                    <div class="predefined-responses-list" id="responsesList">
                                        <?php echo (isset($predefined_responses) ? $predefined_responses : null);?>
                                    </div>

                                    <!-- No Results Message -->
                                    <div class="predefined-responses-no-results" id="noResultsMessage" style="display: none;">
                                        <i class="bi bi-search"></i>
                                        <div><?php $this->_('AdminTickets.add.no_results');?></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                        <div class="mb-3">
                            <?php
                            $staff_signature = '';
                            if (!empty($staff_settings['signature'])) {
                                $staff_signature = "\n\n" . (isset($staff_settings['signature']) ? $staff_settings['signature'] : null);
                            }
                            $this->Form->fieldTextarea('details', (isset($vars->details) ? $vars->details : $staff_signature), ['id' => 'details', 'rows' => 21, 'data-markdown-editor' => '', 'data-image-upload-url' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/uploadimage/')]);
                            ?>
                            <?php $this->Form->fieldHidden('inline_image_temp_ids', '', ['id' => 'inline_image_temp_ids']);?>
                            <div class="form-text mt-2"><?php $this->_('AdminTickets.add.markdown_supported');?></div>
                        </div>

                        <!-- Compact File Upload Zone -->
                        <div class="file-upload-compact mb-3" id="fileDropZone">
                            <?php $this->Form->fieldFile('attachment[]', ['id' => 'ticketFileInput', 'class' => 'drag-drop', 'rel' => $this->_('AppController.dropzone.text', true), 'style' => 'display:none;', 'multiple' => 'multiple']);?>
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-cloud-upload upload-icon"></i>
                                <div class="flex-grow-1">
                                    <div class="upload-text"><?php $this->_('AdminTickets.add.dropzone_drop_files');?></div>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('ticketFileInput').click()">
                                    <?php $this->_('AdminTickets.add.browse_files');?>
                                </button>
                            </div>
                        </div>
                        <div id="fileList" class="mb-3"></div>
                        <div id="custom_fields"><?php echo $department_fields ?? '';?></div>
                    </div><!-- end card-body -->
                    <div class="card-footer d-flex justify-content-end">
                        <?php
                        $this->Form->fieldSubmit('save', $this->_('AdminTickets.add.field_addsubmit', true), ['class' => 'btn btn-primary']);
                        ?>
                    </div>
                </div><!-- end card-content -->
                <?php
                $this->Form->end();
                ?></section>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var departmentSelect = document.getElementById('department_id');
    var prioritySelect = document.getElementById('priority');
    var staffSelect = document.getElementById('ticket_staff_id');
    var serviceContainer = document.getElementById('service_id_container');
    var serviceSelect = document.getElementById('service_id');
    var clientInput = document.getElementById('client');
    var clientIdInput = document.getElementById('client_id');
    var contactsList = document.getElementById('contacts_list');
    var customFields = document.getElementById('custom_fields');
    var csrfToken = document.querySelector('#create_ticket input[name=_csrf_token]');

    // Set the markdown editor mode based on staff preference
    var editorMode = '<?php echo (isset($staff_settings['markdown_editor_mode']) ? $this->Html->safe($staff_settings['markdown_editor_mode']) : 'wysiwyg');?>';

    // Apply mode to editor after it's initialized
    setTimeout(function() {
        var detailsTextarea = document.getElementById('details');
        if (detailsTextarea) {
            // Find the editor div (next sibling after textarea)
            var editorDiv = detailsTextarea.nextElementSibling;
            while (editorDiv && !editorDiv._editor) {
                editorDiv = editorDiv.nextElementSibling;
            }
            if (editorDiv && editorDiv._editor) {
                var editor = editorDiv._editor;
                // Default to WYSIWYG mode without split screen
                if (editorMode === 'wysiwyg') {
                    editor.changeMode('wysiwyg');
                    editor.changePreviewStyle('tab');
                    editorDiv._previewVisible = false;
                } else if (editorMode === 'markdown_no_preview') {
                    editor.changeMode('markdown');
                    editor.changePreviewStyle('tab');
                    editorDiv._previewVisible = false;
                } else if (editorMode === 'markdown') {
                    editor.changeMode('markdown');
                    editor.changePreviewStyle('vertical');
                    editorDiv._previewVisible = true;
                }
            }
        }
    }, 500);

    // Department change handler
    if (departmentSelect) {
        departmentSelect.addEventListener('change', function() {
            setDepartmentFields();
        });

        // Trigger on page load if department is already selected
        if (departmentSelect.value) {
            setDepartmentFields();
        }
    }

    // Keyboard shortcut for predefined responses (Ctrl+Shift+R)
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'R') {
            e.preventDefault();
            var predefinedBtn = document.getElementById('predefinedResponsesBtn');
            if (predefinedBtn) {
                var dropdown = bootstrap.Dropdown.getOrCreateInstance(predefinedBtn);
                dropdown.toggle();
                setTimeout(function() {
                    var searchInput = document.getElementById('responseSearchInput');
                    if (searchInput) {
                        searchInput.focus();
                    }
                }, 100);
            }
        }
    });

    // Predefined responses - search functionality with server-side global search
    var searchInput = document.getElementById('responseSearchInput');
    var searchDebounceTimer = null;
    var isSearchMode = false;
    var originalResponsesContent = null;

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            var searchTerm = this.value.trim();
            var responsesList = document.getElementById('responsesList');
            var noResults = document.getElementById('noResultsMessage');

            // Clear any pending search
            if (searchDebounceTimer) {
                clearTimeout(searchDebounceTimer);
            }

            // If search is empty or less than 2 chars, restore navigation mode
            if (searchTerm.length < 2) {
                if (noResults) noResults.style.display = 'none';

                if (isSearchMode && originalResponsesContent !== null) {
                    // Restore original content and reset to root
                    fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getresponselisting/');?>', {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (data) {
                            responsesList.innerHTML = data;
                            selectedResponseIndex = -1;
                        }
                    });
                    isSearchMode = false;
                    originalResponsesContent = null;
                }
                return;
            }

            // Debounce the search (300ms)
            searchDebounceTimer = setTimeout(function() {
                // Save original content if not in search mode
                if (!isSearchMode) {
                    originalResponsesContent = responsesList.innerHTML;
                    isSearchMode = true;
                }

                // Show loading state
                responsesList.innerHTML = '<div class="predefined-responses-loading"><div class="spinner-border spinner-border-sm" role="status"></div><div class="predefined-responses-loading-text"><?php $this->_('AdminTickets.add.searching');?></div></div>';
                if (noResults) noResults.style.display = 'none';

                // Perform server-side search
                fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/searchresponses/');?>?q=' + encodeURIComponent(searchTerm), {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data && data.results) {
                        if (data.results.length === 0) {
                            // No results found
                            responsesList.innerHTML = '';
                            if (noResults) noResults.style.display = 'flex';
                        } else {
                            // Build search results HTML
                            var html = '';
                            data.results.forEach(function(result) {
                                html += '<div class="predefined-response-item predefined-response-search-result" data-response-id="' + result.id + '">';
                                html += '<div class="response-main"><i class="bi bi-chat-left-text"></i> ' + escapeHtml(result.name) + '</div>';
                                if (result.category_path) {
                                    html += '<div class="response-category-path"><i class="bi bi-folder2"></i> ' + escapeHtml(result.category_path) + '</div>';
                                }
                                html += '</div>';
                            });
                            responsesList.innerHTML = html;
                            if (noResults) noResults.style.display = 'none';
                        }
                        // Reset keyboard selection after search results change
                        selectedResponseIndex = -1;
                    }
                })
                .catch(function(error) {
                    console.error('Search error:', error);
                    responsesList.innerHTML = '';
                    if (noResults) noResults.style.display = 'flex';
                    selectedResponseIndex = -1;
                });
            }, 300);
        });
    }

    // Helper function to escape HTML
    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Keyboard navigation for predefined responses
    var selectedResponseIndex = -1;

    if (searchInput) {
        searchInput.addEventListener('keydown', function(e) {
            var responsesList = document.getElementById('responsesList');
            var items = responsesList.querySelectorAll('.predefined-response-item, .predefined-response-category');
            var visibleItems = Array.from(items).filter(function(item) {
                return item.style.display !== 'none';
            });

            if (visibleItems.length === 0) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                selectedResponseIndex = Math.min(selectedResponseIndex + 1, visibleItems.length - 1);
                updateResponseSelection(visibleItems);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                selectedResponseIndex = Math.max(selectedResponseIndex - 1, 0);
                updateResponseSelection(visibleItems);
            } else if (e.key === 'Enter' && selectedResponseIndex >= 0) {
                e.preventDefault();
                var selectedItem = visibleItems[selectedResponseIndex];
                if (selectedItem) {
                    selectedItem.click();
                }
            } else if (e.key === 'Escape') {
                var dropdown = bootstrap.Dropdown.getInstance(document.getElementById('predefinedResponsesBtn'));
                if (dropdown) dropdown.hide();
            }
        });
    }

    function updateResponseSelection(items) {
        // Remove selection from all items
        items.forEach(function(item) {
            item.classList.remove('keyboard-selected');
        });
        // Add selection to current item
        if (selectedResponseIndex >= 0 && selectedResponseIndex < items.length) {
            items[selectedResponseIndex].classList.add('keyboard-selected');
            items[selectedResponseIndex].scrollIntoView({ block: 'nearest' });
        }
    }

    // Reset selection when dropdown opens or search changes
    var predefinedBtn = document.getElementById('predefinedResponsesBtn');
    if (predefinedBtn) {
        predefinedBtn.addEventListener('shown.bs.dropdown', function() {
            selectedResponseIndex = -1;
            var items = document.querySelectorAll('#responsesList .predefined-response-item, #responsesList .predefined-response-category');
            items.forEach(function(item) {
                item.classList.remove('keyboard-selected');
            });
        });
    }

    // Predefined responses - insert response
    document.addEventListener('click', function(e) {
        var responseItem = e.target.closest('.predefined-response-item');
        if (responseItem) {
            var responseId = responseItem.getAttribute('data-response-id');
            if (responseId) {
                fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getresponse/');?>' + responseId, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data) {
                        var textarea = document.getElementById('details');
                        if (textarea && textarea.nextElementSibling && textarea.nextElementSibling._editor) {
                            var editor = textarea.nextElementSibling._editor;
                            editor.insertText(data + '\n');
                        }
                    }

                    // Close dropdown
                    var dropdown = bootstrap.Dropdown.getInstance(document.getElementById('predefinedResponsesBtn'));
                    if (dropdown) dropdown.hide();
                });
            }
        }
    });

    // Predefined responses - category navigation
    document.addEventListener('click', function(e) {
        var categoryLink = e.target.closest('.predefined-response-category[data-category-id]');
        if (categoryLink) {
            e.preventDefault();
            var categoryId = categoryLink.getAttribute('data-category-id');

            fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getresponselisting/');?>' + categoryId, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data) {
                    document.getElementById('responsesList').innerHTML = data;
                    // Clear search and hide no results message after navigation
                    var searchInput = document.getElementById('responseSearchInput');
                    var noResults = document.getElementById('noResultsMessage');
                    if (searchInput) searchInput.value = '';
                    if (noResults) noResults.style.display = 'none';
                    // Reset search mode and keyboard selection
                    isSearchMode = false;
                    originalResponsesContent = null;
                    selectedResponseIndex = -1;
                }
            });
        }
    });

    // Event delegation for recipients (in sidebar)
    document.addEventListener('click', function(e) {
        // Add recipient
        if (e.target.closest('.add_recipient')) {
            e.preventDefault();
            var container = document.getElementById('recipients_container');
            if (container) {
                var recipients = container.querySelectorAll('.recipient');
                if (recipients.length >= 5) return;

                var firstRecipient = container.querySelector('.recipient');
                if (firstRecipient) {
                    var clone = firstRecipient.cloneNode(true);
                    var input = clone.querySelector('input');
                    if (input) input.value = '';
                    container.appendChild(clone);
                }
            }
        }

        // Remove recipient
        if (e.target.closest('.remove_recipient')) {
            e.preventDefault();
            var container = document.getElementById('recipients_container');
            if (container) {
                var recipients = container.querySelectorAll('.recipient');
                if (recipients.length <= 1) return;
                e.target.closest('.recipient').remove();
            }
        }
    });

    // Client autocomplete
    if (clientInput) {
        var debounceTimer;
        var resultsContainer = document.getElementById('client_autocomplete_results');
        var noClientsMsg = document.getElementById('no_clients');

        clientInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            var query = this.value;

            if (query.length < 3) {
                if (resultsContainer) resultsContainer.innerHTML = '';
                if (resultsContainer) resultsContainer.style.display = 'none';
                return;
            }

            debounceTimer = setTimeout(function() {
                var formData = '_csrf_token=' + encodeURIComponent(csrfToken ? csrfToken.value : '') + '&search=' + encodeURIComponent(query);

                fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getclients/');?>', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data && data.clients) {
                        var html = '';
                        var hasResults = false;
                        for (var id in data.clients) {
                            hasResults = true;
                            html += '<div class="list-group-item" data-id="' + id + '">' + data.clients[id] + '</div>';
                        }

                        if (resultsContainer) {
                            resultsContainer.innerHTML = html;
                            resultsContainer.style.display = hasResults ? 'block' : 'none';
                        }

                        if (noClientsMsg) {
                            noClientsMsg.style.display = hasResults ? 'none' : 'block';
                        }

                        // Handle clicks on autocomplete results
                        if (resultsContainer) {
                            resultsContainer.querySelectorAll('.list-group-item').forEach(function(item) {
                                item.addEventListener('click', function() {
                                    clientInput.value = this.textContent;
                                    clientIdInput.value = this.getAttribute('data-id');
                                    resultsContainer.style.display = 'none';
                                    fetchContacts();
                                    setDepartmentFields();
                                });
                            });
                        }
                    }
                })
                .catch(function(error) {
                    console.error('Error:', error);
                });
            }, 300);
        });

        // Hide autocomplete when clicking outside
        document.addEventListener('click', function(e) {
            if (resultsContainer && !clientInput.contains(e.target) && !resultsContainer.contains(e.target)) {
                resultsContainer.style.display = 'none';
            }
        });
    }

    // Form submit handler
    var createTicketForm = document.getElementById('create_ticket');
    if (createTicketForm) {
        createTicketForm.addEventListener('submit', function() {
            // Submit unchecked checkboxes (except contacts)
            var checkboxes = this.querySelectorAll('input[type="checkbox"]:not(:checked)');
            checkboxes.forEach(function(checkbox) {
                if (!checkbox.closest('#contacts_list')) {
                    checkbox.disabled = true;
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = checkbox.name;
                    hidden.value = '0';
                    checkbox.parentNode.appendChild(hidden);
                }
            });
        });
    }

    // Fetch priorities for department
    function setDepartmentPriorities(departmentId) {
        fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getpriorities/');?>' + departmentId, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data && data.priorities && prioritySelect) {
                prioritySelect.innerHTML = '';
                var defaultPriority = data.default_priority || '';

                for (var value in data.priorities) {
                    var option = new Option(data.priorities[value], value);
                    if (defaultPriority == value) {
                        option.selected = true;
                    }
                    prioritySelect.add(option);
                }
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
        });
    }

    // Fetch department fields (staff, custom fields, services)
    function setDepartmentFields() {
        var departmentId = departmentSelect ? departmentSelect.value : '';
        if (!departmentId) return;

        setDepartmentPriorities(departmentId);

        var clientId = clientIdInput ? clientIdInput.value : '';
        fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getdepartmentstaff/');?>' + departmentId + '?client_id=' + encodeURIComponent(clientId), {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data) {
                // Update staff dropdown
                if (data.department_staff && staffSelect) {
                    staffSelect.innerHTML = '';
                    for (var value in data.department_staff) {
                        staffSelect.add(new Option(data.department_staff[value], value));
                    }
                    // Default to "Unassigned" (empty value)
                    staffSelect.value = '';
                }

                // Update custom fields
                if (customFields) {
                    customFields.innerHTML = data.department_fields || '';
                    customFields.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
                        new bootstrap.Tooltip(el);
                    });
                }

                // Update service dropdown
                if (parseInt(data.enable_related_services) === 1) {
                    if (serviceContainer) serviceContainer.style.display = '';
                    if (data.service_ids && serviceSelect) {
                        var currentServiceId = serviceSelect.value;
                        serviceSelect.innerHTML = '';
                        for (var value in data.service_ids) {
                            var option = new Option(data.service_ids[value], value);
                            if (currentServiceId === value) {
                                option.selected = true;
                            }
                            serviceSelect.add(option);
                        }
                    }
                } else {
                    if (serviceSelect) serviceSelect.value = '';
                    if (serviceContainer) serviceContainer.style.display = 'none';
                }
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
        });
    }

    // Fetch contacts for client
    function fetchContacts() {
        var clientId = clientIdInput ? clientIdInput.value : '';
        if (!clientId || !contactsList) return;

        contactsList.innerHTML = '';

        var formData = '_csrf_token=' + encodeURIComponent(csrfToken ? csrfToken.value : '') + '&client_id=' + encodeURIComponent(clientId);

        fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/getcontacts/');?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data && data.contacts) {
                for (var id in data.contacts) {
                    var div = document.createElement('div');
                    div.className = 'form-check';
                    div.innerHTML = '<input type="checkbox" name="contacts[]" value="' + id + '" id="contact_' + id + '" class="form-check-input"><label for="contact_' + id + '" class="form-check-label">' + data.contacts[id] + '</label>';
                    contactsList.appendChild(div);
                }
            }
        })
        .catch(function(error) {
            console.error('Error:', error);
        });
    }

    // File upload drag and drop
    var dropZone = document.getElementById('fileDropZone');
    var fileInput = document.getElementById('ticketFileInput');
    var fileList = document.getElementById('fileList');

    if (dropZone && fileInput) {
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function(eventName) {
            dropZone.addEventListener(eventName, function(e) {
                e.preventDefault();
                e.stopPropagation();
            });
        });

        ['dragenter', 'dragover'].forEach(function(eventName) {
            dropZone.addEventListener(eventName, function() {
                dropZone.classList.add('drag-over');
            });
        });

        ['dragleave', 'drop'].forEach(function(eventName) {
            dropZone.addEventListener(eventName, function() {
                dropZone.classList.remove('drag-over');
            });
        });

        dropZone.addEventListener('drop', function(e) {
            var files = e.dataTransfer.files;
            fileInput.files = files;
            updateFileList(files);
        });

        dropZone.addEventListener('click', function(e) {
            if (!e.target.closest('button')) {
                fileInput.click();
            }
        });

        fileInput.addEventListener('change', function() {
            updateFileList(this.files);
        });
    }

    function updateFileList(files) {
        if (!fileList) return;

        fileList.innerHTML = '';
        if (files.length > 0) {
            var list = document.createElement('div');
            list.className = 'd-flex flex-wrap gap-2';

            Array.from(files).forEach(function(file) {
                var badge = document.createElement('span');
                badge.className = 'badge bg-secondary d-flex align-items-center gap-1';
                badge.innerHTML = '<i class="bi bi-paperclip"></i> ' + file.name;
                list.appendChild(badge);
            });

            fileList.appendChild(list);
        }
    }
});
</script>
<style>
.autocomplete-results {
    position: absolute;
    z-index: 1000;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    max-height: 200px;
    overflow-y: auto;
    display: none;
    min-width: 100%;
    width: 100%;
}
.autocomplete-results .list-group-item {
    cursor: pointer;
    padding: 8px 12px;
}
.autocomplete-results .list-group-item:hover {
    background-color: var(--bg-secondary);
}
