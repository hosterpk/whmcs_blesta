
                <?php
                echo (isset($message) ? $message : null);

                $this->Widget->clear();
                $this->Widget->create($this->_('AdminResponses.editcategory.boxtitle_editcategory', true));
                ?>
                    <?php $this->Form->create(null, ['class' => 'disable-on-submit']);?>
                        <div class="mb-3">
                            <label class="form-label" for="name"><?php $this->_('AdminResponses.editcategory.field_name');?></label>
                            <?php $this->Form->fieldText('name', (isset($vars->name) ? $vars->name : null), ['id' => 'name', 'class' => 'form-control']);?>
                        </div>
                    </div><!-- end card-body -->
                    <div class="card-footer d-flex justify-content-end">
                        <?php
                        $this->Form->fieldSubmit('save', $this->_('AdminResponses.editcategory.field_submit', true), ['class' => 'btn btn-primary']);
                        ?>
                    </div>
                </div><!-- end card-content -->
                <?php
                $this->Form->end();
                ?></section>