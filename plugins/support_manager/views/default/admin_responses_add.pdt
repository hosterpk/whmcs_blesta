
                <?php
                echo (isset($message) ? $message : null);

                $this->Widget->clear();
                $this->Widget->create($this->_('AdminResponses.add.boxtitle_add', true, (isset($parent_category->name) ? $parent_category->name : null)));
                ?>
                    <?php $this->Form->create(null, ['class' => 'disable-on-submit']);?>
                        <div class="mb-3">
                            <label class="form-label" for="name"><?php $this->_('AdminResponses.add.field_name');?></label>
                            <?php $this->Form->fieldText('name', (isset($vars->name) ? $vars->name : null), ['id' => 'name', 'class' => 'form-control']);?>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="details"><?php $this->_('AdminResponses.add.field_details');?></label>
                            <?php $this->Form->fieldTextarea('details', (isset($vars->details) ? $vars->details : null), ['id' => 'details', 'data-markdown-editor' => '']);?>
                        </div>
                    </div><!-- end card-body -->
                    <div class="card-footer d-flex justify-content-end">
                        <?php
                        $this->Form->fieldSubmit('save', $this->_('AdminResponses.add.field_submit', true), ['class' => 'btn btn-primary']);
                        ?>
                    </div>
                </div><!-- end card-content -->
                <?php
                $this->Form->end();
                ?></section>
