
                <div>
                    <h6 class="form-section-header"><?php $this->_('AdminStaff.schedule_list.heading_schedule');?></h6>
                    <?php
                    if ((isset($staff->schedules) ? $staff->schedules : false) && (count($staff->schedules)) > 0) {
                    ?>
                    <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th><?php $this->_('AdminStaff.schedule_list.heading_day');?></th>
                            <th><?php $this->_('AdminStaff.schedule_list.heading_start_time');?></th>
                            <th><?php $this->_('AdminStaff.schedule_list.heading_end_time');?></th>
                        </tr>
                        </thead>
                        <tbody>
                        <?php
                        // Display all staff schedules
                        $i = 0;
                        foreach ($staff->schedules as $schedule) {
                        ?>
                        <tr<?php echo (($i++%2 == 1) ? ' class="odd_row"' : '');?>>
                            <td><?php echo (isset($days[$schedule->day]) ? $days[$schedule->day] : null);?></td>
                            <td><?php echo $this->Date->cast($schedule->start_time, Configure::get('SupportManager.time_format'));?></td>
                            <td><?php echo $this->Date->cast($schedule->end_time, Configure::get('SupportManager.time_format'));?></td>
                        </tr>
                        <?php
                        }
                        unset($i);
                        ?>
                        </tbody>
                    </table>
                    </div>
                    <?php
                    } else {
                    ?>
                    <div class="card-body text-center text-muted py-4">
                        <i class="bi bi-calendar-week" style="font-size: 2rem; opacity: 0.3;"></i>
                        <p class="mt-2 mb-0 small"><?php $this->_('AdminStaff.schedule_list.no_results');?></p>
                    </div>
                    <?php
                    }
                    ?>
                </div>

                <div>
                    <h6 class="form-section-header"><?php $this->_('AdminStaff.schedule_list.heading_departments');?></h6>
                    <?php
                    if ((isset($staff->departments) ? $staff->departments : false) && (count($staff->departments)) > 0) {
                    ?>
                    <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th><?php $this->_('AdminStaff.schedule_list.heading_department');?></th>
                            <th><?php $this->_('AdminStaff.schedule_list.heading_description');?></th>
                        </tr>
                        </thead>
                        <tbody>
                        <?php
                        // Display all staff departments
                        $i = 0;
                        foreach ($staff->departments as $department) {
                        ?>
                        <tr<?php echo (($i++%2 == 1) ? ' class="odd_row"' : '');?>>
                            <td><?php echo (isset($department->name) ? $this->Html->safe($department->name) : null);?></td>
                            <td>
                                <?php
                                // Set department description
                                $description = $string->truncate((isset($department->description) ? $department->description : null), ['word_length' => Configure::get('SupportManager.summary_truncate_length')]);
                                echo (isset($description) ? $this->Html->safe($description) : null) . ($description != (isset($department->description) ? $department->description : null) ? '...' : '');
                                ?>
                            </td>
                        </tr>
                        <?php
                        }
                        unset($i);
                        ?>
                        </tbody>
                    </table>
                    </div>
                    <?php
                    } else {
                    ?>
                    <div class="card-body text-center text-muted py-4">
                        <i class="bi bi-building" style="font-size: 2rem; opacity: 0.3;"></i>
                        <p class="mt-2 mb-0 small"><?php $this->_('AdminStaff.schedule_list.no_department_results');?></p>
                    </div>
                    <?php
                    }
                    ?>
                </div>
