
        <?php
        echo (isset($message) ? $message : null);

        $this->Widget->clear();
        $this->Widget->create($this->_('AdminKnowledgebase.addcategory.boxtitle_addcategory', true));

        $this->Form->create(null, ['class' => 'disable-on-submit']);
        ?>
                <div class="mb-3">
                    <label class="form-label" for="name"><?php $this->_('AdminKnowledgebase.addcategory.field_name');?></label>
                    <?php $this->Form->fieldText('name', (isset($vars->name) ? $vars->name : null), ['id'=>'name', 'class'=>'form-control']);?>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="parent_id"><?php $this->_('AdminKnowledgebase.addcategory.field_parent_id');?></label>
                    <?php $this->Form->fieldSelect('parent_id', (isset($categories) ? $categories : null), (isset($vars->parent_id) ? $vars->parent_id : null), ['id'=>'parent_id', 'class'=>'form-select']);?>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="access">
                        <?php $this->_('AdminKnowledgebase.addcategory.field_access');?>
                        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="<?php echo $this->Html->safe($this->_('AdminKnowledgebase.!tooltip.access_category', true));?>"></i>
                    </label>
                    <?php $this->Form->fieldSelect('access', (isset($access_types) ? $access_types : null), (isset($vars->access) ? $vars->access : null), ['id'=>'access', 'class'=>'form-select']);?>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="description"><?php $this->_('AdminKnowledgebase.addcategory.field_description');?></label>
                    <?php $this->Form->fieldTextarea('description', (isset($vars->description) ? $vars->description : null), ['id'=>'description', 'data-markdown-editor' => '']);?>
                </div>
            </div><!-- end card-body -->
            <div class="card-footer d-flex justify-content-end gap-2">
                <a class="btn btn-outline-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_knowledgebase/index/' . ((isset($category) ? $category : null) ? (isset($category->id) ? $category->id : null) . '/' : ''));?>"><?php $this->_('AdminKnowledgebase.addcategory.submit_cancel');?></a>
                <?php
                $this->Form->fieldSubmit('save', $this->_('AdminKnowledgebase.addcategory.submit_add', true), ['class' => 'btn btn-primary']);
                ?>
            </div>
        </div><!-- end card-content -->
        <?php
        $this->Form->end();
        ?></section>
