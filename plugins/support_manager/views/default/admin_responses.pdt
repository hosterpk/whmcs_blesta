
        <?php
        echo (isset($message) ? $message : null);

        // Build link buttons for the filter bar
        $link_buttons = [];

        // Back button (only when inside a category)
        if (!empty($category)) {
            $link_buttons[] = [
                'icon' => 'bi bi-arrow-left',
                'name' => $this->_('AdminResponses.index.btn_back', true),
                'attributes' => [
                    'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_responses/index/' . (empty($category->parent_id) ? '' : (isset($category->parent_id) ? $category->parent_id : null) . '/')),
                    'class' => 'btn-back'
                ]
            ];
        }

        // Add Category button
        $link_buttons[] = [
            'icon' => 'bi bi-plus-lg',
            'name' => $this->_('AdminResponses.index.btn_add_category', true),
            'attributes' => [
                'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_responses/addcategory/' . (!empty($category) ? (isset($category->id) ? $category->id : null) . '/' : '')),
                'title' => $this->_('AdminResponses.index.btn_add_category', true)
            ]
        ];

        // Add Response button (only when inside a category)
        if (!empty($category)) {
            $link_buttons[] = [
                'icon' => 'bi bi-plus-lg',
                'name' => $this->_('AdminResponses.index.btn_add_response', true),
                'attributes' => [
                    'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_responses/add/' . (isset($category->id) ? $category->id : null) . '/'),
                    'title' => $this->_('AdminResponses.index.btn_add_response', true)
                ]
            ];
        }

        $this->Widget->clear();
        $this->Widget->setStyleSheet($this->view_dir . 'css/support.css', ['id' => 'support_manager_styles']);
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->create($this->_('AdminResponses.index.boxtitle_responses', true));

        // Display the listing
        echo (isset($response_list) ? $response_list : null);

        $this->Widget->end();
