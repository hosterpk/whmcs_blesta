        <?php
        echo (isset($message) ? $message : null);

        $this->Widget->clear();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminTickets.search.boxtitle_tickets', true, (isset($search) ? $this->Html->safe($search) : null)), ['id'=>'admin_tickets_search'], (isset($render_section) ? $render_section : null));
        ?>
            <?php
            if ((isset($tickets) ? $tickets : false) && ($num_tickets = count($tickets)) > 0) {
            ?>
            <div class="table-responsive">
            <table class="table table-hover mb-0" id="tickets">
                <thead>
                <tr>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/search/?search=' . (isset($search) ? $search : null) . '&sort=code&order=' . ($sort == 'code' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'code' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.search.heading_code');?><?php if ($sort == 'code') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/search/?search=' . (isset($search) ? $search : null) . '&sort=priority&order=' . ($sort == 'priority' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'priority' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.search.heading_priority');?><?php if ($sort == 'priority') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/search/?search=' . (isset($search) ? $search : null) . '&sort=status&order=' . ($sort == 'status' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'status' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.search.heading_status');?><?php if ($sort == 'status') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/search/?search=' . (isset($search) ? $search : null) . '&sort=department_name&order=' . ($sort == 'department_name' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'department_name' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.search.heading_department_name');?><?php if ($sort == 'department_name') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><?php $this->_('AdminTickets.search.heading_summary');?></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/search/?sort=last_reply_date&order=' . ($sort == 'last_reply_date' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'last_reply_date' ? ' ' . $order : '');?>"><?php $this->_('AdminTickets.search.heading_last_reply_date');?><?php if ($sort == 'last_reply_date') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                </tr>
                </thead>
                <tbody>
                <?php
                // Display all tickets
                foreach ($tickets as $ticket) {
                ?>
                <tr<?php echo (!empty($ticket->staff_id) && $ticket->staff_id == (isset($staff_id) ? $staff_id : null) ? ' class="highlight"' : '');?>>
                    <td><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/reply/' . (isset($ticket->id) ? $ticket->id : null) . '/');?>"><?php echo (isset($ticket->code) ? $this->Html->safe($ticket->code) : null);?></a></td>
                    <td>
                    <?php
                    $priority_classes = [
                        'emergency' => 'bg-danger',
                        'critical' => 'bg-warning text-dark',
                        'high' => 'bg-info text-dark',
                        'medium' => 'bg-primary',
                        'low' => 'bg-secondary'
                    ];
                    $badge_class = $priority_classes[$ticket->priority] ?? 'bg-secondary';
                    ?>
                    <span class="badge <?php echo $badge_class; ?>"><?php echo (isset($priorities[$ticket->priority]) ? $priorities[$ticket->priority] : null);?></span>
                    </td>
                    <td><?php echo (isset($statuses[$ticket->status]) ? $statuses[$ticket->status] : null);?></td>
                    <td><?php echo (isset($ticket->department_name) ? $this->Html->safe($ticket->department_name) : null);?></td>
                    <td>
                    <?php
                        $summary = $string->truncate((isset($ticket->summary) ? $ticket->summary : null), ['word_length' => Configure::get('SupportManager.summary_truncate_length')]);
                        echo (isset($summary) ? $this->Html->safe($summary) : null) . ($summary != (isset($ticket->summary) ? $ticket->summary : null) ? '...' : '');
                    ?>
                    </td>
                    <td><?php echo (isset($ticket->last_reply_time) ? $this->Html->safe($ticket->last_reply_time) : null);?></td>
                </tr>
                <?php
                }
                ?>
                </tbody>
            </table>
            </div>
            <?php
            if (isset($this->Pagination) && $this->Pagination->hasPages()) {
                $this->Widget->footer();
                $this->Pagination->build();
            }
            } else {
            ?>
            <div class="text-center text-muted py-5">
                <i class="bi bi-search" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminTickets.search.no_results');?></p>
            </div>
            <?php
            }
            $this->Widget->end();
            ?>
