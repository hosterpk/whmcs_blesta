                    <small class="form-text text-muted"><?php $this->_('AdminMain.ai.field_tool_instructions_desc');?></small>
                </div>
            </div>
        <?php
        $this->Widget->footer();
        ?>
            <div class="d-flex justify-content-end gap-2">
            <?php
            $this->Form->fieldSubmit('save', $this->_('AdminMain.ai.field_submit', true), ['class' => 'btn btn-primary']);
            ?>
            </div>
        <?php
        $this->Widget->end();
        ?>
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize popovers
            const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl);
            });

            // Override Model toggle
            const overrideModelCheckbox = document.getElementById('sm_ai_override_model');
            const modelSelectionSection = document.getElementById('modelSelectionSection');

            if (overrideModelCheckbox && modelSelectionSection) {
                function toggleModelSelection() {
                    if (overrideModelCheckbox.checked) {
                        modelSelectionSection.style.display = 'block';
                    } else {
                        modelSelectionSection.style.display = 'none';
                    }
                }

                toggleModelSelection();
                overrideModelCheckbox.addEventListener('change', toggleModelSelection);
            }

            // Override Max Tokens toggle
            const overrideMaxTokensCheckbox = document.getElementById('sm_ai_override_max_tokens');
            const maxTokensSection = document.getElementById('maxTokensSection');

            if (overrideMaxTokensCheckbox && maxTokensSection) {
                function toggleMaxTokens() {
                    if (overrideMaxTokensCheckbox.checked) {
                        maxTokensSection.style.display = 'block';
                    } else {
                        maxTokensSection.style.display = 'none';
                    }
                }

                toggleMaxTokens();
                overrideMaxTokensCheckbox.addEventListener('change', toggleMaxTokens);
            }

            // Override Temperature toggle
            const overrideTemperatureCheckbox = document.getElementById('sm_ai_override_temperature');
            const temperatureSection = document.getElementById('temperatureSection');

            if (overrideTemperatureCheckbox && temperatureSection) {
                function toggleTemperature() {
                    if (overrideTemperatureCheckbox.checked) {
                        temperatureSection.style.display = 'block';
                    } else {
                        temperatureSection.style.display = 'none';
                    }
                }

                toggleTemperature();
                overrideTemperatureCheckbox.addEventListener('change', toggleTemperature);
            }

            // Auto-Reply settings toggle
            const autoReplyCheckbox = document.getElementById('sm_ai_auto_reply_enabled');
            const autoReplySettings = document.getElementById('autoReplySettings');
            const confidenceThresholdSlider = document.getElementById('sm_ai_confidence_threshold_slider');
            const confidenceThresholdValue = document.getElementById('sm_ai_confidence_threshold');

            if (autoReplyCheckbox && autoReplySettings) {
                function toggleAutoReplySettings() {
                    if (autoReplyCheckbox.checked) {
                        autoReplySettings.style.display = 'block';
                    } else {
                        autoReplySettings.style.display = 'none';
                    }
                }

                toggleAutoReplySettings();
                autoReplyCheckbox.addEventListener('change', toggleAutoReplySettings);
            }

            // Custom Disclaimer toggle
            const addDisclaimerCheckbox = document.getElementById('sm_ai_show_disclaimer');
            const customDisclaimerSection = document.getElementById('customDisclaimerSection');

            if (addDisclaimerCheckbox && customDisclaimerSection) {
                function toggleCustomDisclaimer() {
                    if (addDisclaimerCheckbox.checked) {
                        customDisclaimerSection.style.display = 'block';
                    } else {
                        customDisclaimerSection.style.display = 'none';
                    }
                }

                toggleCustomDisclaimer();
                addDisclaimerCheckbox.addEventListener('change', toggleCustomDisclaimer);
            }

            // Tools settings toggle
            const toolsEnabledCheckbox = document.getElementById('sm_ai_tools_enabled');
            const toolsSettings = document.getElementById('toolsSettings');

            if (toolsEnabledCheckbox && toolsSettings) {
                function toggleToolsSettings() {
                    if (toolsEnabledCheckbox.checked) {
                        toolsSettings.style.display = 'block';
                    } else {
                        toolsSettings.style.display = 'none';
                    }
                }

                toggleToolsSettings();
                toolsEnabledCheckbox.addEventListener('change', toggleToolsSettings);
            }

            // Sync confidence threshold slider and number input
            if (confidenceThresholdSlider && confidenceThresholdValue) {
                confidenceThresholdSlider.addEventListener('input', function() {
                    confidenceThresholdValue.value = this.value;
                });

                confidenceThresholdValue.addEventListener('input', function() {
                    confidenceThresholdSlider.value = this.value;
                });
            }

            // Set tool instructions placeholder with proper newlines
            const toolInstructionsTextarea = document.getElementById('sm_ai_tool_instructions');
            if (toolInstructionsTextarea) {
                toolInstructionsTextarea.placeholder = "Example:\n- Assign technical issues related to Linux servers to John, Windows servers to Dave\n- Only close tickets that are clearly spam, auto-responses, or the customer indicates that the ticket is resolved in the latest reply\n- Increase priority for urgent issues mentioning 'down' or 'offline' to Emergency status\n- Decrease priority of Emergency tickets if they are not actual emergencies";
            }
        });
        </script>
