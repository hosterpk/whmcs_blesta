            <?php
            if (!empty($languages)) {
                $default_lang = Configure::get('Blesta.language');
            ?>
                <!-- Language Tabs -->
                <ul class="nav nav-tabs-connected" role="tablist">
                    <?php
                    foreach ($languages as $i => $lang) {
                        $lang_code = (isset($lang->code) ? $lang->code : null);
                        $is_first = ($i === 0);
                    ?>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link<?php echo $is_first ? ' active' : '';?>"
                                data-bs-toggle="tab"
                                data-bs-target="#lang-<?php echo $this->Html->safe($lang_code);?>"
                                type="button"
                                role="tab">
                            <?php echo (isset($lang->name) ? $this->Html->safe($lang->name) : null);?>
                        </button>
                    </li>
                    <?php
                    }
                    ?>
                </ul>

                <!-- Language Tab Content -->
                <div class="tab-content tab-content-connected mb-3">
                    <?php
                    foreach ($languages as $i => $lang) {
                        $lang_code = (isset($lang->code) ? $lang->code : null);
                        $is_first = ($i === 0);
                    ?>
                    <div class="tab-pane fade<?php echo $is_first ? ' show active' : '';?>" id="lang-<?php echo $this->Html->safe($lang_code);?>" role="tabpanel">
                        <?php
                        $this->Form->fieldHidden('content[' . $i . '][lang]', $lang_code);
                        ?>
                        <div class="mb-3">
                            <label class="form-label"><?php $this->_('AdminKnowledgebase.article_content.title');?></label>
                            <?php $this->Form->fieldText('content[' . $i . '][title]', (isset($vars[$lang_code]->title) ? $vars[$lang_code]->title : null), ['class' => 'form-control']);?>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><?php $this->_('AdminKnowledgebase.article_content.content_type');?></label>
                            <div>
                            <?php
                            foreach ((isset($content_types) ? $content_types : []) as $key => $content_type) {
                            ?>
                                <div class="form-check form-check-inline">
                                    <?php $this->Form->fieldRadio('content[' . $i . '][content_type]', $key, (isset($vars[$lang_code]->content_type) ? $vars[$lang_code]->content_type : ($key == 'text' ? $key : '')) == $key, ['id' => 'type_' . $key . '_' . $i, 'class' => 'content_type form-check-input', 'data-lang-index' => $i]);?>
                                    <label class="form-check-label" for="type_<?php echo $this->Html->safe($key);?>_<?php echo $i;?>"><?php echo $this->Html->safe($content_type);?></label>
                                </div>
                            <?php
                            }
                            ?>
                            </div>
                        </div>
                        <?php
                        $type = (isset($vars[$lang_code]->content_type) ? $vars[$lang_code]->content_type : 'text');
                        foreach ((isset($content_types) ? $content_types : []) as $key => $content_type) {
                            $body_type = 'body_' . $key;
                            // For text mode, use the markdown editor
                            $textarea_attributes = ($key == 'text'
                                ? ['data-markdown-editor' => '', 'id' => 'body_text_' . $i]
                                : ['id' => 'body_html_' . $i, 'class' => 'form-control html-editor', 'rows' => 12]);
                        ?>
                        <div class="mb-3 content-type-<?php echo (isset($key) ? $this->Html->safe($key) : null);?> content-type-lang-<?php echo $i;?>"<?php echo $key == $type ? '' : ' style="display:none;"';?>>
                            <?php
                            $value = ((isset($vars[$lang_code]->content_type) ? $vars[$lang_code]->content_type : null) == $key) ? (isset($vars[$lang_code]->body) ? $vars[$lang_code]->body : null) : (isset($vars[$lang_code]->{$body_type}) ? $vars[$lang_code]->{$body_type} : null);
                            ?>
                            <label class="form-label"><?php $this->_('AdminKnowledgebase.article_content.body');?></label>
                            <?php $this->Form->fieldTextarea('content[' . $i . '][' . $body_type . ']', $value, $textarea_attributes);?>
                        </div>
                        <?php
                        }
                        ?>
                    </div>
                    <?php
                    }
                    ?>
                </div>
            <?php
            }
            ?>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Content type toggle - show/hide text vs html editors
    document.querySelectorAll('.content_type').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var langIndex = this.getAttribute('data-lang-index');
            var contentType = this.value;
            var tabPane = this.closest('.tab-pane');

            // Hide all content type containers for this language
            tabPane.querySelectorAll('.content-type-text.content-type-lang-' + langIndex).forEach(function(el) {
                el.style.display = 'none';
            });
            tabPane.querySelectorAll('.content-type-html.content-type-lang-' + langIndex).forEach(function(el) {
                el.style.display = 'none';
            });

            // Show the selected content type container
            tabPane.querySelectorAll('.content-type-' + contentType + '.content-type-lang-' + langIndex).forEach(function(el) {
                el.style.display = '';
            });
        });
    });

    // Initialize WYSIWYG editor for HTML textareas
    if (typeof blestaBindWysiwygEditor !== 'undefined') {
        blestaBindWysiwygEditor('.html-editor', {
            language: '<?php echo substr(Configure::get('Blesta.language'), 0, 2);?>'
        });
    }
});
</script>
