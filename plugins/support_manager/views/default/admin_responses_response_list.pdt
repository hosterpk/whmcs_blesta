
        <?php
        $category_name = (isset($category->name) ? $category->name : null);
        $dropdown_mode = !(isset($show_links) ? $show_links : false);
        $is_search_mode = isset($is_search_mode) && $is_search_mode;

        if (!empty($category_name) && !$dropdown_mode) {
        ?>
        <h6 class="form-section-header"><?php echo (isset($category_name) ? $this->Html->safe($category_name) : null);?></h6>
        <?php
        }

        if ($is_search_mode && $dropdown_mode) {
            // Search results mode - flat list with category paths
            foreach ((isset($search_results) ? $search_results : []) as $result) {
            ?>
            <div class="predefined-response-item predefined-response-search-result" data-response-id="<?php echo (isset($result['id']) ? $this->Html->safe($result['id']) : null);?>">
                <div class="response-main">
                    <i class="bi bi-chat-left-text"></i>
                    <?php echo (isset($result['name']) ? $this->Html->safe($result['name']) : null);?>
                </div>
                <?php if (!empty($result['category_path'])) { ?>
                <div class="response-category-path">
                    <i class="bi bi-folder2"></i>
                    <?php echo $this->Html->safe($result['category_path']);?>
                </div>
                <?php } ?>
            </div>
            <?php
            }
        } elseif (!empty($category) || !empty($categories) || !empty($responses)) {
            if ($dropdown_mode) {
                // Dropdown mode - used in ticket add/reply predefined responses dropdown
                // Show up a category (back navigation)
                if (!empty($category)) {
                ?>
                <div class="predefined-response-category" data-category-id="<?php echo (isset($category->parent_id) ? $this->Html->safe($category->parent_id) : '');?>">
                    <i class="bi bi-arrow-return-left"></i>
                    <?php $this->_('AdminResponses.index.text_up_level');?>
                </div>
                <?php
                }

                // List categories
                foreach ((isset($categories) ? $categories : []) as $cat) {
                ?>
                <div class="predefined-response-category" data-category-id="<?php echo (isset($cat->id) ? $this->Html->safe($cat->id) : null);?>">
                    <i class="bi bi-folder2"></i>
                    <?php echo (isset($cat->name) ? $this->Html->safe($cat->name) : null);?>
                </div>
                <?php
                }

                // List responses
                foreach ((isset($responses) ? $responses : []) as $response) {
                ?>
                <div class="predefined-response-item" data-response-id="<?php echo (isset($response->id) ? $this->Html->safe($response->id) : null);?>">
                    <i class="bi bi-chat-left-text"></i>
                    <?php echo (isset($response->name) ? $this->Html->safe($response->name) : null);?>
                </div>
                <?php
                }
            } else {
                // Management mode - used in responses admin page
        ?>
        <div class="pad clear" id="responses">
            <div class="row g-3">
                <?php
                // List categories
                foreach ((isset($categories) ? $categories : []) as $cat) {
                ?>
                <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                    <div class="response-folder-card" role="link" tabindex="0" data-href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_responses/index/' . (isset($cat->id) ? $cat->id : null) . '/');?>">
                        <div class="response-folder-icon">
                            <i class="bi bi-folder-fill"></i>
                        </div>
                        <div class="response-folder-name"><?php echo (isset($cat->name) ? $this->Html->safe($cat->name) : null);?></div>
                        <?php if (isset($cat->item_count) && $cat->item_count > 0) { ?>
                        <span class="response-folder-count badge bg-secondary"><?php echo $this->Html->safe($cat->item_count);?></span>
                        <?php } ?>
                        <div class="response-folder-actions">
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_responses/editcategory/' . (isset($cat->id) ? $cat->id : null) . '/');?>" class="response-folder-action-btn" title="<?php $this->_('AdminResponses.index.edit');?>">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <?php
                            $this->Form->create($this->base_uri . 'plugin/support_manager/admin_responses/deletecategory/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', (isset($cat->id) ? $cat->id : null));
                            ?>
                            <button type="button" class="response-folder-action-btn response-folder-delete-btn modal-confirm-delete" data-confirm-message="<?php $this->_('AdminResponses.modal.delete_category');?>" title="<?php $this->_('AdminResponses.index.delete');?>">
                                <i class="bi bi-trash"></i>
                            </button>
                            <?php $this->Form->end();?>
                        </div>
                    </div>
                </div>
                <?php
                }
                // List responses
                foreach ((isset($responses) ? $responses : []) as $response) {
                ?>
                <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                    <div class="response-folder-card response-item-card" role="link" tabindex="0" data-href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_responses/edit/' . (isset($response->id) ? $response->id : null) . '/');?>">
                        <div class="response-folder-icon">
                            <i class="bi bi-chat-left-text"></i>
                        </div>
                        <div class="response-folder-name"><?php echo (isset($response->name) ? $this->Html->safe($response->name) : null);?></div>
                        <div class="response-folder-actions">
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_responses/edit/' . (isset($response->id) ? $response->id : null) . '/');?>" class="response-folder-action-btn" title="<?php $this->_('AdminResponses.index.edit');?>">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <?php
                            $this->Form->create($this->base_uri . 'plugin/support_manager/admin_responses/delete/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', (isset($response->id) ? $response->id : null));
                            ?>
                            <button type="button" class="response-folder-action-btn response-folder-delete-btn modal-confirm-delete" data-confirm-message="<?php $this->_('AdminResponses.modal.delete_response');?>" title="<?php $this->_('AdminResponses.index.delete');?>">
                                <i class="bi bi-trash"></i>
                            </button>
                            <?php $this->Form->end();?>
                        </div>
                    </div>
                </div>
                <?php
                }
                ?>
            </div>
        </div>
        <?php
            }
        }

        // Only show empty message in management mode (not in dropdown mode)
        if (!$dropdown_mode && empty($categories) && empty($responses)) {
        ?>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-chat-square-text" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0"><?php $this->_('AdminResponses.index.no_responses');?></p>
            </div>
        <?php
        }
        ?>
<?php
if (!$dropdown_mode) {
?>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Handle card click navigation
    document.querySelectorAll('#responses .response-folder-card[data-href]').forEach(function(card) {
        card.addEventListener('click', function(e) {
            // Don't navigate if clicking on action buttons, links, or forms
            if (e.target.closest('.response-folder-actions')) {
                return;
            }
            var href = this.dataset.href;
            if (href) {
                window.location.href = href;
            }
        });

        // Handle keyboard navigation (Enter key)
        card.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.target.closest('.response-folder-actions')) {
                var href = this.dataset.href;
                if (href) {
                    window.location.href = href;
                }
            }
        });
    });

    // Prevent action button clicks from triggering card navigation
    document.querySelectorAll('#responses .response-folder-action-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });
});
</script>
<?php
}
