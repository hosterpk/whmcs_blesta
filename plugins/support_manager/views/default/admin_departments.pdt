        <?php
        echo (isset($message) ? $message : null);

        $link_buttons = [
            [
                'icon' => 'bi bi-plus-lg',
                'name' => '',
                'attributes' => [
                    'title' => $this->_('AdminDepartments.index.categorylink_adddepartment', true),
                    'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/add/')
                ]
            ]
        ];

        $this->Widget->clear();
        $this->Widget->setStyleSheet($this->view_dir . 'css/support.css', ['id' => 'support_manager_styles']);
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminDepartments.index.boxtitle_departments', true), ['id'=>'admin_department'], (isset($render_section) ? $render_section : null));

        if ((isset($departments) ? $departments : false) && ($num_departments = count($departments)) > 0) {
        ?>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="departments">
            <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/index/?sort=name&order=' . ($sort == 'name' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'name' ? ' ' . $order : '');?>"><?php $this->_('AdminDepartments.index.heading_name');?><?php if ($sort == 'name') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/index/?sort=description&order=' . ($sort == 'description' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'description' ? ' ' . $order : '');?>"><?php $this->_('AdminDepartments.index.heading_description');?><?php if ($sort == 'description') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/index/?sort=email&order=' . ($sort == 'email' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'email' ? ' ' . $order : '');?>"><?php $this->_('AdminDepartments.index.heading_email');?><?php if ($sort == 'email') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/index/?sort=assigned_staff&order=' . ($sort == 'assigned_staff' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'assigned_staff' ? ' ' . $order : '');?>"><?php $this->_('AdminDepartments.index.heading_assigned_staff');?><?php if ($sort == 'assigned_staff') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/index/?sort=default_priority&order=' . ($sort == 'default_priority' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'default_priority' ? ' ' . $order : '');?>"><?php $this->_('AdminDepartments.index.heading_default_priority');?><?php if ($sort == 'default_priority') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th class="text-end"><?php $this->_('AdminDepartments.index.heading_options');?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                // Display all departments
                foreach ($departments as $department) {
                ?>
                <tr style="cursor: pointer;" data-collapse-row aria-expanded="false">
                    <td><i class="bi bi-<?php echo (isset($department->status) ? $department->status : 'visible') == 'visible' ? 'eye' : 'eye-slash';?>"></i></td>
                    <td><?php echo (isset($department->name) ? $this->Html->safe($department->name) : null);?></td>
                    <td>
                    <?php
                    // Set department description
                    $description = $string->truncate((isset($department->description) ? $department->description : null), ['word_length' => Configure::get('SupportManager.summary_truncate_length')]);
                    echo (isset($description) ? $this->Html->safe($description) : null) . ($description != (isset($department->description) ? $department->description : null) ? '...' : '');
                    ?>
                    </td>
                    <td><?php echo (isset($department->email) ? $this->Html->safe($department->email) : null);?></td>
                    <td><?php echo (isset($department->assigned_staff) ? $this->Html->safe($department->assigned_staff) : null);?></td>
                    <td><?php echo (isset($priorities[$department->default_priority]) ? $priorities[$department->default_priority] : null);?></td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_departments/edit/' . (isset($department->id) ? $this->Html->safe($department->id) : null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminDepartments.index.option_edit');?>">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <?php
                            $this->Form->create($this->base_uri . 'plugin/support_manager/admin_departments/delete/', ['class' => 'd-inline']);
                            $this->Form->fieldHidden('id', (isset($department->id) ? $department->id : null));
                            ?>
                            <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminDepartments.index.confirm_delete', true));?>" title="<?php $this->_('AdminDepartments.index.option_delete');?>">
                                <i class="bi bi-trash"></i>
                            </button>
                            <?php
                            $this->Form->end();
                            ?>
                        </div>
                    </td>
                </tr>
                <tr class="collapse">
                    <td colspan="7" style="padding: 0; background-color: var(--bg-secondary);">
                        <div class="details-container" data-department-id="<?php echo (isset($department->id) ? $this->Html->safe($department->id) : null);?>">
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm text-secondary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
                <?php
                }
                ?>
            </tbody>
        </table>
    </div>
    <?php if (isset($this->Pagination) && $this->Pagination->hasPages()) { ?>
    <div class="card-footer">
        <?php $this->Pagination->build(); ?>
    </div>
    <?php } ?>
        <?php
        } else {
        ?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-building" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('AdminDepartments.index.no_results');?></p>
    </div>
        <?php
        }
        $this->Widget->end();
        ?>
<script type="text/javascript">
document.addEventListener('show.bs.collapse', function(e) {
    var expandedRow = e.target;
    if (!expandedRow.classList.contains('collapse')) return;

    var container = expandedRow.querySelector('.details-container');
    if (!container) return;

    var departmentId = container.getAttribute('data-department-id');

    // Only load if not already loaded
    if (!container.hasAttribute('data-loaded')) {
        fetch('<?php echo $this->Html->safe($this->base_uri);?>plugin/support_manager/admin_departments/assignedstaff/' + departmentId, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(response) {
            return response.text();
        })
        .then(function(html) {
            container.innerHTML = '<div class="p-3">' + html + '</div>';
            container.setAttribute('data-loaded', 'true');
        })
        .catch(function(error) {
            container.innerHTML = '<div class="alert alert-danger m-3">Error loading details.</div>';
        });
    }
});
</script>
