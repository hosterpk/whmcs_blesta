                            <td><?php $this->Form->fieldSelect('department_id', (isset($departments) ? $departments : null), (isset($vars->department_id) ? $vars->department_id : null), ['id' => 'department_id']);?></td>
                            <td>
                                <?php $this->Form->fieldSelect('service_id', (isset($service_ids) ? $service_ids : null), (isset($vars->service_id) ? $vars->service_id : null), ['id' => 'service_id', 'class' => 'inline']);?>
                                <?php
                                if (!empty($service)) {
                                ?>
                                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/editservice/' . (isset($client->id) ? $client->id : null) . '/' . (isset($service->id) ? $service->id : null) . '/');?>"><?php echo $this->Html->safe('(ID: ' . $service->id_code . ')');?></a>
