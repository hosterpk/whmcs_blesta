                                        <?php $this->Form->fieldTextarea('notes', (isset($vars->notes) ? $vars->notes : null), ['id' => 'note_details', 'rows' => 21, 'data-markdown-editor' => '', 'data-image-upload-url' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/uploadimage/')]);?>
