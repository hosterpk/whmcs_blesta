                    <p class="m-0">
                        <a href="#" class="additional_recipients font-weight-bold mt-3"><i class="fas fa-share fa-flip-vertical"></i> <?php $this->_('AdminTickets.reply.text_additional_recipients');?></a>
                    </p>
                    <div id="additional_recipients" class="row m-0 px-2"<?php echo (empty($vars->recipients) && empty($vars->contacts) ? ' style="display: none;"' : ''); ?>>
                        <div class="col-md-6 pl-0 pr-1">
                            <div class="title_row first">
                                <h3><?php $this->_('AdminTickets.reply.heading_recipients');?></h3>
                            </div>
