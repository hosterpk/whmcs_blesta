                                        <div class="dropdown-menu predefined-responses-dropdown" aria-labelledby="predefinedResponsesBtn">
                                            <!-- Search Box -->
                                            <div class="predefined-responses-search">
                                                <input type="text" class="form-control form-control-sm" id="responseSearchInput" placeholder="<?php $this->_('AdminTickets.reply.search_responses');?>" autocomplete="off">
