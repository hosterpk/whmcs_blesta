                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-cloud-upload upload-icon"></i>
                                    <div class="flex-grow-1">
                                        <div class="upload-text"><?php $this->_('AdminTickets.reply.dropzone_drop_files');?></div>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('ticketFileInput').click()">
                                        <?php $this->_('AdminTickets.reply.browse_files');?>
                                    </button>
                                </div>
                            </div>
                            <div id="fileList" class="mb-3"></div>

                            <!-- Custom Fields -->
                            <div id="custom_fields"><?php echo $department_fields ?? '';?></div>

                            <!-- Update Button (above replies) -->
                            <div class="d-flex justify-content-end gap-2 mb-3">
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_tickets/');?>" class="btn btn-secondary"><?php $this->_('AdminTickets.reply.btn_cancel');?></a>
                                <?php
                                $this->Form->fieldSubmit('save', $this->_('AdminTickets.reply.field_replysubmit', true), ['class' => 'btn btn-primary']);
                                ?>
