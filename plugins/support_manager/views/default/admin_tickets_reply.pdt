                            <!-- Reply/Note Tabs -->
                            <?php $this->Form->fieldHidden('reply_type', (isset($vars->reply_type) ? $vars->reply_type : 'reply'), ['id' => 'reply_type']);?>
                            <ul class="nav nav-tabs-connected" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link<?php echo (isset($vars->reply_type) && $vars->reply_type == 'note') ? '' : ' active';?>" data-bs-toggle="tab" data-bs-target="#tab-reply" type="button" role="tab" data-reply-type="reply"><?php $this->_('AdminTickets.reply.field_reply');?></button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link<?php echo (isset($vars->reply_type) && $vars->reply_type == 'note') ? ' active' : '';?>" data-bs-toggle="tab" data-bs-target="#tab-note" type="button" role="tab" data-reply-type="note"><?php $this->_('AdminTickets.reply.field_note');?></button>
