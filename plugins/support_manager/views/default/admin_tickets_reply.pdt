                                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="predefinedResponsesBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                            <i class="bi bi-chat-square-text me-1"></i>
                                            <?php $this->_('AdminTickets.reply.text_add_response');?>
