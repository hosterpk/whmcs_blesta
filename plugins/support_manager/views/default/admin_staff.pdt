        <?php
        echo (isset($message) ? $message : null);

        $link_buttons = [
            [
                'icon' => 'bi bi-plus-lg',
                'name' => '',
                'attributes' => [
                    'title' => $this->_('AdminStaff.index.categorylink_addstaff', true),
                    'href' => $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_staff/add/')
                ]
           ]
        ];

        $this->Widget->clear();
        $this->Widget->setStyleSheet($this->view_dir . 'css/support.css', ['id' => 'support_manager_styles']);
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->setBodyWrapper(false);
        $this->Widget->create($this->_('AdminStaff.index.boxtitle_staff', true), ['id'=>'admin_staff'], (isset($render_section) ? $render_section : null));

        if ((isset($staff) ? $staff : false) && ($num_staff = count($staff)) > 0) {
        ?>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="staff">
            <thead>
                <tr>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_staff/index/?sort=first_name&order=' . ($sort == 'first_name' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'first_name' ? ' ' . $order : '');?>"><?php $this->_('AdminStaff.index.heading_first_name');?><?php if ($sort == 'first_name') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_staff/index/?sort=email&order=' . ($sort == 'email' ? $negate_order : $order));?>" class="ajax<?php echo $this->Html->safe($sort == 'email' ? ' ' . $order : '');?>"><?php $this->_('AdminStaff.index.heading_email');?><?php if ($sort == 'email') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down'; ?>"></i><?php } ?></a></th>
                    <th><?php $this->_('AdminStaff.index.heading_ticket_emails');?></th>
                    <th><?php $this->_('AdminStaff.index.heading_mobile_ticket_emails');?></th>
                    <th><?php $this->_('AdminStaff.index.heading_ticket_messenger_notifications');?></th>
                    <th class="text-end"><?php $this->_('AdminStaff.index.heading_options');?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                // Display all staff
                $i = 0;
                foreach ($staff as $member) {
                    // Get email ticket status
                    $ticket_status = ['ticket_emails' => 'bi-x-lg text-danger', 'mobile_ticket_emails' => 'bi-x-lg text-danger', 'ticket_messenger_notifications' => 'bi-x-lg text-danger'];
                    foreach (['ticket_emails', 'mobile_ticket_emails', 'ticket_messenger_notifications'] as $ticket_key) {
                        foreach ((isset($member->settings[$ticket_key]) ? $member->settings[$ticket_key] : []) as $key => $value) {
                            if ($value == 'true') {
                                $ticket_status[$ticket_key] = 'bi-check-lg text-success';
                                break;
                            }
                        }
                    }
                ?>
                <tr class="<?php echo $this->Html->concat(' ', 'staff_member', ($i++%2 == 1) ? 'odd_row' : '', 'expand');?>" data-staff-id="<?php echo (isset($member->id) ? $this->Html->safe($member->id) : null);?>">
                    <td><?php echo $this->Html->concat(' ', (isset($member->first_name) ? $this->Html->safe($member->first_name) : null), (isset($member->last_name) ? $this->Html->safe($member->last_name) : null));?></td>
                    <td><?php echo (isset($member->email) ? $this->Html->safe($member->email) : null);?></td>
                    <td><i class="bi <?php echo (isset($ticket_status['ticket_emails']) ? $this->Html->safe($ticket_status['ticket_emails']) : null);?>"></i></td>
                    <td><i class="bi <?php echo (isset($ticket_status['mobile_ticket_emails']) ? $this->Html->safe($ticket_status['mobile_ticket_emails']) : null);?>"></i></td>
                    <td><i class="bi <?php echo (isset($ticket_status['ticket_messenger_notifications']) ? $this->Html->safe($ticket_status['ticket_messenger_notifications']) : null);?>"></i></td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_staff/edit/' . (isset($member->id) ? $this->Html->safe($member->id) : null) . '/');?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminStaff.index.option_edit');?>">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger delete-staff" data-staff-id="<?php echo $this->Html->safe($member->id);?>" data-confirm="<?php echo $this->Html->safe($this->_('AdminStaff.index.confirm_delete', true));?>" data-delete-url="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_staff/delete/' . $member->id . '/');?>" title="<?php $this->_('AdminStaff.index.option_delete');?>">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr class="expand_details" id="staff_<?php echo (isset($member->id) ? $this->Html->safe($member->id) : null);?>">
                    <td colspan="6" class="subtable">
                    </td>
                </tr>
                <?php
                }
                unset($i);
                ?>
            </tbody>
        </table>
    </div>
    <?php if (isset($this->Pagination) && $this->Pagination->hasPages()) { ?>
    <div class="card-footer">
        <?php $this->Pagination->build(); ?>
    </div>
    <?php } ?>
        <?php
        } else {
        ?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-people" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('AdminStaff.index.no_results');?></p>
    </div>
        <?php
        }
        $this->Widget->end();
        ?>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Handle delete confirmation
    document.querySelectorAll('.delete-staff').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var confirmMessage = this.dataset.confirm;
            var deleteUrl = this.dataset.deleteUrl;

            if (typeof SupportManager !== 'undefined' && SupportManager.Confirm) {
                SupportManager.Confirm.show(confirmMessage, function() {
                    window.location.href = deleteUrl;
                });
            } else if (confirm(confirmMessage)) {
                window.location.href = deleteUrl;
            }
        });
    });

    // Fetch all staff schedules/departments - expandable rows
    document.querySelectorAll('.staff_member').forEach(function(row) {
        // Prevent click on links/buttons from triggering row expansion
        row.querySelectorAll('a, button').forEach(function(el) {
            el.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });

        row.addEventListener('click', function(e) {
            // Don't expand if clicking on a link or button
            if (e.target.tagName === 'A' || e.target.tagName === 'BUTTON' || e.target.closest('a') || e.target.closest('button')) {
                return;
            }

            var staffId = this.dataset.staffId;
            var detailsRow = document.getElementById('staff_' + staffId);
            var subtable = detailsRow.querySelector('.subtable');

            // Toggle expanded state
            if (this.classList.contains('expanded')) {
                this.classList.remove('expanded');
                detailsRow.style.display = 'none';
                return;
            }

            this.classList.add('expanded');
            detailsRow.style.display = '';

            // Fetch schedule list via AJAX
            var url = '<?php echo $this->Html->safe($this->base_uri);?>plugin/support_manager/admin_staff/getschedule/' + staffId;

            fetch(url, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(function(response) {
                return response.text();
            })
            .then(function(html) {
                subtable.innerHTML = html;
            })
            .catch(function(error) {
                console.error('Error fetching schedule:', error);
            });
        });
    });
});
</script>
