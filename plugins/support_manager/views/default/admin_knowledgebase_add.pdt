
        <?php
        echo (isset($message) ? $message : null);

        $this->Widget->clear();
        $this->Widget->setStyleSheet($this->view_dir . 'css/support.css', ['id' => 'support_manager_styles']);
        $this->Widget->create($this->_('AdminKnowledgebase.add.boxtitle_add', true));

        $this->Form->create(null, ['id' => 'add_article_form', 'class' => 'disable-on-submit']);
        ?>
                <?php echo (isset($article_content) ? $article_content : null);?>

                <div class="mb-3">
                    <label class="form-label" for="access">
                        <?php $this->_('AdminKnowledgebase.add.field_access');?>
                        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="<?php echo $this->Html->safe($this->_('AdminKnowledgebase.!tooltip.access_article', true));?>"></i>
                    </label>
                    <?php $this->Form->fieldSelect('access', (isset($access_types) ? $access_types : null), (isset($vars->access) ? $vars->access : null), ['id'=>'access', 'class'=>'form-select']);?>
                </div>
                <div class="mb-3">
                    <label class="form-label"><?php $this->_('AdminKnowledgebase.add.field_categories');?></label>
                    <div id="categories_container">
                    <?php
                    $num_categories = (!empty($vars->categories) ? count($vars->categories) : 1);
                    for ($i = 0; $i < $num_categories; $i++) {
                    ?>
                        <div class="category d-flex align-items-center mb-2 gap-2">
                            <?php $this->Form->fieldSelect('categories[]', (isset($categories) ? $categories : null), (isset($vars->categories[$i]) ? $vars->categories[$i] : null), ['class'=>'form-select categories']);?>
                            <a href="#" class="remove_category text-danger"><i class="bi bi-x-lg"></i></a>
                        </div>
                    <?php
                    }
                    ?>
                    </div>
                    <a href="#" class="add_category small fw-bold">
                        <i class="bi bi-plus-circle me-1"></i><?php $this->_('AdminKnowledgebase.!text.add_category');?>
                    </a>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a class="btn btn-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/support_manager/admin_knowledgebase/index/' . ((isset($category) ? $category : null) ? (isset($category->id) ? $category->id : null) . '/' : ''));?>"><?php $this->_('AdminKnowledgebase.add.submit_cancel');?></a>
                <?php
                $this->Form->fieldSubmit('save', $this->_('AdminKnowledgebase.add.submit_add', true), ['class' => 'btn btn-primary']);
                ?>
            </div>
        <?php
        $this->Form->end();
        $this->Widget->end();
        ?>
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Bootstrap tooltips
    var tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    tooltipTriggerList.forEach(function(tooltipTriggerEl) {
        new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Add/remove category using event delegation
    document.addEventListener('click', function(e) {
        // Add category
        if (e.target.closest('.add_category')) {
            e.preventDefault();
            var container = document.getElementById('categories_container');
            if (container) {
                var lastCategory = container.querySelector('.category:last-child');
                if (lastCategory) {
                    var clone = lastCategory.cloneNode(true);
                    var select = clone.querySelector('select');
                    if (select) select.value = '';
                    container.appendChild(clone);
                }
            }
        }

        // Remove category
        if (e.target.closest('.remove_category')) {
            e.preventDefault();
            var container = document.getElementById('categories_container');
            if (container) {
                var categories = container.querySelectorAll('.category');
                if (categories.length <= 1) return;
                e.target.closest('.category').remove();
            }
        }
    });
});
</script>
