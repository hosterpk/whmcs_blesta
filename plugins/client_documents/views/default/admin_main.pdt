<?php /** @var View $this **/ ?>

<?php
echo (isset($message) ? $message : null);

$link_buttons = [
    [
        'icon' => 'bi bi-arrow-left me-1',
        'name' => $this->_('AdminMain.index.link_client', true, ($client->id_code ?? null)),
        'attributes' => [
            'href' => $this->base_uri . 'clients/view/' . ($client->id ?? null)
        ]
    ],
    [
        'icon' => 'bi bi-plus-lg',
        'name' => '',
        'attributes' => [
            'href' => $this->Html->safe($this->base_uri . 'plugin/client_documents/admin_main/add/' . ($client->id ?? null)),
            'title' => $this->_('AdminMain.index.categorylink_adddocument', true)
        ]
    ]
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminMain.index.boxtitle_documents', true), ['id' => 'admin_main'], ($render_section ?? null));

if (($documents ?? false) && ($num_documents = count($documents)) > 0) {
?>
<div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/client_documents/admin_main/index/' . ($client->id ?? null) . '/?sort=name&order=' . ($sort == 'name' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminMain.index.heading_name');?>
                        <?php if ($sort == 'name') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th><?php $this->_('AdminMain.index.heading_description');?></th>
                <th>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/client_documents/admin_main/index/' . ($client->id ?? null) . '/?sort=date_added&order=' . ($sort == 'date_added' ? $negate_order : $order));?>" class="ajax text-decoration-none">
                        <?php $this->_('AdminMain.index.heading_date_added');?>
                        <?php if ($sort == 'date_added') { ?><i class="bi bi-chevron-<?php echo $order == 'asc' ? 'up' : 'down';?>"></i><?php } ?>
                    </a>
                </th>
                <th class="text-end" style="width: 100px;"><?php $this->_('AdminMain.index.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($documents as $document) { ?>
            <tr>
                <td><?php echo ($document->name ?? null) ? $this->Html->safe($document->name) : null;?></td>
                <td><?php echo ($document->description ?? null) ? $this->Html->safe($document->description) : null;?></td>
                <td><?php echo $this->Date->cast($document->date_added);?></td>
                <td class="text-end">
                    <div class="d-flex gap-1 justify-content-end">
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/client_documents/admin_main/download/' . ($document->id ?? null));?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('AdminMain.index.option_download');?>">
                            <i class="bi bi-download"></i>
                        </a>
                        <?php
                        $this->Form->create($this->base_uri . 'plugin/client_documents/admin_main/delete/' . ($document->id ?? null), ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', ($document->id ?? null));
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminMain.modal.delete_document', true));?>" title="<?php $this->_('AdminMain.index.option_delete');?>">
                            <i class="bi bi-trash"></i>
                        </button>
                        <?php
                        $this->Form->end();
                        ?>
                    </div>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>
<?php
} else {
?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php $this->_('AdminMain.index.no_results');?></p>
</div>
<?php
}
$this->Widget->end();
?>
