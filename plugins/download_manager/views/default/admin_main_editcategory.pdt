<?php /** @var View $this */ ?>

<?php
echo (isset($message) ? $message : null);

$this->Widget->clear();
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminMain.editcategory.boxtitle_editcategory', true, ($category->name ?? null)));

$this->Form->create(null, ['class' => 'disable-on-submit']);
?>
<div class="card-body">
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.editcategory.field_name', true), 'name', ['class' => 'form-label']);
        $this->Form->fieldText('name', ($vars->name ?? null), ['id' => 'name', 'class' => 'form-control']);
        ?>
    </div>
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.editcategory.field_description', true), 'description', ['class' => 'form-label']);
        $this->Form->fieldTextarea('description', ($vars->description ?? null), ['id' => 'description', 'class' => 'form-control', 'data-markdown-editor' => '']);
        ?>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <a class="btn btn-outline-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/download_manager/admin_main/files/' . ($category->id ?? null)); ?>"><?php $this->_('AdminMain.editcategory.submit_cancel'); ?></a>
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminMain.editcategory.submit_edit', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Form->end();
$this->Widget->end();
?>
