    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><?php $this->_('AdminMain.modal.cancel'); ?></button>
    <button type="button" class="btn btn-primary" id="saveEditFileBtn">
        <?php $this->_('AdminMain.edit.submit_edit'); ?>
    </button>
</div>

<script>
(function() {
    var form = document.getElementById('editFileForm');
    var editAccessLoggedIn = document.getElementById('editAccessLoggedIn');
    var editAvailableToClientGroups = document.getElementById('editAvailableToClientGroups');
    var editAvailableToPackages = document.getElementById('editAvailableToPackages');
    var editSourceUpload = document.getElementById('editSourceUpload');
    var editSourcePath = document.getElementById('editSourcePath');

    function toggleAccess() {
        var showLoggedIn = editAccessLoggedIn.checked;
        document.querySelectorAll('.edit_logged_in').forEach(function(el) {
            el.style.display = showLoggedIn ? 'block' : 'none';
        });
        if (showLoggedIn) {
            if (editAvailableToClientGroups.checked) {
                document.getElementById('editClientGroups').style.display = 'block';
            }
            if (editAvailableToPackages.checked) {
                document.getElementById('editPackages').style.display = 'block';
            }
        } else {
            document.getElementById('editClientGroups').style.display = 'none';
            document.getElementById('editPackages').style.display = 'none';
        }
    }

    function toggleFileSource() {
        document.getElementById('editUploadSection').style.display = editSourceUpload.checked ? 'block' : 'none';
        document.getElementById('editPathSection').style.display = editSourcePath.checked ? 'block' : 'none';
    }

    // Initialize visibility
    toggleAccess();
    toggleFileSource();

    // Access type change
    document.getElementById('editAccessPublic').addEventListener('change', toggleAccess);
    editAccessLoggedIn.addEventListener('change', toggleAccess);

    // Client groups / packages checkboxes
    editAvailableToClientGroups.addEventListener('change', function() {
        document.getElementById('editClientGroups').style.display = this.checked ? 'block' : 'none';
    });
    editAvailableToPackages.addEventListener('change', function() {
        document.getElementById('editPackages').style.display = this.checked ? 'block' : 'none';
    });

    // File source change
    editSourceUpload.addEventListener('change', toggleFileSource);
    editSourcePath.addEventListener('change', toggleFileSource);

    // Dual-select helper
    function moveOptions(fromId, toId) {
        var from = document.getElementById(fromId);
        var to = document.getElementById(toId);
        if (from && to) {
            Array.from(from.selectedOptions).forEach(function(option) {
                to.appendChild(option);
                option.selected = false;
            });
        }
    }

    // Dual-select buttons
    document.querySelectorAll('.edit_client_group.move_left').forEach(function(btn) {
        btn.addEventListener('click', function() { moveOptions('editAvailableClientGroups', 'editAssignedClientGroups'); });
    });
    document.querySelectorAll('.edit_client_group.move_right').forEach(function(btn) {
        btn.addEventListener('click', function() { moveOptions('editAssignedClientGroups', 'editAvailableClientGroups'); });
    });
    document.querySelectorAll('.edit_packages.move_left').forEach(function(btn) {
        btn.addEventListener('click', function() { moveOptions('editAvailablePackages', 'editAssignedPackages'); });
    });
    document.querySelectorAll('.edit_packages.move_right').forEach(function(btn) {
        btn.addEventListener('click', function() { moveOptions('editAssignedPackages', 'editAvailablePackages'); });
    });

    // Double-click to move
    document.getElementById('editAvailableClientGroups').addEventListener('dblclick', function() { moveOptions('editAvailableClientGroups', 'editAssignedClientGroups'); });
    document.getElementById('editAssignedClientGroups').addEventListener('dblclick', function() { moveOptions('editAssignedClientGroups', 'editAvailableClientGroups'); });
    document.getElementById('editAvailablePackages').addEventListener('dblclick', function() { moveOptions('editAvailablePackages', 'editAssignedPackages'); });
    document.getElementById('editAssignedPackages').addEventListener('dblclick', function() { moveOptions('editAssignedPackages', 'editAvailablePackages'); });

    // Save button
    document.getElementById('saveEditFileBtn').addEventListener('click', function() {
        var assignedCG = document.getElementById('editAssignedClientGroups');
        var assignedPkg = document.getElementById('editAssignedPackages');
        if (assignedCG) {
            Array.from(assignedCG.options).forEach(function(option) { option.selected = true; });
        }
        if (assignedPkg) {
            Array.from(assignedPkg.options).forEach(function(option) { option.selected = true; });
        }
        if (form.checkValidity()) {
            form.submit();
        } else {
            form.reportValidity();
        }
    });

    // Initialize tooltips
    document.querySelectorAll('#editFileModal [data-bs-toggle="tooltip"]').forEach(function(el) {
        new bootstrap.Tooltip(el);
    });
})();
</script>
