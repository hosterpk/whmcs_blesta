<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('add_download');
    var type_public = document.getElementById('type_public');
    var type_logged_in = document.getElementById('type_logged_in');
    var file_type_upload = document.getElementById('file_type_upload');
    var file_type_path = document.getElementById('file_type_path');
    var available_to_client_groups = document.getElementById('available_to_client_groups');
    var available_to_packages = document.getElementById('available_to_packages');
    var file_name_input = document.getElementById('file_name');
    var uploads_dir = '<?php echo $this->Html->safe(str_replace('\\', '\\\\', $uploads_dir ?? '')); ?>';

    form.addEventListener('submit', function() {
        var assigned_client_groups = document.getElementById('assigned_client_groups');
        var assigned_packages = document.getElementById('assigned_packages');
        Array.from(assigned_client_groups.options).forEach(function(option) {
            option.selected = true;
        });
        Array.from(assigned_packages.options).forEach(function(option) {
            option.selected = true;
        });
    });

    if (type_logged_in.checked) {
        showLoggedInFields(true);
    }
    if (file_type_path.checked) {
        showFileFields('path');
    }
    if (file_type_upload.checked) {
        showFileFields('upload');
    }

    document.querySelectorAll('.client_group.move_left').forEach(function(btn) {
        btn.addEventListener('click', function() {
            moveOptions('available_client_groups', 'assigned_client_groups');
        });
    });
    document.querySelectorAll('.client_group.move_right').forEach(function(btn) {
        btn.addEventListener('click', function() {
            moveOptions('assigned_client_groups', 'available_client_groups');
        });
    });

    document.querySelectorAll('.packages.move_left').forEach(function(btn) {
        btn.addEventListener('click', function() {
            moveOptions('available_packages', 'assigned_packages');
        });
    });
    document.querySelectorAll('.packages.move_right').forEach(function(btn) {
        btn.addEventListener('click', function() {
            moveOptions('assigned_packages', 'available_packages');
        });
    });

    document.querySelectorAll('.type').forEach(function(radio) {
        radio.addEventListener('change', function() {
            showLoggedInFields(this.value === 'logged_in');
        });
    });

    available_to_client_groups.addEventListener('change', function() {
        showAvailableGroups('client_groups', this.checked);
    });
    available_to_packages.addEventListener('change', function() {
        showAvailableGroups('packages', this.checked);
    });

    document.querySelectorAll('.file_path').forEach(function(radio) {
        radio.addEventListener('change', function() {
            showFileFields(this.value);
        });
    });

    file_name_input.addEventListener('change', function() {
        if (this.value.includes(uploads_dir)) {
            this.classList.remove('border-danger');
        } else {
            this.classList.add('border-danger');
        }
    });

    function moveOptions(fromId, toId) {
        var from = document.getElementById(fromId);
        var to = document.getElementById(toId);
        Array.from(from.selectedOptions).forEach(function(option) {
            to.appendChild(option);
        });
    }

    function showLoggedInFields(show) {
        var logged_in_elements = document.querySelectorAll('.download_logged_in');
        logged_in_elements.forEach(function(el) {
            el.style.display = show ? 'block' : 'none';
        });
        if (show) {
            if (available_to_client_groups.checked) {
                showAvailableGroups('client_groups', true);
            }
            if (available_to_packages.checked) {
                showAvailableGroups('packages', true);
            }
        } else {
            showAvailableGroups('client_groups', false);
            showAvailableGroups('packages', false);
        }
    }

    function showAvailableGroups(type, show) {
        if (type === 'client_groups') {
            document.getElementById('download_client_groups').style.display = show ? 'block' : 'none';
        } else if (type === 'packages') {
            document.getElementById('download_packages').style.display = show ? 'block' : 'none';
        }
    }

    function showFileFields(type) {
        var file_upload = document.getElementById('file_upload');
        var file_full_path = document.getElementById('file_full_path');
        if (type === 'path') {
            file_full_path.style.display = 'block';
            file_upload.style.display = 'none';
        } else {
            file_upload.style.display = 'block';
            file_full_path.style.display = 'none';
        }
    }
});
</script>
