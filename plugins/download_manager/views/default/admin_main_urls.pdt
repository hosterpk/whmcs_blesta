        $this->Widget->setBodyWrapper(false);
        $this->Widget->setStyleSheet($this->view_dir . 'css/styles.css');
        $this->Widget->create($this->_('AdminMain.urls.boxtitle_downloadmanager', true), ['id' => 'urls_widget'], ($render_section ?? null));
        ?>
            <?php
