                    <thead>
                        <tr>
                            <th>
                                <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/download_manager/admin_main/urls/?sort=url&order=' . ($sort == 'url' ? $negate_order : $order)); ?>" class="ajax text-decoration-none">
                                    <?php $this->_('AdminMain.urls.heading_url'); ?>
