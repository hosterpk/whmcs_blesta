<!-- Edit File Modal (outside widget, content loaded via AJAX) -->
<div class="modal fade" id="editFileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="editFileModalContent">
        </div>
    </div>
</div>

<script>
(function() {
    // Prevent double-initialization
    if (window._dmFilesInitialized) return;
    window._dmFilesInitialized = true;

    // File icon mapping
    function getFileIcon(extension) {
        var iconMap = {
            'pdf': { icon: 'bi-file-earmark-pdf', color: 'text-danger' },
            'doc': { icon: 'bi-file-earmark-word', color: 'text-primary' },
            'docx': { icon: 'bi-file-earmark-word', color: 'text-primary' },
            'xls': { icon: 'bi-file-earmark-excel', color: 'text-success' },
            'xlsx': { icon: 'bi-file-earmark-excel', color: 'text-success' },
            'ppt': { icon: 'bi-file-earmark-ppt', color: 'text-warning' },
            'pptx': { icon: 'bi-file-earmark-ppt', color: 'text-warning' },
            'zip': { icon: 'bi-file-earmark-zip', color: 'text-secondary' },
            'rar': { icon: 'bi-file-earmark-zip', color: 'text-secondary' },
            '7z': { icon: 'bi-file-earmark-zip', color: 'text-secondary' },
            'txt': { icon: 'bi-file-earmark-text', color: 'text-info' },
            'csv': { icon: 'bi-file-earmark-text', color: 'text-info' },
            'jpg': { icon: 'bi-file-earmark-image', color: 'text-success' },
            'jpeg': { icon: 'bi-file-earmark-image', color: 'text-success' },
            'png': { icon: 'bi-file-earmark-image', color: 'text-success' },
            'gif': { icon: 'bi-file-earmark-image', color: 'text-success' },
            'mp3': { icon: 'bi-file-earmark-music', color: 'text-purple' },
            'wav': { icon: 'bi-file-earmark-music', color: 'text-purple' },
            'mp4': { icon: 'bi-file-earmark-play', color: 'text-danger' },
            'avi': { icon: 'bi-file-earmark-play', color: 'text-danger' },
            'sql': { icon: 'bi-file-earmark-code', color: 'text-warning' },
            'js': { icon: 'bi-file-earmark-code', color: 'text-warning' },
            'html': { icon: 'bi-file-earmark-code', color: 'text-warning' },
            'css': { icon: 'bi-file-earmark-code', color: 'text-warning' }
        };
        return iconMap[(extension || '').toLowerCase()] || { icon: 'bi-file-earmark', color: 'text-secondary' };
    }

    // Apply file icons to any newly rendered cards
    function applyFileIcons() {
        document.querySelectorAll('[data-extension]').forEach(function(iconEl) {
            var ext = iconEl.getAttribute('data-extension');
            var fileIcon = getFileIcon(ext);
            iconEl.className = 'response-folder-icon ' + fileIcon.color;
            var iconI = iconEl.querySelector('i');
            if (iconI) {
                iconI.className = 'bi ' + fileIcon.icon;
            }
        });
    }

    // Helper function to move options between select lists
    function moveOptions(fromId, toId) {
        var from = document.getElementById(fromId);
        var to = document.getElementById(toId);
        if (from && to) {
            Array.from(from.selectedOptions).forEach(function(option) {
                to.appendChild(option);
                option.selected = false;
            });
        }
    }

    // All click handling via document delegation
    document.addEventListener('click', function(e) {
        // Category card click - navigate
        var categoryCard = e.target.closest('[data-item-type="category"]');
        if (categoryCard && !e.target.closest('.response-folder-action-btn')) {
            var link = categoryCard.querySelector('.response-folder-link');
            if (link) {
                window.location.href = link.getAttribute('href');
            }
            return;
        }

        // File card click - download
        var fileCard = e.target.closest('[data-item-type="file"]');
        if (fileCard && !e.target.closest('.response-folder-action-btn')) {
            var link = fileCard.querySelector('.response-folder-link');
            if (link) {
                window.location.href = link.getAttribute('href');
            }
            return;
        }

        // Edit category button
        var editCatBtn = e.target.closest('[data-action="edit-category"]');
        if (editCatBtn) {
            e.stopPropagation();
            document.getElementById('categoryModalLabel').textContent = '<?php $this->_('AdminMain.files.edit'); ?>';
            document.getElementById('categoryId').value = editCatBtn.getAttribute('data-id');
            document.getElementById('categoryName').value = editCatBtn.getAttribute('data-name');
            document.getElementById('categoryDescription').value = editCatBtn.getAttribute('data-description');

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('categoryModal'));
            modal.show();
            return;
        }

        // Edit file button - load edit form into modal via AJAX
        var editFileBtn = e.target.closest('[data-action="edit-file"]');
        if (editFileBtn) {
            e.stopPropagation();
            var fileId = editFileBtn.getAttribute('data-id');
            var modalContent = document.getElementById('editFileModalContent');

            // Show modal with loading spinner
            modalContent.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
            var editModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editFileModal'));
            editModal.show();

            // Fetch edit form via AJAX
            fetch('<?php echo $this->Html->safe($this->base_uri . 'plugin/download_manager/admin_main/edit/'); ?>' + fileId, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(response) { return response.text(); })
            .then(function(html) {
                modalContent.innerHTML = html;
                // Execute scripts in injected content
                modalContent.querySelectorAll('script').forEach(function(oldScript) {
                    var newScript = document.createElement('script');
                    newScript.textContent = oldScript.textContent;
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });
            });
            return;
        }

        // Add category button - reset form
        if (e.target.closest('#addCategoryBtn')) {
            document.getElementById('categoryModalLabel').textContent = '<?php $this->_('AdminMain.files.add_category'); ?>';
            document.getElementById('categoryForm').reset();
            document.getElementById('categoryId').value = '';
            document.getElementById('categoryDescription').value = '';
            return;
        }

        // Add download button - reset form
        if (e.target.closest('#addDownloadBtn')) {
            document.getElementById('downloadModalLabel').textContent = '<?php $this->_('AdminMain.files.add_download'); ?>';
            document.getElementById('downloadForm').reset();
            document.getElementById('downloadId').value = '';
            // Reset logged-in sections visibility
            document.querySelectorAll('.download_logged_in').forEach(function(s) { s.style.display = 'none'; });
            document.getElementById('modalDownloadClientGroups').style.display = 'none';
            document.getElementById('modalDownloadPackages').style.display = 'none';
            document.getElementById('uploadSection').style.display = 'block';
            document.getElementById('pathSection').style.display = 'none';
            return;
        }

        // Save category button
        if (e.target.closest('#saveCategoryBtn')) {
            var form = document.getElementById('categoryForm');
            if (form.checkValidity()) {
                form.submit();
            } else {
                form.reportValidity();
            }
            return;
        }

        // Save download button
        if (e.target.closest('#saveDownloadBtn')) {
            var form = document.getElementById('downloadForm');
            // Select all assigned options before submitting
            var assignedClientGroups = document.getElementById('modalAssignedClientGroups');
            var assignedPackages = document.getElementById('modalAssignedPackages');
            if (assignedClientGroups) {
                Array.from(assignedClientGroups.options).forEach(function(option) { option.selected = true; });
            }
            if (assignedPackages) {
                Array.from(assignedPackages.options).forEach(function(option) { option.selected = true; });
            }
            if (form.checkValidity()) {
                form.submit();
            } else {
                form.reportValidity();
            }
            return;
        }
    });

    // Change handling via document delegation
    document.addEventListener('change', function(e) {
        // Toggle public/logged-in access
        if (e.target.matches('#downloadModal input[name="type"]')) {
            var showLoggedIn = e.target.value === 'logged_in';
            document.querySelectorAll('.download_logged_in').forEach(function(section) {
                section.style.display = showLoggedIn ? 'block' : 'none';
            });
            if (!showLoggedIn) {
                document.getElementById('modalDownloadClientGroups').style.display = 'none';
                document.getElementById('modalDownloadPackages').style.display = 'none';
            }
            return;
        }

        // Client groups checkbox
        if (e.target.matches('#modalAvailableToClientGroups')) {
            document.getElementById('modalDownloadClientGroups').style.display = e.target.checked ? 'block' : 'none';
            return;
        }

        // Packages checkbox
        if (e.target.matches('#modalAvailableToPackages')) {
            document.getElementById('modalDownloadPackages').style.display = e.target.checked ? 'block' : 'none';
            return;
        }

        // File source toggle (upload/path)
        if (e.target.matches('#downloadModal input[name="file_type"]')) {
            document.getElementById('uploadSection').style.display = e.target.value === 'upload' ? 'block' : 'none';
            document.getElementById('pathSection').style.display = e.target.value === 'path' ? 'block' : 'none';
            return;
        }
    });

    // Dual-select move buttons via delegation
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.dual-select-btn');
        if (!btn) return;

        if (btn.classList.contains('modal_client_group')) {
            if (btn.classList.contains('move_left')) moveOptions('modalAvailableClientGroups', 'modalAssignedClientGroups');
            if (btn.classList.contains('move_right')) moveOptions('modalAssignedClientGroups', 'modalAvailableClientGroups');
        }
        if (btn.classList.contains('modal_packages')) {
            if (btn.classList.contains('move_left')) moveOptions('modalAvailablePackages', 'modalAssignedPackages');
            if (btn.classList.contains('move_right')) moveOptions('modalAssignedPackages', 'modalAvailablePackages');
        }
    });

    // Double-click to move in dual-select
    document.addEventListener('dblclick', function(e) {
        if (e.target.closest('#modalAvailableClientGroups')) moveOptions('modalAvailableClientGroups', 'modalAssignedClientGroups');
        if (e.target.closest('#modalAssignedClientGroups')) moveOptions('modalAssignedClientGroups', 'modalAvailableClientGroups');
        if (e.target.closest('#modalAvailablePackages')) moveOptions('modalAvailablePackages', 'modalAssignedPackages');
        if (e.target.closest('#modalAssignedPackages')) moveOptions('modalAssignedPackages', 'modalAvailablePackages');
    });

    // Apply file icons on initial load
    applyFileIcons();

    // Re-apply file icons after AJAX widget reload via MutationObserver
    var widget = document.getElementById('files_widget');
    if (widget) {
        new MutationObserver(function() {
            applyFileIcons();
        }).observe(widget, { childList: true, subtree: true });
    }
})();
</script>
