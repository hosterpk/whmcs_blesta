<?php /** @var View $this */ ?>

<?php
echo (isset($message) ? $message : null);

$widget_title = $this->_('AdminMain.addcategory.boxtitle_root', true, $this->_('AdminMain.!text.root_directory', true));
if (!empty($category))
    $widget_title = $this->_('AdminMain.addcategory.boxtitle_addcategory', true, (isset($category->name) ? $category->name : null));

$this->Widget->clear();
$this->Widget->setBodyWrapper(false);
$this->Widget->create($widget_title);

$this->Form->create(null, ['class' => 'disable-on-submit']);
?>
<div class="card-body">
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.addcategory.field_name', true), 'name', ['class' => 'form-label']);
        $this->Form->fieldText('name', (isset($vars->name) ? $vars->name : null), ['id' => 'name', 'class' => 'form-control']);
        ?>
    </div>
    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.addcategory.field_description', true), 'description', ['class' => 'form-label']);
        $this->Form->fieldTextarea('description', (isset($vars->description) ? $vars->description : null), ['id' => 'description', 'class' => 'form-control', 'data-markdown-editor' => '']);
        ?>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <a class="btn btn-outline-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/download_manager/admin_main/files/' . ($category->id ?? null)); ?>"><?php $this->_('AdminMain.addcategory.submit_cancel'); ?></a>
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminMain.addcategory.submit_add', true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Form->end();
$this->Widget->end();
?>
