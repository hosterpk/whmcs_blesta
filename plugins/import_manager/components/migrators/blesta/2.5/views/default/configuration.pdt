<?php /** @var View $this */ ?>

<?php
$this->Form->fieldHidden('step', 'configuration');
$this->Form->fieldHidden('host', ($vars->host ?? null));
$this->Form->fieldHidden('database', ($vars->database ?? null));
$this->Form->fieldHidden('user', ($vars->user ?? null));
$this->Form->fieldHidden('pass', ($vars->pass ?? null));
$this->Form->fieldHidden('key', ($vars->key ?? null));
?>

<div class="mb-3">
    <div class="form-check">
        <?php
        $this->Form->fieldRadio('create_packages', 'true', ($vars->create_packages ?? 'true') == 'true', ['id' => 'create_packages_true', 'class' => 'form-check-input']);
        $this->Form->label($this->_('Blesta2_5.configuration.create_packages_true', true), 'create_packages_true', ['class' => 'form-check-label']);
        ?>
    </div>
    <div class="form-check">
        <?php
        $this->Form->fieldRadio('create_packages', 'false', ($vars->create_packages ?? null) == 'false', ['id' => 'create_packages_false', 'class' => 'form-check-input']);
        $this->Form->label($this->_('Blesta2_5.configuration.create_packages_false', true), 'create_packages_false', ['class' => 'form-check-label']);
        ?>
    </div>
</div>

<div class="map_packages">
    <?php
    if (($local_packages ?? null)) {
        ?>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><?php $this->_('Blesta2_5.configuration.remote_package');?></th>
                    <th><?php $this->_('Blesta2_5.configuration.local_package');?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                foreach ($remote_packages as $package) {
                    ?>
                <tr>
                    <td>
                        <?php
                        $this->Form->fieldHidden('remote_packages[]', $package->id);
                        echo (isset($package->name) ? $this->Html->safe($package->name) : null);
                        ?>
                    </td>
                    <td>
                        <?php
                        $this->Form->fieldSelect('local_packages[]', ['' => 'Do not import'] + (array)$this->Form->collapseObjectArray($local_packages, 'name', 'id'), null, ['class' => 'form-select']);
                        ?>
                    </td>
                </tr>
                    <?php
                }
                ?>
            </tbody>
        </table>
    </div>
        <?php
    } else {
        ?>
    <div class="text-center text-muted py-4">
        <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.3;"></i>
        <p class="mt-2 mb-0"><?php $this->_('Blesta2_5.configuration.no_local_packages');?></p>
    </div>
        <?php
    }
    ?>
</div>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var mapPackages = document.querySelector('.map_packages');
        var radioButtons = document.querySelectorAll('input[name="create_packages"]');

        function renderPackages() {
            var checked = document.querySelector('input[name="create_packages"]:checked');
            if (checked && checked.value === 'true') {
                mapPackages.style.display = 'none';
            } else {
                mapPackages.style.display = 'block';
            }
        }

        radioButtons.forEach(function(radio) {
            radio.addEventListener('change', renderPackages);
        });

        renderPackages();
    });
</script>