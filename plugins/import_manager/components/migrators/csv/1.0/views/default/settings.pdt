<?php /** @var View $this */ ?>

<?php
$this->Form->fieldHidden('step', 'settings');
?>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Csv1_0.settings.csv_data', true), 'csv_data', ['class' => 'form-label']);
    $this->Form->fieldTextarea('csv_data', ($vars->csv_data ?? null), ['id' => 'csv_data', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3 form-check">
    <?php
    $this->Form->fieldCheckbox('enable_debug', 'true', ($vars->enable_debug ?? null) == 'true', ['id' => 'enable_debug', 'class' => 'form-check-input']);
    $this->Form->label($this->_('Csv1_0.settings.enable_debug', true), 'enable_debug', ['class' => 'form-check-label']);
    ?>
</div>