<?php /** @var View $this */ ?>

<?php
$this->Form->fieldHidden('step', 'settings');
?>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Clientexec5_5.settings.host', true), 'host', ['class' => 'form-label']);
    $this->Form->fieldText('host', ($vars->host ?? null), ['id' => 'host', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Clientexec5_5.settings.database', true), 'database', ['class' => 'form-label']);
    $this->Form->fieldText('database', ($vars->database ?? null), ['id' => 'database', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Clientexec5_5.settings.user', true), 'user', ['class' => 'form-label']);
    $this->Form->fieldText('user', ($vars->user ?? null), ['id' => 'user', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Clientexec5_5.settings.pass', true), 'pass', ['class' => 'form-label']);
    $this->Form->fieldPassword('pass', ['id' => 'pass', 'class' => 'form-control', 'value' => ($vars->pass ?? null)]);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Clientexec5_5.settings.passphrase', true), 'passphrase', ['class' => 'form-label']);
    $this->Form->fieldPassword('passphrase', ['id' => 'passphrase', 'class' => 'form-control', 'value' => ($vars->passphrase ?? null)]);
    ?>
</div>
<div class="mb-3 form-check">
    <?php
    $this->Form->fieldCheckbox('enable_debug', 'true', ($vars->enable_debug ?? null) == 'true', ['id' => 'enable_debug', 'class' => 'form-check-input']);
    $this->Form->label($this->_('Clientexec5_5.settings.enable_debug', true), 'enable_debug', ['class' => 'form-check-label']);
    ?>
</div>