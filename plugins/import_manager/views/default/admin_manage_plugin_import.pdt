<?php /** @var View $this */ ?>

<?php
echo ($message ?? null);

$this->Widget->clear();
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('ImportManagerManagePlugin.import.boxtitle_importmanager', true, ($info->name ?? null), ($version ?? null)));

$this->Form->create();
$this->Form->fieldHidden('import', 'true');
?>
<div class="card-body">
    <?php
    echo ($content ?? null);
    ?>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/plugins/manage/' . ($plugin_id ?? null) . '/' . ($category->id ?? null));?>" class="btn btn-secondary"><?php $this->_('ImportManagerManagePlugin.import.cancel');?></a>
    <?php
    $this->Form->fieldSubmit('save', $this->_('ImportManagerManagePlugin.import.' . (($continue ?? null) ? 'continue' : 'submit'), true), ['class' => 'btn btn-primary']);
    ?>
</div>
<?php
$this->Form->end();
$this->Widget->end();
?>
