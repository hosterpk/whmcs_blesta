<?xml version="1.0" encoding="UTF-8"?>
<!--
  Diversified redaction placeholders (Story 5.4 AC4). Every PII/credential value
  below is a redacted placeholder in a MIXED style: dashed/spaced/international
  mobile, dashed and undashed CNIC, and mixed REDACTED_* casings. This fixture
  must stay clean: the broadened leak-scan forbidden patterns must NOT match any
  value here (the digit-shaped patterns are dodged by using X placeholders).
-->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <InsertVoucher xmlns="https://app.kuickpay.com/kuickpaycoreapi/">
      <userName>REDACTED_USERNAME</userName>
      <password>redacted_password</password>
      <InstitutionID>INSTITUTION_ID</InstitutionID>
      <CustomerName>REDACTED_CUSTOMER_NAME</CustomerName>
      <Mobile>0300XXXXXXX</Mobile>
      <MobileNo>0300-XXXXXXX</MobileNo>
      <AltMobile>0300 XXXXXXX</AltMobile>
      <IntlMobile>+92-3XX-XXXXXXX</IntlMobile>
      <CNIC>XXXXX-XXXXXXX-X</CNIC>
      <CNICUndashed>XXXXXXXXXXXXX</CNICUndashed>
      <Email>customer@example.invalid</Email>
      <Branch>REDACTED_BRANCH</Branch>
    </InsertVoucher>
  </soap:Body>
</soap:Envelope>
