<?php /** @var View $this **/ ?>

<?php
echo ($message ?? null);

$empty = $this->_('AdminVouchers.text.empty', true);
$run_status = (string) ($run->status ?? '');

$dateOr = function ($value) use ($empty) {
    return $value ? $this->Html->safe($this->Date->cast($value)) : $empty;
};

$mono = function ($value) use ($empty) {
    $value = (string) ($value ?? '');
    if ($value === '') {
        return $empty;
    }

    return '<span class="font-monospace">' . $this->Html->safe($value) . '</span>';
};

$num = function ($value) {
    return $this->Html->safe((string) (int) $value);
};
?>

<p>
    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/kuickpay_reconcile/admin_reconciliation/index/');?>" class="btn btn-link ps-0">
        <i class="bi bi-arrow-left"></i> <?php echo $this->_('AdminReconciliation.link.back_to_runs', true);?>
    </a>
</p>

<?php
// --- Box 1: Run header + count breakdown ---------------------------------
$this->Widget->clear();
$this->Widget->create($this->_('AdminReconciliation.detail.boxtitle', true) . ' #' . $this->Html->safe($run->id));
?>
<table class="table table-sm mb-0">
    <tbody>
        <tr>
            <th class="w-25"><?php echo $this->_('AdminReconciliation.heading.type', true);?></th>
            <td><?php echo $this->Html->safe($this->_($presenter->triggerTypeLabelKey($run->trigger_type), true));?></td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.heading.status', true);?></th>
            <td>
                <span class="badge <?php echo $presenter->runStatusBadgeClassFor($run_status);?>">
                    <?php echo $this->Html->safe($this->_($presenter->runStatusLabelKey($run_status), true));?>
                </span>
            </td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.heading.started', true);?></th>
            <td><?php echo $dateOr($run->date_started);?></td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.heading.completed', true);?></th>
            <td><?php echo $dateOr($run->date_completed);?></td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.heading.run_date', true);?></th>
            <td><?php echo ($run->trigger_type === 'bulk' ? $dateOr($run->run_date) : $empty);?></td>
        </tr>
    </tbody>
</table>

<?php if ($run_status === 'running') { ?>
    <div class="alert alert-info mt-3 mb-0">
        <i class="bi bi-info-circle"></i> <?php echo $this->_('AdminReconciliation.detail.running_note', true);?>
    </div>
<?php } ?>

<h3 class="h6 mt-3 mb-2"><?php echo $this->_('AdminReconciliation.detail.heading.counts', true);?></h3>
<table class="table table-sm mb-2" style="max-width:32rem;">
    <tbody>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.count.checked', true);?></th>
            <td class="text-end font-monospace"><?php echo $num($run->total_checked);?></td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.count.confirmed', true);?></th>
            <td class="text-end font-monospace"><?php echo $num($run->total_confirmed);?></td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.count.manual_review', true);?></th>
            <td class="text-end font-monospace"><?php echo $num($run->total_manual_review);?></td>
        </tr>
        <tr>
            <th class="ps-4"><?php echo $this->_('AdminReconciliation.count.unmatched', true);?></th>
            <td class="text-end font-monospace"><?php echo $num($run->total_unmatched);?></td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.count.failed', true);?></th>
            <td class="text-end font-monospace"><?php echo $num($run->total_failed);?></td>
        </tr>
        <tr>
            <th><?php echo $this->_('AdminReconciliation.count.errors', true);?></th>
            <td class="text-end font-monospace"><?php echo $num($run->total_errors);?></td>
        </tr>
    </tbody>
</table>
<div class="small text-muted">
    <p class="mb-1"><?php echo $this->_('AdminReconciliation.footnote.posting', true);?></p>
    <p class="mb-1"><?php echo $this->_('AdminReconciliation.footnote.unmatched_subset', true);?></p>
    <p class="mb-1"><?php echo $this->_('AdminReconciliation.footnote.eligible', true);?></p>
    <p class="mb-0"><?php echo $this->_('AdminReconciliation.footnote.failed_errors', true);?></p>
</div>
<?php
$this->Widget->end();

// --- Box 2: Matched item transitions (drill into voucher detail) ---------
$this->Widget->clear();
$this->Widget->create($this->_('AdminReconciliation.detail.heading.items', true));

if (($items ?? false) && ($num_items = count($items)) > 0) {
    if ((int) ($item_total ?? 0) > (int) ($item_limit ?? 0)) {
        ?>
        <div class="alert alert-warning mb-0">
            <?php echo $this->_('AdminReconciliation.detail.items_truncated', true, (int) $item_limit, (int) $item_total);?>
        </div>
        <?php
    }
    ?>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="reconciliation_items_table">
            <thead>
                <tr>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.voucher', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.transition', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.failure_class', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.trace', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.when', true);?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                for ($i = 0; $i < $num_items; $i++) {
                    $item = $items[$i];
                    $prior = (string) ($item->prior_status ?? '');
                    $new = (string) ($item->new_status ?? '');
                ?>
                <tr>
                    <td>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/kuickpay_reconcile/admin_vouchers/detail/' . $item->voucher_id . '/');?>" class="font-monospace">
                            #<?php echo $this->Html->safe($item->voucher_id);?>
                        </a>
                    </td>
                    <td>
                        <span class="badge <?php echo $presenter->badgeClassFor($prior);?>">
                            <?php echo $this->Html->safe($this->_($presenter->labelKeyFor($prior), true));?>
                        </span>
                        <i class="bi bi-arrow-right"></i>
                        <span class="badge <?php echo $presenter->badgeClassFor($new);?>">
                            <?php echo $this->Html->safe($this->_($presenter->labelKeyFor($new), true));?>
                        </span>
                    </td>
                    <td>
                        <?php
                        echo ($item->error_class !== null
                            ? $this->Html->safe($this->_($presenter->errorClassLabelKey($item->error_class), true))
                            : $empty);
                        ?>
                    </td>
                    <td><?php echo $mono($item->redacted_trace_id);?></td>
                    <td><?php echo $dateOr($item->date_created);?></td>
                </tr>
                <?php } ?>
            </tbody>
        </table>
    </div>
    <?php
} else {
    ?>
    <div class="card-body text-center text-muted py-4">
        <p class="mb-0"><?php echo $this->_('AdminReconciliation.detail.no_items', true);?></p>
    </div>
    <?php
}
$this->Widget->end();

// --- Box 3: Audit-only bulk exceptions (unmatched / duplicate) -----------
// These write NO item row; they are the per-row evidence behind the run's
// total_unmatched count (AC3). The payload is already past the single
// redaction boundary — render it as one escaped blob, never a per-key echo.
$this->Widget->clear();
$this->Widget->create($this->_('AdminReconciliation.detail.heading.audit_exceptions', true));

if (($audit_exceptions ?? false) && ($num_audit = count($audit_exceptions)) > 0) {
    ?>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="reconciliation_audit_table">
            <thead>
                <tr>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.event', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.voucher', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.trace', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.evidence', true);?></th>
                    <th><?php echo $this->_('AdminReconciliation.detail.heading.when', true);?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                for ($i = 0; $i < $num_audit; $i++) {
                    $row = $audit_exceptions[$i];

                    // Pretty-print the already-redacted payload as one escaped blob.
                    $payload_raw = (string) ($row->payload ?? '');
                    $decoded_payload = json_decode($payload_raw, true);
                    if (is_array($decoded_payload)) {
                        $encoded = json_encode(
                            $decoded_payload,
                            JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE
                        );
                        $payload_out = $encoded !== false ? $encoded : $payload_raw;
                    } else {
                        $payload_out = $payload_raw;
                    }
                ?>
                <tr>
                    <td><?php echo $this->Html->safe($this->_($presenter->eventLabelKey((string) ($row->event_name ?? '')), true));?></td>
                    <td>
                        <?php
                        // Only the duplicate echo carries a voucher_id; an
                        // unmatched row has none, so render evidence only — no
                        // voucher link and no next action.
                        if (!empty($row->voucher_id)) {
                            ?>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/kuickpay_reconcile/admin_vouchers/detail/' . $row->voucher_id . '/');?>" class="font-monospace">
                                #<?php echo $this->Html->safe($row->voucher_id);?>
                            </a>
                            <?php
                        } else {
                            echo $empty;
                        }
                        ?>
                    </td>
                    <td><?php echo $mono($row->redacted_trace_id);?></td>
                    <td>
                        <?php
                        if ($payload_out !== '' && $payload_out !== 'null') {
                            echo '<pre class="mb-0 small font-monospace">' . $this->Html->safe($payload_out) . '</pre>';
                        } else {
                            echo $empty;
                        }
                        ?>
                    </td>
                    <td><?php echo $dateOr($row->date_created);?></td>
                </tr>
                <?php } ?>
            </tbody>
        </table>
    </div>
    <?php
} else {
    ?>
    <div class="card-body text-center text-muted py-4">
        <p class="mb-0"><?php echo $this->_('AdminReconciliation.detail.no_audit_exceptions', true);?></p>
    </div>
    <?php
}
$this->Widget->end();
?>
