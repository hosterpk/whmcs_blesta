<?php /** @var View $this **/ ?>

<?php
echo ($message ?? null);

$empty = $this->_('AdminVouchers.text.empty', true);

// Per-row "next allowed action" is derived from the single source of truth
// (KuickpayVouchers::ALLOWED_ACTIONS_BY_STATE) intersected with the gated
// permission booleans. The labels and the permission flags are paired here;
// the queue only links to the action form on the voucher detail page (4.3) —
// it never re-hosts the mutating POST handlers.
$action_labels = [
    'recheck' => 'AdminVouchers.action.recheck',
    'review' => 'AdminVouchers.action.review',
    'cancel' => 'AdminVouchers.action.cancel',
];
$action_perms = [
    'recheck' => !empty($can_recheck),
    'review' => !empty($can_review),
    'cancel' => !empty($can_cancel),
];

$this->Widget->clear();
$this->Widget->create($this->_('AdminManualReview.index.boxtitle', true), ['id' => 'admin_manual_review']);

if (($vouchers ?? false) && ($num_vouchers = count($vouchers)) > 0) {
?>
<div class="table-responsive">
    <table class="table table-hover mb-0" id="manual_review_table">
        <thead>
            <tr>
                <th><?php echo $this->_('AdminManualReview.heading.reason', true);?></th>
                <th><?php echo $this->_('AdminManualReview.heading.client', true);?></th>
                <th><?php echo $this->_('AdminManualReview.heading.invoice', true);?></th>
                <th><?php echo $this->_('AdminManualReview.heading.amount', true);?></th>
                <th><?php echo $this->_('AdminManualReview.heading.consumer_number', true);?></th>
                <th><?php echo $this->_('AdminManualReview.heading.last_inquiry', true);?></th>
                <th><?php echo $this->_('AdminManualReview.heading.next_action', true);?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            for ($i = 0; $i < $num_vouchers; $i++) {
                $voucher = $vouchers[$i];
                $client_code = $clients_by_id[$voucher->client_id] ?? $voucher->client_id;
                $links = $invoices_by_voucher[$voucher->id] ?? [];

                // Reason summary: a null error_class on a manual_review voucher
                // means "duplicate or ambiguous evidence". errorClassLabelKey(null)
                // returns the generic "Unknown" key, so branch explicitly here.
                $reason_key = ($voucher->error_class === null)
                    ? 'AdminVouchers.posting_state.manual_review'
                    : $presenter->errorClassLabelKey($voucher->error_class);

                // First permitted action for this row, in matrix order.
                $next_action = null;
                $allowed_actions = KuickpayVouchers::ALLOWED_ACTIONS_BY_STATE[$voucher->status] ?? [];
                foreach ($allowed_actions as $candidate) {
                    if (!empty($action_perms[$candidate])) {
                        $next_action = $candidate;
                        break;
                    }
                }
                $detail_url = $this->Html->safe(
                    $this->base_uri . 'plugin/kuickpay_reconcile/admin_vouchers/detail/' . $voucher->id . '/'
                );
            ?>
            <tr>
                <td><?php echo $this->Html->safe($this->_($reason_key, true));?></td>
                <td>
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'clients/view/' . $voucher->client_id . '/');?>">
                        <?php echo $this->Html->safe($client_code);?>
                    </a>
                </td>
                <td>
                    <?php
                    if (!empty($links)) {
                        $invoice_cells = [];
                        foreach ($links as $link) {
                            $invoice_cells[] = '<a href="'
                                . $this->Html->safe($this->base_uri . 'clients/editinvoice/' . $voucher->client_id . '/' . $link['invoice_id'] . '/')
                                . '">' . $this->Html->safe($link['invoice_id']) . '</a>';
                        }
                        echo implode(', ', $invoice_cells);
                    } else {
                        echo $empty;
                    }
                    ?>
                </td>
                <td><span class="font-monospace"><?php echo $this->Html->safe($voucher->amount) . ' ' . $this->Html->safe($voucher->currency);?></span></td>
                <td>
                    <a href="<?php echo $detail_url;?>" class="font-monospace">
                        <?php echo $this->Html->safe($voucher->consumer_number);?>
                    </a>
                </td>
                <td>
                    <?php
                    echo ($voucher->date_last_checked
                        ? $this->Html->safe($this->Date->cast($voucher->date_last_checked))
                        : $empty);
                    ?>
                </td>
                <td>
                    <?php
                    if ($next_action !== null) {
                        ?>
                        <a href="<?php echo $detail_url;?>">
                            <?php echo $this->Html->safe($this->_($action_labels[$next_action], true));?>
                        </a>
                        <?php
                    } else {
                        echo $empty;
                    }
                    ?>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>
<?php
} else {
?>
<div class="card-body text-center text-muted py-5">
    <i class="bi bi-clipboard-check" style="font-size: 3rem; opacity: 0.3;"></i>
    <p class="mt-3 mb-0"><?php echo $this->_('AdminManualReview.no_results', true);?></p>
</div>
<?php
}

if (isset($this->Pagination) && $this->Pagination->hasPages()) {
    $this->Widget->footer();
    $this->Pagination->build();
}

$this->Widget->end();
?>
