<?php /** @var View $this */ ?>

<?php
echo (isset($message) ? $message : null);

$link_buttons = [
    [
        'icon' => 'bi bi-plus-lg',
        'name' => '',
        'attributes' => [
            'title' => $this->_('AdminMain.index.categorylink_compose', true),
            'href' => $this->Html->safe($this->base_uri . 'plugin/mass_mailer/admin_filter/')
        ]
    ]
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setWidgetButton(['href' => $this->base_uri . 'plugin/mass_mailer/admin_main/settings/', 'class'=>'setting']);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_('AdminMain.index.boxtitle', true),
    ['id' => 'admin_main_mailer'],
    (isset($render_section) ? $render_section : null)
);
?>
    <?php
    if (count((isset($jobs) ? $jobs : [])) > 0) {
    ?>
    <table class="table table-hover mb-0" id="mass-mailer-jobs">
        <thead>
            <tr>
                <th class="icon" title="<?php $this->_('AdminMain.index.heading_type');?>"></th>
                <th><?php $this->_('AdminMain.index.heading_date');?></th>
                <th><?php $this->_('AdminMain.index.heading_status');?></th>
                <th><?php $this->_('AdminMain.index.heading_complete');?></th>
                <th><?php $this->_('AdminMain.index.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
        <?php
        foreach ($jobs as $job) {
            $total_tasks = max((int)(isset($job->task_count) ? $job->task_count : 0), 0);
            $completed_tasks = ($total_tasks - (int)(isset($job->total_tasks) ? $job->total_tasks : 0));

            // Determine the icon to show based on the job type
            $icon = 'bi-box-arrow-up-right';
            $icon_title = 'AdminMain.index.type.export';
            if (!empty($job->email)) {
                $icon = 'bi-envelope-open';
                $icon_title = 'AdminMain.index.type.email';
            }
        ?>
        <tr data-collapse-row aria-expanded="false" style="cursor: pointer;">
            <td>
                <i class="bi <?php echo (isset($icon) ? $this->Html->safe($icon) : null);?>" title="<?php $this->_($icon_title);?>"></i>
            </td>
            <td>
                <?php echo $this->Date->cast((isset($job->date_added) ? $job->date_added : null), 'date_time');?>
            </td>
            <td>
                <?php echo (isset($statuses[$job->status]) ? $statuses[$job->status] : null);?>
            </td>
            <td>
                <?php $this->_('AdminMain.index.job_task_total', false, $completed_tasks, $total_tasks);?>
            </td>
            <td>
                <?php
                // Link to the export
                if (empty($job->email) && $job->status === 'complete') {
                ?>
                <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/mass_mailer/admin_main/download/' . (isset($job->id) ? $job->id : null));?>"><?php $this->_('AdminMain.index.option_export');?></a>
                <?php
                }
                ?>
            </td>
        </tr>
        <tr class="collapse">
            <td colspan="5" style="padding: 0; background-color: var(--bg-secondary);">
                <?php
                if (!empty($job->email)) {
                ?>
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr>
                            <th class="border-top-0" style="width: 120px;"><?php $this->_('AdminMain.index.email_to');?></th>
                            <td class="border-top-0"><?php $this->_('AdminMain.index.email_to_recipients', false, (isset($job->task_count) ? $this->Html->safe($job->task_count) : null));?></td>
                        </tr>
                        <tr>
                            <th><?php $this->_('AdminMain.index.email_from');?></th>
                            <td><a href="mailto:<?php echo (isset($job->email->from_address) ? $this->Html->safe($job->email->from_address) : null);?>"><?php echo (isset($job->email->from_name) ? $this->Html->safe($job->email->from_name) : null);?></a></td>
                        </tr>
                        <tr>
                            <th><?php $this->_('AdminMain.index.email_subject');?></th>
                            <td><?php echo (isset($job->email->subject) ? $this->Html->safe($job->email->subject) : null);?></td>
                        </tr>
                        <tr>
                            <td colspan="2"><?php echo nl2br($this->Html->hyperlink((isset($job->email->text) ? $this->Html->safe($job->email->text) : '')));?></td>
                        </tr>
                    </tbody>
                </table>
                <?php
                } else {
                ?>
                <div class="text-center text-muted py-4">
                    <i class="bi bi-file-earmark-spreadsheet" style="font-size: 2rem; opacity: 0.3;"></i>
                    <p class="mt-2 mb-0"><?php $this->_('AdminMain.index.no_export_details');?></p>
                </div>
                <?php
                }
                ?>
            </td>
        </tr>
        <?php
        }
        ?>
        </tbody>
    </table>
    <?php
    if (isset($this->Pagination) && $this->Pagination->hasPages()) {
        $this->Widget->footer();
        $this->Pagination->build();
    }
    ?>
    <?php
    } else {
    ?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-envelope" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('AdminMain.index.no_results');?></p>
    </div>
    <?php
    }
    ?>
    <script>
        <?php
        if ((isset($set_timer) ? $set_timer : null)) {
        ?>
        // Global timer
        var mass_mailer_refresh_timer;
        <?php
        }
        ?>

        (function() {
            // If a timer is set, end it before starting a new one
            if (mass_mailer_refresh_timer) {
                MassMailerStopTimer();
            }
            <?php
            if ((isset($page) ? $page : null) == '1') {
            ?>
            mass_mailer_refresh_timer = MassMailerStartTimer();
            <?php
            }
            ?>

            if (mass_mailer_refresh_timer) {
                var table = document.getElementById('mass-mailer-jobs');
                if (table) {
                    table.addEventListener('click', function(e) {
                        var row = e.target.closest('[data-collapse-row]');
                        if (!row) return;

                        // Check if any detail row is expanded
                        var open = table.querySelectorAll('tr.collapse.show').length > 0;

                        if (open) {
                            MassMailerStopTimer();
                        } else {
                            mass_mailer_refresh_timer = MassMailerStartTimer();
                        }
                    });
                }
            }
        })();

        function MassMailerStartTimer() {
            return setTimeout(function() {
                blestaRequest(
                    'GET',
                    '<?php echo $this->Html->safe($this->base_uri . 'plugin/mass_mailer/admin_main/');?>',
                    null,
                    function(data) {
                        var widget = document.getElementById('admin_main_mailer');
                        if (data && data.content && widget) {
                            if (data.replacer == null) {
                                widget.innerHTML = data.content;
                            } else {
                                var target = widget.querySelector(data.replacer);
                                if (target) {
                                    target.innerHTML = data.content;
                                }
                            }
                        }
                    },
                    null,
                    {dataType: 'json'}
                );
            }, 30000);
        }
        function MassMailerStopTimer() {
            if (mass_mailer_refresh_timer) {
                clearTimeout(mass_mailer_refresh_timer);
            }
        }
    </script>
<?php
$this->Widget->end();
