<?php /** @var View $this */ ?>

        <?php
        $this->Widget->clear();
        $this->Widget->setBodyWrapper(false);
        $this->Widget->setWidgetButton(['href' => $this->base_uri . 'plugin/mass_mailer/admin_main/index/', 'class'=>'setting']);
        $this->Widget->create(
            $this->_('AdminMain.settings.boxtitle', true),
            ['id' => 'admin_main_mailer'],
            ($render_section ?? null)
        );

        $this->Form->create($this->Html->safe($this->base_uri . 'plugin/mass_mailer/admin_main/update/'));
        ?>
        <div class="card-body">
            <h6 class="form-section-header"><?php $this->_('AdminMain.settings.heading');?></h6>

            <div class="mb-3">
                <label class="form-label" for="rate_limit">
                    <?php $this->_('AdminMain.settings.form.rate_limit');?>
                    <span data-bs-toggle="tooltip" data-bs-title="<?php $this->_('AdminMain.!tooltip.rate_limit');?>"><i class="bi bi-info-circle"></i></span>
                </label>
                <?php $this->Form->fieldNumber('rate_limit', ($vars->rate_limit ?? null), 0, null, 1, ['id' => 'rate_limit', 'class' => 'form-control']);?>
            </div>
        </div>

        <?php $this->Widget->footer(); ?>
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-secondary" href="<?php echo $this->Html->safe($this->base_uri);?>plugin/mass_mailer/admin_main/index/"><?php $this->_('AdminMain.settings.submit_cancel');?></a>
            <?php
            $this->Form->fieldSubmit('save', $this->_('AdminMain.settings.submit_settings', true), ['class' => 'btn btn-primary']);
            ?>
        </div>

        <?php
        $this->Form->end();

        $this->Widget->end();
        ?>
