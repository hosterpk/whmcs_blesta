
        <?php
        $this->Widget->clear();
        $this->Widget->create(
            $this->_('AdminMain.settings.boxtitle', true),
            ['id' => 'admin_main_mailer'],
            ($render_section ?? null)
        );

        $this->Form->create($this->Html->safe($this->base_uri . 'plugin/mass_mailer/admin_main/update/'));
        ?>
        <div class="inner">
            <div class="title_row first"><h3><?php $this->_('AdminMain.settings.heading');?></h3></div>
            <div class="pad">
                <ul>
                    <li>
                        <?php $this->Form->label($this->_('AdminMain.settings.form.rate_limit', true), 'rate_limit', ['class' => 'inline']);?>
                        <span class="tooltip"><?php $this->_('AppController.tooltip.text');?><div><?php $this->_('AdminMain.!tooltip.rate_limit');?></div></span>
                        <br />
                        <?php $this->Form->fieldNumber('rate_limit', ($vars->rate_limit ?? null), 0, null, 1, ['id' => 'rate_limit']);?>
                    </li>
                </ul>
            </div>

            <div class="button_row">
                <?php
                $this->Form->fieldSubmit('save', $this->_('AdminMain.settings.submit_settings', true), ['class' => 'btn btn-primary pull-right']);
                ?>
                <a class="btn btn-default pull-right ajax" href="<?php echo $this->Html->safe($this->base_uri);?>plugin/mass_mailer/admin_main/index/"><?php $this->_('AdminMain.settings.submit_cancel');?></a>
            </div>
        </div>

        <?php
        $this->Form->end();

        $this->Widget->end();
        ?>