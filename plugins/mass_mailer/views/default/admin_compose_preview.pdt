<?php /** @var View $this */ ?>

<?php
echo (isset($message) ? $message : null);

$this->Widget->clear();
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminCompose.preview.boxtitle', true), ['id' => 'admin_compose_preview'], (isset($render_section) ? $render_section : null));
?>
    <?php
    $this->Form->create(null, ['id' => 'mass_mailer_preview']);
    ?>
    <div class="card-body">
        <p><?php $this->_('AdminCompose.preview.email_total', false, (isset($total) ? $this->Html->safe($total) : null));?></p>

        <?php
        if ((isset($total) ? $total : 0) > 0) {
        ?>
        <h6 class="form-section-header"><?php $this->_('AdminCompose.preview.heading.email_sample');?></h6>

        <div id="email">
            <p>
                <?php
                $this->_(
                    'AdminCompose.preview.text_name',
                    false,
                    (isset($sample->from_name) ? $this->Html->safe($sample->from_name) : null),
                    $this->Html->safe('<' . (isset($sample->from_address) ? $sample->from_address : null) . '>')
                );
                ?>
            </p>
            <p>
                <?php
                $this->_(
                    'AdminCompose.preview.text_subject',
                    false,
                    (isset($sample->subject) ? $this->Html->safe($sample->subject) : null)
                );
                ?>
            </p>

            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#preview-html" type="button" role="tab">
                        <?php $this->_('AdminCompose.index.form.html');?>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#preview-text" type="button" role="tab">
                        <?php $this->_('AdminCompose.index.form.text');?>
                    </button>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="preview-html" role="tabpanel">
                    <iframe id="preview-iframe" class="border rounded" style="width:100%; min-height:60px;" src="<?php echo $this->Html->safe($this->base_uri . 'plugin/mass_mailer/admin_compose/sample/');?>"></iframe>
                </div>
                <div class="tab-pane fade" id="preview-text" role="tabpanel">
                    <div class="border rounded p-3" style="min-height:60px;"><?php echo nl2br((isset($sample->text) ? $this->Html->safe($sample->text) : ''));?></div>
                </div>
            </div>
        </div>
        <?php
        }
        ?>
    </div>

    <?php $this->Widget->footer(); ?>
    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/mass_mailer/admin_compose/');?>"><?php $this->_('AdminCompose.preview.link_back');?></a>
        <?php
        $this->Form->fieldSubmit('preview', $this->_('AdminCompose.preview.form.send', true), ['class' => 'btn btn-primary']);
        ?>
    </div>
    <?php
    $this->Form->end();
    ?>

<script type="text/javascript" src="<?php echo $this->Html->safe($this->view_dir . 'js/mass_mailer.js');?>"></script>
<script>
    window.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'iframeHeight') {
            var iframe = document.getElementById('preview-iframe');
            if (iframe) {
                iframe.style.height = e.data.height + 'px';
            }
        }
    });
</script>
<?php
$this->Widget->end();
