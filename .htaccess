########################################################
# package:    minPHP
# filename:   .htaccess
########################################################

# Do not allow direct access to templates
# or an unauthorized backdoor from CE
<Files ~ "blesta2ce.php|\.(pdt)$">
   order deny,allow
   deny from all
</Files>

# Protect against Clickjacking
#Header append X-Frame-Options "SAMEORIGIN"

RewriteEngine on

# Do not expose project, documentation, repository, or agent artifacts.
# These files are for local development only and should never be served.
Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "(\.(md|markdown|ya?ml|toml|lock|log|sql|bak|old|orig|dist|ini|env|sh|py|pl|rb)$|^AGENTS\.md$|^README\.md$|^composer\.(json|lock)$)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(\.(md|markdown|ya?ml|toml|lock|log|sql|bak|old|orig|dist|ini|env|sh|py|pl|rb)$|^AGENTS\.md$|^README\.md$|^composer\.(json|lock)$)">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

RewriteRule ^(\.git|\.agents|\.claude|_bmad|_bmad-output|docs|logs|scripts|config)(/|$) - [F,L]

# Disable Apache MultiViews since it
# may conflict with the GUI installer
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# Force HTTPS
#RewriteCond %{HTTPS} !=on
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=307,NE,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php

RewriteCond %{REQUEST_URI} ^(.*)/install.php$
RewriteRule install.php %1/install/ [R=301,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
